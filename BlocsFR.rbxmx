-- Pastilles de la mini palette de l'aperçu : { catégorie, libellé }
local PREVIEW_CHIPS = { { "evenements", "Événem." }, { "controle", "Contrôle" }, { "vfx", "Effets" } }

local NOTE_NAMES = { jaune = "Jaune", vert = "Vert", bleu = "Bleu", rose = "Rose", violet = "Violet" }

---------------------------------------------------------------------------
-- Ouverture / fermeture
---------------------------------------------------------------------------

function ReglagesPanel.open(layer, deps)
	if typeof(layer) ~= "Instance" or not layer:IsA("GuiBase2d") then
		warn("[Blocs FR] Paramètres : calque invalide")
		return nil
	end
	if openPanel ~= nil and not openPanel._closed then
		openPanel:close()
	end
	local self = setmetatable({}, ReglagesPanel)
	self.layer = layer
	self.deps = type(deps) == "table" and deps or {}
	self.host = self.deps.host
	self.dialogs = self.deps.dialogs
	self.maid = Util.Maid.new()
	self.buildMaid = Util.Maid.new()
	self._closed = false
	self._query = ""
	self._navIndex = 1
	self._rebuildToken = 0

	local version = self.deps.version
	if version == nil and type(self.host) == "table" then
		version = self.host.version
	end
	self.version = tostring(version or "?")

	-- Réglages jamais lus (App ne l'a pas fait au démarrage) : on les lit, sinon « Appliquer »
	-- écraserait les réglages enregistrés avec les valeurs par défaut
	if type(Reglages.isLoaded) == "function" and not Reglages.isLoaded() and type(self.host) == "table" then
		pcall(Reglages.load, self.host)
	end
	self.draft = Reglages.validate(Reglages.current())
	-- Le menu « ? » change les animations directement : on part de l'état réel
	if Anim and type(Anim.enabled) == "function" then
		local ok, enabled = pcall(Anim.enabled)
		if ok and type(enabled) == "boolean" then
			self.draft.animations.actives = enabled
		end
	end
	self.initial = Reglages.validate(self.draft)

	-- Fond qui assombrit l'éditeur et arrête les clics
	self.root = self.maid:give(button({
		Name = "Parametres",
		Active = true,
		BackgroundColor3 = Theme.Colors.Overlay,
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_PANEL,
		Parent = layer,
	}))
	self.window = button({
		Name = "Fenetre",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(700, 460),
		Parent = self.root,
	})
	Util.corner(self.window, 14)
	self.windowStroke = Util.stroke(self.window, Theme.Colors.PanelBorder, 1, 0)

	self:_build()

	self.maid:give(layer:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_scheduleRebuild()
	end))

	if Anim then
		if type(Anim.tween) == "function" then
			self.root.BackgroundTransparency = 1
			Anim.tween(self.root, { BackgroundTransparency = 0.45 }, 0.15, "quadOut")
		end
		if type(Anim.popIn) == "function" then
			Anim.popIn(self.window, 0.96)
		end
	end

	openPanel = self
	return self
end

function ReglagesPanel:isOpen()
	return not self._closed
end

function ReglagesPanel:close()
	if self._closed then
		return
	end
	self._closed = true
	self:_endDrag()
	self:_closeSheet()
	self.buildMaid:clean()
	self.maid:clean()
	if openPanel == self then
		openPanel = nil
	end
	local onClose = self.deps.onClose
	if type(onClose) == "function" then
		task.spawn(function()
			local ok, err = pcall(onClose)
			if not ok then
				warn("[Blocs FR] Paramètres (fermeture) : " .. tostring(err))
			end
		end)
	end
end

function ReglagesPanel:getDraft()
	return Util.deepCopy(self.draft)
end

-- Fait défiler la liste jusqu'à une section (id de SECTIONS : "zone", "previsualisation"…).
-- Renvoie true si la section existe.
function ReglagesPanel:showSection(sectionId)
	if self._closed or type(sectionId) ~= "string" then
		return false
	end
	for i, section in ipairs(self.sections or {}) do
		if section.def.id == sectionId then
			self:_scrollToSection(i)
			return true
		end
	end
	return false
end

-- Change une valeur du brouillon (comme un clic dans le panneau)
function ReglagesPanel:setValue(path, value)
	if self._closed or type(path) ~= "string" then
		return
	end
	self:_set(path, value)
end

function ReglagesPanel:getDebugState()
	local visibleRows = 0
	for _, section in ipairs(self.sections or {}) do
		for _, row in ipairs(section.rows) do
			if row.frame.Visible then
				visibleRows += 1
			end
		end
	end
	return {
		open = not self._closed,
		query = self._query,
		visibleRows = visibleRows,
		section = self._navIndex,
		size = self._builtSize,
		changed = not deepEqual(Reglages.validate(self.draft), self.initial),
	}
end

---------------------------------------------------------------------------
-- Outils internes
---------------------------------------------------------------------------

function ReglagesPanel:_give(item)
	return self.buildMaid:give(item)
end

function ReglagesPanel:_connect(signal, fn)
	return self.buildMaid:give(signal:Connect(fn))
end

function ReglagesPanel:_mouse()
	local host = self.host
	if type(host) == "table" and type(host.getMousePosition) == "function" then
		local ok, pos = pcall(host.getMousePosition)
		if ok and typeof(pos) == "Vector2" then
			return pos
		end
	end
	return nil
end

function ReglagesPanel:_toast(text, kind)
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.toast) == "function" then
		pcall(dialogs.toast, dialogs, text, kind or "info", 4)
	end
end

function ReglagesPanel:_layerSize()
	local size = self.layer.AbsoluteSize
	local w, h = size.X, size.Y
	if w < 100 then
		w = 1150
	end
	if h < 100 then
		h = 720
	end
	return w, h
end

-- Survol : couleur de fond (avec Anim si possible)
function ReglagesPanel:_hover(target, normal, hover)
	if Anim and type(Anim.hover) == "function" then
		local ok, disconnect = pcall(Anim.hover, target, normal, hover)
		if ok and type(disconnect) == "function" then
			self:_give(disconnect)
			return
		end
	end
	self:_connect(target.MouseEnter, function()
		target.BackgroundColor3 = hover
	end)
	self:_connect(target.MouseLeave, function()
		target.BackgroundColor3 = normal
	end)
end

-- Bouton du pied de page / des fenêtres : style "normal" | "primary" | "danger" (texte rouge sans fond)
function ReglagesPanel:_textButton(parent, text, style, x, y, h)
	local C = Theme.Colors
	local font = Theme.Fonts.UIBold
	local w = textWidth(text, 12, font) + 28
	local bg = C.Button
	local hover = C.ButtonHover
	local textColor = C.Text
	local transparency = 0
	if style == "primary" then
		bg = C.Accent
		hover = C.AccentHover
		textColor = WHITE
		w += 8
	elseif style == "danger" then
		textColor = C.DangerText
		transparency = 1
		w -= 16
	end
	local b = button({
		Name = "Bouton",
		BackgroundColor3 = bg,
		BackgroundTransparency = transparency,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Parent = parent,
	})
	Util.corner(b, 8)
	label({
		Name = "Texte",
		Text = text,
		Font = font,
		TextSize = 12,
		TextColor3 = textColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = b,
	})
	if style == "danger" then
		self:_connect(b.MouseEnter, function()
			b.BackgroundColor3 = C.Danger
			b.BackgroundTransparency = 0.85
		end)
		self:_connect(b.MouseLeave, function()
			b.BackgroundTransparency = 1
		end)
	else
		self:_hover(b, bg, hover)
	end
	if Anim and type(Anim.press) == "function" then
		local ok, disconnect = pcall(Anim.press, b)
		if ok and type(disconnect) == "function" then
			self:_give(disconnect)
		end
	end
	return b, w
end

---------------------------------------------------------------------------
-- Construction (refaite quand la place change)
---------------------------------------------------------------------------

function ReglagesPanel:_scheduleRebuild()
	if self._closed then
		return
	end
	self._rebuildToken += 1
	local token = self._rebuildToken
	task.delay(0.15, function()
		if self._closed or token ~= self._rebuildToken then
			return
		end
		local w, h = self:_layerSize()
		local built = self._builtSize
		if built ~= nil and math.abs(built.X - w) < 4 and math.abs(built.Y - h) < 4 then
			return
		end
		self:_build()
	end)
end

function ReglagesPanel:_build()
	local previousScroll = nil
	if self.content ~= nil and self.content.Parent ~= nil then
		previousScroll = self.content.CanvasPosition
	end
	self:_endDrag()
	self:_closeSheet()
	self.buildMaid:clean()
	self.controls = {}
	self.sections = {}
	self.navItems = {}
	self.content = nil
	self.previewCard = nil
	self._gridLayer = nil
	self._gridKey = nil
	self._previewPending = false

	local C = Theme.Colors
	local lw, lh = self:_layerSize()
	self._builtSize = Vector2.new(lw, lh)

	local W = math.min(1080, lw - 24)
	if W < 520 then
		W = math.max(320, lw - 8)
	end
	local H = math.min(720, lh - 24)
	if H < 360 then
		H = math.max(260, lh - 8)
	end
	self.W, self.H = W, H
	self.window.Size = UDim2.fromOffset(W, H)

	local navW, previewW
	if W >= 1000 then
		navW, previewW = 220, 272
	elseif W >= 860 then
		navW, previewW = 196, 246
	elseif W >= 700 then
		navW, previewW = 182, 202
	else
		navW, previewW = 166, 0
	end
	local bodyH = H - FOOTER_H
	local contentW = W - navW - previewW

	self.navBg = C.Panel:Lerp(C.Background, 0.35)
	self.asideBg = C.Panel:Lerp(C.Background, 0.55)
	self.window.BackgroundColor3 = self.navBg
	self.windowStroke.Color = C.PanelBorder

	self:_buildNav(navW, bodyH)
	self:_buildContent(navW, contentW, bodyH)
	if previewW > 0 then
		self:_buildPreview(W - previewW, previewW, bodyH)
	end
	self:_buildFooter(W, H)

	self:_applySearch()
	self:_refreshAll(true)
	if previousScroll ~= nil and self.content ~= nil then
		local maxY = math.max(0, self.content.CanvasSize.Y.Offset - self.content.AbsoluteSize.Y)
		self.content.CanvasPosition = Vector2.new(0, math.clamp(previousScroll.Y, 0, math.max(maxY, previousScroll.Y)))
	end
	self:_updateNavFromScroll()
end

---------------------------------------------------------------------------
-- Navigation (à gauche)
---------------------------------------------------------------------------

function ReglagesPanel:_buildNav(navW, bodyH)
	local C = Theme.Colors
	local nav = self:_give(frame({
		Name = "Navigation",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(navW, bodyH),
		Parent = self.window,
	}))
	frame({
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		Position = UDim2.fromOffset(navW - 1, 0),
		Size = UDim2.fromOffset(1, bodyH),
		Parent = nav,
	})
	label({
		Name = "Titre",
		Text = "Paramètres",
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(navW - 32, 24),
		Parent = nav,
	})

	-- Recherche
	local search = frame({
		Name = "Recherche",
		BackgroundColor3 = C.FieldBg,
		Position = UDim2.fromOffset(10, 44),
		Size = UDim2.fromOffset(navW - 20, 32),
		Parent = nav,
	})
	Util.corner(search, 8)
	local searchStroke = Util.stroke(search, C.SearchStroke, 1, 0)
	label({
		Name = "Loupe",
		Text = "🔍",
		TextSize = 12,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.fromOffset(22, 32),
		Parent = search,
	})
	local box = Util.create("TextBox", {
		Name = "Texte",
		Text = self._query,
		PlaceholderText = "Rechercher un réglage…",
		PlaceholderColor3 = C.TextDisabled,
		ClearTextOnFocus = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = 12,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(28, 0),
		Size = UDim2.new(1, -54, 1, 0),
		Parent = search,
	})
	self.searchBox = box
	local clear = button({
		Name = "Effacer",
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -24, 0, 6),
		Size = UDim2.fromOffset(20, 20),
		Visible = self._query ~= "",
		Parent = search,
	})
	label({
		Text = "×",
		TextSize = 14,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = clear,
	})
	self:_connect(clear.MouseButton1Click, function()
		box.Text = ""
	end)
	self:_connect(box:GetPropertyChangedSignal("Text"), function()
		if self._closed then
			return
		end
		clear.Visible = box.Text ~= ""
		-- (signaux différés : la recherche a peut-être déjà été appliquée par _scrollToSection)
		if box.Text == self._query then
			return
		end
		self._query = box.Text
		self:_applySearch()
		if self.content then
			self.content.CanvasPosition = Vector2.new(0, 0)
		end
	end)
	self:_connect(box.Focused, function()
		searchStroke.Color = C.Accent
		searchStroke.Thickness = 2
	end)
	self:_connect(box.FocusLost, function()
		searchStroke.Color = C.SearchStroke
		searchStroke.Thickness = 1
	end)

	-- Sections
	local listH = math.max(60, bodyH - NAV_TOP - 34)
	local list = Util.create("ScrollingFrame", {
		Name = "Sections",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, NAV_TOP),
		Size = UDim2.fromOffset(navW - 16, listH),
		CanvasSize = UDim2.fromOffset(0, #SECTIONS * (NAV_ITEM_H + 2)),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = nav,
	})
	for i, section in ipairs(SECTIONS) do
		local item = button({
			Name = "Section_" .. section.id,
			BackgroundColor3 = C.ButtonActive,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, (i - 1) * (NAV_ITEM_H + 2)),
			Size = UDim2.new(1, -4, 0, NAV_ITEM_H),
			Parent = list,
		})
		Util.corner(item, 8)
		local bar = frame({
			Name = "Barre",
			BackgroundColor3 = C.Accent,
			Position = UDim2.fromOffset(0, 7),
			Size = UDim2.fromOffset(3, NAV_ITEM_H - 14),
			Visible = false,
			Parent = item,
		})
		Util.corner(bar, 2)
		local icon
		if section.icon == "bloc" then
			icon = frame({
				Name = "Icone",
				BackgroundColor3 = C.TextDim,
				Position = UDim2.fromOffset(13, 12),
				Size = UDim2.fromOffset(12, 8),
				Parent = item,
			})
			Util.corner(icon, 2)
		else
			icon = label({
				Name = "Icone",
				Text = section.icon,
				Font = Theme.Fonts.UIBold,
				TextSize = 13,
				TextColor3 = C.TextDim,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.fromOffset(22, NAV_ITEM_H),
				Parent = item,
			})
		end
		local text = label({
			Name = "Nom",
			Text = section.title,
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextColor3 = C.TextSoft,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -34, 1, 0),
			Parent = item,
		})
		local entry = { button = item, bar = bar, icon = icon, text = text, hover = false, dim = false }
		self.navItems[i] = entry
		self:_connect(item.MouseEnter, function()
			entry.hover = true
			self:_paintNav(i)
		end)
		self:_connect(item.MouseLeave, function()
			entry.hover = false
			self:_paintNav(i)
		end)
		self:_connect(item.MouseButton1Click, function()
			self:_scrollToSection(i)
		end)
	end

	label({
		Name = "Version",
		Text = "Blocs FR " .. self.version,
		Font = Theme.Fonts.UIBold,
		TextSize = 11,
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(16, bodyH - 30),
		Size = UDim2.fromOffset(navW - 32, 22),
		Parent = nav,
	})
end

function ReglagesPanel:_paintNav(i)
	local entry = self.navItems[i]
	if entry == nil then
		return
	end
	local C = Theme.Colors
	local selected = self._navIndex == i
	entry.bar.Visible = selected
	if selected then
		entry.button.BackgroundColor3 = C.ButtonActive
		entry.button.BackgroundTransparency = 0
		entry.text.TextColor3 = C.Text
	elseif entry.hover then
		entry.button.BackgroundColor3 = C.ButtonHover
		entry.button.BackgroundTransparency = 0
		entry.text.TextColor3 = C.Text
	else
		entry.button.BackgroundTransparency = 1
		if entry.dim then
			entry.text.TextColor3 = C.TextDisabled
		else
			entry.text.TextColor3 = C.TextSoft
		end
	end
end

function ReglagesPanel:_setNavIndex(i)
	if self._navIndex == i then
		return
	end
	local previous = self._navIndex
	self._navIndex = i
	self:_paintNav(previous)
	self:_paintNav(i)
end

function ReglagesPanel:_scrollToSection(i)
	local section = self.sections[i]
	if section == nil or self.content == nil then
		return
	end
	if not section.header.Visible and self.searchBox ~= nil then
		-- section cachée par la recherche : on efface la recherche d'abord
		self._query = ""
		self.searchBox.Text = ""
		self:_applySearch()
	end
	if not section.header.Visible then
		return
	end
	local content = self.content
	local maxY = math.max(0, content.CanvasSize.Y.Offset - content.AbsoluteSize.Y)
	local target = Vector2.new(0, math.clamp(section.top - 10, 0, maxY))
	self._navLock = i
	self:_setNavIndex(i)
	local function unlock()
		if self._navLock == i then
			self._navLock = nil
		end
	end
	if Anim and type(Anim.tween) == "function" then
		Anim.tween(content, { CanvasPosition = target }, 0.25, "quintOut", unlock)
		-- (une animation remplacée n'appelle pas sa fin : on déverrouille quand même)
		task.delay(0.6, unlock)
	else
		content.CanvasPosition = target
		self._navLock = nil
	end
end

-- La section en haut de la liste est allumée dans la navigation
function ReglagesPanel:_updateNavFromScroll()
	local content = self.content
	if content == nil or self._navLock ~= nil then
		return
	end
	local y = content.CanvasPosition.Y
	local maxY = math.max(0, content.CanvasSize.Y.Offset - content.AbsoluteSize.Y)
	local best = nil
	local lastVisible = nil
	for i, section in ipairs(self.sections) do
		if section.header.Visible then
			lastVisible = i
			if section.top - 24 <= y or best == nil then
				best = i
			end
		end
	end
	if lastVisible ~= nil and maxY > 0 and y >= maxY - 2 then
		best = lastVisible
	end
	if best ~= nil then
		self:_setNavIndex(best)
	end
end

---------------------------------------------------------------------------
-- Liste des réglages (au milieu)
---------------------------------------------------------------------------

function ReglagesPanel:_buildContent(x, w, h)
	local C = Theme.Colors
	local holder = self:_give(frame({
		Name = "Reglages",
		BackgroundColor3 = C.Panel,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.fromOffset(w, h),
		Parent = self.window,
	}))
	local scroll = Util.create("ScrollingFrame", {
		Name = "Liste",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = holder,
	})
	self.content = scroll

	local padX = 16
	if w >= 520 then
		padX = 24
	end
	self.padX = padX
	local rowW = w - 2 * padX - 6
	self.rowW = rowW
	local wide = rowW >= WIDE_MIN

	for _, def in ipairs(SECTIONS) do
		local header = frame({
			Name = "Titre_" .. def.id,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(rowW, 30),
			Parent = scroll,
		})
		label({
			Name = "Titre",
			Text = def.title,
			Font = Theme.Fonts.UIBold,
			TextSize = 16,
			Size = UDim2.fromOffset(rowW, 22),
			Parent = header,
		})
		local subH = measure(def.sub, 12, Theme.Fonts.UI, rowW)
		label({
			Name = "Description",
			Text = def.sub,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(0, 26),
			Size = UDim2.fromOffset(rowW, subH),
			Parent = header,
		})
		local headerH = 26 + subH
		header.Size = UDim2.fromOffset(rowW, headerH)
		local separator = frame({
			Name = "Separateur",
			BackgroundColor3 = C.PanelBorder,
			Size = UDim2.fromOffset(rowW, 1),
			Parent = scroll,
		})
		local section = { def = def, header = header, headerH = headerH, separator = separator, rows = {}, top = 0 }
		for _, rowDef in ipairs(def.rows) do
			local ok, rowOrErr = pcall(self._buildRow, self, def, rowDef, scroll, rowW, wide)
			if ok and type(rowOrErr) == "table" then
				table.insert(section.rows, rowOrErr)
			else
				warn("[Blocs FR] Paramètres (« " .. tostring(rowDef.label) .. " ») : " .. tostring(rowOrErr))
			end
		end
		table.insert(self.sections, section)
	end

	self.emptyLabel = label({
		Name = "AucunResultat",
		Text = "",
		TextSize = 13,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(padX, 24),
		Size = UDim2.fromOffset(rowW, 60),
		Visible = false,
		Parent = scroll,
	})

	self:_connect(scroll:GetPropertyChangedSignal("CanvasPosition"), function()
		self:_updateNavFromScroll()
	end)
end

local BUILDERS = {
	themes = "_controlThemes",
	accent = "_controlAccent",
	segmented = "_controlSegmented",
	slider = "_controlSlider",
	toggle = "_controlToggle",
	categories = "_controlCategories",
	noteColors = "_controlNoteColors",
	text = "_controlText",
	pieces = "_controlPieces",
	favoris = "_controlFavoris",
	info = "_controlInfo",
}

function ReglagesPanel:_buildRow(sectionDef, rowDef, parent, rowW, wide)
	local C = Theme.Colors
	local rowFrame = frame({
		Name = "Reglage",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(rowW, 30),
		Parent = parent,
	})
	local labelW = rowW
	if wide then
		labelW = LABEL_W
	end
	local titleH = measure(rowDef.label, 13, Theme.Fonts.UIBold, labelW)
	local hintH = 0
	if rowDef.hint then
		hintH = measure(rowDef.hint, 12, Theme.Fonts.UI, labelW)
	end
	local labelBlockH = titleH
	if hintH > 0 then
		labelBlockH += 3 + hintH
	end

	local cx, cy, cw
	if wide then
		cx, cy, cw = LABEL_W + 16, 0, rowW - LABEL_W - 16
	else
		cx, cy, cw = 0, labelBlockH + 8, rowW
	end
	local method = self[BUILDERS[rowDef.kind] or ""]
	local controlH, refresh = 0, nil
	if type(method) == "function" then
		controlH, refresh = method(self, rowDef, rowFrame, cx, cy, cw)
	end
	controlH = tonumber(controlH) or 0

	-- Libellé : centré sur un petit réglage, en haut sur un grand
	local labelY = 0
	if wide and controlH > labelBlockH and controlH <= 40 then
		labelY = math.floor((controlH - labelBlockH) / 2)
	elseif wide and controlH > 40 then
		labelY = 6
	end
	label({
		Name = "Libelle",
		Text = rowDef.label,
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(0, labelY),
		Size = UDim2.fromOffset(labelW, titleH),
		Parent = rowFrame,
	})
	if hintH > 0 then
		label({
			Name = "Aide",
			Text = rowDef.hint,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(0, labelY + titleH + 3),
			Size = UDim2.fromOffset(labelW, hintH),
			Parent = rowFrame,
		})
	end

	local height
	if wide then
		height = math.max(labelY + labelBlockH, controlH)
	else
		height = cy + controlH
	end
	rowFrame.Size = UDim2.fromOffset(rowW, height)
	if type(refresh) == "function" then
		table.insert(self.controls, refresh)
	end
	local search = Util.fold(
		sectionDef.title .. " " .. rowDef.label .. " " .. (rowDef.hint or "") .. " " .. (rowDef.keywords or "")
	)
	return { frame = rowFrame, height = height, search = search }
end

-- Filtre les réglages (recherche) puis les range de haut en bas
function ReglagesPanel:_applySearch()
	local content = self.content
	if content == nil then
		return
	end
	local list = words(self._query)
	local padX = self.padX or 16
	local y = 18
	local anyVisible = false
	for i, section in ipairs(self.sections) do
		local count = 0
		for _, row in ipairs(section.rows) do
			local match = true
			for _, word in ipairs(list) do
				if not string.find(row.search, word, 1, true) then
					match = false
					break
				end
			end
			row.frame.Visible = match
			if match then
				count += 1
			end
		end
		local entry = self.navItems[i]
		if entry then
			entry.dim = count == 0
			self:_paintNav(i)
		end
		if count > 0 then
			if anyVisible then
				y += SECTION_GAP
				section.separator.Visible = true
				section.separator.Position = UDim2.fromOffset(padX, y)
				y += 1 + SECTION_GAP
			else
				section.separator.Visible = false
			end
			anyVisible = true
			section.header.Visible = true
			section.header.Position = UDim2.fromOffset(padX, y)
			section.top = y
			y += section.headerH + 16
			for _, row in ipairs(section.rows) do
				if row.frame.Visible then
					row.frame.Position = UDim2.fromOffset(padX, y)
					y += row.height + ROW_GAP
				end
			end
			y -= ROW_GAP
		else
			section.header.Visible = false
			section.separator.Visible = false
		end
	end
	if self.emptyLabel then
		self.emptyLabel.Visible = not anyVisible
		if not anyVisible then
			self.emptyLabel.Text = "Aucun réglage ne correspond à « " .. self._query .. " ». Essaie un autre mot (thème, grille, notes…)."
			y = 90
		end
	end
	content.CanvasSize = UDim2.fromOffset(0, y + 24)
end

---------------------------------------------------------------------------
-- Brouillon
---------------------------------------------------------------------------

function ReglagesPanel:_set(path, value)
	if self._closed then
		return
	end
	setPath(self.draft, path, Util.deepCopy(value))
	self.draft = Reglages.validate(self.draft)
	self:_refreshAll(false)
end

function ReglagesPanel:_get(path)
	return getPath(self.draft, path)
end

-- Met à jour tous les réglages affichés et l'aperçu (immediate : aperçu dessiné tout de suite)
function ReglagesPanel:_refreshAll(immediate)
	for _, refresh in ipairs(self.controls or {}) do
		local ok, err = pcall(refresh)
		if not ok then
			warn("[Blocs FR] Paramètres : " .. tostring(err))
		end
	end
	if immediate then
		self:_drawPreview()
	else
		self:_refreshPreview()
	end
end

---------------------------------------------------------------------------
-- Réglages : contrôles
---------------------------------------------------------------------------

function ReglagesPanel:_controlSegmented(rowDef, parent, x, y, w)
	local C = Theme.Colors
	local pad, segH, gap = 3, 26, 2
	local container = frame({
		Name = "Choix",
		BackgroundColor3 = C.FieldBg,
		Position = UDim2.fromOffset(x, y),
		Parent = parent,
	})
	Util.corner(container, 8)
	Util.stroke(container, C.PanelBorder, 1, 0)
	local positions = {}
	local px, py = pad, pad
	local widest = 0
	for i, option in ipairs(rowDef.options) do
		local sw = textWidth(option[1], 12, Theme.Fonts.UIBold) + 24
		if px > pad and px + sw + pad > w then
			px = pad
			py += segH + gap
		end
		positions[i] = { px, py, sw }
		px += sw + gap
		widest = math.max(widest, px - gap + pad)
	end
	local totalH = py + segH + pad
	container.Size = UDim2.fromOffset(widest, totalH)

	local segments = {}
	for i, option in ipairs(rowDef.options) do
		local p = positions[i]
		local seg = button({
			Name = "Option",
			BackgroundColor3 = C.ButtonActive,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(p[1], p[2]),
			Size = UDim2.fromOffset(p[3], segH),
			Parent = container,
		})
		Util.corner(seg, 6)
		local text = label({
			Text = option[1],
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = seg,
		})
		local entry = { button = seg, text = text, value = option[2], hover = false }
		segments[i] = entry
		self:_connect(seg.MouseEnter, function()
			entry.hover = true
			if self:_get(rowDef.path) ~= entry.value then
				text.TextColor3 = C.Text
			end
		end)
		self:_connect(seg.MouseLeave, function()
			entry.hover = false
			if self:_get(rowDef.path) ~= entry.value then
				text.TextColor3 = C.TextDim
			end
		end)
		self:_connect(seg.MouseButton1Click, function()
			self:_set(rowDef.path, entry.value)
		end)
	end
	local function refresh()
		local value = self:_get(rowDef.path)
		for _, entry in ipairs(segments) do
			local on = value == entry.value
			if on then
				entry.button.BackgroundTransparency = 0
				entry.text.TextColor3 = C.Text
			else
				entry.button.BackgroundTransparency = 1
				if entry.hover then
					entry.text.TextColor3 = C.Text
				else
					entry.text.TextColor3 = C.TextDim
				end
			end
		end
	end
	return totalH, refresh
end

function ReglagesPanel:_controlToggle(rowDef, parent, x, y, _w)
	local C = Theme.Colors
	local track = button({
		Name = "Interrupteur",
		BackgroundColor3 = C.ButtonActive,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(38, 22),
		Parent = parent,
	})
	Util.corner(track, 11)
	local knob = frame({
		Name = "Bouton",
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(16, 16),
		Parent = track,
	})
	Util.corner(knob, 8)
	local first = true
	local function refresh()
		local on = self:_get(rowDef.path) == true
		local color = C.ButtonActive
		local position = UDim2.fromOffset(3, 3)
		if on then
			color = C.Accent
			position = UDim2.fromOffset(19, 3)
		end
		if Anim and type(Anim.tween) == "function" and not first then
			Anim.tween(track, { BackgroundColor3 = color }, 0.12, "quadOut")
			Anim.tween(knob, { Position = position }, 0.12, "quadOut")
		else
			track.BackgroundColor3 = color
			knob.Position = position
		end
		first = false
	end
	self:_connect(track.MouseButton1Click, function()
		self:_set(rowDef.path, not (self:_get(rowDef.path) == true))
	end)
	return 22, refresh
end

function ReglagesPanel:_controlSlider(rowDef, parent, x, y, w)
	local C = Theme.Colors
	local format = rowDef.format or tostring
	local valueW = math.max(
		textWidth(format(rowDef.max), 12, Theme.Fonts.UIBold),
		textWidth(format(rowDef.min), 12, Theme.Fonts.UIBold),
		textWidth(format(0), 12, Theme.Fonts.UIBold)
	) + 8
	local trackW = math.max(80, math.min(w - valueW - 14, 340))
	local h = 28
	local hit = button({
		Name = "Curseur",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(trackW, h),
		Parent = parent,
	})
	local track = frame({
		Name = "Piste",
		BackgroundColor3 = C.PanelBorder,
		Position = UDim2.fromOffset(0, math.floor(h / 2) - 3),
		Size = UDim2.fromOffset(trackW, 6),
		Parent = hit,
	})
	Util.corner(track, 3)
	local fill = frame({
		Name = "Rempli",
		BackgroundColor3 = C.Accent,
		Size = UDim2.fromScale(0.5, 1),
		Parent = track,
	})
	Util.corner(fill, 3)
	local knob = frame({
		Name = "Poignee",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		ZIndex = 2,
		Parent = track,
	})
	Util.corner(knob, 8)
	Util.stroke(knob, C.Accent, 3, 0.65)
	local valueLabel = label({
		Name = "Valeur",
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(x + trackW + 6, y),
		Size = UDim2.fromOffset(valueW + 4, h),
		Parent = parent,
	})

	local span = rowDef.max - rowDef.min
	local function fraction(value)
		local v = tonumber(value) or rowDef.min
		if rowDef.toSlider then
			v = rowDef.toSlider(v)
		end
		if span <= 0 then
			return 0
		end
		return math.clamp((v - rowDef.min) / span, 0, 1)
	end
	local function valueAt(f)
		local raw = rowDef.min + math.clamp(f, 0, 1) * span
		local stepped = math.floor((raw - rowDef.min) / rowDef.step + 0.5) * rowDef.step + rowDef.min
		stepped = round2(math.clamp(stepped, rowDef.min, rowDef.max))
		if rowDef.fromSlider then
			stepped = rowDef.fromSlider(stepped)
		end
		return stepped
	end
	local function refresh()
		local value = self:_get(rowDef.path)
		local f = fraction(value)
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		valueLabel.Text = format(value)
	end
	local function moveTo(mouseX)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local value = valueAt((mouseX - track.AbsolutePosition.X) / width)
		if value ~= self:_get(rowDef.path) then
			self:_set(rowDef.path, value)
		end
	end
	self:_connect(hit.MouseButton1Down, function(mx, _my)
		local mouse = self:_mouse()
		if mouse == nil then
			-- sans host.getMousePosition : un clic place la valeur (pas de glisser)
			moveTo(mx)
			return
		end
		self:_beginDrag(function(position)
			moveTo(position.X)
		end)
	end)
	return h, refresh
end

-- Glisser (curseurs) : un bouton transparent couvre tout pendant le geste ; RunService.Heartbeat lit
-- host.getMousePosition() ; relâcher (ou un nouveau clic) termine.
function ReglagesPanel:_beginDrag(onMove)
	self:_endDrag()
	if self.root == nil then
		return
	end
	local catcher = button({
		Name = "Glisser",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_DRAG,
		Parent = self.root,
	})
	local drag = { catcher = catcher, connections = {}, last = nil }
	self._drag = drag
	local function finish()
		if self._drag == drag then
			self:_endDrag()
		end
	end
	local function step()
		if self._drag ~= drag then
			return
		end
		local mouse = self:_mouse()
		if mouse == nil then
			return
		end
		if drag.last ~= nil and math.abs(mouse.X - drag.last.X) < 0.5 then
			return
		end
		drag.last = mouse
		local ok, err = pcall(onMove, mouse)
		if not ok then
			warn("[Blocs FR] Paramètres (curseur) : " .. tostring(err))
			finish()
		end
	end
	table.insert(drag.connections, catcher.MouseButton1Up:Connect(finish))
	table.insert(drag.connections, catcher.MouseButton1Down:Connect(finish))
	table.insert(drag.connections, catcher.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish()
		end
	end))
	local widget = nil
	if type(self.host) == "table" then
		widget = self.host.widget
	end
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(drag.connections, widget.WindowFocusReleased:Connect(finish))
		end)
	end
	table.insert(drag.connections, RunService.Heartbeat:Connect(step))
	step()
end

function ReglagesPanel:_endDrag()
	local drag = self._drag
	if drag == nil then
		return
	end
	self._drag = nil
	for _, connection in ipairs(drag.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	if drag.catcher then
		pcall(function()
			drag.catcher:Destroy()
		end)
	end
end

function ReglagesPanel:_controlThemes(_rowDef, parent, x, y, w)
	local C = Theme.Colors
	local gap = 10
	local cols = 4
	if (w - 3 * gap) / 4 < 86 then
		cols = 2
	end
	local cardW = math.floor((w - (cols - 1) * gap) / cols)
	local miniH = 58
	local cardH = 8 + miniH + 6 + 18 + 8
	local rows = math.ceil(#Reglages.THEMES / cols)
	local cards = {}
	for i, theme in ipairs(Reglages.THEMES) do
		local col = (i - 1) % cols
		local r = math.floor((i - 1) / cols)
		local card = button({
			Name = "Theme_" .. theme.id,
			BackgroundColor3 = C.PanelAlt,
			Position = UDim2.fromOffset(x + col * (cardW + gap), y + r * (cardH + gap)),
			Size = UDim2.fromOffset(cardW, cardH),
			Parent = parent,
		})
		Util.corner(card, 12)
		local stroke = Util.stroke(card, C.PanelBorder, 1, 0)
		local mini = frame({
			Name = "Miniature",
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(cardW - 16, miniH),
			ClipsDescendants = true,
			Parent = card,
		})
		label({
			Name = "Nom",
			Text = theme.nom,
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(8, 8 + miniH + 6),
			Size = UDim2.fromOffset(cardW - 16, 18),
			Parent = card,
		})
		cards[i] = { id = theme.id, card = card, stroke = stroke, mini = mini }
		self:_connect(card.MouseButton1Click, function()
			self:_set("apparence.theme", theme.id)
		end)
	end

	local lastAccent = nil
	local function drawMini(entry)
		local mini = entry.mini
		for _, child in ipairs(mini:GetChildren()) do
			child:Destroy()
		end
		local tmp = Reglages.validate(self.draft)
		tmp.apparence.theme = entry.id
		local colors = Reglages.colorsFor(tmp)
		mini.BackgroundColor3 = colors.Background
		Util.corner(mini, 7)
		local bordered = entry.id == "clair" or entry.id == "contraste"
		frame({
			Name = "Barre",
			BackgroundColor3 = colors.Panel,
			Size = UDim2.new(1, 0, 0, 12),
			Parent = mini,
		})
		local side = frame({
			Name = "Palette",
			BackgroundColor3 = colors.Panel,
			Position = UDim2.fromOffset(0, 12),
			Size = UDim2.new(0.34, 0, 1, -12),
			Parent = mini,
		})
		if bordered then
			frame({
				BackgroundColor3 = colors.PanelBorder,
				Position = UDim2.fromOffset(0, 12),
				Size = UDim2.new(1, 0, 0, 1),
				Parent = mini,
			})
			frame({
				BackgroundColor3 = colors.PanelBorder,
				Position = UDim2.new(1, -1, 0, 0),
				Size = UDim2.new(0, 1, 1, 0),
				Parent = side,
			})
		end
		local bar1 = frame({
			Name = "Bloc",
			BackgroundColor3 = THEME_ACTIONS_BAR,
			Position = UDim2.new(0.44, 0, 0, 22),
			Size = UDim2.new(0.4, 0, 0, 10),
			Parent = mini,
		})
		Util.corner(bar1, 3)
		local accentBar = colors.Accent
		if entry.id == "contraste" then
			accentBar = colors.AccentText
			Util.stroke(bar1, WHITE, 1, 0)
		end
		local bar2 = frame({
			Name = "Accent",
			BackgroundColor3 = accentBar,
			Position = UDim2.new(0.44, 0, 0, 37),
			Size = UDim2.new(0.3, 0, 0, 10),
			Parent = mini,
		})
		Util.corner(bar2, 3)
	end

	local function refresh()
		local theme = self:_get("apparence.theme")
		local accent = self:_get("apparence.accent")
		local key = ""
		if type(accent) == "table" then
			key = tostring(accent[1]) .. "," .. tostring(accent[2]) .. "," .. tostring(accent[3])
		end
		local redraw = key ~= lastAccent
		lastAccent = key
		for _, entry in ipairs(cards) do
			if redraw then
				drawMini(entry)
			end
			if entry.id == theme then
				entry.stroke.Color = C.Accent
				entry.stroke.Thickness = 2
			else
				entry.stroke.Color = C.PanelBorder
				entry.stroke.Thickness = 1
			end
		end
	end
	return rows * cardH + (rows - 1) * gap, refresh
end

function ReglagesPanel:_controlAccent(rowDef, parent, x, y, w)
	local C = Theme.Colors
	local count = #Reglages.ACCENTS + 1
	local gap = 6
	local ring = math.clamp(math.floor((w + gap) / count) - gap, 24, 32)
	local perLine = math.max(1, math.floor((w + gap) / (ring + gap)))
	local entries = {}
	local function place(i)
		local col = (i - 1) % perLine
		local line = math.floor((i - 1) / perLine)
		return x + col * (ring + gap), y + line * (ring + gap)
	end
	local function makeSwatch(i, color)
		local px, py = place(i)
		local holder = button({
			Name = "Couleur",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(ring, ring),
			Parent = parent,
		})
		Util.corner(holder, math.floor(ring / 2))
		local stroke = Util.stroke(holder, C.Text, 2, 1)
		local inner = frame({
			Name = "Pastille",
			BackgroundColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ring - 8, ring - 8),
			Parent = holder,
		})
		Util.corner(inner, math.floor((ring - 8) / 2))
		return holder, stroke, inner
	end
	for i, rgb in ipairs(Reglages.ACCENTS) do
		local holder, stroke, inner = makeSwatch(i, Util.rgbToColor3(rgb))
		local entry = { rgb = rgb, holder = holder, stroke = stroke, inner = inner }
		entries[i] = entry
		self:_connect(holder.MouseButton1Click, function()
			self:_set(rowDef.path, { rgb[1], rgb[2], rgb[3] })
		end)
	end
	-- « ＋ » : couleur au choix
	local holder, stroke, inner = makeSwatch(count, C.Button)
	Util.stroke(inner, C.PanelBorder, 1, 0)
	local plus = label({
		Text = "＋",
		Font = Theme.Fonts.UIBold,
		TextSize = 14,
		TextColor3 = C.TextSoft,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = inner,
	})
	self:_connect(holder.MouseButton1Click, function()
		self:_pickColor(holder, self:_get(rowDef.path), function(rgb)
			self:_set(rowDef.path, rgb)
		end)
	end)
	local lines = math.ceil(count / perLine)
	local function refresh()
		local accent = self:_get(rowDef.path)
		local contraste = self:_get("apparence.theme") == "contraste"
		local matched = false
		for _, entry in ipairs(entries) do
			local on = sameRgb(entry.rgb, accent)
			if on then
				matched = true
			end
			entry.stroke.Transparency = on and 0 or 1
			entry.inner.BackgroundTransparency = contraste and 0.55 or 0
		end
		stroke.Transparency = matched and 1 or 0
		if not matched and type(accent) == "table" then
			local color = Util.rgbToColor3(accent)
			inner.BackgroundColor3 = color
			plus.TextColor3 = Theme.textOn(color)
		else
			inner.BackgroundColor3 = C.Button
			plus.TextColor3 = C.TextSoft
		end
	end
	return lines * ring + (lines - 1) * gap, refresh
end

-- Ouvre le sélecteur de couleur de Dialogs sous anchor ; onChoose({r, g, b})
function ReglagesPanel:_pickColor(anchor, rgb, onChoose)
	local dialogs = self.dialogs
	if type(dialogs) ~= "table" or type(dialogs.colorPicker) ~= "function" then
		self:_toast("Le sélecteur de couleur n'est pas disponible ici.", "warning")
		return
	end
	local position = nil
	if typeof(anchor) == "Instance" and anchor:IsA("GuiObject") then
		position = anchor.AbsolutePosition + Vector2.new(0, anchor.AbsoluteSize.Y + 4)
	else
		position = self:_mouse()
	end
	local start = rgb
	if type(start) ~= "table" then
		start = { 255, 255, 255 }
	end
	local ok, err = pcall(dialogs.colorPicker, dialogs, position, { start[1], start[2], start[3] }, function(result)
		if self._closed or type(result) ~= "table" then
			return
		end
		onChoose(result)
	end)
	if not ok then
		warn("[Blocs FR] Paramètres (couleur) : " .. tostring(err))
	end
end

function ReglagesPanel:_categoryList()
	local list = {}
	for _, entry in ipairs(Categories) do
		if type(entry) == "table" and type(entry.id) == "string" then
			table.insert(list, { id = entry.id, name = tostring(entry.name or entry.id) })
		end
	end
	return list
end

function ReglagesPanel:_setCategoryColor(categoryId, rgb)
	local couleurs = Util.deepCopy(self:_get("blocs.couleurs") or {})
	couleurs[categoryId] = rgb
	self:_set("blocs.couleurs", couleurs)
end

function ReglagesPanel:_controlCategories(_rowDef, parent, x, y, w)
	local C = Theme.Colors
	local cats = self:_categoryList()
	local gap = 6
	local cols = 1
	if w >= 3 * 140 + 2 * gap then
		cols = 3
	elseif w >= 2 * 120 + gap then
		cols = 2
	end
	local cellW = math.floor((w - (cols - 1) * gap) / cols)
	local cellH = 34
	local cells = {}
	for i, cat in ipairs(cats) do
		local col = (i - 1) % cols
		local r = math.floor((i - 1) / cols)
		local cell = button({
			Name = "Categorie_" .. cat.id,
			BackgroundColor3 = C.PanelAlt,
			Position = UDim2.fromOffset(x + col * (cellW + gap), y + r * (cellH + gap)),
			Size = UDim2.fromOffset(cellW, cellH),
			Parent = parent,
		})
		Util.corner(cell, 8)
		label({
			Name = "Nom",
			Text = cat.name,
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.fromOffset(cellW - 46, cellH),
			Parent = cell,
		})
		local swatch = frame({
			Name = "Couleur",
			Position = UDim2.fromOffset(cellW - 32, 6),
			Size = UDim2.fromOffset(22, 22),
			Parent = cell,
		})
		Util.corner(swatch, 6)
		Util.stroke(swatch, WHITE, 2, 0.25)
		cells[i] = { id = cat.id, swatch = swatch }
		self:_hover(cell, C.PanelAlt, C.ButtonHover)
		self:_connect(cell.MouseButton1Click, function()
			local color = Reglages.categoryColor(cat.id, self.draft)
			local start = nil
			if typeof(color) == "Color3" then
				start = Util.color3ToRgb(color)
			end
			self:_pickColor(cell, start, function(rgb)
				self:_setCategoryColor(cat.id, rgb)
			end)
		end)
		self:_connect(cell.MouseButton2Click, function()
			self:_setCategoryColor(cat.id, nil)
		end)
	end
	local rows = math.max(1, math.ceil(#cats / cols))
	local gridH = rows * cellH + (rows - 1) * gap
	if #cats == 0 then
		gridH = 0
	end
	local resetText = "Réinitialiser les couleurs"
	local reset = button({
		Name = "Reinitialiser",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y + gridH + 8),
		Size = UDim2.fromOffset(textWidth(resetText, 12, Theme.Fonts.UIBold) + 4, 20),
		Parent = parent,
	})
	local resetLabel = label({
		Text = resetText,
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextColor3 = C.AccentText,
		Size = UDim2.fromScale(1, 1),
		Parent = reset,
	})
	self:_connect(reset.MouseEnter, function()
		resetLabel.TextColor3 = C.Text
	end)
	self:_connect(reset.MouseLeave, function()
		resetLabel.TextColor3 = C.AccentText
	end)
	self:_connect(reset.MouseButton1Click, function()
		self:_set("blocs.couleurs", {})
	end)
	local function refresh()
		for _, cell in ipairs(cells) do
			local color = Reglages.categoryColor(cell.id, self.draft)
			if typeof(color) == "Color3" then
				cell.swatch.BackgroundColor3 = color
			end
		end
		local couleurs = self:_get("blocs.couleurs")
		reset.Visible = type(couleurs) == "table" and next(couleurs) ~= nil
	end
	return gridH + 8 + 20, refresh
end

function ReglagesPanel:_controlNoteColors(rowDef, parent, x, y, _w)
	local C = Theme.Colors
	local size, gap = 28, 8
	local entries = {}
	for i, id in ipairs(Reglages.NOTE_COLORS) do
		local colors = Theme.NoteColors and Theme.NoteColors[id]
		local fond = Color3.fromRGB(253, 230, 138)
		if colors and colors.Fond then
			fond = colors.Fond
		end
		local holder = button({
			Name = "Note_" .. id,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(x + (i - 1) * (size + gap), y),
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		})
		Util.corner(holder, size / 2)
		local stroke = Util.stroke(holder, C.Text, 2, 1)
		local inner = frame({
			BackgroundColor3 = fond,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size - 8, size - 8),
			Parent = holder,
		})
		Util.corner(inner, (size - 8) / 2)
		entries[i] = { id = id, stroke = stroke }
		self:_connect(holder.MouseButton1Click, function()
			self:_set(rowDef.path, id)
		end)
	end
	local nameLabel = label({
		Name = "Nom",
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextColor3 = C.TextSoft,
		Position = UDim2.fromOffset(x + #Reglages.NOTE_COLORS * (size + gap) + 4, y),
		Size = UDim2.fromOffset(80, size),
		Parent = parent,
	})
	local function refresh()
		local value = self:_get(rowDef.path)
		for _, entry in ipairs(entries) do
			entry.stroke.Transparency = (entry.id == value) and 0 or 1
		end
		nameLabel.Text = NOTE_NAMES[value] or tostring(value)
	end
	return size, refresh
end

-- Champ texte (id) ; commit à la perte du focus
function ReglagesPanel:_textField(parent, x, y, w, h, placeholder, getValue, setValue)
	local C = Theme.Colors
	local holder = frame({
		Name = "Champ",
		BackgroundColor3 = C.FieldBg,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Parent = parent,
	})
	Util.corner(holder, 8)
	local stroke = Util.stroke(holder, C.SearchStroke, 1, 0)
	local box = Util.create("TextBox", {
		Name = "Texte",
		Text = tostring(getValue() or ""),
		PlaceholderText = placeholder or "",
		PlaceholderColor3 = C.TextDisabled,
		ClearTextOnFocus = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = 12,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Parent = holder,
	})
	self:_connect(box.Focused, function()
		stroke.Color = C.Accent
		stroke.Thickness = 2
	end)
	self:_connect(box.FocusLost, function()
		stroke.Color = C.SearchStroke
		stroke.Thickness = 1
		local text = box.Text
		local id = Reglages.assetId(text)
		if Util.trim(text) ~= "" and id == "" then
			self:_toast("Ce n'est pas un id : colle seulement le numéro (ex : 1234567890).", "warning")
		end
		-- (jamais de changement du champ pendant son propre FocusLost : on diffère)
		task.defer(function()
			if self._closed then
				return
			end
			setValue(id)
			if box.Parent ~= nil then
				box.Text = tostring(getValue() or "")
			end
		end)
	end)
	local function refresh()
		if box.Parent ~= nil and not box:IsFocused() then
			local value = tostring(getValue() or "")
			if box.Text ~= value then
				box.Text = value
			end
		end
	end
	return box, refresh
end

function ReglagesPanel:_controlText(rowDef, parent, x, y, w)
	local _, refresh = self:_textField(parent, x, y, math.min(w, 260), 32, rowDef.placeholder, function()
		return self:_get(rowDef.path)
	end, function(value)
		self:_set(rowDef.path, value)
	end)
	return 32, refresh
end

function ReglagesPanel:_controlPieces(rowDef, parent, x, y, w)
	local C = Theme.Colors
	local gap = 8
	local cols = 1
	if w >= 2 * 200 + gap then
		cols = 2
	end
	local cellW = math.floor((w - (cols - 1) * gap) / cols)
	local labelW = 90
	local fieldH = 30
	local refreshers = {}
	for i, piece in ipairs(Reglages.PIECES) do
		local col = (i - 1) % cols
		local r = math.floor((i - 1) / cols)
		local px = x + col * (cellW + gap)
		local py = y + r * (fieldH + 6)
		label({
			Name = "Nom",
			Text = piece[2],
			Font = Theme.Fonts.UIBold,
			TextSize = 11,
			TextColor3 = C.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(labelW - 6, fieldH),
			Parent = parent,
		})
		local key = rowDef.path .. "." .. piece[1]
		local _, refresh = self:_textField(parent, px + labelW, py, cellW - labelW, fieldH, "id du mesh", function()
			return self:_get(key)
		end, function(value)
			self:_set(key, value)
		end)
		table.insert(refreshers, refresh)
	end
	local rows = math.ceil(#Reglages.PIECES / cols)
	local function refresh()
		for _, fn in ipairs(refreshers) do
			fn()
		end
	end
	return rows * fieldH + (rows - 1) * 6, refresh
end

function ReglagesPanel:_controlFavoris(rowDef, parent, x, y, w)
	local C = Theme.Colors
	local clearText = "Vider la liste"
	local clearW = textWidth(clearText, 12, Theme.Fonts.UIBold) + 24
	local text = label({
		Name = "Nombre",
		TextSize = 13,
		TextColor3 = C.TextSoft,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(math.max(60, w - clearW - 10), 30),
		Parent = parent,
	})
	local clear = button({
		Name = "Vider",
		BackgroundColor3 = C.Button,
		Position = UDim2.fromOffset(x + math.max(60, w - clearW - 10) + 10, y),
		Size = UDim2.fromOffset(clearW, 30),
		Parent = parent,
	})
	Util.corner(clear, 8)
	label({
		Text = clearText,
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextColor3 = C.DangerText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = clear,
	})
	self:_hover(clear, C.Button, C.ButtonHover)
	self:_connect(clear.MouseButton1Click, function()
		self:_set(rowDef.path, {})
	end)
	local function refresh()
		local list = self:_get(rowDef.path)
		local n = 0
		if type(list) == "table" then
			n = #list
		end
		if n == 0 then
			text.Text = "Aucun bloc favori pour l'instant."
		elseif n == 1 then
			text.Text = "1 bloc favori"
		else
			text.Text = tostring(n) .. " blocs favoris"
		end
		clear.Visible = n > 0
	end
	return 30, refresh
end

function ReglagesPanel:_controlInfo(_rowDef, parent, x, y, w)
	label({
		Name = "Texte",
		Text = "Blocs FR " .. self.version,
		TextSize = 13,
		TextColor3 = Theme.Colors.TextSoft,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, 22),
		Parent = parent,
	})
	return 22, nil
end

---------------------------------------------------------------------------
-- Aperçu en direct (à droite)
---------------------------------------------------------------------------

function ReglagesPanel:_buildPreview(x, w, h)
	local C = Theme.Colors
	local aside = self:_give(frame({
		Name = "Apercu",
		BackgroundColor3 = self.asideBg,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.fromOffset(w, h),
		Parent = self.window,
	}))
	-- seul le coin en haut à droite est arrondi (celui de la fenêtre)
	Util.corner(aside, 14)
	frame({
		BackgroundColor3 = self.asideBg,
		Size = UDim2.fromOffset(16, h),
		Parent = aside,
	})
	frame({
		BackgroundColor3 = self.asideBg,
		Position = UDim2.fromOffset(0, h - 16),
		Size = UDim2.fromOffset(w, 16),
		Parent = aside,
	})
	frame({
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		Size = UDim2.fromOffset(1, h),
		ZIndex = 2,
		Parent = aside,
	})
	label({
		Name = "Titre",
		Text = "APERÇU EN DIRECT",
		Font = Theme.Fonts.UIBold,
		TextSize = 11,
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.fromOffset(w - 32, 18),
		ZIndex = 2,
		Parent = aside,
	})
	local cardW = w - 32
	local cardH = math.clamp(h - 40 - 16 - 58, 140, 300)
	local card = frame({
		Name = "Carte",
		Position = UDim2.fromOffset(16, 40),
		Size = UDim2.fromOffset(cardW, cardH),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = aside,
	})
	self.previewCard = card
	self.previewW = cardW
	self.previewH = cardH
	local note = "Les changements s'affichent ici avant d'être appliqués à tout le plugin."
	label({
		Name = "Aide",
		Text = note,
		TextSize = 11,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(16, 40 + cardH + 10),
		Size = UDim2.fromOffset(cardW, measure(note, 11, Theme.Fonts.UI, cardW)),
		ZIndex = 2,
		Parent = aside,
	})
end

function ReglagesPanel:_refreshPreview()
	if self._previewPending or self.previewCard == nil then
		return
	end
	self._previewPending = true
	task.delay(0.05, function()
		self._previewPending = false
		if not self._closed then
			self:_drawPreview()
		end
	end)
end

-- Un bloc de l'aperçu (unités du canvas, zoom 1) ; parts = { "texte" | { kind = "field"|"dropdown", text } }
local function previewBlock(parent, x, y, color, parts, style, corner, isHat, z)
	local font = Theme.Fonts.Block
	local padX, gap = 11, 6
	local widths = {}
	local total = 0
	for i, part in ipairs(parts) do
		local pw
		if type(part) == "string" then
			pw = textWidth(part, 13, font)
		elseif part.kind == "field" then
			pw = math.max(26, textWidth(part.text, 12, font) + 16)
		else
			pw = textWidth(part.text .. " ▼", 12, font) + 16
		end
		widths[i] = pw
		total += pw
	end
	total += gap * math.max(0, #parts - 1)
	local w = padX * 2 + total
	local h = 36
	local contentY = 0
	if isHat then
		h = 48
		contentY = 12
	end
	local radius = corner
	if style == "bonbon" then
		radius = math.floor(corner * 1.6 + 0.5)
	end
	if style == "relief" then
		-- bande sombre du bas : une copie plus sombre décalée de 2 px sous le bloc
		local shade = frame({
			BackgroundColor3 = Theme.darken(color, 0.22),
			Position = UDim2.fromOffset(x, y + 2),
			Size = UDim2.fromOffset(w, h),
			ZIndex = z,
			Parent = parent,
		})
		Util.corner(shade, radius)
	end
	local block = frame({
		Name = "Bloc",
		BackgroundColor3 = color,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = z + 1,
		Parent = parent,
	})
	Util.corner(block, radius)
	if style == "relief" then
		Util.stroke(block, Theme.darken(color, 0.25), 1, 0)
	elseif style == "contour" then
		Util.stroke(block, Theme.darken(color, 0.35), 2, 0)
	elseif style == "bonbon" then
		block.BackgroundColor3 = WHITE
		Util.create("UIGradient", {
			Color = ColorSequence.new(Theme.lighten(color, 0.25), color),
			Rotation = 90,
			Parent = block,
		})
		Util.stroke(block, WHITE, 1, 0.7)
	end
	local cx = padX
	for i, part in ipairs(parts) do
		local pw = widths[i]
		if type(part) == "string" then
			label({
				Text = part,
				Font = font,
				TextSize = 13,
				TextColor3 = WHITE,
				Position = UDim2.fromOffset(cx, contentY),
				Size = UDim2.fromOffset(pw + 2, 36),
				ZIndex = z + 2,
				Parent = block,
			})
		elseif part.kind == "field" then
			local pill = frame({
				BackgroundColor3 = WHITE,
				Position = UDim2.fromOffset(cx, contentY + 7),
				Size = UDim2.fromOffset(pw, 22),
				ZIndex = z + 2,
				Parent = block,
			})
			Util.corner(pill, 11)
			label({
				Text = part.text,
				Font = font,
				TextSize = 12,
				TextColor3 = DARK_TEXT,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				ZIndex = z + 3,
				Parent = pill,
			})
		else
			local menu = frame({
				BackgroundColor3 = Theme.darken(color, 0.26),
				Position = UDim2.fromOffset(cx, contentY + 7),
				Size = UDim2.fromOffset(pw, 22),
				ZIndex = z + 2,
				Parent = block,
			})
			Util.corner(menu, 6)
			Util.stroke(menu, WHITE, 1, 0.8)
			label({
				Text = part.text .. " ▼",
				Font = font,
				TextSize = 12,
				TextColor3 = WHITE,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				ZIndex = z + 3,
				Parent = menu,
			})
		end
		cx += pw + gap
	end
	return h
end

-- Grille de l'aperçu (refaite seulement quand elle change)
function ReglagesPanel:_drawPreviewGrid(card, x, y, w, h, s, colors)
	local spacing = math.max(8, math.floor(s.zone.tailleGrille * 0.6 + 0.5))
	local key = s.zone.grille .. "|" .. spacing .. "|" .. tostring(colors.GridDot) .. "|" .. x .. "|" .. w .. "|" .. h
	if self._gridLayer ~= nil and self._gridLayer.Parent == card and self._gridKey == key then
		return
	end
	if self._gridLayer ~= nil then
		self._gridLayer:Destroy()
	end
	local layer = frame({
		Name = "Grille",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = 1,
		Parent = card,
	})
	self._gridLayer = layer
	self._gridKey = key
	if s.zone.grille == "points" then
		local count = 0
		local gy = math.floor(spacing / 2)
		while gy < h and count < 900 do
			local gx = math.floor(spacing / 2)
			while gx < w and count < 900 do
				frame({
					BackgroundColor3 = colors.GridDot,
					Position = UDim2.fromOffset(gx, gy),
					Size = UDim2.fromOffset(2, 2),
					ZIndex = 1,
					Parent = layer,
				})
				count += 1
				gx += spacing
			end
			gy += spacing
		end
	elseif s.zone.grille == "lignes" then
		local gx = spacing
		while gx < w do
			frame({
				BackgroundColor3 = colors.GridDot,
				Position = UDim2.fromOffset(gx, 0),
				Size = UDim2.fromOffset(1, h),
				ZIndex = 1,
				Parent = layer,
			})
			gx += spacing
		end
		local gy = spacing
		while gy < h do
			frame({
				BackgroundColor3 = colors.GridDot,
				Position = UDim2.fromOffset(0, gy),
				Size = UDim2.fromOffset(w, 1),
				ZIndex = 1,
				Parent = layer,
			})
			gy += spacing
		end
	end
end

function ReglagesPanel:_drawPreview()
	local card = self.previewCard
	if card == nil or card.Parent == nil then
		return
	end
	local ok, err = pcall(function()
		local s = self.draft
		local colors = Reglages.colorsFor(s)
		local cw, ch = self.previewW, self.previewH
		for _, child in ipairs(card:GetChildren()) do
			if child ~= self._gridLayer then
				child:Destroy()
			end
		end
		card.BackgroundColor3 = colors.Background
		Util.corner(card, 12)
		Util.stroke(card, colors.PanelBorder, 1, 0)

		-- Barre du haut : logo, « Blocs FR », bouton « Enregistrer » (couleur principale)
		-- (ClipsDescendants coupe en rectangle : la barre et la palette ont leurs propres coins arrondis)
		local bar = frame({
			Name = "Barre",
			BackgroundColor3 = colors.Panel,
			Size = UDim2.fromOffset(cw, 30),
			ZIndex = 4,
			Parent = card,
		})
		Util.corner(bar, 12)
		frame({
			BackgroundColor3 = colors.Panel,
			Position = UDim2.fromOffset(0, 14),
			Size = UDim2.fromOffset(cw, 16),
			ZIndex = 4,
			Parent = bar,
		})
		frame({
			BackgroundColor3 = colors.PanelBorder,
			Position = UDim2.fromOffset(0, 29),
			Size = UDim2.fromOffset(cw, 1),
			ZIndex = 5,
			Parent = bar,
		})
		local logoMade = false
		if Logo and type(Logo.create) == "function" then
			local okLogo, logo = pcall(Logo.create, bar, 16, 5)
			if okLogo and typeof(logo) == "Instance" then
				logo.Position = UDim2.fromOffset(9, 7)
				logoMade = true
			end
		end
		if not logoMade then
			local tile = frame({
				BackgroundColor3 = Theme.LogoColors.Blue,
				Position = UDim2.fromOffset(9, 7),
				Size = UDim2.fromOffset(16, 16),
				ZIndex = 5,
				Parent = bar,
			})
			Util.corner(tile, 4)
		end
		label({
			Text = "Blocs FR",
			Font = Theme.Fonts.UIBold,
			TextSize = 11,
			TextColor3 = colors.Text,
			Position = UDim2.fromOffset(31, 0),
			Size = UDim2.fromOffset(70, 30),
			ZIndex = 5,
			Parent = bar,
		})
		local pillW = textWidth("Enregistrer", 10, Theme.Fonts.UIBold) + 16
		local pill = frame({
			BackgroundColor3 = colors.Accent,
			Position = UDim2.fromOffset(cw - 8 - pillW, 5),
			Size = UDim2.fromOffset(pillW, 20),
			ZIndex = 5,
			Parent = bar,
		})
		Util.corner(pill, 6)
		label({
			Text = "Enregistrer",
			Font = Theme.Fonts.UIBold,
			TextSize = 10,
			TextColor3 = WHITE,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 6,
			Parent = pill,
		})

		-- Palette (si la place le permet)
		local bodyY = 30
		local bodyH = ch - 30
		local paletteW = 0
		if cw >= 210 then
			paletteW = 66
		end
		if paletteW > 0 then
			local side = frame({
				Name = "Palette",
				BackgroundColor3 = colors.Panel,
				Position = UDim2.fromOffset(0, bodyY),
				Size = UDim2.fromOffset(paletteW, bodyH),
				ZIndex = 4,
				Parent = card,
			})
			Util.corner(side, 12)
			frame({
				BackgroundColor3 = colors.Panel,
				Size = UDim2.fromOffset(paletteW, 16),
				ZIndex = 4,
				Parent = side,
			})
			frame({
				BackgroundColor3 = colors.Panel,
				Position = UDim2.fromOffset(paletteW - 16, 0),
				Size = UDim2.fromOffset(16, bodyH),
				ZIndex = 4,
				Parent = side,
			})
			frame({
				BackgroundColor3 = colors.PanelBorder,
				Position = UDim2.fromOffset(paletteW - 1, 0),
				Size = UDim2.fromOffset(1, bodyH),
				ZIndex = 5,
				Parent = side,
			})
			for i, chip in ipairs(PREVIEW_CHIPS) do
				local _, dot = Reglages.categoryColor(chip[1], s)
				if typeof(dot) ~= "Color3" then
					dot = VFX_DOT
				end
				local chipBg = colors.Button
				if i == 1 then
					chipBg = colors.ButtonActive
				end
				local chipFrame = frame({
					BackgroundColor3 = chipBg,
					Position = UDim2.fromOffset(5, 8 + (i - 1) * 25),
					Size = UDim2.fromOffset(paletteW - 10, 20),
					ZIndex = 5,
					Parent = side,
				})
				Util.corner(chipFrame, 5)
				local d = frame({
					BackgroundColor3 = dot,
					Position = UDim2.fromOffset(5, 6),
					Size = UDim2.fromOffset(7, 7),
					ZIndex = 6,
					Parent = chipFrame,
				})
				Util.corner(d, 4)
				label({
					Text = chip[2],
					Font = Theme.Fonts.UIBold,
					TextSize = 9,
					TextColor3 = colors.Text,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.fromOffset(16, 0),
					Size = UDim2.fromOffset(paletteW - 28, 20),
					ZIndex = 6,
					Parent = chipFrame,
				})
			end
		end

		-- Zone de travail : grille, blocs et note
		local areaX = paletteW
		local areaW = cw - paletteW
		self:_drawPreviewGrid(card, areaX, bodyY, areaW, bodyH, s, colors)

		local stack = frame({
			Name = "Blocs",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(areaX + 10, bodyY + 12),
			Size = UDim2.fromOffset(600, 200),
			ZIndex = 3,
			Parent = card,
		})
		Util.create("UIScale", { Scale = 0.6 * s.blocs.echelle, Parent = stack })
		local evtColor = Reglages.categoryColor("evenements", s)
		local ctrlColor = Reglages.categoryColor("controle", s)
		local vfxColor = Reglages.categoryColor("vfx", s)
		if typeof(evtColor) ~= "Color3" then
			evtColor = Color3.fromRGB(160, 86, 26)
		end
		if typeof(ctrlColor) ~= "Color3" then
			ctrlColor = Color3.fromRGB(154, 103, 0)
		end
		if typeof(vfxColor) ~= "Color3" then
			vfxColor = VFX_COLOR
		end
		local style, corner = s.blocs.style, s.blocs.arrondi
		local by = 0
		by += previewBlock(stack, 0, by, evtColor, { "Quand cet objet est touché" }, style, corner, true, 3)
		by += previewBlock(stack, 0, by, vfxColor, { "explosion de", { kind = "dropdown", text = "étincelles" } }, style, corner, false, 6)
		previewBlock(stack, 0, by, ctrlColor, { "attendre", { kind = "field", text = "1" }, "s" }, style, corner, false, 9)

		-- Note (couleur et taille des nouvelles notes)
		local noteColors = (Theme.NoteColors and Theme.NoteColors[s.notes.couleur]) or nil
		local fond = Color3.fromRGB(253, 230, 138)
		local entete = Color3.fromRGB(252, 211, 77)
		local encre = Color3.fromRGB(66, 32, 6)
		if noteColors then
			fond = noteColors.Fond or fond
			entete = noteColors.Entete or entete
			encre = noteColors.Texte or encre
		end
		local noteW = math.max(80, math.min(132, areaW - 24))
		local textSize = math.max(8, math.floor(s.notes.taille * 0.8 + 0.5))
		local noteText = "Ici : le piège à étincelles du couloir"
		local textH = measure(noteText, textSize, Theme.Fonts.UIBold, noteW - 14)
		local noteH = 16 + textH + 10
		local note = frame({
			Name = "Note",
			BackgroundColor3 = fond,
			Position = UDim2.fromOffset(areaX + 14, math.max(bodyY + 8, ch - noteH - 12)),
			Size = UDim2.fromOffset(noteW, noteH),
			ZIndex = 20,
			Parent = card,
		})
		Util.corner(note, 7)
		local head = frame({
			BackgroundColor3 = entete,
			Size = UDim2.fromOffset(noteW, 16),
			ZIndex = 21,
			Parent = note,
		})
		Util.corner(head, 7)
		frame({
			BackgroundColor3 = entete,
			Position = UDim2.fromOffset(0, 9),
			Size = UDim2.fromOffset(noteW, 7),
			ZIndex = 21,
			Parent = note,
		})
		label({
			Text = "NOTE",
			Font = Theme.Fonts.UIBold,
			TextSize = 8,
			TextColor3 = encre,
			Position = UDim2.fromOffset(7, 0),
			Size = UDim2.fromOffset(noteW - 14, 16),
			ZIndex = 22,
			Parent = head,
		})
		label({
			Text = noteText,
			Font = Theme.Fonts.UIBold,
			TextSize = textSize,
			TextColor3 = encre,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(7, 20),
			Size = UDim2.fromOffset(noteW - 14, textH),
			ZIndex = 22,
			Parent = note,
		})
	end)
	if not ok then
		warn("[Blocs FR] Aperçu des paramètres : " .. tostring(err))
	end
end

---------------------------------------------------------------------------
-- Pied de page
---------------------------------------------------------------------------

function ReglagesPanel:_buildFooter(W, H)
	local C = Theme.Colors
	local footer = self:_give(frame({
		Name = "Pied",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, H - FOOTER_H),
		Size = UDim2.fromOffset(W, FOOTER_H),
		Parent = self.window,
	}))
	frame({
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		Size = UDim2.fromOffset(W, 1),
		Parent = footer,
	})
	local compact = W < 680
	local exportText = "Exporter mes réglages"
	if compact then
		exportText = "Exporter"
	end
	local by = math.floor((FOOTER_H - 34) / 2)
	local x = 14
	local resetButton, resetW = self:_textButton(footer, "Tout réinitialiser", "danger", x, by, 34)
	x += resetW + 8
	local exportButton, exportW = self:_textButton(footer, exportText, "normal", x, by, 34)
	x += exportW + 8
	local importButton = self:_textButton(footer, "Importer", "normal", x, by, 34)

	local applyW = textWidth("Appliquer", 12, Theme.Fonts.UIBold) + 36
	local cancelW = textWidth("Annuler", 12, Theme.Fonts.UIBold) + 28
	local applyButton = self:_textButton(footer, "Appliquer", "primary", W - 14 - applyW, by, 34)
	local cancelButton = self:_textButton(footer, "Annuler", "normal", W - 14 - applyW - 8 - cancelW, by, 34)

	self:_connect(resetButton.MouseButton1Click, function()
		self:_confirmReset()
	end)
	self:_connect(exportButton.MouseButton1Click, function()
		self:_openSheet("export")
	end)
	self:_connect(importButton.MouseButton1Click, function()
		self:_openSheet("import")
	end)
	self:_connect(cancelButton.MouseButton1Click, function()
		self:close()
	end)
	self:_connect(applyButton.MouseButton1Click, function()
		self:_apply()
	end)
end

function ReglagesPanel:_confirmReset()
	local function doReset()
		if self._closed then
			return
		end
		local favoris = Util.deepCopy(self:_get("palette.favoris") or {})
		local fresh = Reglages.defaults()
		fresh.palette.favoris = favoris
		self.draft = Reglages.validate(fresh)
		self:_refreshAll(false)
		self:_toast("Réglages remis à zéro : clique sur « Appliquer » pour les garder.", "info")
	end
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.confirm) == "function" then
		pcall(
			dialogs.confirm,
			dialogs,
			"Tout réinitialiser ?",
			"Tous les réglages reviennent comme au premier jour : thème sombre, couleur bleue, blocs normaux… Tes blocs favoris sont gardés. Rien n'est changé avant que tu cliques sur « Appliquer ».",
			doReset,
			"Réinitialiser",
			"Annuler",
			true
		)
	else
		doReset()
	end
end

function ReglagesPanel:_apply()
	if self._closed then
		return
	end
	local s = Reglages.validate(self.draft)
	local changed = not deepEqual(s, self.initial)
	local onApply = self.deps.onApply
	local host = self.host
	self:close()
	if not changed then
		return
	end
	if type(onApply) == "function" then
		task.spawn(function()
			local ok, err = pcall(onApply, s)
			if not ok then
				warn("[Blocs FR] Paramètres (appliquer) : " .. tostring(err))
			end
		end)
	else
		Reglages.save(host, s)
		Reglages.applyToTheme(s)
	end
end

---------------------------------------------------------------------------
-- Fenêtres « Exporter » / « Importer » (texte à copier-coller)
---------------------------------------------------------------------------

function ReglagesPanel:_closeSheet()
	local sheet = self._sheet
	if sheet == nil then
		return
	end
	self._sheet = nil
	sheet.maid:clean()
end

function ReglagesPanel:_openSheet(mode)
	if self._closed or self.window == nil then
		return
	end
	self:_closeSheet()
	local C = Theme.Colors
	local maid = Util.Maid.new()
	local sheet = { maid = maid }
	self._sheet = sheet
	local isExport = mode == "export"

	local overlay = maid:give(button({
		Name = "FenetreTexte",
		Active = true,
		BackgroundColor3 = C.Overlay,
		BackgroundTransparency = 0.4,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_SHEET,
		Parent = self.window,
	}))
	Util.corner(overlay, 14)
	local boxW = math.min(540, self.W - 40)
	local boxH = math.min(330, self.H - 40)
	local box = button({
		Name = "Boite",
		BackgroundColor3 = C.Popup,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(boxW, boxH),
		Parent = overlay,
	})
	Util.corner(box, 12)
	Util.stroke(box, C.PopupBorder, 1, 0)

	local title = "Importer des réglages"
	local message = "Colle ici le texte de réglages (Ctrl+V), puis clique sur « Importer ». Rien n'est changé avant « Appliquer »."
	if isExport then
		title = "Exporter mes réglages"
		message = "Copie ce texte (Ctrl+A puis Ctrl+C) pour garder tes réglages ou les donner à un ami. Il les colle avec « Importer »."
	end
	label({
		Name = "Titre",
		Text = title,
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.fromOffset(boxW - 36, 22),
		Parent = box,
	})
	local messageH = measure(message, 12, Theme.Fonts.UI, boxW - 36)
	label({
		Name = "Message",
		Text = message,
		TextSize = 12,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(18, 42),
		Size = UDim2.fromOffset(boxW - 36, messageH),
		Parent = box,
	})
	local areaY = 42 + messageH + 10
	local buttonsH = 34
	local errorH = 18
	local areaH = math.max(60, boxH - areaY - 14 - errorH - buttonsH - 14)
	local area = frame({
		Name = "Zone",
		BackgroundColor3 = C.FieldBg,
		Position = UDim2.fromOffset(18, areaY),
		Size = UDim2.fromOffset(boxW - 36, areaH),
		ClipsDescendants = true,
		Parent = box,
	})
	Util.corner(area, 8)
	local areaStroke = Util.stroke(area, C.PopupBorder, 1, 0)
	local content = ""
	if isExport then
		content = Reglages.export(self.draft)
	end
	local textBox = Util.create("TextBox", {
		Name = "Texte",
		Text = content,
		PlaceholderText = "Colle ici le texte de tes réglages (il commence par « " .. Reglages.EXPORT_PREFIX .. " »)",
		PlaceholderColor3 = C.TextDisabled,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextEditable = not isExport,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.Code,
		TextSize = 12,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 1, -16),
		Parent = area,
	})
	maid:give(textBox.Focused:Connect(function()
		areaStroke.Color = C.Accent
		areaStroke.Thickness = 2
	end))
	maid:give(textBox.FocusLost:Connect(function()
		areaStroke.Color = C.PopupBorder
		areaStroke.Thickness = 1
	end))
	if isExport then
		-- lecture seule : le texte revient tout seul s'il a été modifié
		maid:give(textBox:GetPropertyChangedSignal("Text"):Connect(function()
			if textBox.Text ~= content then
				task.defer(function()
					if textBox.Parent ~= nil and textBox.Text ~= content then
						textBox.Text = content
					end
				end)
			end
		end))
	end
	local errorLabel = label({
		Name = "Erreur",
		TextSize = 12,
		TextColor3 = C.DangerText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, areaY + areaH + 6),
		Size = UDim2.fromOffset(boxW - 36, errorH),
		Visible = false,
		Parent = box,
	})

	local by = boxH - 14 - buttonsH
	local function selectAll()
		task.defer(function()
			pcall(function()
				textBox:CaptureFocus()
				textBox.CursorPosition = #textBox.Text + 1
				textBox.SelectionStart = 1
			end)
		end)
	end
	-- (les boutons de la fenêtre texte appartiennent à son maid : ils disparaissent avec elle)
	local function sheetButton(text, style, x, w)
		local bg, hover, textColor = C.Button, C.ButtonHover, C.Text
		if style == "primary" then
			bg, hover, textColor = C.Accent, C.AccentHover, WHITE
		end
		local b = maid:give(button({
			BackgroundColor3 = bg,
			Position = UDim2.fromOffset(x, by),
			Size = UDim2.fromOffset(w, buttonsH),
			Parent = box,
		}))
		Util.corner(b, 8)
		label({
			Text = text,
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextColor3 = textColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = b,
		})
		maid:give(b.MouseEnter:Connect(function()
			b.BackgroundColor3 = hover
		end))
		maid:give(b.MouseLeave:Connect(function()
			b.BackgroundColor3 = bg
		end))
		return b
	end
	local leftText, rightText = "Annuler", "Importer"
	if isExport then
		leftText, rightText = "Tout sélectionner", "Fermer"
	end
	local rightW = textWidth(rightText, 12, Theme.Fonts.UIBold) + 36
	local leftW = textWidth(leftText, 12, Theme.Fonts.UIBold) + 28
	local right = sheetButton(rightText, "primary", boxW - 18 - rightW, rightW)
	local left = sheetButton(leftText, "normal", boxW - 18 - rightW - 8 - leftW, leftW)

	if isExport then
		maid:give(left.MouseButton1Click:Connect(selectAll))
		maid:give(right.MouseButton1Click:Connect(function()
			self:_closeSheet()
		end))
		selectAll()
	else
		maid:give(left.MouseButton1Click:Connect(function()
			self:_closeSheet()
		end))
		maid:give(right.MouseButton1Click:Connect(function()
			local s, err = Reglages.import(textBox.Text)
			if s == nil then
				errorLabel.Text = tostring(err or "Code de réglages invalide.")
				errorLabel.Visible = true
				if Anim and type(Anim.shake) == "function" then
					pcall(Anim.shake, box)
				end
				return
			end
			self.draft = s
			self:_closeSheet()
			self:_refreshAll(false)
			self:_toast("Réglages importés : clique sur « Appliquer » pour les garder.", "success")
		end))
		task.defer(function()
			if self._sheet == sheet and textBox.Parent ~= nil then
				pcall(function()
					textBox:CaptureFocus()
				end)
			end
		end)
	end
	if Anim and type(Anim.popIn) == "function" then
		Anim.popIn(box, 0.96)
	end
end

return ReglagesPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Renderer</string><ProtectedString name="Source"><![CDATA[-- Renderer : dessin et mise en page des blocs (aucune logique de glisser-déposer ici). SPEC §9, §15, §18.
--
-- Fonctionnement en deux étapes :
--   1. un "arbre de mise en page" est calculé (tailles et positions, en unités du canvas,
--      sans créer aucune Instance) : utilisé tel quel par Renderer.measure ;
--   2. l'arbre est instancié : tous les cadres d'une pile sont des enfants directs de view.frame,
--      positionnés en absolu (aucune imbrication d'Instances entre blocs).
--
-- Apparence (design « Blocs FR — interface et logo ») :
--   * lignes de 36 px minimum, marge horizontale 11, espace 6, texte blanc gras 13 px ;
--   * bande plus sombre de 2 px en bas de chaque bloc (Theme.darken(couleur, 0.22)) ;
--   * languette 18×5 (bas arrondi) à x = 14 sous les blocs instruction, dessinée par-dessus le bloc suivant ;
--   * événements : bosse arrondie en haut à gauche, hauteur totale minimale 48 ;
--   * blocs C : bras 16, bouche vide 24, bras du bas 16, ligne « sinon » 30 ;
--   * champs nombre / texte : pilule blanche (22 px, rayon 11, texte foncé 12 px) ;
--     listes : couleur du bloc assombrie (0,26), rayon 6, contour blanc 1 px (transparence 0,8) + « ▾ » ;
--     couleur : pastille 30×18 (rayon 5, contour blanc 2 px) ; case booléenne vide : forme pointue 40×20 ;
--   * blocs valeur : hauteur 26, entièrement arrondis ; conditions : hauteur 30, pointes de 13 px
--     construites avec des bandes horizontales empilées (pas de Rotation : elle ignore le découpage).
--   * opts.problems = { [blockId] = "erreur" | "avertissement" | "conseil" } : contour de 3 px et pastille
--     ronde de 22 px (« ! » ou « i ») en haut à droite du bloc.
--
-- NOTE: ordre d'affichage (ZIndex). Chaque bloc utilise une "bande" de Z_BAND niveaux :
--   0 contour, 1 corps (bouton, couleur de la bande sombre), 2 remplissage, 3 ombre de la languette,
--   4 languette + textes + champs.  ZIndex = profondeur * Z_BAND + niveau + 1.
-- Un bloc imbriqué (profondeur + 1) est donc toujours dessiné au-dessus de son hôte, comme le demande
-- la SPEC (seule la valeur exacte du ZIndex diffère de "1 + profondeur"). Les contours et pastilles de
-- problèmes sont au-dessus de tout (Z_PROBLEM).
--
-- Extensions facultatives de opts.callbacks (en plus de la SPEC §9, utilisées par Canvas) :
--   onWheel(inputObject)                       -- molette au-dessus d'un bloc (zoom du canvas)
--   onFieldFocus(blockId, inputName, focused)  -- un champ texte prend / perd le focus
--   onBodyInput(blockId, inputObject, began)   -- InputBegan / InputEnded du corps d'un bloc (touches
--                                              -- du clavier, touches de modification au clic)
--   getGuiNames(filter) -> { { label, value } } -- champs « gui » (SPEC §21.6), voir plus bas
--   promptText(title, defaultText, onOk)        -- « Autre nom… » des champs « gui »
-- onInputCommit reçoit en 4e argument le modèle qui a dessiné le champ (le projet affiché a pu changer
-- avant l'appel, qui est différé pour les champs texte).
--
-- Champs « gui » (SPEC §21.6) : dessinés comme une liste (pilule plus sombre + « ▼ »), texte = la valeur
-- ou « (choisir) ». Clic : cb.getGuiNames(filter) puis un séparateur et « Autre nom… »
-- (cb.promptText). Sans ces rappels (palette, wiki) le champ n'est pas cliquable. Ils n'acceptent pas
-- de bloc valeur (aucune cible « input »).
--
-- Style des blocs (SPEC §31, lu à chaque dessin dans Theme.Block.Style ; arrondi = Theme.Block.Corner) :
--   relief  = bande sombre en bas + contour de 1 px (le style d'origine) ;
--   plat    = ni bande sombre ni contour ;
--   contour = contour de 2 px (couleur assombrie de 0,35), sans bande sombre ;
--   bonbon  = relief + dégradé vertical (haut plus clair) + arrondi × 1,6 + liseré blanc intérieur.
-- opts.style (facultatif) remplace le style des réglages (aperçus).
--
-- Blocs désactivés (SPEC §32, champ block.disabled) : couleurs mélangées avec le fond du canvas
-- (aspect « 45 % d'opacité », sans voir à travers les cadres superposés), hachures en diagonale
-- (des « / » très légers, découpés à la taille du bloc) et étiquette « désactivé ». Les blocs placés
-- dans un bloc désactivé (corps, entrées, pile d'un événement désactivé) sont seulement estompés.
--
-- Renderer.blockPositions(model, headId) -> { [blockId] = { x, y, w, h } } (NOTE: ajout à la SPEC) :
-- position de chaque bloc de la pile par rapport à son coin haut-gauche, sans créer d'Instance (les
-- notes du canvas suivent ainsi leur bloc quand les piles bougent).

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local Model = require(script.Parent.Model)

local Renderer = {}

local B = Theme.Block
local FONT = Theme.Fonts.Block
local TEXT_SIZE = Theme.TextSize.Block
local FIELD_FONT = Enum.Font.GothamMedium
local MENU_FONT = Theme.Fonts.Block
local FIELD_TEXT_SIZE = B.FieldTextSize or 12
local WHITE = Color3.fromRGB(255, 255, 255)
local DARK_TEXT = Color3.fromRGB(31, 31, 35)
local UNKNOWN_COLOR = Color3.fromRGB(120, 120, 120)
-- (couleurs du thème lues à chaque dessin : les réglages peuvent changer le thème sans recharger)

local MAX_DEPTH = 40 -- profondeur d'imbrication maximale dessinée
local MAX_CHAIN = 5000 -- garde-fou contre les chaînes cycliques
local STRIP = 2 -- hauteur des bandes qui dessinent les bouts pointus
local REPORTER_PAD_Y = 2
local MIN_STACK_WIDTH = 40
local HAT_MIN_WIDTH = 110
local BUMP_WIDTH = 84
local MAX_FIELD_TEXT_WIDTH = 240 -- largeur maximale du texte affiché dans un champ
local MAX_EDIT_WIDTH = 420 -- largeur maximale d'un champ pendant la saisie
local SHADE = B.BottomShade or 2
local SHADE_DARKEN = B.BottomShadeDarken or 0.22
local DROPDOWN_DARKEN = B.DropdownDarken or 0.26
local SLOT_DARKEN = 0.32
local TAB_RADIUS = 4
local Z_BAND = 5
local Z_PROBLEM = 10000
local BADGE_SIZE = 22
local GUI_EMPTY_TEXT = "(choisir)" -- champ « gui » vide
local OTHER_NAME = "\0BlocsFR_autre_nom" -- ligne « Autre nom… » du menu d'un champ « gui »
local DISABLED_MIX = 0.55 -- bloc désactivé : couleurs à 45 % (mélangées avec le fond)
local HATCH_TRANSPARENCY = 0.78 -- hachures d'un bloc désactivé
local DISABLED_TAG = "désactivé"
local GLOSS_LIGHTEN = 0.22 -- style « bonbon » : haut du dégradé plus clair
local BONBON_RADIUS = 1.6

-- Couleurs des problèmes : clés de Theme.Colors, lues au moment du dessin
local SEVERITY_KEYS = {
	erreur = "Danger",
	avertissement = "Warning",
	conseil = "Info",
}

local STYLES = { relief = true, plat = true, contour = true, bonbon = true }

local SEVERITY_GLYPHS = {
	erreur = "!",
	avertissement = "!",
	conseil = "i",
}

---------------------------------------------------------------------------
-- Petites fonctions utilitaires
---------------------------------------------------------------------------

local function measureText(text)
	local v = Util.textSize(tostring(text), TEXT_SIZE, FONT)
	return math.ceil(v.X), math.max(math.ceil(v.Y), TEXT_SIZE)
end

local function fieldTextWidth(text, font)
	return math.ceil(Util.textSize(tostring(text), FIELD_TEXT_SIZE, font).X)
end

-- Raccourcit un texte (avec « … ») pour qu'il tienne dans maxW pixels
local function truncateText(text, font, maxW)
	text = tostring(text)
	if fieldTextWidth(text, font) <= maxW then
		return text
	end
	local ok, result = pcall(function()
		local chars = {}
		for _, cp in utf8.codes(text) do
			table.insert(chars, utf8.char(cp))
		end
		local lo, hi = 0, #chars
		while lo < hi do
			local mid = math.floor((lo + hi + 1) / 2)
			local candidate = table.concat(chars, "", 1, mid) .. "…"
			if fieldTextWidth(candidate, font) <= maxW then
				lo = mid
			else
				hi = mid - 1
			end
		end
		return table.concat(chars, "", 1, lo) .. "…"
	end)
	if ok and type(result) == "string" then
		return result
	end
	return text
end

local function getBlock(model, id)
	if model == nil or id == nil then
		return nil
	end
	local blocks = model.blocks
	if type(blocks) ~= "table" then
		return nil
	end
	return blocks[id]
end

local function getDef(defId)
	if type(defId) ~= "string" then
		return nil
	end
	local ok, def = pcall(Registry.get, defId)
	if ok then
		return def
	end
	return nil
end

local function categoryColor(def)
	if def == nil then
		return UNKNOWN_COLOR
	end
	local ok, color = pcall(Registry.color, def)
	if ok and typeof(color) == "Color3" then
		return color
	end
	return UNKNOWN_COLOR
end

-- Nombre -> texte affiché (sans parenthèses, sans zéros inutiles)
local function formatNumber(v)
	local n = tonumber(v)
	if n == nil then
		if v == nil then
			return "0"
		end
		return tostring(v)
	end
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	if n == math.floor(n) and math.abs(n) < 1e15 then
		return string.format("%d", n)
	end
	local s = string.format("%.6f", n)
	s = (string.gsub(s, "0+$", ""))
	s = (string.gsub(s, "%.$", ""))
	if s == "-0" then
		s = "0"
	end
	return s
end

local function valueToText(v)
	if v == nil then
		return ""
	end
	if type(v) == "number" then
		return formatNumber(v)
	end
	if type(v) == "table" then
		return ""
	end
	return tostring(v)
end

-- {r, g, b} 0-255 normalisé, ou nil si la valeur n'est pas une couleur
local function toRgb(v)
	if typeof(v) == "Color3" then
		return Util.color3ToRgb(v)
	end
	if type(v) == "table" then
		local r = tonumber(v[1] or v.r or v.R)
		local g = tonumber(v[2] or v.g or v.G)
		local b = tonumber(v[3] or v.b or v.B)
		if r and g and b then
			return {
				math.floor(Util.clamp(r, 0, 255) + 0.5),
				math.floor(Util.clamp(g, 0, 255) + 0.5),
				math.floor(Util.clamp(b, 0, 255) + 0.5),
			}
		end
	end
	return nil
end

local function dropdownLabel(spec, value)
	local options = spec.options
	if type(options) == "table" then
		for _, opt in ipairs(options) do
			if type(opt) == "table" and opt[2] == value then
				return tostring(opt[1])
			end
		end
		if value == nil then
			local first = options[1]
			if type(first) == "table" then
				return tostring(first[1])
			end
		end
	end
	if value == nil then
		return "?"
	end
	return tostring(value)
end

local function acceptsReporter(spec)
	local kind = spec.kind
	if kind == "variable" or kind == "gui" then
		return false
	end
	if kind == "dropdown" then
		return spec.acceptReporter == true
	end
	return true
end

-- Style des blocs des réglages (Theme.Block.Style), "relief" si inconnu
local function currentStyle()
	local style = B.Style
	if type(style) == "string" and STYLES[style] then
		return style
	end
	return "relief"
end

-- Bande sombre en bas des blocs ? (styles « relief » et « bonbon »)
local function styleHasShade(style)
	return style == "relief" or style == "bonbon"
end

---------------------------------------------------------------------------
-- Analyse des libellés : "attendre %1 secondes" -> { texte, entrée 1, texte }
---------------------------------------------------------------------------
local labelCache = {}

local function pushText(items, text)
	text = Util.trim(text)
	if text ~= "" then
		table.insert(items, { kind = "text", text = text })
	end
end

local function parseLabel(label)
	if type(label) ~= "string" then
		return {}
	end
	local cached = labelCache[label]
	if cached then
		return cached
	end
	local items = {}
	local pos = 1
	while true do
		local s, e, digit = string.find(label, "%%(%d)", pos)
		if not s then
			break
		end
		pushText(items, string.sub(label, pos, s - 1))
		table.insert(items, { kind = "input", index = tonumber(digit) })
		pos = e + 1
	end
	pushText(items, string.sub(label, pos))
	labelCache[label] = items
	return items
end

---------------------------------------------------------------------------
-- Mise en page (aucune Instance créée)
---------------------------------------------------------------------------

-- Champ littéral (éditeur) d'une entrée
local function layoutField(spec, state)
	local value = nil
	if type(state) == "table" then
		value = state.value
	end
	if value == nil then
		value = spec.default
	end
	local kind = spec.kind
	local item = { kind = "field", spec = spec, value = value, h = B.FieldHeight }
	if kind == "boolean" then
		item.editor = "bool"
		item.w = B.BoolSlotWidth
		item.h = B.BoolSlotHeight
	elseif kind == "color" then
		item.editor = "color"
		item.w = B.ColorSwatchWidth
		item.h = B.ColorSwatchHeight
		item.rgb = toRgb(value) or { 255, 255, 255 }
	elseif kind == "dropdown" or kind == "variable" or kind == "gui" then
		item.editor = "menu"
		local label
		if kind == "dropdown" then
			label = dropdownLabel(spec, value)
		elseif kind == "gui" then
			-- nom d'un écran / élément du Studio d'interface (SPEC §21.6)
			if value == nil or value == "" then
				label = GUI_EMPTY_TEXT
			else
				label = tostring(value)
			end
		elseif value == nil or value == "" then
			label = "ma variable"
		else
			label = tostring(value)
		end
		label = truncateText(label, MENU_FONT, MAX_FIELD_TEXT_WIDTH)
		item.text = label .. " ▼"
		local tw = fieldTextWidth(item.text, MENU_FONT)
		item.w = math.max(B.FieldMinWidth, tw + 2 * B.FieldPadX)
	else
		item.editor = "text"
		if kind == "number" then
			item.text = formatNumber(value)
		else
			item.text = valueToText(value)
		end
		local tw = fieldTextWidth(item.text, FIELD_FONT)
		if tw > MAX_FIELD_TEXT_WIDTH then
			item.overflow = true
			tw = MAX_FIELD_TEXT_WIDTH
		end
		item.w = math.max(B.FieldMinWidth, tw + 2 * B.FieldPadX)
	end
	return item
end

-- Bloc de remplacement (définition inconnue, bloc manquant, imbrication trop profonde)
local function staticNode(id, depth, text)
	local w, h = measureText(text)
	local rowH = math.max(B.RowMinHeight, h + 2 * B.PadY)
	local width = math.max(MIN_STACK_WIDTH, w + 2 * B.PadX)
	return {
		id = id,
		depth = depth,
		shape = "stack",
		color = UNKNOWN_COLOR,
		outline = Theme.darken(UNKNOWN_COLOR, 0.25),
		shade = Theme.darken(UNKNOWN_COLOR, SHADE_DARKEN),
		isValue = false,
		isHat = false,
		isStatement = true,
		canNext = false,
		unknown = true,
		point = 0,
		w = width,
		h = rowH,
		extentW = width,
		subs = {},
		tabs = {},
		parts = {
			{
				x = 0,
				y = 0,
				w = width,
				h = rowH,
				r = B.Corner,
				main = true,
				shaded = true,
				padX = B.PadX,
				items = { { kind = "text", text = text, x = 0, w = w, h = h } },
			},
		},
	}
end

local layoutBlock -- déclarations anticipées (récursion)
local layoutChain

-- Éléments d'une ligne (textes, champs, blocs valeur branchés). Renvoie items, largeur, hauteur max.
local function layoutItems(ctx, node, def, block, labelItems)
	local out = {}
	local x = 0
	local maxH = 0
	local inputs = (type(block.inputs) == "table") and block.inputs or {}
	for i, li in ipairs(labelItems) do
		local item
		if li.kind == "text" then
			local w, h = measureText(li.text)
			item = { kind = "text", text = li.text, w = w, h = h }
		else
			local spec = def.inputs and def.inputs[li.index]
			if type(spec) ~= "table" then
				local w, h = measureText("?")
				item = { kind = "text", text = "?", w = w, h = h }
			else
				local state = inputs[spec.name]
				local childId = (type(state) == "table") and state.block or nil
				local child = nil
				if childId ~= nil and getBlock(ctx.model, childId) ~= nil and not ctx.visited[childId] then
					-- une valeur branchée dans un bloc désactivé est désactivée elle aussi
					child = layoutBlock(ctx, childId, node.depth + 1, def.category, node.disabled)
				end
				if child then
					item = { kind = "reporter", spec = spec, child = child, w = child.w, h = child.h }
				else
					item = layoutField(spec, state)
				end
			end
		end
		if i > 1 then
			x += B.Gap
		end
		item.x = x
		x += item.w
		if item.h > maxH then
			maxH = item.h
		end
		table.insert(out, item)
	end
	return out, x, maxH
end

-- inherited = true : le bloc est dans un bloc désactivé (corps, entrée, pile d'un événement désactivé)
layoutBlock = function(ctx, id, depth, hostCategory, inherited)
	local block = getBlock(ctx.model, id)
	if block == nil then
		return staticNode(id, depth, "bloc manquant")
	end
	if depth > MAX_DEPTH then
		return staticNode(id, depth, "…")
	end
	ctx.visited[id] = true
	local def = getDef(block.def)
	if def == nil then
		return staticNode(id, depth, "bloc inconnu (" .. tostring(block.def) .. ")")
	end

	local shape = def.shape
	local color = categoryColor(def)
	local ownDisabled = block.disabled == true
	local node = {
		id = id,
		depth = depth,
		def = def,
		shape = shape,
		color = color,
		point = 0,
		subs = {},
		parts = {},
		tabs = {},
		ownDisabled = ownDisabled,
		disabled = ownDisabled or inherited == true,
	}
	node.isValue = (shape == "reporter" or shape == "boolean")
	node.isHat = (shape == "hat")
	node.isStatement = not node.isValue
	node.canNext = node.isStatement and def.noNext ~= true and shape ~= "cap"
	if node.isValue and hostCategory ~= nil and hostCategory == def.category then
		-- valeur branchée dans un bloc de la même catégorie : contour plus foncé
		node.outline = Theme.darken(color, 0.45)
	else
		node.outline = Theme.darken(color, 0.25)
	end
	node.shade = Theme.darken(color, SHADE_DARKEN)

	local items, contentW, contentH = layoutItems(ctx, node, def, block, parseLabel(def.label))

	if node.isValue then
		local isBool = (shape == "boolean")
		local minH = B.ReporterMinHeight
		if isBool then
			minH = B.BooleanMinHeight
		end
		local h = math.max(minH, contentH + 2 * REPORTER_PAD_Y)
		local padX
		local minW
		if isBool then
			node.point = math.max(B.BoolPointWidth, math.floor(h * B.BoolPointWidth / B.BooleanMinHeight + 0.5))
			padX = node.point + 3
			minW = 2 * node.point + 14
		else
			padX = math.max(B.ReporterPadX, math.floor(h * 0.3))
			minW = h + 8
		end
		local w = math.max(contentW + 2 * padX, minW)
		node.w = w
		node.h = h
		table.insert(node.parts, {
			x = 0,
			y = 0,
			w = w,
			h = h,
			r = math.floor(h / 2),
			main = true,
			shaded = true,
			items = items,
			padX = padX,
			contentX = math.floor((w - contentW) / 2),
			pointed = isBool,
		})
	elseif shape == "c" or shape == "c2" then
		local rowH = math.max(B.RowMinHeight, contentH + 2 * B.PadY)
		local width = math.max(B.BottomArmMinWidth, contentW + 2 * B.PadX)
		local midItems = nil
		local midH = 0
		if shape == "c2" then
			local label2 = (type(def.label2) == "string") and def.label2 or "sinon"
			local tw, th = measureText(label2)
			midItems = { { kind = "text", text = label2, x = 0, w = tw, h = th } }
			midH = th
			width = math.max(width, tw + 2 * B.PadX)
		end
		local sub = (type(block.sub) == "table") and block.sub or {}
		local extent = width
		table.insert(node.parts, {
			x = 0,
			y = 0,
			w = width,
			h = rowH,
			r = B.Corner,
			main = true,
			shaded = true,
			items = items,
			padX = B.PadX,
		})
		local y = rowH
		local function addMouth(slot)
			-- languette de la ligne du dessus, dessinée par-dessus le premier bloc du corps
			table.insert(node.tabs, { x = B.ArmWidth + B.NotchOffset, y = y, depth = depth + 1 })
			local chain = nil
			local childId = sub[slot]
			if childId ~= nil and getBlock(ctx.model, childId) ~= nil and not ctx.visited[childId] then
				chain = layoutChain(ctx, childId, depth + 1, nil, node.disabled)
			end
			local mouthH = B.MouthMinHeight
			if chain and chain.h > mouthH then
				mouthH = chain.h
			end
			if chain and B.ArmWidth + chain.w > extent then
				extent = B.ArmWidth + chain.w
			end
			table.insert(node.subs, { slot = slot, x = B.ArmWidth, y = y, chain = chain, h = mouthH })
			-- bras gauche (déborde sur les lignes voisines pour masquer leurs coins arrondis)
			table.insert(node.parts, {
				x = 0,
				y = y - B.Corner,
				w = B.ArmWidth,
				h = mouthH + 2 * B.Corner,
				r = B.Corner,
				overlap = B.Corner,
			})
			y += mouthH
		end
		addMouth("DO")
		if shape == "c2" then
			local midRowH = math.max(B.MiddleArmMinHeight, midH + 2 * B.PadY)
			table.insert(node.parts, {
				x = 0,
				y = y,
				w = width,
				h = midRowH,
				r = B.Corner,
				shaded = true,
				items = midItems,
				padX = B.PadX,
			})
			y += midRowH
			addMouth("ELSE")
		end
		table.insert(node.parts, {
			x = 0,
			y = y,
			w = width,
			h = B.BottomArmHeight,
			r = B.Corner,
			shaded = true,
		})
		y += B.BottomArmHeight
		node.w = width
		node.h = y
		node.extentW = extent
		if node.canNext then
			table.insert(node.tabs, { x = B.NotchOffset, y = y, depth = depth })
		end
	elseif shape == "hat" then
		local rowH = math.max(B.RowMinHeight, contentH + 2 * B.PadY)
		local width = math.max(HAT_MIN_WIDTH, contentW + 2 * B.PadX)
		-- bosse arrondie en haut à gauche (le corps recouvre ses coins du bas)
		table.insert(node.parts, {
			x = 0,
			y = 0,
			w = math.min(BUMP_WIDTH, width),
			h = B.HatBump + B.HatRadius + 4,
			r = B.HatRadius,
			bump = true,
		})
		table.insert(node.parts, {
			x = 0,
			y = B.HatBump,
			w = width,
			h = rowH,
			r = B.Corner,
			main = true,
			shaded = true,
			items = items,
			padX = B.PadX,
		})
		node.w = width
		node.h = B.HatBump + rowH
		if node.canNext then
			table.insert(node.tabs, { x = B.NotchOffset, y = node.h, depth = depth })
		end
	else
		-- stack / cap
		local rowH = math.max(B.RowMinHeight, contentH + 2 * B.PadY)
		local width = math.max(MIN_STACK_WIDTH, contentW + 2 * B.PadX)
		table.insert(node.parts, {
			x = 0,
			y = 0,
			w = width,
			h = rowH,
			r = B.Corner,
			main = true,
			shaded = true,
			items = items,
			padX = B.PadX,
		})
		node.w = width
		node.h = rowH
		if node.canNext then
			table.insert(node.tabs, { x = B.NotchOffset, y = rowH, depth = depth })
		end
	end
	node.extentW = node.extentW or node.w
	return node
end

-- Chaîne de blocs reliés par "next" (un bloc valeur n'a jamais de suivant).
-- inherited = true : toute la chaîne est dans un bloc désactivé ; un événement désactivé désactive
-- aussi la pile qui le suit (comme CodeGen).
layoutChain = function(ctx, headId, depth, hostCategory, inherited)
	local chain = { nodes = {}, w = 0, h = 0 }
	local id = headId
	local y = 0
	local count = 0
	local chainInherited = inherited == true
	while id ~= nil and count < MAX_CHAIN do
		if ctx.visited[id] then
			break
		end
		local block = getBlock(ctx.model, id)
		if block == nil then
			break
		end
		count += 1
		local node = layoutBlock(ctx, id, depth, hostCategory, chainInherited)
		if node.isHat and node.ownDisabled then
			chainInherited = true
		end
		node.y = y
		node.first = (count == 1)
		table.insert(chain.nodes, node)
		y += node.h
		local extent = node.extentW or node.w
		if extent > chain.w then
			chain.w = extent
		end
		if node.isValue then
			break
		end
		ctx.visited[id] = true
		id = block.next
	end
	chain.h = y
	return chain
end

local function layoutRoot(model, headId)
	local ctx = { model = model, visited = {} }
	if getBlock(model, headId) == nil then
		local node = staticNode(headId, 0, "bloc inconnu (" .. tostring(headId) .. ")")
		node.y = 0
		node.first = true
		return { nodes = { node }, w = node.w, h = node.h }
	end
	local chain = layoutChain(ctx, headId, 0, nil, false)
	if #chain.nodes == 0 then
		local node = staticNode(headId, 0, "bloc inconnu (" .. tostring(headId) .. ")")
		node.y = 0
		node.first = true
		return { nodes = { node }, w = node.w, h = node.h }
	end
	return chain
end

---------------------------------------------------------------------------
-- Instanciation
---------------------------------------------------------------------------

local function zOf(depth, level)
	return depth * Z_BAND + level + 1
end

local function safeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Blocs FR] Renderer : " .. tostring(err))
	end
end

local function connect(ctx, signal, fn)
	local connection = signal:Connect(fn)
	table.insert(ctx.connections, connection)
	return connection
end

-- Couleur d'un bloc désactivé en cours de dessin (ctx.dim) : mélangée avec le fond du canvas
local function tint(ctx, color)
	if ctx.dim and typeof(color) == "Color3" then
		return color:Lerp(ctx.dimBg, DISABLED_MIX)
	end
	return color
end

-- Cadre décoratif (ne capte jamais les clics), enfant direct de view.frame
local function newFrame(ctx, props)
	props.BorderSizePixel = 0
	if props.Active == nil then
		props.Active = false
	end
	if props.BackgroundColor3 ~= nil then
		props.BackgroundColor3 = tint(ctx, props.BackgroundColor3)
	end
	props.Parent = ctx.frame
	return Util.create("Frame", props)
end

-- Relie les événements d'un corps de bloc aux rappels
local function bindBody(ctx, button, blockId)
	if blockId == nil then
		return
	end
	local cb = ctx.callbacks
	if type(cb.onBlockPointerDown) == "function" then
		connect(ctx, button.MouseButton1Down, function()
			safeCall(cb.onBlockPointerDown, blockId)
		end)
	end
	if type(cb.onBlockContextMenu) == "function" then
		connect(ctx, button.MouseButton2Click, function()
			safeCall(cb.onBlockContextMenu, blockId)
		end)
	end
	if type(cb.onHover) == "function" then
		connect(ctx, button.MouseEnter, function()
			safeCall(cb.onHover, blockId, true)
		end)
		connect(ctx, button.MouseLeave, function()
			safeCall(cb.onHover, blockId, false)
		end)
	end
	if type(cb.onWheel) == "function" then
		connect(ctx, button.InputChanged, function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				safeCall(cb.onWheel, input)
			end
		end)
	end
	if type(cb.onBodyInput) == "function" then
		connect(ctx, button.InputBegan, function(input)
			safeCall(cb.onBodyInput, blockId, input, true)
		end)
		connect(ctx, button.InputEnded, function(input)
			safeCall(cb.onBodyInput, blockId, input, false)
		end)
	end
end

-- Corps cliquable d'un bloc (TextButton sans texte)
local function makeBody(ctx, blockId, x, y, w, h, color, radius, zIndex, transparent)
	local button = Util.create("TextButton", {
		Name = "Bloc_" .. tostring(blockId),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = tint(ctx, color),
		BackgroundTransparency = transparent and 1 or 0,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = zIndex,
		Parent = ctx.frame,
	})
	if radius and radius > 0 then
		Util.corner(button, radius)
	end
	bindBody(ctx, button, blockId)
	return button
end

-- Forme pointue (bloc condition / case booléenne) : un rectangle central et deux pointes faites de
-- bandes horizontales de STRIP px. shadeColor (facultatif) colore les STRIP derniers pixels du bas.
local function drawPointed(ctx, x, y, w, h, point, color, shadeColor, zIndex)
	if w <= 0 or h <= 0 then
		return
	end
	point = math.max(0, math.min(point, math.floor(w / 2)))
	local half = h / 2
	local midX = x + point - 1
	local midW = w - 2 * point + 2
	if point <= 0 then
		midX = x
		midW = w
	end
	local mainH = h
	if shadeColor and h > SHADE then
		mainH = h - SHADE
	end
	if midW > 0 then
		newFrame(ctx, {
			Name = "Forme",
			BackgroundColor3 = color,
			Position = UDim2.fromOffset(midX, y),
			Size = UDim2.fromOffset(midW, mainH),
			ZIndex = zIndex,
		})
		if mainH < h then
			newFrame(ctx, {
				Name = "Ombre",
				BackgroundColor3 = shadeColor,
				Position = UDim2.fromOffset(midX, y + mainH),
				Size = UDim2.fromOffset(midW, h - mainH),
				ZIndex = zIndex,
			})
		end
	end
	if point <= 0 or half <= 0 then
		return
	end
	local sy = 0
	while sy < h do
		local sh = math.min(STRIP, h - sy)
		local yc = sy + sh / 2
		local inset = math.floor(point * math.abs(yc - half) / half + 0.5)
		local sw = point - inset
		if sw > 0 then
			local c = color
			if shadeColor and sy >= mainH then
				c = shadeColor
			end
			newFrame(ctx, {
				Name = "Pointe",
				BackgroundColor3 = c,
				Position = UDim2.fromOffset(x + inset, y + sy),
				Size = UDim2.fromOffset(sw, sh),
				ZIndex = zIndex,
			})
			newFrame(ctx, {
				Name = "Pointe",
				BackgroundColor3 = c,
				Position = UDim2.fromOffset(x + w - point, y + sy),
				Size = UDim2.fromOffset(sw, sh),
				ZIndex = zIndex,
			})
		end
		sy += sh
	end
end

-- Languette sous un bloc instruction (y = bas du bloc) : couleur du bloc + bord inférieur sombre
-- (sans bord sombre pour les styles « plat » et « contour »)
local function drawTab(ctx, x, y, color, shade, depth)
	local w = B.NotchWidth
	local h = B.NotchHeight + 4
	local frontH = h
	if ctx.shadeOn then
		local back = newFrame(ctx, {
			Name = "Languette",
			BackgroundColor3 = shade,
			Position = UDim2.fromOffset(x, y - 4),
			Size = UDim2.fromOffset(w, h),
			ZIndex = zOf(depth, 3),
		})
		Util.corner(back, TAB_RADIUS)
		frontH = h - SHADE
	end
	local front = newFrame(ctx, {
		Name = "Languette",
		BackgroundColor3 = color,
		Position = UDim2.fromOffset(x, y - 4),
		Size = UDim2.fromOffset(w, frontH),
		ZIndex = zOf(depth, 4),
	})
	Util.corner(front, TAB_RADIUS)
end

local function drawText(ctx, depth, item, x, y)
	Util.create("TextLabel", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Font = FONT,
		TextSize = TEXT_SIZE,
		TextColor3 = tint(ctx, WHITE),
		Text = item.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(item.w + 2, item.h),
		ZIndex = zOf(depth, 4),
		Parent = ctx.frame,
	})
end

-- Champ nombre / texte : pilule blanche (TextBox si interactif, sinon étiquette)
local function drawTextField(ctx, node, item, x, y, z)
	local spec = item.spec
	local cb = ctx.callbacks
	local radius = math.floor(item.h / 2)
	local align = Enum.TextXAlignment.Center
	if item.overflow then
		align = Enum.TextXAlignment.Left
	end
	if not ctx.interactive or node.unknown then
		local label = Util.create("TextLabel", {
			Name = "Champ",
			BackgroundColor3 = tint(ctx, ctx.fieldBg),
			BorderSizePixel = 0,
			Active = false,
			Font = FIELD_FONT,
			TextSize = FIELD_TEXT_SIZE,
			TextColor3 = tint(ctx, ctx.fieldText),
			Text = item.text,
			TextXAlignment = align,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(item.w, item.h),
			ZIndex = z,
			Parent = ctx.frame,
		})
		Util.corner(label, radius)
		Util.create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			Parent = label,
		})
		return label
	end

	local box = Util.create("TextBox", {
		Name = "Champ_" .. tostring(spec.name),
		BackgroundColor3 = tint(ctx, ctx.fieldBg),
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		MultiLine = false,
		TextEditable = true,
		Font = FIELD_FONT,
		TextSize = FIELD_TEXT_SIZE,
		TextColor3 = tint(ctx, ctx.fieldText),
		PlaceholderText = "",
		Text = item.text,
		TextXAlignment = align,
		TextYAlignment = Enum.TextYAlignment.Center,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(item.w, item.h),
		ZIndex = z,
		Parent = ctx.frame,
	})
	Util.corner(box, radius)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		Parent = box,
	})
	local focusStroke = Util.stroke(box, ctx.focusColor, 2, 0)
	focusStroke.Enabled = false

	local blockId = node.id
	local inputName = spec.name
	local function restore()
		box.Text = item.text
		box.Size = UDim2.fromOffset(item.w, item.h)
	end

	connect(ctx, box.Focused, function()
		focusStroke.Enabled = true
		safeCall(cb.onFieldFocus, blockId, inputName, true)
	end)
	-- le champ s'élargit pendant la saisie
	connect(ctx, box:GetPropertyChangedSignal("Text"), function()
		if not box:IsFocused() then
			return
		end
		local tw = fieldTextWidth(box.Text, FIELD_FONT)
		local w = math.max(item.w, math.min(tw + 2 * B.FieldPadX + 4, MAX_EDIT_WIDTH))
		box.Size = UDim2.fromOffset(w, item.h)
	end)
	-- NOTE: le rappel onInputCommit est différé (task.defer) : il provoque un nouveau dessin qui
	-- détruit ce TextBox, ce qui est interdit pendant son propre FocusLost.
	connect(ctx, box.FocusLost, function()
		focusStroke.Enabled = false
		safeCall(cb.onFieldFocus, blockId, inputName, false)
		local text = box.Text
		local newValue
		if spec.kind == "number" then
			local n = Util.parseNumber(text)
			if n == nil or n ~= n or n == math.huge or n == -math.huge then
				restore()
				return
			end
			if tonumber(item.value) == n then
				restore()
				return
			end
			newValue = n
		else
			if text == valueToText(item.value) then
				box.Size = UDim2.fromOffset(item.w, item.h)
				return
			end
			newValue = text
		end
		if type(cb.onInputCommit) == "function" then
			-- le champ peut rester affiché jusqu'au prochain dessin (Canvas le reporte pendant la saisie
			-- dans un autre champ) : il garde la valeur envoyée pour comparer et restaurer correctement
			item.value = newValue
			item.text = text
			task.defer(safeCall, cb.onInputCommit, blockId, inputName, newValue, ctx.model)
		end
	end)
	return box
end

-- Lignes du menu d'un champ « gui » : noms donnés par cb.getGuiNames(filtre), puis « Autre nom… »
-- (cb.promptText). Renvoie nil si rien ne peut être proposé.
local function guiMenuEntries(cb, spec, current)
	local entries = {}
	if type(cb.getGuiNames) == "function" then
		local ok, list = pcall(cb.getGuiNames, spec.filter or "element")
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.value ~= nil then
					table.insert(entries, {
						label = tostring(entry.label or entry.value),
						value = entry.value,
						checked = entry.value == current,
					})
				elseif type(entry) == "string" and entry ~= "" then
					table.insert(entries, { label = entry, value = entry, checked = entry == current })
				end
			end
		end
	end
	if type(cb.promptText) == "function" then
		if #entries > 0 then
			table.insert(entries, "separator")
		end
		table.insert(entries, { label = "Autre nom…", value = OTHER_NAME })
	end
	if #entries == 0 then
		return nil
	end
	return entries
end

-- Liste (dropdown / variable / gui) : couleur du bloc assombrie, contour blanc léger, « ▼ »
local function drawMenuField(ctx, node, item, x, y, z)
	local spec = item.spec
	local cb = ctx.callbacks
	local bg = tint(ctx, Theme.darken(node.color, DROPDOWN_DARKEN))
	local interactive = ctx.interactive and not node.unknown
	if interactive and spec.kind == "gui" and type(cb.getGuiNames) ~= "function" and type(cb.promptText) ~= "function" then
		-- (palette, wiki : pas de liste des écrans) le champ n'est pas cliquable
		interactive = false
	end
	local props = {
		Name = "Liste",
		BackgroundColor3 = bg,
		BorderSizePixel = 0,
		Font = MENU_FONT,
		TextSize = FIELD_TEXT_SIZE,
		TextColor3 = tint(ctx, WHITE),
		Text = item.text,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(item.w, item.h),
		ZIndex = z,
		Parent = ctx.frame,
	}
	local field
	if interactive then
		props.AutoButtonColor = false
		field = Util.create("TextButton", props)
	else
		props.Active = false
		field = Util.create("TextLabel", props)
	end
	Util.corner(field, B.DropdownRadius or 6)
	Util.stroke(field, tint(ctx, WHITE), 1, 0.8)
	if not interactive then
		return field
	end

	local blockId = node.id
	local inputName = spec.name
	local hoverBg = tint(ctx, Theme.darken(node.color, DROPDOWN_DARKEN + 0.12))
	connect(ctx, field.MouseEnter, function()
		field.BackgroundColor3 = hoverBg
	end)
	connect(ctx, field.MouseLeave, function()
		field.BackgroundColor3 = bg
	end)
	connect(ctx, field.MouseButton1Click, function()
		if type(cb.openMenu) ~= "function" then
			return
		end
		local pos = field.AbsolutePosition + Vector2.new(0, field.AbsoluteSize.Y + 2)
		if spec.kind == "gui" then
			local entries = guiMenuEntries(cb, spec, item.value)
			if entries == nil then
				return
			end
			safeCall(cb.openMenu, pos, entries, function(choice)
				if choice == OTHER_NAME then
					local current = item.value
					if type(current) ~= "string" then
						current = ""
					end
					local title = "Nom de l'élément"
					if spec.filter == "ecran" then
						title = "Nom de l'écran"
					end
					safeCall(cb.promptText, title, current, function(text)
						if type(text) ~= "string" then
							return
						end
						text = Util.trim(text)
						if text == "" or text == item.value then
							return
						end
						safeCall(cb.onInputCommit, blockId, inputName, text, ctx.model)
					end)
					return
				end
				if choice == nil or choice == item.value then
					return
				end
				safeCall(cb.onInputCommit, blockId, inputName, choice, ctx.model)
			end)
			return
		end
		local entries = {}
		if spec.kind == "dropdown" then
			for _, opt in ipairs(spec.options or {}) do
				if type(opt) == "table" then
					table.insert(entries, { label = tostring(opt[1]), value = opt[2], checked = opt[2] == item.value })
				end
			end
		else
			local vars = {}
			if type(cb.getVariables) == "function" then
				local ok, list = pcall(cb.getVariables)
				if ok and type(list) == "table" then
					vars = list
				end
			end
			for _, name in ipairs(vars) do
				table.insert(entries, { label = tostring(name), value = name, checked = name == item.value })
			end
			if #entries == 0 and item.value ~= nil then
				table.insert(entries, { label = tostring(item.value), value = item.value })
			end
		end
		if #entries == 0 then
			return
		end
		safeCall(cb.openMenu, pos, entries, function(choice)
			if choice == nil or choice == item.value then
				return
			end
			safeCall(cb.onInputCommit, blockId, inputName, choice, ctx.model)
		end)
	end)
	return field
end

-- Pastille de couleur 30×18 (contour blanc 2 px) ; ouvre le sélecteur de couleur
local function drawColorField(ctx, node, item, x, y, z)
	local spec = item.spec
	local cb = ctx.callbacks
	local rgb = item.rgb
	local interactive = ctx.interactive and not node.unknown
	local props = {
		Name = "Couleur",
		BackgroundColor3 = tint(ctx, Color3.fromRGB(rgb[1], rgb[2], rgb[3])),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(item.w, item.h),
		ZIndex = z,
		Parent = ctx.frame,
	}
	local field
	if interactive then
		props.Text = ""
		props.AutoButtonColor = false
		field = Util.create("TextButton", props)
	else
		props.Active = false
		field = Util.create("Frame", props)
	end
	Util.corner(field, 5)
	Util.stroke(field, tint(ctx, WHITE), 2, 0)
	if not interactive then
		return field
	end
	local blockId = node.id
	local inputName = spec.name
	connect(ctx, field.MouseButton1Click, function()
		if type(cb.openColorPicker) ~= "function" then
			return
		end
		local pos = field.AbsolutePosition + Vector2.new(0, field.AbsoluteSize.Y + 4)
		safeCall(cb.openColorPicker, pos, { rgb[1], rgb[2], rgb[3] }, function(newRgb)
			local clean = toRgb(newRgb)
			if clean == nil then
				return
			end
			if clean[1] == rgb[1] and clean[2] == rgb[2] and clean[3] == rgb[3] then
				return
			end
			safeCall(cb.onInputCommit, blockId, inputName, clean, ctx.model)
		end)
	end)
	return field
end

local function addInputTarget(ctx, node, item, x, y)
	local spec = item.spec
	if node.unknown or node.id == nil or type(spec) ~= "table" or not acceptsReporter(spec) then
		return
	end
	table.insert(ctx.targets, {
		kind = "input",
		blockId = node.id,
		input = spec.name,
		x = x,
		y = y,
		w = item.w,
		h = item.h,
		boolean = spec.kind == "boolean",
	})
end

local instantiateNode -- déclarations anticipées (récursion)
local instantiateChain

local function instantiateItems(ctx, node, part, px, py)
	local items = part.items
	if type(items) ~= "table" then
		return
	end
	local contentX = part.contentX or part.padX or 0
	local areaH = part.h
	if part.shaded and not node.isValue and ctx.shadeOn then
		-- centré dans la partie claire (au-dessus de la bande sombre)
		areaH = part.h - SHADE
	end
	local depth = node.depth or 0
	local z = zOf(depth, 4)
	for _, item in ipairs(items) do
		local ix = px + contentX + (item.x or 0)
		local iy = py + math.floor((areaH - item.h) / 2 + 0.5)
		if item.kind == "text" then
			drawText(ctx, depth, item, ix, iy)
		elseif item.kind == "reporter" then
			instantiateNode(ctx, item.child, ix, iy)
			addInputTarget(ctx, node, item, ix, iy)
		elseif item.kind == "field" then
			if item.editor == "bool" then
				drawPointed(ctx, ix, iy, item.w, item.h, math.floor(item.h / 2), Theme.darken(node.color, SLOT_DARKEN), nil, z)
			elseif item.editor == "color" then
				drawColorField(ctx, node, item, ix, iy, z)
			elseif item.editor == "menu" then
				drawMenuField(ctx, node, item, ix, iy, z)
			else
				drawTextField(ctx, node, item, ix, iy, z)
			end
			addInputTarget(ctx, node, item, ix, iy)
		end
	end
end

-- Style « bonbon » : dégradé vertical (haut plus clair). Le fond passe au blanc : UIGradient
-- multiplie la couleur du fond par celle du dégradé. topAmount / bottomAmount : éclaircissement du
-- haut et du bas (GLOSS_LIGHTEN et 0 par défaut).
local function addGloss(ctx, frame, color, topAmount, bottomAmount)
	local top = Theme.lighten(color, topAmount or GLOSS_LIGHTEN)
	local bottom = color
	if bottomAmount then
		bottom = Theme.lighten(color, bottomAmount)
	end
	frame.BackgroundColor3 = WHITE
	Util.create("UIGradient", {
		Name = "Bonbon",
		Color = ColorSequence.new(tint(ctx, top), tint(ctx, bottom)),
		Rotation = 90,
		Parent = frame,
	})
end

-- Style « bonbon » : liseré blanc de 1 px à l'intérieur du bord (cadre transparent en retrait de 1 px
-- dont le contour est dessiné juste à l'extérieur)
local function addShine(ctx, px, py, w, h, r, z)
	if w < 6 or h < 6 then
		return
	end
	local shine = newFrame(ctx, {
		Name = "Reflet",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(px + 1, py + 1),
		Size = UDim2.fromOffset(w - 2, h - 2),
		ZIndex = z,
	})
	if r > 1 then
		Util.corner(shine, r - 1)
	end
	Util.stroke(shine, tint(ctx, WHITE), 1, 0.7)
end

-- Partie arrondie d'un bloc : contour (relief 1 px, contour 2 px, plat aucun), corps cliquable,
-- remplissage au-dessus de la bande sombre (relief, bonbon). Renvoie le corps.
local function drawRoundPart(ctx, node, part, px, py, color, outline, shade, depth)
	local r = part.r or 0
	if ctx.radiusK ~= 1 then
		r = math.floor(r * ctx.radiusK + 0.5)
	end
	local ow = ctx.outlineW
	if ow > 0 then
		local contour = newFrame(ctx, {
			Name = "Contour",
			BackgroundColor3 = outline,
			Position = UDim2.fromOffset(px - ow, py - ow),
			Size = UDim2.fromOffset(part.w + 2 * ow, part.h + 2 * ow),
			ZIndex = zOf(depth, 0),
		})
		if r > 0 then
			Util.corner(contour, r + ow)
		end
	end
	local body
	if part.shaded and ctx.shadeOn then
		-- corps = couleur sombre sur toute la hauteur ; remplissage 2 px plus court par-dessus
		body = makeBody(ctx, node.id, px, py, part.w, part.h, shade, r, zOf(depth, 1), false)
		local fillH = math.max(1, part.h - SHADE)
		local fill = newFrame(ctx, {
			Name = "Remplissage",
			BackgroundColor3 = color,
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(part.w, fillH),
			ZIndex = zOf(depth, 2),
		})
		if r > 0 then
			Util.corner(fill, r)
		end
		if ctx.gloss then
			addGloss(ctx, fill, color)
			addShine(ctx, px, py, part.w, fillH, r, zOf(depth, 2))
		end
	else
		body = makeBody(ctx, node.id, px, py, part.w, part.h, color, r, zOf(depth, 2), false)
		if ctx.gloss and part.bump then
			-- bosse d'un événement : son bas rejoint le haut (clair) du remplissage de la ligne
			addGloss(ctx, body, color, GLOSS_LIGHTEN + 0.08, GLOSS_LIGHTEN)
		end
	end
	return body
end

-- Partie pointue (bloc condition) dans le style courant. Renvoie le corps (transparent).
local function drawPointedPart(ctx, node, part, px, py, color, outline, shade, depth)
	local point = node.point or 0
	local ow = ctx.outlineW
	if ow > 0 then
		drawPointed(ctx, px - ow, py - ow, part.w + 2 * ow, part.h + 2 * ow, point + ow, outline, nil, zOf(depth, 0))
	end
	local body = makeBody(ctx, node.id, px, py, part.w, part.h, color, 0, zOf(depth, 1), true)
	local shadeColor = nil
	if ctx.shadeOn then
		shadeColor = shade
	end
	drawPointed(ctx, px, py, part.w, part.h, point, color, shadeColor, zOf(depth, 2))
	return body
end

-- Hachures d'un bloc désactivé : des « / » très légers, découpés à la taille du rectangle
-- (un TextLabel n'est pas tourné, le découpage ClipsDescendants marche donc normalement)
local function drawHatch(ctx, x, y, w, h, z)
	if w < 8 or h < 8 then
		return
	end
	local clip = newFrame(ctx, {
		Name = "Hachures",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = z,
	})
	local size = math.floor(Util.clamp(h * 1.3, 14, 100))
	local count = math.min(160, math.ceil(w / math.max(4, size * 0.28)) + 3)
	local extra = math.floor(size * 0.25)
	Util.create("TextLabel", {
		Name = "Motif",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Font = Enum.Font.Gotham,
		TextSize = size,
		TextColor3 = WHITE,
		TextTransparency = HATCH_TRANSPARENCY,
		Text = string.rep("/", count),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(-4, -extra),
		Size = UDim2.fromOffset(w + 8, h + 2 * extra),
		ZIndex = z,
		Parent = clip,
	})
end

-- Hachures sur les parties d'un bloc désactivé (pas sur la bosse d'un événement ni sur les coins)
local function hatchNode(ctx, node, ox, oy, depth)
	local z = zOf(depth, 3)
	local shadeH = 0
	if ctx.shadeOn then
		shadeH = SHADE
	end
	for _, part in ipairs(node.parts) do
		if not part.bump then
			local px, py = ox + part.x, oy + part.y
			if part.pointed then
				local point = node.point or 0
				drawHatch(ctx, px + point, py + 2, part.w - 2 * point, part.h - 4 - shadeH, z)
			elseif part.overlap then
				-- bras gauche d'un bloc C : seulement le long de la bouche
				local o = part.overlap
				drawHatch(ctx, px + 2, py + o, part.w - 4, part.h - 2 * o, z)
			else
				local h = part.h
				if part.shaded then
					h -= shadeH
				end
				drawHatch(ctx, px + 2, py + 2, part.w - 4, h - 4, z)
			end
		end
	end
end

-- Étiquette « désactivé » à cheval sur le bord haut du bloc, à droite (au-dessus d'un bloc valeur)
local function drawDisabledTag(ctx, node, ox, oy)
	local font = Theme.Fonts.UIBold or FONT
	local tw = math.ceil(Util.textSize(DISABLED_TAG, 10, font).X) + 14
	local th = 16
	local rowY = oy
	if node.isHat then
		rowY = oy + B.HatBump
	end
	local x = ox + math.max(0, node.w - tw - 8)
	local y = rowY - math.floor(th / 2)
	if node.isValue then
		x = ox + math.max(0, math.floor((node.w - tw) / 2))
		y = oy - th - 1
	end
	local tag = Util.create("Frame", {
		Name = "Desactive",
		BackgroundColor3 = Color3.fromRGB(24, 24, 28),
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(tw, th),
		ZIndex = Z_PROBLEM - 2,
		Parent = ctx.frame,
	})
	Util.corner(tag, math.floor(th / 2))
	Util.stroke(tag, WHITE, 1, 0.65)
	Util.create("TextLabel", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Font = font,
		TextSize = 10,
		TextColor3 = Color3.fromRGB(225, 225, 230),
		Text = DISABLED_TAG,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_PROBLEM - 2,
		Parent = tag,
	})
end

instantiateNode = function(ctx, node, ox, oy)
	local depth = node.depth or 0
	local prevDim = ctx.dim
	ctx.dim = node.disabled == true
	local color = node.color or UNKNOWN_COLOR
	local outline = node.outline or Theme.darken(color, 0.25)
	if ctx.style == "contour" then
		outline = Theme.darken(color, 0.35)
	end
	local shade = node.shade or Theme.darken(color, SHADE_DARKEN)
	local mainFrame = nil
	local firstFrame = nil
	for _, part in ipairs(node.parts) do
		local px, py = ox + part.x, oy + part.y
		local body
		if part.pointed then
			body = drawPointedPart(ctx, node, part, px, py, color, outline, shade, depth)
		else
			body = drawRoundPart(ctx, node, part, px, py, color, outline, shade, depth)
		end
		if firstFrame == nil then
			firstFrame = body
		end
		if part.main then
			mainFrame = body
		end
		if part.items then
			instantiateItems(ctx, node, part, px, py)
			-- (une valeur branchée a pu changer ctx.dim puis le remettre : on le reprend pour ce bloc)
			ctx.dim = node.disabled == true
		end
	end
	if node.ownDisabled then
		hatchNode(ctx, node, ox, oy, depth)
		drawDisabledTag(ctx, node, ox, oy)
	end
	for _, tab in ipairs(node.tabs or {}) do
		drawTab(ctx, ox + tab.x, oy + tab.y, color, shade, tab.depth or depth)
	end

	if node.id ~= nil and ctx.blocks[node.id] == nil then
		local info = {
			frame = mainFrame or firstFrame,
			x = ox,
			y = oy,
			w = node.w,
			h = node.h,
			shape = node.shape,
			ringY = oy,
			ringH = node.h,
			disabled = node.disabled == true,
		}
		if node.isHat then
			info.ringY = oy + B.HatBump
			info.ringH = node.h - B.HatBump
		end
		ctx.blocks[node.id] = info
	end

	if not node.unknown and node.id ~= nil then
		for _, sub in ipairs(node.subs or {}) do
			table.insert(ctx.targets, { kind = "sub", blockId = node.id, slot = sub.slot, x = ox + sub.x, y = oy + sub.y })
		end
		if node.canNext then
			table.insert(ctx.targets, { kind = "next", blockId = node.id, x = ox, y = oy + node.h })
		end
	end
	ctx.dim = prevDim
	for _, sub in ipairs(node.subs or {}) do
		if sub.chain then
			instantiateChain(ctx, sub.chain, ox + sub.x, oy + sub.y)
		end
	end
	ctx.dim = prevDim
end

-- Remplaçant gris quand le dessin d'un bloc a échoué
local function drawBroken(ctx, node, x, y)
	local w = math.max(80, node.w or 80)
	local h = math.max(26, node.h or 26)
	local depth = node.depth or 0
	local body = makeBody(ctx, node.id, x, y, w, h, UNKNOWN_COLOR, B.Corner, zOf(depth, 4), false)
	Util.create("TextLabel", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Font = FONT,
		TextSize = TEXT_SIZE,
		TextColor3 = WHITE,
		Text = "bloc illisible",
		Size = UDim2.fromScale(1, 1),
		Parent = body,
	})
	if node.id ~= nil then
		ctx.blocks[node.id] = { frame = body, x = x, y = y, w = w, h = h, shape = "stack", ringY = y, ringH = h }
	end
end

instantiateChain = function(ctx, chain, ox, oy)
	for _, node in ipairs(chain.nodes) do
		local nx, ny = ox, oy + (node.y or 0)
		local ok, err = pcall(instantiateNode, ctx, node, nx, ny)
		if not ok then
			warn("[Blocs FR] Renderer : impossible de dessiner le bloc " .. tostring(node.id) .. " : " .. tostring(err))
			pcall(drawBroken, ctx, node, nx, ny)
		end
	end
end

-- Contour de 3 px + pastille « ! » / « i » sur les blocs qui ont un problème (SPEC §18)
local function drawProblems(ctx)
	local problems = ctx.problems
	if type(problems) ~= "table" then
		return
	end
	ctx.dim = false
	for blockId, info in pairs(ctx.blocks) do
		local severity = problems[blockId]
		local key = severity and SEVERITY_KEYS[severity]
		local color = key and Theme.Colors[key]
		if typeof(color) == "Color3" then
			local radius = B.Corner
			if info.shape == "reporter" or info.shape == "boolean" then
				radius = math.floor(info.ringH / 2)
			end
			local ring = newFrame(ctx, {
				Name = "Probleme",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(info.x, info.ringY),
				Size = UDim2.fromOffset(info.w, info.ringH),
				ZIndex = Z_PROBLEM,
			})
			Util.corner(ring, radius)
			Util.stroke(ring, color, 3, 0)

			local badge = newFrame(ctx, {
				Name = "Pastille",
				BackgroundColor3 = color,
				Position = UDim2.fromOffset(info.x + info.w - BADGE_SIZE + 8, info.ringY - BADGE_SIZE + 12),
				Size = UDim2.fromOffset(BADGE_SIZE, BADGE_SIZE),
				ZIndex = Z_PROBLEM + 1,
			})
			Util.corner(badge, BADGE_SIZE / 2)
			Util.stroke(badge, Theme.Colors.Background, 2, 0)
			local textColor = WHITE
			if severity == "avertissement" then
				textColor = Theme.Colors.TextDark
			end
			Util.create("TextLabel", {
				Name = "Signe",
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				Font = Theme.Fonts.UIBold or FONT,
				TextSize = 14,
				TextColor3 = textColor,
				Text = SEVERITY_GLYPHS[severity] or "!",
				Size = UDim2.fromScale(1, 1),
				ZIndex = Z_PROBLEM + 2,
				Parent = badge,
			})
		end
	end
end

-- Construit une vue complète (voir SPEC §9)
local function buildView(model, headId, parent, opts, position, defaultInteractive)
	opts = opts or {}
	local chain = layoutRoot(model, headId)
	local width = math.ceil(chain.w)
	local height = math.ceil(chain.h)
	local frame = Util.create("Frame", {
		Name = "Pile_" .. tostring(headId),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = position,
		Size = UDim2.fromOffset(width, height),
	})
	local interactive = defaultInteractive
	if opts.interactive ~= nil then
		interactive = opts.interactive == true
	end
	local style = currentStyle()
	if type(opts.style) == "string" and STYLES[opts.style] then
		style = opts.style
	end
	local colors = Theme.Colors
	local ctx = {
		model = model,
		frame = frame,
		callbacks = (type(opts.callbacks) == "table") and opts.callbacks or {},
		interactive = interactive,
		problems = opts.problems,
		connections = {},
		targets = {},
		blocks = {},
		-- style des blocs (SPEC §31)
		style = style,
		shadeOn = styleHasShade(style),
		outlineW = 1,
		radiusK = 1,
		gloss = style == "bonbon",
		-- blocs désactivés (SPEC §32) : mélange avec le fond du canvas
		dim = false,
		dimBg = colors.Background or Color3.fromRGB(20, 20, 22),
		fieldBg = colors.InputBg or WHITE,
		fieldText = colors.InputText or DARK_TEXT,
		focusColor = colors.Accent or Color3.fromRGB(37, 99, 235),
	}
	if style == "plat" then
		ctx.outlineW = 0
	elseif style == "contour" then
		ctx.outlineW = 2
	elseif style == "bonbon" then
		ctx.radiusK = BONBON_RADIUS
	end

	local ok, err = pcall(function()
		instantiateChain(ctx, chain, 0, 0)
		local head = chain.nodes[1]
		if head and head.isStatement and not head.isHat and not head.unknown and head.id ~= nil then
			table.insert(ctx.targets, { kind = "above", blockId = head.id, x = 0, y = 0 })
		end
		drawProblems(ctx)
	end)
	if not ok then
		for _, connection in ipairs(ctx.connections) do
			connection:Disconnect()
		end
		frame:Destroy()
		error(err, 0)
	end
	frame.Parent = parent

	local connections = ctx.connections
	local view = {
		frame = frame,
		width = width,
		height = height,
		blocks = ctx.blocks,
		targets = ctx.targets,
		headId = headId,
	}
	function view.destroy(self)
		local target = self or view
		if target._destroyed then
			return
		end
		target._destroyed = true
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
		if target.frame then
			target.frame:Destroy()
		end
		if target.model and type(target.model.destroy) == "function" then
			pcall(target.model.destroy, target.model)
		end
	end
	return view
end

---------------------------------------------------------------------------
-- API publique (SPEC §9)
---------------------------------------------------------------------------

-- Dessine la pile qui commence à headId. view.frame est placé en (head.x, head.y).
function Renderer.renderStack(model, headId, parent, opts)
	local head = getBlock(model, headId)
	local x, y = 0, 0
	if head then
		x = tonumber(head.x) or 0
		y = tonumber(head.y) or 0
	end
	return buildView(model, headId, parent, opts, UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5)), true)
end

-- Dessine un seul bloc (palette, wiki) à partir d'un modèle jetable ; view.frame est placé en (0, 0).
-- Par défaut non interactif (opts.interactive = true pour des champs modifiables).
function Renderer.renderPrototype(defId, presetInputs, parent, opts)
	local model = Model.new()
	local id = model:create(defId, 0, 0, presetInputs)
	if id == nil then
		pcall(model.destroy, model)
		error("Bloc inconnu : " .. tostring(defId), 0)
	end
	local view = buildView(model, id, parent, opts, UDim2.fromOffset(0, 0), false)
	view.model = model
	view.blockId = id
	return view
end

-- Taille (unités du canvas) de la pile qui commence à headId, sans créer d'Instance
function Renderer.measure(model, headId)
	local chain = layoutRoot(model, headId)
	return math.ceil(chain.w), math.ceil(chain.h)
end

-- Positions des blocs d'une pile (mêmes calculs que le dessin, sans Instance)
local positionsOfNode -- déclaration anticipée (récursion)

local function positionsOfChain(shadeOn, chain, ox, oy, out)
	for _, node in ipairs(chain.nodes) do
		positionsOfNode(shadeOn, node, ox, oy + (node.y or 0), out)
	end
end

positionsOfNode = function(shadeOn, node, ox, oy, out)
	if node.id ~= nil and out[node.id] == nil then
		out[node.id] = { x = ox, y = oy, w = node.w, h = node.h }
	end
	for _, part in ipairs(node.parts or {}) do
		if type(part.items) == "table" then
			local px, py = ox + part.x, oy + part.y
			local contentX = part.contentX or part.padX or 0
			local areaH = part.h
			if part.shaded and not node.isValue and shadeOn then
				areaH = part.h - SHADE
			end
			for _, item in ipairs(part.items) do
				if item.kind == "reporter" and type(item.child) == "table" then
					local ix = px + contentX + (item.x or 0)
					local iy = py + math.floor((areaH - item.h) / 2 + 0.5)
					positionsOfNode(shadeOn, item.child, ix, iy, out)
				end
			end
		end
	end
	for _, sub in ipairs(node.subs or {}) do
		if sub.chain then
			positionsOfChain(shadeOn, sub.chain, ox + sub.x, oy + sub.y, out)
		end
	end
end

-- Position (unités du canvas, par rapport au coin haut-gauche de la pile) de chaque bloc de la pile
-- qui commence à headId : { [blockId] = { x, y, w, h } }. Aucune Instance créée (NOTE: ajout à la
-- SPEC, utilisé par Canvas pour que les notes suivent leur bloc).
function Renderer.blockPositions(model, headId)
	local chain = layoutRoot(model, headId)
	local out = {}
	positionsOfChain(styleHasShade(currentStyle()), chain, 0, 0, out)
	return out
end

return Renderer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">Shared</string><ProtectedString name="Source"><![CDATA[-- Shared : listes d'options partagées, constructeurs d'entrées et fonctions utiles du code généré.
-- Les fonctions de Shared.helpers sont copiées dans les scripts générés quand un bloc les demande
-- avec g.helper("_nom"). Elles doivent être robustes (jamais d'erreur pour une mauvaise valeur).

local Shared = {}

-- Variables de contexte disponibles dans le code généré (voir SPEC §5.5)
Shared.CONTEXTE = { "joueur", "personnage", "partieTouchee", "deltaTemps", "messageChat", "dernierObjet" }

---------------------------------------------------------------------------
-- Listes d'options (dropdown) : { "libellé", "code Luau", helper = "_optionnel" }
---------------------------------------------------------------------------

Shared.OBJETS = {
	{ "cet objet", "script.Parent" },
	{ "la partie touchée", "partieTouchee" },
	{ "le personnage", "personnage" },
	{ "le dernier objet créé", "dernierObjet" },
}

Shared.JOUEURS = {
	{ "le joueur", "joueur" },
	{ "le joueur le plus proche", "_joueurProche(script.Parent)", helper = "_joueurProche" },
	{ "un joueur au hasard", "_joueurHasard()", helper = "_joueurHasard" },
}

Shared.OUI_NON = {
	{ "oui", "true" },
	{ "non", "false" },
}

Shared.MATERIAUX = {
	{ "plastique", "Enum.Material.Plastic" },
	{ "plastique lisse", "Enum.Material.SmoothPlastic" },
	{ "néon", "Enum.Material.Neon" },
	{ "bois", "Enum.Material.Wood" },
	{ "planches", "Enum.Material.WoodPlanks" },
	{ "métal", "Enum.Material.Metal" },
	{ "métal rouillé", "Enum.Material.CorrodedMetal" },
	{ "plaque de métal", "Enum.Material.DiamondPlate" },
	{ "verre", "Enum.Material.Glass" },
	{ "brique", "Enum.Material.Brick" },
	{ "ardoise", "Enum.Material.Slate" },
	{ "granit", "Enum.Material.Granite" },
	{ "marbre", "Enum.Material.Marble" },
	{ "béton", "Enum.Material.Concrete" },
	{ "pavés", "Enum.Material.Cobblestone" },
	{ "herbe", "Enum.Material.Grass" },
	{ "sable", "Enum.Material.Sand" },
	{ "glace", "Enum.Material.Ice" },
	{ "tissu", "Enum.Material.Fabric" },
	{ "champ de force", "Enum.Material.ForceField" },
}

Shared.TOUCHES = {
	{ "E", "Enum.KeyCode.E" },
	{ "F", "Enum.KeyCode.F" },
	{ "R", "Enum.KeyCode.R" },
	{ "T", "Enum.KeyCode.T" },
	{ "G", "Enum.KeyCode.G" },
	{ "Q", "Enum.KeyCode.Q" },
	{ "A", "Enum.KeyCode.A" },
	{ "Z", "Enum.KeyCode.Z" },
	{ "X", "Enum.KeyCode.X" },
	{ "C", "Enum.KeyCode.C" },
	{ "V", "Enum.KeyCode.V" },
	{ "espace", "Enum.KeyCode.Space" },
	{ "entrée", "Enum.KeyCode.Return" },
	{ "maj (shift)", "Enum.KeyCode.LeftShift" },
	{ "ctrl", "Enum.KeyCode.LeftControl" },
	{ "tab", "Enum.KeyCode.Tab" },
	{ "1", "Enum.KeyCode.One" },
	{ "2", "Enum.KeyCode.Two" },
	{ "3", "Enum.KeyCode.Three" },
	{ "flèche haut", "Enum.KeyCode.Up" },
	{ "flèche bas", "Enum.KeyCode.Down" },
	{ "flèche gauche", "Enum.KeyCode.Left" },
	{ "flèche droite", "Enum.KeyCode.Right" },
}

-- Le code est un nom de propriété (X, Y ou Z), à utiliser comme : expr .. "." .. a.AXE
Shared.AXES = {
	{ "x", "X" },
	{ "y", "Y" },
	{ "z", "Z" },
}

Shared.FORMES = {
	{ "bloc", "Enum.PartType.Block" },
	{ "boule", "Enum.PartType.Ball" },
	{ "cylindre", "Enum.PartType.Cylinder" },
	{ "coin", "Enum.PartType.Wedge" },
	{ "coin d'angle", "Enum.PartType.CornerWedge" },
}

-- Le code est un nom de classe entre guillemets, utilisable avec Instance.new(a.EFFET)
Shared.EFFETS = {
	{ "feu", '"Fire"' },
	{ "fumée", '"Smoke"' },
	{ "étincelles", '"Sparkles"' },
}

---------------------------------------------------------------------------
-- Constructeurs d'entrées courantes
---------------------------------------------------------------------------

-- Objet : "cet objet", "la partie touchée"... ; accepte aussi un bloc valeur (ex. "objet nommé …")
function Shared.objInput(name: string, default: string?)
	return {
		name = name,
		kind = "dropdown",
		options = Shared.OBJETS,
		default = default or "script.Parent",
		acceptReporter = true,
	}
end

-- Joueur : "le joueur", "le joueur le plus proche"... ; accepte aussi un bloc valeur
function Shared.playerInput(name: string, default: string?)
	return {
		name = name,
		kind = "dropdown",
		options = Shared.JOUEURS,
		default = default or "joueur",
		acceptReporter = true,
	}
end

-- Oui / non (code "true" / "false")
function Shared.yesNoInput(name: string, default: boolean?)
	return {
		name = name,
		kind = "dropdown",
		options = Shared.OUI_NON,
		default = (default == false) and "false" or "true",
	}
end

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------
Shared.helpers = {
	_avertir = {
		deps = {},
		services = {},
		code = [[
local function _avertir(message)
	warn("[Blocs FR] " .. tostring(message))
end]],
	},

	-- Convertit n'importe quelle valeur en nombre (texte "3,5" accepté) ; 0 si impossible
	_num = {
		deps = {},
		services = {},
		code = [[
local function _num(valeur)
	local t = type(valeur)
	if t == "number" then
		return valeur
	elseif t == "boolean" then
		return valeur and 1 or 0
	elseif t == "string" then
		local n = tonumber((string.gsub(valeur, ",", ".")))
		if n then
			return n
		end
	end
	return 0
end]],
	},

	-- Convertit n'importe quelle valeur en texte lisible (vrai/faux, nom d'objet...)
	_texte = {
		deps = {},
		services = {},
		code = [[
local function _texte(valeur)
	local t = typeof(valeur)
	if valeur == nil then
		return ""
	elseif t == "string" then
		return valeur
	elseif t == "boolean" then
		return valeur and "vrai" or "faux"
	elseif t == "number" then
		if valeur == math.floor(valeur) and math.abs(valeur) < 1e15 then
			return string.format("%d", valeur)
		end
		return tostring(math.floor(valeur * 1000 + 0.5) / 1000)
	elseif t == "Instance" then
		return valeur.Name
	elseif t == "Vector3" then
		return string.format("%.2f, %.2f, %.2f", valeur.X, valeur.Y, valeur.Z)
	elseif t == "Color3" then
		return string.format("%d, %d, %d", math.floor(valeur.R * 255 + 0.5), math.floor(valeur.G * 255 + 0.5), math.floor(valeur.B * 255 + 0.5))
	end
	return tostring(valeur)
end]],
	},

	-- Égalité "à la Scratch" : nombres comparés comme nombres, textes sans tenir compte des majuscules,
	-- un objet est égal à son nom.
	_egal = {
		deps = {},
		services = {},
		code = [[
local function _egal(a, b)
	if a == b then
		return true
	end
	local na, nb = tonumber(a), tonumber(b)
	if na ~= nil and nb ~= nil then
		return na == nb
	end
	if typeof(a) == "Instance" then
		a = a.Name
	end
	if typeof(b) == "Instance" then
		b = b.Name
	end
	if type(a) == "string" and type(b) == "string" then
		return string.lower(a) == string.lower(b)
	end
	return false
end]],
	},

	-- Objet (Instance) à partir d'une valeur : Instance, joueur (-> son personnage) ou nom d'objet
	_obj = {
		deps = {},
		services = {},
		code = [[
local function _obj(valeur)
	local t = typeof(valeur)
	if t == "Instance" then
		if valeur:IsA("Player") then
			return valeur.Character
		end
		return valeur
	elseif t == "string" and valeur ~= "" then
		return workspace:FindFirstChild(valeur, true)
	end
	return nil
end]],
	},

	-- Toutes les parties (BasePart) d'un objet (lui-même + descendants)
	_parties = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _parties(valeur)
	local objet = _obj(valeur)
	local liste = {}
	if objet == nil then
		return liste
	end
	if objet:IsA("BasePart") then
		table.insert(liste, objet)
	end
	for _, d in ipairs(objet:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(liste, d)
		end
	end
	return liste
end]],
	},

	-- La partie principale d'un objet (BasePart) ou nil
	_partie = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _partie(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		return nil
	end
	if objet:IsA("BasePart") then
		return objet
	end
	if objet:IsA("Model") then
		local racine = objet:FindFirstChild("HumanoidRootPart")
		if racine and racine:IsA("BasePart") then
			return racine
		end
		if objet.PrimaryPart then
			return objet.PrimaryPart
		end
	end
	return objet:FindFirstChildWhichIsA("BasePart", true)
end]],
	},

	-- CFrame (position + rotation) d'un objet ou nil
	_pivot = {
		deps = { "_obj", "_partie" },
		services = {},
		code = [[
local function _pivot(valeur)
	if typeof(valeur) == "CFrame" then
		return valeur
	end
	local objet = _obj(valeur)
	if objet == nil then
		return nil
	end
	if objet:IsA("PVInstance") then
		return objet:GetPivot()
	end
	local p = _partie(objet)
	if p then
		return p.CFrame
	end
	return nil
end]],
	},

	-- Place un objet (partie ou modèle) à un CFrame ; renvoie true si réussi
	_setPivot = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _setPivot(valeur, cf)
	local objet = _obj(valeur)
	if objet == nil or typeof(cf) ~= "CFrame" then
		_avertir("Impossible de déplacer : objet introuvable.")
		return false
	end
	if objet:IsA("PVInstance") then
		objet:PivotTo(cf)
		return true
	end
	_avertir("« " .. objet.Name .. " » ne peut pas être déplacé.")
	return false
end]],
	},

	-- Position (Vector3) d'une valeur (Vector3, CFrame, objet, joueur) ou nil
	_pos = {
		deps = { "_pivot" },
		services = {},
		code = [[
local function _pos(valeur)
	local t = typeof(valeur)
	if t == "Vector3" then
		return valeur
	elseif t == "CFrame" then
		return valeur.Position
	end
	local cf = _pivot(valeur)
	if cf then
		return cf.Position
	end
	return nil
end]],
	},

	-- Personnage (Model avec Humanoid) à partir d'un joueur, d'un personnage ou d'une de ses parties.
	-- Dans un script local, nil -> personnage du joueur local.
	_perso = {
		deps = {},
		services = { "Players", "RunService" },
		code = [[
local function _perso(valeur)
	if typeof(valeur) ~= "Instance" then
		if valeur == nil and RunService:IsClient() and Players.LocalPlayer then
			return Players.LocalPlayer.Character
		end
		return nil
	end
	if valeur:IsA("Player") then
		return valeur.Character
	end
	if valeur:IsA("Humanoid") then
		return valeur.Parent
	end
	if valeur:IsA("Model") and valeur:FindFirstChildOfClass("Humanoid") then
		return valeur
	end
	local modele = valeur:FindFirstAncestorOfClass("Model")
	while modele do
		if modele:FindFirstChildOfClass("Humanoid") then
			return modele
		end
		modele = modele:FindFirstAncestorOfClass("Model")
	end
	return nil
end]],
	},

	-- Joueur (Player) à partir d'un joueur, personnage, partie de personnage ou nom.
	-- Dans un script local, nil -> joueur local.
	_joueur = {
		deps = { "_perso" },
		services = { "Players", "RunService" },
		code = [[
local function _joueur(valeur)
	local t = typeof(valeur)
	if t == "Instance" then
		if valeur:IsA("Player") then
			return valeur
		end
		local p = _perso(valeur)
		if p then
			return Players:GetPlayerFromCharacter(p)
		end
		return nil
	elseif t == "string" then
		local trouve = Players:FindFirstChild(valeur)
		if trouve and trouve:IsA("Player") then
			return trouve
		end
		return nil
	elseif valeur == nil and RunService:IsClient() then
		return Players.LocalPlayer
	end
	return nil
end]],
	},

	-- Humanoid à partir d'un joueur / personnage / partie
	_humanoid = {
		deps = { "_perso" },
		services = {},
		code = [[
local function _humanoid(valeur)
	if typeof(valeur) == "Instance" and valeur:IsA("Humanoid") then
		return valeur
	end
	local p = _perso(valeur)
	if p then
		return p:FindFirstChildOfClass("Humanoid")
	end
	return nil
end]],
	},

	-- Joueur le plus proche d'un objet (ou nil)
	_joueurProche = {
		deps = { "_pos" },
		services = { "Players" },
		code = [[
local function _joueurProche(valeur)
	local origine = _pos(valeur)
	if origine == nil then
		return nil
	end
	local meilleur, distance = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local racine = c and c:FindFirstChild("HumanoidRootPart")
		if racine then
			local d = (racine.Position - origine).Magnitude
			if d < distance then
				meilleur, distance = p, d
			end
		end
	end
	return meilleur
end]],
	},

	-- Un joueur au hasard (ou nil)
	_joueurHasard = {
		deps = {},
		services = { "Players" },
		code = [[
local function _joueurHasard()
	local liste = Players:GetPlayers()
	if #liste == 0 then
		return nil
	end
	return liste[math.random(1, #liste)]
end]],
	},
}

return Shared
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">Storage</string><ProtectedString name="Source"><![CDATA[-- Storage : enregistre un projet Blocs FR dans le jeu (script généré + données JSON dans des
-- StringValue enfants du script) et le recharge. Voir SPEC §7.
-- Phase 2 (SPEC §17) : chaque enregistrement écrit aussi la table des lignes du code généré
-- (CodeGen : result.lineMap) en JSON dans la StringValue « BlocsFR_Lignes » du script, remplacée à
-- chaque fois. ErrorWatcher s'en sert pendant les tests pour retrouver le bloc d'une erreur.
-- Storage.load l'ignore. NOTE: le script reçoit aussi l'attribut « BlocsFR_Chemin » (son chemin).
-- Mode « module » (SPEC §20) : le projet devient un ModuleScript « BlocsModule » (mêmes attributs,
-- mêmes StringValue). isProjectScript / findProjectScript / load reconnaissent aussi les ModuleScript.

local HttpService = game:GetService("HttpService")

local Model = require(script.Parent.Model)

local Storage = {}

Storage.ATTR = "BlocsFR" -- attribut (true) posé sur les scripts générés
Storage.MODE_ATTR = "BlocsFR_Mode" -- attribut "server" / "local" / "module"
Storage.DATA_NAME = "BlocsFR_Donnees" -- StringValue contenant le JSON (puis _2, _3… si trop long)
Storage.LINES_NAME = "BlocsFR_Lignes" -- StringValue : table des lignes du code (JSON)
-- Attribut : chemin du script au moment de l'enregistrement (« StarterGui.Menu.BlocsLocal »). Pendant
-- un test, un script local est copié ailleurs (PlayerGui…) : ErrorWatcher s'en sert pour savoir de
-- quel projet vient une erreur.
Storage.ORIGIN_ATTR = "BlocsFR_Chemin"
Storage.CHUNK_SIZE = 150000
Storage.SERVER_NAME = "BlocsServeur"
Storage.LOCAL_NAME = "BlocsLocal"
Storage.MODULE_NAME = "BlocsModule"
Storage.RECORDING_NAME = "Blocs FR : enregistrer le script"

-- Conteneurs où un script local doit être un LocalScript
local CLIENT_CONTAINERS = { "StarterGui", "StarterPlayer", "StarterPack", "ReplicatedFirst" }

local VALID_MODES = { server = true, ["local"] = true, module = true }

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function getService(name)
	local ok, service = pcall(function()
		return game:GetService(name)
	end)
	if ok then
		return service
	end
	return nil
end

-- inst est le service `serviceName` ou l'un de ses descendants
local function isInside(inst, serviceName)
	local service = getService(serviceName)
	if service == nil then
		return false
	end
	if inst == service then
		return true
	end
	local ok, inside = pcall(function()
		return inst:IsDescendantOf(service)
	end)
	return ok and inside == true
end

local function chunkName(index)
	if index == 1 then
		return Storage.DATA_NAME
	end
	return Storage.DATA_NAME .. "_" .. tostring(index)
end

local function isChunkName(name)
	return name == Storage.DATA_NAME or string.match(name, "^" .. Storage.DATA_NAME .. "_%d+$") ~= nil
end

-- Découpe le JSON en morceaux de `size` octets au plus, sans couper un caractère UTF-8 en deux
local function splitChunks(text, size)
	local chunks = {}
	local length = #text
	local start = 1
	while start <= length do
		local stop = math.min(start + size - 1, length)
		if stop < length then
			while stop > start do
				local nextByte = string.byte(text, stop + 1)
				if nextByte >= 0x80 and nextByte < 0xC0 then
					stop -= 1
				else
					break
				end
			end
		end
		table.insert(chunks, string.sub(text, start, stop))
		start = stop + 1
	end
	if #chunks == 0 then
		table.insert(chunks, "")
	end
	return chunks
end

-- JSON de la table des lignes : [{ "line", "last", "block", "def" }, …].
-- Si le texte est trop long pour une StringValue, forme compacte [[line, last, block, def], …]
-- (lue aussi par ErrorWatcher), puis, en dernier recours, liste tronquée.
local function encodeLineMap(lineMap)
	local entries = {}
	if type(lineMap) == "table" then
		for _, entry in ipairs(lineMap) do
			if type(entry) == "table" and type(entry.line) == "number" then
				local clean = { line = entry.line }
				if type(entry.last) == "number" then
					clean.last = entry.last
				end
				if type(entry.block) == "string" or type(entry.block) == "number" then
					clean.block = entry.block
				end
				if type(entry.def) == "string" then
					clean.def = entry.def
				end
				table.insert(entries, clean)
			end
		end
	end
	local function encode(value)
		local ok, json = pcall(function()
			return HttpService:JSONEncode(value)
		end)
		if ok and type(json) == "string" then
			return json
		end
		return nil
	end
	local json = encode(entries)
	if json ~= nil and #json <= Storage.CHUNK_SIZE then
		return json
	end
	local compact = {}
	for i, entry in ipairs(entries) do
		compact[i] = { entry.line, entry.last or entry.line, entry.block or "", entry.def or "" }
	end
	json = encode(compact)
	while json ~= nil and #json > Storage.CHUNK_SIZE and #compact > 0 do
		local keep = math.floor(#compact * 0.8)
		for i = #compact, keep + 1, -1 do
			compact[i] = nil
		end
		json = encode(compact)
	end
	return json or "[]"
end

-- Crée / remplace la StringValue « BlocsFR_Lignes » du script
local function writeLines(scriptInst, linesJson)
	local holder = scriptInst:FindFirstChild(Storage.LINES_NAME)
	if holder ~= nil and not holder:IsA("StringValue") then
		holder.Parent = nil
		holder = nil
	end
	if holder == nil then
		holder = Instance.new("StringValue")
		holder.Name = Storage.LINES_NAME
		holder.Value = linesJson
		holder.Parent = scriptInst
	else
		holder.Value = linesJson
	end
	-- doublons éventuels (ancienne version, copie manuelle)
	for _, child in ipairs(scriptInst:GetChildren()) do
		if child ~= holder and child.Name == Storage.LINES_NAME then
			child.Parent = nil
		end
	end
end

local function decodeJson(json)
	if type(json) ~= "string" or json == "" then
		return nil, "Les données du projet sont vides."
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(data) ~= "table" then
		return nil, "Les données du projet sont illisibles (JSON invalide)."
	end
	return data, nil
end

---------------------------------------------------------------------------
-- Reconnaissance des scripts Blocs FR
---------------------------------------------------------------------------

function Storage.isProjectScript(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, result = pcall(function()
		if not inst:IsA("BaseScript") and not inst:IsA("ModuleScript") then
			return false
		end
		if inst:GetAttribute(Storage.ATTR) == true then
			return true
		end
		local data = inst:FindFirstChild(Storage.DATA_NAME)
		return data ~= nil and data:IsA("StringValue")
	end)
	return ok and result == true
end

-- inst lui-même s'il s'agit d'un script Blocs FR, sinon son premier enfant direct qui en est un
function Storage.findProjectScript(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if Storage.isProjectScript(inst) then
		return inst
	end
	local ok, children = pcall(function()
		return inst:GetChildren()
	end)
	if not ok then
		return nil
	end
	for _, child in ipairs(children) do
		if Storage.isProjectScript(child) then
			return child
		end
	end
	return nil
end

-- JSON brut (morceaux recollés) d'un script Blocs FR, ou nil
function Storage.readJson(scriptInst)
	if typeof(scriptInst) ~= "Instance" then
		return nil
	end
	local ok, json = pcall(function()
		local parts = {}
		local index = 1
		while true do
			local value = scriptInst:FindFirstChild(chunkName(index))
			if value == nil or not value:IsA("StringValue") then
				break
			end
			table.insert(parts, value.Value)
			index += 1
		end
		if #parts == 0 then
			return nil
		end
		return table.concat(parts)
	end)
	if ok then
		return json
	end
	return nil
end

---------------------------------------------------------------------------
-- JSON <-> modèle
---------------------------------------------------------------------------

-- Table model:serialize() -> json ou nil, erreurFR
local function encodeData(data)
	local okJson, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not okJson or type(json) ~= "string" then
		return nil, "Impossible d'encoder le projet en JSON : " .. tostring(json)
	end
	return json, nil
end

-- Renvoie json ou nil, erreurFR
function Storage.toJson(model)
	if type(model) ~= "table" or type(model.serialize) ~= "function" then
		return nil, "Aucun projet à enregistrer."
	end
	local okData, data = pcall(function()
		return model:serialize()
	end)
	if not okData then
		return nil, "Impossible de préparer les données du projet : " .. tostring(data)
	end
	return encodeData(data)
end

-- Renvoie model ou nil, erreurFR, warnings
function Storage.fromJson(json)
	local data, err = decodeJson(json)
	if data == nil then
		return nil, err, {}
	end
	local ok, model, warnings = pcall(Model.fromData, data)
	if not ok or model == nil then
		return nil, "Impossible de reconstruire le projet : " .. tostring(model), {}
	end
	return model, nil, warnings or {}
end

-- Recharge le projet d'un script Blocs FR (ou du premier script Blocs FR enfant de scriptInst).
-- Renvoie model ou nil, erreurFR, warnings (avertissements de chargement, en français).
function Storage.load(scriptInst)
	if typeof(scriptInst) ~= "Instance" then
		return nil, "Aucun script Blocs FR à ouvrir.", {}
	end
	local projectScript = Storage.findProjectScript(scriptInst)
	if projectScript == nil then
		return nil, "« " .. Storage.pathOf(scriptInst) .. " » ne contient pas de projet Blocs FR.", {}
	end
	local json = Storage.readJson(projectScript)
	if json == nil or json == "" then
		return nil,
			"Le script « "
				.. Storage.pathOf(projectScript)
				.. " » n'a pas de données de blocs (« "
				.. Storage.DATA_NAME
				.. " » manquant) : il ne peut pas être rouvert dans l'éditeur.",
			{}
	end
	local data, err = decodeJson(json)
	if data == nil then
		return nil, err, {}
	end
	-- Mode absent des données : on le reprend de l'attribut du script (ou de sa classe : ModuleScript)
	if not VALID_MODES[data.mode] then
		local okAttr, attrMode = pcall(function()
			return projectScript:GetAttribute(Storage.MODE_ATTR)
		end)
		if okAttr and VALID_MODES[attrMode] then
			data.mode = attrMode
		elseif data.mode == nil and projectScript:IsA("ModuleScript") then
			data.mode = "module"
		end
	end
	local ok, model, warnings = pcall(Model.fromData, data)
	if not ok or model == nil then
		return nil, "Impossible de reconstruire le projet : " .. tostring(model), {}
	end
	return model, nil, warnings or {}
end

---------------------------------------------------------------------------
-- Type et nom du script selon le mode
---------------------------------------------------------------------------

-- Renvoie { className = "Script" | "LocalScript" | "ModuleScript",
--           name = "BlocsServeur" | "BlocsLocal" | "BlocsModule", runContext = Enum.RunContext? }
function Storage.scriptSpec(mode, target)
	if mode == "module" then
		-- un ModuleScript n'a pas de RunContext : il s'exécute du côté du script qui le charge
		return { className = "ModuleScript", name = Storage.MODULE_NAME, runContext = nil }
	end
	if mode == "local" then
		local inClientContainer = false
		if typeof(target) == "Instance" then
			for _, serviceName in ipairs(CLIENT_CONTAINERS) do
				if isInside(target, serviceName) then
					inClientContainer = true
					break
				end
			end
		end
		if inClientContainer then
			return { className = "LocalScript", name = Storage.LOCAL_NAME, runContext = nil }
		end
		return { className = "Script", name = Storage.LOCAL_NAME, runContext = Enum.RunContext.Client }
	end
	return { className = "Script", name = Storage.SERVER_NAME, runContext = Enum.RunContext.Legacy }
end

-- Avertissement si le script ne s'exécutera pas à cet endroit (ou nil)
local function placementWarning(mode, spec, target)
	local where = Storage.pathOf(target)
	if mode == "module" then
		-- un module peut être rangé partout ; seuls les scripts serveur voient ces deux services
		for _, serviceName in ipairs({ "ServerScriptService", "ServerStorage" }) do
			if isInside(target, serviceName) then
				return "Attention : un script module placé dans « "
					.. where
					.. " » ne peut être utilisé que par les scripts serveur (les scripts locaux n'y ont pas accès). Place-le dans ReplicatedStorage s'il doit aussi servir aux scripts locaux."
			end
		end
		return nil
	end
	if mode == "server" then
		for _, serviceName in ipairs({ "ReplicatedStorage", "ServerStorage", "ReplicatedFirst", "Lighting" }) do
			if isInside(target, serviceName) then
				return "Attention : un script serveur placé dans « "
					.. where
					.. " » ne s'exécutera pas. Place la cible dans Workspace ou ServerScriptService."
			end
		end
	elseif spec.className == "Script" then
		for _, serviceName in ipairs({ "ServerScriptService", "ServerStorage" }) do
			if isInside(target, serviceName) then
				return "Attention : un script local placé dans « "
					.. where
					.. " » ne s'exécutera pas (cet endroit n'est pas envoyé aux joueurs)."
			end
		end
	elseif target == getService("StarterPlayer") then
		return "Attention : un script local placé directement dans StarterPlayer ne s'exécutera pas. Utilise StarterPlayerScripts ou StarterCharacterScripts."
	end
	return nil
end

---------------------------------------------------------------------------
-- Écriture
---------------------------------------------------------------------------

local function beginRecording(history)
	if history == nil then
		return nil
	end
	local ok, recording = pcall(function()
		return history:TryBeginRecording(Storage.RECORDING_NAME, Storage.RECORDING_NAME)
	end)
	if ok and recording ~= nil then
		return recording
	end
	pcall(function()
		history:SetWaypoint("Blocs FR : avant l'enregistrement")
	end)
	return nil
end

local function finishRecording(history, recording, success)
	if history == nil then
		return
	end
	if recording ~= nil then
		local operation = Enum.FinishRecordingOperation.Commit
		if not success then
			-- en cas d'échec, on annule les modifications partielles
			operation = Enum.FinishRecordingOperation.Cancel
		end
		local ok = pcall(function()
			history:FinishRecording(recording, operation)
		end)
		if ok then
			return
		end
	end
	pcall(function()
		history:SetWaypoint(Storage.RECORDING_NAME)
	end)
end

-- Écrit le code : ScriptEditorService:UpdateSourceAsync, sinon script.Source
local function setSource(scriptInst, code)
	local editor = getService("ScriptEditorService")
	if editor ~= nil then
		local ok = pcall(function()
			editor:UpdateSourceAsync(scriptInst, function()
				return code
			end)
		end)
		if ok then
			return true, nil
		end
	end
	local ok, err = pcall(function()
		scriptInst.Source = code
	end)
	if ok then
		return true, nil
	end
	return false, tostring(err)
end

-- Écrit le JSON dans BlocsFR_Donnees (+ _2, _3…) et retire les anciens morceaux en trop
local function writeChunks(scriptInst, json)
	local chunks = splitChunks(json, Storage.CHUNK_SIZE)
	for index, chunk in ipairs(chunks) do
		local name = chunkName(index)
		local holder = scriptInst:FindFirstChild(name)
		if holder ~= nil and not holder:IsA("StringValue") then
			holder.Parent = nil
			holder = nil
		end
		if holder == nil then
			holder = Instance.new("StringValue")
			holder.Name = name
			holder.Value = chunk
			holder.Parent = scriptInst
		else
			holder.Value = chunk
		end
	end
	local index = #chunks + 1
	while true do
		local stale = scriptInst:FindFirstChild(chunkName(index))
		if stale == nil then
			break
		end
		stale.Parent = nil
		index += 1
	end
end

-- Crée / met à jour / remplace le script dans target (appelé dans un pcall)
local function writeScript(target, existing, spec, mode, code, json, linesJson)
	local scriptInst = nil
	local old = nil
	if existing ~= nil then
		if existing.ClassName == spec.className then
			-- Bon type : mis à jour sur place (garde Enabled, attributs, tags et références) ;
			-- seul le nom suit le mode (BlocsServeur / BlocsLocal / BlocsModule)
			scriptInst = existing
			if existing.Name ~= spec.name then
				existing.Name = spec.name
			end
		else
			old = existing -- mauvais type : remplacé dans le même parent
		end
	end
	if scriptInst == nil then
		scriptInst = Instance.new(spec.className)
		scriptInst.Name = spec.name
	end
	if old ~= nil then
		-- reprend l'état posé par l'utilisateur sur l'ancien script (sauf nos attributs BlocsFR*)
		pcall(function()
			scriptInst.Enabled = old.Enabled
		end)
		pcall(function()
			for name, value in pairs(old:GetAttributes()) do
				if string.sub(name, 1, #Storage.ATTR) ~= Storage.ATTR then
					scriptInst:SetAttribute(name, value)
				end
			end
		end)
		pcall(function()
			for _, tag in ipairs(old:GetTags()) do
				scriptInst:AddTag(tag)
			end
		end)
	end
	if spec.className == "Script" and spec.runContext ~= nil then
		scriptInst.RunContext = spec.runContext
	end
	scriptInst:SetAttribute(Storage.ATTR, true)
	scriptInst:SetAttribute(Storage.MODE_ATTR, mode)
	if old ~= nil then
		-- conserve les éventuels enfants ajoutés par l'utilisateur (sauf nos anciennes données)
		for _, child in ipairs(old:GetChildren()) do
			if not isChunkName(child.Name) and child.Name ~= Storage.LINES_NAME then
				child.Parent = scriptInst
			end
		end
	end
	if scriptInst.Parent ~= target then
		scriptInst.Parent = target
	end
	scriptInst:SetAttribute(Storage.ORIGIN_ATTR, Storage.pathOf(scriptInst))
	if old ~= nil then
		old.Parent = nil -- (Parent = nil plutôt que Destroy pour que « Annuler » de Studio fonctionne)
	end
	local okSource, sourceErr = setSource(scriptInst, code)
	if not okSource then
		error("impossible d'écrire le code du script (" .. tostring(sourceErr) .. ")", 0)
	end
	writeChunks(scriptInst, json)
	writeLines(scriptInst, linesJson or "[]")
	return scriptInst
end

-- Génère le code et l'écrit dans un script à l'intérieur de target.
-- Renvoie scriptInst ou nil, erreurFR, warnings (liste de textes FR), code (texte généré ou nil).
function Storage.save(model, target, existingScript)
	local warnings = {}
	if type(model) ~= "table" or type(model.serialize) ~= "function" then
		return nil, "Aucun projet à enregistrer.", warnings, nil
	end
	if typeof(target) ~= "Instance" then
		return nil, "Aucune cible : sélectionne un objet dans l'Explorateur avant d'enregistrer.", warnings, nil
	end
	-- La cible est elle-même un script Blocs FR : on enregistre à sa place, dans son parent
	if Storage.isProjectScript(target) and target.Parent ~= nil then
		if existingScript == nil then
			existingScript = target
		end
		target = target.Parent
	end
	-- Le script du projet a été déplacé par l'utilisateur mais est toujours dans le jeu : il est mis à
	-- jour là où il se trouve (sinon un second script serait créé dans l'ancienne cible, et celui
	-- déplacé continuerait d'exécuter l'ancien code).
	if existingScript ~= nil and Storage.isProjectScript(existingScript) then
		local okMoved, newParent = pcall(function()
			local parent = existingScript.Parent
			if parent ~= nil and parent ~= target and existingScript:IsDescendantOf(game) then
				return parent
			end
			return nil
		end)
		if okMoved and typeof(newParent) == "Instance" then
			target = newParent
			table.insert(
				warnings,
				"Le script Blocs FR a été déplacé dans « " .. Storage.pathOf(target) .. " » : il y est mis à jour."
			)
		end
	end
	if target == game then
		return nil, "Impossible d'enregistrer directement dans « game » : choisis un objet (par exemple dans Workspace).", warnings, nil
	end
	local okInGame, inGame = pcall(function()
		return target:IsDescendantOf(game)
	end)
	if not okInGame or not inGame then
		return nil, "La cible « " .. tostring(target.Name) .. " » n'est plus dans le jeu (elle a peut-être été supprimée).", warnings, nil
	end

	local mode = "server"
	if model.mode == "local" or model.mode == "module" then
		mode = model.mode
	end

	-- Génération du code (CodeGen chargé ici pour éviter les problèmes d'ordre de chargement)
	local okRequire, CodeGen = pcall(function()
		return require(script.Parent.CodeGen)
	end)
	if not okRequire or type(CodeGen) ~= "table" then
		return nil, "Le module CodeGen est introuvable ou contient une erreur : " .. tostring(CodeGen), warnings, nil
	end
	local okGen, result = pcall(CodeGen.generate, model, mode)
	if not okGen then
		return nil, "Erreur pendant la génération du code : " .. tostring(result), warnings, nil
	end
	if type(result) ~= "table" or type(result.code) ~= "string" then
		return nil, "Erreur pendant la génération du code : résultat invalide.", warnings, nil
	end
	for _, message in ipairs(result.warnings or {}) do
		table.insert(warnings, tostring(message))
	end
	for _, message in ipairs(result.errors or {}) do
		table.insert(warnings, "Erreur : " .. tostring(message))
	end
	local code = result.code
	local linesJson = encodeLineMap(result.lineMap)

	-- Un seul instantané : celui écrit dans le script est aussi celui marqué « enregistré » à la fin
	-- (UpdateSourceAsync cède la main : un changement fait pendant l'écriture reste non enregistré)
	local okData, data = pcall(function()
		return model:serialize()
	end)
	if not okData then
		return nil, "Impossible de préparer les données du projet : " .. tostring(data), warnings, code
	end
	local json, jsonErr = encodeData(data)
	if json == nil then
		return nil, jsonErr, warnings, code
	end

	-- Script existant : seulement un script Blocs FR qui est toujours un enfant direct de la cible
	if existingScript ~= nil then
		local okParent, parent = pcall(function()
			return existingScript.Parent
		end)
		if not okParent or parent ~= target or not Storage.isProjectScript(existingScript) then
			existingScript = nil
		end
	end
	if existingScript == nil then
		existingScript = Storage.findProjectScript(target)
	end

	local spec = Storage.scriptSpec(mode, target)
	local placement = placementWarning(mode, spec, target)
	if placement ~= nil then
		table.insert(warnings, placement)
	end
	local okChildren, children = pcall(function()
		return target:GetChildren()
	end)
	if okChildren then
		for _, child in ipairs(children) do
			if child ~= existingScript and Storage.isProjectScript(child) then
				if mode == "module" or child:IsA("ModuleScript") then
					-- un module ne s'exécute pas tout seul : seule l'ouverture de la cible est ambiguë
					table.insert(
						warnings,
						"Un autre script Blocs FR (« "
							.. child.Name
							.. " ») se trouve aussi dans cette cible : l'éditeur n'ouvrira que le premier des deux. Range chaque projet dans son propre objet."
					)
				else
					table.insert(
						warnings,
						"Un autre script Blocs FR (« " .. child.Name .. " ») se trouve aussi dans cette cible : il s'exécutera en plus de celui-ci."
					)
				end
			end
		end
	end

	-- Écriture dans un seul enregistrement de l'historique de Studio
	local history = getService("ChangeHistoryService")
	local recording = beginRecording(history)
	local okWrite, written = pcall(writeScript, target, existingScript, spec, mode, code, json, linesJson)
	finishRecording(history, recording, okWrite)
	if not okWrite then
		return nil, "Impossible d'écrire le script dans « " .. Storage.pathOf(target) .. " » : " .. tostring(written), warnings, code
	end

	pcall(function()
		model:markSaved(data)
	end)
	return written, nil, warnings, code
end

---------------------------------------------------------------------------
-- Divers
---------------------------------------------------------------------------

-- "Workspace.Porte"
function Storage.pathOf(inst)
	if typeof(inst) ~= "Instance" then
		return "(aucune)"
	end
	if inst == game then
		return "game"
	end
	local ok, fullName = pcall(function()
		return inst:GetFullName()
	end)
	if ok and type(fullName) == "string" then
		return fullName
	end
	return tostring(inst.Name)
end

-- Premier objet sélectionné dans l'Explorateur, sinon Workspace
function Storage.defaultTarget()
	local selection = getService("Selection")
	if selection ~= nil then
		local ok, list = pcall(function()
			return selection:Get()
		end)
		if ok and type(list) == "table" and typeof(list[1]) == "Instance" then
			return list[1]
		end
	end
	return workspace
end

return Storage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Theme : couleurs, polices et dimensions de Blocs FR (thème sombre, comme Visual Script)
--
-- Les valeurs écrites ici sont celles du thème « Sombre » par défaut. Les paramètres du plugin
-- (Reglages.applyToTheme, SPEC §31) modifient SUR PLACE les tables Theme.Colors, Theme.TextSize,
-- Theme.Layout, Theme.Block, Theme.Canvas et Theme.Anim (les modules qui gardent une référence à ces
-- tables voient donc les nouvelles valeurs) en repartant toujours des valeurs d'origine gardées dans
-- Theme.Base (copie faite à la fin de ce fichier) : changer de thème puis revenir redonne exactement
-- les mêmes couleurs.
-- Clés ajoutées pour les paramètres : Theme.Block.Style ("relief" | "plat" | "contour" | "bonbon"),
-- Theme.Canvas = { GridStyle, GridSize, Zoom, MiniCarte }, Theme.Anim.Facteur (durées × facteur),
-- Theme.NoteColors (couleurs des notes), Theme.luminance / Theme.contrast / Theme.textOn.

local Theme = {}

-- Couleurs issues du design Claude Design « Blocs FR — interface et logo »
Theme.Colors = {
	Background = Color3.fromRGB(20, 20, 22), -- fond du canvas (#141416)
	GridDot = Color3.fromRGB(46, 46, 53), -- points de la grille (#2E2E35)
	Panel = Color3.fromRGB(28, 28, 32), -- panneau de gauche / barres (#1C1C20)
	PanelAlt = Color3.fromRGB(35, 35, 40), -- cartes (#232328)
	PanelBorder = Color3.fromRGB(42, 42, 48), -- séparateurs (#2A2A30)
	Button = Color3.fromRGB(38, 38, 43), -- (#26262B)
	ButtonHover = Color3.fromRGB(48, 48, 54), -- (#303036)
	ButtonActive = Color3.fromRGB(58, 58, 66), -- (#3A3A42)
	ButtonActiveStroke = Color3.fromRGB(74, 74, 84), -- (#4A4A54)
	Text = Color3.fromRGB(236, 236, 239), -- (#ECECEF)
	TextSoft = Color3.fromRGB(201, 201, 207), -- (#C9C9CF)
	TextDim = Color3.fromRGB(154, 154, 162), -- (#9A9AA2)
	TextDisabled = Color3.fromRGB(107, 107, 115), -- (#6B6B73)
	TextDark = Color3.fromRGB(31, 31, 35), -- (#1F1F23)
	Accent = Color3.fromRGB(37, 99, 235), -- bleu (#2563EB)
	AccentHover = Color3.fromRGB(59, 118, 240),
	AccentText = Color3.fromRGB(143, 178, 255), -- (#8FB2FF)
	Danger = Color3.fromRGB(229, 72, 77), -- (#E5484D)
	DangerText = Color3.fromRGB(255, 133, 137), -- (#FF8589)
	Warning = Color3.fromRGB(240, 180, 60), -- (#F0B43C)
	WarningText = Color3.fromRGB(243, 199, 102), -- (#F3C766)
	Success = Color3.fromRGB(34, 165, 90), -- (#22A55A)
	SuccessText = Color3.fromRGB(60, 207, 122),
	Info = Color3.fromRGB(37, 99, 235),
	InfoText = Color3.fromRGB(143, 178, 255),
	InputBg = Color3.fromRGB(255, 255, 255),
	InputText = Color3.fromRGB(31, 31, 35),
	SearchBg = Color3.fromRGB(38, 38, 43),
	SearchStroke = Color3.fromRGB(52, 52, 59),
	FieldBg = Color3.fromRGB(20, 20, 22), -- champs des fenêtres (#141416)
	Overlay = Color3.fromRGB(0, 0, 0), -- fond des fenêtres modales (avec transparence)
	SnapHighlight = Color3.fromRGB(255, 255, 255),
	Popup = Color3.fromRGB(31, 31, 36), -- menus et fenêtres (#1F1F24)
	PopupBorder = Color3.fromRGB(52, 52, 59), -- (#34343B)
	PopupHover = Color3.fromRGB(44, 44, 51), -- (#2C2C33)
	Tooltip = Color3.fromRGB(14, 14, 16),
	CodeBg = Color3.fromRGB(18, 18, 20), -- (#121214)
	-- Studio d'interface (design « Studio d'interface + blocs de l'écran »)
	LinkHighlight = Color3.fromRGB(34, 211, 238), -- lien bloc ↔ élément (#22D3EE)
	LinkBadge = Color3.fromRGB(14, 116, 144), -- pastille « ◆ 1 script » (#0E7490)
	Guide = Color3.fromRGB(255, 59, 212), -- repères d'alignement (#FF3BD4)
	DeviceFrame = Color3.fromRGB(11, 11, 13), -- cadre de l'appareil (#0B0B0D)
	Splitter = Color3.fromRGB(24, 24, 27), -- séparateur réglable (#18181B)
	ModelesAccent = Color3.fromRGB(245, 158, 11), -- tuile « Modèles » (#F59E0B)
}

-- Mises à jour : identifiant du plugin publié sur le Creator Store (0 = pas encore publié)
-- et adresse facultative d'un fichier JSON { "version": "2.2.0", "notes": "..." } ("" = désactivé)
Theme.PluginAssetId = 0
Theme.UpdateUrl = ""

-- Durées des animations de l'éditeur (secondes)
Theme.Anim = {
	Fast = 0.12,
	Normal = 0.22,
	Slow = 0.35,
	-- Vitesse choisie dans les paramètres : Anim multiplie chaque durée par ce facteur
	-- (lente = 1.5, normale = 1, rapide = 0.6). Fast / Normal / Slow restent les durées de base.
	Facteur = 1,
}

-- Logo : laisser "" pour dessiner le logo avec des Frames ; sinon "rbxassetid://..." (icône importée)
Theme.LogoAssetId = ""
-- Icône des boutons de la barre d'outils de Studio (logo importé sur Roblox)
Theme.ToolbarIconId = "rbxassetid://93240659392576"
Theme.LogoColors = {
	Tile = Color3.fromRGB(35, 35, 40), -- #232328
	Blue = Color3.fromRGB(43, 89, 195), -- #2B59C3
	White = Color3.fromRGB(244, 244, 245), -- #F4F4F5
	Red = Color3.fromRGB(229, 56, 59), -- #E5383B
}

-- Coloration syntaxique pour la vue du code
Theme.Code = {
	Keyword = Color3.fromRGB(248, 109, 124),
	String = Color3.fromRGB(173, 241, 149),
	Number = Color3.fromRGB(255, 198, 0),
	Comment = Color3.fromRGB(102, 102, 102),
	Builtin = Color3.fromRGB(132, 214, 247),
	Text = Color3.fromRGB(204, 204, 204),
	LineNumber = Color3.fromRGB(90, 90, 90),
}

Theme.Fonts = {
	Block = Enum.Font.GothamBold,
	UI = Enum.Font.GothamMedium,
	UIBold = Enum.Font.GothamBold,
	Code = Enum.Font.Code,
}

Theme.TextSize = {
	Block = 13,
	UI = 13,
	Small = 11,
	Title = 15,
	Code = 14,
}

-- Dimensions des blocs (unités du canvas, zoom = 1)
Theme.Block = {
	PadX = 11, -- marge horizontale à l'intérieur d'un bloc
	PadY = 5, -- marge verticale minimale autour du contenu d'une ligne
	Gap = 6, -- espace entre deux éléments d'une ligne (texte / champ)
	RowMinHeight = 36, -- hauteur minimale d'une ligne de bloc instruction
	HatBump = 12, -- hauteur supplémentaire de la "bosse" au-dessus d'un bloc événement (total 48)
	HatRadius = 18, -- arrondi du coin supérieur gauche d'un bloc événement
	ArmWidth = 16, -- largeur du bras gauche d'un bloc C
	MouthMinHeight = 24, -- hauteur minimale de la bouche d'un bloc C vide
	BottomArmHeight = 16, -- hauteur du bras inférieur d'un bloc C
	BottomArmMinWidth = 140,
	MiddleArmMinHeight = 30, -- hauteur de la ligne "sinon"
	ReporterMinHeight = 26, -- hauteur minimale d'un bloc valeur
	BooleanMinHeight = 30, -- hauteur minimale d'un bloc condition
	BoolPointWidth = 13, -- largeur des pointes d'un bloc condition
	ReporterPadX = 9,
	FieldHeight = 22, -- hauteur d'un champ de saisie
	FieldRadius = 11, -- champ blanc en forme de pilule
	FieldMinWidth = 26,
	FieldPadX = 8,
	FieldTextSize = 12,
	DropdownRadius = 6,
	DropdownDarken = 0.26, -- assombrissement de la couleur du bloc pour les listes
	BoolSlotWidth = 40, -- largeur d'une case booléenne vide
	BoolSlotHeight = 20,
	ColorSwatchWidth = 30,
	ColorSwatchHeight = 18,
	Corner = 6, -- arrondi des blocs instruction
	BottomShade = 2, -- bande plus sombre en bas des blocs
	BottomShadeDarken = 0.22,
	NotchWidth = 18, -- languette sous les blocs instruction
	NotchHeight = 5,
	NotchOffset = 14,
	StrokeThickness = 1,
	SnapDistance = 28, -- aimant (paramètre « zone.aimant » ; 0 = désactivé)
	StackGap = 40, -- espace entre piles lors du rangement
	-- Style des blocs (paramètre « blocs.style », lu par Renderer) :
	--   "relief"  = bande sombre en bas + contour fin (le style d'origine)
	--   "plat"    = ni bande sombre ni contour
	--   "contour" = contour de 2 px (couleur assombrie de 0,35)
	--   "bonbon"  = dégradé vertical (haut plus clair), arrondi × 1,6, liseré blanc intérieur
	Style = "relief",
}

Theme.Layout = {
	TopBarHeight = 48,
	StatusBarHeight = 28,
	PanelWidth = 280,
	CategoryButtonHeight = 32,
	SearchHeight = 36,
	ProblemsPanelWidth = 430,
	-- Onglet « Interface »
	GuiLeftWidth = 250, -- éléments, modèles d'interface, calques
	GuiRightWidth = 300, -- propriétés
	GuiPaletteWidth = 230, -- palette de la zone « Blocs de l'écran »
	GuiSplitterHeight = 14,
	GuiBlocksHeaderHeight = 40,
	GuiPreviewMinHeight = 200,
	GuiBlocksMinHeight = 160,
}

-- Zone de travail (paramètres « zone.* » et « blocs.echelle », lus par Canvas)
Theme.Canvas = {
	GridStyle = "points", -- "points" | "lignes" | "aucune"
	GridSize = 22, -- espacement de la grille (unités du canvas)
	Zoom = 1, -- zoom de départ (« Taille des blocs », 0,7 à 1,4)
	MiniCarte = true, -- mini-carte en bas à gauche
}

-- Couleurs des notes de la zone de travail (SPEC §29, planche « Notes ») : fond, bandeau, texte
Theme.NoteColors = {
	jaune = {
		Fond = Color3.fromRGB(253, 230, 138), -- #FDE68A
		Entete = Color3.fromRGB(252, 211, 77), -- #FCD34D
		Texte = Color3.fromRGB(66, 32, 6), -- #422006
	},
	vert = {
		Fond = Color3.fromRGB(187, 247, 208), -- #BBF7D0
		Entete = Color3.fromRGB(134, 239, 172), -- #86EFAC
		Texte = Color3.fromRGB(5, 46, 22), -- #052E16
	},
	bleu = {
		Fond = Color3.fromRGB(191, 219, 254), -- #BFDBFE
		Entete = Color3.fromRGB(147, 197, 253), -- #93C5FD
		Texte = Color3.fromRGB(23, 37, 84), -- #172554
	},
	rose = {
		Fond = Color3.fromRGB(251, 207, 232), -- #FBCFE8
		Entete = Color3.fromRGB(249, 168, 212), -- #F9A8D4
		Texte = Color3.fromRGB(80, 7, 36), -- #500724
	},
	violet = {
		Fond = Color3.fromRGB(221, 214, 254), -- #DDD6FE
		Entete = Color3.fromRGB(196, 181, 253), -- #C4B5FD
		Texte = Color3.fromRGB(46, 16, 101), -- #2E1065
	},
}

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

-- Assombrit une couleur (amount entre 0 et 1)
function Theme.darken(color: Color3, amount: number): Color3
	local k = 1 - clamp01(amount)
	return Color3.new(color.R * k, color.G * k, color.B * k)
end

-- Éclaircit une couleur (amount entre 0 et 1)
function Theme.lighten(color: Color3, amount: number): Color3
	local a = clamp01(amount)
	return Color3.new(color.R + (1 - color.R) * a, color.G + (1 - color.G) * a, color.B + (1 - color.B) * a)
end

local function linear(x)
	if x <= 0.03928 then
		return x / 12.92
	end
	return ((x + 0.055) / 1.055) ^ 2.4
end

-- Luminance relative d'une couleur (0 = noir, 1 = blanc), comme dans les règles d'accessibilité
function Theme.luminance(color: Color3): number
	return 0.2126 * linear(color.R) + 0.7152 * linear(color.G) + 0.0722 * linear(color.B)
end

-- Contraste entre deux couleurs (1 = aucun, 21 = noir sur blanc)
function Theme.contrast(a: Color3, b: Color3): number
	local la = Theme.luminance(a)
	local lb = Theme.luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- Couleur de texte lisible sur un fond : blanc, sauf sur les fonds clairs (texte sombre)
function Theme.textOn(background: Color3): Color3
	local white = Color3.fromRGB(255, 255, 255)
	local dark = Color3.fromRGB(31, 31, 35)
	if Theme.contrast(background, white) >= Theme.contrast(background, dark) then
		return white
	end
	return dark
end

-- Valeurs d'origine (thème « Sombre »), copiées une seule fois au chargement : Reglages.applyToTheme
-- repart toujours d'elles. Ne pas modifier.
local function snapshot(t)
	local copy = {}
	for key, value in pairs(t) do
		copy[key] = value
	end
	return copy
end

Theme.Base = {
	Colors = snapshot(Theme.Colors),
	TextSize = snapshot(Theme.TextSize),
	Layout = snapshot(Theme.Layout),
	Block = snapshot(Theme.Block),
	Canvas = snapshot(Theme.Canvas),
	Anim = snapshot(Theme.Anim),
}

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">TopBar</string><ProtectedString name="Source"><![CDATA[-- TopBar : barre d'outils du haut de Blocs FR (48 px ; boards « Blocs FR — interface et logo » et
-- « Studio d'interface »).
--   Onglet Blocs :
--     [logo] Blocs FR │ [Blocs | Interface] │ Nouveau · Ouvrir · Enregistrer │ [Script serveur | Script local |
--     Script module] · Voir le code · Expliquer │ Annuler Refaire · Ranger … [Cible  Workspace.Porte]
--     ● Non enregistré  [✓ | ⚠ n]  Wiki  ?
--   Onglet Interface (SPEC §21.8) :
--     [logo] Blocs FR │ [Blocs | Interface] │ Écran  Menu ▼ · Enregistrer l'écran · Aperçu │ Annuler Refaire
--     … [Dans  StarterGui → Menu]  ● Non enregistré  [✓ | ⚠ n]  Wiki  ?
-- La barre se compacte toute seule quand le widget est étroit (largeur minimale du widget : 760 px) :
-- marges réduites, nom « Blocs FR » masqué, textes raccourcis (« Code », « Enregistrer », « Serveur | Local |
-- Module », « ● », « ← » / « → » pour Annuler / Refaire), puis « Expliquer » (premier bouton masqué), la puce
-- de la cible, « Wiki » (le « ? » ouvre aussi le wiki) et « Ranger » ; enfin le type de script devient un menu
-- « Serveur ▼ » et « Nouveau » + « Ouvrir » deviennent un menu « Fichier ▼ ».
--
-- Animations (SPEC §24, module Anim) : survol en fondu (0,12 s) et appui (94 % puis petit rebond) sur chaque
-- bouton (ancrés au centre pour rétrécir sur eux-mêmes), pastilles des onglets et du type de script qui
-- glissent d'un segment à l'autre, « ● Non enregistré » qui apparaît en fondu, bouton des problèmes qui
-- « saute » quand son texte change, logo qui fait coucou au survol.
--
-- Menus (SPEC §33, « clic droit comme sur le bureau de Windows ») :
--   * « ? » : Ouvrir le wiki, Aide sur l'éditeur | Paramètres…, Prévisualiseur de hitbox, Partager ce
--     script…, Importer un code… | Animations de l'éditeur (coche), Nouveautés, À propos de Blocs FR <version> ;
--   * « Écran ▼ » : les écrans (coche sur l'écran ouvert) | Nouvel écran, Modèles d'interface ›, Renommer,
--     Supprimer ;
--   * clic droit sur la puce de la cible, le bouton des problèmes, « Enregistrer », « Écran ▼ » et « ? ».
-- topbar:setUpdateDot(bool) : petit point sur le « ? » (mise à jour disponible, SPEC §25).
--
-- API : TopBar.new(parentFrame, deps) (deps = { app, dialogs, host }) ; topbar:update(state) ;
--   topbar:setUpdateDot(bool) ; topbar:getDebugState() ; topbar:destroy().
-- state = { workspace = "blocs" | "interface", targetPath, mode, dirty, canUndo, canRedo, zoom, hasScript,
--           problems = { erreur = n, avertissement = n, conseil = n } | nil (pas encore analysé),
--           problemsVisible, explainVisible, codeVisible, screenName, screenSaved, screenPath, previewOn }
-- Méthodes de deps.app utilisées (toutes facultatives : sinon une notification le dit) : setWorkspace,
--   newProject, openFromSelection, save, setMode, showCode, explain, undo, redo, cleanUp, toggleProblems,
--   recheck, clearTestErrors, openWiki, help, openSettings, openHitboxPreview, shareScript, importCode,
--   setAnimations, saveScreen, togglePreview, openScreen, newScreen, insertTemplate, renameScreen,
--   deleteScreen, listScreens, listTemplates, selectInExplorer.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Logo = require(script.Parent.Logo)
local Anim = require(script.Parent.Anim)

local TopBar = {}
TopBar.__index = TopBar

-- Couleurs du thème lues à chaque usage (les paramètres peuvent changer le thème)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})
local FONT = Theme.Fonts.UI
local FONT_BOLD = Theme.Fonts.UIBold
local TEXT_SIZE = 13
local SMALL_SIZE = 12
local TAB_SIZE = 12
local BUTTON_H = 30
local SQUARE_W = 30
local LOGO_SIZE = 26
local CORNER = 7
local SEPARATOR_H = 22
local CHIP_MIN = 110 -- en dessous, la puce de la cible est masquée
local CHIP_MAX = 380
local CHIP_H = 30
local CHIP_PAD = 10
local SEG_INSET = 3 -- marge intérieure des contrôles segmentés
local SEG_GAP = 2
local TOOLTIP_DELAY = 0.55
local MENU_GAP = 6
local WHITE = Color3.fromRGB(255, 255, 255)

-- Couleurs par gravité : noms des couleurs du thème { couleur de base, texte lisible sur fond sombre }
local SEVERITY_KEYS = {
	erreur = { "Danger", "DangerText" },
	avertissement = { "Warning", "WarningText" },
	conseil = { "Info", "InfoText" },
}

local TEXTS = {
	code = { "Voir le code", "Code" },
	dirty = { "● Non enregistré", "●" },
	undo = { "Annuler", "←" },
	redo = { "Refaire", "→" },
	saveScreen = { "Enregistrer l'écran", "Enregistrer" },
}

local MODE_LONG = { server = "Script serveur", ["local"] = "Script local", module = "Script module" }
local MODE_SHORT = { server = "Serveur", ["local"] = "Local", module = "Module" }
local MODE_ORDER = { "server", "local", "module" }

-- Niveaux de compactage, du plus confortable au plus serré (chaque étape s'ajoute aux précédentes).
-- margin : marges gauche/droite ; pad : marge intérieure des boutons ; gap : espace entre éléments ;
-- sepGap : espace autour des séparateurs ; middle : espace minimal entre la gauche et la puce de la cible ;
-- tabPad : marge intérieure des onglets ; segPad (facultatif) : marge des segments du type de script
-- (sinon max(8, pad - 2)) ; screenMax : largeur maximale du nom de l'écran (onglet Interface).
-- Estimé avec la police réelle (Montserrat) : le niveau le plus serré tient dans 760 px (onglet Blocs, projet
-- modifié, « ⚠ 12 »), l'onglet Interface aussi.
local BASE_LEVEL = {
	margin = 12,
	pad = 12,
	gap = 6,
	sepGap = 10,
	middle = 16,
	tabPad = 14,
	screenMax = 200,
	brand = true,
	codeLong = true,
	saveScreenLong = true,
	modeLong = true,
	dirtyText = true,
	undoLong = true,
	explain = true,
	chip = true,
	wiki = true,
	ranger = true,
	modeMenu = false,
	fileMenu = false,
}
local STEPS = {
	{},
	{ margin = 10, pad = 10, gap = 5, sepGap = 8, middle = 12, tabPad = 12 },
	{ brand = false },
	{ codeLong = false, saveScreenLong = false },
	{ modeLong = false },
	{ dirtyText = false },
	{ undoLong = false },
	{ margin = 8, pad = 8, gap = 4, sepGap = 5, middle = 8, tabPad = 10, screenMax = 150 },
	{ explain = false },
	{ chip = false },
	{ wiki = false },
	{ ranger = false },
	{ modeMenu = true },
	{ margin = 6, pad = 6, segPad = 6, gap = 3, sepGap = 4, middle = 4, tabPad = 8, screenMax = 110 },
	{ fileMenu = true },
}
local LEVELS = {}
do
	local current = table.clone(BASE_LEVEL)
	for _, step in ipairs(STEPS) do
		for key, value in pairs(step) do
			current[key] = value
		end
		table.insert(LEVELS, table.clone(current))
	end
end

local DEFAULT_STATE = {
	workspace = "blocs",
	targetPath = "",
	mode = "server",
	dirty = false,
	canUndo = false,
	canRedo = false,
	zoom = 1,
	hasScript = false,
	problemsVisible = false,
	explainVisible = false,
	codeVisible = false,
	screenSaved = false,
	previewOn = false,
}

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

local function plural(n, word)
	if n > 1 then
		return n .. " " .. word .. "s"
	end
	return n .. " " .. word
end

-- Durée d'animation du thème (Anim la multiplie lui-même par la vitesse choisie)
local function animTime(key, default)
	local anim = Theme.Anim
	if type(anim) == "table" and type(anim[key]) == "number" then
		return anim[key]
	end
	return default
end

-- Texte lisible sur le fond des segments actifs (clair dans les thèmes sombres, foncé dans « Clair »)
local function activeTextColor()
	local bg = C.ButtonActive
	if typeof(bg) == "Color3" and type(Theme.textOn) == "function" then
		local ok, color = pcall(Theme.textOn, bg)
		if ok and typeof(color) == "Color3" then
			return color
		end
	end
	return WHITE
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = TEXT_SIZE,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Caractères UTF-8 d'un texte (octets seuls si le texte est abîmé)
local function utf8Chars(text)
	local chars = {}
	local ok = pcall(function()
		for _, cp in utf8.codes(text) do
			table.insert(chars, utf8.char(cp))
		end
	end)
	if not ok then
		chars = {}
		for i = 1, #text do
			chars[i] = string.sub(text, i, i)
		end
	end
	return chars
end

-- Raccourcit un chemin par la gauche (« …Maison.Porte ») pour qu'il tienne dans maxWidth
local function truncateLeft(text, maxWidth, size, font)
	if maxWidth <= 0 then
		return ""
	end
	if textWidth(text, size, font) <= maxWidth then
		return text
	end
	local chars = utf8Chars(text)
	-- recherche dichotomique du plus long suffixe qui tient avec « … »
	local lo, hi = 2, #chars + 1
	while lo < hi do
		local mid = math.floor((lo + hi) / 2)
		if textWidth("…" .. table.concat(chars, "", mid), size, font) <= maxWidth then
			hi = mid
		else
			lo = mid + 1
		end
	end
	return "…" .. table.concat(chars, "", lo)
end

-- Raccourcit un nom par la droite (« Menu princ… ») pour qu'il tienne dans maxWidth
local function truncateRight(text, maxWidth, size, font)
	if maxWidth <= 0 then
		return ""
	end
	if textWidth(text, size, font) <= maxWidth then
		return text
	end
	local chars = utf8Chars(text)
	local lo, hi = 0, #chars
	while lo < hi do
		local mid = math.floor((lo + hi + 1) / 2)
		if textWidth(table.concat(chars, "", 1, mid) .. "…", size, font) <= maxWidth then
			lo = mid
		else
			hi = mid - 1
		end
	end
	return table.concat(chars, "", 1, lo) .. "…"
end

-- Texte sûr dans un TextLabel en RichText
local function escapeRich(text)
	text = string.gsub(tostring(text or ""), "&", "&amp;")
	text = string.gsub(text, "<", "&lt;")
	text = string.gsub(text, ">", "&gt;")
	text = string.gsub(text, "\"", "&quot;")
	return text
end

local function rgbText(color)
	if typeof(color) ~= "Color3" then
		return "rgb(154,154,162)"
	end
	return string.format(
		"rgb(%d,%d,%d)",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- Espace entre deux éléments voisins (a à gauche de b)
local function spacing(a, b, L)
	if a.sep or b.sep then
		return L.sepGap
	end
	if b.gapBefore then
		return b.gapBefore
	end
	return L.gap
end

-- Largeur totale d'un groupe d'éléments visibles ({ item, w })
local function groupWidth(visible, L)
	local total = 0
	for i, entry in ipairs(visible) do
		if i > 1 then
			total += spacing(visible[i - 1].item, entry.item, L)
		end
		total += entry.w
	end
	return total
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function TopBar.new(parentFrame, deps)
	local self = setmetatable({}, TopBar)
	self.deps = deps or {}
	self.app = self.deps.app
	self.dialogs = self.deps.dialogs
	self.connections = {}
	self.buttons = {}
	self.segs = {}
	self.state = table.clone(DEFAULT_STATE)
	self.level = LEVELS[1]
	self.levelIndex = 1
	self.leftItems = {}
	self.rightItems = {}
	self._hoverToken = 0
	self._tooltipShown = false
	self._problemsText = nil -- texte du bouton des problèmes (il « saute » quand il change)
	self._updateDot = false
	self._visibleKeys = {}
	self.updateDot = nil
	self._destroyed = false

	-- Anim lit le réglage « Animations » (App l'initialise aussi ; ceci sert si ce n'est pas encore fait)
	if not Anim.isInitialized() then
		local host = (self.app and self.app.host) or self.deps.host
		if type(host) == "table" then
			pcall(Anim.init, host)
		end
	end

	self.frame = Util.create("Frame", {
		Name = "BarreHaut",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = parentFrame,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 2,
		Parent = self.frame,
	})

	self:_buildLeft()
	self:_buildRight()
	self:_buildChip()

	table.insert(self.connections, self.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_layout()
	end))
	self:update(self.state)
	return self
end

function TopBar:_buildLeft()
	local left = self.leftItems

	-- Logo (petit coucou au survol) + nom du plugin
	local logo = Logo.create(self.frame, LOGO_SIZE, 1)
	logo.AnchorPoint = Vector2.new(0, 0.5)
	self.logo = logo
	table.insert(left, {
		key = "logo",
		inst = logo,
		height = LOGO_SIZE,
		measure = function()
			return LOGO_SIZE
		end,
	})
	if type(Logo.attachHover) == "function" then
		local ok, disconnect = pcall(Logo.attachHover, logo)
		if ok and type(disconnect) == "function" then
			table.insert(self.connections, { Disconnect = disconnect })
		end
	end
	local brand = makeLabel({
		Name = "Nom",
		Text = "Blocs FR",
		Font = FONT_BOLD,
		TextSize = 15,
		AnchorPoint = Vector2.new(0, 0.5),
		Visible = false,
		Parent = self.frame,
	})
	table.insert(left, {
		key = "brand",
		inst = brand,
		height = 20,
		gapBefore = 9,
		measure = function(L)
			if L.brand then
				return textWidth("Blocs FR", 15, FONT_BOLD) + 2
			end
			return 0
		end,
	})
	self:_addSeparator(left)

	-- Onglets « Blocs | Interface » (toujours visibles)
	self.segs.tabs = self:_addSegmented(left, "Espace", {
		textSize = TAB_SIZE,
		specs = {
			{
				value = "blocs",
				texts = { "Blocs", "Blocs" },
				tip = "Blocs : programme tes objets avec des blocs (scripts serveur, locaux et modules)",
			},
			{
				value = "interface",
				texts = { "Interface", "Interface" },
				tip = "Interface : dessine les écrans de ton jeu (menus, boutons, barres de vie…) et leurs blocs",
			},
		},
		current = function()
			return self:_workspace()
		end,
		onPick = function(value)
			self:_callApp("setWorkspace", value)
		end,
		long = function()
			return true
		end,
		pad = function(L)
			return L.tabPad
		end,
	})
	self:_addSeparator(left)

	-- Onglet Blocs : fichier
	self.buttons.file = self:_addButton(left, "Fichier", {
		ws = "blocs",
		text = "Fichier ▼",
		visible = function(L)
			return L.fileMenu
		end,
		tip = "Nouveau projet, ouvrir un script, partager ou importer un code",
		onClick = function(btn)
			self:_openFileMenu(btn.inst)
		end,
	})
	self.buttons.new = self:_addButton(left, "Nouveau", {
		ws = "blocs",
		text = "Nouveau",
		visible = function(L)
			return not L.fileMenu
		end,
		tip = "Nouveau projet vide pour l'objet sélectionné dans l'Explorateur",
		onClick = function()
			self:_callApp("newProject")
		end,
	})
	self.buttons.open = self:_addButton(left, "Ouvrir", {
		ws = "blocs",
		text = "Ouvrir",
		visible = function(L)
			return not L.fileMenu
		end,
		tip = "Ouvrir le script Blocs FR de l'objet sélectionné dans l'Explorateur",
		onClick = function()
			self:_callApp("openFromSelection")
		end,
	})
	self.buttons.save = self:_addButton(left, "Enregistrer", {
		ws = "blocs",
		text = "Enregistrer",
		style = "primary",
		tip = function()
			local kind = "script Luau"
			if self.state.mode == "module" then
				kind = "script module Luau"
			end
			local text = "Transformer les blocs en " .. kind .. " dans « " .. self:_path() .. " »"
			if self.state.hasScript then
				text = text .. " (le script existant sera mis à jour)"
			end
			return text .. "\nClic droit : partager ou importer un code"
		end,
		onClick = function()
			self:_callApp("save")
		end,
		onRightClick = function()
			self:_openSaveMenu(nil)
		end,
	})
	self:_addSeparator(left, "blocs")

	-- Onglet Blocs : type de script (contrôle segmenté, ou menu quand la barre est très étroite) + code
	self.segs.mode = self:_addSegmented(left, "Mode", {
		ws = "blocs",
		visible = function(L)
			return not L.modeMenu
		end,
		specs = {
			{
				value = "server",
				texts = { MODE_LONG.server, MODE_SHORT.server },
				tip = "Script serveur : s'exécute sur le serveur, pour tout le monde (portes, pièges, points…)",
			},
			{
				value = "local",
				texts = { MODE_LONG["local"], MODE_SHORT["local"] },
				tip = "Script local : s'exécute chez chaque joueur (touches du clavier, caméra, effets visibles par lui seul…)",
			},
			{
				value = "module",
				texts = { MODE_LONG.module, MODE_SHORT.module },
				tip = "Script module : une boîte à outils (fonctions et valeurs) que les autres scripts utilisent avec « appeler la fonction … du module »",
			},
		},
		current = function()
			return self:_currentMode()
		end,
		onPick = function(value)
			if self.state.mode ~= value then
				self:_callApp("setMode", value)
			end
		end,
		long = function(L)
			return L.modeLong
		end,
	})
	self.buttons.modeMenu = self:_addButton(left, "TypeDeScript", {
		ws = "blocs",
		visible = function(L)
			return L.modeMenu
		end,
		pickText = function()
			return MODE_SHORT[self:_currentMode()] .. " ▼"
		end,
		tip = "Type de script : serveur, local ou module",
		onClick = function(btn)
			self:_openModeMenu(btn.inst)
		end,
	})
	self.buttons.code = self:_addButton(left, "VoirCode", {
		ws = "blocs",
		pickText = function(L)
			if L.codeLong then
				return TEXTS.code[1]
			end
			return TEXTS.code[2]
		end,
		tip = "Afficher le code Luau fabriqué à partir de tes blocs",
		onClick = function()
			self:_callApp("showCode")
		end,
	})
	self.buttons.explain = self:_addButton(left, "Expliquer", {
		ws = "blocs",
		text = "Expliquer",
		visible = function(L)
			return L.explain
		end,
		tip = "Explique-moi ce script : ce que font tes blocs, étape par étape (et la simulation 3D des attaques)",
		onClick = function()
			self:_callApp("explain")
		end,
	})
	self:_addSeparator(left, "blocs")

	-- Onglet Interface : écran, enregistrer l'écran, aperçu
	self.buttons.screen = self:_addButton(left, "Ecran", {
		ws = "interface",
		richText = true,
		pickText = function(L)
			return self:_screenRich(L)
		end,
		measure = function(L)
			return textWidth(self:_screenPlain(L), TEXT_SIZE, FONT) + 2 * L.pad
		end,
		tip = "Choisir l'écran à modifier, en créer un nouveau (vide ou depuis un modèle), le renommer ou le supprimer",
		onClick = function(btn)
			self:_openScreenMenu(btn.inst)
		end,
		onRightClick = function()
			self:_openScreenMenu(nil)
		end,
	})
	self.buttons.saveScreen = self:_addButton(left, "EnregistrerEcran", {
		ws = "interface",
		style = "primary",
		pickText = function(L)
			if L.saveScreenLong then
				return TEXTS.saveScreen[1]
			end
			return TEXTS.saveScreen[2]
		end,
		tip = "Enregistrer l'écran dans StarterGui, avec ses blocs (script local « BlocsLocal » dans l'écran)",
		onClick = function()
			self:_callApp("saveScreen")
		end,
	})
	self.buttons.preview = self:_addButton(left, "Apercu", {
		ws = "interface",
		text = "Aperçu",
		tip = "Aperçu : essaie ton écran comme dans le jeu (les boutons réagissent, rien n'est modifié). Clique encore pour revenir à l'édition.",
		onClick = function()
			self:_callApp("togglePreview")
		end,
	})
	self:_addSeparator(left, "interface")

	-- Historique + rangement
	self.buttons.undo = self:_addButton(left, "Annuler", {
		pickText = function(L)
			if L.undoLong then
				return TEXTS.undo[1]
			end
			return TEXTS.undo[2]
		end,
		tip = function()
			if self:_workspace() == "interface" then
				return "Annuler la dernière action (sur l'écran ou sur ses blocs : ce que tu as modifié en dernier)"
			end
			return "Annuler la dernière action"
		end,
		onClick = function()
			self:_callApp("undo")
		end,
	})
	self.buttons.redo = self:_addButton(left, "Refaire", {
		gapBefore = 3,
		pickText = function(L)
			if L.undoLong then
				return TEXTS.redo[1]
			end
			return TEXTS.redo[2]
		end,
		tip = "Refaire l'action annulée",
		onClick = function()
			self:_callApp("redo")
		end,
	})
	self.buttons.cleanUp = self:_addButton(left, "Ranger", {
		ws = "blocs",
		text = "Ranger",
		visible = function(L)
			return L.ranger
		end,
		tip = "Ranger les groupes de blocs en colonnes",
		onClick = function()
			self:_callApp("cleanUp")
		end,
	})
end

-- Groupe de droite, rangé de droite à gauche : ?, Wiki, problèmes, « non enregistré »
function TopBar:_buildRight()
	local right = self.rightItems

	self.buttons.help = self:_addButton(right, "Aide", {
		text = "?",
		square = true,
		bold = true,
		textSize = 15,
		tip = function()
			if self._updateDot then
				return "Une mise à jour de Blocs FR est disponible : ouvre ce menu puis « Nouveautés »."
			end
			-- barre étroite : le bouton « Wiki » est masqué, le menu du « ? » ouvre le même wiki
			if self.level and self.level.wiki == false then
				return "Aide et wiki de Blocs FR, paramètres, prévisualiseur de hitbox, partage, animations, nouveautés"
			end
			return "Aide, paramètres, prévisualiseur de hitbox, partage d'un script, animations, nouveautés"
		end,
		onClick = function()
			self:_openHelpMenu(false)
		end,
		onRightClick = function()
			self:_openHelpMenu(true)
		end,
	})
	self.buttons.wiki = self:_addButton(right, "Wiki", {
		text = "Wiki",
		visible = function(L)
			return L.wiki
		end,
		tip = "Ouvrir le wiki de Blocs FR : tutoriels, exemples et tous les blocs",
		onClick = function()
			self:_callApp("openWiki")
		end,
	})

	-- Bouton des problèmes : « ✓ » ou « ⚠ n » coloré selon la gravité la plus forte
	local problems = self:_addButton(right, "Problemes", {
		text = "✓",
		bold = true,
		measure = function(L)
			local text = self.buttons.problems and self.buttons.problems.label.Text or "✓"
			return math.max(SQUARE_W + 6, textWidth(text, TEXT_SIZE, FONT_BOLD) + 2 * math.max(8, L.pad - 2))
		end,
		tip = function()
			return self:_problemsTip()
		end,
		onClick = function()
			self:_callApp("toggleProblems")
		end,
		onRightClick = function()
			self:_openProblemsMenu()
		end,
	})
	problems.stroke = Util.stroke(problems.inst, C.PanelBorder, 1, 0)
	problems.stroke.Enabled = false
	self.buttons.problems = problems

	-- Indicateur « ● Non enregistré » (seulement quand le projet est modifié)
	local dirty = makeLabel({
		Name = "NonEnregistre",
		Text = TEXTS.dirty[1],
		Font = FONT_BOLD,
		TextSize = SMALL_SIZE,
		TextColor3 = C.WarningText,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0, 0.5),
		Visible = false,
		Parent = self.frame,
	})
	self.dirtyLabel = dirty
	self:_bindTooltip(dirty, function()
		if self:_workspace() == "interface" then
			return "L'écran ou ses blocs ont des modifications non enregistrées : clique sur « Enregistrer l'écran »."
		end
		return "Le projet a des modifications non enregistrées : clique sur « Enregistrer »."
	end)
	table.insert(right, {
		key = "dirty",
		inst = dirty,
		height = 20,
		measure = function(L)
			if not self.state.dirty then
				return 0
			end
			local text = TEXTS.dirty[2]
			if L.dirtyText then
				text = TEXTS.dirty[1]
			end
			return textWidth(text, SMALL_SIZE, FONT_BOLD) + 4
		end,
		apply = function(L)
			dirty.TextColor3 = C.WarningText
			if L.dirtyText then
				dirty.Text = TEXTS.dirty[1]
			else
				dirty.Text = TEXTS.dirty[2]
			end
		end,
	})
end

-- Puce « Cible  Workspace.Porte » (onglet Interface : « Dans  StarterGui → Menu »), largeur variable,
-- placée à gauche du groupe de droite. Clic : sélectionne la cible dans l'Explorateur ; clic droit : menu.
function TopBar:_buildChip()
	local chip = Util.create("TextButton", {
		Name = "Cible",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(CHIP_MIN, CHIP_H),
		Visible = false,
		Parent = self.frame,
	})
	Util.corner(chip, CORNER)
	Util.stroke(chip, C.PanelBorder, 1)
	self.chip = chip
	self.chipCaption = makeLabel({
		Name = "Libelle",
		Text = "Cible",
		TextSize = SMALL_SIZE,
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(CHIP_PAD, 0),
		Size = UDim2.new(0, textWidth("Cible", SMALL_SIZE, FONT) + 2, 1, 0),
		Parent = chip,
	})
	self.chipPath = makeLabel({
		Name = "Chemin",
		Font = FONT_BOLD,
		TextSize = TEXT_SIZE,
		TextColor3 = C.Text,
		Position = UDim2.fromOffset(self:_chipPathX(), 0),
		Size = UDim2.new(1, -(self:_chipPathX() + CHIP_PAD), 1, 0),
		Parent = chip,
	})
	self:_bindTooltip(chip, function()
		if self:_workspace() == "interface" then
			local text = "Écran : " .. self:_chipText()
			if self.state.screenSaved then
				text = text .. "\nIl est enregistré dans StarterGui ; ses blocs vont dans son script local « BlocsLocal »."
			else
				text = text .. "\nIl sera créé dans StarterGui quand tu cliqueras sur « Enregistrer l'écran »."
			end
			return text .. "\nClic droit : le sélectionner dans l'Explorateur."
		end
		local text = "Cible : " .. self:_path()
		if self.state.hasScript then
			text = text .. "\nCet objet contient déjà un script Blocs FR."
		else
			text = text .. "\nLe script sera créé à l'intérieur de cet objet."
		end
		return text
			.. "\nSélectionne un autre objet dans l'Explorateur pour changer de cible."
			.. "\nClic : la sélectionner dans l'Explorateur · clic droit : plus d'options."
	end)
	table.insert(self.connections, chip.MouseEnter:Connect(function()
		Anim.tween(chip, { BackgroundColor3 = C.ButtonHover }, animTime("Fast", 0.12), "quadOut")
	end))
	table.insert(self.connections, chip.MouseLeave:Connect(function()
		Anim.tween(chip, { BackgroundColor3 = C.Background }, animTime("Fast", 0.12), "quadOut")
	end))
	table.insert(self.connections, chip.MouseButton1Click:Connect(function()
		self:_cancelTooltip()
		self:_callApp("selectInExplorer", "cible")
	end))
	table.insert(self.connections, chip.MouseButton2Click:Connect(function()
		self:_openTargetMenu()
	end))
end

function TopBar:_chipCaption()
	if self:_workspace() == "interface" then
		return "Dans"
	end
	return "Cible"
end

function TopBar:_chipPathX()
	return CHIP_PAD + textWidth(self:_chipCaption(), SMALL_SIZE, FONT) + 7
end

function TopBar:_addSeparator(list, ws)
	local sep = Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(1, SEPARATOR_H),
		Visible = false,
		Parent = self.frame,
	})
	table.insert(list, {
		key = "sep",
		sep = true,
		ws = ws,
		inst = sep,
		height = SEPARATOR_H,
		measure = function()
			return 1
		end,
	})
end

-- opts = { ws = "blocs" | "interface" | nil (les deux), text | pickText(L), style = "primary"?, square, bold,
--          textSize, richText, gapBefore, visible(L)?, measure(L)?, tip = texte | fonction,
--          onClick = function(btn), onRightClick = function(btn)? }
function TopBar:_addButton(list, name, opts)
	local style = opts.style or "normal"
	local bold = style == "primary" or opts.bold == true
	local font = FONT
	if bold then
		font = FONT_BOLD
	end
	local size = opts.textSize or TEXT_SIZE

	-- ancré au centre : l'appui (Anim.press) rétrécit le bouton sur lui-même (voir TopBar:_place)
	local inst = Util.create("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(SQUARE_W, BUTTON_H),
		Visible = false,
		Parent = self.frame,
	})
	Util.corner(inst, CORNER)
	table.insert(self.connections, { Disconnect = Anim.press(inst) })
	local initialText = opts.text
	if opts.pickText then
		local ok, text = pcall(opts.pickText, LEVELS[1])
		if ok then
			initialText = text
		end
	end
	local label = makeLabel({
		Name = "Texte",
		Text = tostring(initialText or ""),
		Font = font,
		TextSize = size,
		RichText = opts.richText == true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = inst,
	})

	local btn = {
		inst = inst,
		label = label,
		style = style,
		enabled = true,
		hovered = false,
		active = false,
		custom = nil, -- couleurs imposées (bouton des problèmes)
		stroke = nil,
	}

	local item = {
		key = name,
		inst = inst,
		ws = opts.ws,
		height = BUTTON_H,
		gapBefore = opts.gapBefore,
		measure = function(L)
			if opts.visible and not opts.visible(L) then
				return 0
			end
			if opts.measure then
				return opts.measure(L)
			end
			if opts.square then
				return SQUARE_W
			end
			local text = opts.text or ""
			if opts.pickText then
				text = opts.pickText(L)
			end
			return math.max(SQUARE_W, textWidth(text, size, font) + 2 * L.pad)
		end,
		apply = function(L)
			if opts.pickText then
				label.Text = opts.pickText(L)
			end
		end,
	}
	table.insert(list, item)

	table.insert(self.connections, inst.MouseEnter:Connect(function()
		btn.hovered = true
		self:_applyLook(btn)
		if opts.tip then
			self:_scheduleTooltip(opts.tip, inst)
		end
	end))
	table.insert(self.connections, inst.MouseLeave:Connect(function()
		btn.hovered = false
		self:_applyLook(btn)
		self:_cancelTooltip()
	end))
	table.insert(self.connections, inst.MouseButton1Click:Connect(function()
		self:_cancelTooltip()
		if not btn.enabled or type(opts.onClick) ~= "function" then
			return
		end
		local ok, err = pcall(opts.onClick, btn)
		if not ok then
			warn("[Blocs FR] Barre d'outils : " .. tostring(err))
			if self.dialogs then
				self.dialogs:toast("Erreur : " .. tostring(err), "error")
			end
		end
	end))
	if type(opts.onRightClick) == "function" then
		table.insert(self.connections, inst.MouseButton2Click:Connect(function()
			self:_cancelTooltip()
			local ok, err = pcall(opts.onRightClick, btn)
			if not ok then
				warn("[Blocs FR] Barre d'outils (clic droit) : " .. tostring(err))
			end
		end))
	end

	self:_applyLook(btn, true)
	return btn
end

-- Contrôle segmenté avec une pastille qui glisse sous le segment actif (onglets, type de script).
-- opts = { ws, visible(L)?, specs = { { value, texts = { long, court }, tip } }, current = fn() -> value,
--          onPick = fn(value), long = fn(L) -> bool, pad = fn(L)?, textSize }
function TopBar:_addSegmented(list, name, opts)
	local textSize = opts.textSize or TEXT_SIZE
	local box = Util.create("Frame", {
		Name = name,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(200, BUTTON_H),
		Visible = false,
		Parent = self.frame,
	})
	Util.corner(box, CORNER + 1)
	-- pastille du segment actif (fond + contour) : elle glisse d'un segment à l'autre ; les segments
	-- sont transparents par-dessus
	local thumb = Util.create("Frame", {
		Name = "Selection",
		BackgroundColor3 = C.ButtonActive,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(SEG_INSET, SEG_INSET),
		Size = UDim2.fromOffset(80, BUTTON_H - 2 * SEG_INSET),
		ZIndex = 1,
		Parent = box,
	})
	Util.corner(thumb, CORNER - 1)
	Util.stroke(thumb, C.ButtonActiveStroke, 1, 0)

	local seg = { box = box, thumb = thumb, entries = {}, opts = opts, key = nil, animate = false, look = nil }
	local segH = BUTTON_H - 2 * SEG_INSET
	for _, spec in ipairs(opts.specs) do
		-- ancré au centre (appui qui rétrécit sur place) ; placé par l'élément (apply)
		local button = Util.create("TextButton", {
			Name = tostring(spec.value),
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.ButtonHover,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(SEG_INSET + 40, SEG_INSET + segH / 2),
			Size = UDim2.fromOffset(80, segH),
			ZIndex = 2,
			Parent = box,
		})
		Util.corner(button, CORNER - 1)
		table.insert(self.connections, { Disconnect = Anim.press(button) })
		local label = makeLabel({
			Text = spec.texts[1],
			TextSize = textSize,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = button,
		})
		local entry = { value = spec.value, inst = button, label = label, texts = spec.texts, hovered = false }
		table.insert(seg.entries, entry)

		table.insert(self.connections, button.MouseEnter:Connect(function()
			entry.hovered = true
			self:_applySegLook(seg)
			self:_scheduleTooltip(spec.tip, button)
		end))
		table.insert(self.connections, button.MouseLeave:Connect(function()
			entry.hovered = false
			self:_applySegLook(seg)
			self:_cancelTooltip()
		end))
		table.insert(self.connections, button.MouseButton1Click:Connect(function()
			self:_cancelTooltip()
			local okCurrent, current = pcall(opts.current)
			if okCurrent and current == spec.value then
				return
			end
			local ok, err = pcall(opts.onPick, spec.value)
			if not ok then
				warn("[Blocs FR] Barre d'outils : " .. tostring(err))
			end
		end))
	end

	local function segText(entry, L)
		if opts.long(L) then
			return entry.texts[1]
		end
		return entry.texts[2]
	end
	local function segPad(L)
		if opts.pad then
			return opts.pad(L)
		end
		return L.segPad or math.max(8, L.pad - 2)
	end
	local function segWidth(entry, L)
		-- mesuré en gras pour que la largeur ne change pas quand le segment devient actif
		return textWidth(segText(entry, L), textSize, FONT_BOLD) + 2 * segPad(L)
	end

	table.insert(list, {
		key = name,
		inst = box,
		ws = opts.ws,
		height = BUTTON_H,
		measure = function(L)
			if opts.visible and not opts.visible(L) then
				return 0
			end
			local total = 2 * SEG_INSET
			for i, entry in ipairs(seg.entries) do
				if i > 1 then
					total += SEG_GAP
				end
				total += segWidth(entry, L)
			end
			return total
		end,
		apply = function(L)
			local x = SEG_INSET
			for _, entry in ipairs(seg.entries) do
				local w = segWidth(entry, L)
				entry.label.Text = segText(entry, L)
				entry.x = x
				entry.w = w
				entry.inst.Position = UDim2.fromOffset(x + w / 2, SEG_INSET + segH / 2)
				entry.inst.Size = UDim2.fromOffset(w, segH)
				x += w + SEG_GAP
			end
			self:_placeSegThumb(seg)
		end,
	})
	self:_applySegLook(seg, true)
	return seg
end

-- Segments : l'actif est montré par la pastille (segment transparent, texte gras) ; un segment inactif
-- survolé prend le fond ButtonHover
function TopBar:_applySegLook(seg, instant)
	if not seg then
		return
	end
	local okCurrent, current = pcall(seg.opts.current)
	if not okCurrent then
		current = nil
	end
	if seg.look ~= nil and seg.look ~= current then
		seg.animate = true -- la valeur vient de changer : la pastille glissera
	end
	seg.look = current
	local duration = animTime("Fast", 0.12)
	if instant == true then
		duration = 0
	end
	local activeText = activeTextColor()
	for _, entry in ipairs(seg.entries) do
		local transparency = 1
		local textColor = C.TextDim
		if entry.value == current then
			entry.label.Font = FONT_BOLD
			textColor = activeText
		else
			entry.label.Font = FONT
			if entry.hovered then
				transparency = 0
				textColor = C.Text
			end
		end
		Anim.tween(entry.inst, { BackgroundTransparency = transparency }, duration, "quadOut")
		Anim.tween(entry.label, { TextColor3 = textColor }, duration, "quadOut")
	end
	self:_placeSegThumb(seg)
end

-- Place la pastille sous le segment actif : elle glisse (0,22 s, quintOut) quand la valeur vient de
-- changer, sinon elle est posée directement (première mise en page, largeur changée)
function TopBar:_placeSegThumb(seg)
	local thumb = seg.thumb
	if not thumb then
		return
	end
	local entry = nil
	for _, e in ipairs(seg.entries) do
		if e.value == seg.look then
			entry = e
		end
	end
	if entry == nil then
		thumb.Visible = false
		return
	end
	if entry.x == nil then
		return
	end
	thumb.Visible = true
	local key = tostring(seg.look) .. "|" .. tostring(entry.x) .. "|" .. tostring(entry.w)
	if key == seg.key then
		return
	end
	local first = seg.key == nil
	seg.key = key
	local props = {
		Position = UDim2.fromOffset(entry.x, SEG_INSET),
		Size = UDim2.fromOffset(entry.w, BUTTON_H - 2 * SEG_INSET),
	}
	if seg.animate and not first then
		Anim.tween(thumb, props, animTime("Normal", 0.22), "quintOut")
	else
		Anim.tween(thumb, props, 0)
	end
	seg.animate = false
end

---------------------------------------------------------------------------
-- État affiché
---------------------------------------------------------------------------

function TopBar:_workspace()
	if self.state.workspace == "interface" then
		return "interface"
	end
	return "blocs"
end

-- Type de script affiché ("server" par défaut)
function TopBar:_currentMode()
	local current = self.state.mode
	if current ~= "local" and current ~= "module" then
		current = "server"
	end
	return current
end

function TopBar:_path()
	local path = tostring(self.state.targetPath or "")
	if path == "" then
		path = "(aucune)"
	end
	return path
end

function TopBar:_chipText()
	if self:_workspace() == "interface" then
		local path = self.state.screenPath
		if type(path) ~= "string" or path == "" then
			path = "pas encore enregistré"
		end
		return path
	end
	return self:_path()
end

-- Nom de l'écran ouvert, raccourci pour le niveau L
function TopBar:_screenShortName(L)
	local name = self.state.screenName
	if type(name) ~= "string" or name == "" then
		name = "aucun"
	end
	return truncateRight(name, (L and L.screenMax) or 200, TEXT_SIZE, FONT)
end

function TopBar:_screenPlain(L)
	return "Écran  " .. self:_screenShortName(L) .. "  ▼"
end

function TopBar:_screenRich(L)
	return "<font color=\""
		.. rgbText(C.TextDim)
		.. "\">Écran</font>  "
		.. escapeRich(self:_screenShortName(L))
		.. "  ▼"
end

---------------------------------------------------------------------------
-- Apparence
---------------------------------------------------------------------------

-- Couleurs d'un bouton : { base, hover, baseT, hoverT, text }
function TopBar:_lookOf(btn)
	if btn.custom then
		return btn.custom
	end
	if btn.style == "primary" then
		return { base = C.Accent, hover = C.AccentHover, baseT = 0, hoverT = 0, text = WHITE }
	end
	if btn.active then
		return { base = C.ButtonActive, hover = C.ButtonActive, baseT = 0, hoverT = 0, text = C.Text }
	end
	return { base = C.Button, hover = C.ButtonHover, baseT = 0, hoverT = 0, text = C.Text }
end

-- Couleurs d'un bouton (normal, survolé, désactivé), en fondu de 0,12 s (instant = true : tout de suite)
function TopBar:_applyLook(btn, instant)
	if not btn or not btn.inst then
		return
	end
	local look = self:_lookOf(btn)
	local color, transparency, textColor
	if btn.enabled then
		if btn.hovered then
			color = look.hover
			transparency = look.hoverT or 0
		else
			color = look.base
			transparency = look.baseT or 0
		end
		textColor = look.text
	else
		-- aspect désactivé : fond estompé, texte gris
		color = C.Button
		transparency = 0.5
		textColor = C.TextDisabled
	end
	local duration = animTime("Fast", 0.12)
	if instant == true then
		duration = 0
	end
	Anim.tween(btn.inst, { BackgroundColor3 = color, BackgroundTransparency = transparency }, duration, "quadOut")
	Anim.tween(btn.label, { TextColor3 = textColor }, duration, "quadOut")
end

function TopBar:_setEnabled(btn, enabled)
	if not btn then
		return
	end
	enabled = enabled == true
	if btn.enabled == enabled then
		return
	end
	btn.enabled = enabled
	self:_applyLook(btn)
end

-- Bouton « enfoncé » (panneau ouvert, aperçu actif) : fond ButtonActive + contour
function TopBar:_setActive(btn, on)
	if not btn then
		return
	end
	on = on == true
	if btn.active == on then
		return
	end
	btn.active = on
	if on and btn.stroke == nil then
		btn.stroke = Util.stroke(btn.inst, C.ButtonActiveStroke, 1, 0)
	end
	if btn.stroke then
		btn.stroke.Color = C.ButtonActiveStroke
		btn.stroke.Enabled = on
	end
	self:_applyLook(btn)
end

-- Nombres de problèmes (erreur, avertissement, conseil) ou nil si l'analyse n'a pas encore eu lieu
function TopBar:_problemCounts()
	local p = self.state.problems
	if type(p) ~= "table" then
		return nil
	end
	local function count(v)
		return math.max(0, math.floor(tonumber(v) or 0))
	end
	return count(p.erreur), count(p.avertissement), count(p.conseil)
end

function TopBar:_applyProblems()
	local btn = self.buttons.problems
	if not btn then
		return
	end
	local e, a, c = self:_problemCounts()
	-- panneau du détecteur ouvert : bouton « enfoncé »
	local open = self.state.problemsVisible == true
	local look = { base = C.Button, hover = C.ButtonHover, baseT = 0, hoverT = 0, text = C.TextDim }
	btn.stroke.Enabled = false
	if open then
		look.base = C.ButtonActive
		btn.stroke.Color = C.ButtonActiveStroke
		btn.stroke.Transparency = 0
		btn.stroke.Enabled = true
	end
	if e == nil then
		btn.label.Text = "✓"
		look.text = C.TextDim
	elseif e + a + c == 0 then
		btn.label.Text = "✓"
		look.text = C.Success
	else
		local worst = "conseil"
		if e > 0 then
			worst = "erreur"
		elseif a > 0 then
			worst = "avertissement"
		end
		local keys = SEVERITY_KEYS[worst]
		local base = C[keys[1]]
		btn.label.Text = "⚠ " .. (e + a + c)
		look.base = base
		look.hover = base
		look.baseT = 0.82
		look.hoverT = 0.7
		if open then
			look.baseT = 0.65
		end
		look.text = C[keys[2]]
		btn.stroke.Color = base
		btn.stroke.Transparency = 0.45
		if open then
			btn.stroke.Transparency = 0
		end
		btn.stroke.Enabled = true
	end
	btn.custom = look
	self:_applyLook(btn)
	-- le nombre de problèmes change : le bouton « saute » (82 % -> 100 % avec rebond)
	local text = btn.label.Text
	if self._problemsText ~= nil and self._problemsText ~= text then
		Anim.popIn(btn.inst, 0.82)
	end
	self._problemsText = text
end

function TopBar:_problemsTip()
	local e, a, c = self:_problemCounts()
	if e == nil then
		return "Détecteur d'erreurs : clique pour l'ouvrir"
	end
	if e + a + c == 0 then
		return "Aucun problème détecté. Clique pour ouvrir le détecteur d'erreurs (clic droit : revérifier)."
	end
	return plural(e, "erreur")
		.. ", "
		.. plural(a, "avertissement")
		.. ", "
		.. plural(c, "conseil")
		.. " — clique pour voir les problèmes (clic droit : plus d'options)."
end

---------------------------------------------------------------------------
-- Mise en page (dépend de la largeur de la barre et de l'onglet affiché)
---------------------------------------------------------------------------

function TopBar:_itemShown(item)
	return item.ws == nil or item.ws == self:_workspace()
end

-- Éléments visibles d'un groupe au niveau L : { { item, w } } (sans séparateur au début, à la fin ou en
-- double : un groupe entièrement masqué n'en laisse pas deux côte à côte)
function TopBar:_collect(list, L)
	local visible = {}
	for _, item in ipairs(list) do
		local w = 0
		if self:_itemShown(item) then
			local ok, measured = pcall(item.measure, L)
			if ok and type(measured) == "number" then
				w = measured
			end
		end
		if w > 0 then
			local last = visible[#visible]
			if not (item.sep and (last == nil or last.item.sep)) then
				table.insert(visible, { item = item, w = w })
			end
		end
	end
	while #visible > 0 and visible[#visible].item.sep do
		table.remove(visible)
	end
	return visible
end

-- x = bord gauche de l'élément ; les boutons sont ancrés au centre (AnchorPoint 0,5 ; 0,5), les
-- autres éléments à gauche (0 ; 0,5)
function TopBar:_place(item, x, w, L)
	item.inst.Visible = true
	item.inst.Position = UDim2.new(0, x + w * item.inst.AnchorPoint.X, 0.5, 0)
	item.inst.Size = UDim2.fromOffset(w, item.height or BUTTON_H)
	if item.apply then
		local ok, err = pcall(item.apply, L, w)
		if not ok then
			warn("[Blocs FR] Barre d'outils (mise en page) : " .. tostring(err))
		end
	end
end

function TopBar:_chipNaturalWidth()
	return self:_chipPathX() + textWidth(self:_chipText(), TEXT_SIZE, FONT_BOLD) + CHIP_PAD + 2
end

function TopBar:_layout()
	if self._destroyed or not self.frame then
		return
	end
	local width = math.floor(self.frame.AbsoluteSize.X)
	if width < 20 then
		return
	end

	-- Premier niveau où tout tient (le dernier sinon)
	local L, leftV, rightV = nil, nil, nil
	for index, level in ipairs(LEVELS) do
		local lv = self:_collect(self.leftItems, level)
		local rv = self:_collect(self.rightItems, level)
		local need = 2 * level.margin + groupWidth(lv, level) + groupWidth(rv, level) + level.middle
		if level.chip then
			need += CHIP_MIN + level.gap + 4
		end
		if need <= width or index == #LEVELS then
			L, leftV, rightV = level, lv, rv
			self.levelIndex = index
			break
		end
	end
	self.level = L

	local shown = {}
	local keys = {}
	-- Groupe de gauche
	local x = L.margin
	for i, entry in ipairs(leftV) do
		if i > 1 then
			x += spacing(leftV[i - 1].item, entry.item, L)
		end
		self:_place(entry.item, x, entry.w, L)
		shown[entry.item] = true
		if not entry.item.sep then
			table.insert(keys, entry.item.key)
		end
		x += entry.w
	end
	local leftEnd = x

	-- Groupe de droite (de droite à gauche)
	local rx = width - L.margin
	for i, entry in ipairs(rightV) do
		if i > 1 then
			rx -= spacing(entry.item, rightV[i - 1].item, L)
		end
		rx -= entry.w
		self:_place(entry.item, rx, entry.w, L)
		shown[entry.item] = true
		table.insert(keys, entry.item.key)
	end
	for _, list in ipairs({ self.leftItems, self.rightItems }) do
		for _, item in ipairs(list) do
			if not shown[item] then
				item.inst.Visible = false
			end
		end
	end

	-- Puce de la cible dans l'espace restant, collée au groupe de droite
	local chipRight = rx
	if #rightV > 0 then
		chipRight -= L.gap + 4
	end
	local available = chipRight - (leftEnd + L.middle)
	if L.chip and available >= CHIP_MIN then
		local caption = self:_chipCaption()
		self.chipCaption.Text = caption
		self.chipCaption.Size = UDim2.new(0, textWidth(caption, SMALL_SIZE, FONT) + 2, 1, 0)
		local w = math.floor(math.min(self:_chipNaturalWidth(), available, CHIP_MAX))
		local pathX = self:_chipPathX()
		self.chip.Visible = true
		self.chip.Position = UDim2.new(0, chipRight - w, 0.5, 0)
		self.chip.Size = UDim2.fromOffset(w, CHIP_H)
		self.chipPath.Position = UDim2.fromOffset(pathX, 0)
		self.chipPath.Size = UDim2.new(1, -(pathX + CHIP_PAD), 1, 0)
		self.chipPath.Text = truncateLeft(self:_chipText(), w - pathX - CHIP_PAD, TEXT_SIZE, FONT_BOLD)
		table.insert(keys, "chip")
	else
		self.chip.Visible = false
	end
	self._visibleKeys = keys
end

---------------------------------------------------------------------------
-- Info-bulles
---------------------------------------------------------------------------

function TopBar:_bindTooltip(inst, tip)
	table.insert(self.connections, inst.MouseEnter:Connect(function()
		self:_scheduleTooltip(tip, inst)
	end))
	table.insert(self.connections, inst.MouseLeave:Connect(function()
		self:_cancelTooltip()
	end))
end

-- tip : texte ou fonction qui renvoie le texte (évaluée au moment de l'affichage)
function TopBar:_scheduleTooltip(tip, inst)
	if not self.dialogs then
		return
	end
	self._hoverToken += 1
	local token = self._hoverToken
	task.delay(TOOLTIP_DELAY, function()
		if self._destroyed or token ~= self._hoverToken or not inst.Parent or not inst.Visible then
			return
		end
		local text = tip
		if type(tip) == "function" then
			local ok, result = pcall(tip)
			text = nil
			if ok then
				text = result
			end
		end
		if type(text) ~= "string" or text == "" then
			return
		end
		if type(self.dialogs.tooltipBelow) == "function" then
			self.dialogs:tooltipBelow(text, inst)
		else
			local pos = inst.AbsolutePosition
			self.dialogs:tooltip(text, Vector2.new(pos.X - 14, pos.Y + inst.AbsoluteSize.Y - 14))
		end
		self._tooltipShown = true
	end)
end

function TopBar:_cancelTooltip()
	self._hoverToken += 1
	if self._tooltipShown then
		self._tooltipShown = false
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
	end
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

-- Appelle app:<method>(...) sans jamais faire planter la barre
function TopBar:_callApp(method, ...)
	local app = self.app
	if not app or type(app[method]) ~= "function" then
		if self.dialogs then
			self.dialogs:toast("Cette fonction n'est pas disponible pour le moment.", "warning")
		end
		return
	end
	local ok, err = pcall(app[method], app, ...)
	if not ok then
		warn("[Blocs FR] Barre d'outils (" .. method .. ") : " .. tostring(err))
		if self.dialogs then
			self.dialogs:toast("Erreur : " .. tostring(err), "error")
		end
	end
end

-- Valeur renvoyée par app:<method>(...) (nil si la méthode manque ou échoue)
function TopBar:_appValue(method, ...)
	local app = self.app
	if not app or type(app[method]) ~= "function" then
		return nil
	end
	local ok, result = pcall(app[method], app, ...)
	if ok then
		return result
	end
	warn("[Blocs FR] Barre d'outils (" .. method .. ") : " .. tostring(result))
	return nil
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

-- state : voir l'en-tête du module (zoom est ignoré : les commandes de zoom sont sur le canvas)
function TopBar:update(state)
	if self._destroyed or type(state) ~= "table" then
		return
	end
	local merged = table.clone(DEFAULT_STATE)
	for key, value in pairs(state) do
		merged[key] = value
	end
	local wasDirty = self.state ~= nil and self.state.dirty == true
	local wasWorkspace = self.state and self.state.workspace
	self.state = merged

	self:_applySegLook(self.segs.tabs)
	self:_applySegLook(self.segs.mode)
	self:_setEnabled(self.buttons.undo, merged.canUndo == true)
	self:_setEnabled(self.buttons.redo, merged.canRedo == true)
	self:_setActive(self.buttons.explain, merged.explainVisible == true)
	self:_setActive(self.buttons.code, merged.codeVisible == true)
	self:_setActive(self.buttons.preview, merged.previewOn == true)
	self:_applyProblems()
	self:_layout()
	-- « ● Non enregistré » apparaît en fondu (pas au changement d'onglet)
	if merged.dirty == true and not wasDirty and wasWorkspace == merged.workspace and self.dirtyLabel and self.dirtyLabel.Visible then
		Anim.fadeIn(self.dirtyLabel, 0.25)
	end
end

function TopBar:getDebugState()
	return {
		level = self.levelIndex,
		workspace = self:_workspace(),
		visible = table.clone(self._visibleKeys or {}),
		updateDot = self._updateDot,
	}
end

---------------------------------------------------------------------------
-- Menus (SPEC §33)
---------------------------------------------------------------------------

-- Point d'ouverture d'un menu sous un bouton (nil = à la souris)
function TopBar:_menuPos(inst)
	if typeof(inst) ~= "Instance" or not inst:IsA("GuiObject") then
		return nil
	end
	local p = inst.AbsolutePosition
	return Vector2.new(p.X, p.Y + inst.AbsoluteSize.Y + MENU_GAP)
end

function TopBar:_menu(pos, items, onChoose)
	if self._destroyed then
		return false
	end
	if not self.dialogs or type(self.dialogs.menu) ~= "function" then
		return false
	end
	self:_cancelTooltip()
	self.dialogs:menu(pos, items, function(value, item)
		if self._destroyed then
			return
		end
		local ok, err = pcall(onChoose, value, item)
		if not ok then
			warn("[Blocs FR] Barre d'outils (menu) : " .. tostring(err))
			if self.dialogs then
				self.dialogs:toast("Erreur : " .. tostring(err), "error")
			end
		end
	end)
	return true
end

-- Version du plugin (host.version, écrite par Main), ou ""
function TopBar:_version()
	local host = (self.app and self.app.host) or self.deps.host
	local version = nil
	if type(host) == "table" then
		version = host.version
	end
	if type(version) ~= "string" and type(version) ~= "number" then
		return ""
	end
	return tostring(version)
end

-- Menu du « ? » (atMouse : ouvert par un clic droit, à la souris)
function TopBar:_openHelpMenu(atMouse)
	if self._destroyed then
		return
	end
	if not self.dialogs or type(self.dialogs.menu) ~= "function" then
		self:_callApp("help")
		return
	end
	local pos = nil
	if not atMouse then
		local btn = self.buttons.help
		pos = self:_menuPos(btn and btn.inst)
	end
	local version = self:_version()
	local about = "À propos de Blocs FR"
	if version ~= "" then
		about = about .. " " .. version
	end
	local newsHint = nil
	if self._updateDot then
		newsHint = "mise à jour !"
	end
	local items = {
		{ label = "Ouvrir le wiki", value = "wiki", icon = "≡" },
		{ label = "Aide sur l'éditeur", value = "aide", icon = "?" },
		"separator",
		{ label = "Paramètres…", value = "parametres", icon = "◎" },
		{ label = "Prévisualiseur de hitbox", value = "hitbox", icon = "◆" },
		{ label = "Partager ce script…", value = "partager", icon = "→" },
		{ label = "Importer un code…", value = "importer", icon = "←" },
		"separator",
		{ label = "Animations de l'éditeur", value = "animations", checked = Anim.enabled() },
		{ label = "Nouveautés", value = "nouveautes", icon = "●", hint = newsHint },
		{ label = about, value = "apropos" },
	}
	self:_menu(pos, items, function(value)
		if value == "wiki" then
			self:_callApp("openWiki")
		elseif value == "aide" then
			self:_callApp("help")
		elseif value == "parametres" then
			self:_callApp("openSettings")
		elseif value == "hitbox" then
			self:_callApp("openHitboxPreview")
		elseif value == "partager" then
			self:_callApp("shareScript")
		elseif value == "importer" then
			self:_callApp("importCode")
		elseif value == "animations" then
			self:_toggleAnimations()
		elseif value == "nouveautes" then
			self:_callApp("openWiki", "nouveautes")
		elseif value == "apropos" then
			self:_showAbout()
		end
	end)
end

-- « Fichier ▼ » (barre très étroite : Nouveau et Ouvrir y sont rangés)
function TopBar:_openFileMenu(anchor)
	local items = {
		{ label = "Nouveau", value = "nouveau", icon = "＋" },
		{ label = "Ouvrir", value = "ouvrir", icon = "◎" },
		"separator",
		{ label = "Partager ce script…", value = "partager", icon = "→" },
		{ label = "Importer un code…", value = "importer", icon = "←" },
	}
	self:_menu(self:_menuPos(anchor), items, function(value)
		if value == "nouveau" then
			self:_callApp("newProject")
		elseif value == "ouvrir" then
			self:_callApp("openFromSelection")
		elseif value == "partager" then
			self:_callApp("shareScript")
		elseif value == "importer" then
			self:_callApp("importCode")
		end
	end)
end

-- Clic droit sur « Enregistrer »
function TopBar:_openSaveMenu(anchor)
	local items = {
		{ label = "Enregistrer", value = "enregistrer", icon = "✓", hint = "dans la cible" },
		{ label = "Voir le code", value = "code" },
		"separator",
		{ label = "Partager ce script…", value = "partager", icon = "→" },
		{ label = "Importer un code…", value = "importer", icon = "←" },
	}
	self:_menu(self:_menuPos(anchor), items, function(value)
		if value == "enregistrer" then
			self:_callApp("save")
		elseif value == "code" then
			self:_callApp("showCode")
		elseif value == "partager" then
			self:_callApp("shareScript")
		elseif value == "importer" then
			self:_callApp("importCode")
		end
	end)
end

-- « Serveur ▼ » (barre très étroite : le type de script devient un menu)
function TopBar:_openModeMenu(anchor)
	local current = self:_currentMode()
	local items = {}
	for _, mode in ipairs(MODE_ORDER) do
		table.insert(items, { label = MODE_LONG[mode], value = mode, checked = current == mode })
	end
	self:_menu(self:_menuPos(anchor), items, function(value)
		if value ~= self:_currentMode() then
			self:_callApp("setMode", value)
		end
	end)
end

-- « Écran ▼ » : écrans de StarterGui, nouvel écran, modèles, renommer, supprimer
function TopBar:_openScreenMenu(anchor)
	local screens = self:_appValue("listScreens")
	if type(screens) ~= "table" then
		screens = {}
	end
	local templates = self:_appValue("listTemplates")
	if type(templates) ~= "table" then
		templates = {}
	end
	local items = {}
	local hasCurrent = false
	for _, screen in ipairs(screens) do
		if type(screen) == "table" and type(screen.name) == "string" then
			local hint = nil
			if screen.saved == false then
				hint = "pas enregistré"
			end
			if screen.current then
				hasCurrent = true
			end
			table.insert(items, {
				label = screen.name,
				value = { kind = "ouvrir", instance = screen.instance, current = screen.current == true },
				checked = screen.current == true,
				hint = hint,
			})
		end
	end
	if #items == 0 then
		table.insert(items, { label = "Aucun écran pour l'instant", value = "rien", disabled = true })
	end
	table.insert(items, "separator")
	table.insert(items, { label = "Nouvel écran", value = { kind = "nouveau" }, icon = "＋" })
	if #templates > 0 then
		local sub = {}
		for _, entry in ipairs(templates) do
			if type(entry) == "table" and entry.id ~= nil then
				table.insert(sub, { label = tostring(entry.title or entry.id), value = { kind = "modele", id = entry.id } })
			end
		end
		table.insert(items, { label = "Nouvel écran depuis un modèle", icon = "◆", submenu = { items = sub } })
	end
	table.insert(items, "separator")
	table.insert(items, { label = "Renommer l'écran…", value = { kind = "renommer" }, disabled = not hasCurrent })
	table.insert(items, {
		label = "Supprimer l'écran…",
		value = { kind = "supprimer" },
		icon = "×",
		danger = true,
		disabled = not hasCurrent,
	})
	self:_menu(self:_menuPos(anchor), items, function(value)
		if type(value) ~= "table" then
			return
		end
		if value.kind == "ouvrir" then
			if not value.current and value.instance ~= nil then
				self:_callApp("openScreen", value.instance)
			end
		elseif value.kind == "nouveau" then
			self:_callApp("newScreen")
		elseif value.kind == "modele" then
			self:_callApp("insertTemplate", value.id)
		elseif value.kind == "renommer" then
			self:_callApp("renameScreen")
		elseif value.kind == "supprimer" then
			self:_callApp("deleteScreen")
		end
	end)
end

-- Clic droit sur la puce de la cible
function TopBar:_openTargetMenu()
	local items
	if self:_workspace() == "interface" then
		items = {
			{
				label = "Sélectionner l'écran dans l'Explorateur",
				value = "cible",
				icon = "◎",
				disabled = self.state.screenSaved ~= true,
			},
			{
				label = "Sélectionner le script de l'écran",
				value = "script",
				disabled = self.state.hasScript ~= true,
			},
		}
	else
		items = {
			{ label = "Sélectionner la cible dans l'Explorateur", value = "cible", icon = "◎" },
			{ label = "Sélectionner le script Blocs FR", value = "script", disabled = self.state.hasScript ~= true },
			"separator",
			{ label = "Ouvrir le script de la sélection", value = "ouvrir" },
			{ label = "Nouveau projet pour la sélection", value = "nouveau", icon = "＋" },
		}
	end
	self:_menu(nil, items, function(value)
		if value == "cible" or value == "script" then
			self:_callApp("selectInExplorer", value)
		elseif value == "ouvrir" then
			self:_callApp("openFromSelection")
		elseif value == "nouveau" then
			self:_callApp("newProject")
		end
	end)
end

-- Clic droit sur le bouton des problèmes
function TopBar:_openProblemsMenu()
	local label = "Ouvrir le détecteur d'erreurs"
	if self.state.problemsVisible == true then
		label = "Fermer le détecteur d'erreurs"
	end
	local items = {
		{ label = label, value = "detecteur", icon = "⚠" },
		{ label = "Revérifier maintenant", value = "reverifier", icon = "✓" },
		"separator",
		{ label = "Effacer les erreurs du dernier test", value = "effacer", icon = "×" },
	}
	self:_menu(nil, items, function(value)
		if value == "detecteur" then
			self:_callApp("toggleProblems")
		elseif value == "reverifier" then
			self:_callApp("recheck")
		elseif value == "effacer" then
			self:_callApp("clearTestErrors")
		end
	end)
end

-- « Animations de l'éditeur » (réglage du plugin, gardé d'une session à l'autre ; aussi dans Paramètres)
function TopBar:_toggleAnimations()
	local on = not Anim.enabled()
	local app = self.app
	if app and type(app.setAnimations) == "function" then
		self:_callApp("setAnimations", on)
	else
		Anim.setEnabled(on)
		local canvas = app and app.canvas
		if on and type(canvas) == "table" and type(canvas.refresh) == "function" then
			pcall(canvas.refresh, canvas)
		end
	end
	if self.dialogs then
		if on then
			self.dialogs:toast("Animations activées.", "success")
		else
			self.dialogs:toast("Animations désactivées : l'éditeur ne bouge plus.", "info")
		end
	end
end

function TopBar:_showAbout()
	if not self.dialogs then
		return
	end
	local version = self:_version()
	local name = "Blocs FR"
	if version ~= "" then
		name = name .. " " .. version
	end
	local lines = {
		name,
		"Des blocs en français pour programmer tes jeux Roblox, comme dans Scratch.",
		"",
		"● Onglet « Blocs » : glisse des blocs de la palette vers la zone de travail, puis clique sur « Enregistrer » : Blocs FR écrit le script Luau pour toi.",
		"● Onglet « Interface » : dessine les écrans de ton jeu (menus, boutons, barres de vie) et mets leurs blocs juste en dessous.",
		"● Clic droit sur un bloc, sur le fond ou dans la palette : copier, sélectionner, désactiver, ouvrir dans le wiki…",
		"● « Expliquer » raconte ce que fait ton script, étape par étape.",
		"● Le menu « ? » ouvre le wiki, les paramètres (thème, couleurs, taille des blocs…), le prévisualiseur de hitbox et les nouveautés.",
	}
	self.dialogs:alert("À propos de Blocs FR", table.concat(lines, "\n"))
end

-- Petit point sur le « ? » : une mise à jour du plugin est disponible (SPEC §25).
-- Le menu du « ? » marque aussi « Nouveautés ».
function TopBar:setUpdateDot(on)
	if self._destroyed then
		return
	end
	on = on == true
	self._updateDot = on
	local btn = self.buttons.help
	if not btn or not btn.inst then
		return
	end
	local dot = self.updateDot
	if dot == nil then
		if not on then
			return
		end
		dot = Util.create("Frame", {
			Name = "PointMiseAJour",
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.fromOffset(9, 9),
			Visible = false,
			ZIndex = 3,
			Parent = btn.inst,
		})
		Util.corner(dot, 5)
		Util.stroke(dot, C.Panel, 2, 0)
		self.updateDot = dot
	end
	local wasVisible = dot.Visible
	dot.Visible = on
	if on and not wasVisible then
		Anim.popIn(dot, 0.3)
	end
end

function TopBar:destroy()
	if self._destroyed then
		return
	end
	self:_cancelTooltip()
	self._destroyed = true
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.frame then
		self.frame:Destroy()
		self.frame = nil
	end
end

return TopBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Util : petites fonctions partagées par tous les modules de Blocs FR

local TextService = game:GetService("TextService")

local Util = {}

---------------------------------------------------------------------------
-- Signal (événement simple)
---------------------------------------------------------------------------
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local entry = { fn = fn, connected = true }
	table.insert(handlers, entry)
	local connection = {}
	function connection.Disconnect()
		if not entry.connected then
			return
		end
		entry.connected = false
		for i, e in ipairs(handlers) do
			if e == entry then
				table.remove(handlers, i)
				break
			end
		end
	end
	connection.disconnect = connection.Disconnect
	return connection
end

-- Appelle chaque abonné dans son propre thread : une erreur dans un abonné n'empêche pas les autres.
function Signal:Fire(...)
	local snapshot = table.clone(self._handlers)
	for _, entry in ipairs(snapshot) do
		if entry.connected then
			task.spawn(entry.fn, ...)
		end
	end
end

function Signal:Destroy()
	for _, entry in ipairs(self._handlers) do
		entry.connected = false
	end
	table.clear(self._handlers)
end

Util.Signal = Signal

---------------------------------------------------------------------------
-- Maid : range des connexions / instances / fonctions à nettoyer
---------------------------------------------------------------------------
local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:give(item)
	table.insert(self._tasks, item)
	return item
end

function Maid:clean()
	local tasks = self._tasks
	self._tasks = {}
	for i = #tasks, 1, -1 do
		local item = tasks[i]
		local kind = typeof(item)
		if kind == "RBXScriptConnection" then
			item:Disconnect()
		elseif kind == "Instance" then
			pcall(function()
				item:Destroy()
			end)
		elseif kind == "function" then
			pcall(item)
		elseif kind == "table" then
			if type(item.Disconnect) == "function" then
				pcall(item.Disconnect, item)
			elseif type(item.destroy) == "function" then
				pcall(item.destroy, item)
			elseif type(item.Destroy) == "function" then
				pcall(item.Destroy, item)
			end
		end
	end
end

Util.Maid = Maid

---------------------------------------------------------------------------
-- Instances
---------------------------------------------------------------------------

-- Util.create("Frame", { Size = ..., Parent = ... }, { childA, childB })
-- La propriété Parent est appliquée en dernier.
function Util.create(className: string, props: { [string]: any }?, children: { Instance }?): Instance
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Ajoute un UICorner
function Util.corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 4)
	c.Parent = parent
	return c
end

-- Ajoute un UIStroke (contour)
function Util.stroke(parent: Instance, color: Color3, thickness: number?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

---------------------------------------------------------------------------
-- Texte
---------------------------------------------------------------------------
local textCache = {}

-- Taille (Vector2) d'un texte sur une ligne. Ne bloque jamais (pas de yield).
function Util.textSize(text: string, size: number, font: Enum.Font): Vector2
	local key = font.Name .. "|" .. size .. "|" .. text
	local cached = textCache[key]
	if cached then
		return cached
	end
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(100000, 100000))
	end)
	if not ok then
		-- estimation de secours
		result = Vector2.new(math.ceil(#text * size * 0.55), size)
	end
	textCache[key] = result
	return result
end

function Util.trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

-- Minuscule + suppression des accents français (pour la recherche)
local foldMap = {
	[0xE0] = "a", [0xE1] = "a", [0xE2] = "a", [0xE3] = "a", [0xE4] = "a", [0xE5] = "a",
	[0xC0] = "a", [0xC1] = "a", [0xC2] = "a", [0xC3] = "a", [0xC4] = "a", [0xC5] = "a",
	[0xE7] = "c", [0xC7] = "c",
	[0xE8] = "e", [0xE9] = "e", [0xEA] = "e", [0xEB] = "e",
	[0xC8] = "e", [0xC9] = "e", [0xCA] = "e", [0xCB] = "e",
	[0xEC] = "i", [0xED] = "i", [0xEE] = "i", [0xEF] = "i",
	[0xCC] = "i", [0xCD] = "i", [0xCE] = "i", [0xCF] = "i",
	[0xF2] = "o", [0xF3] = "o", [0xF4] = "o", [0xF5] = "o", [0xF6] = "o",
	[0xD2] = "o", [0xD3] = "o", [0xD4] = "o", [0xD5] = "o", [0xD6] = "o",
	[0xF9] = "u", [0xFA] = "u", [0xFB] = "u", [0xFC] = "u",
	[0xD9] = "u", [0xDA] = "u", [0xDB] = "u", [0xDC] = "u",
	[0xFF] = "y", [0xFD] = "y", [0xDD] = "y",
	[0xF1] = "n", [0xD1] = "n",
	[0x153] = "oe", [0x152] = "oe", [0xE6] = "ae", [0xC6] = "ae",
	[0x2019] = "'", [0x2018] = "'",
}

function Util.fold(s: string): string
	local ok, result = pcall(function()
		local parts = {}
		for _, cp in utf8.codes(s) do
			local mapped = foldMap[cp]
			if mapped then
				table.insert(parts, mapped)
			elseif cp < 128 then
				table.insert(parts, string.lower(string.char(cp)))
			else
				table.insert(parts, utf8.char(cp))
			end
		end
		return table.concat(parts)
	end)
	if ok then
		return result
	end
	return string.lower(s)
end

---------------------------------------------------------------------------
-- Littéraux Luau (génération de code)
---------------------------------------------------------------------------

-- Nombre -> littéral Luau. Les négatifs sont entre parenthèses pour éviter "--" (commentaire).
function Util.numLiteral(n: any): string
	n = tonumber(n)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local text
	if n == math.floor(n) and math.abs(n) < 1e15 then
		text = string.format("%d", n)
	else
		text = string.format("%.14g", n)
	end
	if string.sub(text, 1, 1) == "-" then
		return "(" .. text .. ")"
	end
	return text
end

-- Chaîne -> littéral Luau entre guillemets doubles, toujours sur une seule ligne.
function Util.strLiteral(s: any): string
	s = tostring(s == nil and "" or s)
	local out = { '"' }
	for i = 1, #s do
		local c = string.sub(s, i, i)
		local b = string.byte(c)
		if c == "\\" then
			table.insert(out, "\\\\")
		elseif c == '"' then
			table.insert(out, '\\"')
		elseif c == "\n" then
			table.insert(out, "\\n")
		elseif c == "\r" then
			table.insert(out, "\\r")
		elseif c == "\t" then
			table.insert(out, "\\t")
		elseif b < 32 or b == 127 then
			table.insert(out, string.format("\\%03d", b))
		else
			table.insert(out, c)
		end
	end
	table.insert(out, '"')
	return table.concat(out)
end

-- "12", "-3.5", "4,2" (virgule française) -> nombre ; sinon nil
function Util.parseNumber(s: any): number?
	if type(s) == "number" then
		return s
	end
	if type(s) ~= "string" then
		return nil
	end
	local t = string.gsub(Util.trim(s), ",", ".")
	if string.match(t, "^[%+%-]?%d+%.?%d*$") or string.match(t, "^[%+%-]?%.%d+$") then
		return tonumber(t)
	end
	return nil
end

-- Vrai si expr est un littéral numérique produit par numLiteral ("12", "3.5", "(-4)")
function Util.isNumberLiteral(expr: string): boolean
	if type(expr) ~= "string" then
		return false
	end
	return string.match(expr, "^%d+%.?%d*$") ~= nil
		or string.match(expr, "^%(%-%d+%.?%d*%)$") ~= nil
		or string.match(expr, "^%d+%.?%d*e[%+%-]?%d+$") ~= nil
		or string.match(expr, "^%(%-%d+%.?%d*e[%+%-]?%d+%)$") ~= nil
end

-- Vrai si expr est un seul littéral chaîne produit par strLiteral
function Util.isStringLiteral(expr: string): boolean
	if type(expr) ~= "string" or #expr < 2 then
		return false
	end
	if string.sub(expr, 1, 1) ~= '"' or string.sub(expr, -1) ~= '"' then
		return false
	end
	local i = 2
	local n = #expr
	while i < n do
		local c = string.sub(expr, i, i)
		if c == "\\" then
			i += 2
		elseif c == '"' then
			return false
		else
			i += 1
		end
	end
	return i == n
end

function Util.isIdentifier(s: string): boolean
	return type(s) == "string" and string.match(s, "^[%a_][%w_]*$") ~= nil
end

---------------------------------------------------------------------------
-- Divers
---------------------------------------------------------------------------
function Util.clamp(x: number, lo: number, hi: number): number
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

function Util.deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[Util.deepCopy(k)] = Util.deepCopy(v)
	end
	return copy
end

function Util.pointInRect(p: Vector2, x: number, y: number, w: number, h: number): boolean
	return p.X >= x and p.X <= x + w and p.Y >= y and p.Y <= y + h
end

-- Vrai si le point écran p est dans le GuiObject (AbsolutePosition/AbsoluteSize)
function Util.pointInGui(p: Vector2, gui: GuiObject): boolean
	if not gui or not gui.Parent then
		return false
	end
	local pos = gui.AbsolutePosition
	local size = gui.AbsoluteSize
	return Util.pointInRect(p, pos.X, pos.Y, size.X, size.Y)
end

-- Couleur {r,g,b} (0-255) -> Color3
function Util.rgbToColor3(rgb: any): Color3
	if type(rgb) ~= "table" then
		return Color3.fromRGB(255, 255, 255)
	end
	local r = math.floor(Util.clamp(tonumber(rgb[1]) or 0, 0, 255) + 0.5)
	local g = math.floor(Util.clamp(tonumber(rgb[2]) or 0, 0, 255) + 0.5)
	local b = math.floor(Util.clamp(tonumber(rgb[3]) or 0, 0, 255) + 0.5)
	return Color3.fromRGB(r, g, b)
end

function Util.color3ToRgb(c: Color3): { number }
	return {
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5),
	}
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">Wiki</string><ProtectedString name="Source"><![CDATA[-- Wiki : le wiki intégré de Blocs FR (SPEC §16), affiché dans sa propre fenêtre ancrable.
--
-- Wiki.new(parentFrame, deps) -> wiki     deps = { host = host, onLoadExample = function(exampleId) end }
-- wiki:open(pageId)        nil = page d'accueil « accueil »
-- wiki:openBlock(defId)    fiche d'un bloc : page de sa catégorie, défilée jusqu'à lui (et mise en
--                          valeur) ; un bloc absent des pages de catégorie (bloc caché) a sa propre
--                          page ; un id inconnu affiche « Bloc introuvable » (jamais d'erreur)
-- wiki:back()              revient à la page précédente (historique)
-- wiki:destroy()
-- wiki.frame               cadre racine du wiki
--
-- Mise en page (planche « Wiki intégré ») : en-tête (logo, « Wiki Blocs FR », retour, recherche),
-- sommaire à gauche (270 px, page active avec une barre bleue de 3 px), contenu défilant à droite
-- (fil d'Ariane, titre 28 px, éléments). Les textes s'enroulent sur la largeur du contenu
-- (TextWrapped + AutomaticSize Y). Les aperçus de blocs (Renderer) sont réduits avec un UIScale
-- quand ils sont plus larges que le contenu, et recalculés quand la fenêtre change de taille.
-- Quand la fenêtre est étroite, le sommaire passe en surimpression (bouton ≡).
--
-- Animations (SPEC §24, module Anim chargé prudemment ; durées × vitesse des réglages ; désactivées :
-- rien ne bouge) : chaque nouvelle page apparaît en fondu (0,15 s, un voile de la couleur du fond
-- s'efface) en montant de 10 px ; les résultats de recherche arrivent en cascade ; défilement doux
-- jusqu'à la fiche d'un bloc, qui s'illumine ; barre bleue du sommaire qui pousse ; bulles d'aide en
-- fondu ; boutons en fondu au survol ; logo qui apparaît puis fait coucou au survol.
--
-- NOTE: les connexions créées sur les éléments d'une page (boutons, survols) disparaissent avec
-- leurs Instances quand la page est effacée ; les connexions permanentes sont dans self.connections.
-- NOTE: aucune position de souris n'est utilisée : les bulles d'aide des exemples sont placées sous
-- le bloc survolé (AbsolutePosition du cadre du bloc).

local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local Logo = require(script.Parent.Logo)

-- Modules chargés prudemment : si l'un d'eux est cassé, le wiki s'affiche quand même.
local function chargerModule(nom)
	local module = script.Parent:FindFirstChild(nom)
	if module == nil then
		return nil, "module " .. nom .. " introuvable"
	end
	local ok, resultat = pcall(require, module)
	if ok then
		return resultat, nil
	end
	return nil, tostring(resultat)
end

local Model, erreurModel = chargerModule("Model")
local Renderer, erreurRenderer = chargerModule("Renderer")
local WikiContent, erreurContenu = chargerModule("WikiContent")
local Examples, erreurExemples = chargerModule("Examples")
local Anim, erreurAnim = chargerModule("Anim") -- sans lui, le wiki marche sans animations

for nom, erreur in pairs({
	Model = erreurModel,
	Renderer = erreurRenderer,
	WikiContent = erreurContenu,
	Examples = erreurExemples,
	Anim = erreurAnim,
}) do
	warn("[Blocs FR] Wiki : impossible de charger " .. nom .. " : " .. tostring(erreur))
end

-- Vrai si les animations peuvent tourner (module chargé et animations activées)
local function animer()
	if type(Anim) ~= "table" then
		return false
	end
	local ok, actif = pcall(Anim.enabled)
	return ok and actif == true
end

-- Appelle Anim.<nom>(...) sans jamais casser le wiki ; renvoie son résultat (ou nil)
local function anim(nom, ...)
	if type(Anim) ~= "table" or type(Anim[nom]) ~= "function" then
		return nil
	end
	local ok, resultat = pcall(Anim[nom], ...)
	if ok then
		return resultat
	end
	return nil
end

local Wiki = {}
Wiki.__index = Wiki

---------------------------------------------------------------------------
-- Constantes
---------------------------------------------------------------------------

-- Couleurs du thème lues à chaque usage (Reglages peut changer le thème)
local C = setmetatable({}, {
	__index = function(_, cle)
		return Theme.Colors[cle]
	end,
})
local FONT = Theme.Fonts.UI
local FONT_BOLD = Theme.Fonts.UIBold
local FONT_CODE = Theme.Fonts.Code
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(0, 0, 0)

local HOME = "accueil"
local HEADER_H = 56
local SIDEBAR_W = 270
local NARROW_W = 700 -- en dessous : sommaire en surimpression
local TITLE_MIN_W = 620 -- en dessous : le titre de l'en-tête est caché
local CONTENT_MAX_W = 860
local CARD_PAD = 16
local EXAMPLE_PAD = 18
local NOTCH_SPACE = 6 -- languette sous les blocs instruction
local MIN_SCALE = 0.35
local MAX_DOTS = 120
local DOT_SPACING = 22
local MAX_HISTORY = 50
local MAX_PAGE_RESULTS = 20
local MAX_BLOCK_RESULTS = 30
local BODY_SIZE = 15
local BACK_W = 100
local SEARCH_DELAY = 0.2
local RESIZE_DELAY = 0.12
local PAGE_TOP = 24 -- marge au-dessus du contenu d'une page
local PAGE_RISE = 10 -- une nouvelle page monte de 10 px en apparaissant
local PAGE_FADE = 0.15
local RESULTS_STEP = 0.05 -- écart entre deux résultats de recherche qui arrivent
local SCROLL_TIME = 0.35 -- défilement jusqu'à la fiche d'un bloc
local LAYOUT_FRAMES = 60 -- images au plus pour attendre la mise en page d'une page

-- Variables de contexte (SPEC §5.5) -> nom affiché dans les blocs « Valeurs »
local CONTEXTE_FR = {
	joueur = "le joueur",
	personnage = "le personnage",
	partieTouchee = "la partie touchée",
	deltaTemps = "temps depuis la dernière image",
	messageChat = "le message du chat",
	dernierObjet = "le dernier objet créé",
	-- « Définir la fonction … » (scripts modules, SPEC §20)
	["paramètres"] = "les paramètres (bloc « paramètre … »)",
	parametres = "les paramètres (bloc « paramètre … »)",
}

-- Couleur des étiquettes « script module » (pastille de la catégorie « Modules », #94A3B8)
local MODULE_TEXT = Color3.fromRGB(148, 163, 184)

local FORMES_FR = {
	hat = "Événement",
	stack = "Instruction",
	c = "Bloc C",
	c2 = "Bloc C à deux parties",
	cap = "Bloc de fin",
	reporter = "Valeur",
	boolean = "Condition (vrai ou faux)",
}

local MAJUSCULES = {
	["é"] = "É",
	["è"] = "È",
	["ê"] = "Ê",
	["ë"] = "Ë",
	["à"] = "À",
	["â"] = "Â",
	["î"] = "Î",
	["ï"] = "Ï",
	["ô"] = "Ô",
	["ù"] = "Ù",
	["û"] = "Û",
	["ü"] = "Ü",
	["ç"] = "Ç",
	["œ"] = "Œ",
}

---------------------------------------------------------------------------
-- Textes
---------------------------------------------------------------------------

local function hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- Échappe un texte pour l'insérer dans du RichText
local function echapper(texte)
	texte = tostring(texte or "")
	texte = string.gsub(texte, "&", "&amp;")
	texte = string.gsub(texte, "<", "&lt;")
	texte = string.gsub(texte, ">", "&gt;")
	texte = string.gsub(texte, "\"", "&quot;")
	texte = string.gsub(texte, "'", "&apos;")
	return texte
end

local GRAS_FERMANT = "</font></b>"
local CODE_FERMANT = "</font>"

-- **gras** et `code` -> RichText ; tout le reste est échappé (couleurs du thème actuel)
local function enrichir(texte)
	local GRAS_OUVRANT = "<b><font color=\"" .. hex(C.Text) .. "\">"
	local CODE_OUVRANT = "<font face=\"RobotoMono\" color=\"" .. hex(C.WarningText) .. "\">"
	texte = tostring(texte or "")
	local morceaux = {}
	local i = 1
	local n = #texte
	local gras = false
	while i <= n do
		local posGras = string.find(texte, "**", i, true)
		local posCode = string.find(texte, "`", i, true)
		local pos, genre = nil, nil
		if posGras and (posCode == nil or posGras < posCode) then
			pos, genre = posGras, "gras"
		elseif posCode then
			pos, genre = posCode, "code"
		end
		if pos == nil then
			table.insert(morceaux, echapper(string.sub(texte, i)))
			break
		end
		table.insert(morceaux, echapper(string.sub(texte, i, pos - 1)))
		if genre == "gras" then
			gras = not gras
			if gras then
				table.insert(morceaux, GRAS_OUVRANT)
			else
				table.insert(morceaux, GRAS_FERMANT)
			end
			i = pos + 2
		else
			local fin = string.find(texte, "`", pos + 1, true)
			if fin == nil then
				table.insert(morceaux, echapper(string.sub(texte, pos)))
				break
			end
			table.insert(morceaux, CODE_OUVRANT .. echapper(string.sub(texte, pos + 1, fin - 1)) .. CODE_FERMANT)
			i = fin + 1
		end
	end
	if gras then
		table.insert(morceaux, GRAS_FERMANT)
	end
	return table.concat(morceaux)
end

-- Texte sans les marques ** et `
local function sansBalises(texte)
	texte = tostring(texte or "")
	texte = string.gsub(texte, "%*%*", "")
	texte = string.gsub(texte, "`", "")
	return texte
end

-- MAJUSCULES, accents français compris
local function majuscules(texte)
	local resultat = string.upper(tostring(texte or ""))
	for minuscule, majuscule in pairs(MAJUSCULES) do
		resultat = string.gsub(resultat, minuscule, majuscule)
	end
	return resultat
end

-- Coupe un texte UTF-8 à n caractères (avec « … »)
local function couper(texte, n)
	texte = tostring(texte or "")
	local longueur = utf8.len(texte)
	if longueur == nil or longueur <= n then
		return texte
	end
	local fin = utf8.offset(texte, n + 1)
	if fin == nil then
		return texte
	end
	return string.sub(texte, 1, fin - 1) .. "…"
end

local function motsDe(requete)
	local mots = {}
	for mot in string.gmatch(Util.fold(requete or ""), "[^%s]+") do
		table.insert(mots, mot)
	end
	return mots
end

-- Hauteur d'un texte enroulé sur une largeur donnée (sans attente)
local function hauteurTexte(texte, taille, police, largeur)
	local ok, resultat = pcall(function()
		return TextService:GetTextSize(texte, taille, police, Vector2.new(math.max(largeur, 10), 10000))
	end)
	if ok then
		return resultat.Y
	end
	return taille * 2
end

---------------------------------------------------------------------------
-- Fabrique d'éléments d'interface
---------------------------------------------------------------------------

local function fusionner(base, props)
	for cle, valeur in pairs(props or {}) do
		base[cle] = valeur
	end
	return base
end

local function etiquette(props)
	return Util.create(
		"TextLabel",
		fusionner({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = FONT,
			TextSize = 14,
			TextColor3 = C.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = "",
		}, props)
	)
end

-- Texte enroulé sur toute la largeur, hauteur automatique
local function texteEnroule(props)
	return etiquette(fusionner({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
	}, props))
end

local function rembourrage(parent, haut, droite, bas, gauche)
	return Util.create("UIPadding", {
		PaddingTop = UDim.new(0, haut),
		PaddingRight = UDim.new(0, droite),
		PaddingBottom = UDim.new(0, bas),
		PaddingLeft = UDim.new(0, gauche),
		Parent = parent,
	})
end

local function liste(parent, ecart, direction)
	return Util.create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, ecart or 0),
		Parent = parent,
	})
end

-- Cadre transparent à hauteur automatique
local function groupe(props)
	return Util.create(
		"Frame",
		fusionner({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, props)
	)
end

-- Carte : fond gris foncé, coins arrondis, contour, contenu empilé
local function carte(props)
	local cadre = Util.create(
		"Frame",
		fusionner({
			BackgroundColor3 = C.PanelAlt,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, props)
	)
	Util.corner(cadre, 10)
	Util.stroke(cadre, C.PanelBorder, 1)
	rembourrage(cadre, CARD_PAD - 2, CARD_PAD, CARD_PAD, CARD_PAD)
	liste(cadre, 10)
	return cadre
end

-- Petite pastille arrondie
local function pastille(texte, couleurTexte, fond)
	local largeur = Util.textSize(texte, 12, FONT_BOLD).X + 20
	local p = etiquette({
		Text = texte,
		Font = FONT_BOLD,
		TextSize = 12,
		TextColor3 = couleurTexte or C.TextSoft,
		BackgroundColor3 = fond or C.ButtonActive,
		BackgroundTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.fromOffset(largeur, 22),
	})
	Util.corner(p, 11)
	return p
end

-- Bouton (principal = bleu)
local function bouton(texte, principal)
	local largeur = Util.textSize(texte, 13, FONT_BOLD).X + 28
	local fond = C.Button
	local fondSurvol = C.ButtonHover
	local couleurTexte = C.Text
	if principal then
		fond = C.Accent
		fondSurvol = C.AccentHover
		couleurTexte = WHITE
	end
	local b = Util.create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = fond,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(largeur, 32),
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = couleurTexte,
		Text = texte,
	})
	Util.corner(b, 8)
	-- survol en fondu (0,12 s) ; sans Anim : changement direct (les connexions disparaissent avec
	-- le bouton)
	if anim("hover", b, fond, fondSurvol) == nil then
		b.MouseEnter:Connect(function()
			b.BackgroundColor3 = fondSurvol
		end)
		b.MouseLeave:Connect(function()
			b.BackgroundColor3 = fond
		end)
	end
	return b
end

local function separateur()
	return Util.create("Frame", {
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
	})
end

-- Grille de points (comme le canvas) dans un cadre, au plus MAX_DOTS points
local function dessinerPoints(conteneur, largeur, hauteur)
	conteneur:ClearAllChildren()
	if largeur < 4 or hauteur < 4 then
		return
	end
	local ecart = DOT_SPACING
	while math.floor(largeur / ecart) * math.floor(hauteur / ecart) > MAX_DOTS do
		ecart += 4
	end
	local colonnes = math.floor(largeur / ecart)
	local lignes = math.floor(hauteur / ecart)
	if colonnes < 1 or lignes < 1 then
		return
	end
	local x0 = math.floor((largeur - (colonnes - 1) * ecart) / 2)
	local y0 = math.floor((hauteur - (lignes - 1) * ecart) / 2)
	for i = 0, colonnes - 1 do
		for j = 0, lignes - 1 do
			Util.create("Frame", {
				BackgroundColor3 = C.GridDot,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(x0 + i * ecart - 1, y0 + j * ecart - 1),
				Size = UDim2.fromOffset(2, 2),
				Parent = conteneur,
			})
		end
	end
end

local function rien() end

-- Contenu de secours si WikiContent n'a pas pu être chargé
local function contenuDeSecours()
	return {
		sections = {
			{
				id = "demarrer",
				title = "Bien démarrer",
				pages = {
					{
						id = HOME,
						title = "Wiki indisponible",
						summary = "Le contenu du wiki n'a pas pu être chargé.",
						body = {
							{ kind = "p", text = "Erreur : " .. tostring(erreurContenu) },
							{ kind = "p", text = "Les fiches des blocs restent disponibles dans **Tous les blocs**." },
						},
					},
				},
			},
			{ id = "blocs", title = "Tous les blocs", generated = "categories", pages = {} },
		},
		categoryIntros = {},
	}
end

---------------------------------------------------------------------------
-- Création
---------------------------------------------------------------------------

function Wiki.new(parentFrame, deps)
	local self = setmetatable({}, Wiki)
	self.parentFrame = parentFrame
	self.deps = deps or {}
	self.host = self.deps.host
	self.connections = {}
	self.views = {} -- vues Renderer de la page affichée
	self.models = {} -- modèles temporaires (exemples) de la page affichée
	self.resizers = {} -- fonctions(largeurColonne) appelées quand la largeur change
	self.anchors = {} -- nom -> GuiObject (pour défiler jusqu'à un exemple ou un bloc)
	self.history = {}
	self.current = nil
	self.renderToken = 0
	self.searchToken = 0
	self.lastSearchText = ""
	self.resizeScheduled = false
	self.order = 0
	self.destroyed = false
	self.narrow = nil
	self.sidebarOpen = true
	self.sidebarItems = {}
	self.flashOrigins = setmetatable({}, { __mode = "k" }) -- [contour] = couleurs d'avant la mise en valeur
	self.anchorScroll = nil -- défilement animé vers une fiche (poignée Anim)

	-- Anim lit le réglage « Animations » (l'éditeur le fait aussi ; ceci sert si le wiki s'ouvre avant)
	if type(Anim) == "table" and type(Anim.isInitialized) == "function" and not Anim.isInitialized() then
		if type(self.host) == "table" then
			pcall(Anim.init, self.host)
		end
	end

	self:_indexContent()
	self:_buildUI()
	self:_layout()
	self:open(nil)
	return self
end

function Wiki:_connect(signal, fn)
	local connexion = signal:Connect(fn)
	table.insert(self.connections, connexion)
	return connexion
end

---------------------------------------------------------------------------
-- Index du contenu (pages, exemples, recherche)
---------------------------------------------------------------------------

function Wiki:_collectTexts(element, sortie)
	if type(element) ~= "table" then
		return
	end
	local genre = element.kind
	if genre == "steps" then
		for _, item in ipairs(element.items or {}) do
			table.insert(sortie, sansBalises(item))
		end
	elseif genre == "example" then
		local ex = self.examplesById[element.id]
		if ex then
			table.insert(sortie, tostring(ex.title or ""))
			table.insert(sortie, tostring(ex.description or ""))
		end
	elseif genre == "block" then
		local def = Registry.get(element.def)
		if def then
			table.insert(sortie, Registry.plainLabel(def))
			table.insert(sortie, tostring(def.tooltip or ""))
		end
	elseif type(element.text) == "string" then
		table.insert(sortie, sansBalises(element.text))
	end
end

function Wiki:_indexContent()
	local contenu = WikiContent
	if type(contenu) ~= "table" or type(contenu.sections) ~= "table" then
		contenu = contenuDeSecours()
	end
	self.categoryIntros = contenu.categoryIntros or {}

	-- Exemples, et blocs utilisés par chacun
	self.examples = {}
	self.examplesById = {}
	self.usage = {}
	if type(Examples) == "table" then
		for _, ex in ipairs(Examples) do
			if type(ex) == "table" and type(ex.id) == "string" and self.examplesById[ex.id] == nil then
				table.insert(self.examples, ex)
				self.examplesById[ex.id] = ex
				local vus = {}
				local blocs = type(ex.data) == "table" and ex.data.blocks
				if type(blocs) == "table" then
					for _, b in pairs(blocs) do
						if type(b) == "table" and type(b.def) == "string" and not vus[b.def] then
							vus[b.def] = true
							self.usage[b.def] = self.usage[b.def] or {}
							table.insert(self.usage[b.def], ex)
						end
					end
				end
			end
		end
	end

	-- Sections et pages
	self.sections = {}
	self.pages = {}
	self.pageOrder = {}
	for _, section in ipairs(contenu.sections) do
		if type(section) == "table" then
			local s = { id = tostring(section.id or ""), title = tostring(section.title or ""), pages = {} }
			if section.generated == "categories" then
				for _, cat in ipairs(Registry.categories()) do
					local defs = {}
					if cat.id == "variables" then
						-- le bloc rond d'une variable n'est pas dans la palette standard : on le montre en premier
						local valeur = Registry.get("var_valeur")
						if valeur then
							table.insert(defs, valeur)
						end
					end
					for _, def in ipairs(Registry.list(cat.id)) do
						table.insert(defs, def)
					end
					table.insert(s.pages, {
						id = "cat_" .. cat.id,
						title = cat.name,
						summary = self.categoryIntros[cat.id] or "",
						category = cat,
						defs = defs,
						body = {},
					})
				end
			else
				for _, page in ipairs(section.pages or {}) do
					if type(page) == "table" and type(page.id) == "string" then
						table.insert(s.pages, {
							id = page.id,
							title = tostring(page.title or page.id),
							summary = page.summary,
							body = type(page.body) == "table" and page.body or {},
						})
					end
				end
			end
			for _, page in ipairs(s.pages) do
				if self.pages[page.id] == nil then
					page.section = s
					self.pages[page.id] = page
					table.insert(self.pageOrder, page)
					page.index = #self.pageOrder
				end
			end
			table.insert(self.sections, s)
		end
	end
	self.home = HOME
	if self.pages[HOME] == nil and self.pageOrder[1] then
		self.home = self.pageOrder[1].id
	end

	-- Textes de recherche (sans accents ni majuscules)
	for _, page in ipairs(self.pageOrder) do
		local textes = {}
		if type(page.summary) == "string" and page.summary ~= "" then
			table.insert(textes, page.summary)
		end
		for _, element in ipairs(page.body) do
			self:_collectTexts(element, textes)
		end
		local plies = {}
		for i, texte in ipairs(textes) do
			plies[i] = Util.fold(texte)
		end
		page.texts = textes
		page.foldTexts = plies
		page.foldTitle = Util.fold(page.title)
		page.foldText = table.concat(plies, " \n ")
	end

	-- Page où chaque exemple est présenté : un tutoriel de préférence, sinon la galerie
	self.exampleHome = {}
	local function noter(page)
		for _, element in ipairs(page.body) do
			if type(element) == "table" and element.kind == "example" and type(element.id) == "string" then
				if self.exampleHome[element.id] == nil then
					self.exampleHome[element.id] = page.id
				end
			end
		end
	end
	for _, page in ipairs(self.pageOrder) do
		if page.section.id == "tutoriels" then
			noter(page)
		end
	end
	if self.pages.galerie then
		noter(self.pages.galerie)
	end
	for _, page in ipairs(self.pageOrder) do
		noter(page)
	end
end

---------------------------------------------------------------------------
-- Interface permanente : en-tête, sommaire, zone de contenu
---------------------------------------------------------------------------

function Wiki:_buildUI()
	local root = Util.create("Frame", {
		Name = "Wiki",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		Parent = self.parentFrame,
	})
	self.root = root
	self.frame = root

	-- En-tête
	local header = Util.create("Frame", {
		Name = "EnTete",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, HEADER_H),
		ZIndex = 3,
		Parent = root,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 2,
		Parent = header,
	})
	self.header = header

	local menu = Util.create("TextButton", {
		Name = "Sommaire",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(32, 32),
		Font = FONT_BOLD,
		TextSize = 17,
		TextColor3 = C.TextSoft,
		Text = "≡",
		ZIndex = 2,
		Parent = header,
	})
	Util.corner(menu, 8)
	self:_connect(menu.MouseEnter, function()
		menu.BackgroundColor3 = C.ButtonHover
	end)
	self:_connect(menu.MouseLeave, function()
		menu.BackgroundColor3 = C.Button
	end)
	self:_connect(menu.Activated, function()
		self.sidebarOpen = not self.sidebarOpen
		self:_layout()
	end)

	local logo = Logo.create(header, 30, 2)
	logo.AnchorPoint = Vector2.new(0, 0.5)
	logo.Position = UDim2.new(0, 54, 0.5, 0)

	local titre = etiquette({
		Name = "Titre",
		Text = "Wiki Blocs FR",
		Font = FONT_BOLD,
		TextSize = 17,
		TextColor3 = C.Text,
		Position = UDim2.fromOffset(94, 10),
		Size = UDim2.fromOffset(Util.textSize("Wiki Blocs FR", 17, FONT_BOLD).X + 4, 20),
		ZIndex = 2,
		Parent = header,
	})
	local sousTitre = etiquette({
		Name = "SousTitre",
		Text = "Guide, tutoriels et exemples",
		TextSize = 11,
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(94, 31),
		Size = UDim2.fromOffset(Util.textSize("Guide, tutoriels et exemples", 11, FONT).X + 4, 14),
		ZIndex = 2,
		Parent = header,
	})
	self.titleLabel = titre
	self.subtitleLabel = sousTitre
	self.titleRight = 94 + math.max(titre.Size.X.Offset, sousTitre.Size.X.Offset)

	-- Zone cliquable logo + titre : retour à l'accueil
	local accueil = Util.create("TextButton", {
		Name = "Accueil",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Position = UDim2.fromOffset(52, 6),
		Size = UDim2.fromOffset(self.titleRight - 52, HEADER_H - 12),
		ZIndex = 5,
		Parent = header,
	})
	self.homeButton = accueil
	self:_connect(accueil.Activated, function()
		self:open(nil)
	end)
	-- le logo apparaît en tournant à l'ouverture du wiki, puis fait coucou quand la souris passe
	-- sur la zone logo + titre (connexion coupée avec la zone)
	pcall(Logo.attachHover, logo, accueil)
	pcall(Logo.pop, logo)

	local retour = Util.create("TextButton", {
		Name = "Retour",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, self.titleRight + 18, 0.5, 0),
		Size = UDim2.fromOffset(BACK_W, 32),
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = C.TextDisabled,
		Text = "←  Retour",
		ZIndex = 2,
		Parent = header,
	})
	Util.corner(retour, 8)
	self.backButton = retour
	self:_connect(retour.MouseEnter, function()
		if #self.history > 0 then
			retour.BackgroundColor3 = C.ButtonHover
		end
	end)
	self:_connect(retour.MouseLeave, function()
		retour.BackgroundColor3 = C.Button
	end)
	self:_connect(retour.Activated, function()
		self:back()
	end)

	-- Recherche
	local recherche = Util.create("Frame", {
		Name = "Recherche",
		BackgroundColor3 = C.SearchBg,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(360, 36),
		ZIndex = 2,
		Parent = header,
	})
	Util.corner(recherche, 8)
	local contourRecherche = Util.stroke(recherche, C.SearchStroke, 1)
	etiquette({
		Text = "🔍",
		TextSize = 14,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(0, 34, 1, 0),
		Parent = recherche,
	})
	local champ = Util.create("TextBox", {
		Name = "Champ",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -66, 1, 0),
		Font = FONT,
		TextSize = 13,
		TextColor3 = C.Text,
		PlaceholderText = "Rechercher : porte, pièces, variable, touche…",
		PlaceholderColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		ClipsDescendants = true,
		Parent = recherche,
	})
	local effacer = Util.create("TextButton", {
		Name = "Effacer",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = C.TextDim,
		Text = "×",
		Visible = false,
		Parent = recherche,
	})
	self.searchFrame = recherche
	self.searchBox = champ
	self.clearButton = effacer
	self:_connect(champ.Focused, function()
		contourRecherche.Color = C.Accent
	end)
	self:_connect(champ.FocusLost, function(entree)
		contourRecherche.Color = C.SearchStroke
		if entree then
			-- Entrée : recherche immédiate (sans attendre le délai de frappe)
			self.searchToken += 1
			local texte = champ.Text
			task.defer(function()
				if not self.destroyed then
					self:_applySearch(texte)
				end
			end)
		end
	end)
	self:_connect(champ:GetPropertyChangedSignal("Text"), function()
		local texte = champ.Text
		effacer.Visible = texte ~= ""
		if texte == self.lastSearchText then
			return -- texte changé par le wiki lui-même
		end
		self.lastSearchText = texte
		self.searchToken += 1
		local jeton = self.searchToken
		task.delay(SEARCH_DELAY, function()
			if self.destroyed or jeton ~= self.searchToken then
				return
			end
			self:_applySearch(champ.Text)
		end)
	end)
	self:_connect(effacer.MouseEnter, function()
		effacer.TextColor3 = C.Text
	end)
	self:_connect(effacer.MouseLeave, function()
		effacer.TextColor3 = C.TextDim
	end)
	self:_connect(effacer.Activated, function()
		self.searchToken += 1
		self:_setSearchText("")
		self:_applySearch("")
	end)

	-- Corps : sommaire + contenu
	local corps = Util.create("Frame", {
		Name = "Corps",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 1, -HEADER_H),
		ZIndex = 1,
		Parent = root,
	})
	self.body = corps

	local contenu = Util.create("ScrollingFrame", {
		Name = "Contenu",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(SIDEBAR_W, 0),
		Size = UDim2.new(1, -SIDEBAR_W, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.ButtonActiveStroke,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		ZIndex = 1,
		Parent = corps,
	})
	self.content = contenu
	local colonne = Util.create("Frame", {
		Name = "Colonne",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -64, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = contenu,
	})
	Util.create("UISizeConstraint", { MaxSize = Vector2.new(CONTENT_MAX_W, math.huge), Parent = colonne })
	liste(colonne, 14)
	self.columnPadding = rembourrage(colonne, PAGE_TOP, 0, 56, 0)
	self.column = colonne

	-- Voile de la couleur du fond posé sur le contenu puis effacé : chaque page apparaît en fondu
	-- (un seul cadre animé, quelle que soit la taille de la page). Il ne capte pas les clics.
	self.pageVeil = Util.create("Frame", {
		Name = "VoilePage",
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = contenu.Position,
		Size = contenu.Size,
		ZIndex = 2,
		Parent = corps,
	})

	local voile = Util.create("TextButton", {
		Name = "Voile",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 4,
		Parent = corps,
	})
	self.shade = voile
	self:_connect(voile.Activated, function()
		self.sidebarOpen = false
		self:_layout()
	end)

	self:_buildSidebar(corps)

	-- Bulle d'aide (au-dessus de tout, ne capte pas les clics)
	local calque = Util.create("Frame", {
		Name = "Calque",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = root,
	})
	local bulle = Util.create("Frame", {
		Name = "Bulle",
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = calque,
	})
	Util.corner(bulle, 8)
	Util.stroke(bulle, C.PopupBorder, 1)
	rembourrage(bulle, 10, 12, 10, 12)
	liste(bulle, 4)
	self.tooltip = bulle
	self.tooltipTitle = texteEnroule({ Font = FONT_BOLD, TextSize = 13, TextColor3 = C.Text, LayoutOrder = 1, Parent = bulle })
	self.tooltipText = texteEnroule({ TextSize = 12, TextColor3 = C.TextSoft, LayoutOrder = 2, Parent = bulle })
	texteEnroule({
		Text = "Clique sur le bloc pour ouvrir sa fiche.",
		TextSize = 11,
		TextColor3 = C.TextDim,
		LayoutOrder = 3,
		Parent = bulle,
	})

	-- Réactions aux changements de taille et au défilement
	self:_connect(root:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_layout()
	end)
	self:_connect(colonne:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_scheduleResize()
	end)
	self:_connect(contenu:GetPropertyChangedSignal("CanvasPosition"), function()
		self:_hideTooltip()
	end)
end

function Wiki:_buildSidebar(parent)
	local cadre = Util.create("Frame", {
		Name = "Sommaire",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(0, SIDEBAR_W, 1, 0),
		ZIndex = 5,
		Parent = parent,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -1, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 2,
		Parent = cadre,
	})
	local defilant = Util.create("ScrollingFrame", {
		Name = "Liste",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -1, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ButtonActiveStroke,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = cadre,
	})
	liste(defilant, 2)
	rembourrage(defilant, 6, 10, 20, 10)
	self.sidebar = cadre
	self.sidebarList = defilant

	local ordre = 0
	for _, section in ipairs(self.sections) do
		ordre += 1
		local titre = etiquette({
			Name = "Section_" .. section.id,
			Text = majuscules(section.title),
			Font = FONT_BOLD,
			TextSize = 11,
			TextColor3 = C.TextDim,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = ordre,
			Parent = defilant,
		})
		rembourrage(titre, 0, 8, 7, 14)
		for _, page in ipairs(section.pages) do
			if self.pages[page.id] == page then
				ordre += 1
				local item = self:_sidebarItem(page)
				item.bouton.LayoutOrder = ordre
				item.bouton.Parent = defilant
			end
		end
	end
end

function Wiki:_sidebarItem(page)
	local b = Util.create("TextButton", {
		Name = page.id,
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.ButtonActive,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 30),
	})
	Util.corner(b, 6)
	-- barre bleue de la page active (ancrée au milieu : elle pousse depuis le centre)
	local barre = Util.create("Frame", {
		Name = "Barre",
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 3, 1, -12),
		Visible = false,
		Parent = b,
	})
	Util.corner(barre, 2)
	local x = 14
	local droite = 8
	if page.category then
		local point = Util.create("Frame", {
			BackgroundColor3 = page.category.dot or page.category.color,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 14, 0.5, -4),
			Size = UDim2.fromOffset(8, 8),
			Parent = b,
		})
		Util.corner(point, 4)
		x = 30
		local compteur = pastille(tostring(#page.defs), C.TextDim, C.Button)
		local largeur = compteur.Size.X.Offset - 6
		compteur.Size = UDim2.fromOffset(largeur, 18)
		compteur.TextSize = 11
		compteur.AnchorPoint = Vector2.new(1, 0.5)
		compteur.Position = UDim2.new(1, -8, 0.5, 0)
		compteur.Parent = b
		droite = largeur + 16
	end
	local texte = etiquette({
		Text = page.title,
		TextSize = 13,
		TextColor3 = C.TextSoft,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -(x + droite), 1, 0),
		Parent = b,
	})
	local item = { bouton = b, barre = barre, texte = texte, actif = false }
	self.sidebarItems[page.id] = item
	self:_connect(b.MouseEnter, function()
		if not item.actif then
			b.BackgroundColor3 = C.ButtonHover
			b.BackgroundTransparency = 0
		end
	end)
	self:_connect(b.MouseLeave, function()
		if not item.actif then
			b.BackgroundTransparency = 1
		end
	end)
	self:_connect(b.Activated, function()
		self:_go(page.id, nil, false)
	end)
	return item
end

-- Disposition selon la largeur de la fenêtre
function Wiki:_layout()
	if self.destroyed then
		return
	end
	local largeur = self.root.AbsoluteSize.X
	if largeur <= 0 then
		return
	end
	local etroit = largeur < NARROW_W
	if etroit ~= self.narrow then
		self.narrow = etroit
		self.sidebarOpen = not etroit
	end
	local ancre = self.sidebarOpen and not etroit
	self.sidebar.Visible = self.sidebarOpen
	self.shade.Visible = self.sidebarOpen and etroit
	if ancre then
		self.content.Position = UDim2.fromOffset(SIDEBAR_W, 0)
		self.content.Size = UDim2.new(1, -SIDEBAR_W, 1, 0)
	else
		self.content.Position = UDim2.fromOffset(0, 0)
		self.content.Size = UDim2.fromScale(1, 1)
	end
	if self.pageVeil then
		self.pageVeil.Position = self.content.Position
		self.pageVeil.Size = self.content.Size
	end
	local marge = 32
	if largeur < 520 then
		marge = 16
	end
	self.column.Position = UDim2.fromOffset(marge, 0)
	self.column.Size = UDim2.new(1, -2 * marge, 0, 0)

	-- En-tête : titre caché si la place manque, recherche qui prend le reste
	local avecTitre = largeur >= TITLE_MIN_W
	self.titleLabel.Visible = avecTitre
	self.subtitleLabel.Visible = avecTitre
	self.homeButton.Visible = avecTitre
	local xRetour = 94
	if avecTitre then
		xRetour = self.titleRight + 18
	end
	-- Fenêtre très étroite (wiki ancré dans une colonne) : bouton retour réduit à sa flèche,
	-- sinon la recherche (largeur minimale) recouvre le bouton « Retour »
	local largeurRetour = BACK_W
	local texteRetour = "←  Retour"
	local rechercheMin = 140
	if largeur < xRetour + BACK_W + 32 + 140 then
		largeurRetour = 36
		texteRetour = "←"
		rechercheMin = 90
	end
	self.backButton.Text = texteRetour
	self.backButton.Size = UDim2.fromOffset(largeurRetour, 32)
	self.backButton.Position = UDim2.new(0, xRetour, 0.5, 0)
	local largeurRecherche = Util.clamp(largeur - (xRetour + largeurRetour + 32), rechercheMin, 380)
	self.searchFrame.Size = UDim2.fromOffset(largeurRecherche, 36)
	self:_hideTooltip()
end

-- Met à jour le sommaire (page active) et le bouton retour
function Wiki:_updateChrome()
	local actif = nil
	if self.current and self.current.query == nil then
		actif = self.current.page
		-- page d'un bloc seul : sa catégorie reste marquée dans le sommaire
		if actif == nil and type(self.current.block) == "string" then
			local def = Registry.get(self.current.block)
			if def then
				actif = "cat_" .. tostring(def.category)
			end
		end
	end
	for id, item in pairs(self.sidebarItems) do
		local estActif = id == actif
		local etaitActif = item.actif == true
		item.actif = estActif
		item.bouton.BackgroundColor3 = C.ButtonActive
		item.bouton.BackgroundTransparency = estActif and 0 or 1
		item.barre.Visible = estActif
		item.texte.TextColor3 = estActif and C.Text or C.TextSoft
		item.texte.Font = estActif and FONT_BOLD or FONT
		if estActif and not etaitActif and animer() then
			-- la barre bleue pousse (0,22 s)
			item.barre.Size = UDim2.new(0, 3, 0, 0)
			anim("tween", item.barre, { Size = UDim2.new(0, 3, 1, -12) }, 0.22, "quintOut")
		end
	end
	local peutRevenir = #self.history > 0
	self.backButton.TextColor3 = peutRevenir and C.Text or C.TextDisabled
	if not peutRevenir then
		self.backButton.BackgroundColor3 = C.Button
	end
end

---------------------------------------------------------------------------
-- Navigation
---------------------------------------------------------------------------

-- Ouvre une page (nil = accueil)
function Wiki:open(pageId)
	if self.destroyed then
		return
	end
	local id = pageId
	if id == nil or self.pages[id] == nil then
		id = self.home
	end
	self:_go(id, nil, false)
end

-- Vrai si la page de catégorie montre ce bloc (les blocs cachés n'y sont pas, sauf var_valeur)
local function pageMontreBloc(page, defId)
	for _, def in ipairs(page.defs or {}) do
		if def.id == defId then
			return true
		end
	end
	return false
end

-- Ouvre la fiche d'un bloc : page de sa catégorie, défilée jusqu'au bloc et mise en valeur. Un bloc
-- absent des pages de catégorie a sa propre page ; un id inconnu affiche « Bloc introuvable ».
function Wiki:openBlock(defId)
	if self.destroyed then
		return
	end
	if defId == nil then
		self:open(nil)
		return
	end
	local def = nil
	pcall(function()
		def = Registry.get(defId)
	end)
	if type(def) == "table" then
		local pageId = "cat_" .. tostring(def.category)
		local page = self.pages[pageId]
		if page ~= nil and pageMontreBloc(page, def.id) then
			self:_go(pageId, "bloc_" .. def.id, true)
			return
		end
	end
	self:_goBlock(tostring(defId))
end

-- Va à la page d'un seul bloc (avec historique)
function Wiki:_goBlock(defId)
	if self.destroyed then
		return
	end
	self.searchToken += 1
	self:_setSearchText("")
	if self.narrow and self.sidebarOpen then
		self.sidebarOpen = false
		self:_layout()
	end
	if self.current ~= nil and self.current.query == nil and self.current.block == defId then
		self:_scrollTop()
		return
	end
	self:_navigate({ block = defId }, true)
end

-- Remonte en haut de la page affichée (en douceur)
function Wiki:_scrollTop()
	self:_stopAnchorScroll()
	if animer() then
		self.anchorScroll = anim("tween", self.content, { CanvasPosition = Vector2.new(0, 0) }, 0.25, "quintOut")
	end
	if self.anchorScroll == nil then
		self.content.CanvasPosition = Vector2.new(0, 0)
	end
end

-- Arrête un défilement animé en cours (nouvelle page, autre fiche…)
function Wiki:_stopAnchorScroll()
	local handle = self.anchorScroll
	self.anchorScroll = nil
	if type(handle) == "table" and type(handle.cancel) == "function" then
		pcall(handle.cancel, handle)
	end
end

-- Revient à la page précédente
function Wiki:back()
	if self.destroyed then
		return
	end
	local precedent = table.remove(self.history)
	if precedent == nil then
		return
	end
	self.searchToken += 1
	self:_setSearchText(precedent.query or "")
	self.current = precedent
	self:_render(precedent)
	self:_updateChrome()
end

-- Va à une page (avec historique) ; anchor = nom d'ancre facultatif, flash = mise en valeur
function Wiki:_go(pageId, anchor, flash)
	if self.destroyed or pageId == nil or self.pages[pageId] == nil then
		return
	end
	self.searchToken += 1
	self:_setSearchText("")
	if self.narrow and self.sidebarOpen then
		self.sidebarOpen = false
		self:_layout()
	end
	local memePage = self.current ~= nil and self.current.query == nil and self.current.page == pageId
	if memePage and anchor == nil then
		self:_scrollTop()
		return
	end
	-- même page déjà affichée : on défile jusqu'à la fiche sans redessiner toute la page
	local cible = anchor and self.anchors[anchor]
	if memePage and cible ~= nil and cible.Parent ~= nil then
		self.current.anchor = anchor
		self.current.flash = flash
		self:_scrollToAnchor(anchor, flash)
		return
	end
	self:_navigate({ page = pageId, anchor = anchor, flash = flash }, not memePage)
end

function Wiki:_navigate(etat, empiler)
	-- recherche affinée (une recherche remplace une autre) : pas de fondu de toute la page
	local leger = etat.query ~= nil and self.current ~= nil and self.current.query ~= nil
	if empiler and self.current then
		table.insert(self.history, {
			page = self.current.page,
			query = self.current.query,
			block = self.current.block,
			scroll = self.content.CanvasPosition,
		})
		while #self.history > MAX_HISTORY do
			table.remove(self.history, 1)
		end
	end
	self.current = etat
	self:_render(etat, leger)
	self:_updateChrome()
end

function Wiki:_setSearchText(texte)
	texte = texte or ""
	self.lastSearchText = texte
	if self.searchBox.Text ~= texte then
		self.searchBox.Text = texte
	end
	self.clearButton.Visible = texte ~= ""
end

-- Applique la recherche tapée : page de résultats, ou retour à la page d'avant si vide
function Wiki:_applySearch(texte)
	if self.destroyed then
		return
	end
	local requete = Util.trim(texte or "")
	if requete == "" then
		if self.current and self.current.query then
			if #self.history > 0 then
				self:back()
			else
				self:_navigate({ page = self.home }, false)
			end
		end
		return
	end
	if self.current and self.current.query == requete then
		return
	end
	local dejaEnRecherche = self.current ~= nil and self.current.query ~= nil
	self:_navigate({ query = requete }, not dejaEnRecherche)
end

---------------------------------------------------------------------------
-- Rendu d'une page
---------------------------------------------------------------------------

function Wiki:_clearPage()
	for _, vue in ipairs(self.views) do
		if type(vue) == "table" and type(vue.destroy) == "function" then
			pcall(vue.destroy, vue)
		end
	end
	for _, modele in ipairs(self.models) do
		if type(modele) == "table" and type(modele.destroy) == "function" then
			pcall(modele.destroy, modele)
		end
	end
	self.views = {}
	self.models = {}
	self.resizers = {}
	self.anchors = {}
	if self.column then
		for _, enfant in ipairs(self.column:GetChildren()) do
			if enfant:IsA("GuiObject") then
				enfant:Destroy()
			end
		end
	end
end

-- Ajoute un élément à la colonne de contenu, dans l'ordre
function Wiki:_add(gui)
	if gui == nil then
		return nil
	end
	self.order += 1
	gui.LayoutOrder = self.order
	gui.Parent = self.column
	return gui
end

-- Dessine l'état demandé (page, recherche ou bloc seul). leger = true : pas de fondu de toute la page
-- (recherche affinée pendant la frappe), seuls les résultats arrivent en cascade.
function Wiki:_render(etat, leger)
	self.renderToken += 1
	self:_stopAnchorScroll()
	self:_hideTooltip()
	self:_clearPage()
	self.order = 0
	self.staggerItems = nil
	local ok, erreur = pcall(function()
		if etat.query then
			self:_renderSearch(etat.query)
		elseif etat.block then
			self:_renderBlockPage(etat.block)
		else
			local page = self.pages[etat.page] or self.pages[self.home]
			if page == nil then
				self:_pageHeader("Wiki", "Aucune page", "Le wiki ne contient aucune page.", nil)
				return
			end
			if page.category then
				self:_renderCategory(page)
			else
				self:_renderPage(page)
			end
			self:_renderFooter(page)
		end
	end)
	if not ok then
		self:_add(self:_elEncadre("Cette page n'a pas pu être affichée entièrement : " .. tostring(erreur), "warn"))
	end
	self:_runResizers()
	self.content.CanvasPosition = Vector2.new(0, 0)
	if leger ~= true then
		self:_animatePage()
	end
	local cascade = self.staggerItems
	self.staggerItems = nil
	if cascade ~= nil and #cascade > 0 then
		anim("stagger", cascade, RESULTS_STEP, 0)
	end
	if etat.anchor then
		self:_scrollToAnchor(etat.anchor, etat.flash)
	elseif etat.scroll then
		self:_restoreScroll(etat.scroll)
	end
end

-- Nouvelle page : un voile de la couleur du fond s'efface (fondu de 0,15 s) et le contenu monte de
-- 10 px. Animations désactivées (ou en panne) : la page est là tout de suite.
function Wiki:_animatePage()
	local voile = self.pageVeil
	local marge = self.columnPadding
	if voile == nil then
		return
	end
	if not animer() then
		voile.BackgroundTransparency = 1
		if marge then
			marge.PaddingTop = UDim.new(0, PAGE_TOP)
		end
		return
	end
	voile.BackgroundColor3 = C.Background
	voile.BackgroundTransparency = 0
	if anim("tween", voile, { BackgroundTransparency = 1 }, PAGE_FADE, "quadOut") == nil then
		voile.BackgroundTransparency = 1
	end
	if marge then
		marge.PaddingTop = UDim.new(0, PAGE_TOP + PAGE_RISE)
		if anim("tween", marge, { PaddingTop = UDim.new(0, PAGE_TOP) }, 0.22, "quintOut") == nil then
			marge.PaddingTop = UDim.new(0, PAGE_TOP)
		end
	end
end

-- Page d'un seul bloc : bloc absent des pages de catégorie (bloc caché), ou id inconnu
function Wiki:_renderBlockPage(defId)
	local def = nil
	pcall(function()
		def = Registry.get(defId)
	end)
	-- titre de la section « Tous les blocs » (celle des pages de catégorie)
	local section = "Tous les blocs"
	for _, page in ipairs(self.pageOrder) do
		if page.category ~= nil then
			section = page.section.title
			break
		end
	end
	if type(def) ~= "table" then
		self:_pageHeader(section, "Bloc introuvable", nil, nil)
		self:_add(self:_elEncadre(
			"Le bloc `"
				.. tostring(defId)
				.. "` n'existe pas (ou plus) dans cette version de Blocs FR. Cherche un bloc qui fait la même chose avec la recherche en haut, ou dans **"
				.. section
				.. "**.",
			"warn"
		))
		return
	end
	local cat = Registry.category(def.category)
	local nomCat = tostring(def.category)
	local couleur = nil
	if cat then
		nomCat = cat.name
		couleur = cat.color
	end
	local titre = Registry.plainLabel(def)
	if def.id == "var_valeur" then
		titre = "valeur d'une variable"
	end
	self:_pageHeader(section .. "  →  " .. nomCat, titre, nil, couleur)
	self:_add(self:_blockCard(def, { anchor = "bloc_" .. def.id, usages = true, category = true }))
	local pageCat = self.pages["cat_" .. tostring(def.category)]
	if pageCat then
		self:_add(self:_elLien({ page = pageCat.id, text = "Voir tous les blocs « " .. nomCat .. " »" }))
	end
end

function Wiki:_pageHeader(chemin, titre, resume, couleur)
	self:_add(texteEnroule({ Text = chemin, TextSize = 12, TextColor3 = C.TextDim }))
	self:_add(texteEnroule({ Text = titre, Font = FONT_BOLD, TextSize = 28, TextColor3 = C.Text }))
	if couleur then
		local barre = Util.create("Frame", {
			BackgroundColor3 = couleur,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(56, 4),
		})
		Util.corner(barre, 2)
		self:_add(barre)
	end
	if type(resume) == "string" and resume ~= "" then
		self:_add(texteEnroule({ Text = resume, TextSize = 16, TextColor3 = C.TextSoft, LineHeight = 1.15 }))
	end
	self:_add(separateur())
end

function Wiki:_renderPage(page)
	self:_pageHeader(page.section.title .. "  →  " .. page.title, page.title, page.summary, nil)
	for _, element in ipairs(page.body) do
		local ok, resultat = pcall(function()
			return self:_renderElement(element)
		end)
		if ok then
			self:_add(resultat)
		else
			self:_add(self:_elEncadre("Élément illisible : " .. tostring(resultat), "warn"))
		end
	end
end

function Wiki:_renderCategory(page)
	local cat = page.category
	self:_pageHeader(page.section.title .. "  →  " .. page.title, page.title, page.summary, cat.color)
	local n = #page.defs
	local resume = n .. " bloc"
	if n > 1 then
		resume = resume .. "s"
	end
	resume = resume .. " dans cette catégorie. Clique sur un exemple pour voir le bloc en action."
	self:_add(texteEnroule({ Text = resume, TextSize = 13, TextColor3 = C.TextDim }))
	for _, def in ipairs(page.defs) do
		local ok, resultat = pcall(function()
			return self:_blockCard(def, { anchor = "bloc_" .. def.id, usages = true })
		end)
		if ok then
			self:_add(resultat)
		else
			self:_add(self:_elEncadre("Bloc « " .. tostring(def.id) .. " » illisible : " .. tostring(resultat), "warn"))
		end
	end
end

function Wiki:_renderFooter(page)
	local precedente = self.pageOrder[(page.index or 0) - 1]
	local suivante = self.pageOrder[(page.index or 0) + 1]
	if precedente == nil and suivante == nil then
		return
	end
	self:_add(separateur())
	local ligne = Util.create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 62),
	})
	if precedente then
		local b = self:_navButton(precedente, false)
		b.Position = UDim2.fromOffset(0, 0)
		b.Size = UDim2.new(0.5, -6, 1, 0)
		b.Parent = ligne
	end
	if suivante then
		local b = self:_navButton(suivante, true)
		b.Position = UDim2.new(0.5, 6, 0, 0)
		b.Size = UDim2.new(0.5, -6, 1, 0)
		b.Parent = ligne
	end
	self:_add(ligne)
end

function Wiki:_navButton(page, suivant)
	local b = Util.create("TextButton", {
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
	})
	Util.corner(b, 10)
	Util.stroke(b, C.PanelBorder, 1)
	local alignement = Enum.TextXAlignment.Left
	local indication = "←  Précédent"
	if suivant then
		alignement = Enum.TextXAlignment.Right
		indication = "Suivant  →"
	end
	etiquette({
		Text = indication,
		TextSize = 12,
		TextColor3 = C.TextDim,
		TextXAlignment = alignement,
		Position = UDim2.fromOffset(14, 11),
		Size = UDim2.new(1, -28, 0, 16),
		Parent = b,
	})
	etiquette({
		Text = page.title,
		Font = FONT_BOLD,
		TextSize = 14,
		TextColor3 = C.Text,
		TextXAlignment = alignement,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(14, 31),
		Size = UDim2.new(1, -28, 0, 20),
		Parent = b,
	})
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = C.ButtonHover
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = C.PanelAlt
	end)
	b.Activated:Connect(function()
		task.defer(function()
			self:_go(page.id, nil, false)
		end)
	end)
	return b
end

---------------------------------------------------------------------------
-- Éléments
---------------------------------------------------------------------------

function Wiki:_renderElement(element)
	if type(element) ~= "table" then
		return nil
	end
	local genre = element.kind
	if genre == "h" then
		return self:_elTitre(element.text)
	elseif genre == "p" then
		return self:_elParagraphe(element.text)
	elseif genre == "steps" then
		return self:_elEtapes(element.items)
	elseif genre == "tip" then
		return self:_elEncadre(element.text, "tip")
	elseif genre == "warn" then
		return self:_elEncadre(element.text, "warn")
	elseif genre == "code" then
		return self:_elCode(element.text)
	elseif genre == "link" then
		return self:_elLien(element)
	elseif genre == "block" then
		return self:_elBloc(element.def)
	elseif genre == "example" then
		return self:_elExemple(element.id)
	end
	return nil
end

function Wiki:_elTitre(texte)
	local titre = texteEnroule({
		Text = tostring(texte or ""),
		Font = FONT_BOLD,
		TextSize = 20,
		TextColor3 = C.Text,
	})
	rembourrage(titre, 12, 0, 0, 0)
	return titre
end

function Wiki:_elParagraphe(texte)
	return texteEnroule({
		Text = enrichir(texte),
		RichText = true,
		TextSize = BODY_SIZE,
		TextColor3 = C.TextSoft,
		LineHeight = 1.15,
	})
end

function Wiki:_elEtapes(items)
	local conteneur = groupe({})
	liste(conteneur, 10)
	for i, item in ipairs(items or {}) do
		local ligne = groupe({ LayoutOrder = i, Parent = conteneur })
		local rond = etiquette({
			Text = tostring(i),
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = WHITE,
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 0,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			Size = UDim2.fromOffset(26, 26),
			Parent = ligne,
		})
		Util.corner(rond, 13)
		texteEnroule({
			Text = enrichir(item),
			RichText = true,
			TextSize = BODY_SIZE,
			TextColor3 = C.TextSoft,
			LineHeight = 1.15,
			Position = UDim2.fromOffset(40, 3),
			Size = UDim2.new(1, -40, 0, 0),
			Parent = ligne,
		})
	end
	return conteneur
end

function Wiki:_elEncadre(texte, genre)
	local couleur = C.Accent
	local titre = "●  Astuce"
	local couleurTitre = C.AccentText
	if genre == "warn" then
		couleur = C.Warning
		titre = "⚠  Attention"
		couleurTitre = C.WarningText
	end
	local boite = Util.create("Frame", {
		BackgroundColor3 = couleur,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	Util.corner(boite, 10)
	Util.stroke(boite, couleur, 1, 0.55)
	rembourrage(boite, 12, 16, 14, 16)
	liste(boite, 4)
	texteEnroule({ Text = titre, Font = FONT_BOLD, TextSize = 13, TextColor3 = couleurTitre, LayoutOrder = 1, Parent = boite })
	texteEnroule({
		Text = enrichir(texte),
		RichText = true,
		TextSize = 14,
		TextColor3 = C.Text,
		LineHeight = 1.15,
		LayoutOrder = 2,
		Parent = boite,
	})
	return boite
end

function Wiki:_elCode(texte)
	local boite = Util.create("Frame", {
		BackgroundColor3 = C.CodeBg,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	Util.corner(boite, 8)
	Util.stroke(boite, C.PanelBorder, 1)
	rembourrage(boite, 12, 14, 12, 14)
	texteEnroule({
		Text = tostring(texte or ""),
		Font = FONT_CODE,
		TextSize = 14,
		TextColor3 = Theme.Code.Text,
		LineHeight = 1.1,
		Parent = boite,
	})
	return boite
end

function Wiki:_elLien(element)
	local texte = tostring(element.text or element.page or element.def or "")
	local lien = Util.create("TextButton", {
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = FONT_BOLD,
		TextSize = 14,
		TextColor3 = C.AccentText,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "→  " .. texte,
	})
	rembourrage(lien, 2, 0, 2, 0)
	lien.MouseEnter:Connect(function()
		lien.TextColor3 = C.Text
	end)
	lien.MouseLeave:Connect(function()
		lien.TextColor3 = C.AccentText
	end)
	lien.Activated:Connect(function()
		task.defer(function()
			self:_followLink(element)
		end)
	end)
	return lien
end

function Wiki:_followLink(element)
	if self.destroyed then
		return
	end
	if type(element.def) == "string" then
		self:openBlock(element.def)
		return
	end
	local pageId = element.page
	if type(element.example) == "string" then
		pageId = self.exampleHome[element.example] or "galerie"
		self:_go(pageId, "ex_" .. element.example, true)
		return
	end
	if type(pageId) == "string" and self.pages[pageId] then
		self:_go(pageId, element.anchor, element.anchor ~= nil)
	end
end

function Wiki:_elBloc(defId)
	local def = Registry.get(defId)
	if def == nil then
		return self:_elEncadre("Bloc inconnu : `" .. tostring(defId) .. "`.", "warn")
	end
	return self:_blockCard(def, { referenceLink = true, clickOpens = true })
end

function Wiki:_elExemple(id)
	local ex = self.examplesById[id]
	if ex == nil then
		return self:_elEncadre("Exemple introuvable : `" .. tostring(id) .. "`.", "warn")
	end
	return self:_exampleCard(ex)
end

---------------------------------------------------------------------------
-- Blocs : aperçu (Renderer) et fiche
---------------------------------------------------------------------------

function Wiki:_renderOpts(getVariables, onPointerDown, onHover)
	return {
		interactive = false,
		callbacks = {
			onBlockPointerDown = onPointerDown or rien,
			onBlockContextMenu = rien,
			onInputCommit = rien,
			openMenu = rien,
			openColorPicker = rien,
			getVariables = getVariables,
			onHover = onHover,
		},
	}
end

-- Aperçu d'un bloc (prototype non interactif), réduit si trop large.
-- retrait = largeur à retirer de la colonne (marges des cartes) ; surClic = fonction facultative
function Wiki:_blockPreview(def, retrait, surClic)
	local support = Util.create("Frame", {
		Name = "Apercu",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(10, 10),
	})
	local vue = nil
	if Renderer and type(Renderer.renderPrototype) == "function" then
		local presets = {}
		for _, entree in ipairs(def.inputs or {}) do
			if entree.kind == "variable" then
				presets[entree.name] = "ma variable"
			end
		end
		local opts = self:_renderOpts(function()
			return { "ma variable" }
		end, function()
			if surClic then
				task.defer(surClic)
			end
		end, nil)
		local ok, resultat = pcall(Renderer.renderPrototype, def.id, presets, support, opts)
		if ok and type(resultat) == "table" and typeof(resultat.frame) == "Instance" then
			vue = resultat
		elseif not ok then
			warn("[Blocs FR] Wiki : aperçu de « " .. tostring(def.id) .. " » impossible : " .. tostring(resultat))
		end
	end

	if vue == nil then
		-- Repli : libellé du bloc dans une pastille de sa couleur
		support.Size = UDim2.new(1, 0, 0, 0)
		support.AutomaticSize = Enum.AutomaticSize.Y
		liste(support, 4)
		local texte = Registry.plainLabel(def)
		local largeur = Util.textSize(texte, 13, FONT_BOLD).X + 24
		local repli = etiquette({
			Text = texte,
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = WHITE,
			BackgroundColor3 = Registry.color(def),
			BackgroundTransparency = 0,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(0, largeur, 0, 32),
			LayoutOrder = 1,
			Parent = support,
		})
		Util.create("UISizeConstraint", { MaxSize = Vector2.new(CONTENT_MAX_W, 32), Parent = repli })
		Util.corner(repli, 6)
		etiquette({
			Text = "Aperçu indisponible",
			TextSize = 11,
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = 2,
			Parent = support,
		})
		return support
	end

	table.insert(self.views, vue)
	local largeur = math.max(1, tonumber(vue.width) or vue.frame.Size.X.Offset)
	local hauteur = math.max(1, tonumber(vue.height) or vue.frame.Size.Y.Offset)
	vue.frame.Position = UDim2.fromOffset(0, 0)
	local echelle = vue.frame:FindFirstChildOfClass("UIScale")
	if echelle == nil then
		echelle = Instance.new("UIScale")
		echelle.Parent = vue.frame
	end
	local function ajuster(largeurColonne)
		local s = 1
		if largeurColonne then
			local disponible = largeurColonne - retrait
			if largeur > disponible then
				s = math.max(MIN_SCALE, disponible / largeur)
			end
		end
		echelle.Scale = s
		support.Size = UDim2.fromOffset(math.ceil(largeur * s), math.ceil(hauteur * s) + NOTCH_SPACE)
	end
	table.insert(self.resizers, ajuster)
	ajuster(self:_columnWidth())
	return support
end

-- Étiquettes d'un bloc : forme, type de script, contexte fourni, catégorie
function Wiki:_blockTags(def, avecCategorie)
	local items = {}
	if avecCategorie then
		local cat = Registry.category(def.category)
		if cat then
			table.insert(items, pastille("● " .. cat.name, cat.dot or cat.color))
		end
	end
	table.insert(items, pastille(FORMES_FR[def.shape] or tostring(def.shape)))
	if def.loop then
		table.insert(items, pastille("Boucle"))
	end
	if def.scriptType == "server" then
		table.insert(items, pastille("Script serveur uniquement", C.AccentText))
	elseif def.scriptType == "local" then
		table.insert(items, pastille("Script local uniquement", C.SuccessText))
	elseif def.scriptType == "module" then
		table.insert(items, pastille("Script module uniquement", MODULE_TEXT))
	end
	if def.shape == "hat" and type(def.provides) == "table" and #def.provides > 0 then
		local noms = {}
		for _, nom in ipairs(def.provides) do
			table.insert(noms, CONTEXTE_FR[nom] or tostring(nom))
		end
		table.insert(items, pastille("Donne : " .. table.concat(noms, ", "), C.WarningText))
	end
	local ligne = groupe({})
	local disposition = liste(ligne, 6, Enum.FillDirection.Horizontal)
	pcall(function()
		disposition.Wraps = true
	end)
	for i, item in ipairs(items) do
		item.LayoutOrder = i
		item.Parent = ligne
	end
	return ligne
end

-- « Utilisé dans : » + un bouton par exemple
function Wiki:_usageRow(exemples)
	local ligne = groupe({})
	local disposition = liste(ligne, 6, Enum.FillDirection.Horizontal)
	disposition.VerticalAlignment = Enum.VerticalAlignment.Center
	pcall(function()
		disposition.Wraps = true
	end)
	etiquette({
		Text = "Utilisé dans :",
		TextSize = 13,
		TextColor3 = C.TextDim,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.fromOffset(Util.textSize("Utilisé dans :", 13, FONT).X + 4, 24),
		LayoutOrder = 0,
		Parent = ligne,
	})
	for i, ex in ipairs(exemples) do
		local titre = tostring(ex.title or ex.id)
		local b = Util.create("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = C.Button,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(Util.textSize(titre, 12, FONT_BOLD).X + 20, 24),
			Font = FONT_BOLD,
			TextSize = 12,
			TextColor3 = C.AccentText,
			Text = titre,
			LayoutOrder = i,
			Parent = ligne,
		})
		Util.corner(b, 12)
		b.MouseEnter:Connect(function()
			b.BackgroundColor3 = C.ButtonHover
		end)
		b.MouseLeave:Connect(function()
			b.BackgroundColor3 = C.Button
		end)
		b.Activated:Connect(function()
			local exempleId = ex.id
			task.defer(function()
				self:_followLink({ example = exempleId })
			end)
		end)
	end
	return ligne
end

-- Fiche d'un bloc. options = { anchor, usages, referenceLink, clickOpens, category }
function Wiki:_blockCard(def, options)
	options = options or {}
	local fiche = carte({ Name = "Bloc_" .. tostring(def.id) })
	if options.anchor then
		self.anchors[options.anchor] = fiche
	end
	local surClic = nil
	if options.clickOpens then
		surClic = function()
			self:openBlock(def.id)
		end
	end
	local apercu = self:_blockPreview(def, 2 * CARD_PAD, surClic)
	apercu.LayoutOrder = 1
	apercu.Parent = fiche

	local etiquettes = self:_blockTags(def, options.category)
	etiquettes.LayoutOrder = 2
	etiquettes.Parent = fiche

	local explication = def.tooltip
	if type(explication) ~= "string" or explication == "" then
		explication = "Pas encore d'explication pour ce bloc."
	end
	if def.id == "var_valeur" then
		explication = "La valeur actuelle d'une variable. Chaque variable créée avec « ＋ Créer une variable » a son propre bloc rond, à glisser dans les cases des autres blocs."
	end
	texteEnroule({
		Text = explication,
		TextSize = 14,
		TextColor3 = C.TextSoft,
		LineHeight = 1.15,
		LayoutOrder = 3,
		Parent = fiche,
	})

	if options.usages then
		local exemples = self.usage[def.id]
		if exemples and #exemples > 0 then
			local ligne = self:_usageRow(exemples)
			ligne.LayoutOrder = 4
			ligne.Parent = fiche
		end
	end
	if options.referenceLink then
		local lien = self:_elLien({ def = def.id, text = "Voir sa fiche dans « Tous les blocs »" })
		lien.TextSize = 13
		lien.LayoutOrder = 5
		lien.Parent = fiche
	end
	return fiche
end

---------------------------------------------------------------------------
-- Exemples
---------------------------------------------------------------------------

function Wiki:_exampleCard(ex)
	local fiche = carte({ Name = "Exemple_" .. tostring(ex.id) })
	self.anchors["ex_" .. tostring(ex.id)] = fiche

	-- Titre + type de script
	local entete = groupe({ LayoutOrder = 1, Parent = fiche })
	local texteMode = "● Script serveur"
	local couleurMode = C.AccentText
	if ex.mode == "local" then
		texteMode = "● Script local"
		couleurMode = C.SuccessText
	elseif ex.mode == "module" then
		texteMode = "● Script module"
		couleurMode = MODULE_TEXT
	end
	local mode = pastille(texteMode, couleurMode, C.ButtonActive)
	mode.AnchorPoint = Vector2.new(1, 0)
	mode.Position = UDim2.new(1, 0, 0, 1)
	mode.Parent = entete
	texteEnroule({
		Text = tostring(ex.title or ex.id),
		Font = FONT_BOLD,
		TextSize = 18,
		TextColor3 = C.Text,
		Size = UDim2.new(1, -(mode.Size.X.Offset + 12), 0, 0),
		Parent = entete,
	})

	texteEnroule({
		Text = tostring(ex.description or ""),
		TextSize = 14,
		TextColor3 = C.TextSoft,
		LineHeight = 1.15,
		LayoutOrder = 2,
		Parent = fiche,
	})
	texteEnroule({
		Text = "<b><font color=\"" .. hex(C.TextSoft) .. "\">Où placer le script :</font></b> " .. echapper(ex.cible or "?"),
		RichText = true,
		TextSize = 13,
		TextColor3 = C.TextDim,
		LayoutOrder = 3,
		Parent = fiche,
	})

	local apercu = self:_examplePreview(ex)
	apercu.LayoutOrder = 4
	apercu.Parent = fiche

	-- Charger dans l'éditeur
	local ligne = Util.create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 5,
		Parent = fiche,
	})
	local b = bouton("Charger cet exemple", true)
	b.Parent = ligne
	local decalage = b.Size.X.Offset + 12
	local etat = etiquette({
		Text = "",
		TextSize = 13,
		TextColor3 = C.TextDim,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(decalage, 0),
		Size = UDim2.new(1, -decalage, 1, 0),
		Parent = ligne,
	})
	local exempleId = ex.id
	b.Activated:Connect(function()
		self:_loadExample(exempleId, etat)
	end)
	return fiche
end

function Wiki:_loadExample(exempleId, etat)
	local rappel = self.deps.onLoadExample
	local message = "Ouvre l'éditeur de blocs pour charger cet exemple."
	local couleur = C.WarningText
	if type(rappel) == "function" then
		local ok, resultat, erreur = pcall(rappel, exempleId)
		if not ok then
			message = "Impossible de charger l'exemple : " .. tostring(resultat)
			couleur = C.DangerText
		elseif resultat == false then
			message = tostring(erreur or "Impossible de charger l'exemple.")
			couleur = C.DangerText
		else
			message = "✓ Exemple envoyé dans l'éditeur de blocs."
			couleur = C.SuccessText
		end
	end
	etat.Text = message
	etat.TextColor3 = couleur
	local jeton = self.renderToken
	task.delay(5, function()
		if jeton == self.renderToken and etat.Parent ~= nil and etat.Text == message then
			etat.Text = ""
		end
	end)
end

-- Cadre sombre à points avec les piles de l'exemple, dessinées par le Renderer (non interactives)
function Wiki:_examplePreview(ex)
	local boite = Util.create("Frame", {
		Name = "Apercu",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, 80),
	})
	Util.corner(boite, 10)
	Util.stroke(boite, C.PanelBorder, 1)
	local points = Util.create("Frame", {
		Name = "Points",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = boite,
	})
	local interieur = Util.create("Frame", {
		Name = "Blocs",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(10, 10),
		ZIndex = 2,
		Parent = boite,
	})
	local echelle = Instance.new("UIScale")
	echelle.Parent = interieur

	local modele = nil
	if Model and Renderer and type(Renderer.renderStack) == "function" and type(ex.data) == "table" then
		local ok, resultat = pcall(Model.fromData, Util.deepCopy(ex.data))
		if ok and type(resultat) == "table" then
			modele = resultat
			table.insert(self.models, modele)
		end
	end

	local vues = {}
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	if modele then
		local function cadreDuBloc(blockId)
			for _, vue in ipairs(vues) do
				local info = type(vue.blocks) == "table" and vue.blocks[blockId]
				if type(info) == "table" and typeof(info.frame) == "Instance" then
					return info.frame
				end
			end
			return nil
		end
		local opts = self:_renderOpts(function()
			return modele.variables or {}
		end, function(blockId)
			local bloc = modele.blocks[blockId]
			if bloc then
				local defId = bloc.def
				task.defer(function()
					self:openBlock(defId)
				end)
			end
		end, function(blockId, entre)
			if entre then
				local bloc = modele.blocks[blockId]
				self:_showTooltip(cadreDuBloc(blockId), bloc and Registry.get(bloc.def))
			else
				self:_hideTooltip()
			end
		end)
		for _, topId in ipairs(modele.tops) do
			local bloc = modele.blocks[topId]
			local ok, vue = pcall(Renderer.renderStack, modele, topId, interieur, opts)
			if ok and type(vue) == "table" and typeof(vue.frame) == "Instance" and bloc then
				table.insert(vues, vue)
				table.insert(self.views, vue)
				local w = tonumber(vue.width) or vue.frame.Size.X.Offset
				local h = tonumber(vue.height) or vue.frame.Size.Y.Offset
				vue.frame.Position = UDim2.fromOffset(bloc.x, bloc.y)
				minX = math.min(minX, bloc.x)
				minY = math.min(minY, bloc.y)
				maxX = math.max(maxX, bloc.x + w)
				maxY = math.max(maxY, bloc.y + h)
			elseif not ok then
				warn("[Blocs FR] Wiki : aperçu de l'exemple « " .. tostring(ex.id) .. " » impossible : " .. tostring(vue))
			end
		end
	end

	if #vues == 0 then
		boite.Size = UDim2.new(1, 0, 0, 56)
		etiquette({
			Text = "Aperçu indisponible",
			TextSize = 13,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 3,
			Parent = boite,
		})
		return boite
	end

	local largeurContenu = math.max(1, maxX - minX)
	local hauteurContenu = math.max(1, maxY - minY) + NOTCH_SPACE
	interieur.Size = UDim2.fromOffset(math.ceil(maxX + NOTCH_SPACE), math.ceil(maxY + NOTCH_SPACE))
	local derniereLargeur, derniereHauteur = -1, -1
	local function ajuster(largeurColonne)
		local disponible = nil
		if largeurColonne then
			disponible = largeurColonne - 2 * CARD_PAD
		end
		local s = 1
		if disponible and largeurContenu + 2 * EXAMPLE_PAD > disponible then
			s = math.max(MIN_SCALE, (disponible - 2 * EXAMPLE_PAD) / largeurContenu)
		end
		echelle.Scale = s
		interieur.Position = UDim2.fromOffset(math.floor(EXAMPLE_PAD - minX * s), math.floor(EXAMPLE_PAD - minY * s))
		local hauteurBoite = math.ceil(hauteurContenu * s + 2 * EXAMPLE_PAD)
		boite.Size = UDim2.new(1, 0, 0, hauteurBoite)
		local largeurBoite = disponible or math.ceil(largeurContenu * s + 2 * EXAMPLE_PAD)
		if math.abs(largeurBoite - derniereLargeur) > 2 or hauteurBoite ~= derniereHauteur then
			derniereLargeur, derniereHauteur = largeurBoite, hauteurBoite
			dessinerPoints(points, largeurBoite, hauteurBoite)
		end
	end
	table.insert(self.resizers, ajuster)
	ajuster(self:_columnWidth())
	return boite
end

---------------------------------------------------------------------------
-- Recherche
---------------------------------------------------------------------------

function Wiki:_searchPages(requete)
	local mots = motsDe(requete)
	local resultats = {}
	if #mots == 0 then
		return resultats
	end
	for _, page in ipairs(self.pageOrder) do
		local score = 0
		local tous = true
		for _, mot in ipairs(mots) do
			if string.find(page.foldTitle, mot, 1, true) then
				score += 10
			elseif string.find(page.foldText, mot, 1, true) then
				score += 1
			else
				tous = false
				break
			end
		end
		if tous then
			table.insert(resultats, { page = page, score = score, extrait = self:_excerpt(page, mots) })
		end
	end
	table.sort(resultats, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.page.index < b.page.index
	end)
	return resultats
end

-- Premier texte de la page qui contient un des mots cherchés
function Wiki:_excerpt(page, mots)
	for i, plie in ipairs(page.foldTexts or {}) do
		for _, mot in ipairs(mots) do
			if string.find(plie, mot, 1, true) then
				return couper(page.texts[i], 170)
			end
		end
	end
	return couper(page.summary or "", 170)
end

function Wiki:_renderSearch(requete)
	self:_pageHeader("Recherche", "Résultats pour « " .. requete .. " »", nil, nil)
	local pages = self:_searchPages(requete)
	local blocs = {}
	local ok, resultat = pcall(Registry.search, requete)
	if ok and type(resultat) == "table" then
		blocs = resultat
	end
	if #pages == 0 and #blocs == 0 then
		self:_add(self:_elParagraphe("Aucun résultat. Essaie un mot plus court ou un autre mot, par exemple `porte`, `couleur`, `joueur` ou `son`."))
		if self.pages.galerie then
			self:_add(self:_elLien({ page = "galerie", text = "Voir tous les exemples" }))
		end
		return
	end
	-- les résultats arrivent l'un après l'autre (fondu en cascade, voir Wiki:_render)
	local cascade = {}
	self.staggerItems = cascade
	if #pages > 0 then
		self:_add(self:_elTitre("Pages (" .. #pages .. ")"))
		for i, r in ipairs(pages) do
			if i > MAX_PAGE_RESULTS then
				break
			end
			table.insert(cascade, self:_add(self:_resultCard(r.page, r.extrait)))
		end
	end
	if #blocs > 0 then
		self:_add(self:_elTitre("Blocs (" .. #blocs .. ")"))
		if #blocs > MAX_BLOCK_RESULTS then
			self:_add(texteEnroule({
				Text = "Les " .. MAX_BLOCK_RESULTS .. " premiers blocs sont affichés : ajoute un mot pour préciser ta recherche.",
				TextSize = 13,
				TextColor3 = C.TextDim,
			}))
		end
		for i, def in ipairs(blocs) do
			if i > MAX_BLOCK_RESULTS then
				break
			end
			table.insert(cascade, self:_add(self:_blockCard(def, { category = true, clickOpens = true, referenceLink = true })))
		end
	end
end

function Wiki:_resultCard(page, extrait)
	local b = Util.create("TextButton", {
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	Util.corner(b, 10)
	Util.stroke(b, C.PanelBorder, 1)
	rembourrage(b, 12, 16, 14, 16)
	liste(b, 4)
	texteEnroule({ Text = page.title, Font = FONT_BOLD, TextSize = 16, TextColor3 = C.Text, LayoutOrder = 1, Parent = b })
	texteEnroule({ Text = page.section.title, TextSize = 12, TextColor3 = C.AccentText, LayoutOrder = 2, Parent = b })
	if type(extrait) == "string" and extrait ~= "" then
		texteEnroule({ Text = extrait, TextSize = 13, TextColor3 = C.TextSoft, LineHeight = 1.1, LayoutOrder = 3, Parent = b })
	end
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = C.ButtonHover
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = C.PanelAlt
	end)
	local pageId = page.id
	b.Activated:Connect(function()
		task.defer(function()
			self:_go(pageId, nil, false)
		end)
	end)
	return b
end

---------------------------------------------------------------------------
-- Défilement, redimensionnement, bulle d'aide
---------------------------------------------------------------------------

function Wiki:_columnWidth()
	if self.column == nil then
		return nil
	end
	local largeur = self.column.AbsoluteSize.X
	if largeur < 60 then
		return nil
	end
	return largeur
end

function Wiki:_runResizers()
	local largeur = self:_columnWidth()
	for _, ajuster in ipairs(self.resizers) do
		local ok, erreur = pcall(ajuster, largeur)
		if not ok then
			warn("[Blocs FR] Wiki : mise à l'échelle impossible : " .. tostring(erreur))
		end
	end
end

function Wiki:_scheduleResize()
	if self.resizeScheduled then
		return
	end
	self.resizeScheduled = true
	task.delay(RESIZE_DELAY, function()
		self.resizeScheduled = false
		if not self.destroyed then
			self:_runResizers()
		end
	end)
end

-- Position (dans le contenu défilant) du haut d'une ancre, ou nil si elle n'est pas encore mise en page
function Wiki:_anchorY(cible)
	local contenu = self.content
	if cible == nil or cible.Parent == nil or contenu.AbsoluteWindowSize.Y <= 0 or cible.AbsoluteSize.Y <= 0 then
		return nil
	end
	return cible.AbsolutePosition.Y - contenu.AbsolutePosition.Y + contenu.CanvasPosition.Y
end

-- Attend que la page soit mise en page : fenêtre ouverte, tailles automatiques calculées, aperçus
-- remis à l'échelle (mesure(), stable deux images de suite ; une seconde au plus). À appeler dans
-- son propre thread (ne bloque jamais le rendu). Renvoie la dernière mesure, ou nil si la page a
-- changé entre-temps.
function Wiki:_waitLayout(mesure, jeton)
	local derniere = nil
	local stable = 0
	for _ = 1, LAYOUT_FRAMES do
		RunService.Heartbeat:Wait()
		if self.destroyed or jeton ~= self.renderToken then
			return nil
		end
		local valeur = mesure()
		if valeur ~= nil and not self.resizeScheduled then
			if derniere ~= nil and math.abs(valeur - derniere) < 1 then
				stable += 1
				if stable >= 2 then
					return valeur
				end
			else
				stable = 0
			end
			derniere = valeur
		end
	end
	return derniere
end

-- Défile (en douceur) jusqu'à une fiche, une fois la page mise en page, puis la met en valeur
function Wiki:_scrollToAnchor(nom, mettreEnValeur)
	local jeton = self.renderToken
	self:_stopAnchorScroll()
	local cible = self.anchors[nom]
	if cible == nil then
		return
	end
	task.spawn(function()
		local y = self:_waitLayout(function()
			return self:_anchorY(cible)
		end, jeton)
		if y == nil or self.destroyed or jeton ~= self.renderToken or cible.Parent == nil then
			return
		end
		local contenu = self.content
		local maxY = math.max(0, contenu.AbsoluteCanvasSize.Y - contenu.AbsoluteWindowSize.Y)
		local position = Vector2.new(0, Util.clamp(y - 12, 0, maxY))
		self:_stopAnchorScroll()
		if animer() then
			self.anchorScroll = anim("tween", contenu, { CanvasPosition = position }, SCROLL_TIME, "quintOut")
		end
		if self.anchorScroll == nil then
			contenu.CanvasPosition = position
		end
		if mettreEnValeur then
			self:_flash(cible, jeton)
		end
	end)
end

-- Retour en arrière : revient à la position de défilement d'avant, une fois la page mise en page
function Wiki:_restoreScroll(position)
	local jeton = self.renderToken
	task.spawn(function()
		local contenu = self.content
		local hauteur = self:_waitLayout(function()
			if contenu.AbsoluteWindowSize.Y <= 0 then
				return nil
			end
			return contenu.AbsoluteCanvasSize.Y
		end, jeton)
		if hauteur == nil or self.destroyed or jeton ~= self.renderToken then
			return
		end
		local maxY = math.max(0, contenu.AbsoluteCanvasSize.Y - contenu.AbsoluteWindowSize.Y)
		contenu.CanvasPosition = Vector2.new(0, Util.clamp(position.Y, 0, maxY))
	end)
end

-- Met une fiche en valeur : contour bleu épais et fond légèrement bleuté qui s'adoucissent puis
-- reviennent à la normale (environ 1,6 s). Sans animations : contour bleu pendant 1,6 s.
function Wiki:_flash(cadre, jeton)
	local contour = cadre:FindFirstChildOfClass("UIStroke")
	if contour == nil then
		return
	end
	-- couleurs d'origine notées une seule fois (une mise en valeur peut en interrompre une autre)
	local origine = self.flashOrigins[contour]
	if origine == nil then
		origine = { couleur = contour.Color, epaisseur = contour.Thickness, fond = cadre.BackgroundColor3 }
		self.flashOrigins[contour] = origine
	end
	if not animer() then
		contour.Color = C.Accent
		contour.Thickness = 2
		task.delay(1.6, function()
			if contour.Parent ~= nil and jeton == self.renderToken then
				contour.Color = origine.couleur
				contour.Thickness = origine.epaisseur
			end
		end)
		return
	end
	contour.Color = C.Accent
	contour.Thickness = 3
	cadre.BackgroundColor3 = origine.fond:Lerp(C.Accent, 0.16)
	local handle = anim("tween", contour, { Thickness = 2 }, 0.3, "quadOut", function()
		anim("tween", contour, { Color = origine.couleur, Thickness = origine.epaisseur }, 0.5, "quadOut", nil, 1)
	end)
	if handle == nil then
		contour.Color = origine.couleur
		contour.Thickness = origine.epaisseur
	end
	if anim("tween", cadre, { BackgroundColor3 = origine.fond }, 0.9, "quadOut", nil, 0.6) == nil then
		cadre.BackgroundColor3 = origine.fond
	end
end

function Wiki:_showTooltip(cadre, def)
	if self.destroyed or def == nil or cadre == nil or not cadre:IsDescendantOf(self.root) then
		return
	end
	local titre = Registry.plainLabel(def)
	if def.id == "var_valeur" then
		titre = "valeur d'une variable"
	end
	local texte = tostring(def.tooltip or "")
	local tailleRacine = self.root.AbsoluteSize
	local largeur = math.min(300, math.max(160, tailleRacine.X - 16))
	self.tooltip.Size = UDim2.fromOffset(largeur, 0)
	self.tooltipTitle.Text = titre
	self.tooltipText.Text = texte
	local interieur = largeur - 24
	local hauteur = 20 + 8 + hauteurTexte(titre, 13, FONT_BOLD, interieur) + hauteurTexte(texte, 12, FONT, interieur) + 16
	local relatif = cadre.AbsolutePosition - self.root.AbsolutePosition
	local x = Util.clamp(relatif.X, 8, math.max(8, tailleRacine.X - largeur - 8))
	local y = relatif.Y + cadre.AbsoluteSize.Y + 6
	if y + hauteur > tailleRacine.Y - 8 then
		y = relatif.Y - hauteur - 6
	end
	y = math.max(8, y)
	self.tooltip.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	local etaitVisible = self.tooltip.Visible
	self.tooltip.Visible = true
	-- la bulle apparaît en fondu (0,1 s) ; déjà affichée, elle se déplace simplement
	if not etaitVisible then
		anim("fadeIn", self.tooltip, 0.1)
	end
end

function Wiki:_hideTooltip()
	if self.tooltip then
		self.tooltip.Visible = false
	end
end

---------------------------------------------------------------------------
-- Destruction
---------------------------------------------------------------------------

function Wiki:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self.renderToken += 1
	self.searchToken += 1
	self:_stopAnchorScroll()
	for _, connexion in ipairs(self.connections) do
		connexion:Disconnect()
	end
	self.connections = {}
	self:_clearPage()
	if self.root then
		self.root:Destroy()
		self.root = nil
	end
end

return Wiki
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">WikiContent</string><ProtectedString name="Source"><![CDATA[-- WikiContent : textes du wiki intégré de Blocs FR (SPEC §16).
--
-- Renvoie { sections = { { id, title, pages = { page… } } }, categoryIntros = { [catId] = texte } }
-- page = { id, title, summary, body = { élément… } }
-- Éléments :
--   { kind = "h", text }          titre de partie
--   { kind = "p", text }          paragraphe (**gras** et `code` acceptés)
--   { kind = "steps", items }     étapes numérotées
--   { kind = "tip", text }        encadré bleu « Astuce »
--   { kind = "warn", text }       encadré jaune « Attention »
--   { kind = "example", id }      exemple de Examples.lua dessiné avec ses blocs + « Charger cet exemple »
--   { kind = "block", def }       un bloc dessiné + son explication
--   { kind = "link", page, text, anchor? } ou { kind = "link", def, text }   lien vers une page / un bloc
--   { kind = "code", text }       texte en police de code
-- La section « Tous les blocs » (generated = "categories") est remplie par Wiki.lua à partir du
-- Registry : une page « cat_<id de catégorie> » par catégorie.
-- Les libellés de blocs cités entre « » sont ceux des fichiers Defs_*.lua (… = une case à remplir).
--
-- Version 2.1.0 (SPEC §26, §35, §36) : pages Studio d'interface, blocs sous l'écran, Caméra, Effets, systèmes
-- tout prêts, Modèles, prévisualiseur de hitbox, « Expliquer », notes, lignes entre les blocs, menus du clic
-- droit, blocs désactivés, favoris / copier-coller / partage / brouillon / mini-carte, Paramètres et
-- Nouveautés (id « nouveautes », ouverte par la carte de mise à jour et le menu « ? ») ; trois tutoriels.
-- NOTE: deux sections en plus de la SPEC §16 : « Guides » et « Outils de l'éditeur ».
-- NOTE: au chargement, chaque bloc, exemple et lien est vérifié (Registry, Examples, pages) : ce qui n'existe
--   pas (par exemple un bloc écrit en parallèle et pas encore là) est retiré de la page et noté dans
--   « retires » (DevBridge « examples » le signale). Le wiki n'affiche donc jamais « Bloc inconnu ».
-- NOTE: les chemins de menus s'écrivent avec « → » (le signe « → » ne s'affiche pas toujours dans Studio).

local function h(text)
	return { kind = "h", text = text }
end

local function p(text)
	return { kind = "p", text = text }
end

local function etapes(items)
	return { kind = "steps", items = items }
end

local function astuce(text)
	return { kind = "tip", text = text }
end

local function attention(text)
	return { kind = "warn", text = text }
end

local function exemple(id)
	return { kind = "example", id = id }
end

local function bloc(def)
	return { kind = "block", def = def }
end

local function lien(page, text, anchor)
	return { kind = "link", page = page, text = text, anchor = anchor }
end

local function lienBloc(def, text)
	return { kind = "link", def = def, text = text }
end

-- Lien vers un exemple (la page qui le présente, défilée jusqu'à lui)
local function lienExemple(id, text)
	return { kind = "link", example = id, text = text }
end

local function code(text)
	return { kind = "code", text = text }
end

---------------------------------------------------------------------------
-- Bien démarrer
---------------------------------------------------------------------------

local accueil = {
	id = "accueil",
	title = "Bienvenue dans Blocs FR",
	summary = "Programme tes objets Roblox avec des blocs, comme dans Scratch, entièrement en français.",
	body = {
		p("**Blocs FR** est un plugin de Roblox Studio qui te permet de créer des scripts en assemblant des blocs, comme dans Scratch. Pas besoin de connaître le Luau : tu emboîtes des blocs écrits en français, et Blocs FR écrit le vrai script Roblox à ta place."),
		h("Comment ça marche ?"),
		etapes({
			"Dans l'**Explorateur** de Studio, sélectionne l'objet à programmer (une Part, un modèle…). C'est la **cible** : elle s'affiche en haut de l'éditeur.",
			"Dans l'éditeur de blocs, glisse des blocs depuis la **palette** (à gauche) vers le **canvas** (la grande zone à points).",
			"Commence toujours par un bloc **événement**, celui avec une bosse sur le dessus : il décide **quand** les blocs du dessous s'exécutent.",
			"Accroche des blocs dessous : ils s'exécutent dans l'ordre, de haut en bas.",
			"Clique sur **Enregistrer** : Blocs FR crée le script dans la cible.",
			"Clique sur **Jouer** dans Studio pour tester ton jeu !",
		}),
		bloc("evt_touche_perso"),
		h("Comment utiliser ce wiki"),
		p("À gauche, le **sommaire** est rangé en sept parties : **Bien démarrer** (les bases), **Guides** (caméra, effets, systèmes tout prêts, modèles…), **Outils de l'éditeur** (clic droit, notes, paramètres…), **Tutoriels** (des projets pas à pas), **Exemples** (des scripts prêts à charger), **Tous les blocs** (chaque bloc expliqué, catégorie par catégorie) et **Aide** (quand quelque chose ne marche pas)."),
		p("En haut, la **recherche** trouve les pages et les blocs : essaie `porte`, `pièces`, `variable` ou `touche`. Le bouton **← Retour** te ramène à la page précédente."),
		p("Dans les exemples, passe la souris sur un bloc pour lire son explication, et clique dessus pour ouvrir sa fiche."),
		astuce("Le bouton **Charger cet exemple** envoie un exemple dans l'éditeur de blocs. Si ton projet est vide, l'exemple le remplace ; sinon, ses blocs sont ajoutés à côté des tiens."),
		h("Par où commencer ?"),
		lien("premier_script", "Ton premier script en deux minutes"),
		lien("editeur", "Découvrir l'éditeur en détail"),
		lien("tuto_brique", "Tutoriel : la brique mortelle"),
		lien("galerie", "Voir tous les exemples"),
		lien("faq", "Questions fréquentes"),
		h("Nouveau : la version 2.1.0"),
		p("Un **Studio d'interface** pour dessiner les écrans de ton jeu, les catégories **Interface**, **Caméra** et **Effets**, 28 nouveaux **systèmes tout prêts**, des **modèles** de scripts entiers, un **prévisualiseur de hitbox** en 3D, des **notes**, des **lignes** entre les blocs, des **paramètres** pour tout personnaliser… et bien plus."),
		lien("nouveautes", "Toutes les nouveautés"),
		h("Dessiner l'interface de ton jeu"),
		p("L'onglet **Interface**, en haut de l'éditeur, sert à dessiner des menus, une barre de vie, une boutique ou un écran de victoire. Huit modèles d'écrans sont prêts à l'emploi, et les blocs de l'écran se posent juste en dessous."),
		lien("studio_interface", "Le Studio d'interface"),
		lien("tuto_menu", "Tutoriel : un menu qui marche"),
		h("Des mécaniques toutes prêtes"),
		p("La catégorie **Tout prêts** fait en un seul bloc ce qui demanderait des dizaines de blocs : une attaque avec animation et hitbox, un projectile, un dash, une barre de vie, un PNJ qui poursuit les joueurs, mais aussi des points de sauvegarde, un sprint, un double saut, une porte automatique, un bouton d'achat, un chronomètre de course…"),
		lien("tuto_combat", "Tutoriel : système de combat (animation + hitbox)"),
		lien("toutprets_systemes", "Les systèmes tout prêts de la version 2.1.0"),
		lien("cat_toutprets", "Tous les blocs « Tout prêts »"),
		h("Réutiliser tes blocs"),
		p("Avec un **script module**, tu ranges tes propres fonctions (par exemple `soignerJoueur`) dans une boîte à outils. Tous tes scripts serveur et locaux peuvent ensuite les utiliser, sans recopier les mêmes blocs partout."),
		lien("modules", "Les scripts modules"),
		lien("tuto_module", "Tutoriel : une boîte à outils avec un module"),
	},
}

local premierScript = {
	id = "premier_script",
	title = "Ton premier script",
	summary = "Une brique qui change de couleur quand on marche dessus. C'est parti !",
	body = {
		p("Dans ce premier projet, tu vas créer une brique qui prend une couleur au hasard à chaque fois qu'un personnage la touche. Il ne faut que **deux blocs**."),
		h("Étapes"),
		etapes({
			"Dans Studio, ajoute une **Part** dans Workspace (bouton **Part** de l'onglet Accueil) et pose-la sur le sol.",
			"Sélectionne-la dans l'**Explorateur**.",
			"Ouvre l'éditeur : onglet **Plugins**, bouton **Éditeur de blocs**. En haut, la cible affiche `Workspace.Part`.",
			"Vérifie que **Script serveur** est choisi en haut de l'éditeur.",
			"Dans la palette, clique sur la catégorie **Événements** puis glisse « Quand un personnage touche cet objet » sur le canvas.",
			"Clique sur la catégorie **Apparence**, attrape « mettre une couleur au hasard à … » et lâche-le juste sous l'événement : il s'**aimante** tout seul.",
			"Clique sur **Enregistrer**. Un script `BlocsServeur` apparaît dans ta Part, dans l'Explorateur.",
			"Clique sur **Jouer**, marche sur la brique… elle change de couleur !",
		}),
		bloc("evt_touche_perso"),
		bloc("app_couleur_aleatoire"),
		astuce("Dans le menu d'un bloc, « cet objet » désigne l'objet qui contient le script : ici, ta Part."),
		h("Et ensuite ?"),
		p("Ajoute « attendre … secondes » puis « mettre la transparence de … à … » sous le bloc de couleur, avec la valeur `1` : la brique disparaît une seconde après avoir été touchée. Les blocs s'exécutent toujours dans l'ordre, de haut en bas."),
		p("Pour arrêter le test, clique sur **Arrêter** dans Studio. Tu peux ensuite modifier tes blocs, enregistrer à nouveau et rejouer."),
		lien("editeur", "Découvrir l'éditeur en détail"),
		lien("tuto_brique", "Tutoriel suivant : la brique mortelle"),
	},
}

local editeur = {
	id = "editeur",
	title = "L'éditeur en détail",
	summary = "Les onglets Blocs et Interface, la barre du haut, le menu ?, la palette, la zone de travail, l'aimantation, le clic droit et les animations.",
	body = {
		h("Les onglets Blocs et Interface"),
		p("Tout en haut à gauche, à côté du logo, deux onglets : **Blocs** pour assembler les scripts de tes objets, et **Interface** pour dessiner les écrans de ton jeu (menu, barre de vie, boutique…) avec leurs blocs juste en dessous. Chaque onglet garde son travail quand tu passes de l'un à l'autre, même s'il n'est pas encore enregistré."),
		lien("studio_interface", "Le Studio d'interface"),
		h("La barre du haut"),
		p("**Nouveau** commence un projet vide pour l'objet sélectionné dans l'Explorateur. **Ouvrir** recharge le script Blocs FR de l'objet sélectionné. **Enregistrer** crée ou met à jour le script dans la cible."),
		p("À côté, tu choisis le type de script : **Script serveur**, **Script local** ou **Script module** (quand la fenêtre est étroite : **Serveur**, **Local** ou **Module**). **Voir le code** te montre le script Luau que Blocs FR a écrit pour toi, et **Expliquer** raconte en français ce que fait ton script, étape par étape."),
		p("À droite, **Cible** indique l'objet qui recevra le script, et « ● Non enregistré » apparaît tant que tes derniers changements ne sont pas enregistrés. Le bouton des problèmes (**✓** ou **⚠**) ouvre le détecteur d'erreurs, et **Wiki** ouvre ce wiki. Quand la fenêtre est étroite, quelques boutons se cachent : tu les retrouves dans le menu **?** et dans le clic droit sur le fond de la zone de travail."),
		h("Le menu ? et les animations"),
		p("Le bouton **?** ouvre un menu : **Ouvrir le wiki**, **Aide sur l'éditeur**, **Paramètres…**, **Prévisualiseur de hitbox**, **Partager ce script…**, **Importer un code…**, **Animations de l'éditeur** et **Nouveautés**. Un petit point apparaît sur **?** quand une nouvelle version de Blocs FR est disponible."),
		p("**Animations de l'éditeur** allume ou éteint les animations : blocs qui s'aimantent avec un petit éclair, menus et panneaux qui glissent en douceur, confettis quand des blocs sont supprimés… La coche ✓ montre qu'elles sont allumées. Si ton ordinateur rame, éteins-les : tout marche pareil, sans mouvement. Leur vitesse (lente, normale, rapide) se règle dans les **Paramètres**."),
		lien("parametres", "Les paramètres"),
		h("La palette"),
		p("À gauche, les blocs sont rangés en **15 catégories** de couleurs différentes. Clique sur une catégorie pour sauter à ses blocs, ou tape un mot dans **Rechercher un bloc…** (les accents et les majuscules ne comptent pas)."),
		p("Les dix premières catégories contiennent les petits blocs de base : Événements, Débogage, Contrôle, Variables, Actions, Monde, Joueurs, Apparence, Opérateurs et Valeurs. Viennent ensuite **Interface** (les écrans de ton jeu), **Caméra**, **Effets** (particules, explosions, auras…), **Tout prêts** (des mécaniques de jeu complètes en un seul bloc) et **Modules** (les scripts modules)."),
		p("Tout en haut, la section **Favoris** rassemble tes blocs préférés (clic droit sur un bloc, puis **Ajouter aux favoris**). Sous les catégories, la tuile **◆ Modèles** mène à des scripts entiers prêts à poser."),
		p("Passe la souris sur un bloc pour lire son explication. Les blocs grisés avec une étiquette « local », « serveur » ou « module » ne marchent pas dans le type de script choisi. Dans un script module, les blocs « serveur » et « local » gardent leur étiquette mais ne sont pas grisés : un module tourne du côté du script qui l'utilise."),
		h("La zone de travail"),
		p("C'est la grande zone à points où tu assembles tes blocs. **Glisse le fond** pour te déplacer et utilise la **molette** de la souris pour zoomer (de 40 % à 200 %). En bas à droite, les boutons **−** et **＋** zooment aussi, et **◎** recentre la vue. En bas à gauche, la **mini-carte** montre toutes tes piles : clique dessus pour y aller."),
		h("L'aimantation"),
		p("Quand tu approches un bloc d'un autre, une **ombre blanche** montre où il va s'accrocher. Lâche-le et il s'emboîte. Tu peux le placer **sous** un bloc, **dans** un bloc en forme de C, ou **au-dessus** d'une pile."),
		p("Les blocs ronds (les **valeurs**) et les blocs pointus (les **conditions**) se lâchent **dans les cases** des autres blocs."),
		astuce("Quand tu attrapes un bloc au milieu d'une pile, tous les blocs **en dessous** viennent avec lui. Pour n'en sortir qu'un seul, fais un clic droit dessus puis **Détacher ce bloc**. Pour supprimer des blocs, lâche-les sur la palette."),
		h("Le clic droit et la sélection"),
		p("Comme sur le bureau de Windows, le **clic droit** ouvre un menu partout : sur un bloc (couper, copier, dupliquer, désactiver, ajouter une note, voir dans le code, ouvrir dans le wiki, supprimer…), sur le fond (coller, ranger, recentrer, zoom, partager…), sur une note et sur les blocs de la palette."),
		p("Clique sur un bloc pour le **sélectionner** : il est entouré de blanc. **Maj + clic** en ajoute d'autres, et **Maj + glisser** sur le fond dessine un rectangle de sélection. Les menus et les raccourcis (**Ctrl+C**, **Ctrl+V**, **Suppr**…) agissent alors sur toute la sélection."),
		lien("menus", "Tous les menus du clic droit et les raccourcis"),
		h("Annuler, refaire, ranger"),
		p("Les boutons **Annuler** et **Refaire** (ou **Ctrl+Z** et **Ctrl+Y**) annulent ou refont tes dernières actions, autant de fois que tu veux. **Ranger** aligne toutes les piles en colonnes bien propres."),
		h("Les formes des blocs"),
		p("La forme d'un bloc t'indique où il peut aller :"),
		bloc("evt_demarrage"),
		bloc("ctrl_attendre"),
		bloc("ctrl_repeter"),
		bloc("op_plus"),
		bloc("op_superieur"),
		p("**Événement** (avec une bosse) : démarre une pile. **Instruction** (rectangle) : fait une action, les instructions s'empilent. **Bloc C** : contient d'autres blocs. **Valeur** (bouts arrondis) : donne un nombre, un texte, un objet… **Condition** (bouts pointus) : vaut vrai ou faux."),
		lien("detecteur", "Le détecteur d'erreurs"),
		lien("notes", "Les notes"),
		lien("astuces", "Raccourcis et astuces"),
	},
}

local serveurLocal = {
	id = "serveur_local",
	title = "Script serveur, local ou module ?",
	summary = "Choisis le bon type de script : pour tout le monde, pour un seul joueur, ou une boîte à outils que les autres scripts utilisent.",
	body = {
		p("Dans Roblox, un jeu tourne à deux endroits en même temps : sur le **serveur** (l'ordinateur de Roblox qui gère la partie pour tout le monde) et chez chaque **joueur** (son ordinateur, sa tablette ou son téléphone)."),
		p("En haut de l'éditeur, tu choisis entre trois types de script : **Script serveur**, **Script local** et **Script module**."),
		h("Script serveur"),
		p("Ce qu'il fait est vu par **tous les joueurs** : une porte qui s'ouvre, un piège, des points dans le classement, un message de bienvenue… C'est le bon choix dans la plupart des cas, et c'est le choix par défaut."),
		h("Script local"),
		p("Il tourne **chez un seul joueur**. C'est lui qui peut lire le **clavier**, avec « Quand la touche … est appuyée ». Ce qu'il change sur les objets n'est souvent visible que par ce joueur."),
		astuce("Dans un script local, « le joueur » désigne toujours le joueur qui joue sur cet ordinateur, et « le personnage » son avatar."),
		h("Script module"),
		p("Un script module ne fait **rien tout seul** : c'est une **boîte à outils**. Il range des **fonctions** (des suites de blocs avec un nom, comme `soignerJoueur`) et des **valeurs**, que les scripts serveur et locaux utilisent avec « appeler la fonction … du module … »."),
		p("Il n'est ni serveur ni local : il tourne **du côté du script qui l'utilise**. Appelé par un script serveur, il agit sur le serveur ; appelé par un script local, il agit chez ce joueur. Pratique pour écrire une seule fois des blocs dont plusieurs scripts ont besoin."),
		h("Où placer le script ?"),
		p("**Script serveur** : dans une Part ou un modèle de **Workspace**, ou dans **ServerScriptService** pour un script qui concerne tout le jeu."),
		p("**Script local** : dans **StarterPlayer → StarterPlayerScripts**, dans **StarterGui** ou dans **StarterPack**. Si tu choisis un objet de Workspace, Blocs FR crée un script spécial qui tourne quand même chez le joueur."),
		p("**Script module** : dans un Folder de **ReplicatedStorage**, pour que les scripts serveur **et** les scripts locaux puissent l'utiliser. Dans **ServerScriptService** ou **ServerStorage**, seuls les scripts serveur y ont accès."),
		attention("Un script local placé dans **ServerScriptService** ou **ServerStorage** ne s'exécute jamais. Le détecteur d'erreurs te prévient si ça arrive."),
		h("Faire parler les deux côtés"),
		p("Un script local peut prévenir le serveur avec « envoyer le message … au serveur ». Le serveur peut prévenir les joueurs avec « envoyer le message … à tous les joueurs » ou « envoyer le message … au joueur … »."),
		lien("messages", "Les messages entre scripts"),
		lien("tuto_combat", "Tutoriel : un système de combat avec un script local et un script serveur"),
		lien("modules", "Les scripts modules"),
		lien("tuto_module", "Tutoriel : une boîte à outils avec un module"),
		exemple("touche_e"),
	},
}

local variables = {
	id = "variables",
	title = "Les variables",
	summary = "Une variable est une boîte avec un nom, qui garde une valeur : un score, un nombre de clics…",
	body = {
		p("Une **variable** retient une valeur pendant que le jeu tourne. Par exemple, une variable `clics` peut compter combien de fois on a cliqué sur un bouton, et une variable `vies` peut retenir les vies qui restent."),
		h("Créer une variable"),
		etapes({
			"Ouvre la catégorie **Variables** de la palette.",
			"Clique sur **＋ Créer une variable** et donne-lui un nom, par exemple `clics`.",
			"Un bloc rond portant ce nom apparaît dans la palette : c'est la **valeur** de la variable. Glisse-le dans les cases des autres blocs.",
			"Les autres blocs de variable (mettre, ajouter…) ont un menu pour choisir la variable.",
		}),
		bloc("var_definir"),
		bloc("var_ajouter"),
		p("Fais un **clic droit** sur le bloc rond d'une variable dans la palette pour la **renommer** ou la **supprimer**."),
		astuce("Pense à donner une valeur de départ à ta variable avec « mettre … à … » sous « Quand ce script démarre »."),
		attention("Une variable n'existe que dans **son** script. Deux scripts différents ne partagent pas leurs variables : utilise une **valeur partagée**, un **message** ou une valeur rangée dans un **script module**."),
		h("Les valeurs partagées"),
		p("« mettre la valeur partagée … à … » range une valeur sous un nom, dans Workspace. Tous les scripts peuvent ensuite la lire avec « valeur partagée … » ou l'augmenter avec « ajouter … à la valeur partagée … »."),
		bloc("var_partagee_definir"),
		h("Exemple"),
		exemple("compteur_clics"),
	},
}

local messages = {
	id = "messages",
	title = "Les messages entre scripts",
	summary = "Un script peut en prévenir un autre en lui envoyant un message.",
	body = {
		p("Un **message** est comme un signal qui porte un nom. Un script l'envoie, et tous les blocs « Quand je reçois le message … » qui portent **exactement le même nom** se déclenchent, dans tous les scripts."),
		bloc("ctrl_envoyer_message"),
		bloc("evt_message"),
		h("Exemple : un interrupteur et une lampe"),
		p("L'interrupteur envoie `allumer` ou `éteindre` quand on clique dessus. La lampe, dans un autre script, reçoit ces messages et s'allume ou s'éteint. Les deux objets n'ont pas besoin de se connaître : ils partagent juste le nom des messages."),
		lien("tuto_interrupteur", "Tutoriel : l'interrupteur et la lampe"),
		h("Entre le serveur et les joueurs"),
		p("« envoyer le message … » prévient les scripts **du même côté** : les scripts serveur entre eux, ou les scripts locaux d'un même joueur entre eux."),
		p("« envoyer le message … à tous les joueurs » et « envoyer le message … au joueur … » vont d'un script **serveur** vers les scripts **locaux** des joueurs."),
		p("« envoyer le message … au serveur » va d'un script **local** vers les scripts **serveur**. Là-bas, « le joueur » est le joueur qui a envoyé le message."),
		astuce("Les noms des messages doivent être identiques, majuscules et accents compris : `allumer` et `Allumer` sont deux messages différents."),
		lien("tuto_combat", "Exemple complet : la touche F du script local déclenche l'attaque du script serveur"),
	},
}

local detecteur = {
	id = "detecteur",
	title = "Le détecteur d'erreurs",
	summary = "Blocs FR vérifie tes blocs en permanence et t'explique comment corriger les problèmes.",
	body = {
		p("Pendant que tu assembles tes blocs, Blocs FR les **vérifie** tout seul. En haut de l'éditeur, le bouton des problèmes affiche **✓** quand tout va bien, ou **⚠** suivi du nombre de problèmes trouvés."),
		p("Clique dessus pour ouvrir le panneau **Problèmes**. Chaque problème explique ce qui ne va pas et comment le corriger. **Voir le bloc** t'amène directement au bloc concerné, qui est entouré de couleur sur le canvas."),
		h("Trois niveaux"),
		p("**Erreur** (rouge) : le script ne pourra pas marcher comme prévu. Corrige-la avant de jouer."),
		p("**Avertissement** (jaune) : quelque chose risque de ne pas marcher, par exemple un bloc « si … alors » qui ne contient aucun bloc."),
		p("**Conseil** (bleu) : une idée pour améliorer ton script, par exemple des blocs posés en dehors d'un événement, qui seront ignorés."),
		h("Ce qu'il vérifie"),
		p("Par exemple : une condition vide dans « si … alors » ou « tant que … » ; un événement sans aucun bloc dessous ; un bloc qui ne marche pas dans ce type de script ; « sortir de la boucle » placé hors d'une boucle ; un message que personne n'envoie ; un « objet nommé … » introuvable dans ta place ; un événement de contact ou de clic dans une cible qui n'est ni une Part ni un modèle ; un script placé là où il ne peut pas tourner."),
		p("Pour les **scripts modules** : « renvoyer … » ou « paramètre … » placé hors de « Définir la fonction … » ; deux fonctions qui portent le même nom ; un paramètre que la fonction ne déclare pas ; un module, une fonction ou une valeur introuvable ; un module rangé dans ServerScriptService ou ServerStorage mais appelé par un script local."),
		p("Pour l'**interface** : un écran ou un élément introuvable (« L'élément « Jouer » n'existe dans aucun écran. », avec « Voulais-tu dire … ? » quand un nom est presque pareil) ; un élément du mauvais type (un texte dans une case qui attend un bouton) ; un bloc Interface dans un script serveur sans joueur ; « afficher la statistique … dans … » avec une statistique qu'aucun script ne crée."),
		p("Pour les **nouveaux blocs** : un bloc **Caméra** dans un script serveur (la caméra n'existe que chez le joueur) ; « sauvegarder les statistiques des joueurs » dans deux scripts ; un nom d'objet écrit dans une case (« Arrivée » du téléporteur, « Point2 » de la caméra, « Pièce » du générateur, l'outil « Épée » du bouton d'achat…) introuvable dans ta place."),
		p("Les **blocs désactivés** ne sont pas vérifiés : un seul conseil te rappelle combien il y en a, au cas où tu aurais oublié de les réactiver."),
		h("Pendant le test"),
		p("Si un bloc plante pendant que tu joues, Blocs FR le retrouve : la **Sortie** affiche « [Blocs FR] Erreur dans le bloc « … » » avec une explication en français, et l'éditeur t'affiche l'erreur dans le détecteur quand tu reviens."),
		astuce("Une erreur rouge n'est pas une catastrophe : c'est Blocs FR qui t'aide à trouver le problème avant tes joueurs ! Le bouton **Expliquer** reprend aussi ces problèmes, sous chaque script, avec « Attention : … »."),
		lien("erreurs", "Comprendre les messages d'erreur"),
		lien("rien_ne_se_passe", "Mon script ne fait rien"),
		lien("expliquer", "Explique-moi ce script"),
	},
}

local enregistrer = {
	id = "enregistrer",
	title = "Enregistrer et rouvrir",
	summary = "Où vont tes blocs quand tu enregistres, et comment les retrouver plus tard.",
	body = {
		p("Quand tu cliques sur **Enregistrer**, Blocs FR transforme tes blocs en un vrai script Luau et le range **dans la cible** : `BlocsServeur` pour un script serveur, `BlocsLocal` pour un script local, et `BlocsModule` (un ModuleScript) pour un script module."),
		p("Tes blocs sont sauvegardés avec le script (dans une valeur nommée `BlocsFR_Donnees`) : tu pourras les rouvrir et les modifier quand tu veux."),
		h("Rouvrir un projet"),
		etapes({
			"Dans l'Explorateur, sélectionne l'objet qui contient le script, ou le script lui-même.",
			"Si ton projet actuel est déjà enregistré, Blocs FR charge les blocs tout seul.",
			"Sinon, enregistre d'abord ton projet, ou clique sur **Ouvrir**.",
		}),
		p("Pour commencer un autre script dans un autre objet, sélectionne cet objet puis clique sur **Nouveau**."),
		attention("Un objet ne contient qu'**un seul** script Blocs FR. Si tu cliques sur **Nouveau** dans un objet qui en a déjà un, le nouveau projet **remplacera** l'ancien script à l'enregistrement. Pour avoir deux scripts (par exemple un script local et un script serveur), mets-les dans deux objets différents."),
		attention("Ne modifie pas le script généré à la main : la prochaine fois que tu enregistreras depuis l'éditeur, tes changements seront remplacés par le code des blocs."),
		astuce("Pour copier un objet avec son script, sélectionne-le et appuie sur **Ctrl+D** dans Studio : le script et ses blocs sont copiés avec lui."),
		h("Ne perds rien"),
		p("« ● Non enregistré » reste affiché tant que tes derniers changements ne sont pas dans le script. Et n'oublie pas de sauvegarder ta place Roblox (**Fichier → Enregistrer**) : les scripts sont rangés dedans."),
		p("Si Studio se ferme avant que tu aies enregistré, pas de panique : toutes les 30 secondes (réglable dans les **Paramètres**), Blocs FR garde un **brouillon** de tes blocs non enregistrés. À la prochaine ouverture, la fenêtre « Brouillon retrouvé » te propose de le **Restaurer** ou de l'**Ignorer**."),
		lien("outils", "Le brouillon automatique et les autres outils"),
		p("Le bouton **Voir le code** te montre le script Luau : c'est un excellent moyen de découvrir le vrai langage de Roblox !"),
		h("Et les écrans ?"),
		p("Dans l'onglet **Interface**, c'est le bouton **Enregistrer l'écran** qui range l'écran (un ScreenGui) dans **StarterGui**, avec le script local `BlocsLocal` de ses blocs à l'intérieur."),
		lien("studio_interface", "Le Studio d'interface"),
	},
}

local modules = {
	id = "modules",
	title = "Les scripts modules",
	summary = "Une boîte à outils de fonctions et de valeurs, écrite une seule fois et utilisable par tous tes scripts.",
	body = {
		p("Un **script module** (un ModuleScript dans Roblox) est une **boîte à outils**. Il ne fait rien tout seul : il range des **fonctions** (des suites de blocs qui portent un nom) et des **valeurs**, que tes autres scripts, serveur ou locaux, peuvent utiliser autant de fois qu'ils veulent."),
		h("Pourquoi utiliser un module ?"),
		p("Imagine que dix objets de ton jeu doivent soigner les joueurs exactement de la même façon. Sans module, tu recopies les mêmes blocs dans dix scripts, et le jour où tu veux changer quelque chose, il faut tout refaire dix fois."),
		p("Avec un module, tu écris ces blocs **une seule fois**, dans une fonction, et chaque script n'a plus qu'à l'**appeler**. Tu modifies la fonction, tu enregistres : tous les scripts qui l'utilisent en profitent."),
		h("Créer un script module"),
		etapes({
			"Choisis où le ranger (voir juste en dessous), par exemple un **Folder** nommé `Outils` dans **ReplicatedStorage**, et sélectionne-le dans l'Explorateur.",
			"Dans l'éditeur de blocs, clique sur **Nouveau**, puis choisis **Script module** en haut de l'éditeur.",
			"Ajoute tes fonctions et tes valeurs avec les blocs de la catégorie **Modules**.",
			"Clique sur **Enregistrer** : un script module nommé `BlocsModule` apparaît dans ton Folder.",
		}),
		h("Où le placer ?"),
		p("**ReplicatedStorage** : le meilleur endroit. Le module y est visible à la fois par les **scripts serveur** et par les **scripts locaux**."),
		p("**ServerScriptService** ou **ServerStorage** : seuls les **scripts serveur** peuvent l'utiliser. Les joueurs ne voient pas ce qu'il contient, mais un script local n'y a pas accès du tout."),
		astuce("Range ton module dans un **Folder** rien qu'à lui, avec un nom clair comme `Outils` : c'est ce nom que tu écriras dans les blocs qui l'utilisent. N'oublie pas qu'un objet ne garde qu'**un seul** script Blocs FR."),
		attention("Un script local ne peut pas utiliser un module rangé dans ServerScriptService ou ServerStorage : ces endroits n'existent pas chez les joueurs. Le détecteur d'erreurs te prévient si ça arrive."),
		h("Définir une fonction"),
		bloc("mod_fonction"),
		p("« Définir la fonction … (paramètres : … … …) » donne un **nom** à la suite de blocs accrochée dessous, par exemple `soignerJoueur`. Les trois cases suivantes sont les **paramètres** : les informations que le script qui appelle la fonction lui envoie, par exemple `qui` (le joueur à soigner). Laisse vides les cases dont tu n'as pas besoin."),
		bloc("mod_parametre"),
		p("Dans la fonction, « paramètre … » donne la valeur reçue. Écris **exactement** le même nom que dans « Définir la fonction … » (`qui`, `min`, `max`…), puis glisse-le dans les cases des autres blocs, comme n'importe quelle valeur."),
		h("Renvoyer un résultat"),
		bloc("mod_renvoyer"),
		p("Une fonction peut aussi **calculer** quelque chose et le **renvoyer** au script qui l'a appelée. « renvoyer … » termine la fonction : rien ne peut être accroché dessous. Par exemple, une fonction `aleatoireEntre` avec les paramètres `min` et `max` peut renvoyer « nombre au hasard entre … et … »."),
		astuce("Une fonction sans « renvoyer … » sert à **faire** quelque chose : soigner, téléporter, colorer… Une fonction avec « renvoyer … » sert à **calculer** une valeur, que l'on récupère avec « résultat de … du module … »."),
		h("Des valeurs dans le module"),
		bloc("mod_definir_valeur"),
		p("« mettre la valeur … du module à … » range une valeur dans le module, sous un nom : une vitesse, un nombre de points, un texte… Les autres scripts la lisent avec « valeur … du module … »."),
		h("Quand le module est chargé"),
		bloc("mod_au_chargement"),
		p("Les blocs accrochés sous « Quand le module est chargé » s'exécutent **une seule fois**, la première fois qu'un script utilise le module. C'est le bon endroit pour donner leurs valeurs de départ aux valeurs du module."),
		p("Le serveur et chaque joueur ont **leur propre copie** du module : tous les scripts serveur partagent la même, et les scripts locaux d'un joueur en partagent une autre."),
		h("Utiliser le module depuis un autre script"),
		p("Dans un script **serveur** ou **local**, la catégorie **Modules** contient aussi les blocs qui utilisent un module. Dans leur case « module », écris le **nom** du Folder qui contient le module (ou le nom du script module lui-même), par exemple `Outils`. Blocs FR le cherche d'abord dans ReplicatedStorage."),
		bloc("mod_appeler"),
		p("« appeler la fonction … du module … avec … … … » lance une fonction du module. Les trois dernières cases sont envoyées aux paramètres, dans l'ordre : la première case va dans le premier paramètre, la deuxième dans le deuxième… Une case vide envoie « rien »."),
		bloc("mod_resultat"),
		p("« résultat de … du module … avec … … … » appelle la fonction et donne ce qu'elle **renvoie**. Glisse-le dans la case d'un autre bloc, par exemple dans « ajouter … à la statistique … de … »."),
		bloc("mod_valeur"),
		bloc("mod_existe"),
		p("« valeur … du module … » lit une valeur rangée dans le module, et « le module … existe » vérifie que le module est bien là avant de l'utiliser."),
		h("Exemple"),
		exemple("module_outils"),
		lien("tuto_module", "Le tutoriel pas à pas, avec le script serveur qui utilise ce module"),
		h("Les erreurs fréquentes"),
		p("**Mon module ne fait rien** : c'est normal ! Un module ne s'exécute jamais tout seul. Il faut qu'un script serveur ou local appelle ses fonctions ou lise ses valeurs."),
		p("**Module ou fonction introuvable** : les noms doivent être écrits exactement pareil des deux côtés, majuscules comprises : `soignerJoueur` et `SoignerJoueur` sont deux noms différents. Vérifie aussi que le Folder du module porte bien le nom écrit dans la case « module », et qu'aucun autre objet ne porte le même nom."),
		p("**« le joueur » est vide dans le module** : une fonction ne sait pas quel événement l'a lancée. Envoie-lui le joueur : glisse « le joueur » dans une case de « appeler la fonction … », puis utilise « paramètre … » dans la fonction."),
		p("**« renvoyer … » ou « paramètre … » hors d'une fonction** : ces blocs doivent être accrochés sous « Définir la fonction … ». Le détecteur d'erreurs les signale en rouge."),
		p("**Un paramètre qui vaut « rien »** : le nom écrit dans « paramètre … » doit être l'un de ceux de « Définir la fonction … », et le script qui appelle doit remplir la case correspondante."),
		p("**Deux fonctions avec le même nom** : la seconde remplacerait la première. Donne un nom différent à chaque fonction."),
		p("**Un script local ne trouve pas le module** : le module est sans doute rangé dans ServerScriptService ou ServerStorage. Déplace-le dans ReplicatedStorage."),
		p("**Des événements dans un module** : « Quand un joueur rejoint la partie » et les autres événements ne démarrent que quand un script charge le module. Garde plutôt les événements dans tes scripts serveur ou locaux, et le module pour les fonctions et les valeurs."),
		attention("Après avoir modifié un module, clique sur **Enregistrer** : les scripts qui l'utilisent prendront la nouvelle version au prochain test."),
		lien("tuto_module", "Tutoriel : une boîte à outils avec un module"),
		lien("cat_modules", "Tous les blocs « Modules »"),
		lien("serveur_local", "Script serveur, local ou module ?"),
	},
}

---------------------------------------------------------------------------
-- Studio d'interface (version 2.1.0, SPEC §21)
---------------------------------------------------------------------------

local studioInterface = {
	id = "studio_interface",
	title = "Le Studio d'interface",
	summary = "Dessine les écrans de ton jeu (menu, HUD, boutique…) dans l'onglet Interface, puis fais-les réagir avec les blocs posés juste en dessous.",
	body = {
		p("Un **écran**, c'est tout ce qui s'affiche par-dessus le jeu : un menu avec un bouton **Jouer**, la barre de vie, le compteur de pièces, une boutique, un message de victoire… Dans Roblox, chaque écran est un `ScreenGui` rangé dans **StarterGui** : chaque joueur en reçoit une copie quand il arrive dans la partie."),
		p("Blocs FR a un atelier rien que pour ça : le **Studio d'interface**. Tu dessines tes écrans à la souris, et juste en dessous tu poses les blocs qui les font réagir."),
		h("Les onglets Blocs et Interface"),
		p("En haut de l'éditeur, à côté du logo, deux onglets : **Blocs** (l'éditeur de scripts habituel) et **Interface** (le Studio). Passer de l'un à l'autre ne perd rien : chaque onglet garde son projet, même s'il n'est pas encore enregistré."),
		h("Ce que tu vois"),
		p("**À gauche** : les **Éléments** (8 tuiles à glisser), les **Modèles d'interface** (8 écrans tout prêts) et les **Calques** (la liste de tous les éléments de l'écran, rangés les uns dans les autres ; clique sur ▼ pour replier un cadre)."),
		p("**Au milieu, en haut** : l'**aperçu** de l'écran, dans un cadre d'**Ordinateur 16:9**, de **Tablette 4:3** ou de **Téléphone**. Vérifie que ton écran reste beau sur les trois : beaucoup de joueurs Roblox jouent sur téléphone !"),
		p("**Au milieu, en bas** : la zone **Blocs de l'écran**, avec sa palette et sa zone de travail. Ce sont les blocs de cet écran : ils le font réagir pendant le jeu."),
		p("**À droite** : les **Propriétés** de l'élément choisi (ou de l'écran lui-même quand rien n'est choisi)."),
		h("Ton premier écran"),
		etapes({
			"Clique sur l'onglet **Interface**.",
			"Choisis **Nouvel écran vide**, ou clique sur un modèle pour partir d'un écran déjà dessiné.",
			"Glisse la tuile **Bouton** sur l'aperçu : un bouton vert apparaît là où tu l'as lâché.",
			"Double-clique dessus et écris `JOUER`.",
			"À droite, dans **Nom**, écris `Jouer` : c'est le nom que les blocs utiliseront.",
			"Change ses couleurs dans **Style**, puis clique sur **Enregistrer l'écran** dans la barre du haut.",
			"L'écran apparaît dans **StarterGui** (Explorateur). Clique sur **Jouer** dans Studio : ton bouton est à l'écran !",
		}),
		h("Les éléments"),
		p("**Cadre** : un rectangle (souvent arrondi) qui sert de fond ou qui regroupe d'autres éléments. Lâche un élément sur un cadre pour le ranger dedans : il bougera avec lui."),
		p("**Texte** : un titre, un nombre de pièces, une phrase… **Bouton** : on clique dessus ; avec un **relief 3D** et l'effet **rebond**, il grossit sous la souris et s'enfonce quand on appuie. **Image** : une image Roblox (`rbxassetid://…`)."),
		p("**Barre** : une jauge qui se remplit (vie, expérience, chargement). **Champ** : une case où le joueur écrit (un pseudo, un code secret). **Liste** et **Grille** : rangent leurs éléments tout seuls, les uns sous les autres ou en cases (un inventaire, une boutique)."),
		h("Placer et régler les éléments"),
		p("**Clique** sur un élément pour le choisir, **glisse**-le pour le déplacer, tire une des **8 poignées** pour changer sa taille (avec **Maj**, il garde ses proportions). Des **lignes roses** apparaissent quand il est aligné avec le centre ou les bords d'un autre élément : lâche-le à ce moment-là pour un écran bien rangé. Sa taille s'affiche en pixels, sous la forme « L × H »."),
		p("Le **clic droit** sur un élément (dans l'aperçu ou dans les Calques) propose : Couper, Copier, Coller, Dupliquer, Sélectionner uniquement cet élément, Renommer…, Mettre devant, Mettre derrière, Disposition (centrer, tout devant…), Visible au démarrage, **Blocs de cet élément**, Ouvrir dans le wiki et Supprimer. Sur un bouton, **Ajouter un script au clic** crée tout de suite le bloc « Quand le bouton … est cliqué »."),
		h("Les propriétés"),
		p("**Texte** : le texte, la police (FredokaOne, LuckiestGuy, Bangers…), sa taille, sa couleur, un contour et l'alignement. **Style** : la couleur de fond, un **dégradé** avec une 2e couleur, la transparence, l'arrondi des coins, le contour et le **relief 3D**. **Position et taille** : X, Y, L, H (en pixels d'un écran de 1280 × 720) et l'**Ancre** (le point de l'élément qui reste fixe quand l'écran du joueur change de taille)."),
		p("Selon le type d'élément : la valeur et la couleur d'une **barre**, l'id d'une **image**, le texte d'aide d'un **champ**, la direction ou les colonnes d'une **liste** ou d'une **grille**, et l'**effet** d'un bouton (rebond ou aucun)."),
		p("Quand rien n'est choisi, ce sont les propriétés de l'**écran** : son nom, **Visible au démarrage** (non pour une boutique qui s'ouvre plus tard), **Garder après la mort** et l'**Ordre d'affichage** (le plus grand passe devant les autres écrans)."),
		attention("Le **nom** d'un élément compte beaucoup : c'est lui que les blocs utilisent (« Quand le bouton Jouer est cliqué »). Donne à tes éléments des noms clairs et différents. Si tu renommes un élément plus tard, le détecteur d'erreurs te montre les blocs qui utilisent encore l'ancien nom."),
		h("Les modèles d'interface"),
		p("Huit écrans tout prêts, dans le style des jeux Roblox, avec leurs blocs déjà posés : **Menu principal**, **HUD vie + pièces**, **Boutique**, **Dialogue PNJ**, **Notifications**, **Écran de chargement**, **Paramètres** et **Victoire**. Change les textes et les couleurs : c'est ton écran !"),
		p("Clique sur un modèle pour créer un nouvel écran avec lui. Si un écran est déjà ouvert, un menu te propose aussi d'ajouter les éléments du modèle à cet écran (sans ses blocs)."),
		astuce("La barre du haut a un menu **Écran : … ▼** : changer d'écran, **Nouvel écran**, **Nouvel écran depuis un modèle**, **Renommer l'écran…** et **Supprimer l'écran…**."),
		h("Aperçu et enregistrement"),
		p("Le bouton **Aperçu** rend l'écran vivant : les boutons réagissent à la souris comme dans le jeu (les scripts, eux, ne tournent que quand tu cliques sur **Jouer** dans Studio). Clique encore sur **Aperçu** pour revenir au dessin."),
		p("**Enregistrer l'écran** crée (ou met à jour) le ScreenGui dans StarterGui, avec le script de ses blocs (`BlocsLocal`). « ● Non enregistré » reste affiché tant qu'il reste des changements. Si tu changes d'écran sans enregistrer, Blocs FR te demande : **Enregistrer**, **Ne pas enregistrer** ou **Annuler**."),
		p("Les boutons **Annuler** et **Refaire** de la barre du haut agissent sur ce que tu as modifié en dernier : le dessin de l'écran ou ses blocs."),
		astuce("Sélectionne dans l'Explorateur un écran fait avec Blocs FR (dans StarterGui) : il s'ouvre dans le Studio."),
		lien("blocs_ecran", "Les blocs sous l'écran"),
		lien("tuto_menu", "Tutoriel : un menu qui marche"),
		lien("tuto_hud", "Tutoriel : afficher les pièces et la vie (HUD)"),
		lien("cat_interface", "Tous les blocs « Interface »"),
	},
}

local blocsEcran = {
	id = "blocs_ecran",
	title = "Les blocs sous l'écran",
	summary = "Sous l'aperçu d'un écran, ses propres blocs : « Quand le bouton Jouer est cliqué → cacher l'écran Menu avec fondu ».",
	body = {
		p("Sous l'aperçu, la zone **Blocs de l'écran « Menu »** contient les blocs de **cet écran**. Ensemble, ils forment son script local (`BlocsLocal`, rangé dans le ScreenGui à l'enregistrement). Ils utilisent directement les boutons, les textes et les barres que tu as dessinés, par leur nom."),
		bloc("gui_quand_clic"),
		bloc("gui_cacher_ecran"),
		h("Ton premier bouton qui marche"),
		etapes({
			"Dans l'aperçu, clique sur ton bouton `Jouer`.",
			"Dans les **Propriétés**, clique sur le bouton **Ajouter un script au clic** : le bloc « Quand le bouton Jouer est cliqué » apparaît dans la zone du bas.",
			"Dans la palette de la zone, ouvre la catégorie **Interface** et accroche « cacher l'écran … avec … » sous l'événement.",
			"Choisis ton écran dans son menu ▼, puis l'effet **fondu**.",
			"Clique sur **Enregistrer l'écran**, puis sur **Jouer** dans Studio, et clique sur ton bouton !",
		}),
		exemple("menu_jouer"),
		h("Choisir un élément"),
		p("Les cases des blocs Interface ont un menu ▼ avec les éléments de tes écrans : d'abord celui que tu dessines (même pas encore enregistré), puis les écrans déjà enregistrés. **Autre nom…** permet d'écrire un nom à la main. Si deux écrans ont un élément du même nom, le menu propose « Écran/Élément », par exemple `Boutique/Fermer`."),
		h("Les blocs et les éléments se répondent"),
		p("Choisis un élément dans l'aperçu : les blocs qui l'utilisent sont entourés de **cyan** dans la zone du bas, et les Propriétés les listent dans **Blocs de cet élément** (clique pour y aller). L'aperçu affiche aussi une pastille « ◆ 2 scripts » sur l'élément. Dans l'autre sens, passe la souris sur un bloc : l'élément qu'il utilise brille dans l'aperçu."),
		h("La zone des blocs"),
		p("Glisse la barre entre l'aperçu et la zone pour donner plus de place à l'un ou à l'autre, clique sur l'en-tête **▼ Blocs de l'écran** pour la replier, ou utilise **Agrandir** (55 %, 25 %, 80 % de place pour l'aperçu). L'en-tête montre aussi où est rangé le script, s'il y a des problèmes, et un bouton **Voir le code**."),
		h("Quelques blocs utiles"),
		bloc("gui_afficher_ecran"),
		bloc("gui_texte"),
		bloc("gui_barre"),
		bloc("gui_animer"),
		bloc("gui_notification"),
		p("Il y a aussi « Quand la souris entre sur … » (pour faire grossir un bouton survolé), « Quand le texte de … est validé » (le joueur appuie sur Entrée dans un champ), « afficher le grand message … », « afficher la vie dans la barre … », « afficher la statistique … dans … », et les valeurs « texte de … », « l'écran … est ouvert » et « … est visible »."),
		h("Depuis un script serveur"),
		p("Les blocs Interface (sauf les trois événements « Quand … ») marchent aussi dans un **script serveur**, sous un événement qui donne un joueur : ils agissent sur l'écran de **ce** joueur. Par exemple, dans la ligne d'arrivée d'un obby : « Quand un personnage touche cet objet » puis « afficher l'écran Victoire avec zoom »."),
		attention("Dans un script serveur, sous « Quand ce script démarre », aucun joueur n'est concerné : le bloc ne sait pas à qui afficher l'écran. Le détecteur d'erreurs te prévient. Les événements de clic, de survol et de texte validé ne marchent que dans un script local, comme les blocs sous un écran."),
		exemple("hud_pieces_vie"),
		lien("studio_interface", "Le Studio d'interface"),
		lien("tuto_menu", "Tutoriel : un menu qui marche"),
		lien("cat_interface", "Tous les blocs « Interface »"),
	},
}

---------------------------------------------------------------------------
-- Nouveautés (id « nouveautes » : ouverte par la carte de mise à jour et le menu « ? »)
---------------------------------------------------------------------------

local nouveautes = {
	id = "nouveautes",
	title = "Nouveautés",
	summary = "Tout ce qui a changé dans chaque version de Blocs FR, de la plus récente à la plus ancienne.",
	body = {
		h("Version 2.1.0"),
		p("Une très grosse mise à jour, faite à partir de tes idées !"),
		p("**Studio d'interface** : un nouvel onglet **Interface** pour dessiner les écrans de ton jeu (menu, HUD, boutique, dialogue, victoire…) avec 8 modèles prêts à l'emploi, et les **blocs de l'écran** posés juste en dessous pour le faire réagir."),
		lien("studio_interface", "Le Studio d'interface"),
		p("**Nouvelles catégories de blocs** : **Interface** (20 blocs : afficher ou cacher un écran avec un effet, changer un texte, remplir une barre, notifications, grand message…), **Caméra** (19 blocs : modes de caméra, cinématiques, tremblements, flou, bandes de cinéma…) et **Effets** (13 blocs : particules, explosions, traînées, rayons, auras, chiffres de dégâts…). Il y a maintenant **15 catégories**."),
		lien("camera", "La caméra"),
		lien("effets", "Les effets visuels (VFX)"),
		p("**28 nouveaux systèmes tout prêts** : sprint, double saut, point de sauvegarde, téléporteur, pièce à ramasser, générateur, porte automatique, plateformes mobiles et piégées, tapis roulant, trampoline, zone de soin, cycle jour/nuit, sauvegarde des statistiques, minuteur à l'écran, bouton d'achat, brique mortelle, objet qui flotte, rotation, ascenseur, chronomètre de course, lave qui monte, zones de vitesse et de super saut, porte VIP, familier, PNJ qui réapparaît et butin. Tous les blocs tout prêts ont aussi été **optimisés** pour que ton jeu reste fluide."),
		lien("toutprets_systemes", "Les systèmes tout prêts"),
		p("**Modèles** : des scripts entiers à glisser depuis la palette (obby complet, combat à l'épée, PNJ ennemi, cinématique, bouton d'achat…)."),
		lien("modeles_scripts", "Les modèles"),
		p("**Prévisualiseur de hitbox** : vois ta hitbox en 3D sur un mannequin R6, R15 ou ton propre modèle, et lance une simulation : « TOUCHÉ ! LET'S GO » ou « RATÉ… BOF »."),
		lien("hitbox", "Le prévisualiseur de hitbox"),
		p("**Explique-moi ce script** : le bouton **Expliquer** raconte en français ce que fait ton script, étape par étape."),
		p("**Notes** sur la zone de travail (« ici, la porte s'ouvre… »), qui deviennent des commentaires dans le code. **Lignes entre les blocs** : les messages et les fonctions de module sont reliés automatiquement, et tu peux tracer tes propres lignes."),
		lien("notes", "Les notes"),
		lien("lignes", "Les lignes entre les blocs"),
		p("**Clic droit comme sur Windows** : des menus partout (bloc, fond, note, palette, élément d'interface), la **sélection** de plusieurs blocs, couper / copier / coller et des raccourcis clavier."),
		lien("menus", "Le clic droit et la sélection"),
		p("**Désactiver un bloc** pour tester sans le supprimer, **favoris**, **copier-coller** entre scripts, **code de partage** pour envoyer un script à un ami, **brouillon automatique** et **mini-carte**."),
		lien("desactiver", "Désactiver un bloc"),
		lien("outils", "Favoris, copier-coller, partage, brouillon et mini-carte"),
		p("**Paramètres** : thèmes (sombre, nuit, clair, contraste élevé), couleur principale, taille de l'interface, style et couleurs des blocs, grille, aimant, palette, animations, notes, mannequin 3D, sauvegarde automatique…"),
		lien("parametres", "Les paramètres"),
		p("**Animations** : l'éditeur bouge en douceur (menus, panneaux, blocs qui s'aimantent…). Tu peux les éteindre dans le menu **?** avec **Animations de l'éditeur**."),
		p("**Notification de mise à jour** : quand une nouvelle version de Blocs FR sort, une petite carte apparaît en bas à droite de l'éditeur. Pour l'installer : **Plugins → Gérer les plugins → Mettre à jour**, puis rouvre ta place."),
		p("**Détecteur d'erreurs** : il vérifie aussi les noms d'écrans et d'éléments, les blocs Caméra dans un script serveur, la sauvegarde des statistiques en double, les noms d'objets écrits dans les blocs tout prêts et les blocs désactivés."),
		p("**Wiki** : toutes ces pages, de nouveaux tutoriels (un menu qui marche, un HUD, une cinématique) et de nouveaux exemples."),
		h("Version 2.0.0"),
		p("**Wiki intégré** dans sa propre fenêtre, avec la recherche, des tutoriels, des exemples à charger et une fiche pour chaque bloc."),
		p("**Détecteur d'erreurs** : il vérifie tes blocs pendant que tu travailles, et retrouve le bloc qui a planté pendant un test."),
		p("**Tout prêts** : des mécaniques de jeu complètes en un seul bloc (attaque avec animation et hitbox, projectile, dash, barre de vie, PNJ ennemi…)."),
		p("**Scripts modules** : des boîtes à outils de fonctions et de valeurs partagées par tous tes scripts."),
		p("**Nouvel aspect** de l'éditeur et un logo tout neuf."),
		h("Version 1"),
		p("Le tout premier éditeur de blocs de Roblox Studio entièrement en français : 10 catégories de blocs, scripts serveur et locaux, et enregistrement du script dans l'objet choisi."),
		astuce("Une nouvelle version est sortie ? La carte « Mise à jour disponible » te le dit. **Plus tard** la cache pour cette version, et le réglage **Mises à jour** des Paramètres arrête complètement la vérification."),
	},
}

