}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- Avertissement en français, au plus une fois toutes les 5 s pour un même message (un bloc dans
	-- une boucle ne remplit pas la sortie). Mémoire commune aux scripts du même côté (shared).
	_vfxAvertir = {
		deps = { "_avertir" },
		services = {},
		code = [[
local function _vfxAvertir(message)
	local etat = shared.BlocsFR_VFX
	if type(etat) ~= "table" then
		etat = {}
		shared.BlocsFR_VFX = etat
	end
	local cle = tostring(message)
	local maintenant = os.clock()
	local dernier = etat[cle]
	if type(dernier) == "number" and maintenant - dernier < 5 then
		return
	end
	etat[cle] = maintenant
	_avertir(cle)
end]],
	},

	-- Crée un objet d'effet : nom, attribut « BlocsFR_VFX », propriétés (une propriété refusée est
	-- ignorée, jamais d'erreur), puis le parent en dernier. Renvoie l'objet ou nil.
	_vfxCreer = {
		deps = {},
		services = {},
		code = [[
local function _vfxCreer(classe, nom, proprietes, parent)
	local ok, objet = pcall(Instance.new, classe)
	if not ok or typeof(objet) ~= "Instance" then
		return nil
	end
	objet.Name = nom
	objet:SetAttribute("BlocsFR_VFX", true)
	if type(proprietes) == "table" then
		for propriete, valeur in pairs(proprietes) do
			pcall(function()
				objet[propriete] = valeur
			end)
		end
	end
	if parent ~= nil then
		local place = pcall(function()
			objet.Parent = parent
		end)
		if not place then
			objet:Destroy()
			return nil
		end
	end
	return objet
end]],
	},

	-- Détruit les effets Blocs FR d'un objet (lui-même et ses descendants) dont le nom commence par
	-- « prefixe » (nil = tous). Les points d'attache d'un rayon ou d'une traînée partent avec eux.
	_vfxRetirer = {
		deps = {},
		services = {},
		code = [[
local function _vfxRetirer(objet, prefixe)
	if typeof(objet) ~= "Instance" then
		return
	end
	local liste = objet:GetDescendants()
	table.insert(liste, 1, objet)
	-- d'abord la liste (les liens d'un rayon sont lus avant toute destruction), puis on détruit
	local trouves = {}
	for _, d in ipairs(liste) do
		if d:GetAttribute("BlocsFR_VFX") == true and (prefixe == nil or string.sub(d.Name, 1, #prefixe) == prefixe) then
			table.insert(trouves, d)
			if d:IsA("Beam") or d:IsA("Trail") then
				local a0, a1 = d.Attachment0, d.Attachment1
				if a0 ~= nil and a0:GetAttribute("BlocsFR_VFX") == true then
					table.insert(trouves, a0)
				end
				if a1 ~= nil and a1:GetAttribute("BlocsFR_VFX") == true then
					table.insert(trouves, a1)
				end
			end
		end
	end
	for _, d in ipairs(trouves) do
		pcall(d.Destroy, d)
	end
end]],
	},

	-- La partie où poser un effet : la partie elle-même, la partie racine d'un personnage ou la
	-- partie principale d'un modèle. Un joueur sans personnage est attendu 5 s au plus.
	-- Renvoie la partie et l'objet choisi, ou nil + avertissement.
	_vfxPartie = {
		deps = { "_obj", "_partie", "_vfxAvertir" },
		services = {},
		code = [[
local function _vfxPartie(valeur, action)
	if valeur == nil then
		_vfxAvertir("« " .. action .. " » : la cible est vide (rien). « le personnage » et « la partie touchée » n'existent que sous un événement qui les donne (par exemple « Quand un personnage apparaît » ou « Quand cet objet est touché »).")
		return nil, nil
	end
	if typeof(valeur) == "Instance" and valeur:IsA("Player") and valeur.Character == nil then
		-- le personnage n'est peut-être pas encore apparu : on l'attend un peu
		local attente = 0
		while valeur.Character == nil and valeur.Parent ~= nil and attente < 5 do
			attente += task.wait(0.1)
		end
		if valeur.Character == nil then
			_vfxAvertir("« " .. action .. " » : le personnage de « " .. valeur.Name .. " » n'est pas là (pas encore apparu ?).")
			return nil, nil
		end
	end
	local objet = _obj(valeur)
	if typeof(objet) == "Instance" and objet:IsA("Humanoid") then
		objet = objet.Parent
	end
	if typeof(objet) ~= "Instance" then
		_vfxAvertir("« " .. action .. " » : objet introuvable (" .. tostring(valeur) .. ").")
		return nil, nil
	end
	if objet == game or objet == workspace or objet.Parent == game or objet:IsA("Terrain") then
		_vfxAvertir("« " .. action .. " » : choisis une partie, un modèle ou un personnage (pas « " .. objet.Name .. " »).")
		return nil, nil
	end
	local partie = nil
	if objet:IsA("BasePart") then
		partie = objet
	elseif objet:IsA("Attachment") then
		partie = objet:FindFirstAncestorWhichIsA("BasePart")
	else
		partie = _partie(objet)
	end
	if partie == nil then
		_vfxAvertir("« " .. action .. " » : « " .. objet.Name .. " » ne contient aucune partie.")
		return nil, objet
	end
	return partie, objet
end]],
	},

	-- Taille d'un objet en studs (son plus grand côté, boîte englobante pour un modèle), de 1 à 40
	_vfxTaille = {
		deps = {},
		services = {},
		code = [[
local function _vfxTaille(partie, objet)
	local taille = partie.Size
	if typeof(objet) == "Instance" and objet:IsA("Model") then
		local ok, _, dimensions = pcall(function()
			return objet:GetBoundingBox()
		end)
		if ok and typeof(dimensions) == "Vector3" then
			taille = dimensions
		end
	end
	return math.clamp(math.max(taille.X, taille.Y, taille.Z), 1, 40)
end]],
	},

	-- Réglages d'un type de particules (aura = false) ou d'aura (aura = true), pour un objet de
	-- « taille » studs. Renvoie { cle, lumiere = Color3, duree = vie max des particules (s),
	-- objets = { { classe, propriétés, réglages d'explosion|nil } }, eclairage, eclat, scintille }.
	-- Le nom est accepté avec ou sans accents ni « s » final ; un nom inconnu donne le premier type.
	_vfxPreset = {
		deps = { "_vfxAvertir" },
		services = {},
		code = [[
local function _vfxPreset(nom, taille, aura)
	taille = tonumber(taille) or 4
	local function seq(...)
		local valeurs = { ... }
		local points = {}
		for i = 1, #valeurs - 1, 2 do
			table.insert(points, NumberSequenceKeypoint.new(valeurs[i], valeurs[i + 1]))
		end
		return NumberSequence.new(points)
	end
	local function plage(mini, maxi)
		return NumberRange.new(mini, maxi)
	end
	local function rgb(r, v, b)
		return Color3.fromRGB(r, v, b)
	end
	local function degrade(debut, fin)
		return ColorSequence.new(debut, fin)
	end
	-- émetteur avec la texture par défaut de Roblox ; « rafale » = réglages en plus pour une explosion
	local function emetteur(proprietes, rafale)
		if proprietes.LightInfluence == nil then
			proprietes.LightInfluence = 0
		end
		if proprietes.Rotation == nil then
			proprietes.Rotation = plage(0, 360)
		end
		return { "ParticleEmitter", proprietes, rafale }
	end
	local function braises(debit, vitesse)
		return emetteur({
			Color = degrade(rgb(255, 225, 130), rgb(255, 80, 20)),
			LightEmission = 1,
			Size = seq(0, 0.22, 1, 0),
			Transparency = seq(0, 0, 0.8, 0.2, 1, 1),
			Lifetime = plage(0.8, 1.5),
			Speed = plage(vitesse * 0.5, vitesse),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, 5, 0),
			Drag = 0.6,
			Rate = debit,
			RotSpeed = plage(-90, 90),
		}, { Speed = plage(8, 16), Drag = 3 })
	end
	local function flammes(force)
		return { "Fire", {
			Size = math.clamp(taille * force, 2, 30),
			Heat = math.clamp(taille * 2, 6, 25),
			Color = rgb(255, 130, 40),
			SecondaryColor = rgb(170, 60, 20),
		} }
	end
	local function fumee(teinte, opacite, montee, force)
		return { "Smoke", {
			Color = teinte,
			Opacity = opacite,
			RiseVelocity = montee,
			Size = math.clamp(taille * force, 0.5, 10),
		}, { Opacity = math.min(opacite * 1.5, 1), RiseVelocity = math.max(montee, 0) + 4 } }
	end
	local function zaps(debit, vitesse)
		return emetteur({
			Color = degrade(rgb(235, 250, 255), rgb(80, 170, 255)),
			LightEmission = 1,
			Size = seq(0, 0.5, 1, 0.15),
			Squash = seq(0, 2.5, 1, 2.5),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Transparency = seq(0, 0, 1, 0.5),
			Lifetime = plage(0.06, 0.16),
			Speed = plage(vitesse * 0.5, vitesse),
			SpreadAngle = Vector2.new(180, 180),
			Rate = debit,
			ZOffset = 0.5,
		}, { Speed = plage(25, 45) })
	end
	local particules = {
		etincelles = function()
			return {
				lumiere = rgb(255, 180, 70),
				duree = 0.8,
				objets = {
					emetteur({
						Color = degrade(rgb(255, 245, 180), rgb(255, 110, 20)),
						LightEmission = 1,
						Size = seq(0, 0.3, 1, 0),
						Transparency = seq(0, 0, 0.75, 0.15, 1, 1),
						Lifetime = plage(0.35, 0.7),
						Speed = plage(8, 15),
						SpreadAngle = Vector2.new(50, 50),
						Acceleration = Vector3.new(0, -35, 0),
						Drag = 1.5,
						Rate = 40,
						Orientation = Enum.ParticleOrientation.VelocityParallel,
						Squash = seq(0, 1.4, 1, 1.4),
					}, { Speed = plage(14, 26), Drag = 3 }),
				},
			}
		end,
		feu = function()
			return {
				lumiere = rgb(255, 140, 40),
				duree = 1.6,
				eclairage = true,
				objets = { flammes(1), braises(14, 4) },
			}
		end,
		fumee = function()
			return {
				lumiere = rgb(200, 200, 205),
				duree = 5,
				objets = { fumee(rgb(150, 150, 155), 0.3, 4, 0.5) },
			}
		end,
		magie = function()
			return {
				lumiere = rgb(170, 110, 255),
				duree = 1.8,
				objets = {
					emetteur({
						Color = degrade(rgb(225, 160, 255), rgb(90, 190, 255)),
						LightEmission = 1,
						Size = seq(0, 0.1, 0.25, 0.45, 1, 0),
						Transparency = seq(0, 0.6, 0.2, 0, 0.8, 0.2, 1, 1),
						Lifetime = plage(1, 1.8),
						Speed = plage(0.5, 2),
						SpreadAngle = Vector2.new(180, 180),
						Acceleration = Vector3.new(0, 1.5, 0),
						Drag = 1,
						Rate = 25,
						RotSpeed = plage(-120, 120),
					}, { Speed = plage(6, 12), Drag = 4 }),
				},
			}
		end,
		poussiere = function()
			return {
				lumiere = rgb(210, 180, 130),
				duree = 5,
				objets = {
					fumee(rgb(190, 165, 125), 0.2, 1, 0.6),
					emetteur({
						Color = degrade(rgb(225, 200, 160), rgb(170, 140, 100)),
						LightEmission = 0.2,
						LightInfluence = 0.6,
						Size = seq(0, 0.12, 1, 0.08),
						Transparency = seq(0, 1, 0.2, 0.3, 0.8, 0.5, 1, 1),
