local helpers = {
	-- Toutes les parties d'un objet ; avertit si l'objet est introuvable ou vide.
	-- (aussi utilisée par Defs_Apparence)
	_partiesOuAvertir = {
		deps = { "_obj", "_parties", "_avertir" },
		services = {},
		code = [[
local function _partiesOuAvertir(valeur, action)
	local parties = _parties(valeur)
	if #parties == 0 then
		local objet = _obj(valeur)
		if objet == nil then
			_avertir("« " .. tostring(action) .. " » : objet introuvable.")
		else
			_avertir("« " .. tostring(action) .. " » : « " .. objet.Name .. " » ne contient aucune partie.")
		end
	end
	return parties
end]],
	},

	-- Vrai pour les objets qu'il ne faut jamais détruire / déplacer (services, Workspace, Terrain…)
	_estProtege = {
		deps = {},
		services = {},
		code = [[
local function _estProtege(objet)
	if objet == game or objet == workspace or objet.Parent == game then
		return true
	end
	return objet:IsA("Terrain") or objet:IsA("Camera") or objet:IsA("Player")
end]],
	},

	_deplacerDe = {
		deps = { "_pivot", "_setPivot", "_avertir" },
		services = {},
		code = [[
local function _deplacerDe(valeur, x, y, z)
	local cf = _pivot(valeur)
	if cf == nil then
		_avertir("« déplacer » : objet introuvable.")
		return
	end
	_setPivot(valeur, cf + Vector3.new(x, y, z))
end]],
	},

	_teleporterObjet = {
		deps = { "_pivot", "_setPivot", "_avertir" },
		services = {},
		code = [[
local function _teleporterObjet(valeur, x, y, z)
	local cf = _pivot(valeur)
	if cf == nil then
		_avertir("« téléporter » : objet introuvable.")
		return
	end
	_setPivot(valeur, cf.Rotation + Vector3.new(x, y, z))
end]],
	},

	-- Boîte englobante (CFrame, taille) d'une partie ou d'un modèle, ou nil
	_boiteObjet = {
		deps = { "_obj", "_partie" },
		services = {},
		code = [[
local function _boiteObjet(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		return nil, nil
	end
	if objet:IsA("BasePart") then
		return objet.CFrame, objet.Size
	end
	if objet:IsA("Model") then
		local ok, cf, taille = pcall(function()
			return objet:GetBoundingBox()
		end)
		if ok and typeof(cf) == "CFrame" and typeof(taille) == "Vector3" and taille.Magnitude > 0 then
			return cf, taille
		end
	end
	local partie = _partie(objet)
	if partie then
		return partie.CFrame, partie.Size
	end
	return nil, nil
end]],
	},

	-- Demi-hauteur (selon l'axe vertical du monde) d'une boîte orientée
	_demiHauteur = {
		deps = {},
		services = {},
		code = [[
local function _demiHauteur(cf, taille)
	return 0.5 * (math.abs(cf.RightVector.Y) * taille.X + math.abs(cf.UpVector.Y) * taille.Y + math.abs(cf.LookVector.Y) * taille.Z)
end]],
	},

	_placerSur = {
		deps = { "_obj", "_pos", "_pivot", "_setPivot", "_boiteObjet", "_demiHauteur", "_avertir" },
		services = {},
		code = [[
local function _placerSur(valeur, cible)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« placer sur » : objet introuvable.")
		return
	end
	if _obj(cible) == objet then
		_avertir("« placer sur » : un objet ne peut pas être posé sur lui-même.")
		return
	end
	local cfObjet, tailleObjet = _boiteObjet(objet)
	local pivot = _pivot(objet)
	if cfObjet == nil or pivot == nil then
		_avertir("« placer sur » : « " .. objet.Name .. " » ne contient aucune partie.")
		return
	end
	local centreCible = nil
	local hautCible = nil
	local cfCible, tailleCible = _boiteObjet(cible)
	if cfCible then
		centreCible = cfCible.Position
		hautCible = centreCible.Y + _demiHauteur(cfCible, tailleCible)
	elseif typeof(cible) == "Vector3" or typeof(cible) == "CFrame" then
		centreCible = _pos(cible)
		hautCible = centreCible.Y
	else
		_avertir("« placer sur » : cible introuvable.")
		return
	end
	local nouveauCentre = Vector3.new(centreCible.X, hautCible + _demiHauteur(cfObjet, tailleObjet), centreCible.Z)
	_setPivot(objet, pivot + (nouveauCentre - cfObjet.Position))
end]],
	},

	_tournerDe = {
		deps = { "_pivot", "_setPivot", "_avertir" },
		services = {},
		code = [[
local function _tournerDe(valeur, x, y, z)
	local cf = _pivot(valeur)
	if cf == nil then
		_avertir("« tourner » : objet introuvable.")
		return
	end
	_setPivot(valeur, cf * CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)))
end]],
	},

	_orienterVers = {
		deps = { "_obj", "_pivot", "_pos", "_setPivot", "_avertir" },
		services = {},
		code = [[
local function _orienterVers(valeur, cible)
	local cf = _pivot(valeur)
	local vise = _pos(cible)
	if cf == nil or vise == nil then
		_avertir("« orienter vers » : objet ou cible introuvable.")
		return
	end
	local objet = _obj(valeur)
	if objet and objet:FindFirstChildOfClass("Humanoid") then
		-- un personnage reste debout : il ne tourne qu'à l'horizontale
		vise = Vector3.new(vise.X, cf.Position.Y, vise.Z)
	end
	local direction = vise - cf.Position
	if direction.Magnitude < 0.001 then
		return
	end
	local haut = Vector3.yAxis
	if math.abs(direction.Unit.Y) > 0.999 then
		haut = Vector3.zAxis
	end
	_setPivot(valeur, CFrame.lookAt(cf.Position, vise, haut))
end]],
	},

	-- Attend la fin d'une animation (Tween), avec une limite de temps de sécurité
	_attendreTween = {
		deps = {},
		services = {},
		code = [[
local function _attendreTween(tween, duree)
	local ecoule = 0
	local limite = duree + 2
	while tween.PlaybackState == Enum.PlaybackState.Begin
		or tween.PlaybackState == Enum.PlaybackState.Delayed
		or tween.PlaybackState == Enum.PlaybackState.Playing do
		if ecoule > limite then
			tween:Cancel()
			break
		end
		ecoule += task.wait()
	end
end]],
	},

	-- Fait glisser un objet (TweenService). relatif = true : de x, y, z ; sinon : vers x, y, z.
	-- Une partie est animée directement ; un modèle via une CFrameValue (PivotTo à chaque changement).
	-- Les assemblages non ancrés sont ancrés pendant le trajet (sinon la gravité leur donne de la
	-- vitesse et ils tombent d'un coup à l'arrivée), puis relâchés sans vitesse.
	_glisser = {
		deps = { "_obj", "_pivot", "_parties", "_attendreTween", "_avertir" },
		services = { "TweenService" },
		code = [[
local function _glisser(valeur, x, y, z, duree, relatif)
	local objet = _obj(valeur)
	if objet == nil or not objet:IsA("PVInstance") then
		_avertir("« faire glisser » : objet introuvable ou impossible à déplacer.")
		return
	end
	local depart = _pivot(objet)
	if depart == nil then
		_avertir("« faire glisser » : objet introuvable.")
		return
	end
	local arrivee = depart.Rotation + Vector3.new(x, y, z)
	if relatif then
		arrivee = depart + Vector3.new(x, y, z)
	end
	if not (duree > 0) then
		objet:PivotTo(arrivee)
		return
	end
	local relachees = {}
	local vues = {}
	for _, partie in ipairs(_parties(objet)) do
		local racine = partie.AssemblyRootPart
		if racine and not racine.Anchored and not vues[racine] then
			vues[racine] = true
			table.insert(relachees, racine)
		end
	end
	for _, racine in ipairs(relachees) do
		racine.Anchored = true
	end
	local info = TweenInfo.new(duree, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	if objet:IsA("BasePart") then
		local tween = TweenService:Create(objet, info, { CFrame = arrivee * objet.PivotOffset:Inverse() })
		tween:Play()
		_attendreTween(tween, duree)
	else
		local support = Instance.new("CFrameValue")
		support.Value = depart
		local connexion = support.Changed:Connect(function(cf)
			if objet.Parent then
				objet:PivotTo(cf)
			end
		end)
		local tween = TweenService:Create(support, info, { Value = arrivee })
		tween:Play()
		_attendreTween(tween, duree)
		connexion:Disconnect()
		support:Destroy()
		if objet.Parent and tween.PlaybackState == Enum.PlaybackState.Completed then
			objet:PivotTo(arrivee)
		end
	end
	for _, racine in ipairs(relachees) do
		if racine.Parent then
			racine.Anchored = false
		end
	end
	for _, racine in ipairs(relachees) do
		if racine.Parent then
			racine.AssemblyLinearVelocity = Vector3.zero
			racine.AssemblyAngularVelocity = Vector3.zero
		end
	end
end]],
	},

	_changerTaille = {
		deps = { "_obj", "_parties", "_avertir" },
		services = {},
		code = [[
local function _changerTaille(valeur, x, y, z)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« mettre la taille » : objet introuvable.")
		return
	end
	local partie = nil
	if objet:IsA("BasePart") then
		partie = objet
	else
		local parties = _parties(objet)
		if #parties == 0 then
			_avertir("« mettre la taille » : « " .. objet.Name .. " » ne contient aucune partie.")
			return
		elseif #parties > 1 then
			_avertir("« mettre la taille » : « " .. objet.Name .. " » contient plusieurs parties. Utilise « multiplier la taille » pour un modèle.")
			return
		end
		partie = parties[1]
	end
	local cf = partie.CFrame
	partie.Size = Vector3.new(math.max(x, 0.001), math.max(y, 0.001), math.max(z, 0.001))
	partie.CFrame = cf
end]],
	},

	_multiplierTaille = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _multiplierTaille(valeur, facteur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« multiplier la taille » : objet introuvable.")
		return
	end
	if not (facteur > 0) then
		_avertir("« multiplier la taille » : le nombre doit être plus grand que 0.")
		return
	end
	if objet:IsA("Model") then
		local ok, erreur = pcall(function()
			objet:ScaleTo(objet:GetScale() * facteur)
		end)
		if not ok then
			_avertir("Impossible de changer la taille de « " .. objet.Name .. " » : " .. tostring(erreur))
		end
		return
	end
	if objet:IsA("BasePart") then
		local cf = objet.CFrame
		objet.Size = objet.Size * facteur
		objet.CFrame = cf
		-- un maillage importé (SpecialMesh de type FileMesh) ne suit pas la taille de la partie
		for _, enfant in ipairs(objet:GetChildren()) do
			if enfant:IsA("SpecialMesh") and enfant.MeshType == Enum.MeshType.FileMesh then
				enfant.Scale = enfant.Scale * facteur
			end
		end
		return
	end
	_avertir("« multiplier la taille » : « " .. objet.Name .. " » n'est ni une partie ni un modèle.")
end]],
	},

	_ancrerObjet = {
		deps = { "_partiesOuAvertir" },
		services = {},
		code = [[
local function _ancrerObjet(valeur, etat)
	for _, partie in ipairs(_partiesOuAvertir(valeur, "ancrer")) do
		partie.Anchored = etat == true
	end
end]],
	},

	-- Le Humanoid d'un personnage remet sans cesse les collisions de son corps (tête, torse) :
	-- on prévient au lieu de laisser croire que le personnage peut traverser les murs.
	_collisionObjet = {
		deps = { "_obj", "_partiesOuAvertir", "_avertir" },
		services = {},
		code = [[
local function _collisionObjet(valeur, etat)
	for _, partie in ipairs(_partiesOuAvertir(valeur, "collision")) do
		partie.CanCollide = etat == true
	end
	local objet = _obj(valeur)
	if etat ~= true and objet and objet:IsA("Model") and objet:FindFirstChildOfClass("Humanoid") then
		_avertir("« collision » : un personnage reste solide (Roblox remet les collisions de son corps) ; rends plutôt l'obstacle non solide.")
	end
end]],
	},

	-- Roblox ne fait réapparaître un joueur qu'après la mort de son personnage : un personnage
	-- détruit ne reviendrait jamais. Il est donc éliminé à la place.
	-- Renvoie true si l'objet est le personnage (avec Humanoid) d'un joueur.
	_eliminerPersoJoueur = {
		deps = { "_avertir" },
		services = { "Players" },
		code = [[
local function _eliminerPersoJoueur(objet, action)
	if not objet:IsA("Model") or Players:GetPlayerFromCharacter(objet) == nil then
		return false
	end
	local h = objet:FindFirstChildOfClass("Humanoid")
	if h == nil then
		return false
	end
	if h.Health > 0 then
		h.Health = 0
		_avertir("« " .. action .. " » : le personnage d'un joueur n'est pas détruit (il ne réapparaîtrait jamais) ; il est éliminé à la place. Utilise plutôt « éliminer ».")
	end
	return true
end]],
	},

	-- Avant de détruire un objet : les sons « jouer le son » en cours dans l'objet sont déplacés
	-- à sa place (dans une Attachment du Terrain) pour finir de jouer au lieu de s'arrêter net.
	_libererSons = {
		deps = {},
		services = { "Debris" },
		code = [[
local function _libererSons(objet)
	for _, son in ipairs(objet:GetDescendants()) do
		if son:IsA("Sound") and son.Name == "BlocsFR_Son" and son.IsPlaying and son.Parent and son.Parent:IsA("BasePart") then
			local position = son.Parent.Position
			pcall(function()
				local attache = Instance.new("Attachment")
				attache.Name = "BlocsFR_Son"
				attache.Parent = workspace.Terrain
				attache.WorldPosition = position
				son.Parent = attache
				local reste = 30
				if son.TimeLength > 0 then
					reste = (son.TimeLength - son.TimePosition) / math.max(son.PlaybackSpeed, 0.01) + 1
				end
				Debris:AddItem(attache, math.max(reste, 0.5))
			end)
		end
	end
end]],
	},

	_detruire = {
		deps = { "_obj", "_estProtege", "_eliminerPersoJoueur", "_libererSons", "_avertir" },
		services = {},
		code = [[
local function _detruire(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« détruire » : objet introuvable.")
		return
	end
	if _estProtege(objet) then
		_avertir("« " .. objet.Name .. " » ne peut pas être détruit.")
		return
	end
	if _eliminerPersoJoueur(objet, "détruire") then
		return
	end
	_libererSons(objet)
	local ok, erreur = pcall(function()
		objet:Destroy()
	end)
	if not ok then
		_avertir("Impossible de détruire « " .. objet.Name .. " » : " .. tostring(erreur))
	end
end]],
	},

	_detruireApres = {
		deps = { "_obj", "_estProtege", "_eliminerPersoJoueur", "_libererSons", "_avertir" },
		services = { "Debris", "Players" },
		code = [[
local function _detruireApres(valeur, secondes)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« détruire après » : objet introuvable.")
		return
	end
	if _estProtege(objet) then
		_avertir("« " .. objet.Name .. " » ne peut pas être détruit.")
		return
	end
	local delai = tonumber(secondes) or 0
	if not (delai > 0) then
		delai = 0
	end
	task.delay(delai, function()
		if objet.Parent == nil then
			return
		end
		if _eliminerPersoJoueur(objet, "détruire après") then
			return
		end
		_libererSons(objet)
		pcall(function()
			objet:Destroy()
		end)
	end)
	-- sécurité : si ce script s'arrête avant la fin du délai, Debris détruit quand même l'objet
	-- (jamais le personnage d'un joueur : il ne réapparaîtrait plus)
	if not (objet:IsA("Model") and Players:GetPlayerFromCharacter(objet)) then
		Debris:AddItem(objet, delai + 1)
	end
end]],
	},

	-- Copie un objet dans le même parent (Workspace s'il n'en a pas) et renvoie la copie.
	-- Un modèle ou une partie rangés dans ServerStorage, ReplicatedStorage ou Lighting sont copiés
	-- dans Workspace : rangée à côté du modèle, la copie n'apparaîtrait jamais dans le jeu.
	-- La copie ne reprend pas le script en cours : sinon un objet qui se clone lui-même
	-- au démarrage se multiplierait à l'infini.
	_cloner = {
		deps = { "_obj", "_estProtege", "_avertir" },
		services = {},
		code = [[
local function _cloner(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« cloner » : objet introuvable.")
		return nil
	end
	if _estProtege(objet) then
		_avertir("« " .. objet.Name .. " » ne peut pas être cloné.")
		return nil
	end
	local scriptDedans = script:IsDescendantOf(objet)
	local archivableScript = script.Archivable
	local archivableObjet = objet.Archivable
	if scriptDedans then
		script.Archivable = false
	end
	objet.Archivable = true
	local ok, copie = pcall(function()
		return objet:Clone()
	end)
	objet.Archivable = archivableObjet
	if scriptDedans then
		script.Archivable = archivableScript
	end
	if not ok or copie == nil then
		_avertir("Impossible de cloner « " .. objet.Name .. " ».")
		return nil
	end
	local parent = objet.Parent
	if parent ~= nil and (copie:IsA("PVInstance") or copie:IsA("Folder")) then
		local service = parent
		while service.Parent ~= nil and service.Parent ~= game do
			service = service.Parent
		end
		if service:IsA("ServerStorage") or service:IsA("ReplicatedStorage") or service:IsA("Lighting") then
			parent = workspace
		end
	end
	copie.Parent = parent or workspace
	return copie
end]],
	},

	-- Partie principale d'un objet qui peut bouger (non ancrée), sinon nil + avertissement
	_partieMobile = {
		deps = { "_partie", "_avertir" },
		services = {},
		code = [[
local function _partieMobile(valeur, action)
	local partie = _partie(valeur)
	if partie == nil then
		_avertir("« " .. action .. " » : objet introuvable ou sans partie.")
		return nil
	end
	local racine = partie.AssemblyRootPart or partie
	if partie.Anchored or racine.Anchored then
		_avertir("« " .. action .. " » : « " .. partie.Name .. " » est ancré, il ne peut pas bouger. Utilise d'abord « ancrer … : non ».")
		return nil
	end
	return partie
end]],
	},

	_donnerVitesse = {
		deps = { "_partieMobile" },
		services = {},
		code = [[
local function _donnerVitesse(valeur, x, y, z)
	local partie = _partieMobile(valeur, "donner la vitesse")
	if partie == nil then
		return
	end
	partie.AssemblyLinearVelocity = Vector3.new(x, y, z)
end]],
	},

	_pousser = {
		deps = { "_partieMobile" },
		services = {},
		code = [[
local function _pousser(valeur, x, y, z)
	local partie = _partieMobile(valeur, "pousser")
	if partie == nil then
		return
	end
	partie:ApplyImpulse(Vector3.new(x, y, z) * partie.AssemblyMass)
end]],
	},

	_explosion = {
		deps = { "_pos", "_avertir" },
		services = { "Debris" },
		code = [[
local function _explosion(valeur, rayon)
	local position = _pos(valeur)
	if position == nil then
		_avertir("« explosion » : objet introuvable.")
		return
	end
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = math.max(tonumber(rayon) or 0, 0)
	explosion.Parent = workspace
	Debris:AddItem(explosion, 3)
end]],
	},

	-- Adresse d'un son : nombre -> "rbxassetid://<n>" ; texte déjà "rbxasset…" gardé tel quel
	_idSon = {
		deps = {},
		services = {},
		code = [[
local function _idSon(valeur)
	if type(valeur) == "number" then
		if valeur ~= valeur or valeur < 1 then
			return nil
		end
		return "rbxassetid://" .. string.format("%.0f", math.floor(valeur))
	end
	if type(valeur) ~= "string" then
		return nil
	end
	local texte = string.gsub(valeur, "%s", "")
	if texte == "" then
		return nil
	end
	if string.match(texte, "^%d+$") then
		return "rbxassetid://" .. texte
	end
	if string.find(texte, "^rbxasset") or string.find(texte, "^https?://") then
		return texte
	end
	local chiffres = string.match(texte, "(%d+)")
	if chiffres then
		return "rbxassetid://" .. chiffres
	end
	return nil
end]],
	},

	-- Joue un son dans la partie principale de l'objet (ou partout, dans SoundService)
	-- puis le supprime quand il est terminé.
	_jouerSon = {
		deps = { "_idSon", "_partie", "_avertir" },
		services = { "SoundService", "Debris" },
		code = [[
local function _jouerSon(son, valeur, volume)
	local id = _idSon(son)
	if id == nil then
		_avertir("« jouer le son » : son ou ID invalide (" .. tostring(son) .. ").")
		return
	end
	local s = Instance.new("Sound")
	s.Name = "BlocsFR_Son"
	s.SoundId = id
	s.Volume = math.clamp(tonumber(volume) or 1, 0, 10)
	s.Parent = _partie(valeur) or SoundService
	local function nettoyer()
		Debris:AddItem(s, 0.1)
	end
	s.Ended:Once(nettoyer)
	s.Stopped:Once(nettoyer)
	s:Play()
	task.spawn(function()
		local attente = 0
		while not s.IsLoaded and attente < 10 and s.Parent ~= nil do
			attente += task.wait(0.1)
		end
		if s.Parent == nil then
			return
		end
		if not s.IsLoaded then
			_avertir("Le son « " .. id .. " » n'a pas pu être chargé.")
			s:Destroy()
			return
		end
		Debris:AddItem(s, s.TimeLength / math.max(s.PlaybackSpeed, 0.01) + 2)
	end)
end]],
	},

	_arreterSons = {
		deps = { "_obj", "_partie" },
		services = { "SoundService" },
		code = [[
local function _arreterSons(valeur)
	local objet = _obj(valeur)
	local liste = {}
	if objet then
		liste = objet:GetDescendants()
		table.insert(liste, objet)
	end
	-- les sons joués « sur » un objet sans partie sont dans SoundService
	if objet == nil or _partie(objet) == nil then
		for _, s in ipairs(SoundService:GetChildren()) do
			if s.Name == "BlocsFR_Son" then
				table.insert(liste, s)
			end
		end
	end
	for _, d in ipairs(liste) do
		if d:IsA("Sound") then
			d:Stop()
		end
	end
end]],
	},

	-- Convertit une valeur pour une propriété dont la valeur actuelle est « actuelle »
	_convertirPropriete = {
		deps = { "_obj", "_texte", "_versColor3" },
		services = {},
		code = [[
local function _convertirPropriete(actuelle, valeur)
	local typeActuel = typeof(actuelle)
	local typeValeur = typeof(valeur)
	local texte = nil
	if typeValeur == "string" then
		texte = string.lower((string.gsub(valeur, "^%s*(.-)%s*$", "%1")))
	end
	local nombre = nil
	if typeValeur == "number" then
		nombre = valeur
	elseif texte then
		nombre = tonumber((string.gsub(texte, ",", ".")))
	end
	local booleen = nil
	if typeValeur == "boolean" then
		booleen = valeur
	elseif texte == "true" or texte == "vrai" or texte == "oui" then
		booleen = true
	elseif texte == "false" or texte == "faux" or texte == "non" then
		booleen = false
	end
	if typeActuel == "number" then
		if nombre ~= nil then
			return nombre
		end
		if booleen ~= nil then
			return booleen and 1 or 0
		end
		return valeur
	elseif typeActuel == "boolean" then
		if booleen ~= nil then
			return booleen
		end
		if nombre ~= nil then
			return nombre ~= 0
		end
		return valeur
	elseif typeActuel == "string" then
		return _texte(valeur)
	elseif typeActuel == "Color3" then
		return _versColor3(valeur) or valeur
	elseif typeActuel == "BrickColor" then
		if typeValeur == "BrickColor" then
			return valeur
		end
		if texte then
			local ok, brique = pcall(BrickColor.new, valeur)
			if ok and string.lower(brique.Name) == texte then
				return brique
			end
		end
		local couleur = _versColor3(valeur)
		if couleur then
			return BrickColor.new(couleur)
		end
		return valeur
	elseif typeActuel == "EnumItem" then
		if typeValeur == "string" then
			local nomItem = string.match(valeur, "([%w_]+)%s*$")
			if nomItem then
				local ok, item = pcall(function()
					return actuelle.EnumType[nomItem]
				end)
				if ok and item then
					return item
				end
			end
		elseif typeValeur == "number" then
			local ok, items = pcall(function()
				return actuelle.EnumType:GetEnumItems()
			end)
			if ok then
				for _, item in ipairs(items) do
					if item.Value == valeur then
						return item
					end
				end
			end
		end
		return valeur
	elseif typeActuel == "Vector3" then
		if typeValeur == "number" then
			return Vector3.new(valeur, valeur, valeur)
		end
		if texte then
			local x, y, z = string.match(texte, "^([%-%d%.]+)[%s,;]+([%-%d%.]+)[%s,;]+([%-%d%.]+)$")
			if x then
				return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
			end
		end
		return valeur
	elseif typeActuel == "Instance" then
		if typeValeur == "string" then
			return _obj(valeur) or valeur
		end
		return valeur
	end
	if booleen ~= nil then
		return booleen
	end
	if nombre ~= nil then
		return nombre
	end
	return valeur
end]],
	},

	-- Change une propriété quelconque (pcall) ; noms français courants acceptés.
	-- Un joueur (Player) est gardé tel quel (TeamColor, Neutral…) ; si la propriété n'existe pas
	-- pour un joueur, elle est cherchée sur son personnage.
	_definirPropriete = {
		deps = { "_obj", "_convertirPropriete", "_avertir" },
		services = {},
		code = [[
local function _definirPropriete(valeur, nom, nouvelle)
	local objet = valeur
	if typeof(objet) ~= "Instance" then
		objet = _obj(valeur)
	end
	if objet == nil then
		_avertir("« mettre la propriété » : objet introuvable.")
		return
	end
	nom = (string.gsub(tostring(nom or ""), "%s", ""))
	if nom == "" then
		_avertir("« mettre la propriété » : nom de propriété vide.")
		return
	end
	local okLire, actuelle = pcall(function()
		return objet[nom]
	end)
	if not okLire and objet:IsA("Player") then
		local perso = objet.Character
		if perso == nil then
			_avertir("« mettre la propriété » : « " .. nom .. " » n'est pas une propriété du joueur « " .. objet.Name .. " », et il n'a pas de personnage.")
			return
		end
		objet = perso
		okLire, actuelle = pcall(function()
			return objet[nom]
		end)
	end
	if not okLire then
		local alias = {
			transparence = "Transparency",
			couleur = "Color",
			taille = "Size",
			nom = "Name",
			position = "Position",
			ancre = "Anchored",
			["ancré"] = "Anchored",
			collision = "CanCollide",
			materiau = "Material",
			["matériau"] = "Material",
			reflet = "Reflectance",
			texte = "Text",
			visible = "Visible",
		}
		local traduit = alias[string.lower(nom)]
		if traduit then
			nom = traduit
			okLire, actuelle = pcall(function()
				return objet[nom]
			end)
		end
	end
	if not okLire then
		actuelle = nil
	end
	local converti = _convertirPropriete(actuelle, nouvelle)
	local ok, erreur = pcall(function()
		objet[nom] = converti
	end)
	if not ok then
		_avertir("Impossible de mettre la propriété « " .. nom .. " » de « " .. objet.Name .. " » : " .. tostring(erreur))
	end
end]],
	},

	_mettreDans = {
		deps = { "_obj", "_estProtege", "_avertir" },
		services = {},
		code = [[
local function _mettreDans(valeur, parent)
	local objet = _obj(valeur)
	local destination = _obj(parent)
	if objet == nil or destination == nil then
		_avertir("« mettre dans » : objet ou destination introuvable.")
		return
	end
	if _estProtege(objet) then
		_avertir("« " .. objet.Name .. " » ne peut pas être déplacé.")
		return
	end
	if destination == objet or destination:IsDescendantOf(objet) then
		_avertir("« mettre dans » : « " .. objet.Name .. " » ne peut pas être mis dans lui-même.")
		return
	end
	local ok, erreur = pcall(function()
		objet.Parent = destination
	end)
	if not ok then
		_avertir("Impossible de mettre « " .. objet.Name .. " » dans « " .. destination.Name .. " » : " .. tostring(erreur))
	end
end]],
	},
}

return {
	category = "actions",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Defs_Apparence</string><ProtectedString name="Source"><![CDATA[-- Defs_Apparence : blocs de la catégorie « Apparence »
-- (couleur, transparence, matériau, forme, cacher / montrer, lumière, effets, texte au-dessus…)
-- Les blocs s'appliquent à toutes les parties (BasePart) de l'objet : une partie seule, un modèle
-- entier ou le personnage d'un joueur. La partie invisible « HumanoidRootPart » des personnages
-- est laissée de côté pour la transparence.

local Shared = require(script.Parent.Shared)

local objInput = Shared.objInput

-- Entrée nombre
local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Entrée couleur ({r, g, b} de 0 à 255)
local function couleur(name, default)
	return { name = name, kind = "color", default = default }
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	return g.helper(nom) .. "(" .. table.concat({ ... }, ", ") .. ")"
end

local blocks = {
	{
		id = "app_couleur",
		shape = "stack",
		label = "mettre la couleur de %1 à %2",
		inputs = { objInput("OBJ"), couleur("COULEUR", { 255, 0, 0 }) },
		keywords = "couleur peindre colorier teinte color paint",
		tooltip = "Peint toutes les parties de l'objet avec cette couleur.",
		gen = function(a, g)
			return appel(g, "_mettreCouleur", a.OBJ, a.COULEUR)
		end,
	},
	{
		id = "app_couleur_aleatoire",
		shape = "stack",
		label = "mettre une couleur au hasard à %1",
		inputs = { objInput("OBJ") },
		keywords = "couleur hasard aléatoire random arc-en-ciel peindre",
		tooltip = "Peint l'objet avec une couleur vive choisie au hasard.",
		gen = function(a, g)
			return appel(g, "_mettreCouleurHasard", a.OBJ)
		end,
	},
	{
		id = "app_transparence",
		shape = "stack",
		label = "mettre la transparence de %1 à %2",
		inputs = { objInput("OBJ"), nombre("VALEUR", 0.5) },
		keywords = "transparence transparent invisible opacité fantôme transparency",
		tooltip = "0 = opaque, 1 = invisible, 0,5 = à moitié transparent. S'applique à toutes les parties de l'objet et à ses images (visage, autocollants).",
		gen = function(a, g)
			return appel(g, "_mettreTransparence", a.OBJ, g.num(a.VALEUR))
		end,
	},
	{
		id = "app_materiau",
		shape = "stack",
		label = "mettre le matériau de %1 à %2",
		inputs = {
			objInput("OBJ"),
			{ name = "MATERIAU", kind = "dropdown", options = Shared.MATERIAUX, default = "Enum.Material.Neon" },
		},
		keywords = "matériau matière texture néon bois métal verre material",
		tooltip = "Change la matière de toutes les parties de l'objet (néon, bois, métal, verre…).",
		gen = function(a, g)
			return appel(g, "_mettreMateriau", a.OBJ, a.MATERIAU)
		end,
	},
	{
		id = "app_forme",
		shape = "stack",
		label = "mettre la forme de %1 à %2",
		inputs = {
			objInput("OBJ"),
			{ name = "FORME", kind = "dropdown", options = Shared.FORMES, default = "Enum.PartType.Ball" },
		},
		keywords = "forme boule sphère cylindre bloc cube coin shape",
		tooltip = "Change la forme des parties simples (bloc, boule, cylindre, coin). Ne marche pas sur les MeshParts.",
		gen = function(a, g)
			return appel(g, "_mettreForme", a.OBJ, a.FORME)
		end,
	},
	{
		id = "app_cacher",
		shape = "stack",
		label = "cacher %1",
		inputs = { objInput("OBJ") },
		keywords = "cacher invisible disparaître masquer hide",
		tooltip = "Rend l'objet invisible (ses parties et ses images). Il reste solide : utilise « collision de … : non » si besoin.",
		gen = function(a, g)
			return appel(g, "_cacher", a.OBJ)
		end,
	},
	{
		id = "app_montrer",
		shape = "stack",
		label = "montrer %1",
		inputs = { objInput("OBJ") },
		keywords = "montrer afficher visible apparaître réapparaître show",
		tooltip = "Fait réapparaître un objet caché avec « cacher » : chaque partie retrouve sa transparence d'avant.",
		gen = function(a, g)
			return appel(g, "_montrer", a.OBJ)
		end,
	},
	{
		id = "app_reflet",
		shape = "stack",
		label = "mettre le reflet de %1 à %2",
		inputs = { objInput("OBJ"), nombre("VALEUR", 0.5) },
		keywords = "reflet miroir brillant briller reflectance",
		tooltip = "Rend l'objet brillant comme un miroir : 0 = pas de reflet, 1 = miroir parfait.",
		gen = function(a, g)
			return appel(g, "_mettreReflet", a.OBJ, g.num(a.VALEUR))
		end,
	},
	{
		id = "app_lumiere",
		shape = "stack",
		label = "ajouter une lumière à %1 (couleur %2, portée %3)",
		inputs = { objInput("OBJ"), couleur("COULEUR", { 255, 240, 180 }), nombre("PORTEE", 16) },
		keywords = "lumière lampe éclairer briller ampoule pointlight light",
		tooltip = "Ajoute une lampe qui éclaire autour de l'objet. Si l'objet a déjà une lampe Blocs FR, elle est mise à jour. Portée maximum : 60 studs.",
		gen = function(a, g)
			return appel(g, "_ajouterLumiere", a.OBJ, a.COULEUR, g.num(a.PORTEE))
		end,
	},
	{
		id = "app_retirer_lumiere",
		shape = "stack",
		label = "retirer les lumières de %1",
		inputs = { objInput("OBJ") },
		keywords = "lumière lampe éteindre retirer enlever light",
		tooltip = "Retire toutes les lampes (lumières) de l'objet.",
		gen = function(a, g)
			return appel(g, "_retirerLumiere", a.OBJ)
		end,
	},
	{
		id = "app_effet",
		shape = "stack",
		label = "ajouter l'effet %1 à %2",
		inputs = {
			{ name = "EFFET", kind = "dropdown", options = Shared.EFFETS, default = Shared.EFFETS[1][2] },
			objInput("OBJ"),
		},
		keywords = "effet feu fumée étincelles particules fire smoke sparkles",
		tooltip = "Ajoute un effet de feu, de fumée ou d'étincelles sur l'objet.",
		gen = function(a, g)
			return appel(g, "_ajouterEffet", a.OBJ, a.EFFET)
		end,
	},
	{
		id = "app_retirer_effets",
		shape = "stack",
		label = "retirer les effets de %1",
		inputs = { objInput("OBJ") },
		keywords = "effet retirer enlever éteindre feu fumée étincelles",
		tooltip = "Retire le feu, la fumée et les étincelles de l'objet.",
		gen = function(a, g)
			return appel(g, "_retirerEffets", a.OBJ)
		end,
	},
	{
		id = "app_texte_dessus",
		shape = "stack",
		label = "afficher le texte %1 au-dessus de %2",
		inputs = { { name = "TEXTE", kind = "text", default = "Bonjour !" }, objInput("OBJ") },
		keywords = "texte afficher dessus étiquette panneau nom billboard bulle",
		tooltip = "Affiche un texte (ou une valeur, comme un score) au-dessus de l'objet. Si un texte y est déjà affiché, il est remplacé.",
		gen = function(a, g)
			return appel(g, "_texteDessus", a.OBJ, a.TEXTE)
		end,
	},
	{
		id = "app_retirer_texte",
		shape = "stack",
		label = "retirer le texte au-dessus de %1",
		inputs = { objInput("OBJ") },
		keywords = "texte retirer enlever effacer étiquette billboard",
		tooltip = "Retire le texte affiché au-dessus de l'objet.",
		gen = function(a, g)
			return appel(g, "_retirerTexte", a.OBJ)
		end,
	},
	{
		id = "app_clignoter",
		shape = "stack",
		label = "faire clignoter %1 %2 fois",
		inputs = { objInput("OBJ"), nombre("FOIS", 3) },
		keywords = "clignoter clignotement flash disparaître apparaître blink",
		tooltip = "Fait clignoter l'objet (il disparaît et réapparaît) le nombre de fois indiqué. Le script attend la fin (0,3 s par clignotement).",
		gen = function(a, g)
			return appel(g, "_clignoter", a.OBJ, g.num(a.FOIS))
		end,
	},
	{
		id = "app_couleur_rgb",
		shape = "reporter",
		label = "couleur R %1 V %2 B %3",
		inputs = { nombre("R", 255), nombre("V", 0), nombre("B", 0) },
		keywords = "couleur rgb rouge vert bleu mélange color",
		tooltip = "Fabrique une couleur avec ses quantités de Rouge, Vert et Bleu (de 0 à 255).",
		gen = function(a, g)
			return appel(g, "_couleurRGB", g.num(a.R), g.num(a.V), g.num(a.B))
		end,
	},
	{
		id = "app_transparence_val",
		shape = "reporter",
		label = "transparence de %1",
		inputs = { objInput("OBJ") },
		keywords = "transparence transparent invisible opacité transparency",
		tooltip = "Donne la transparence de l'objet (0 = opaque, 1 = invisible).",
		gen = function(a, g)
			return appel(g, "_transparenceDe", a.OBJ)
		end,
	},
}

local helpers = {
	-- Convertit une valeur en Color3 : Color3, BrickColor, Vector3 (r, g, b), partie (sa couleur),
	-- texte "255, 0, 0", "#ff0000", nom français ("rouge") ou nom BrickColor. nil si impossible.
	-- (aussi utilisée par Defs_Monde et Defs_Actions)
	_versColor3 = {
		deps = {},
		services = {},
		code = [[
local function _versColor3(valeur)
	local t = typeof(valeur)
	if t == "Color3" then
		return valeur
	elseif t == "BrickColor" then
		return valeur.Color
	elseif t == "Vector3" then
		return Color3.fromRGB(math.clamp(valeur.X, 0, 255), math.clamp(valeur.Y, 0, 255), math.clamp(valeur.Z, 0, 255))
	elseif t == "Instance" then
		if valeur:IsA("BasePart") then
			return valeur.Color
		elseif valeur:IsA("Color3Value") then
			return valeur.Value
		elseif valeur:IsA("BrickColorValue") then
			return valeur.Value.Color
		end
		return nil
	elseif t ~= "string" then
		return nil
	end
	local texte = string.lower((string.gsub(valeur, "^%s*(.-)%s*$", "%1")))
	local r, v, b = string.match(texte, "^(%d+)[%s,;]+(%d+)[%s,;]+(%d+)$")
	if r then
		return Color3.fromRGB(math.clamp(tonumber(r) or 0, 0, 255), math.clamp(tonumber(v) or 0, 0, 255), math.clamp(tonumber(b) or 0, 0, 255))
	end
	local hex = string.match(texte, "^#?(%x%x%x%x%x%x)$")
	if hex then
		local ok, c = pcall(Color3.fromHex, hex)
		if ok then
			return c
		end
	end
	local noms = {
		rouge = { 255, 0, 0 },
		vert = { 0, 200, 0 },
		bleu = { 0, 90, 255 },
		jaune = { 255, 220, 0 },
		orange = { 255, 140, 0 },
		violet = { 140, 60, 220 },
		rose = { 255, 105, 180 },
		noir = { 0, 0, 0 },
		blanc = { 255, 255, 255 },
		gris = { 128, 128, 128 },
		marron = { 120, 70, 30 },
		cyan = { 0, 220, 255 },
		turquoise = { 64, 224, 208 },
		["or"] = { 255, 200, 40 },
		["doré"] = { 255, 200, 40 },
	}
	local rgb = noms[texte]
	if rgb then
		return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	end
	local ok, brique = pcall(BrickColor.new, valeur)
	if ok and string.lower(brique.Name) == texte then
		return brique.Color
	end
	return nil
end]],
	},

	-- Parties visibles d'un objet (sans la HumanoidRootPart des personnages), avec ou sans
	-- les images (Decal / Texture). Renvoie la liste et l'objet (nil si introuvable).
	_elementsVisibles = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _elementsVisibles(valeur, avecDecals)
	local objet = _obj(valeur)
	local liste = {}
	if objet == nil then
		return liste, nil
	end
	local candidats = objet:GetDescendants()
	table.insert(candidats, 1, objet)
	for _, d in ipairs(candidats) do
		if d:IsA("BasePart") then
			if d.Name ~= "HumanoidRootPart" or d == objet then
				table.insert(liste, d)
			end
		elseif avecDecals and d:IsA("Decal") then
			table.insert(liste, d)
		end
	end
	return liste, objet
end]],
	},

	_mettreCouleur = {
		deps = { "_versColor3", "_partiesOuAvertir", "_avertir" },
		services = {},
		code = [[
local function _mettreCouleur(valeur, couleur)
	local c = _versColor3(couleur)
	if c == nil then
		_avertir("« mettre la couleur » : couleur invalide (" .. tostring(couleur) .. ").")
		return
	end
	for _, partie in ipairs(_partiesOuAvertir(valeur, "mettre la couleur")) do
		partie.Color = c
	end
end]],
	},

	_mettreCouleurHasard = {
		deps = { "_mettreCouleur" },
		services = {},
		code = [[
local function _mettreCouleurHasard(valeur)
	_mettreCouleur(valeur, Color3.fromHSV(math.random(), 0.65 + 0.35 * math.random(), 0.75 + 0.25 * math.random()))
end]],
	},

	-- Parties ET images (Decal / Texture) : sinon le visage d'un personnage invisible flotte en l'air
	_mettreTransparence = {
		deps = { "_elementsVisibles", "_avertir" },
		services = {},
		code = [[
local function _mettreTransparence(valeur, transparence)
	local parties, objet = _elementsVisibles(valeur, true)
	if objet == nil then
		_avertir("« mettre la transparence » : objet introuvable.")
		return
	end
	if #parties == 0 then
		_avertir("« mettre la transparence » : « " .. objet.Name .. " » ne contient aucune partie.")
		return
	end
	local t = math.clamp(tonumber(transparence) or 0, 0, 1)
	for _, partie in ipairs(parties) do
		partie.Transparency = t
		partie:SetAttribute("BlocsFR_Transparence", nil)
	end
end]],
	},

	_mettreMateriau = {
		deps = { "_partiesOuAvertir", "_avertir" },
		services = {},
		code = [[
local function _mettreMateriau(valeur, materiau)
	if typeof(materiau) ~= "EnumItem" or materiau.EnumType ~= Enum.Material then
		_avertir("« mettre le matériau » : matériau invalide.")
		return
	end
	for _, partie in ipairs(_partiesOuAvertir(valeur, "mettre le matériau")) do
		partie.Material = materiau
	end
end]],
	},

	_mettreForme = {
		deps = { "_partiesOuAvertir", "_avertir" },
		services = {},
		code = [[
local function _mettreForme(valeur, forme)
	local parties = _partiesOuAvertir(valeur, "mettre la forme")
	if #parties == 0 then
		return
	end
	local changees = 0
	for _, partie in ipairs(parties) do
		if partie:IsA("Part") then
			local ok = pcall(function()
				partie.Shape = forme
			end)
			if ok then
				changees += 1
			end
		end
	end
	if changees == 0 then
		_avertir("« mettre la forme » : seules les parties simples (Part) peuvent changer de forme.")
	end
end]],
	},

	-- Cache l'objet ; la transparence d'avant est gardée dans l'attribut « BlocsFR_Transparence »
	_cacher = {
		deps = { "_elementsVisibles", "_avertir" },
		services = {},
		code = [[
local function _cacher(valeur)
	local elements, objet = _elementsVisibles(valeur, true)
	if objet == nil then
		_avertir("« cacher » : objet introuvable.")
		return
	end
	for _, element in ipairs(elements) do
		if element:GetAttribute("BlocsFR_Transparence") == nil then
			element:SetAttribute("BlocsFR_Transparence", element.Transparency)
		end
		element.Transparency = 1
	end
end]],
	},

	-- Remontre l'objet : remet la transparence gardée par « cacher ». Si l'objet n'a jamais été
	-- caché par un bloc, les éléments complètement invisibles redeviennent opaques.
	_montrer = {
		deps = { "_elementsVisibles", "_avertir" },
		services = {},
		code = [[
local function _montrer(valeur)
	local elements, objet = _elementsVisibles(valeur, true)
	if objet == nil then
		_avertir("« montrer » : objet introuvable.")
		return
	end
	local dejaCache = false
	for _, element in ipairs(elements) do
		if element:GetAttribute("BlocsFR_Transparence") ~= nil then
			dejaCache = true
			break
		end
	end
	for _, element in ipairs(elements) do
		local ancienne = element:GetAttribute("BlocsFR_Transparence")
		if type(ancienne) == "number" then
			element.Transparency = math.clamp(ancienne, 0, 1)
			element:SetAttribute("BlocsFR_Transparence", nil)
		elseif not dejaCache and element.Transparency >= 1 then
			element.Transparency = 0
		end
	end
end]],
	},

	_mettreReflet = {
		deps = { "_partiesOuAvertir" },
		services = {},
		code = [[
local function _mettreReflet(valeur, reflet)
	local r = math.clamp(tonumber(reflet) or 0, 0, 1)
	for _, partie in ipairs(_partiesOuAvertir(valeur, "mettre le reflet")) do
		partie.Reflectance = r
	end
end]],
	},

	-- Une seule lampe Blocs FR par objet (mise à jour si elle existe déjà)
	_ajouterLumiere = {
		deps = { "_partie", "_versColor3", "_avertir" },
		services = {},
		code = [[
local function _ajouterLumiere(valeur, couleur, portee)
	local partie = _partie(valeur)
	if partie == nil then
		_avertir("« ajouter une lumière » : objet introuvable ou sans partie.")
		return
	end
	local lumiere = partie:FindFirstChild("BlocsFR_Lumiere")
	if lumiere == nil or not lumiere:IsA("PointLight") then
		lumiere = Instance.new("PointLight")
		lumiere.Name = "BlocsFR_Lumiere"
		lumiere.Brightness = 2
		lumiere.Shadows = true
		lumiere.Parent = partie
	end
	lumiere.Color = _versColor3(couleur) or Color3.new(1, 1, 1)
	lumiere.Range = math.clamp(tonumber(portee) or 0, 0, 60)
	lumiere.Enabled = true
end]],
	},

	_retirerLumiere = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _retirerLumiere(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« retirer les lumières » : objet introuvable.")
		return
	end
	for _, d in ipairs(objet:GetDescendants()) do
		if d:IsA("Light") then
			d:Destroy()
		end
	end
end]],
	},

	-- Ajoute un effet (Fire, Smoke ou Sparkles) dans la partie principale ; pas de doublon
	_ajouterEffet = {
		deps = { "_partie", "_avertir" },
		services = {},
		code = [[
local function _ajouterEffet(valeur, classe)
	local permis = { Fire = true, Smoke = true, Sparkles = true }
	if type(classe) ~= "string" or not permis[classe] then
		_avertir("« ajouter l'effet » : effet inconnu (" .. tostring(classe) .. ").")
		return
	end
	local partie = _partie(valeur)
	if partie == nil then
		_avertir("« ajouter l'effet » : objet introuvable ou sans partie.")
		return
	end
	local effet = partie:FindFirstChildOfClass(classe)
	if effet == nil then
		effet = Instance.new(classe)
		effet.Parent = partie
	end
	effet.Enabled = true
end]],
	},

	_retirerEffets = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _retirerEffets(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« retirer les effets » : objet introuvable.")
		return
	end
	for _, d in ipairs(objet:GetDescendants()) do
		if d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
			d:Destroy()
		end
	end
end]],
	},

	-- Un seul panneau « BlocsFR_Texte » (BillboardGui) par objet : texte blanc, contour sombre,
	-- toujours visible par-dessus le décor. Si le panneau existe, seul le texte change.
	_texteDessus = {
		deps = { "_obj", "_partie", "_texte", "_avertir" },
		services = {},
		code = [[
local function _texteDessus(valeur, texte)
	local objet = _obj(valeur)
	local partie = _partie(valeur)
	if objet == nil or partie == nil then
		_avertir("« afficher le texte » : objet introuvable ou sans partie.")
		return
	end
	local panneau = partie:FindFirstChild("BlocsFR_Texte")
	if panneau == nil or not panneau:IsA("BillboardGui") then
		panneau = Instance.new("BillboardGui")
		panneau.Name = "BlocsFR_Texte"
		panneau.Size = UDim2.fromOffset(240, 50)
		panneau.AlwaysOnTop = true
		panneau.LightInfluence = 0
		panneau.MaxDistance = 250
		panneau.Adornee = partie
		if objet:IsA("BasePart") then
			panneau.ExtentsOffsetWorldSpace = Vector3.new(0, 1, 0)
			panneau.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
		else
			local hauteur = partie.Size.Y / 2 + 1.5
			if objet:IsA("Model") then
				local ok, cf, taille = pcall(function()
					return objet:GetBoundingBox()
				end)
				if ok and typeof(cf) == "CFrame" and typeof(taille) == "Vector3" then
					hauteur = cf.Position.Y + taille.Y / 2 - partie.Position.Y + 1.5
				end
			end
			panneau.StudsOffsetWorldSpace = Vector3.new(0, hauteur, 0)
		end
		local etiquette = Instance.new("TextLabel")
		etiquette.Name = "Texte"
		etiquette.Size = UDim2.fromScale(1, 1)
		etiquette.BackgroundTransparency = 1
		etiquette.Font = Enum.Font.GothamBold
		etiquette.TextColor3 = Color3.new(1, 1, 1)
		etiquette.TextStrokeColor3 = Color3.new(0, 0, 0)
		etiquette.TextStrokeTransparency = 0.1
		etiquette.TextScaled = true
		etiquette.TextWrapped = true
		etiquette.Parent = panneau
		local limite = Instance.new("UITextSizeConstraint")
		limite.MinTextSize = 10
		limite.MaxTextSize = 30
		limite.Parent = etiquette
		panneau.Parent = partie
	end
	local etiquette = panneau:FindFirstChildWhichIsA("TextLabel")
	if etiquette then
		etiquette.Text = _texte(texte)
	end
end]],
	},

	_retirerTexte = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _retirerTexte(valeur)
	local objet = _obj(valeur)
	if objet == nil then
		_avertir("« retirer le texte » : objet introuvable.")
		return
	end
	for _, d in ipairs(objet:GetDescendants()) do
		if d.Name == "BlocsFR_Texte" and d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
end]],
	},

	-- Clignote n fois (0,15 s invisible puis 0,15 s visible) ; attend la fin
	_clignoter = {
		deps = { "_elementsVisibles", "_avertir" },
		services = {},
		code = [[
local function _clignoter(valeur, fois)
	local elements, objet = _elementsVisibles(valeur, true)
	if objet == nil then
		_avertir("« faire clignoter » : objet introuvable.")
		return
	end
	local n = tonumber(fois) or 0
	if not (n >= 1) or #elements == 0 then
		return
	end
	n = math.min(math.floor(n), 1000)
	local origines = {}
	for i, element in ipairs(elements) do
		origines[i] = element.Transparency
	end
	for _ = 1, n do
		for _, element in ipairs(elements) do
			element.Transparency = 1
		end
		task.wait(0.15)
		for i, element in ipairs(elements) do
			element.Transparency = origines[i]
		end
		task.wait(0.15)
	end
end]],
	},

	_couleurRGB = {
		deps = {},
		services = {},
		code = [[
local function _couleurRGB(r, v, b)
	return Color3.fromRGB(math.clamp(tonumber(r) or 0, 0, 255), math.clamp(tonumber(v) or 0, 0, 255), math.clamp(tonumber(b) or 0, 0, 255))
end]],
	},

	_transparenceDe = {
		deps = { "_elementsVisibles" },
		services = {},
		code = [[
local function _transparenceDe(valeur)
	local parties = _elementsVisibles(valeur, false)
	if parties[1] then
		return parties[1].Transparency
	end
	return 0
end]],
	},
}

return {
	category = "apparence",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Defs_Camera</string><ProtectedString name="Source"><![CDATA[-- Defs_Camera : blocs de la catégorie « Caméra » (SPEC §23)
-- La caméra n'existe que chez le joueur : tous ces blocs sont pour les scripts locaux
-- (scriptType "local"). Dans un script serveur, leurs fonctions utiles affichent un avertissement
-- en français (une seule fois) et ne font rien.
--
-- Choix de conception :
--   * Il n'y a qu'une caméra par joueur : son état (vue spéciale en cours, décalage voulu, objet
--     suivi, trajet et tremblement en cours…) est commun à tous les scripts locaux du joueur. Il est
--     rangé dans shared.BlocsFR_Camera et renvoyé par _camEtat() (une fonction utile ne peut pas
--     avoir de variable à elle en dehors de son corps, SPEC §5.4).
--   * Les vues spéciales (dessus, côté, épaule, caméra fixe) sont recalculées à chaque image par
--     une seule liaison RunService:BindToRenderStep("BlocsFR_Camera", …) qui relit le personnage du
--     joueur à chaque image : elles continuent après une réapparition. Une nouvelle commande de
--     caméra remplace la vue en cours (_camArreter).
--   * Le tremblement (« BlocsFR_Tremblement ») décale la caméra juste après sa mise à jour
--     (priorité Camera + 1) : il marche avec la caméra normale (Custom) comme avec une caméra fixe
--     (Scriptable), sans toucher Humanoid.CameraOffset (réservé à « décaler la caméra » et à la vue
--     épaule).
--   * Les objets nommés (« Camera1 », « Point2 ») sont cherchés avec _objetNomme (Defs_Monde) ; chez
--     le joueur, un objet peut arriver un peu après le démarrage du script : on l'attend 3 s.
--   * Aides réutilisées d'autres fichiers : _objetNomme (Defs_Monde), _versColor3 (Defs_Apparence),
--     _nombreOu (Defs_Joueurs), _tpAvertirUneFois (Defs_ToutPrets).
-- NOTE: « fixer la caméra sur … regardant … » et « faire regarder la caméra vers … » continuent de
-- suivre la cible des yeux si elle bouge (pour une cible immobile, c'est un simple CFrame.lookAt).
-- NOTE: les blocs valeur « position / direction de la caméra » et « champ de vision » sont des
-- expressions directes (pas de fonction utile) : chaque fonction utile est une variable locale du
-- script, et Luau en limite le nombre (200).
-- Optimisation (SPEC §34) : rien n'est cherché récursivement à chaque image (la caméra fixe trouve
-- une seule fois la partie qu'elle suit des yeux) ; « déplacer la caméra » attend la fin du trajet
-- avec des pauses d'au moins 0,03 s ; « objet visé par la souris » réutilise un seul RaycastParams.

local Shared = require(script.Parent.Shared)

---------------------------------------------------------------------------
-- Listes d'options
---------------------------------------------------------------------------

-- Modes de caméra (le code est un texte Luau entre guillemets)
local MODES = {
	{ "normale", '"normale"' },
	{ "première personne", '"premiere"' },
	{ "vue de dessus", '"dessus"' },
	{ "vue de côté (2D)", '"cote"' },
	{ "épaule", '"epaule"' },
	{ "fixe ici", '"fixe"' },
}

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	local n = select("#", ...)
	local args = { ... }
	for i = 1, n do
		if args[i] == nil or args[i] == "" then
			args[i] = "nil"
		end
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ", 1, n) .. ")"
end

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "cam_mode",
		shape = "stack",
		label = "mode de caméra %1",
		inputs = {
			{ name = "MODE", kind = "dropdown", options = MODES, default = '"normale"', acceptReporter = true },
		},
		scriptType = "local",
		keywords = "camera mode vue premiere personne dessus cote 2d epaule fixe normale view first person top down side shoulder",
		tooltip = "Change la façon dont la caméra filme le joueur : normale, première personne, vue de dessus, vue de côté (comme un jeu 2D), épaule (caméra décalée sur le côté) ou fixe ici (la caméra reste où elle est). Les vues continuent après une réapparition. À mettre dans un script local, par exemple sous « Quand ce script démarre ». Astuce : « remettre la caméra normale » annule tout.",
		gen = function(a, g)
			return appel(g, "_camMode", a.MODE)
		end,
	},
	{
		id = "cam_fixer",
		shape = "stack",
		label = "fixer la caméra sur %1 regardant %2",
		inputs = {
			{ name = "POSITION", kind = "any", default = "Camera1" },
			Shared.objInput("CIBLE", "personnage"),
		},
		scriptType = "local",
		keywords = "fixer camera position regarder viser surveillance scene cinematique fixed camera look at security cutscene",
		tooltip = "Place la caméra sur un objet (par exemple une partie nommée « Camera1 ») et la fait regarder vers la cible, qu'elle suit des yeux si elle bouge : parfait pour une caméra de surveillance ou une scène. Sans cible, la caméra regarde dans la direction de la face avant de l'objet. À mettre dans un script local. Astuce : rends la partie « Camera1 » transparente, ancrée et sans collision.",
		gen = function(a, g)
			return appel(g, "_camViser", a.POSITION, a.CIBLE)
		end,
	},
	{
		id = "cam_aller_vers",
		shape = "stack",
		label = "déplacer la caméra vers %1 en %2 s",
		inputs = {
			{ name = "CIBLE", kind = "any", default = "Point2" },
			nombre("DUREE", 2),
		},
		scriptType = "local",
		keywords = "deplacer glisser camera trajet travelling cinematique scene point aller vers move camera tween cutscene",
		tooltip = "Fait glisser la caméra jusqu'à un objet (par exemple une partie nommée « Point2 ») en douceur : elle prend sa place et regarde dans la direction de sa face avant. Le script attend la fin du trajet : enchaîne plusieurs blocs pour faire une cinématique ! À mettre dans un script local. Astuce : termine par « remettre la caméra normale » pour rendre la caméra au joueur.",
		gen = function(a, g)
			return appel(g, "_camAllerVers", a.CIBLE, g.num(a.DUREE))
		end,
	},
	{
		id = "cam_regarder",
		shape = "stack",
		label = "faire regarder la caméra vers %1",
		inputs = { Shared.objInput("CIBLE") },
		scriptType = "local",
		keywords = "regarder viser tourner camera vers objet suivre des yeux look at camera aim",
		tooltip = "Tourne la caméra vers l'objet ou le personnage sans la déplacer, et continue de le suivre des yeux s'il bouge. À mettre dans un script local. Astuce : après « déplacer la caméra vers … », fais regarder la caméra vers le personnage.",
		gen = function(a, g)
			return appel(g, "_camViser", "nil", a.CIBLE)
		end,
	},
	{
		id = "cam_suivre_objet",
		shape = "stack",
		label = "faire suivre la caméra à %1",
		inputs = { Shared.objInput("CIBLE") },
		scriptType = "local",
		keywords = "suivre camera objet voiture vehicule pnj sujet follow camera subject car vehicle",
		tooltip = "La caméra suit un autre objet que le personnage : une voiture, un PNJ, une partie… Le joueur peut toujours tourner autour avec la souris. À mettre dans un script local. Astuce : choisis « le personnage » (ou « remettre la caméra normale ») pour revenir au joueur.",
		gen = function(a, g)
			return appel(g, "_camSuivre", a.CIBLE)
		end,
	},
	{
		id = "cam_trembler",
		shape = "stack",
		label = "faire trembler la caméra force %1 pendant %2 s",
		inputs = {
			nombre("FORCE", 0.5),
			nombre("DUREE", 0.4),
		},
		scriptType = "local",
		keywords = "trembler secouer tremblement camera explosion seisme choc impact shake camera shake earthquake",
		tooltip = "Fait trembler la caméra un court instant, de moins en moins fort : parfait pour une explosion, un coup reçu ou un tremblement de terre. Le script continue tout de suite. Force 0.5 = léger, 2 = très fort. À mettre dans un script local. Astuce : place-le sous « Quand je reçois le message explosion ».",
		gen = function(a, g)
			return appel(g, "_camTrembler", g.num(a.FORCE), g.num(a.DUREE))
		end,
	},
	{
		id = "cam_champ_vision",
		shape = "stack",
		label = "mettre le champ de vision à %1 en %2 s",
		inputs = {
			nombre("FOV", 50),
			nombre("DUREE", 0.5),
		},
		scriptType = "local",
		keywords = "champ de vision zoom objectif fov angle vitesse effet field of view",
		tooltip = "Change le champ de vision (l'angle de l'objectif) en douceur : 70 = normal, plus petit = zoom avant, plus grand = effet de vitesse. Entre 1 et 120. Le script continue tout de suite. À mettre dans un script local. Astuce : 90 pendant un sprint donne une impression de vitesse.",
		gen = function(a, g)
			return appel(g, "_camChampVision", g.num(a.FOV), g.num(a.DUREE))
		end,
	},
	{
		id = "cam_distance",
		shape = "stack",
		label = "distance de zoom entre %1 et %2",
		inputs = {
			nombre("MIN", 5),
			nombre("MAX", 30),
		},
		scriptType = "local",
		keywords = "distance zoom molette minimum maximum camera loin proche zoom distance min max",
		tooltip = "Limite le zoom de la molette : la caméra reste entre ces deux distances du personnage (en studs, de 0.5 à 400). À mettre dans un script local. Astuce : mets la même valeur deux fois (par exemple 15 et 15) pour bloquer la caméra à une distance fixe.",
		gen = function(a, g)
			return appel(g, "_camDistance", g.num(a.MIN), g.num(a.MAX))
		end,
	},
	{
		id = "cam_premiere_personne",
		shape = "stack",
		label = "vue à la première personne %1",
		inputs = { Shared.yesNoInput("ACTIVE", true) },
		scriptType = "local",
		keywords = "premiere personne vue fps tete yeux camera first person lock",
		tooltip = "Oui : la caméra est bloquée dans la tête du personnage (vue à la première personne). Non : retour à la caméra normale, que le joueur peut éloigner avec la molette. À mettre dans un script local. Astuce : pratique pour un jeu d'horreur ou de tir.",
		gen = function(a, g)
			return appel(g, "_camPremierePersonne", a.ACTIVE)
		end,
	},
	{
		id = "cam_decaler",
		shape = "stack",
		label = "décaler la caméra de x %1 y %2 z %3",
		inputs = {
			nombre("X", 2),
			nombre("Y", 1),
			nombre("Z", 0),
		},
		scriptType = "local",
		keywords = "decaler decalage camera epaule cote offset camera offset shoulder",
		tooltip = "Décale la caméra par rapport au personnage : x = vers la droite, y = vers le haut, z = vers l'arrière (en studs). Le décalage reste après une réapparition. À mettre dans un script local. Astuce : x 2, y 1 donne une vue par-dessus l'épaule ; 0, 0, 0 l'annule.",
		gen = function(a, g)
			return appel(g, "_camDecaler", g.num(a.X), g.num(a.Y), g.num(a.Z))
		end,
	},
	{
		id = "cam_flou",
		shape = "stack",
		label = "flou de la caméra %1",
		inputs = { nombre("TAILLE", 8) },
		scriptType = "local",
		keywords = "flou flouter ecran camera effet pause menu dialogue blur effect",
		tooltip = "Rend tout l'écran flou, en douceur (8 = flou léger, 30 = très flou). 0 enlève le flou. À mettre dans un script local. Astuce : un flou derrière un menu ou pendant un dialogue fait ressortir l'interface.",
		gen = function(a, g)
			return appel(g, "_camFlou", g.num(a.TAILLE))
		end,
	},
	{
		id = "cam_teinte",
		shape = "stack",
		label = "teinte de l'écran %1 intensité %2",
		inputs = {
			{ name = "COULEUR", kind = "color", default = { 255, 80, 80 } },
			nombre("INTENSITE", 0.3),
		},
		scriptType = "local",
		keywords = "teinte couleur ecran colorer filtre rouge degats eau ambiance tint color correction filter",
		tooltip = "Colore tout l'écran, en douceur (intensité 0.3 = légère teinte, 1 = très coloré). Une intensité de 0 enlève la teinte. À mettre dans un script local. Astuce : du rouge quand le joueur est blessé, du bleu sous l'eau.",
		gen = function(a, g)
			return appel(g, "_camTeinte", a.COULEUR, g.num(a.INTENSITE))
		end,
	},
	{
		id = "cam_bandes",
		shape = "stack",
		label = "bandes de cinéma %1",
		inputs = { Shared.yesNoInput("ACTIVE", true) },
		scriptType = "local",
		keywords = "bandes noires cinema cinematique film scene letterbox cutscene bars",
		tooltip = "Oui : deux bandes noires glissent en haut et en bas de l'écran, comme au cinéma. Non : elles repartent. À mettre dans un script local. Astuce : parfait avec « déplacer la caméra vers … » pour une cinématique.",
		gen = function(a, g)
			return appel(g, "_camBandes", a.ACTIVE)
		end,
	},
	{
		id = "cam_souris_centre",
		shape = "stack",
		label = "bloquer la souris au centre %1",
		inputs = { Shared.yesNoInput("ACTIVE", true) },
		scriptType = "local",
		keywords = "souris centre bloquer verrouiller viseur tir fps mouse lock center shift lock",
		tooltip = "Oui : la souris reste bloquée au centre de l'écran et la caméra tourne quand on bouge la souris, comme dans un jeu de tir. Non : la souris redevient libre. À mettre dans un script local. Astuce : ajoute un petit viseur au centre de l'écran avec le Studio d'interface.",
		gen = function(a, g)
			return appel(g, "_camSouris", a.ACTIVE)
		end,
	},
	{
		id = "cam_normale",
		shape = "stack",
		label = "remettre la caméra normale",
		inputs = {},
		scriptType = "local",
		keywords = "remettre camera normale reinitialiser annuler fin cinematique reset camera default",
		tooltip = "Annule tous les effets de caméra : vue normale qui suit le personnage, champ de vision 70, aucun décalage, plus de flou, de teinte ni de bandes, souris libre. À mettre dans un script local. Astuce : à la fin d'une cinématique.",
		gen = function(_a, g)
			return appel(g, "_camNormale")
		end,
	},

	---------------------------------------------------------------------------
	-- Valeurs
	---------------------------------------------------------------------------
	{
		id = "cam_position",
		shape = "reporter",
		label = "position de la caméra",
		inputs = {},
		scriptType = "local",
		keywords = "position camera vecteur ou est la camera camera position",
		tooltip = "La position de la caméra (un vecteur x, y, z). À utiliser dans un script local. Astuce : avec « distance entre … et … », tu sais si la caméra est loin d'un objet.",
		gen = function(_a, _g)
			return "(workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero)"
		end,
	},
	{
		id = "cam_direction",
		shape = "reporter",
		label = "direction de la caméra",
		inputs = {},
		scriptType = "local",
		keywords = "direction camera regard devant vecteur look vector camera direction",
		tooltip = "La direction dans laquelle regarde la caméra (un vecteur de longueur 1). À utiliser dans un script local. Astuce : pratique pour lancer quelque chose droit devant la caméra.",
		gen = function(_a, _g)
			return "(workspace.CurrentCamera and workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0, 0, -1))"
		end,
	},
	{
		id = "cam_champ",
		shape = "reporter",
		label = "champ de vision",
		inputs = {},
		scriptType = "local",
		keywords = "champ de vision camera zoom fov angle field of view",
		tooltip = "Le champ de vision actuel de la caméra (70 par défaut). À utiliser dans un script local.",
		gen = function(_a, _g)
			return "(workspace.CurrentCamera and workspace.CurrentCamera.FieldOfView or 70)"
		end,
	},
	{
		id = "cam_objet_vise",
		shape = "reporter",
		label = "objet visé par la souris",
		inputs = {},
		scriptType = "local",
		keywords = "objet vise souris pointe montre cible rayon raycast mouse target hit",
		tooltip = "La partie que la souris montre à l'écran (jusqu'à 500 studs), sans compter ton propre personnage ; rien si la souris montre le ciel. À utiliser dans un script local. Astuce : « nom de … » sur cette valeur te dit ce que vise le joueur.",
		gen = function(_a, g)
			return appel(g, "_camObjetVise")
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- État de la caméra, commun à tous les scripts locaux du joueur (une seule caméra).
	-- Branche aussi (une fois) la réapparition : le décalage voulu et l'objet suivi sont remis
	-- sur le nouveau personnage.
	_camEtat = {
		deps = {},
		services = { "Players" },
		code = [[
local function _camEtat()
	local etat = shared.BlocsFR_Camera
	if type(etat) ~= "table" then
		etat = { decalage = Vector3.zero }
		shared.BlocsFR_Camera = etat
	end
	local joueurLocal = Players.LocalPlayer
	if joueurLocal ~= nil and (etat.reapparition == nil or not etat.reapparition.Connected) then
		etat.reapparition = joueurLocal.CharacterAdded:Connect(function(perso)
			local h = perso:WaitForChild("Humanoid", 10)
			task.wait(0.1)
			if h == nil or not h:IsA("Humanoid") or perso.Parent == nil then
				return
			end
			if etat.vue ~= "epaule" then
				h.CameraOffset = etat.decalage or Vector3.zero
			end
			local sujet = etat.sujet
			local camera = workspace.CurrentCamera
			if camera ~= nil and typeof(sujet) == "Instance" and sujet.Parent ~= nil and camera.CameraType == Enum.CameraType.Custom then
				camera.CameraSubject = sujet
			end
		end)
	end
	return etat
end]],
	},

	-- La caméra du joueur (attendue 5 s au plus). Dans un script serveur : avertissement et nil.
	_cam = {
		deps = { "_camEtat", "_tpAvertirUneFois" },
		services = { "RunService" },
		code = [[
local function _cam()
	if not RunService:IsClient() then
		_tpAvertirUneFois(_camEtat(), "serveur", "La caméra n'existe que chez le joueur : utilise un script local (bouton « Script local ») pour les blocs Caméra.")
		return nil
	end
	local camera = workspace.CurrentCamera
	local attente = 0
	while camera == nil and attente < 5 do
		attente += task.wait(0.1)
		camera = workspace.CurrentCamera
	end
	if camera == nil then
		_tpAvertirUneFois(_camEtat(), "absente", "La caméra du joueur est introuvable.")
	end
	return camera
end]],
	},

	-- Personnage du joueur local, son Humanoid et sa partie racine (nil s'ils ne sont pas là)
	_camPerso = {
		deps = {},
		services = { "Players" },
		code = [[
local function _camPerso()
	local joueurLocal = Players.LocalPlayer
	local perso = nil
	if joueurLocal ~= nil then
		perso = joueurLocal.Character
	end
	if perso == nil then
		return nil, nil, nil
	end
	local h = perso:FindFirstChildOfClass("Humanoid")
	local racine = perso:FindFirstChild("HumanoidRootPart")
	if racine == nil or not racine:IsA("BasePart") then
		racine = perso.PrimaryPart
	end
	return perso, h, racine
end]],
	},

	-- Ce que vise un bloc caméra : objet, joueur (-> son personnage), position (Vector3 / CFrame) ou
	-- nom d'objet (attendu 3 s au plus : chez le joueur, un objet peut arriver un peu après le
	-- démarrage). Rien (nil) avec persoParDefaut : le personnage du joueur local (attendu 5 s au plus).
	_camTrouver = {
		deps = { "_obj", "_objetNomme", "_camPerso" },
		services = {},
		code = [[
local function _camTrouver(valeur, persoParDefaut)
	local t = typeof(valeur)
	if t == "Vector3" or t == "CFrame" then
		return valeur
	end
	local attente = 0
	if valeur == nil then
		if not persoParDefaut then
			return nil
		end
		local perso = _camPerso()
		while perso == nil and attente < 5 do
			attente += task.wait(0.1)
			perso = _camPerso()
		end
		return perso
	end
	if t == "Instance" then
		return _obj(valeur)
	end
	if (t ~= "string" and t ~= "number") or valeur == "" then
		return nil
	end
	local trouve = _objetNomme(valeur)
	while trouve == nil and attente < 3 do
		attente += task.wait(0.25)
		trouve = _objetNomme(valeur)
	end
	if typeof(trouve) == "Instance" then
		return _obj(trouve)
	end
	return nil
end]],
	},

	-- CFrame placé en « depart » et tourné vers « vise » (nil si les deux points sont confondus)
	_camRegard = {
		deps = {},
		services = {},
		code = [[
local function _camRegard(depart, vise)
	local direction = vise - depart
	if direction.Magnitude < 0.01 then
		return nil
	end
	local haut = Vector3.yAxis
	if math.abs(direction.Unit.Y) > 0.999 then
		haut = Vector3.zAxis
	end
	return CFrame.lookAt(depart, vise, haut)
end]],
	},

	-- Arrête la vue spéciale et le trajet de caméra en cours ; remet le décalage voulu après la vue
	-- « épaule » (qui change Humanoid.CameraOffset)
	_camArreter = {
		deps = { "_camEtat", "_camPerso" },
		services = { "RunService" },
		code = [[
local function _camArreter()
	local etat = _camEtat()
	pcall(function()
		RunService:UnbindFromRenderStep("BlocsFR_Camera")
	end)
	local tween = etat.tween
	etat.tween = nil
	if tween ~= nil then
		pcall(function()
			tween:Cancel()
		end)
	end
	if etat.vue == "epaule" then
		local _, h = _camPerso()
		if h then
			h.CameraOffset = etat.decalage or Vector3.zero
		end
	end
	etat.vue = nil
	etat.sujet = nil
	etat.cfFixe = nil
end]],
	},

	-- Quitte la première personne : mode Classic, puis la caméra est un peu éloignée du personnage
	-- (sinon elle resterait dans sa tête jusqu'au prochain coup de molette)
	_camSortirPremiere = {
		deps = {},
		services = { "Players" },
		code = [[
local function _camSortirPremiere()
	local joueurLocal = Players.LocalPlayer
	if joueurLocal == nil or joueurLocal.CameraMode ~= Enum.CameraMode.LockFirstPerson then
		return
	end
	joueurLocal.CameraMode = Enum.CameraMode.Classic
	local ancienMin = joueurLocal.CameraMinZoomDistance
	local recul = math.min(10, joueurLocal.CameraMaxZoomDistance)
	if ancienMin >= recul then
		return
	end
	joueurLocal.CameraMinZoomDistance = recul
	task.delay(0.2, function()
		if joueurLocal.CameraMinZoomDistance == recul then
			joueurLocal.CameraMinZoomDistance = ancienMin
		end
	end)
end]],
	},

	-- Caméra fixe (Scriptable) placée à « cf ». Avec une cible (objet, position, ou suivrePerso =
	-- le personnage du joueur local, relu à chaque image), la caméra garde sa place et suit la cible
	-- des yeux. La liaison remet la caméra en Scriptable si Roblox la change (réapparition…).
	-- La partie (ou le modèle) suivie est trouvée une seule fois, pas à chaque image.
	_camFixe = {
		deps = { "_camEtat", "_camArreter", "_camPerso", "_camRegard", "_partie" },
		services = { "RunService" },
		code = [[
local function _camFixe(cf, cible, suivrePerso)
	local etat = _camEtat()
	_camArreter()
	etat.vue = "fixe"
	etat.cfFixe = cf
	-- objet suivi des yeux : un modèle ou une partie (son pivot à chaque image), sinon sa première
	-- partie (sa position à chaque image)
	local suivi = nil
	local suiviPartie = false
	if not suivrePerso and typeof(cible) == "Instance" then
		if cible:IsA("PVInstance") then
			suivi = cible
		else
			suivi = _partie(cible)
			suiviPartie = true
		end
	end
	local function image()
		local camera = workspace.CurrentCamera
		local actuel = etat.cfFixe
		if camera == nil or actuel == nil then
			return
		end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		local point = nil
		if suivrePerso then
			local _, _, racine = _camPerso()
			if racine then
				point = racine.Position
			end
		elseif typeof(cible) == "Vector3" then
			point = cible
		elseif suivi ~= nil and suivi.Parent ~= nil then
			if suiviPartie then
				point = suivi.Position
			else
				point = suivi:GetPivot().Position
			end
		end
		if point ~= nil then
			local regard = _camRegard(actuel.Position, point)
			if regard ~= nil then
				actuel = regard
				etat.cfFixe = regard
			end
		end
		camera.CFrame = actuel
	end
	image()
	RunService:BindToRenderStep("BlocsFR_Camera", Enum.RenderPriority.Camera.Value, image)
end]],
	},

	-- « mode de caméra » : "normale", "premiere", "dessus", "cote", "epaule" ou "fixe"
	_camMode = {
		deps = {
			"_cam",
			"_camEtat",
			"_camArreter",
			"_camSortirPremiere",
			"_camFixe",
			"_camPerso",
			"_texte",
			"_tpAvertirUneFois",
		},
		services = { "Players", "RunService" },
		code = [[
local function _camMode(mode)
	local camera = _cam()
	if camera == nil then
		return
	end
	local etat = _camEtat()
	local texte = string.lower(_texte(mode))
	local alias = {
		normal = "normale",
		["première personne"] = "premiere",
		["premiere personne"] = "premiere",
		["première"] = "premiere",
		["vue de dessus"] = "dessus",
		["côté"] = "cote",
		["vue de côté"] = "cote",
		["vue de cote"] = "cote",
		["vue de côté (2d)"] = "cote",
		["2d"] = "cote",
		["épaule"] = "epaule",
		["fixe ici"] = "fixe",
	}
	local code = alias[texte] or texte
	local connus = { normale = true, premiere = true, dessus = true, cote = true, epaule = true, fixe = true }
	if not connus[code] then
		_tpAvertirUneFois(etat, "mode:" .. texte, "« mode de caméra » : mode inconnu « " .. _texte(mode) .. " » (normale, première personne, vue de dessus, vue de côté, épaule ou fixe).")
		return
	end
	if code == "fixe" then
		_camSortirPremiere()
		_camFixe(camera.CFrame, nil, false)
		return
	end
	_camArreter()
	if code == "dessus" or code == "cote" then
		_camSortirPremiere()
		local decalage = Vector3.new(0, 40, 12)
		if code == "cote" then
			decalage = Vector3.new(0, 4, 30)
		end
		etat.vue = code
		local function image()
			local cam = workspace.CurrentCamera
			local _, _, racine = _camPerso()
			if cam == nil or racine == nil then
				return
			end
			if cam.CameraType ~= Enum.CameraType.Scriptable then
				cam.CameraType = Enum.CameraType.Scriptable
			end
			local centre = racine.Position
			cam.CFrame = CFrame.lookAt(centre + decalage, centre)
		end
		image()
		RunService:BindToRenderStep("BlocsFR_Camera", Enum.RenderPriority.Camera.Value, image)
		return
	end
	-- normale, première personne et épaule : la caméra de Roblox suit le personnage
	camera.CameraType = Enum.CameraType.Custom
	local _, h = _camPerso()
	if h then
		camera.CameraSubject = h
	end
	if code == "premiere" then
		etat.vue = "premiere"
		local joueurLocal = Players.LocalPlayer
		if joueurLocal ~= nil then
			joueurLocal.CameraMode = Enum.CameraMode.LockFirstPerson
		end
		return
	end
	_camSortirPremiere()
	if code == "epaule" then
		etat.vue = "epaule"
		local function image()
			local _, hum = _camPerso()
			if hum == nil then
				return
			end
			local voulu = Vector3.new(2, 1, 0) + (etat.decalage or Vector3.zero)
			if hum.CameraOffset ~= voulu then
				hum.CameraOffset = voulu
			end
		end
		image()
		RunService:BindToRenderStep("BlocsFR_Camera", Enum.RenderPriority.Camera.Value - 1, image)
	end
end]],
	},

	-- « fixer la caméra sur … regardant … » (position : nom, objet ou Vector3) et « faire regarder la
	-- caméra vers … » (position nil : la caméra garde sa place). La caméra suit la cible des yeux.
	_camViser = {
		deps = { "_cam", "_camEtat", "_camTrouver", "_camFixe", "_pivot", "_pos", "_tpAvertirUneFois" },
		services = { "Players" },
		code = [[
local function _camViser(position, cible)
	local camera = _cam()
	if camera == nil then
		return
	end
	local etat = _camEtat()
	local depart = camera.CFrame
	if position ~= nil then
		local source = _camTrouver(position, false)
		local cf = nil
		if typeof(source) == "Vector3" then
			cf = CFrame.new(source)
		elseif source ~= nil then
			cf = _pivot(source)
		end
		if cf == nil then
			local conseil = ""
			if workspace.StreamingEnabled then
				conseil = " (le Streaming est activé : un objet loin du joueur n'est peut-être pas encore chargé)"
			end
			_tpAvertirUneFois(etat, "fixer:" .. tostring(position), "« fixer la caméra » : « " .. tostring(position) .. " » est introuvable" .. conseil .. ". Crée une partie avec ce nom (transparente, ancrée et sans collision) à l'endroit où tu veux la caméra.")
			return
		end
		depart = cf
	end
	local vise = _camTrouver(cible, true)
	if typeof(vise) == "CFrame" then
		vise = vise.Position
	end
	local suivrePerso = false
	local joueurLocal = Players.LocalPlayer
	local perso = nil
	if joueurLocal ~= nil then
		perso = joueurLocal.Character
	end
	if typeof(vise) == "Instance" and perso ~= nil and (vise == perso or vise:IsDescendantOf(perso)) then
		suivrePerso = true
	elseif vise == nil and cible ~= nil then
		_tpAvertirUneFois(etat, "viser:" .. tostring(cible), "« regarder » : la cible « " .. tostring(cible) .. " » est introuvable, la caméra garde sa direction.")
	elseif typeof(vise) == "Instance" and _pos(vise) == nil then
		-- par exemple « cet objet » quand le script est dans StarterPlayerScripts
		_tpAvertirUneFois(etat, "viser:position:" .. vise:GetFullName(), "« regarder » : « " .. vise.Name .. " » n'a pas de position (choisis une partie, un modèle ou un personnage) : la caméra garde sa direction.")
	end
	_camFixe(depart, vise, suivrePerso)
end]],
	},

	-- « déplacer la caméra vers … en … s » : trajet en douceur jusqu'à la place (et l'orientation)
	-- d'un objet ; le script attend la fin. Une autre commande de caméra annule le trajet.
	_camAllerVers = {
		deps = {
			"_cam",
			"_camEtat",
			"_camTrouver",
			"_camArreter",
			"_camFixe",
			"_pivot",
			"_nombreOu",
			"_tpAvertirUneFois",
		},
		services = { "TweenService" },
		code = [[
local function _camAllerVers(cible, duree)
	local camera = _cam()
	if camera == nil then
		return
	end
	local etat = _camEtat()
	local objet = _camTrouver(cible, false)
	local arrivee = nil
	if typeof(objet) == "Vector3" then
		arrivee = CFrame.new(objet) * camera.CFrame.Rotation
	elseif objet ~= nil then
		arrivee = _pivot(objet)
	end
	if arrivee == nil then
		local conseil = ""
		if workspace.StreamingEnabled then
			conseil = " (le Streaming est activé : un objet loin du joueur n'est peut-être pas encore chargé)"
		end
		_tpAvertirUneFois(etat, "aller:" .. tostring(cible), "« déplacer la caméra » : « " .. tostring(cible) .. " » est introuvable" .. conseil .. ". Crée une partie avec ce nom : la caméra prendra sa place et regardera dans la direction de sa face avant.")
		return
	end
	_camArreter()
	camera.CameraType = Enum.CameraType.Scriptable
	local d = math.clamp(_nombreOu(duree, 0), 0, 600)
	if d <= 0 then
		_camFixe(arrivee, nil, false)
		return
	end
	local tween = TweenService:Create(camera, TweenInfo.new(d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = arrivee })
	etat.tween = tween
	tween:Play()
	local debut = os.clock()
	while etat.tween == tween and os.clock() - debut < d + 2 do
		local lecture = tween.PlaybackState
		if lecture == Enum.PlaybackState.Completed or lecture == Enum.PlaybackState.Cancelled then
			break
		end
		-- dort jusqu'à la fin prévue du trajet, puis vérifie toutes les 0,03 s
		task.wait(math.clamp(debut + d - os.clock(), 0.03, 0.25))
	end
	if etat.tween == tween then
		etat.tween = nil
		_camFixe(arrivee, nil, false)
	end
end]],
	},

	-- « faire suivre la caméra à … » : caméra normale (Custom) qui suit un autre objet
	_camSuivre = {
		deps = { "_cam", "_camEtat", "_camTrouver", "_camArreter", "_camPerso", "_tpAvertirUneFois" },
		services = {},
		code = [[
local function _camSuivre(cible)
	local camera = _cam()
	if camera == nil then
		return
	end
	local objet = _camTrouver(cible, true)
	local sujet = nil
	if typeof(objet) == "Instance" then
		if objet:IsA("Humanoid") or objet:IsA("BasePart") then
			sujet = objet
		elseif objet:IsA("Model") then
			sujet = objet:FindFirstChildOfClass("Humanoid") or objet.PrimaryPart or objet:FindFirstChildWhichIsA("BasePart", true)
		else
			sujet = objet:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	if sujet == nil then
		_tpAvertirUneFois(_camEtat(), "suivre:" .. tostring(cible), "« faire suivre la caméra » : rien à suivre pour « " .. tostring(cible) .. " » (il faut une partie, un modèle ou un personnage).")
		return
	end
	_camArreter()
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = sujet
	local _, h = _camPerso()
	if sujet ~= h then
		-- remis après une réapparition (Roblox refait alors suivre le nouveau personnage)
		_camEtat().sujet = sujet
	end
end]],
	},

	-- « faire trembler la caméra » : décalage au hasard qui diminue, appliqué juste après la mise à
	-- jour de la caméra. Une caméra fixe (que personne ne bouge) est remise exactement à sa place.
	_camTrembler = {
		deps = { "_cam", "_camEtat", "_nombreOu" },
		services = { "RunService" },
		code = [[
local function _camTrembler(force, duree)
	if _cam() == nil then
		return
	end
	local etat = _camEtat()
	local f = math.clamp(_nombreOu(force, 0.5), 0, 10)
	local d = math.clamp(_nombreOu(duree, 0.4), 0, 30)
	if f <= 0 or d <= 0 then
		return
	end
	local maintenant = os.clock()
	local ancien = etat.tremble
	if ancien ~= nil and ancien.fin > maintenant then
		-- un tremblement est déjà en cours : on garde le plus fort et le plus long des deux
		local resteAncien = ancien.fin - maintenant
		f = math.max(f, ancien.force * resteAncien / math.max(ancien.fin - ancien.debut, 0.001))
		d = math.max(d, resteAncien)
	end
	etat.tremble = { force = f, debut = maintenant, fin = maintenant + d }
	local function image()
		local camera = workspace.CurrentCamera
		if camera == nil then
			return
		end
		local actuel = camera.CFrame
		local ecrit = etat.trembleEcrit
		if ecrit ~= nil and etat.trembleBase ~= nil and (actuel.Position - ecrit.Position).Magnitude < 0.001 and actuel.LookVector:Dot(ecrit.LookVector) > 0.99999 then
			-- personne n'a bougé la caméra depuis l'image précédente : on repart de sa vraie place
			actuel = etat.trembleBase
		end
		local t = etat.tremble
		local reste = 0
		if t ~= nil then
			reste = t.fin - os.clock()
		end
		if reste <= 0 then
			camera.CFrame = actuel
			etat.tremble = nil
			etat.trembleBase = nil
			etat.trembleEcrit = nil
			RunService:UnbindFromRenderStep("BlocsFR_Tremblement")
			return
		end
		local amplitude = t.force * reste / math.max(t.fin - t.debut, 0.001)
		local decalage = Vector3.new((math.random() * 2 - 1) * amplitude, (math.random() * 2 - 1) * amplitude, (math.random() * 2 - 1) * amplitude * 0.3)
		etat.trembleBase = actuel
		etat.trembleEcrit = actuel * CFrame.new(decalage)
		camera.CFrame = etat.trembleEcrit
	end
	pcall(function()
		RunService:UnbindFromRenderStep("BlocsFR_Tremblement")
	end)
	RunService:BindToRenderStep("BlocsFR_Tremblement", Enum.RenderPriority.Camera.Value + 1, image)
end]],
	},

	-- « mettre le champ de vision à … en … s » (1 à 120) ; ne fait pas attendre le script
	_camChampVision = {
		deps = { "_cam", "_camEtat", "_nombreOu" },
		services = { "TweenService" },
		code = [[
local function _camChampVision(fov, duree)
	local camera = _cam()
	if camera == nil then
		return
	end
	local etat = _camEtat()
	local valeur = math.clamp(_nombreOu(fov, 70), 1, 120)
	local d = math.clamp(_nombreOu(duree, 0), 0, 60)
	local ancien = etat.tweenFov
	etat.tweenFov = nil
	if ancien ~= nil then
		pcall(function()
			ancien:Cancel()
		end)
	end
	if d <= 0 then
		camera.FieldOfView = valeur
		return
	end
	local tween = TweenService:Create(camera, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = valeur })
	etat.tweenFov = tween
	tween:Play()
end]],
	},

	-- « distance de zoom entre … et … » : limites de la molette du joueur local (0,5 à 400 studs)
	_camDistance = {
		deps = { "_cam", "_nombreOu" },
		services = { "Players" },
		code = [[
local function _camDistance(mini, maxi)
	if _cam() == nil then
		return
	end
	local joueurLocal = Players.LocalPlayer
	if joueurLocal == nil then
		return
	end
	local a = math.clamp(_nombreOu(mini, 0.5), 0.5, 400)
	local b = math.clamp(_nombreOu(maxi, 400), 0.5, 400)
	if a > b then
		a, b = b, a
	end
	-- dans cet ordre, le minimum ne dépasse jamais le maximum (Roblox corrigerait la valeur)
	pcall(function()
		joueurLocal.CameraMinZoomDistance = math.min(joueurLocal.CameraMinZoomDistance, a)
		joueurLocal.CameraMaxZoomDistance = b
		joueurLocal.CameraMinZoomDistance = a
	end)
end]],
	},

	-- « vue à la première personne oui / non »
	_camPremierePersonne = {
		deps = { "_cam", "_camEtat", "_camArreter", "_camSortirPremiere", "_camPerso" },
		services = { "Players" },
		code = [[
local function _camPremierePersonne(actif)
	local camera = _cam()
	local joueurLocal = Players.LocalPlayer
	if camera == nil or joueurLocal == nil then
		return
	end
	local etat = _camEtat()
	if actif == false or actif == nil then
		if etat.vue == "premiere" then
			etat.vue = nil
		end
		_camSortirPremiere()
		return
	end
	if etat.vue ~= "premiere" then
		_camArreter()
	end
	camera.CameraType = Enum.CameraType.Custom
	local _, h = _camPerso()
	if h then
		camera.CameraSubject = h
	end
	etat.vue = "premiere"
	joueurLocal.CameraMode = Enum.CameraMode.LockFirstPerson
end]],
	},

	-- « décaler la caméra » : Humanoid.CameraOffset, gardé dans l'état et remis après une réapparition
	_camDecaler = {
		deps = { "_cam", "_camEtat", "_camPerso", "_nombreOu" },
		services = {},
		code = [[
local function _camDecaler(x, y, z)
	if _cam() == nil then
		return
	end
	local etat = _camEtat()
	etat.decalage = Vector3.new(math.clamp(_nombreOu(x, 0), -100, 100), math.clamp(_nombreOu(y, 0), -100, 100), math.clamp(_nombreOu(z, 0), -100, 100))
	if etat.vue ~= "epaule" then
		local _, h = _camPerso()
		if h then
			h.CameraOffset = etat.decalage
		end
	end
end]],
	},

	-- « flou de la caméra » : BlurEffect « BlocsFR_Flou » dans la caméra (0 = enlevé)
	_camFlou = {
		deps = { "_cam", "_nombreOu" },
		services = { "TweenService" },
		code = [[
local function _camFlou(taille)
	local camera = _cam()
	if camera == nil then
		return
	end
	local valeur = math.clamp(_nombreOu(taille, 0), 0, 56)
	local flou = camera:FindFirstChild("BlocsFR_Flou")
	if flou ~= nil and not flou:IsA("BlurEffect") then
		flou = nil
	end
	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if valeur <= 0 then
		if flou ~= nil then
			local tween = TweenService:Create(flou, info, { Size = 0 })
			tween.Completed:Once(function(fin)
				if fin == Enum.PlaybackState.Completed and flou.Parent ~= nil then
					flou:Destroy()
				end
			end)
			tween:Play()
		end
		return
	end
	if flou == nil then
		flou = Instance.new("BlurEffect")
		flou.Name = "BlocsFR_Flou"
		flou.Size = 0
		flou.Parent = camera
	end
	TweenService:Create(flou, info, { Size = valeur }):Play()
end]],
	},

	-- « teinte de l'écran » : ColorCorrectionEffect « BlocsFR_Teinte » dans la caméra
	-- (TintColor = blanc mélangé à la couleur selon l'intensité ; 0 = enlevée)
	_camTeinte = {
		deps = { "_cam", "_camEtat", "_versColor3", "_nombreOu", "_tpAvertirUneFois" },
		services = { "TweenService" },
		code = [[
local function _camTeinte(couleur, intensite)
	local camera = _cam()
	if camera == nil then
		return
	end
	local c = _versColor3(couleur)
	if c == nil then
		_tpAvertirUneFois(_camEtat(), "teinte:" .. tostring(couleur), "« teinte de l'écran » : couleur invalide (" .. tostring(couleur) .. ").")
		return
	end
	local force = math.clamp(_nombreOu(intensite, 0), 0, 1)
	local effet = camera:FindFirstChild("BlocsFR_Teinte")
	if effet ~= nil and not effet:IsA("ColorCorrectionEffect") then
		effet = nil
	end
	local blanc = Color3.new(1, 1, 1)
	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if force <= 0 then
		if effet ~= nil then
			local tween = TweenService:Create(effet, info, { TintColor = blanc })
			tween.Completed:Once(function(fin)
				if fin == Enum.PlaybackState.Completed and effet.Parent ~= nil then
					effet:Destroy()
				end
			end)
			tween:Play()
		end
		return
	end
	if effet == nil then
		effet = Instance.new("ColorCorrectionEffect")
		effet.Name = "BlocsFR_Teinte"
		effet.TintColor = blanc
		effet.Parent = camera
	end
	TweenService:Create(effet, info, { TintColor = blanc:Lerp(c, force) }):Play()
end]],
	},

	-- « bandes de cinéma » : ScreenGui « BlocsFR_Cinema » (deux bandes noires de 12 % qui glissent)
	_camBandes = {
		deps = { "_cam", "_avertir" },
		services = { "Players", "TweenService" },
		code = [[
local function _camBandes(actif)
	if _cam() == nil then
		return
	end
	local joueurLocal = Players.LocalPlayer
	local interface = nil
	if joueurLocal ~= nil then
		interface = joueurLocal:FindFirstChildOfClass("PlayerGui") or joueurLocal:WaitForChild("PlayerGui", 5)
	end
	if interface == nil then
		_avertir("« bandes de cinéma » : l'écran du joueur est introuvable.")
		return
	end
	local ecran = interface:FindFirstChild("BlocsFR_Cinema")
	if ecran ~= nil and not ecran:IsA("ScreenGui") then
		ecran = nil
	end
	local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if actif == false or actif == nil then
		if ecran == nil then
			return
		end
		ecran:SetAttribute("BlocsFR_Actif", false)
		local hautSortie = ecran:FindFirstChild("Haut")
		local basSortie = ecran:FindFirstChild("Bas")
		if hautSortie then
			TweenService:Create(hautSortie, info, { Position = UDim2.fromScale(0, 0) }):Play()
		end
		if basSortie then
			TweenService:Create(basSortie, info, { Position = UDim2.fromScale(0, 1) }):Play()
		end
		task.delay(0.45, function()
			if ecran.Parent ~= nil and ecran:GetAttribute("BlocsFR_Actif") == false then
				ecran:Destroy()
			end
		end)
		return
	end
	if ecran == nil then
		ecran = Instance.new("ScreenGui")
		ecran.Name = "BlocsFR_Cinema"
		ecran.DisplayOrder = 100
		ecran.IgnoreGuiInset = true
		ecran.ResetOnSpawn = false
		ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		for _, nom in ipairs({ "Haut", "Bas" }) do
			local bande = Instance.new("Frame")
			bande.Name = nom
			bande.Size = UDim2.fromScale(1, 0.12)
			bande.BackgroundColor3 = Color3.new(0, 0, 0)
			bande.BorderSizePixel = 0
			if nom == "Haut" then
				-- ancrée par le bas : en position 0, elle est juste au-dessus de l'écran
				bande.AnchorPoint = Vector2.new(0, 1)
				bande.Position = UDim2.fromScale(0, 0)
			else
				bande.AnchorPoint = Vector2.new(0, 0)
				bande.Position = UDim2.fromScale(0, 1)
			end
			bande.Parent = ecran
		end
		ecran.Parent = interface
	end
	ecran:SetAttribute("BlocsFR_Actif", true)
	local haut = ecran:FindFirstChild("Haut")
	local bas = ecran:FindFirstChild("Bas")
	if haut then
		TweenService:Create(haut, info, { Position = UDim2.fromScale(0, 0.12) }):Play()
	end
	if bas then
		TweenService:Create(bas, info, { Position = UDim2.fromScale(0, 0.88) }):Play()
	end
end]],
	},

	-- « bloquer la souris au centre » : la liaison « BlocsFR_Souris » remet LockCenter à chaque
	-- image (les scripts de caméra de Roblox changent MouseBehavior)
	_camSouris = {
		deps = { "_cam" },
		services = { "RunService", "UserInputService" },
		code = [[
local function _camSouris(actif)
	if _cam() == nil then
		return
	end
	pcall(function()
		RunService:UnbindFromRenderStep("BlocsFR_Souris")
	end)
	if actif == false or actif == nil then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		return
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	RunService:BindToRenderStep("BlocsFR_Souris", Enum.RenderPriority.Camera.Value + 2, function()
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	end)
end]],
	},

	-- « remettre la caméra normale » : annule toutes les vues et tous les effets de caméra
	_camNormale = {
		deps = { "_cam", "_camEtat", "_camArreter", "_camSortirPremiere", "_camPerso", "_camBandes" },
		services = { "RunService", "UserInputService" },
		code = [[
local function _camNormale()
	local camera = _cam()
	if camera == nil then
		return
	end
	local etat = _camEtat()
	_camArreter()
	pcall(function()
		RunService:UnbindFromRenderStep("BlocsFR_Tremblement")
	end)
	pcall(function()
		RunService:UnbindFromRenderStep("BlocsFR_Souris")
	end)
	etat.tremble = nil
	etat.trembleBase = nil
	etat.trembleEcrit = nil
	local tweenFov = etat.tweenFov
	etat.tweenFov = nil
	if tweenFov ~= nil then
		pcall(function()
			tweenFov:Cancel()
		end)
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	etat.decalage = Vector3.zero
	camera.CameraType = Enum.CameraType.Custom
	local _, h = _camPerso()
	if h then
		camera.CameraSubject = h
		h.CameraOffset = Vector3.zero
	end
	camera.FieldOfView = 70
	_camSortirPremiere()
	for _, nom in ipairs({ "BlocsFR_Flou", "BlocsFR_Teinte" }) do
		local effet = camera:FindFirstChild(nom)
		if effet then
			effet:Destroy()
		end
	end
	_camBandes(false)
end]],
	},

	-- « objet visé par la souris » : rayon de 500 studs depuis la caméra, sans le personnage local.
	-- Un seul RaycastParams (gardé dans l'état de la caméra) : ce bloc peut être lu à chaque image.
	_camObjetVise = {
		deps = { "_camEtat", "_camPerso", "_tpAvertirUneFois" },
		services = { "RunService", "UserInputService" },
		code = [[
local function _camObjetVise()
	if not RunService:IsClient() then
		_tpAvertirUneFois(_camEtat(), "serveur", "La caméra n'existe que chez le joueur : utilise un script local (bouton « Script local ») pour les blocs Caméra.")
		return nil
	end
	local camera = workspace.CurrentCamera
	if camera == nil then
		return nil
	end
	local souris = UserInputService:GetMouseLocation()
	local rayon = camera:ViewportPointToRay(souris.X, souris.Y)
	local etat = _camEtat()
	local params = etat.paramsVise
	if params == nil then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		etat.paramsVise = params
	end
	local perso = _camPerso()
	if perso ~= nil then
		params.FilterDescendantsInstances = { perso }
	else
		params.FilterDescendantsInstances = {}
	end
	local resultat = workspace:Raycast(rayon.Origin, rayon.Direction * 500, params)
	if resultat ~= nil then
		return resultat.Instance
	end
	return nil
end]],
	},
}

return {
	category = "camera",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Defs_Controle</string><ProtectedString name="Source"><![CDATA[-- Defs_Controle : blocs « Contrôle » (attentes, boucles, conditions, parallèle, messages, arrêt).
-- Les fonctions d'envoi de messages (_envoyerMessage, _envoyerMessageClients, _envoyerMessageJoueur,
-- _envoyerMessageServeur) sont définies dans Defs_Evenements (CodeGen résout les aides globalement).
--
-- NOTE: « répéter jusqu'à ce que » suit Scratch : la condition est vérifiée AVANT chaque tour
-- (si elle est déjà vraie, les blocs à l'intérieur ne s'exécutent pas).
-- NOTE: « pour … allant de … à … » compte vers le bas (pas de -1) quand « de » est plus grand que « à ».

local Util = require(script.Parent.Util)
local Shared = require(script.Parent.Shared)

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

-- Code indenté d'un niveau, précédé d'un saut de ligne ("" si le code est vide)
local function corps(g, code)
	if code == nil or code == "" then
		return ""
	end
	return "\n" .. g.indent(code)
end

-- Valeur d'un littéral numérique ("12", "(-3)") ou nil si l'expression n'est pas un littéral
local function litNum(expr)
	if not Util.isNumberLiteral(expr) then
		return nil
	end
	return tonumber((string.gsub(expr, "[%(%)]", "")))
end

local MOTS_SORTIE = { ["break"] = true, ["return"] = true, ["continue"] = true }

-- Vrai si le code (corps non indenté) se termine par break / return / continue
-- (ces instructions doivent être les dernières de leur bloc en Luau). Un faux positif est sans
-- danger (le code est seulement placé dans un bloc do … end), on vérifie donc largement :
-- toute ligne de premier niveau qui commence par un de ces mots, ou la dernière ligne utile.
local function finitParSortie(code)
	local derniere = nil
	for ligne in string.gmatch(code, "[^\n]+") do
		local motPremierNiveau = string.match(ligne, "^([%a_][%w_]*)")
		if motPremierNiveau and MOTS_SORTIE[motPremierNiveau] then
			return true
		end
		-- on ignore les lignes vides et les commentaires
		if string.find(ligne, "%S") and not string.find(ligne, "^%s*%-%-") then
			derniere = ligne
		end
	end
	if derniere == nil then
		return false
	end
	local mot = string.match(derniere, "^%s*([%a_][%w_]*)")
	return mot ~= nil and MOTS_SORTIE[mot] == true
end

-- Corps d'une boucle qui cède la main à chaque tour : le code puis task.wait().
-- Si le code se termine par break/return, il est placé dans un bloc do … end pour rester valide.
local function corpsAvecPause(g, code)
	if code == nil or code == "" then
		return "\n\ttask.wait()"
	end
	if finitParSortie(code) then
		return "\n\tdo\n" .. g.indent(g.indent(code)) .. "\n\tend\n\ttask.wait()"
	end
	return "\n" .. g.indent(code) .. "\n\ttask.wait()"
end

-- Expression booléenne entre parenthèses (pour « not (…) »)
local function entreParentheses(expr)
	if expr == nil or expr == "" then
		return "(false)"
	end
	return "(" .. expr .. ")"
end

-- Condition d'un bloc si / tant que / jusqu'à. Un bloc branché dans la case (a.raw.COND == nil)
-- peut être un bloc rond (variable, valeur partagée…) : sa valeur passe par _vrai, qui suit Scratch
-- (0, "", « faux »… sont faux) au lieu de la règle Luau où tout sauf nil / false est vrai.
-- Pour un vrai bloc condition, _vrai donne le même résultat.
local function condition(a, g)
	local cond = a.COND
	if cond == nil or cond == "" then
		return "false"
	end
	if type(a.raw) ~= "table" or a.raw.COND == nil then
		cond = g.helper("_vrai") .. "(" .. cond .. ")"
	end
	return cond
end

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "ctrl_attendre",
		shape = "stack",
		label = "attendre %1 secondes",
		inputs = { { name = "SECONDES", kind = "number", default = 1 } },
		keywords = "attendre pause patienter délai wait secondes temps",
		tooltip = "Met ce script en pause pendant le nombre de secondes indiqué, puis continue.",
		gen = function(a, g)
			return "task.wait(" .. g.num(a.SECONDES) .. ")"
		end,
	},
	{
		id = "ctrl_repeter",
		shape = "c",
		label = "répéter %1 fois",
		inputs = { { name = "FOIS", kind = "number", default = 10 } },
		loop = true,
		keywords = "répéter boucle fois plusieurs for loop recommencer",
		tooltip = "Répète les blocs à l'intérieur le nombre de fois indiqué, sans pause entre les tours.",
		gen = function(a, g)
			local tour = g.uid("tour")
			return "for " .. tour .. " = 1, " .. g.num(a.FOIS) .. " do" .. corps(g, a.DO) .. "\nend"
		end,
	},
	{
		id = "ctrl_toujours",
		shape = "c",
		label = "répéter indéfiniment",
		inputs = {},
		loop = true,
		noNext = true,
		keywords = "répéter indéfiniment toujours boucle infinie sans fin forever while true loop",
		tooltip = "Répète les blocs à l'intérieur sans jamais s'arrêter. Une très courte pause est faite à chaque tour pour ne pas bloquer le jeu.",
		gen = function(a, g)
			return "while true do" .. corpsAvecPause(g, a.DO) .. "\nend"
		end,
	},
	{
		id = "ctrl_si",
		shape = "c",
		label = "si %1 alors",
		inputs = { { name = "COND", kind = "boolean" } },
		keywords = "si alors condition test if vérifier",
		tooltip = "Exécute les blocs à l'intérieur seulement si la condition est vraie.",
		gen = function(a, g)
			return "if " .. condition(a, g) .. " then" .. corps(g, a.DO) .. "\nend"
		end,
	},
	{
		id = "ctrl_si_sinon",
		shape = "c2",
		label = "si %1 alors",
		label2 = "sinon",
		inputs = { { name = "COND", kind = "boolean" } },
		keywords = "si alors sinon condition test if else autrement",
		tooltip = "Si la condition est vraie, exécute la première partie ; sinon, exécute la partie « sinon ».",
		gen = function(a, g)
			local code = "if " .. condition(a, g) .. " then" .. corps(g, a.DO)
			if a.ELSE ~= nil and a.ELSE ~= "" then
				code = code .. "\nelse" .. corps(g, a.ELSE)
			end
			return code .. "\nend"
		end,
	},
	{
		id = "ctrl_tant_que",
		shape = "c",
		label = "tant que %1",
		inputs = { { name = "COND", kind = "boolean" } },
		loop = true,
		keywords = "tant que boucle condition while pendant répéter",
		tooltip = "Répète les blocs à l'intérieur tant que la condition est vraie (une très courte pause est faite à chaque tour).",
		gen = function(a, g)
			return "while " .. condition(a, g) .. " do" .. corpsAvecPause(g, a.DO) .. "\nend"
		end,
	},
	{
		id = "ctrl_repeter_jusqua",
		shape = "c",
		label = "répéter jusqu'à ce que %1",
		inputs = { { name = "COND", kind = "boolean" } },
		loop = true,
		keywords = "répéter jusqu'à jusqua condition boucle until repeat",
		tooltip = "Répète les blocs à l'intérieur jusqu'à ce que la condition devienne vraie. La condition est vérifiée avant chaque tour (une très courte pause est faite à chaque tour).",
		gen = function(a, g)
			return "while not " .. entreParentheses(condition(a, g)) .. " do" .. corpsAvecPause(g, a.DO) .. "\nend"
		end,
	},
	{
		id = "ctrl_attendre_jusqua",
		shape = "stack",
		label = "attendre jusqu'à ce que %1",
		inputs = { { name = "COND", kind = "boolean" } },
		keywords = "attendre jusqu'à jusqua condition pause patienter wait until",
		tooltip = "Met ce script en pause jusqu'à ce que la condition soit vraie.",
		gen = function(a, g)
			return "while not " .. entreParentheses(condition(a, g)) .. " do\n\ttask.wait()\nend"
		end,
	},
	{
		id = "ctrl_pour",
		shape = "c",
		label = "pour %1 allant de %2 à %3",
		inputs = {
			{ name = "VAR", kind = "variable" },
			{ name = "DE", kind = "number", default = 1 },
			{ name = "A", kind = "number", default = 10 },
		},
		loop = true,
		keywords = "pour allant de à boucle compter compteur variable for each chaque",
		tooltip = "Répète les blocs à l'intérieur en donnant à la variable les valeurs de « de » jusqu'à « à », de 1 en 1 (en comptant vers le bas si « de » est plus grand que « à »).",
		gen = function(a, g)
			local compteur = g.uid("i")
			local de, fin = g.num(a.DE), g.num(a.A)
			local interieur = a.VAR .. " = " .. compteur
			if a.DO ~= nil and a.DO ~= "" then
				interieur = interieur .. "\n" .. a.DO
			end
			local nDe, nFin = litNum(de), litNum(fin)
			if nDe and nFin then
				local pas = ""
				if nFin < nDe then
					pas = ", -1"
				end
				return "for " .. compteur .. " = " .. de .. ", " .. fin .. pas .. " do" .. corps(g, interieur) .. "\nend"
			end
			local vDe, vFin = g.uid("de"), g.uid("a")
			local boucle = "for " .. compteur .. " = " .. vDe .. ", " .. vFin .. ", (" .. vFin .. " >= " .. vDe .. ") and 1 or -1 do"
				.. corps(g, interieur)
				.. "\nend"
			return "do\n\tlocal " .. vDe .. ", " .. vFin .. " = " .. de .. ", " .. fin .. corps(g, boucle) .. "\nend"
		end,
	},
	{
		id = "ctrl_parallele",
		shape = "c",
		label = "lancer en parallèle",
		inputs = {},
		newFunction = true,
		keywords = "parallèle en même temps simultané lancer thread spawn tâche",
		tooltip = "Lance les blocs à l'intérieur en même temps que la suite : les blocs placés en dessous n'attendent pas qu'ils soient terminés.",
		gen = function(a, g)
			return "task.spawn(function()" .. corps(g, a.DO) .. "\nend)"
		end,
	},
	{
		id = "ctrl_apres",
		shape = "c",
		label = "après %1 secondes, faire",
		inputs = { { name = "SECONDES", kind = "number", default = 1 } },
		newFunction = true,
		keywords = "après plus tard délai différé retardement minuterie delay faire",
		tooltip = "Programme les blocs à l'intérieur pour qu'ils s'exécutent après le délai indiqué, sans mettre la suite du script en pause.",
		gen = function(a, g)
			return "task.delay(" .. g.num(a.SECONDES) .. ", function()" .. corps(g, a.DO) .. "\nend)"
		end,
	},
	{
		id = "ctrl_envoyer_message",
		shape = "stack",
		label = "envoyer le message %1",
		inputs = { { name = "MESSAGE", kind = "text", default = "message1" } },
		keywords = "envoyer message diffuser signal broadcast événement communiquer",
		tooltip = "Envoie un message aux blocs « Quand je reçois le message » du même côté (les scripts serveur entre eux, ou les scripts locaux d'un joueur entre eux). Un script qui n'a pas encore démarré ne reçoit pas le message.",
		gen = function(a, g)
			local fonction = g.helper("_envoyerMessage")
			if g.mode == "local" then
				return fonction .. "(" .. a.MESSAGE .. ")"
			end
			-- script serveur : le joueur du contexte accompagne le message
			return fonction .. "(" .. a.MESSAGE .. ", joueur)"
		end,
	},
	{
		id = "ctrl_envoyer_message_tous",
		shape = "stack",
		label = "envoyer le message %1 à tous les joueurs",
		inputs = { { name = "MESSAGE", kind = "text", default = "message1" } },
		scriptType = "server",
		keywords = "envoyer message tous les joueurs clients diffuser réseau remote broadcast",
		tooltip = "Script serveur : envoie le message aux scripts locaux de tous les joueurs (reçu par « Quand je reçois le message »).",
		gen = function(a, g)
			return g.helper("_envoyerMessageClients") .. "(" .. a.MESSAGE .. ")"
		end,
	},
	{
		id = "ctrl_envoyer_message_joueur",
		shape = "stack",
		label = "envoyer le message %1 au joueur %2",
		inputs = {
			{ name = "MESSAGE", kind = "text", default = "message1" },
			Shared.playerInput("JOUEUR"),
		},
		scriptType = "server",
		keywords = "envoyer message joueur client réseau remote un seul",
		tooltip = "Script serveur : envoie le message aux scripts locaux d'un seul joueur.",
		gen = function(a, g)
			return g.helper("_envoyerMessageJoueur") .. "(" .. a.MESSAGE .. ", " .. a.JOUEUR .. ")"
		end,
	},
	{
		id = "ctrl_envoyer_message_serveur",
		shape = "stack",
		label = "envoyer le message %1 au serveur",
		inputs = { { name = "MESSAGE", kind = "text", default = "message1" } },
		scriptType = "local",
		keywords = "envoyer message serveur réseau remote client",
		tooltip = "Script local : envoie le message aux scripts serveur. Là-bas, « le joueur » est le joueur qui l'a envoyé.",
		gen = function(a, g)
			return g.helper("_envoyerMessageServeur") .. "(" .. a.MESSAGE .. ")"
		end,
	},
	{
		id = "ctrl_sortir_boucle",
		shape = "cap",
		label = "sortir de la boucle",
		inputs = {},
		keywords = "sortir quitter boucle arrêter interrompre break stop",
		tooltip = "Quitte immédiatement la boucle qui contient ce bloc (répéter, tant que, pour…) ; le script continue après la boucle.",
		gen = function(a, g)
			if g.inLoop() then
				return "break"
			end
			g.warn("« sortir de la boucle » n'est dans aucune boucle : ce bloc a été ignoré.")
			return "-- sortir de la boucle : ignoré (ce bloc n'est dans aucune boucle)"
		end,
	},
	{
		id = "ctrl_arreter",
		shape = "cap",
		label = "arrêter ce script",
		inputs = {},
		keywords = "arrêter stopper terminer fin script désactiver stop",
		tooltip = "Arrête complètement ce script : plus aucun de ses événements ne s'exécutera. Dans un script module (qu'on ne peut pas désactiver), il arrête seulement la fonction ou l'événement en cours.",
		gen = function(a, g)
			if g.mode == "module" then
				-- un ModuleScript n'a pas de propriété Enabled (SPEC §20) : on termine seulement la fonction en
				-- cours (« Quand le module est chargé » est aussi une fonction : voir Defs_Modules)
				return "return"
			end
			return "script.Enabled = false\nreturn"
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- Valeur d'une condition, comme dans Scratch : faux pour rien (nil), faux, 0, un nombre invalide,
	-- un texte vide et les textes « faux », « false », « non », « 0 » (majuscules ignorées) ; vrai sinon
	_vrai = {
		deps = {},
		services = {},
		code = [[
local function _vrai(valeur)
	if valeur == nil or valeur == false then
		return false
	end
	if type(valeur) == "number" then
		return valeur == valeur and valeur ~= 0
	end
	if type(valeur) == "string" then
		local texte = string.lower((string.gsub(valeur, "^%s*(.-)%s*$", "%1")))
		if texte == "" or texte == "faux" or texte == "false" or texte == "non" then
			return false
		end
		local n = tonumber(texte)
		if n ~= nil then
			return n == n and n ~= 0
		end
	end
	return true
end]],
	},
}

return {
	category = "controle",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Defs_Debogage</string><ProtectedString name="Source"><![CDATA[-- Defs_Debogage : blocs « Débogage » (sortie, avertissements, erreurs, commentaires, chronomètre).

local blocks = {
	{
		id = "dbg_afficher",
		shape = "stack",
		label = "afficher %1 dans la sortie",
		inputs = { { name = "VALEUR", kind = "any", default = "Bonjour !" } },
		keywords = "afficher écrire sortie print console message texte dire",
		tooltip = "Écrit la valeur dans la fenêtre Sortie (Output) de Roblox Studio. Pratique pour vérifier ce que fait un script.",
		gen = function(a, g)
			return "print(" .. g.str(a.VALEUR) .. ")"
		end,
	},
	{
		id = "dbg_avertir",
		shape = "stack",
		label = "afficher l'avertissement %1",
		inputs = { { name = "VALEUR", kind = "any", default = "Attention !" } },
		keywords = "avertissement attention warn alerte orange sortie console",
		tooltip = "Écrit la valeur en orange dans la fenêtre Sortie, comme un avertissement (le script continue).",
		gen = function(a, g)
			return "warn(" .. g.str(a.VALEUR) .. ")"
		end,
	},
	{
		id = "dbg_erreur",
		shape = "stack",
		label = "déclencher l'erreur %1",
		inputs = { { name = "MESSAGE", kind = "text", default = "Oups !" } },
		keywords = "erreur error déclencher bug planter arrêter rouge exception",
		tooltip = "Déclenche une erreur avec ce message (en rouge dans la Sortie) : les blocs suivants de cet événement ne s'exécutent pas.",
		gen = function(a, g)
			return "error(" .. g.str(a.MESSAGE) .. ")"
		end,
	},
	{
		id = "dbg_commentaire",
		shape = "stack",
		label = "commentaire : %1",
		inputs = { { name = "TEXTE", kind = "text", default = "à faire" } },
		keywords = "commentaire note remarque explication mémo todo",
		tooltip = "Une note pour toi : ce bloc ne fait rien, il ajoute seulement un commentaire dans le code généré.",
		gen = function(a, g)
			local texte = nil
			if type(a.raw) == "table" then
				texte = a.raw.TEXTE
			end
			if texte == nil then
				-- un bloc valeur est branché : on ne peut pas connaître le texte à l'avance
				return "-- commentaire (texte calculé par un bloc)"
			end
			texte = string.gsub(tostring(texte), "[\r\n]+", " ")
			return "-- " .. texte
		end,
	},
	{
		id = "dbg_afficher_variables",
		shape = "stack",
		label = "afficher toutes les variables",
		inputs = {},
		keywords = "afficher variables liste valeurs sortie print déboguer inspecter",
		tooltip = "Écrit le nom et la valeur de toutes les variables du script dans la fenêtre Sortie.",
		gen = function(a, g)
			return g.helper("_afficherVariables") .. "(V)"
		end,
	},
	{
		id = "dbg_chrono",
		shape = "reporter",
		label = "temps depuis le démarrage (s)",
		inputs = {},
		keywords = "temps chronomètre chrono horloge secondes durée démarrage time",
		tooltip = "Le nombre de secondes écoulées depuis le lancement du jeu.",
		gen = function(a, g)
			return "time()"
		end,
	},
}

local helpers = {
	-- Écrit « Variables : nom = valeur, … » dans la sortie (noms triés)
	_afficherVariables = {
		deps = { "_texte" },
		services = {},
		code = [[
local function _afficherVariables(variables)
	if type(variables) ~= "table" then
		return
	end
	local noms = {}
	for nom in pairs(variables) do
		table.insert(noms, tostring(nom))
	end
	table.sort(noms)
	if #noms == 0 then
		print("Variables : (aucune)")
		return
	end
	local morceaux = {}
	for _, nom in ipairs(noms) do
		table.insert(morceaux, nom .. " = " .. _texte(variables[nom]))
	end
	print("Variables : " .. table.concat(morceaux, ", "))
end]],
	},
}

return {
	category = "debogage",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Defs_Effets</string><ProtectedString name="Source"><![CDATA[-- Defs_Effets : blocs de la catégorie « Effets » (VFX) (SPEC §30)
-- Particules, explosions, traînées, rayons, ondes de choc, éclairs d'impact, contours lumineux,
-- chiffres de dégâts, auras, images fantômes, lumières qui pulsent, fondus.
--
-- Choix de conception :
--   * Tout est fabriqué par le script, sans aucun fichier à importer : ParticleEmitter avec la
--     texture par défaut de Roblox (réglée avec Color / Size / Transparency / Squash…), Fire et
--     Smoke (feu et fumée « classiques », plus réalistes que des étoiles), Trail, Beam, Highlight,
--     PointLight, parties en néon et BillboardGui.
--   * Chaque objet créé porte l'attribut « BlocsFR_VFX = true » : « arrêter les effets » retrouve
--     ainsi tout ce que ces blocs ont posé, sans jamais toucher aux objets du joueur. Les effets
--     courts sont détruits tout seuls (Debris) ; les effets « sans arrêt » restent jusqu'à
--     « arrêter les effets » ou la destruction de l'objet (un personnage qui réapparaît est un
--     nouveau modèle : il faut relancer le bloc).
--   * Aucune boucle par image : les animations passent par TweenService, et les deux seules
--     boucles (lumière qui pulse, scintillement de l'aura électrique) s'arrêtent dès que leur
--     lumière disparaît. Les images fantômes s'arrêtent au bout de leur durée (10 s au plus).
--   * Un script détruit n'exécute plus ses task.delay (exemple : « explosion sur cet objet » puis
--     « détruire cet objet » dans une pièce à ramasser). Les effets courts partent donc tout de
--     suite (:Emit), leurs fins sont des tweens retardés (TweenInfo DelayTime) et Debris détruit
--     tout : ils se terminent proprement même sans le script.
--   * Les nouvelles parties (explosion, onde, éclair, images fantômes) sont posées dans le
--     Workspace, jamais dans la cible : les blocs qui parcourent les parties d'un objet
--     (transparence, cacher / montrer…) ne les voient pas, et une explosion reste visible même si
--     l'objet est détruit juste après.
--   * Comme dans « Tout prêts », la valeur littérale « le personnage » devient « (personnage or
--     joueur) » : sous un événement qui ne donne que le joueur, son personnage est utilisé (attendu
--     5 s au plus s'il n'est pas encore apparu).
--   * Les avertissements (en français) sont limités à un toutes les 5 s par message : un bloc mal
--     réglé dans une boucle ne remplit pas la sortie.
--   * Aides réutilisées d'autres fichiers : _obj, _partie, _perso, _avertir, _texte (Shared),
--     _versColor3, _elementsVisibles (Defs_Apparence), _nombreOu (Defs_Joueurs), _objetNomme
--     (Defs_Monde).
-- NOTE: « onde de choc » vise « le personnage » par défaut (planche NotesVFX) ; sur un modèle, elle
--   part du bas de sa boîte englobante (les pieds d'un personnage), sur une partie de son centre.
-- NOTE: « rayon » accepte aussi 0 s = sans arrêt (comme « particules » et « contour lumineux ») ; un
--   rayon sans arrêt remplace le précédent rayon sans arrêt du même objet.
-- NOTE: « particules … pendant 0 s » (sans arrêt) remplace les particules sans arrêt du même type
--   sur le même objet ; « pendant n s » n'ajoute rien si les mêmes particules jaillissent encore de
--   cet objet. Un bloc relancé à chaque contact ou dans une boucle n'empile donc pas des centaines
--   d'émetteurs. « aura », « traînée » et « contour » remplacent aussi le précédent.
-- NOTE: « faire disparaître en fondu » attend la fin du fondu (comme « faire glisser ») et garde la
--   transparence d'avant dans l'attribut « BlocsFR_Transparence » : « montrer … » (Apparence) fait
--   revenir l'objet.
-- NOTE: « arrêter les effets » sur une partie d'un personnage (la partie touchée) nettoie tout le
--   personnage.

local Shared = require(script.Parent.Shared)

---------------------------------------------------------------------------
-- Listes d'options (le code est un texte Luau entre guillemets)
---------------------------------------------------------------------------

local PARTICULES = {
	{ "étincelles", '"etincelles"' },
	{ "feu", '"feu"' },
	{ "fumée", '"fumee"' },
	{ "magie", '"magie"' },
	{ "poussière", '"poussiere"' },
	{ "bulles", '"bulles"' },
	{ "cœurs", '"coeurs"' },
	{ "neige", '"neige"' },
	{ "éclairs", '"eclairs"' },
	{ "confettis", '"confettis"' },
}

local AURAS = {
	{ "magique", '"magique"' },
	{ "feu", '"feu"' },
	{ "glace", '"glace"' },
	{ "ténèbres", '"tenebres"' },
	{ "électrique", '"electrique"' },
	{ "soin", '"soin"' },
}

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

local function couleur(name, r, v, b)
	return { name = name, kind = "color", default = { r, v, b } }
end

-- Menu d'effet (accepte aussi un bloc valeur : un texte comme « feu » ou « neige »)
local function typeInput(options, default)
	return { name = "TYPE", kind = "dropdown", options = options, default = default, acceptReporter = true }
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	local n = select("#", ...)
	local args = { ... }
	for i = 1, n do
		if args[i] == nil or args[i] == "" then
			args[i] = "nil"
		end
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ", 1, n) .. ")"
end

-- Expression d'une entrée « objet ». Le littéral « le personnage » devient « (personnage or joueur) » :
-- sous un événement qui ne fournit que le joueur, son personnage est utilisé.
local function persoOu(a, nom)
	if a.raw ~= nil and a.raw[nom] == "personnage" then
		return "(personnage or joueur)"
	end
	local expr = a[nom]
	if expr == nil or expr == "" then
		return "nil"
	end
	return expr
end

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "vfx_particules",
		shape = "stack",
		label = "particules %1 sur %2 pendant %3 s",
		inputs = {
			typeInput(PARTICULES, '"etincelles"'),
			Shared.objInput("CIBLE"),
			nombre("DUREE", 2),
		},
		keywords = "particules effet effets vfx etincelles feu fumee magie poussiere bulles coeurs neige eclairs confettis jaillir particle particles emitter sparkle sparks fire smoke magic dust bubbles hearts snow lightning",
		tooltip = "Fait jaillir des particules de l'objet (ou autour du personnage) pendant le temps choisi : étincelles, feu, fumée, magie, poussière, bulles, cœurs, neige, éclairs ou confettis. 0 s = sans arrêt, jusqu'à « arrêter les effets ». Tout est fabriqué par le script, rien à importer. Dans un script serveur, tout le monde voit l'effet ; dans un script local, seulement ce joueur. Astuce : sur une grande partie en hauteur (un nuage), « neige » fait tomber la neige sur toute sa surface.",
		gen = function(a, g)
			return appel(g, "_vfxParticules", a.TYPE, persoOu(a, "CIBLE"), g.num(a.DUREE))
		end,
	},
	{
		id = "vfx_explosion",
		shape = "stack",
		label = "explosion de %1 sur %2",
		inputs = {
			typeInput(PARTICULES, '"confettis"'),
			Shared.objInput("CIBLE", "partieTouchee"),
		},
		keywords = "explosion exploser eclater boum pop rafale confettis etincelles impact effet vfx burst explode blast",
		tooltip = "Une explosion de particules en un seul coup, avec un flash de lumière (sans dégâts ni recul) : confettis, étincelles, magie, cœurs… Parfait quand on ramasse une pièce ou qu'on gagne. À mettre dans un script serveur (tout le monde la voit) ou local, par exemple sous « Quand cet objet est touché ». Astuce : l'explosion reste visible même si tu détruis l'objet juste après.",
		gen = function(a, g)
			return appel(g, "_vfxExplosion", a.TYPE, persoOu(a, "CIBLE"))
		end,
	},
	{
		id = "vfx_trainee",
		shape = "stack",
		label = "traînée lumineuse sur %1 couleur %2",
		inputs = {
			Shared.objInput("CIBLE", "personnage"),
			couleur("COULEUR", 34, 211, 238),
		},
		keywords = "trainee lumineuse trace sillage epee coup bras main vitesse mouvement effet vfx trail swoosh sword slash",
		tooltip = "Ajoute une traînée de lumière qui dessine chaque mouvement : sur un personnage, elle suit son bras droit (parfait pour les coups d'épée) ; sur une partie, elle va d'un bout à l'autre de son côté le plus long. Elle reste jusqu'à « arrêter les effets » ; une nouvelle traînée remplace l'ancienne. À mettre dans un script serveur (par exemple sous « Quand un personnage apparaît ») ou local. Astuce : sur la lame de ton épée (« objet nommé Lame »), chaque coup laisse un arc lumineux.",
		gen = function(a, g)
			return appel(g, "_vfxTrainee", persoOu(a, "CIBLE"), a.COULEUR)
		end,
	},
	{
		id = "vfx_rayon",
		shape = "stack",
		label = "rayon de %1 vers %2 couleur %3 pendant %4 s",
		inputs = {
			Shared.objInput("DE"),
			{ name = "VERS", kind = "any", default = "Cible" },
			couleur("COULEUR", 250, 204, 21),
			nombre("DUREE", 1),
		},
		keywords = "rayon laser faisceau lien lumiere tirer viser vers cible effet vfx beam ray link",
		tooltip = "Trace un rayon laser lumineux entre deux objets pendant le temps choisi (0 s = sans arrêt), avec des étincelles au point d'arrivée. « vers » peut être le nom d'un objet (par exemple une partie nommée « Cible »), un objet, un joueur ou une position (bloc « vecteur »). Le rayon suit les objets s'ils bougent. Script serveur ou local. Astuce : ajoute « infliger … dégâts » juste après pour un vrai laser de combat.",
		gen = function(a, g)
			return appel(g, "_vfxRayon", persoOu(a, "DE"), a.VERS, a.COULEUR, g.num(a.DUREE))
		end,
	},
	{
		id = "vfx_onde",
		shape = "stack",
		label = "onde de choc sur %1 taille %2 couleur %3",
		inputs = {
			Shared.objInput("CIBLE", "personnage"),
			nombre("TAILLE", 16),
			couleur("COULEUR", 255, 255, 255),
		},
		keywords = "onde de choc anneau cercle impact sol saut atterrir attaque zone effet vfx shockwave ring slam",
		tooltip = "Une onde de choc : un anneau de néon qui s'agrandit jusqu'à la taille choisie (sa largeur en studs) et s'efface en 0,5 s. Sur un personnage, elle part de ses pieds. Script serveur ou local. Astuce : après un grand saut ou une attaque de zone, ajoute « faire trembler la caméra » (catégorie Caméra) pour un impact puissant.",
		gen = function(a, g)
			return appel(g, "_vfxOnde", persoOu(a, "CIBLE"), g.num(a.TAILLE), a.COULEUR)
		end,
	},
	{
		id = "vfx_eclair",
		shape = "stack",
		label = "éclair d'impact sur %1 couleur %2",
		inputs = {
			Shared.objInput("CIBLE", "partieTouchee"),
			couleur("COULEUR", 251, 146, 60),
		},
		keywords = "eclair impact flash coup boule lumiere touche frapper etincelles effet vfx hit spark burst",
		tooltip = "Un éclair d'impact : une boule de lumière qui éclate en 0,25 s avec un flash et des étincelles. Idéal quand un coup touche sa cible. À mettre dans un script serveur ou local, par exemple sous « Quand cet objet est touché ». Astuce : prends la couleur de ton attaque (bleu pour la glace, vert pour le poison).",
		gen = function(a, g)
			return appel(g, "_vfxEclair", persoOu(a, "CIBLE"), a.COULEUR)
		end,
	},
	{
		id = "vfx_contour",
		shape = "stack",
		label = "contour lumineux sur %1 couleur %2 pendant %3 s",
		inputs = {
			Shared.objInput("CIBLE", "personnage"),
			couleur("COULEUR", 239, 68, 68),
			nombre("DUREE", 1),
		},
		keywords = "contour lumineux surbrillance briller entourer selection degats touche effet vfx highlight outline glow",
		tooltip = "Entoure l'objet ou le personnage d'un contour lumineux de la couleur choisie pendant le temps choisi (0 s = sans arrêt) ; un nouveau contour remplace l'ancien. Script serveur ou local. Astuce : un contour rouge d'1 s quand un joueur prend des dégâts, ou un contour jaune sans arrêt sur un objet à ramasser. Roblox n'affiche pas plus de 31 contours à la fois.",
		gen = function(a, g)
			return appel(g, "_vfxContour", persoOu(a, "CIBLE"), a.COULEUR, g.num(a.DUREE))
		end,
	},
	{
		id = "vfx_degats",
		shape = "stack",
		label = "chiffres de dégâts %1 au-dessus de %2",
		inputs = {
			{ name = "TEXTE", kind = "any", default = "-20" },
			Shared.objInput("CIBLE", "personnage"),
		},
		keywords = "chiffres degats nombre texte vie points soin afficher monter tete effet vfx damage numbers popup indicator",
		tooltip = "Fait apparaître un chiffre (ou un petit texte) au-dessus de la tête, qui monte et s'efface en 0,9 s : rouge s'il commence par « - », vert par « + », doré sinon. Script serveur (tout le monde le voit) ou local. Astuce : mets-le juste après « infliger … dégâts » pour voir chaque coup, ou écris « +10 » quand un joueur se soigne.",
		gen = function(a, g)
			return appel(g, "_vfxDegats", a.TEXTE, persoOu(a, "CIBLE"))
		end,
	},
	{
		id = "vfx_aura",
		shape = "stack",
		label = "aura %1 autour de %2",
		inputs = {
