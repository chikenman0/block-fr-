local function _guiSurSurvol(qui, nom, fn)
	_guiBrancher(qui, nom, "survol", fn)
end]=],
	},

	-- Affiche (montrer = true) ou cache un écran avec un effet de 0,3 s sur sa « Racine » :
	-- fondu = GroupTransparency, haut / bas / gauche / droite = glissement, zoom = UIScale + fondu.
	-- Un écran sans Racine (fait à la main) est seulement activé / désactivé.
	_guiEffetEcran = {
		deps = { "_guiEcran", "_guiEtat" },
		services = { "TweenService" },
		code = [=[
local function _guiEffetEcran(qui, nom, effet, montrer)
	local ecran = _guiEcran(qui, nom)
	if ecran == nil then
		return
	end
	local DUREE = 0.3
	local HORS = {
		haut = UDim2.fromScale(0.5, -0.5),
		bas = UDim2.fromScale(0.5, 1.5),
		gauche = UDim2.fromScale(-0.5, 0.5),
		droite = UDim2.fromScale(1.5, 0.5),
	}
	local racine = nil
	for _, enfant in ipairs(ecran:GetChildren()) do
		if enfant:IsA("GuiObject") and enfant:GetAttribute("BlocsFR_Racine") == true then
			racine = enfant
			break
		end
	end
	local zoom = nil
	if racine ~= nil then
		zoom = racine:FindFirstChild("BlocsFR_Zoom")
		if zoom ~= nil and not zoom:IsA("UIScale") then
			zoom = nil
		end
	end
	local etat = _guiEtat()
	local function groupe(valeur)
		pcall(function()
			racine.GroupTransparency = valeur
		end)
	end
	local function normal()
		if racine == nil then
			return
		end
		groupe(0)
		racine.Position = UDim2.fromScale(0.5, 0.5)
		if zoom ~= nil then
			zoom.Scale = 1
		end
	end
	-- Arrête les tweens de l'effet précédent de cet écran : sans ça, ils finiraient leur trajet
	-- par-dessus le nouvel état (écran affiché mais transparent, rétréci ou hors de l'écran)
	local function arreter()
		local anciens = etat.tweens[ecran]
		etat.tweens[ecran] = nil
		if anciens ~= nil then
			for _, t in ipairs(anciens) do
				pcall(function()
					t:Cancel()
				end)
			end
		end
	end
	local function animer(cible, proprietes, style, direction)
		pcall(function()
			local t = TweenService:Create(cible, TweenInfo.new(DUREE, style, direction), proprietes)
			local liste = etat.tweens[ecran]
			if liste == nil then
				liste = {}
				etat.tweens[ecran] = liste
			end
			table.insert(liste, t)
			t:Play()
		end)
	end
	local connu = effet == "fondu" or effet == "zoom" or HORS[effet] ~= nil
	if racine == nil or not connu then
		etat.versions[ecran] = (etat.versions[ecran] or 0) + 1
		etat.enCours[ecran] = nil
		arreter()
		normal()
		ecran.Enabled = montrer == true
		return
	end
	if montrer then
		if etat.enCours[ecran] == "montrer" then
			return
		end
		if ecran.Enabled and etat.enCours[ecran] == nil then
			return
		end
	else
		if etat.enCours[ecran] == "cacher" then
			return
		end
		if not ecran.Enabled then
			return
		end
	end
	local version = (etat.versions[ecran] or 0) + 1
	etat.versions[ecran] = version
	arreter()
	if effet == "zoom" and zoom == nil then
		zoom = Instance.new("UIScale")
		zoom.Name = "BlocsFR_Zoom"
		zoom.Parent = racine
	end
	if montrer then
		etat.enCours[ecran] = "montrer"
		normal()
		if effet == "fondu" then
			groupe(1)
			animer(racine, { GroupTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		elseif effet == "zoom" then
			groupe(1)
			zoom.Scale = 0.6
			animer(racine, { GroupTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			animer(zoom, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		else
			racine.Position = HORS[effet]
			animer(racine, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
		ecran.Enabled = true
		task.wait(DUREE)
		if etat.versions[ecran] == version then
			etat.enCours[ecran] = nil
			arreter()
			normal()
		end
	else
		etat.enCours[ecran] = "cacher"
		if effet == "fondu" then
			animer(racine, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		elseif effet == "zoom" then
			animer(racine, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			animer(zoom, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		else
			animer(racine, { Position = HORS[effet] }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.wait(DUREE)
		if etat.versions[ecran] == version then
			etat.enCours[ecran] = nil
			arreter()
			ecran.Enabled = false
			normal()
		end
	end
end]=],
	},

	_guiAfficherEcran = {
		deps = { "_guiEffetEcran" },
		services = {},
		code = [=[
local function _guiAfficherEcran(qui, nom, effet)
	_guiEffetEcran(qui, nom, effet, true)
end]=],
	},

	_guiCacherEcran = {
		deps = { "_guiEffetEcran" },
		services = {},
		code = [=[
local function _guiCacherEcran(qui, nom, effet)
	_guiEffetEcran(qui, nom, effet, false)
end]=],
	},

	-- Fondu d'un élément et de ses morceaux : mode "apparaitre" / "disparaitre" (attend la fin), ou
	-- n'importe quoi d'autre = annuler le fondu en cours. Les transparences d'origine sont gardées
	-- dans des attributs (BlocsFR_T_<propriété>) pendant le fondu, puis remises. Les tweens du fondu
	-- en cours sont arrêtés avant (sinon ils finiraient leur trajet : élément visible mais transparent).
	_guiFondu = {
		deps = { "_guiEtat" },
		services = { "TweenService" },
		code = [=[
local function _guiFondu(objet, mode, duree)
	local etat = _guiEtat()
	local function arreter()
		local anciens = etat.fondus[objet]
		etat.fondus[objet] = nil
		if anciens ~= nil then
			for _, t in ipairs(anciens) do
				pcall(function()
					t:Cancel()
				end)
			end
		end
	end
	arreter()
	local liste = {}
	local function ajouter(o)
		if o:IsA("GuiObject") then
			table.insert(liste, { o, "BackgroundTransparency" })
			if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
				table.insert(liste, { o, "TextTransparency" })
			elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
				table.insert(liste, { o, "ImageTransparency" })
			elseif o:IsA("ScrollingFrame") then
				table.insert(liste, { o, "ScrollBarImageTransparency" })
			end
		elseif o:IsA("UIStroke") then
			table.insert(liste, { o, "Transparency" })
		end
	end
	ajouter(objet)
	for i, o in ipairs(objet:GetDescendants()) do
		if i > 400 then
			break
		end
		ajouter(o)
	end
	local version = (tonumber(objet:GetAttribute("BlocsFR_Fondu")) or 0) + 1
	objet:SetAttribute("BlocsFR_Fondu", version)
	local function restaurer()
		for _, paire in ipairs(liste) do
			local o, propriete = paire[1], paire[2]
			local cle = "BlocsFR_T_" .. propriete
			local origine = o:GetAttribute(cle)
			if type(origine) == "number" then
				o[propriete] = origine
				o:SetAttribute(cle, nil)
			end
		end
	end
	if mode ~= "apparaitre" and mode ~= "disparaitre" then
		restaurer()
		return
	end
	for _, paire in ipairs(liste) do
		local o, propriete = paire[1], paire[2]
		local cle = "BlocsFR_T_" .. propriete
		if type(o:GetAttribute(cle)) ~= "number" then
			o:SetAttribute(cle, o[propriete])
		end
	end
	if mode == "apparaitre" then
		for _, paire in ipairs(liste) do
			local o, propriete = paire[1], paire[2]
			o[propriete] = 1
		end
		objet.Visible = true
	end
	local tweens = {}
	etat.fondus[objet] = tweens
	for _, paire in ipairs(liste) do
		local o, propriete = paire[1], paire[2]
		local cible = 1
		if mode == "apparaitre" then
			cible = o:GetAttribute("BlocsFR_T_" .. propriete)
		end
		if type(cible) == "number" then
			if duree > 0 then
				pcall(function()
					local t = TweenService:Create(o, TweenInfo.new(duree, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [propriete] = cible })
					table.insert(tweens, t)
					t:Play()
				end)
			else
				o[propriete] = cible
			end
		end
	end
	if duree > 0 then
		task.wait(duree)
	end
	if objet:GetAttribute("BlocsFR_Fondu") ~= version then
		return
	end
	arreter()
	if mode == "disparaitre" then
		objet.Visible = false
	end
	restaurer()
end]=],
	},

	_guiMontrer = {
		deps = { "_guiTrouver", "_guiFondu" },
		services = {},
		code = [=[
local function _guiMontrer(qui, nom, visible)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	_guiFondu(objet, "annuler", 0)
	objet.Visible = visible == true
end]=],
	},

	-- Texte d'un élément (une barre sans texte en reçoit un)
	_guiTexte = {
		deps = { "_guiTrouver", "_guiTexteObjet", "_guiPartie", "_guiAvertir", "_texte" },
		services = {},
		code = [=[
local function _guiTexte(qui, nom, valeur)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	local zone = _guiTexteObjet(objet)
	if zone == nil and _guiPartie(objet, "Remplissage") ~= nil then
		zone = Instance.new("TextLabel")
		zone.Name = "Texte"
		zone:SetAttribute("BlocsFR_Partie", "Texte")
		zone.BackgroundTransparency = 1
		zone.BorderSizePixel = 0
		zone.Size = UDim2.fromScale(1, 1)
		zone.ZIndex = 2
		zone.Font = Enum.Font.FredokaOne
		zone.TextScaled = true
		zone.TextColor3 = Color3.new(1, 1, 1)
		local trait = Instance.new("UIStroke")
		trait.Color = Color3.fromRGB(14, 22, 48)
		trait.Thickness = 2
		trait.Parent = zone
		zone.Parent = objet
	end
	if zone == nil then
		_guiAvertir("« " .. objet.Name .. " » n'affiche pas de texte : choisis un texte, un bouton, un champ ou une barre.")
		return
	end
	zone.Text = _texte(valeur)
end]=],
	},

	_guiCouleur = {
		deps = { "_guiTrouver", "_guiPartie", "_guiAvertir" },
		services = {},
		code = [=[
local function _guiCouleur(qui, nom, couleur)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	if typeof(couleur) ~= "Color3" then
		_guiAvertir("mettre la couleur : la valeur donnée n'est pas une couleur.")
		return
	end
	local function sansDegrade(cible)
		for _, enfant in ipairs(cible:GetChildren()) do
			if enfant:IsA("UIGradient") then
				enfant.Enabled = false
			end
		end
	end
	local rempli = _guiPartie(objet, "Remplissage")
	if rempli ~= nil then
		sansDegrade(rempli)
		rempli.BackgroundColor3 = couleur
		return
	end
	local face = _guiPartie(objet, "Face")
	if face ~= nil then
		sansDegrade(face)
		face.BackgroundColor3 = couleur
		if face.BackgroundTransparency >= 0.99 then
			face.BackgroundTransparency = 0
		end
		if objet:GetAttribute("BlocsFR_ReliefAuto") == true then
			objet.BackgroundColor3 = Color3.new(couleur.R * 0.65, couleur.G * 0.65, couleur.B * 0.65)
		end
		return
	end
	if objet.BackgroundTransparency >= 0.99 then
		if objet:IsA("TextLabel") or objet:IsA("TextButton") or objet:IsA("TextBox") then
			objet.TextColor3 = couleur
			return
		elseif objet:IsA("ImageLabel") or objet:IsA("ImageButton") then
			objet.ImageColor3 = couleur
			return
		end
		objet.BackgroundTransparency = 0
	end
	sansDegrade(objet)
	objet.BackgroundColor3 = couleur
end]=],
	},

	_guiImage = {
		deps = { "_guiTrouver", "_guiAvertir", "_texte" },
		services = {},
		code = [=[
local function _guiImage(qui, nom, image)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	if not (objet:IsA("ImageLabel") or objet:IsA("ImageButton")) then
		_guiAvertir("« " .. objet.Name .. " » n'est pas une image : choisis un élément Image.")
		return
	end
	local id = ""
	if type(image) == "number" then
		if image == image and image >= 0 and image < 1e15 then
			id = "rbxassetid://" .. string.format("%d", math.floor(image))
		end
	else
		id = _texte(image)
		id = string.gsub(id, "^%s+", "")
		id = string.gsub(id, "%s+$", "")
		if string.match(id, "^%d+$") then
			id = "rbxassetid://" .. id
		end
	end
	objet.Image = id
end]=],
	},

	-- Remplissage d'une barre (valeur / maximum, entre 0 et 1), en douceur ; ne bloque pas
	_guiBarre = {
		deps = { "_guiTrouver", "_guiPartie", "_guiAvertir", "_num", "_texte" },
		services = { "TweenService" },
		code = [=[
local function _guiBarre(qui, nom, valeur, maximum, duree)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	local rempli = _guiPartie(objet, "Remplissage") or objet:FindFirstChild("Remplissage")
	if rempli == nil or not rempli:IsA("GuiObject") then
		_guiAvertir("« " .. objet.Name .. " » n'est pas une barre : choisis un élément Barre.")
		return
	end
	local v = _num(valeur)
	local m = _num(maximum)
	local part = 0
	if m > 0 then
		part = v / m
	end
	if part ~= part then
		part = 0
	end
	part = math.clamp(part, 0, 1)
	local d = _num(duree)
	if d ~= d or d < 0 then
		d = 0
	end
	local taille = UDim2.new(part, 0, rempli.Size.Y.Scale, rempli.Size.Y.Offset)
	if d > 0 then
		local ok = pcall(function()
			TweenService:Create(rempli, TweenInfo.new(math.min(d, 600), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = taille }):Play()
		end)
		if not ok then
			rempli.Size = taille
		end
	else
		rempli.Size = taille
	end
	local zone = _guiPartie(objet, "Texte")
	if zone ~= nil and (zone:IsA("TextLabel") or zone:IsA("TextButton") or zone:IsA("TextBox")) then
		zone.Text = _texte(v) .. " / " .. _texte(m)
	end
end]=],
	},

	-- Animations d'un élément ; attend la fin. La taille passe par le UIScale « BlocsFR_Echelle »
	-- (attribut BlocsFR_EchelleBase = taille choisie par les blocs, BlocsFR_EchelleTexte = échelle des
	-- très grands textes posée par Blocs FR).
	_guiAnimer = {
		deps = { "_guiTrouver", "_guiFondu", "_guiAvertir", "_num" },
		services = { "TweenService" },
		code = [=[
local function _guiAnimer(qui, nom, effet, duree)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	local d = _num(duree)
	if d ~= d or d < 0 then
		d = 0
	end
	d = math.min(d, 600)
	local function tween(cible, temps, proprietes, style, direction)
		pcall(function()
			TweenService:Create(cible, TweenInfo.new(temps, style, direction), proprietes):Play()
		end)
	end
	local texte = objet:GetAttribute("BlocsFR_EchelleTexte")
	if type(texte) ~= "number" then
		texte = 1
	end
	local base = objet:GetAttribute("BlocsFR_EchelleBase")
	if type(base) ~= "number" then
		base = 1
	end
	local function echelle()
		local e = objet:FindFirstChild("BlocsFR_Echelle")
		if e == nil or not e:IsA("UIScale") then
			e = Instance.new("UIScale")
			e.Name = "BlocsFR_Echelle"
			e.Scale = texte * base
			e.Parent = objet
		end
		return e
	end
	if effet == "rebondir" then
		local e = echelle()
		local montee = math.max(d * 0.35, 0.03)
		local descente = math.max(d - montee, 0.05)
		tween(e, montee, { Scale = texte * base * 1.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.wait(montee)
		tween(e, descente, { Scale = texte * base }, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
		task.wait(descente)
	elseif effet == "grossir" or effet == "retrecir" or effet == "normal" then
		local cible = 1
		if effet == "grossir" then
			cible = 1.3
		elseif effet == "retrecir" then
			cible = 0.75
		end
		objet:SetAttribute("BlocsFR_EchelleBase", cible)
		local e = echelle()
		if d > 0 then
			tween(e, d, { Scale = texte * cible }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			task.wait(d)
		else
			e.Scale = texte * cible
		end
	elseif effet == "pulser" then
		local e = echelle()
		local etape = math.max(d / 4, 0.03)
		for _ = 1, 2 do
			tween(e, etape, { Scale = texte * base * 1.12 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(etape)
			tween(e, etape, { Scale = texte * base }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(etape)
		end
	elseif effet == "secouer" then
		local origine = objet:GetAttribute("BlocsFR_PosOrigine")
		if typeof(origine) ~= "UDim2" then
			origine = objet.Position
			objet:SetAttribute("BlocsFR_PosOrigine", origine)
		end
		local version = (tonumber(objet:GetAttribute("BlocsFR_Secousse")) or 0) + 1
		objet:SetAttribute("BlocsFR_Secousse", version)
		local fin = math.max(d, 0.1)
		local ecoule = 0
		while ecoule < fin do
			if objet:GetAttribute("BlocsFR_Secousse") ~= version then
				return
			end
			local force = 8 * (1 - ecoule / fin) + 2
			objet.Position = origine + UDim2.fromOffset((math.random() * 2 - 1) * force, (math.random() * 2 - 1) * force * 0.5)
			ecoule += task.wait(0.04)
		end
		if objet:GetAttribute("BlocsFR_Secousse") == version then
			objet.Position = origine
			objet:SetAttribute("BlocsFR_PosOrigine", nil)
		end
	elseif effet == "clignoter" then
		local avant = objet.Visible
		local etape = math.max(d / 6, 0.03)
		for _ = 1, 3 do
			objet.Visible = not avant
			task.wait(etape)
			objet.Visible = avant
			task.wait(etape)
		end
	elseif effet == "tourner" then
		local origine = objet:GetAttribute("BlocsFR_RotOrigine")
		if type(origine) ~= "number" then
			origine = objet.Rotation
			objet:SetAttribute("BlocsFR_RotOrigine", origine)
		end
		local version = (tonumber(objet:GetAttribute("BlocsFR_Tour")) or 0) + 1
		objet:SetAttribute("BlocsFR_Tour", version)
		objet.Rotation = origine
		if d > 0 then
			tween(objet, d, { Rotation = origine + 360 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
			task.wait(d)
		end
		if objet:GetAttribute("BlocsFR_Tour") == version then
			objet.Rotation = origine
			objet:SetAttribute("BlocsFR_RotOrigine", nil)
		end
	elseif effet == "apparaitre" or effet == "disparaitre" then
		_guiFondu(objet, effet, d)
	else
		_guiAvertir("animer : effet inconnu « " .. tostring(effet) .. " ».")
	end
end]=],
	},

	-- Déplace un élément à (x %, y %) de son parent ; attend la fin
	_guiDeplacer = {
		deps = { "_guiTrouver", "_num" },
		services = { "TweenService" },
		code = [=[
local function _guiDeplacer(qui, nom, x, y, duree)
	local objet = _guiTrouver(qui, nom)
	if objet == nil then
		return
	end
	local px, py = _num(x), _num(y)
	if px ~= px then
		px = 0
	end
	if py ~= py then
		py = 0
	end
	local cible = UDim2.fromScale(math.clamp(px, -1000, 1000) / 100, math.clamp(py, -1000, 1000) / 100)
	-- une secousse en cours ne remettra pas l'ancienne position
	objet:SetAttribute("BlocsFR_Secousse", (tonumber(objet:GetAttribute("BlocsFR_Secousse")) or 0) + 1)
	objet:SetAttribute("BlocsFR_PosOrigine", nil)
	local d = _num(duree)
	if d ~= d or d < 0 then
		d = 0
	end
	d = math.min(d, 600)
	if d > 0 then
		local ok = pcall(function()
			TweenService:Create(objet, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Position = cible }):Play()
		end)
		if ok then
			task.wait(d)
			return
		end
	end
	objet.Position = cible
end]=],
	},

	-- Notification façon jeu vidéo, empilée sur la droite (5 au plus) ; ne bloque pas
	_guiNotification = {
		deps = { "_guiRacine", "_guiFacteur", "_guiEtat", "_texte", "_num" },
		services = { "TweenService" },
		code = [=[
local function _guiNotification(qui, texte, couleur, duree)
	local message = _texte(texte)
	local secondes = _num(duree)
	if secondes ~= secondes or secondes <= 0 then
		secondes = 3
	end
	secondes = math.min(secondes, 600)
	if typeof(couleur) ~= "Color3" then
		couleur = Color3.fromRGB(47, 191, 90)
	end
	task.spawn(function()
		local racine = _guiRacine(qui)
		if racine == nil or message == "" then
			return
		end
		local k = _guiFacteur()
		local ecran = racine:FindFirstChild("BlocsFR_Notifications")
		if ecran == nil or not ecran:IsA("ScreenGui") then
			ecran = Instance.new("ScreenGui")
			ecran.Name = "BlocsFR_Notifications"
			ecran.ResetOnSpawn = false
			ecran.IgnoreGuiInset = true
			ecran.DisplayOrder = 50
			ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
			ecran.Parent = racine
		end
		local pile = ecran:FindFirstChild("Pile")
		if pile == nil then
			pile = Instance.new("Frame")
			pile.Name = "Pile"
			pile:SetAttribute("BlocsFR_Partie", "Pile")
			pile.AnchorPoint = Vector2.new(1, 0)
			pile.BackgroundTransparency = 1
			pile.Size = UDim2.fromScale(0.6, 0.7)
			local disposition = Instance.new("UIListLayout")
			disposition.SortOrder = Enum.SortOrder.LayoutOrder
			disposition.HorizontalAlignment = Enum.HorizontalAlignment.Right
			disposition.Parent = pile
			pile.Parent = ecran
		end
		pile.Position = UDim2.new(1, -math.floor(24 * k + 0.5), 0.22, 0)
		local disposition = pile:FindFirstChildOfClass("UIListLayout")
		if disposition ~= nil then
			disposition.Padding = UDim.new(0, math.floor(10 * k + 0.5))
		end
		local anciennes = {}
		for _, enfant in ipairs(pile:GetChildren()) do
			if enfant:IsA("Frame") then
				table.insert(anciennes, enfant)
			end
		end
		table.sort(anciennes, function(p, q)
			return p.LayoutOrder < q.LayoutOrder
		end)
		while #anciennes >= 5 do
			local plusVieille = table.remove(anciennes, 1)
			plusVieille:Destroy()
		end
		local etat = _guiEtat()
		etat.notifications = (etat.notifications or 0) + 1
		local hauteur = math.floor(60 * k + 0.5)
		local trait = math.max(1, math.floor(4 * k + 0.5))
		local dehors = UDim2.new(1, math.floor(800 * k), 0.5, 0)
		-- (attribut BlocsFR_Partie : jamais confondus avec les éléments de l'interface du joueur)
		local case = Instance.new("Frame")
		case.Name = "Notification"
		case:SetAttribute("BlocsFR_Partie", "Notification")
		case.LayoutOrder = etat.notifications
		case.BackgroundTransparency = 1
		case.Size = UDim2.new(1, 0, 0, hauteur + trait * 2)
		local face = Instance.new("Frame")
		face.Name = "Face"
		face:SetAttribute("BlocsFR_Partie", "Face")
		face.AnchorPoint = Vector2.new(1, 0.5)
		face.Position = dehors
		face.Size = UDim2.new(0, 0, 0, hauteur)
		face.AutomaticSize = Enum.AutomaticSize.X
		face.BackgroundColor3 = couleur
		face.BorderSizePixel = 0
		local coins = Instance.new("UICorner")
		coins.CornerRadius = UDim.new(0, math.floor(14 * k + 0.5))
		coins.Parent = face
		local bord = Instance.new("UIStroke")
		bord.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bord.Color = Color3.fromRGB(14, 22, 48)
		bord.Thickness = trait
		bord.Parent = face
		local degrade = Instance.new("UIGradient")
		degrade.Color = ColorSequence.new(couleur:Lerp(Color3.new(1, 1, 1), 0.3), couleur)
		degrade.Rotation = 90
		degrade.Parent = face
		local marges = Instance.new("UIPadding")
		marges.PaddingLeft = UDim.new(0, math.floor(18 * k + 0.5))
		marges.PaddingRight = UDim.new(0, math.floor(18 * k + 0.5))
		marges.Parent = face
		local etiquette = Instance.new("TextLabel")
		etiquette.Name = "Texte"
		etiquette:SetAttribute("BlocsFR_Partie", "Texte")
		etiquette.BackgroundTransparency = 1
		etiquette.Size = UDim2.new(0, 0, 1, 0)
		etiquette.AutomaticSize = Enum.AutomaticSize.X
		etiquette.Font = Enum.Font.FredokaOne
		etiquette.TextSize = math.clamp(math.floor(28 * k + 0.5), 8, 100)
		etiquette.Text = message
		local clarte = couleur.R * 0.299 + couleur.G * 0.587 + couleur.B * 0.114
		if clarte > 0.72 then
			etiquette.TextColor3 = Color3.fromRGB(59, 42, 0)
		else
			etiquette.TextColor3 = Color3.new(1, 1, 1)
			local contour = Instance.new("UIStroke")
			contour.Color = Color3.fromRGB(14, 22, 48)
			contour.Thickness = math.max(1, math.floor(2.5 * k + 0.5))
			contour.LineJoinMode = Enum.LineJoinMode.Round
			contour.Parent = etiquette
		end
		etiquette.Parent = face
		face.Parent = case
		case.Parent = pile
		pcall(function()
			TweenService:Create(face, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(1, -trait, 0.5, 0) }):Play()
		end)
		task.delay(secondes, function()
			if case.Parent == nil then
				return
			end
			pcall(function()
				TweenService:Create(face, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = dehors }):Play()
			end)
			task.wait(0.3)
			case:Destroy()
		end)
	end)
end]=],
	},

	-- Grand message jaune au centre (apparaît en grossissant 0 -> 1,1 -> 1, puis s'efface) ; ne bloque pas
	_guiGrandMessage = {
		deps = { "_guiRacine", "_guiFacteur", "_texte", "_num" },
		services = { "TweenService" },
		code = [=[
local function _guiGrandMessage(qui, texte, duree)
	local message = _texte(texte)
	local secondes = _num(duree)
	if secondes ~= secondes or secondes <= 0 then
		secondes = 2
	end
	secondes = math.min(secondes, 600)
	task.spawn(function()
		local racine = _guiRacine(qui)
		if racine == nil then
			return
		end
		local ancien = racine:FindFirstChild("BlocsFR_GrandMessage")
		if ancien ~= nil then
			ancien:Destroy()
		end
		if message == "" then
			return
		end
		local k = _guiFacteur()
		local function animer(cible, temps, proprietes)
			pcall(function()
				TweenService:Create(cible, TweenInfo.new(temps, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), proprietes):Play()
			end)
		end
		local ecran = Instance.new("ScreenGui")
		ecran.Name = "BlocsFR_GrandMessage"
		ecran.ResetOnSpawn = false
		ecran.IgnoreGuiInset = true
		ecran.DisplayOrder = 60
		ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		local etiquette = Instance.new("TextLabel")
		etiquette.Name = "Message"
		etiquette:SetAttribute("BlocsFR_Partie", "Message")
		etiquette.AnchorPoint = Vector2.new(0.5, 0.5)
		etiquette.Position = UDim2.fromScale(0.5, 0.4)
		etiquette.Size = UDim2.fromScale(0.86, 0.2)
		etiquette.BackgroundTransparency = 1
		etiquette.Font = Enum.Font.LuckiestGuy
		etiquette.TextScaled = true
		etiquette.TextWrapped = true
		etiquette.TextColor3 = Color3.fromRGB(255, 211, 77)
		etiquette.Text = message
		local limite = Instance.new("UITextSizeConstraint")
		limite.MaxTextSize = 100
		limite.Parent = etiquette
		local trait = Instance.new("UIStroke")
		trait.Color = Color3.fromRGB(14, 22, 48)
		trait.Thickness = math.max(1, 4 * k)
		trait.LineJoinMode = Enum.LineJoinMode.Round
		trait.Parent = etiquette
		local echelle = Instance.new("UIScale")
		echelle.Scale = 0.01
		echelle.Parent = etiquette
		etiquette.Parent = ecran
		ecran.Parent = racine
		animer(echelle, 0.22, { Scale = 1.1 })
		task.wait(0.22)
		animer(echelle, 0.12, { Scale = 1 })
		task.wait(secondes)
		if ecran.Parent == nil then
			return
		end
		animer(etiquette, 0.3, { TextTransparency = 1 })
		animer(trait, 0.3, { Transparency = 1 })
		task.wait(0.3)
		ecran:Destroy()
	end)
end]=],
	},

	-- Statistique (leaderstats) du joueur affichée dans un texte, mise à jour à chaque changement.
	-- Suivie sans limite de temps : la statistique peut être créée plus tard (premier gain, premier
	-- record) ou remplacée (un nombre entier qui devient un nombre à virgule) ; un seul avertissement
	-- si elle n'existe toujours pas au bout de 10 s.
	_guiLierStat = {
		deps = { "_guiJoueur", "_guiNom", "_guiTexte", "_guiAvertir" },
		services = {},
		code = [=[
local function _guiLierStat(qui, stat, nom)
	local nomStat = _guiNom(stat)
	if nomStat == "" then
		_guiAvertir("afficher la statistique : écris le nom de la statistique dans le bloc (la case est vide).")
		return
	end
	task.spawn(function()
		local p = _guiJoueur(qui)
		if p == nil then
			return
		end
		local dossier, valeur = nil, nil
		local lienValeur = nil
		local liensDossier = {}
		local function montrer()
			if valeur ~= nil then
				_guiTexte(qui, nom, valeur.Value)
			end
		end
		local function suivreValeur(v)
			if v == valeur then
				return
			end
			if lienValeur ~= nil then
				lienValeur:Disconnect()
				lienValeur = nil
			end
			valeur = v
			if v ~= nil then
				lienValeur = v.Changed:Connect(montrer)
				montrer()
			end
		end
		local function chercherValeur()
			local trouve = nil
			if dossier ~= nil then
				for _, enfant in ipairs(dossier:GetChildren()) do
					if enfant.Name == nomStat and enfant:IsA("ValueBase") then
						trouve = enfant
						break
					end
				end
			end
			suivreValeur(trouve)
		end
		local function suivreDossier(d)
			if d == dossier then
				return
			end
			for _, lien in ipairs(liensDossier) do
				lien:Disconnect()
			end
			table.clear(liensDossier)
			dossier = d
			if d ~= nil then
				table.insert(liensDossier, d.ChildAdded:Connect(function(enfant)
					if enfant.Name == nomStat and enfant:IsA("ValueBase") then
						suivreValeur(enfant)
					end
				end))
				table.insert(liensDossier, d.ChildRemoved:Connect(function(enfant)
					if enfant == valeur then
						chercherValeur()
					end
				end))
			end
			chercherValeur()
		end
		p.ChildAdded:Connect(function(enfant)
			if enfant.Name == "leaderstats" then
				suivreDossier(enfant)
			end
		end)
		p.ChildRemoved:Connect(function(enfant)
			if enfant == dossier then
				suivreDossier(p:FindFirstChild("leaderstats"))
			end
		end)
		task.delay(10, function()
			if valeur ~= nil then
				return
			end
			if dossier == nil then
				_guiAvertir("afficher la statistique : « " .. p.Name .. " » n'a pas encore de statistiques. « " .. nomStat .. " » s'affichera dès qu'elle sera créée (bloc « créer la statistique » dans un script serveur).")
			else
				_guiAvertir("afficher la statistique : « " .. nomStat .. " » n'existe pas encore. Elle s'affichera dès qu'elle sera créée (bloc « créer la statistique » dans un script serveur).")
			end
		end)
		suivreDossier(p:FindFirstChild("leaderstats"))
	end)
end]=],
	},

	-- Vie du joueur reliée à une barre (suit les réapparitions)
	_guiLierVie = {
		deps = { "_guiJoueur", "_guiBarre" },
		services = {},
		code = [=[
local function _guiLierVie(qui, nom)
	task.spawn(function()
		local p = _guiJoueur(qui)
		if p == nil then
			return
		end
		local connexions = {}
		local function suivre(perso)
			for _, c in ipairs(connexions) do
				c:Disconnect()
			end
			table.clear(connexions)
			if perso == nil then
				return
			end
			local h = perso:FindFirstChildOfClass("Humanoid") or perso:WaitForChild("Humanoid", 10)
			if h == nil or not h:IsA("Humanoid") then
				return
			end
			local function montrer()
				_guiBarre(qui, nom, math.floor(h.Health + 0.5), math.floor(h.MaxHealth + 0.5), 0.15)
			end
			montrer()
			table.insert(connexions, h.HealthChanged:Connect(montrer))
			table.insert(connexions, h:GetPropertyChangedSignal("MaxHealth"):Connect(montrer))
		end
		p.CharacterAdded:Connect(suivre)
		suivre(p.Character)
	end)
end]=],
	},

	_guiEcranOuvert = {
		deps = { "_guiEcran", "_guiEtat" },
		services = {},
		code = [=[
local function _guiEcranOuvert(qui, nom)
	local ecran = _guiEcran(qui, nom)
	if ecran == nil then
		return false
	end
	return ecran.Enabled == true and _guiEtat().enCours[ecran] ~= "cacher"
end]=],
	},

	_guiTexteDe = {
		deps = { "_guiTrouver", "_guiTexteObjet" },
		services = {},
		code = [=[
local function _guiTexteDe(qui, nom)
	local zone = _guiTexteObjet(_guiTrouver(qui, nom))
	if zone == nil then
		return ""
	end
	return zone.Text
end]=],
	},

	_guiEstVisible = {
		deps = { "_guiTrouver" },
		services = {},
		code = [=[
local function _guiEstVisible(qui, nom)
	local objet = _guiTrouver(qui, nom)
	while objet ~= nil do
		if objet:IsA("LayerCollector") then
			return objet.Enabled == true
		end
		if objet:IsA("GuiObject") and not objet.Visible then
			return false
		end
		objet = objet.Parent
	end
	return false
end]=],
	},
}

return {
	category = "interface",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Defs_Joueurs</string><ProtectedString name="Source"><![CDATA[-- Defs_Joueurs : blocs de la catégorie « Joueurs »
-- vie, vitesse, saut, téléportation, statistiques du classement (leaderstats),
-- messages à l'écran, outils, boucle « pour chaque joueur »…
--
-- Chaque bloc accepte un joueur (Player), un personnage, une partie d'un personnage,
-- un nom de joueur, ou rien (dans un script local : rien = le joueur local).
-- La résolution passe toujours par les aides de base _joueur / _perso / _humanoid (Shared.lua)
-- et un avertissement en français est affiché quand rien n'est trouvé.

local Shared = require(script.Parent.Shared)

-- Construit l'appel d'une fonction utile : nom(arg1, arg2, ...) et déclare l'aide.
local function appel(g, nom, ...)
	local args = {}
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		if v == nil then
			v = "nil"
		end
		args[i] = v
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ") .. ")"
end

-- Nouvelle entrée « joueur » (une table neuve par bloc)
local function joueurInput()
	return Shared.playerInput("JOUEUR")
end

local blocks = {
	---------------------------------------------------------------------------
	-- Vie et mouvements
	---------------------------------------------------------------------------
	{
		id = "j_eliminer",
		shape = "stack",
		label = "éliminer %1",
		inputs = { joueurInput() },
		keywords = "tuer mourir kill mort vie sante eliminer",
		tooltip = "Élimine le joueur : sa vie tombe à 0 et son personnage meurt (il réapparaîtra normalement).",
		gen = function(a, g)
			return appel(g, "_eliminer", a.JOUEUR)
		end,
	},
	{
		id = "j_vie",
		shape = "stack",
		label = "mettre la vie de %1 à %2",
		inputs = {
			joueurInput(),
			{ name = "VIE", kind = "number", default = 100 },
		},
		keywords = "vie sante points health pv",
		tooltip = "Change la vie du joueur (0 = éliminé). Si la valeur dépasse la vie maximum, la vie maximum est augmentée.",
		gen = function(a, g)
			return appel(g, "_definirVie", a.JOUEUR, g.num(a.VIE))
		end,
	},
	{
		id = "j_degats",
		shape = "stack",
		label = "infliger %1 dégâts à %2",
		inputs = {
			{ name = "DEGATS", kind = "number", default = 10 },
			joueurInput(),
		},
		keywords = "degats blesser frapper attaque damage vie piege lave",
		tooltip = "Retire des points de vie au joueur. Sans effet s'il est protégé par un champ de force.",
		gen = function(a, g)
			return appel(g, "_infligerDegats", a.JOUEUR, g.num(a.DEGATS))
		end,
	},
	{
		id = "j_soigner",
		shape = "stack",
		label = "soigner %1 de %2 points",
		inputs = {
			joueurInput(),
			{ name = "POINTS", kind = "number", default = 20 },
		},
		keywords = "soigner guerir vie sante soin heal medikit",
		tooltip = "Rend des points de vie au joueur, sans dépasser sa vie maximum. Ne ranime pas un joueur éliminé.",
		gen = function(a, g)
			return appel(g, "_soigner", a.JOUEUR, g.num(a.POINTS))
		end,
	},
	{
		id = "j_vie_max",
		shape = "stack",
		label = "mettre la vie maximum de %1 à %2",
		inputs = {
			joueurInput(),
			{ name = "VIE", kind = "number", default = 100 },
		},
		keywords = "vie maximum max sante maxhealth",
		tooltip = "Change la vie maximum du joueur (100 par défaut dans Roblox).",
		gen = function(a, g)
			return appel(g, "_vieMax", a.JOUEUR, g.num(a.VIE))
		end,
	},
	{
		id = "j_vitesse",
		shape = "stack",
		label = "mettre la vitesse de marche de %1 à %2",
		inputs = {
			joueurInput(),
			{ name = "VITESSE", kind = "number", default = 16 },
		},
		keywords = "vitesse marche courir rapide lent walkspeed speed",
		tooltip = "Change la vitesse de marche du personnage (16 par défaut dans Roblox).",
		gen = function(a, g)
			return appel(g, "_vitesseMarche", a.JOUEUR, g.num(a.VITESSE))
		end,
	},
	{
		id = "j_saut",
		shape = "stack",
		label = "mettre la puissance de saut de %1 à %2",
		inputs = {
			joueurInput(),
			{ name = "PUISSANCE", kind = "number", default = 50 },
		},
		keywords = "saut sauter puissance hauteur jump jumppower",
		tooltip = "Change la puissance de saut du personnage (50 par défaut). Plus elle est grande, plus il saute haut.",
		gen = function(a, g)
			return appel(g, "_puissanceSaut", a.JOUEUR, g.num(a.PUISSANCE))
		end,
	},
	{
		id = "j_teleporter",
		shape = "stack",
		label = "téléporter %1 à x %2 y %3 z %4",
		inputs = {
			joueurInput(),
			{ name = "X", kind = "number", default = 0 },
			{ name = "Y", kind = "number", default = 10 },
			{ name = "Z", kind = "number", default = 0 },
		},
		keywords = "teleporter deplacer position coordonnees teleport",
		tooltip = "Téléporte le personnage du joueur à la position x, y, z (en studs), en gardant son orientation.",
		gen = function(a, g)
			local position = "Vector3.new(" .. g.num(a.X) .. ", " .. g.num(a.Y) .. ", " .. g.num(a.Z) .. ")"
			return appel(g, "_teleporterJoueur", a.JOUEUR, position)
		end,
	},
	{
		id = "j_teleporter_objet",
		shape = "stack",
		label = "téléporter %1 sur %2",
		inputs = {
			joueurInput(),
			Shared.objInput("OBJ"),
		},
		keywords = "teleporter sur objet partie destination checkpoint teleport",
		tooltip = "Téléporte le personnage du joueur juste au-dessus d'un objet (partie ou modèle).",
		gen = function(a, g)
			return appel(g, "_teleporterJoueurSur", a.JOUEUR, a.OBJ)
		end,
	},
	{
		id = "j_faire_sauter",
		shape = "stack",
		label = "faire sauter %1",
		inputs = { joueurInput() },
		keywords = "sauter saut jump bondir",
		tooltip = "Fait sauter le personnage du joueur (cela le fait aussi descendre d'un siège).",
		gen = function(a, g)
			return appel(g, "_faireSauter", a.JOUEUR)
		end,
	},
	{
		id = "j_reapparaitre",
		shape = "stack",
		label = "faire réapparaître %1",
		inputs = { joueurInput() },
		scriptType = "server",
		keywords = "reapparaitre respawn renaitre recommencer personnage",
		tooltip = "Fait réapparaître le joueur avec un nouveau personnage, à son point d'apparition (script serveur uniquement).",
		gen = function(a, g)
			return appel(g, "_reapparaitre", a.JOUEUR)
		end,
	},

	---------------------------------------------------------------------------
	-- Statistiques du classement (leaderstats)
	---------------------------------------------------------------------------
	{
		id = "j_creer_stat",
		shape = "stack",
		label = "créer la statistique %1 (départ %2)",
		inputs = {
			{ name = "NOM", kind = "text", default = "Pièces" },
			{ name = "DEPART", kind = "number", default = 0 },
		},
		scriptType = "server",
		keywords = "statistique classement leaderstats score points pieces creer tableau",
		tooltip = "Crée une statistique affichée dans le classement (en haut à droite) pour tous les joueurs présents et ceux qui arriveront plus tard. À placer sous « Quand ce script démarre ».",
		gen = function(a, g)
			local etat = g.declare("_etatStatistiques", "{}")
			return appel(g, "_creerStat", etat, g.str(a.NOM), g.num(a.DEPART))
		end,
	},
	{
		id = "j_ajouter_stat",
		shape = "stack",
		label = "ajouter %1 à la statistique %2 de %3",
		inputs = {
			{ name = "VALEUR", kind = "number", default = 1 },
			{ name = "NOM", kind = "text", default = "Pièces" },
			joueurInput(),
		},
		keywords = "statistique classement leaderstats score points pieces ajouter gagner augmenter",
		tooltip = "Ajoute une valeur à une statistique du joueur (un nombre négatif en retire). La statistique est créée si elle n'existe pas encore.",
		gen = function(a, g)
			return appel(g, "_ajouterStat", a.JOUEUR, g.str(a.NOM), g.num(a.VALEUR))
		end,
	},
	{
		id = "j_definir_stat",
		shape = "stack",
		label = "mettre la statistique %1 de %2 à %3",
		inputs = {
			{ name = "NOM", kind = "text", default = "Pièces" },
			joueurInput(),
			{ name = "VALEUR", kind = "any", default = "0" },
		},
		keywords = "statistique classement leaderstats score points pieces mettre definir changer",
		tooltip = "Change la valeur d'une statistique du joueur. La statistique est créée si elle n'existe pas encore.",
		gen = function(a, g)
			return appel(g, "_definirStat", a.JOUEUR, g.str(a.NOM), a.VALEUR)
		end,
	},

	---------------------------------------------------------------------------
	-- Messages, outils, exclusion
	---------------------------------------------------------------------------
	{
		id = "j_message_ecran",
		shape = "stack",
		label = "afficher %1 à l'écran de %2 pendant %3 s",
		inputs = {
			{ name = "MESSAGE", kind = "text", default = "Bonjour !" },
			joueurInput(),
			{ name = "DUREE", kind = "number", default = 3 },
		},
		keywords = "message ecran afficher texte interface gui annonce notification",
		tooltip = "Affiche un message en haut de l'écran du joueur pendant quelques secondes (0 = jusqu'au prochain message). Un nouveau message remplace le précédent ; un texte vide efface le message.",
		gen = function(a, g)
			return appel(g, "_messageEcran", a.JOUEUR, g.str(a.MESSAGE), g.num(a.DUREE))
		end,
	},
	{
		id = "j_message_tous",
		shape = "stack",
		label = "afficher %1 à l'écran de tous les joueurs pendant %2 s",
		inputs = {
			{ name = "MESSAGE", kind = "text", default = "Bonjour à tous !" },
			{ name = "DUREE", kind = "number", default = 3 },
		},
		keywords = "message ecran afficher tous joueurs texte annonce notification",
		tooltip = "Affiche un message en haut de l'écran de tous les joueurs pendant quelques secondes (0 = jusqu'au prochain message). Dans un script local, seul le joueur local le voit.",
		gen = function(a, g)
			return appel(g, "_messageTous", g.str(a.MESSAGE), g.num(a.DUREE))
		end,
	},
	{
		id = "j_donner_outil",
		shape = "stack",
		label = "donner l'outil %1 à %2",
		inputs = {
			{ name = "OUTIL", kind = "text", default = "Épée" },
			joueurInput(),
		},
		scriptType = "server",
		keywords = "outil donner arme tool epee sac backpack objet inventaire",
		tooltip = "Donne au joueur une copie de l'outil (Tool) portant ce nom, cherché dans ServerStorage, ReplicatedStorage, Lighting puis Workspace. Un joueur qui a déjà cet outil n'en reçoit pas un deuxième.",
		gen = function(a, g)
			return appel(g, "_donnerOutil", a.JOUEUR, g.str(a.OUTIL))
		end,
	},
	{
		id = "j_exclure",
		shape = "stack",
		label = "exclure %1 avec le message %2",
		inputs = {
			joueurInput(),
			{ name = "MESSAGE", kind = "text", default = "Au revoir !" },
		},
		scriptType = "server",
		keywords = "exclure expulser kick bannir renvoyer",
		tooltip = "Exclut (expulse) le joueur de la partie en lui affichant un message.",
		gen = function(a, g)
			return appel(g, "_exclure", a.JOUEUR, g.str(a.MESSAGE))
		end,
	},
	{
		id = "j_pour_chaque_joueur",
		shape = "c",
		label = "pour chaque joueur",
		loop = true,
		keywords = "pour chaque joueur tous boucle repeter chacun",
		tooltip = "Répète les blocs à l'intérieur pour chaque joueur présent. Dans la boucle, « le joueur » et « le personnage » désignent le joueur en cours.",
		gen = function(a, g)
			local lignes = {
				"for _, joueur in ipairs(" .. g.service("Players") .. ":GetPlayers()) do",
				"\tlocal personnage = joueur.Character",
			}
			local corps = a.DO or ""
			if corps ~= "" then
				table.insert(lignes, g.indent(corps))
			end
			table.insert(lignes, "end")
			return table.concat(lignes, "\n")
		end,
	},

	---------------------------------------------------------------------------
	-- Valeurs
	---------------------------------------------------------------------------
	{
		id = "j_nom",
		shape = "reporter",
		label = "nom de %1",
		inputs = { joueurInput() },
		keywords = "nom pseudo utilisateur name joueur",
		tooltip = "Le nom d'utilisateur du joueur (unique, sans espaces).",
		gen = function(a, g)
			return appel(g, "_nomJoueur", a.JOUEUR)
		end,
	},
	{
		id = "j_nom_affiche",
		shape = "reporter",
		label = "nom affiché de %1",
		inputs = { joueurInput() },
		keywords = "nom affiche pseudo displayname joueur",
		tooltip = "Le nom affiché du joueur (celui que les autres voient au-dessus de sa tête).",
		gen = function(a, g)
			return appel(g, "_nomAffiche", a.JOUEUR)
		end,
	},
	{
		id = "j_vie_val",
		shape = "reporter",
		label = "vie de %1",
		inputs = { joueurInput() },
		keywords = "vie sante points health pv",
		tooltip = "La vie actuelle du joueur (0 s'il n'a pas de personnage).",
		gen = function(a, g)
			return appel(g, "_vieJoueur", a.JOUEUR)
		end,
	},
	{
		id = "j_stat_val",
		shape = "reporter",
		label = "statistique %1 de %2",
		inputs = {
			{ name = "NOM", kind = "text", default = "Pièces" },
			joueurInput(),
		},
		keywords = "statistique classement leaderstats score points pieces valeur",
		tooltip = "La valeur d'une statistique du classement du joueur (0 si elle n'existe pas).",
		gen = function(a, g)
			return appel(g, "_lireStat", a.JOUEUR, g.str(a.NOM))
		end,
	},
	{
		id = "j_nb_joueurs",
		shape = "reporter",
		label = "nombre de joueurs",
		keywords = "nombre joueurs combien total compter",
		tooltip = "Le nombre de joueurs actuellement dans la partie.",
		gen = function(_a, g)
			return "(#" .. g.service("Players") .. ":GetPlayers())"
		end,
	},
	{
		id = "j_est_joueur",
		shape = "boolean",
		label = "%1 est un joueur",
		inputs = { Shared.objInput("OBJ", "partieTouchee") },
		keywords = "est un joueur personnage humain verifier touche",
		tooltip = "Vrai si l'objet est un joueur, le personnage d'un joueur ou une partie de ce personnage (par exemple la partie qui a touché l'objet).",
		gen = function(a, g)
			return appel(g, "_estJoueur", a.OBJ)
		end,
	},
	{
		id = "j_en_vie",
		shape = "boolean",
		label = "%1 est en vie",
		inputs = { joueurInput() },
		keywords = "en vie vivant mort sante alive",
		tooltip = "Vrai si le joueur a un personnage dont la vie est supérieure à 0.",
		gen = function(a, g)
			return appel(g, "_enVie", a.JOUEUR)
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------
local helpers = {
	-- Avertissement quand aucun joueur / personnage n'a été trouvé
	_avertirCible = {
		deps = { "_avertir" },
		services = { "RunService" },
		code = [[
local function _avertirCible(action, valeur, quoi)
	if valeur == nil then
		if RunService:IsClient() then
			_avertir(action .. " : le " .. quoi .. " du joueur local est introuvable (pas encore chargé ?).")
		else
			_avertir(action .. " : aucun " .. quoi .. " (la valeur est vide). Place ce bloc sous un événement qui fournit « le joueur », ou choisis un autre joueur.")
		end
	else
		_avertir(action .. " : aucun " .. quoi .. " trouvé pour « " .. tostring(valeur) .. " ».")
	end
end]],
	},

	-- Joueur (Player) ou nil + avertissement
	_exigerJoueur = {
		deps = { "_joueur", "_avertirCible" },
		services = {},
		code = [[
local function _exigerJoueur(valeur, action)
	local p = _joueur(valeur)
	if p == nil then
		_avertirCible(action, valeur, "joueur")
	end
	return p
end]],
	},

	-- Personnage (Model) ou nil + avertissement (un nom de joueur désigne ce joueur)
	_exigerPerso = {
		deps = { "_joueur", "_perso", "_avertirCible" },
		services = {},
		code = [[
local function _exigerPerso(valeur, action)
	if type(valeur) == "string" then
		valeur = _joueur(valeur) or valeur
	end
	local perso = _perso(valeur)
	if perso == nil or not perso:IsA("Model") then
		_avertirCible(action, valeur, "personnage")
		return nil
	end
	return perso
end]],
	},

	-- Humanoid ou nil + avertissement (un nom de joueur désigne ce joueur)
	_exigerHumanoid = {
		deps = { "_joueur", "_humanoid", "_avertirCible" },
		services = {},
		code = [[
local function _exigerHumanoid(valeur, action)
	if type(valeur) == "string" then
		valeur = _joueur(valeur) or valeur
	end
	local h = _humanoid(valeur)
	if h == nil then
		_avertirCible(action, valeur, "personnage")
	end
	return h
end]],
	},

	-- Nombre utilisable (ni NaN ni infini), sinon la valeur par défaut
	_nombreOu = {
		deps = {},
		services = {},
		code = [[
local function _nombreOu(valeur, defaut)
	local n = tonumber(valeur)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return defaut
	end
	return n
end]],
	},

	_eliminer = {
		deps = { "_exigerHumanoid" },
		services = {},
		code = [[
local function _eliminer(valeur)
	local h = _exigerHumanoid(valeur, "éliminer")
	if h then
		h.Health = 0
	end
end]],
	},

	_definirVie = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _definirVie(valeur, vie)
	local h = _exigerHumanoid(valeur, "mettre la vie")
	if h == nil then
		return
	end
	vie = math.max(_nombreOu(vie, 0), 0)
	if vie > h.MaxHealth then
		h.MaxHealth = vie
	end
	h.Health = vie
end]],
	},

	_infligerDegats = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _infligerDegats(valeur, degats)
	local h = _exigerHumanoid(valeur, "infliger des dégâts")
	if h == nil then
		return
	end
	h:TakeDamage(math.max(_nombreOu(degats, 0), 0))
end]],
	},

	_soigner = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _soigner(valeur, points)
	local h = _exigerHumanoid(valeur, "soigner")
	if h == nil or h.Health <= 0 then
		return
	end
	h.Health = math.min(h.Health + math.max(_nombreOu(points, 0), 0), h.MaxHealth)
end]],
	},

	_vieMax = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _vieMax(valeur, vie)
	local h = _exigerHumanoid(valeur, "mettre la vie maximum")
	if h == nil then
		return
	end
	h.MaxHealth = math.max(_nombreOu(vie, 100), 1)
end]],
	},

	_vitesseMarche = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _vitesseMarche(valeur, vitesse)
	local h = _exigerHumanoid(valeur, "mettre la vitesse de marche")
	if h == nil then
		return
	end
	h.WalkSpeed = math.max(_nombreOu(vitesse, 16), 0)
end]],
	},

	_puissanceSaut = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _puissanceSaut(valeur, puissance)
	local h = _exigerHumanoid(valeur, "mettre la puissance de saut")
	if h == nil then
		return
	end
	h.UseJumpPower = true
	h.JumpPower = math.max(_nombreOu(puissance, 50), 0)
end]],
	},

	-- Place un personnage à une position (garde son orientation, le fait descendre d'un siège)
	_placerPerso = {
		deps = { "_avertir" },
		services = {},
		code = [[
local function _placerPerso(perso, position)
	local h = perso:FindFirstChildOfClass("Humanoid")
	if h and h.SeatPart then
		local soudure = h.SeatPart:FindFirstChild("SeatWeld")
		if soudure then
			soudure:Destroy()
		end
	end
	local ok, erreur = pcall(function()
		perso:PivotTo(CFrame.new(position) * perso:GetPivot().Rotation)
	end)
	if not ok then
		_avertir("téléporter : impossible de déplacer « " .. perso.Name .. " » (" .. tostring(erreur) .. ").")
	end
end]],
	},

	_teleporterJoueur = {
		deps = { "_exigerPerso", "_placerPerso", "_avertir" },
		services = {},
		code = [[
local function _teleporterJoueur(valeur, position)
	local perso = _exigerPerso(valeur, "téléporter")
	if perso == nil then
		return
	end
	if typeof(position) ~= "Vector3" then
		_avertir("téléporter : la position est invalide.")
		return
	end
	_placerPerso(perso, position)
end]],
	},

	-- Téléporte un personnage juste au-dessus d'un objet (partie, modèle…) ; le dessus est calculé
	-- selon la verticale du monde (_demiHauteur), même si l'objet est tourné (cylindre debout…)
	_teleporterJoueurSur = {
		deps = { "_exigerPerso", "_placerPerso", "_obj", "_pos", "_demiHauteur", "_avertir" },
		services = {},
		code = [[
local function _teleporterJoueurSur(valeur, cible)
	local perso = _exigerPerso(valeur, "téléporter")
	if perso == nil then
		return
	end
	local objet = _obj(cible)
	if objet == nil then
		_avertir("téléporter : l'objet de destination est introuvable.")
		return
	end
	local dessus = nil
	if objet:IsA("BasePart") then
		dessus = objet.Position + Vector3.new(0, _demiHauteur(objet.CFrame, objet.Size), 0)
	elseif objet:IsA("Model") then
		local ok, cadre, taille = pcall(function()
			return objet:GetBoundingBox()
		end)
		if ok and typeof(cadre) == "CFrame" and typeof(taille) == "Vector3" then
			dessus = cadre.Position + Vector3.new(0, _demiHauteur(cadre, taille), 0)
		end
	end
	if dessus == nil then
		dessus = _pos(objet)
	end
	if dessus == nil then
		_avertir("téléporter : impossible de trouver la position de « " .. objet.Name .. " ».")
		return
	end
	-- hauteur entre le sol et le centre du personnage
	local hauteur = 3
	local h = perso:FindFirstChildOfClass("Humanoid")
	local racine = perso:FindFirstChild("HumanoidRootPart")
	if h and racine and racine:IsA("BasePart") and h.RigType == Enum.HumanoidRigType.R15 then
		hauteur = h.HipHeight + racine.Size.Y / 2
	end
	_placerPerso(perso, dessus + Vector3.new(0, hauteur + 0.5, 0))
end]],
	},

	_faireSauter = {
		deps = { "_exigerHumanoid" },
		services = {},
		code = [[
local function _faireSauter(valeur)
	local h = _exigerHumanoid(valeur, "faire sauter")
	if h then
		h.Jump = true
	end
end]],
	},

	_reapparaitre = {
		deps = { "_exigerJoueur", "_avertir" },
		services = { "RunService" },
		code = [[
local function _reapparaitre(valeur)
	local p = _exigerJoueur(valeur, "faire réapparaître")
	if p == nil then
		return
	end
	if RunService:IsClient() then
		_avertir("faire réapparaître : ce bloc ne fonctionne que dans un script serveur.")
		return
	end
	local ok, erreur = pcall(function()
		p:LoadCharacter()
	end)
	if not ok then
		_avertir("faire réapparaître : impossible pour « " .. p.Name .. " » (" .. tostring(erreur) .. ").")
	end
end]],
	},

	-- Statistique « nom » du dossier leaderstats d'un joueur (Player).
	-- Si creerAvec n'est pas nil, crée le dossier et la statistique manquants avec cette valeur :
	-- IntValue pour un entier, NumberValue pour un nombre à virgule, StringValue pour un texte.
	_statTrouver = {
		deps = { "_texte" },
		services = {},
		code = [[
local function _statTrouver(p, nom, creerAvec)
	local dossier = p:FindFirstChild("leaderstats")
	if dossier == nil then
		if creerAvec == nil then
			return nil
		end
		dossier = Instance.new("Folder")
		dossier.Name = "leaderstats"
		dossier.Parent = p
	end
	local stat = dossier:FindFirstChild(nom)
	if stat == nil and creerAvec ~= nil then
		local n = nil
		if type(creerAvec) == "number" then
			n = creerAvec
		elseif type(creerAvec) == "string" then
			n = tonumber((string.gsub(creerAvec, ",", ".")))
		end
		if n ~= nil and (n ~= n or math.abs(n) == math.huge) then
			n = 0
		end
		if n == nil then
			stat = Instance.new("StringValue")
			stat.Value = _texte(creerAvec)
		elseif n == math.floor(n) and math.abs(n) < 9007199254740992 then
			stat = Instance.new("IntValue")
			stat.Value = n
		else
			stat = Instance.new("NumberValue")
			stat.Value = n
		end
		stat.Name = nom
		stat.Parent = dossier
	end
	return stat
end]],
	},

	-- Écrit une valeur dans une statistique (un IntValue devient NumberValue si la valeur a des décimales)
	_ecrireStat = {
		deps = { "_num", "_texte", "_avertir" },
		services = {},
		code = [[
local function _ecrireStat(stat, valeur)
	if stat:IsA("IntValue") or stat:IsA("NumberValue") then
		local n = _num(valeur)
		if n ~= n or math.abs(n) == math.huge then
			n = 0
		end
		if stat:IsA("IntValue") and (n ~= math.floor(n) or math.abs(n) >= 9007199254740992) then
			-- un nombre à virgule ne tient pas dans un IntValue : on le remplace par un NumberValue
			local nouveau = Instance.new("NumberValue")
			nouveau.Name = stat.Name
			nouveau.Value = n
			local parent = stat.Parent
			stat:Destroy()
			nouveau.Parent = parent
		else
			stat.Value = n
		end
	elseif stat:IsA("StringValue") then
		stat.Value = _texte(valeur)
	elseif stat:IsA("BoolValue") then
		if type(valeur) == "boolean" then
			stat.Value = valeur
		else
			stat.Value = _num(valeur) ~= 0
		end
	else
		local ok = pcall(function()
			stat.Value = valeur
		end)
		if not ok then
			_avertir("statistique « " .. stat.Name .. " » : impossible de lui donner cette valeur.")
		end
	end
end]],
	},

	-- Crée une statistique pour tous les joueurs présents et futurs.
	-- etat : table déclarée une seule fois dans le script (évite de connecter PlayerAdded plusieurs fois).
	_creerStat = {
		deps = { "_statTrouver", "_texte", "_avertir" },
		services = { "Players" },
		code = [[
local function _creerStat(etat, nom, depart)
	nom = _texte(nom)
	if nom == "" then
		_avertir("créer la statistique : le nom est vide.")
		return
	end
	depart = tonumber(depart) or 0
	if type(etat) ~= "table" then
		etat = {}
	end
	if etat.noms == nil then
		etat.noms = {}
		etat.departs = {}
		Players.PlayerAdded:Connect(function(p)
			for _, n in ipairs(etat.noms) do
				_statTrouver(p, n, etat.departs[n])
			end
		end)
	end
	if etat.departs[nom] == nil then
		table.insert(etat.noms, nom)
	end
	etat.departs[nom] = depart
	for _, p in ipairs(Players:GetPlayers()) do
		_statTrouver(p, nom, depart)
	end
end]],
	},

	_ajouterStat = {
		deps = { "_exigerJoueur", "_statTrouver", "_ecrireStat", "_texte", "_num", "_avertir" },
		services = {},
		code = [[
local function _ajouterStat(valeur, nom, quantite)
	local p = _exigerJoueur(valeur, "ajouter à la statistique")
	if p == nil then
		return
	end
	nom = _texte(nom)
	if nom == "" then
		_avertir("ajouter à la statistique : le nom de la statistique est vide.")
		return
	end
	local stat = _statTrouver(p, nom, 0)
	if stat == nil or not (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
		_avertir("ajouter à la statistique : « " .. nom .. " » ne contient pas un nombre.")
		return
	end
	_ecrireStat(stat, stat.Value + _num(quantite))
end]],
	},

	_definirStat = {
		deps = { "_exigerJoueur", "_statTrouver", "_ecrireStat", "_texte", "_avertir" },
		services = {},
		code = [[
local function _definirStat(valeur, nom, v)
	local p = _exigerJoueur(valeur, "mettre la statistique")
	if p == nil then
		return
	end
	nom = _texte(nom)
	if nom == "" then
		_avertir("mettre la statistique : le nom de la statistique est vide.")
		return
	end
	if v == nil then
		v = 0
	end
	local stat = _statTrouver(p, nom, v)
	if stat == nil or not stat:IsA("ValueBase") then
		_avertir("mettre la statistique : « " .. nom .. " » n'est pas une statistique.")
		return
	end
	_ecrireStat(stat, v)
end]],
	},

	_lireStat = {
		deps = { "_exigerJoueur", "_statTrouver", "_texte", "_avertir" },
		services = {},
		code = [[
local function _lireStat(valeur, nom)
	local p = _exigerJoueur(valeur, "statistique")
	if p == nil then
		return 0
	end
	nom = _texte(nom)
	local stat = _statTrouver(p, nom, nil)
	if stat == nil or not stat:IsA("ValueBase") then
		_avertir("la statistique « " .. nom .. " » n'existe pas pour « " .. p.Name .. " ».")
		return 0
	end
	return stat.Value
end]],
	},

	-- Message en haut de l'écran d'un joueur (ScreenGui « BlocsFR_Message » dans son PlayerGui).
	-- Fonctionne depuis un script serveur (n'importe quel joueur) ou local (joueur local).
	_messageEcran = {
		deps = { "_exigerJoueur", "_texte", "_num", "_avertir" },
		services = { "Players", "RunService" },
		code = [[
local function _messageEcran(valeur, message, duree)
	local p = _exigerJoueur(valeur, "afficher à l'écran")
	if p == nil then
		return
	end
	if RunService:IsClient() and p ~= Players.LocalPlayer then
		_avertir("afficher à l'écran : un script local ne peut afficher un message que sur l'écran du joueur local.")
		return
	end
	local texte = _texte(message)
	local secondes = _num(duree)
	task.spawn(function()
		local interface = p:FindFirstChildOfClass("PlayerGui")
		if interface == nil then
			interface = p:WaitForChild("PlayerGui", 5)
		end
		if interface == nil then
			_avertir("afficher à l'écran : l'écran de « " .. p.Name .. " » est introuvable.")
			return
		end
		local ancien = interface:FindFirstChild("BlocsFR_Message")
		if ancien then
			ancien:Destroy()
		end
		if texte == "" then
			return
		end
		local ecran = Instance.new("ScreenGui")
		ecran.Name = "BlocsFR_Message"
		ecran.ResetOnSpawn = false
		ecran.DisplayOrder = 50
		ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		local etiquette = Instance.new("TextLabel")
		etiquette.Name = "Message"
		etiquette.AnchorPoint = Vector2.new(0.5, 0)
		etiquette.Position = UDim2.new(0.5, 0, 0, 24)
		etiquette.Size = UDim2.new(0.6, 0, 0, 0)
		etiquette.AutomaticSize = Enum.AutomaticSize.Y
		etiquette.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
		etiquette.BackgroundTransparency = 0.15
		etiquette.BorderSizePixel = 0
		etiquette.Font = Enum.Font.GothamBold
		etiquette.TextSize = 24
		etiquette.TextColor3 = Color3.fromRGB(255, 255, 255)
		etiquette.TextWrapped = true
		etiquette.Text = texte
		etiquette.Parent = ecran
		local coins = Instance.new("UICorner")
		coins.CornerRadius = UDim.new(0, 12)
		coins.Parent = etiquette
		local marges = Instance.new("UIPadding")
		marges.PaddingTop = UDim.new(0, 12)
		marges.PaddingBottom = UDim.new(0, 12)
		marges.PaddingLeft = UDim.new(0, 18)
		marges.PaddingRight = UDim.new(0, 18)
		marges.Parent = etiquette
		local limite = Instance.new("UISizeConstraint")
		limite.MinSize = Vector2.new(220, 0)
		limite.MaxSize = Vector2.new(720, math.huge)
		limite.Parent = etiquette
		local contour = Instance.new("UIStroke")
		contour.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		contour.Color = Color3.fromRGB(255, 255, 255)
		contour.Transparency = 0.8
		contour.Thickness = 1
		contour.Parent = etiquette
		ecran.Parent = interface
		if secondes > 0 then
			task.delay(secondes, function()
				if ecran.Parent then
					ecran:Destroy()
				end
			end)
		end
	end)
end]],
	},

	-- Message à l'écran de tous les joueurs (script local : seulement le joueur local)
	_messageTous = {
		deps = { "_messageEcran" },
		services = { "Players", "RunService" },
		code = [[
local function _messageTous(message, duree)
	if RunService:IsClient() then
		_messageEcran(Players.LocalPlayer, message, duree)
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		_messageEcran(p, message, duree)
	end
end]],
	},

	-- Donne une copie d'un outil (Tool) cherché par son nom
	_donnerOutil = {
		deps = { "_exigerJoueur", "_texte", "_avertir" },
		services = { "Players" },
		code = [[
local function _donnerOutil(valeur, nom)
	local p = _exigerJoueur(valeur, "donner l'outil")
	if p == nil then
		return
	end
	nom = _texte(nom)
	if nom == "" then
		_avertir("donner l'outil : le nom de l'outil est vide.")
		return
	end
	local cherche = string.lower(nom)
	local modele, approchant = nil, nil
	for _, nomService in ipairs({ "ServerStorage", "ReplicatedStorage", "Lighting", "Workspace" }) do
		local ok, conteneur = pcall(game.GetService, game, nomService)
		if ok and conteneur then
			for _, d in ipairs(conteneur:GetDescendants()) do
				-- on ignore les outils tenus en main par un personnage
				if d:IsA("Tool") and Players:GetPlayerFromCharacter(d.Parent) == nil then
					if d.Name == nom then
						modele = d
						break
					elseif approchant == nil and string.lower(d.Name) == cherche then
						approchant = d
					end
				end
			end
		end
		if modele then
			break
		end
	end
	modele = modele or approchant
	if modele == nil then
		_avertir("donner l'outil : aucun outil (Tool) nommé « " .. nom .. " » dans ServerStorage, ReplicatedStorage, Lighting ou Workspace.")
		return
	end
	local sac = p:FindFirstChildOfClass("Backpack")
	if sac == nil then
		_avertir("donner l'outil : le sac à dos de « " .. p.Name .. " » est introuvable.")
		return
	end
	-- un seul exemplaire : le joueur qui a déjà cet outil (dans son sac ou en main) n'en reçoit pas d'autre
	local dansSac = sac:FindFirstChild(modele.Name)
	local enMain = p.Character and p.Character:FindFirstChild(modele.Name)
	if (dansSac and dansSac:IsA("Tool")) or (enMain and enMain:IsA("Tool")) then
		return
	end
	local ok, copie = pcall(function()
		return modele:Clone()
	end)
	if not ok or copie == nil then
		_avertir("donner l'outil : impossible de copier « " .. modele.Name .. " » (sa propriété Archivable est-elle désactivée ?).")
		return
	end
	copie.Parent = sac
end]],
	},

	_exclure = {
		deps = { "_exigerJoueur", "_texte", "_avertir" },
		services = {},
		code = [[
local function _exclure(valeur, message)
	local p = _exigerJoueur(valeur, "exclure")
	if p == nil then
		return
	end
	local texte = _texte(message)
	local ok, erreur = pcall(function()
		p:Kick(texte)
	end)
	if not ok then
		_avertir("exclure : impossible d'exclure « " .. p.Name .. " » (" .. tostring(erreur) .. ").")
	end
end]],
	},

	_nomJoueur = {
		deps = { "_exigerJoueur" },
		services = {},
		code = [[
local function _nomJoueur(valeur)
	local p = _exigerJoueur(valeur, "nom du joueur")
	if p == nil then
		return ""
	end
	return p.Name
end]],
	},

	_nomAffiche = {
		deps = { "_exigerJoueur" },
		services = {},
		code = [[
local function _nomAffiche(valeur)
	local p = _exigerJoueur(valeur, "nom affiché du joueur")
	if p == nil then
		return ""
	end
	return p.DisplayName
end]],
	},

	_vieJoueur = {
		deps = { "_exigerHumanoid" },
		services = {},
		code = [[
local function _vieJoueur(valeur)
	local h = _exigerHumanoid(valeur, "vie du joueur")
	if h == nil then
		return 0
	end
	return h.Health
end]],
	},

	-- Vrai si la valeur est un joueur, son personnage ou une partie de son personnage
	-- (pas d'avertissement : « non » est une réponse normale)
	_estJoueur = {
		deps = { "_joueur" },
		services = {},
		code = [[
local function _estJoueur(valeur)
	if valeur == nil then
		return false
	end
	return _joueur(valeur) ~= nil
end]],
	},

	-- Vrai si le personnage existe et a encore de la vie (pas d'avertissement : « non » est normal)
	_enVie = {
		deps = { "_joueur", "_humanoid" },
		services = {},
		code = [[
local function _enVie(valeur)
	if type(valeur) == "string" then
		valeur = _joueur(valeur) or valeur
	end
	local h = _humanoid(valeur)
	if h == nil then
		return false
	end
	return h.Health > 0 and h:GetState() ~= Enum.HumanoidStateType.Dead
end]],
	},
}

return {
	category = "joueurs",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Defs_Modules</string><ProtectedString name="Source"><![CDATA[-- Defs_Modules : blocs « Modules » (SPEC §20). Un projet en mode « module » devient un ModuleScript
-- (« BlocsModule ») qui ne s'exécute pas tout seul : il démarre la première fois qu'un autre script
-- le charge avec require(…), qui renvoie la table « Module » (ses fonctions et ses valeurs).
--
-- * mod_fonction / mod_au_chargement / mod_definir_valeur / mod_parametre / mod_renvoyer : pour
--   écrire le module (scriptType "module").
-- * mod_appeler / mod_resultat / mod_valeur / mod_existe : pour utiliser un module depuis n'importe
--   quel script (serveur, local ou module).
--
-- En mode « module », CodeGen déclare « local Module = {} » avant les événements et termine le
-- script par « return Module ». Les blocs qui écrivent dans Module font aussi
-- g.declare("Module", "{}") : le code reste valide dans les autres modes (la table est alors
-- locale au script ; CodeGen avertit que ces blocs ne fonctionnent que dans un script module).
--
-- NOTE: « Définir la fonction » porte deux champs propres à ce fichier, lus par CodeGen :
--   functionBody = true : son corps est le corps d'une fonction (g.inFunction() y vaut vrai) ;
--   emitEmpty = true    : la fonction est créée même sans bloc dessous (elle existe mais ne fait
--                         rien), pour que les scripts qui l'appellent ne reçoivent pas d'erreur.
-- NOTE: les fonctions utiles gardent leur état (modules chargés, recherches par nom, derniers
-- avertissements) dans shared.BlocsFR_Modules : une fonction utile ne peut pas avoir de variable
-- propre en dehors d'elle (§5.4). Cette table est commune aux scripts d'un même côté, comme le
-- cache de require lui-même.

local Util = require(script.Parent.Util)

local PARAMETRES = { "P1", "P2", "P3" } -- entrées des noms de paramètres
local ARGUMENTS = { "p1", "p2", "p3" } -- paramètres Luau de la fonction générée

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

-- Code indenté d'un niveau, précédé d'un saut de ligne ("" si le code est vide)
local function corps(g, code)
	if code == nil or code == "" then
		return ""
	end
	return "\n" .. g.indent(code)
end

-- Assemble les morceaux de code non vides, un par ligne
local function lignes(...)
	local out = {}
	for i = 1, select("#", ...) do
		local morceau = select(i, ...)
		if morceau ~= nil and morceau ~= "" then
			table.insert(out, morceau)
		end
	end
	return table.concat(out, "\n")
end

-- Valeur littérale d'une entrée, sans espaces autour ; nil quand un bloc valeur y est branché
local function brut(a, nom)
	if type(a.raw) ~= "table" or a.raw[nom] == nil then
		return nil
	end
	return Util.trim(tostring(a.raw[nom]))
end

-- Clé de texte (nom de fonction, de valeur ou de paramètre) : le littéral sans espaces autour,
-- sinon _texte(expression) (jamais nil : une clé nil ferait planter le script)
local function cleTexte(a, g, nom)
	local texte = brut(a, nom)
	if texte ~= nil then
		return Util.strLiteral(texte)
	end
	return g.str(a[nom])
end

-- Référence d'un module : le nom littéral sans espaces autour, sinon l'expression telle quelle
-- (un bloc valeur peut donner un objet : le ModuleScript lui-même ou l'objet qui le contient)
local function refModule(a)
	local texte = brut(a, "MODULE")
	if texte ~= nil then
		return Util.strLiteral(texte)
	end
	return a.MODULE or "nil"
end

-- Argument d'un appel : une case laissée vide donne « rien » (nil)
local function argument(a, nom)
	if brut(a, nom) == "" then
		return "nil"
	end
	return a[nom] or "nil"
end

-- _appelerModule(module, nom, a, b, c) ; les « rien » de la fin sont retirés
local function appelModule(a, g)
	local extras = { argument(a, "A"), argument(a, "B"), argument(a, "C") }
	local n = #extras
	while n > 0 and extras[n] == "nil" do
		n -= 1
	end
	local args = { refModule(a), cleTexte(a, g, "NOM") }
	for i = 1, n do
		table.insert(args, extras[i])
	end
	return g.helper("_appelerModule") .. "(" .. table.concat(args, ", ") .. ")"
end

local function dansFonction(g)
	return type(g.inFunction) == "function" and g.inFunction() == true
end

-- Entrées communes de « appeler la fonction » et « résultat de »
local function entreesAppel()
	return {
		{ name = "NOM", kind = "text", default = "maFonction" },
		{ name = "MODULE", kind = "text", default = "Outils" },
		{ name = "A", kind = "any", default = "" },
		{ name = "B", kind = "any", default = "" },
		{ name = "C", kind = "any", default = "" },
	}
end

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "mod_fonction",
		shape = "hat",
		label = "Définir la fonction %1 (paramètres : %2 %3 %4)",
		inputs = {
			{ name = "NOM", kind = "text", default = "maFonction" },
			{ name = "P1", kind = "text", default = "a" },
			{ name = "P2", kind = "text", default = "b" },
			{ name = "P3", kind = "text", default = "" },
		},
		scriptType = "module",
		hatOrder = 1,
		provides = { "paramètres" },
		functionBody = true,
		emitEmpty = true,
		keywords = "définir fonction module paramètres function procédure outil créer méthode",
		tooltip = "Script module : crée une fonction que les autres scripts peuvent appeler (bloc « appeler la fonction … du module … »). Les paramètres sont les valeurs reçues à l'appel, dans l'ordre : on les lit avec le bloc « paramètre ». Une case de paramètre vide est ignorée.",
		gen = function(a, g)
			local module = g.declare("Module", "{}")
			local nom = brut(a, "NOM")
			if nom == "" then
				g.warn("« Définir la fonction » : la fonction n'a pas de nom, les autres scripts ne pourront pas l'appeler.")
			end
			local entrees = {}
			local vus = {}
			for i, champ in ipairs(PARAMETRES) do
				local texte = brut(a, champ)
				if texte == nil then
					-- nom donné par un bloc valeur : calculé à chaque appel
					table.insert(entrees, "[" .. g.str(a[champ]) .. "] = " .. ARGUMENTS[i])
				elseif texte ~= "" then
					if vus[texte] then
						g.warn("« Définir la fonction » : le paramètre « " .. texte .. " » est écrit deux fois (seul le premier compte).")
					else
						vus[texte] = true
						table.insert(entrees, "[" .. Util.strLiteral(texte) .. "] = " .. ARGUMENTS[i])
					end
				end
			end
			local parametres = "local P = {" .. table.concat(entrees, ", ") .. "}"
			return module
				.. "["
				.. cleTexte(a, g, "NOM")
				.. "] = function("
				.. table.concat(ARGUMENTS, ", ")
				.. ")"
				.. corps(g, lignes(parametres, a.BODY))
				.. "\nend"
		end,
	},
	{
		id = "mod_au_chargement",
		shape = "hat",
		label = "Quand le module est chargé",
		inputs = {},
		scriptType = "module",
		hatOrder = 2,
		keywords = "module chargé chargement démarrage début require initialiser préparer",
		tooltip = "Script module : s'exécute une seule fois, la première fois qu'un script charge ce module, juste après la création de ses fonctions. Le script qui charge le module attend la fin de ces blocs.",
		gen = function(a, g)
			-- dans le code du module lui-même (pas de task.spawn) : require attend la fin. Les blocs sont
			-- dans une fonction appelée tout de suite : un « return » (« arrêter ce script ») n'arrête que
			-- ces blocs, jamais le code du module, qui doit toujours finir par « return Module ».
			local chargement = g.uid("auChargement")
			return "do\n\tlocal function "
				.. chargement
				.. "()"
				.. corps(g, g.indent(a.BODY))
				.. "\n\tend\n\t"
				.. chargement
				.. "()\nend"
		end,
	},
	{
		id = "mod_definir_valeur",
		shape = "stack",
		label = "mettre la valeur %1 du module à %2",
		inputs = {
			{ name = "NOM", kind = "text", default = "vitesse" },
			{ name = "VALEUR", kind = "any", default = "16" },
		},
		scriptType = "module",
		keywords = "mettre valeur module définir réglage constante partager donnée propriété",
		tooltip = "Script module : range une valeur dans le module. Les autres scripts la lisent avec le bloc « valeur … du module … ».",
		gen = function(a, g)
			local module = g.declare("Module", "{}")
			if brut(a, "NOM") == "" then
				g.warn("« mettre la valeur … du module » : la valeur n'a pas de nom.")
			end
			return module .. "[" .. cleTexte(a, g, "NOM") .. "] = " .. (a.VALEUR or "nil")
		end,
	},
	{
		id = "mod_parametre",
		shape = "reporter",
		label = "paramètre %1",
		inputs = { { name = "NOM", kind = "text", default = "a" } },
		scriptType = "module",
		keywords = "paramètre argument entrée valeur reçue fonction module",
		tooltip = "Script module : la valeur reçue par la fonction pour ce paramètre (écris le même nom que dans « Définir la fonction »). Vaut « rien » si l'appel ne l'a pas donnée.",
		gen = function(a, g)
			if g.hatDefId ~= "mod_fonction" then
				g.warn("Le bloc « paramètre » ne sert que sous « Définir la fonction » : ailleurs, il vaut « rien ».")
			end
			-- P existe toujours au premier niveau ; chaque fonction a son propre P (paramètres reçus)
			local parametres = g.declare("P", "{}")
			return parametres .. "[" .. cleTexte(a, g, "NOM") .. "]"
		end,
	},
	{
		id = "mod_renvoyer",
		shape = "cap",
		label = "renvoyer %1",
		inputs = { { name = "VALEUR", kind = "any", default = "" } },
		scriptType = "module",
		keywords = "renvoyer retourner résultat return fonction module réponse terminer",
		tooltip = "Script module : termine la fonction et donne cette valeur comme résultat au script qui l'a appelée (bloc « résultat de … du module … »). Ne fonctionne que sous « Définir la fonction ».",
		gen = function(a, g)
			if not dansFonction(g) then
				g.warn("« renvoyer » n'est utile que sous « Définir la fonction » (et pas dans « lancer en parallèle » ni « après … secondes ») : ce bloc a été ignoré.")
				return "-- renvoyer : ignoré (ce bloc n'est pas dans une fonction du module)"
			end
			if brut(a, "VALEUR") == "" then
				return "return nil"
			end
			return "return " .. (a.VALEUR or "nil")
		end,
	},
	{
		id = "mod_appeler",
		shape = "stack",
		label = "appeler la fonction %1 du module %2 avec %3 %4 %5",
		inputs = entreesAppel(),
		keywords = "appeler fonction module require utiliser lancer exécuter outil call",
		tooltip = "Charge le module (son nom, ou l'objet qui le contient) et appelle une de ses fonctions avec jusqu'à trois valeurs. Une case vide n'envoie rien. Le module est cherché dans ReplicatedStorage, puis (scripts serveur) ServerScriptService et ServerStorage, puis Workspace.",
		gen = function(a, g)
			return appelModule(a, g)
		end,
	},
	{
		id = "mod_resultat",
		shape = "reporter",
		label = "résultat de %1 du module %2 avec %3 %4 %5",
		inputs = entreesAppel(),
		keywords = "résultat fonction module appeler renvoyer valeur calculer require",
		tooltip = "Appelle une fonction d'un module et donne la valeur qu'elle renvoie (bloc « renvoyer » dans le module). Donne « rien » si le module ou la fonction est introuvable.",
		gen = function(a, g)
			-- entre parenthèses : une seule valeur, même si la fonction en renvoie plusieurs
			return "(" .. appelModule(a, g) .. ")"
		end,
	},
	{
		id = "mod_valeur",
		shape = "reporter",
		label = "valeur %1 du module %2",
		inputs = {
			{ name = "NOM", kind = "text", default = "vitesse" },
			{ name = "MODULE", kind = "text", default = "Outils" },
		},
		keywords = "valeur module lire donnée réglage constante require",
		tooltip = "Lit une valeur rangée dans un module (bloc « mettre la valeur … du module »). Donne « rien » si le module ou la valeur est introuvable.",
		gen = function(a, g)
			return g.helper("_valeurModule") .. "(" .. refModule(a) .. ", " .. cleTexte(a, g, "NOM") .. ")"
		end,
	},
	{
		id = "mod_existe",
		shape = "boolean",
		label = "le module %1 existe",
		inputs = { { name = "MODULE", kind = "text", default = "Outils" } },
		keywords = "module existe trouvé présent disponible vérifier",
		tooltip = "Vrai si un script module de ce nom (ou un objet qui en contient un) est trouvé. Le module n'est pas chargé.",
		gen = function(a, g)
			return g.helper("_moduleExiste") .. "(" .. refModule(a) .. ")"
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- État commun des blocs Modules (une table par côté, dans « shared ») : modules chargés,
	-- modules trouvés par nom, noms introuvables récents et derniers avertissements
	_etatModules = {
		deps = {},
		services = {},
		code = [[
local function _etatModules()
	local etat = shared.BlocsFR_Modules
	if type(etat) ~= "table" or type(etat.charges) ~= "table" or type(etat.noms) ~= "table"
		or type(etat.absents) ~= "table" or type(etat.avertis) ~= "table" then
		etat = {
			charges = setmetatable({}, { __mode = "k" }),
			noms = {},
			absents = {},
			avertis = {},
		}
		shared.BlocsFR_Modules = etat
	end
	return etat
end]],
	},

	-- Avertissement (au plus une fois toutes les 5 secondes pour un même message)
	_avertirModule = {
		deps = { "_avertir", "_etatModules" },
		services = {},
		code = [[
local function _avertirModule(message)
	local etat = _etatModules()
	local texte = tostring(message)
	local maintenant = os.clock()
	local dernier = etat.avertis[texte]
	if dernier ~= nil and maintenant - dernier < 5 then
		return
	end
	etat.avertis[texte] = maintenant
	_avertir(texte)
end]],
	},

	-- ModuleScript désigné par ref, ou nil (sans avertissement) :
	--   objet : le ModuleScript lui-même, sinon son enfant « BlocsModule », sinon son premier ModuleScript ;
	--   nom   : objet de ce nom qui est ou contient un ModuleScript (un module Blocs FR est préféré),
	--           cherché dans ReplicatedStorage, puis (serveur) ServerScriptService et ServerStorage,
	--           puis Workspace, ReplicatedFirst, StarterPlayer ; un chemin « Dossier.Outils » marche aussi.
	_trouverModule = {
		deps = { "_etatModules" },
		services = { "RunService" },
		code = [[
local function _trouverModule(ref)
	local function moduleDe(objet)
		if typeof(objet) ~= "Instance" then
			return nil
		end
		if objet:IsA("ModuleScript") then
			return objet
		end
		local blocs = objet:FindFirstChild("BlocsModule")
		if blocs ~= nil and blocs:IsA("ModuleScript") then
			return blocs
		end
		return objet:FindFirstChildWhichIsA("ModuleScript")
	end
	if typeof(ref) == "Instance" then
		return moduleDe(ref)
	end
	if type(ref) == "number" then
		ref = tostring(ref)
	end
	if type(ref) ~= "string" then
		return nil
	end
	local nom = string.match(ref, "^%s*(.-)%s*$")
	if nom == "" then
		return nil
	end
	local etat = _etatModules()
	local connu = etat.noms[nom]
	if connu ~= nil then
		local ok, valide = pcall(function()
			return (connu.chemin or connu.objet.Name == nom)
				and connu.objet:IsDescendantOf(game)
				and moduleDe(connu.objet) == connu.module
		end)
		if ok and valide then
			return connu.module
		end
		etat.noms[nom] = nil
	end
	local absent = etat.absents[nom]
	if absent ~= nil and os.clock() - absent < 1 then
		return nil
	end
	local trouveObjet, trouveModule, parChemin = nil, nil, false
	-- chemin « Service.Dossier.Objet » (le premier morceau peut être « game »)
	if string.find(nom, ".", 1, true) then
		local objet = game
		for morceau in string.gmatch(nom, "[^%.]+") do
			if not (objet == game and morceau == "game") then
				local enfant = objet:FindFirstChild(morceau)
				if enfant == nil and objet == game then
					local okService, service = pcall(function()
						return game:FindService(morceau)
					end)
					if okService then
						enfant = service
					end
				end
				objet = enfant
				if objet == nil then
					break
				end
			end
		end
		if objet ~= nil and objet ~= game then
			local module = moduleDe(objet)
			if module ~= nil then
				trouveObjet, trouveModule, parChemin = objet, module, true
			end
		end
	end
	if trouveModule == nil then
		local endroits = { "ReplicatedStorage" }
		if RunService:IsServer() then
			table.insert(endroits, "ServerScriptService")
			table.insert(endroits, "ServerStorage")
		end
		table.insert(endroits, "Workspace")
		table.insert(endroits, "ReplicatedFirst")
		table.insert(endroits, "StarterPlayer")
		for _, nomService in ipairs(endroits) do
			local ok, liste = pcall(function()
				return game:GetService(nomService):GetDescendants()
			end)
			if ok and type(liste) == "table" then
				for _, objet in ipairs(liste) do
					if objet.Name == nom then
						local module = moduleDe(objet)
						if module ~= nil then
							if module.Name == "BlocsModule" or module:GetAttribute("BlocsFR") == true then
								trouveObjet, trouveModule = objet, module
								break
							end
							if trouveModule == nil then
								trouveObjet, trouveModule = objet, module
							end
						end
					end
				end
			end
			if trouveModule ~= nil then
				break
			end
		end
	end
	if trouveModule ~= nil then
		etat.noms[nom] = { objet = trouveObjet, module = trouveModule, chemin = parChemin }
		etat.absents[nom] = nil
	else
		etat.absents[nom] = os.clock()
	end
	return trouveModule
end]],
	},

	-- Charge un module (require protégé, résultat gardé pour chaque ModuleScript).
	-- Renvoie valeur, true ; ou nil, false (avec un avertissement en français).
	_requireModule = {
		deps = { "_trouverModule", "_avertirModule", "_etatModules", "_texte" },
		services = { "RunService" },
		code = [[
local function _requireModule(ref)
	local module = _trouverModule(ref)
	if module == nil and typeof(ref) ~= "Instance" and RunService:IsClient() and not game:IsLoaded() then
		-- chez un joueur, le jeu n'est peut-être pas encore entièrement arrivé
		game.Loaded:Wait()
		_etatModules().absents = {}
		module = _trouverModule(ref)
	end
	if module == nil then
		if typeof(ref) == "Instance" then
			_avertirModule("« " .. ref:GetFullName() .. " » n'est pas un script module et n'en contient aucun.")
		elseif ref == nil or _texte(ref) == "" then
			_avertirModule("Aucun module indiqué : écris le nom du script module (ou de l'objet qui le contient).")
		elseif RunService:IsClient() then
			_avertirModule("Module « " .. _texte(ref) .. " » introuvable. Un script local ne voit pas ServerScriptService ni ServerStorage : range le module dans ReplicatedStorage.")
		else
			_avertirModule("Module « " .. _texte(ref) .. " » introuvable (cherché dans ReplicatedStorage, ServerScriptService, ServerStorage, Workspace, ReplicatedFirst et StarterPlayer). Vérifie son nom.")
		end
		return nil, false
	end
	local etat = _etatModules()
	local connu = etat.charges[module]
	if connu ~= nil then
		return connu.valeur, connu.ok
	end
	local ok, valeur = pcall(require, module)
	if not ok then
		etat.charges[module] = { ok = false }
		_avertirModule("Le module « " .. module:GetFullName() .. " » a une erreur et n'a pas pu être chargé : " .. tostring(valeur))
		return nil, false
	end
	etat.charges[module] = { ok = true, valeur = valeur }
	return valeur, true
end]],
	},

	-- Appelle la fonction nom du module ref avec les valeurs données et renvoie son résultat.
	-- L'appel lui-même n'est pas protégé : une erreur dans la fonction garde son vrai emplacement.
	_appelerModule = {
		deps = { "_requireModule", "_avertirModule", "_texte" },
		services = {},
		code = [[
local function _appelerModule(ref, nom, ...)
	local valeur, ok = _requireModule(ref)
	if not ok then
		return nil
	end
	local cle = _texte(nom)
	if type(valeur) ~= "table" then
		_avertirModule("Le module « " .. _texte(ref) .. " » ne renvoie pas une table : impossible d'y appeler la fonction « " .. cle .. " ».")
		return nil
	end
	local fonction = valeur[cle]
	if fonction == nil then
		fonction = valeur[string.match(cle, "^%s*(.-)%s*$")]
	end
	if type(fonction) ~= "function" then
		if fonction == nil then
			_avertirModule("La fonction « " .. cle .. " » n'existe pas dans le module « " .. _texte(ref) .. " ».")
		else
			_avertirModule("« " .. cle .. " » n'est pas une fonction dans le module « " .. _texte(ref) .. " » : c'est une valeur (bloc « valeur … du module … »).")
		end
		return nil
	end
	return fonction(...)
end]],
	},

	-- Valeur nom du module ref (ou nil, avec un avertissement)
	_valeurModule = {
		deps = { "_requireModule", "_avertirModule", "_texte" },
		services = {},
		code = [[
local function _valeurModule(ref, nom)
	local valeur, ok = _requireModule(ref)
	if not ok then
		return nil
	end
	local cle = _texte(nom)
	if type(valeur) ~= "table" then
		_avertirModule("Le module « " .. _texte(ref) .. " » ne renvoie pas une table : impossible d'y lire « " .. cle .. " ».")
		return nil
	end
	local resultat = valeur[cle]
	if resultat == nil then
		resultat = valeur[string.match(cle, "^%s*(.-)%s*$")]
	end
	if resultat == nil then
		_avertirModule("La valeur « " .. cle .. " » n'existe pas (ou vaut « rien ») dans le module « " .. _texte(ref) .. " ».")
	end
	return resultat
end]],
	},

	-- Vrai si le module est trouvé (il n'est pas chargé)
	_moduleExiste = {
		deps = { "_trouverModule" },
		services = {},
		code = [[
local function _moduleExiste(ref)
	return _trouverModule(ref) ~= nil
end]],
	},
}

return {
	category = "modules",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Defs_Monde</string><ProtectedString name="Source"><![CDATA[-- Defs_Monde : blocs de la catégorie « Monde »
-- (créer des parties, gravité, heure, lumière, brouillard, recherche d'objets, distances, contacts…)
-- Les valeurs renvoyées ne plantent jamais : un objet introuvable donne « rien » (nil),
-- une position inconnue donne 0, une distance inconnue est infinie.

local Shared = require(script.Parent.Shared)

local objInput = Shared.objInput

-- Entrée nombre
local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	return g.helper(nom) .. "(" .. table.concat({ ... }, ", ") .. ")"
end

local AXES_VALIDES = { X = true, Y = true, Z = true }

local blocks = {
	{
		id = "monde_creer_partie",
		shape = "stack",
		label = "créer une partie à x %1 y %2 z %3",
		inputs = { nombre("X", 0), nombre("Y", 10), nombre("Z", 0) },
		keywords = "créer partie nouveau bloc brique ajouter instance part new",
		tooltip = "Crée une nouvelle partie (bloc gris de 4 × 1 × 2 studs, non ancrée : elle tombe) à la position indiquée. Elle devient « le dernier objet créé ».",
		gen = function(a, g)
			return "dernierObjet = " .. appel(g, "_creerPartie", g.num(a.X), g.num(a.Y), g.num(a.Z))
		end,
	},
	{
		id = "monde_gravite",
		shape = "stack",
		label = "mettre la gravité à %1",
		inputs = { nombre("VALEUR", 196.2) },
		keywords = "gravité pesanteur lune espace sauter gravity",
		tooltip = "Change la gravité de tout le jeu. Normale : 196,2. Plus petite : on saute plus haut (comme sur la Lune).",
		gen = function(a, g)
			return "workspace.Gravity = " .. g.num(a.VALEUR)
		end,
	},
	{
		id = "monde_heure",
		shape = "stack",
		label = "mettre l'heure à %1 h",
		inputs = { nombre("HEURE", 14) },
		keywords = "heure jour nuit soleil temps horloge clocktime",
		tooltip = "Règle l'heure de la journée (de 0 à 24) : 14 = début d'après-midi, 0 = minuit.",
		gen = function(a, g)
			return g.service("Lighting") .. ".ClockTime = " .. g.num(a.HEURE) .. " % 24"
		end,
	},
	{
		id = "monde_luminosite",
		shape = "stack",
		label = "mettre la luminosité à %1",
		inputs = { nombre("VALEUR", 2) },
		keywords = "luminosité lumière soleil clarté sombre brightness",
		tooltip = "Règle la luminosité du soleil et du ciel (2 par défaut, 0 = très sombre).",
		gen = function(a, g)
			return g.service("Lighting") .. ".Brightness = math.max(0, " .. g.num(a.VALEUR) .. ")"
		end,
	},
	{
		id = "monde_brouillard",
		shape = "stack",
		label = "mettre le brouillard à %1 studs",
		inputs = { nombre("DISTANCE", 500) },
		keywords = "brouillard brume fog visibilité atmosphère",
		tooltip = "Règle la distance à laquelle le brouillard cache tout. Petite valeur : brouillard épais ; grande valeur : presque pas de brouillard.",
		gen = function(a, g)
			return appel(g, "_brouillard", g.num(a.DISTANCE))
		end,
	},
	{
		id = "monde_ambiance",
		shape = "stack",
		label = "mettre la lumière ambiante à %1",
		inputs = { { name = "COULEUR", kind = "color", default = { 128, 128, 128 } } },
		keywords = "lumière ambiante ambiance couleur ombre ambient éclairage",
		tooltip = "Change la couleur de la lumière ambiante (la lumière des ombres et des zones sans soleil).",
		gen = function(a, g)
			return appel(g, "_ambiance", a.COULEUR)
		end,
	},
	{
		id = "monde_objet_nomme",
		shape = "reporter",
		label = "objet nommé %1",
		inputs = { { name = "NOM", kind = "text", default = "Part" } },
		keywords = "objet nommé nom chercher trouver find chemin",
		tooltip = "Trouve un objet par son nom dans Workspace (puis ReplicatedStorage, ServerStorage et Lighting). Accepte aussi un chemin comme Workspace.Maison.Porte. Donne « rien » si aucun objet n'a ce nom.",
		gen = function(a, g)
			return appel(g, "_objetNomme", a.NOM)
		end,
	},
	{
		id = "monde_enfant",
		shape = "reporter",
		label = "enfant %1 de %2",
		inputs = { { name = "NOM", kind = "text", default = "Part" }, objInput("OBJ") },
		keywords = "enfant child contenu dans objet nommé chercher",
		tooltip = "Donne l'objet portant ce nom à l'intérieur de l'objet (ou son n-ième enfant si tu écris un nombre). Donne « rien » s'il n'existe pas.",
		gen = function(a, g)
			return appel(g, "_enfantDe", a.OBJ, a.NOM)
		end,
	},
	{
		id = "monde_parent",
		shape = "reporter",
		label = "parent de %1",
		inputs = { objInput("OBJ") },
		keywords = "parent contenant dossier modèle parent",
		tooltip = "Donne l'objet qui contient cet objet (son parent).",
		gen = function(a, g)
			return appel(g, "_parentDe", a.OBJ)
		end,
	},
	{
		id = "monde_position_axe",
		shape = "reporter",
		label = "position %1 de %2",
		-- NOTE : AXE n'accepte pas de bloc valeur (son code sert de nom de propriété : .X / .Y / .Z)
		inputs = {
			{ name = "AXE", kind = "dropdown", options = Shared.AXES, default = "X", acceptReporter = false },
			objInput("OBJ"),
		},
		keywords = "position coordonnée axe x y z hauteur",
		tooltip = "Donne la coordonnée x, y (la hauteur) ou z de la position de l'objet. Donne 0 si l'objet est introuvable.",
		gen = function(a, g)
			local axe = a.AXE
			if not AXES_VALIDES[axe] then
				g.warn("« position … de … » : axe inconnu (" .. tostring(axe) .. "), x utilisé.")
				axe = "X"
			end
			return "(" .. g.helper("_pos") .. "(" .. a.OBJ .. ") or Vector3.zero)." .. axe
		end,
	},
	{
		id = "monde_distance",
		shape = "reporter",
		label = "distance entre %1 et %2",
		inputs = { objInput("A"), objInput("B", "personnage") },
		keywords = "distance écart loin proche entre studs magnitude",
		tooltip = "Donne la distance en studs entre deux objets (ou positions). Si l'un des deux n'existe pas, la distance est infinie.",
		gen = function(a, g)
			return appel(g, "_distanceEntre", a.A, a.B)
		end,
	},
	{
		id = "monde_heure_val",
		shape = "reporter",
		label = "heure du jeu",
		keywords = "heure jour nuit temps horloge clocktime",
		tooltip = "Donne l'heure actuelle de la journée dans le jeu (de 0 à 24).",
		gen = function(_a, g)
			return g.service("Lighting") .. ".ClockTime"
		end,
	},
	{
		id = "monde_nom",
		shape = "reporter",
		label = "nom de %1",
		inputs = { objInput("OBJ") },
		keywords = "nom name objet texte",
		tooltip = "Donne le nom de l'objet (un texte). Donne un texte vide si l'objet est introuvable.",
		gen = function(a, g)
			return appel(g, "_nomObjet", a.OBJ)
		end,
	},
	{
		id = "monde_existe",
		shape = "boolean",
		label = "%1 existe",
		inputs = { objInput("OBJ", "dernierObjet") },
		keywords = "existe exister présent détruit trouvé exists",
		tooltip = "Vrai si l'objet existe encore dans le jeu (il a été trouvé et n'a pas été détruit).",
		gen = function(a, g)
			return appel(g, "_existeObjet", a.OBJ)
		end,
	},
	{
		id = "monde_touche",
		shape = "boolean",
		label = "%1 touche %2",
		inputs = { objInput("A"), objInput("B", "personnage") },
		keywords = "touche toucher contact collision chevauche touching",
		tooltip = "Vrai si une partie du premier objet touche (ou chevauche) une partie du second objet.",
		gen = function(a, g)
			return appel(g, "_seTouchent", a.A, a.B)
		end,
	},
}

local helpers = {
	-- Nouvelle partie dans Workspace (renvoyée pour « dernierObjet »)
	_creerPartie = {
		deps = {},
		services = {},
		code = [[
local function _creerPartie(x, y, z)
	local partie = Instance.new("Part")
	partie.Name = "Partie"
	partie.Size = Vector3.new(4, 1, 2)
	partie.Position = Vector3.new(x, y, z)
	partie.TopSurface = Enum.SurfaceType.Smooth
	partie.BottomSurface = Enum.SurfaceType.Smooth
	partie.Parent = workspace
	return partie
end]],
	},

	-- Brouillard classique ; s'il y a une Atmosphere, Roblox ignore FogEnd : on règle sa densité.
	_brouillard = {
		deps = {},
		services = { "Lighting" },
		code = [[
local function _brouillard(distance)
	if not (distance > 0) then
		distance = 0
	end
	Lighting.FogStart = 0
	Lighting.FogEnd = distance
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = math.clamp(50 / math.max(distance, 1), 0, 1)
	end
end]],
	},

	_ambiance = {
		deps = { "_versColor3", "_avertir" },
		services = { "Lighting" },
		code = [[
local function _ambiance(couleur)
	local c = _versColor3(couleur)
	if c == nil then
		_avertir("« lumière ambiante » : couleur invalide (" .. tostring(couleur) .. ").")
		return
	end
	Lighting.Ambient = c
	Lighting.OutdoorAmbient = c
end]],
	},

	-- Cherche un objet par son nom (Workspace, puis les rangements) ou par son chemin
	_objetNomme = {
		deps = {},
		services = {},
		code = [[
local function _objetNomme(nom)
	if typeof(nom) == "Instance" then
		return nom
	end
	if nom == nil then
		return nil
	end
	nom = tostring(nom)
	if nom == "" then
		return nil
	end
	if string.lower(nom) == "workspace" then
		return workspace
	end
	local trouve = workspace:FindFirstChild(nom, true)
	if trouve then
		return trouve
	end
	for _, nomService in ipairs({ "ReplicatedStorage", "ServerStorage", "Lighting" }) do
		local ok, service = pcall(function()
			return game:FindService(nomService)
		end)
		if ok and service then
			trouve = service:FindFirstChild(nom, true)
			if trouve then
				return trouve
			end
		end
	end
	-- chemin complet, par exemple « Workspace.Maison.Porte »
	if string.find(nom, ".", 1, true) then
		local courant = game
		for morceau in string.gmatch(nom, "[^%.]+") do
			local suivant = courant:FindFirstChild(morceau)
			if suivant == nil and courant == game then
				local ok, service = pcall(function()
					return game:FindService(morceau)
				end)
				if ok then
					suivant = service
				end
			end
			if suivant == nil then
				return nil
			end
			courant = suivant
		end
		if courant ~= game then
			return courant
		end
		return nil
	end
	-- un service, par exemple « Lighting »
	local ok, service = pcall(function()
		return game:FindService(nom)
	end)
	if ok and service then
		return service
	end
	return nil
end]],
	},

	-- Enfant d'un objet par nom (ou par rang). Pour un joueur : cherche dans le joueur puis son personnage.
	_enfantDe = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _enfantDe(valeur, nom)
	if nom == nil then
		return nil
	end
	local parents = {}
	if typeof(valeur) == "Instance" then
		table.insert(parents, valeur)
		if valeur:IsA("Player") and valeur.Character then
			table.insert(parents, valeur.Character)
		end
	else
		local objet = _obj(valeur)
		if objet then
			table.insert(parents, objet)
		end
	end
	local texte = tostring(nom)
	for _, parent in ipairs(parents) do
		local enfant = parent:FindFirstChild(texte)
		if enfant then
			return enfant
		end
	end
	local rang = tonumber(texte)
	if rang then
		for _, parent in ipairs(parents) do
			local enfant = parent:GetChildren()[math.floor(rang)]
			if enfant then
				return enfant
			end
		end
	end
	for _, parent in ipairs(parents) do
		local enfant = parent:FindFirstChild(texte, true)
		if enfant then
			return enfant
		end
	end
	return nil
end]],
	},

	_parentDe = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _parentDe(valeur)
	local objet = valeur
	if typeof(objet) ~= "Instance" then
		objet = _obj(valeur)
	end
	if objet == nil then
		return nil
	end
	return objet.Parent
end]],
	},

	_nomObjet = {
		deps = {},
		services = {},
		code = [[
local function _nomObjet(valeur)
	if typeof(valeur) == "Instance" then
		return valeur.Name
	end
	if type(valeur) == "string" then
		return valeur
	end
	return ""
end]],
	},

	-- Vrai si l'objet a été trouvé et est toujours dans le jeu (pas détruit)
	_existeObjet = {
		deps = { "_obj" },
		services = {},
		code = [[
local function _existeObjet(valeur)
	local objet = valeur
	if typeof(objet) ~= "Instance" then
		objet = _obj(valeur)
	end
	if objet == nil then
		return false
	end
	return objet == game or objet.Parent ~= nil
end]],
	},

	_distanceEntre = {
		deps = { "_pos" },
		services = {},
		code = [[
local function _distanceEntre(a, b)
	local pa = _pos(a)
	local pb = _pos(b)
	if pa == nil or pb == nil then
		return math.huge
	end
	return (pa - pb).Magnitude
end]],
	},

	-- Vrai si une partie de a touche une partie de b. On interroge l'espace avec la boîte
	-- de chaque partie du plus petit groupe, agrandie de 0,2 stud (deux parties posées
	-- l'une sur l'autre se touchent sans se chevaucher). Secours : GetTouchingParts.
	_seTouchent = {
		deps = { "_parties" },
		services = {},
		code = [[
local function _seTouchent(a, b)
	local partiesA = _parties(a)
	local partiesB = _parties(b)
	if #partiesA == 0 or #partiesB == 0 then
		return false
	end
	local dansA = {}
	local dansB = {}
	for _, p in ipairs(partiesA) do
		dansA[p] = true
	end
	for _, p in ipairs(partiesB) do
		dansB[p] = true
	end
	local listeA = {}
	local listeB = {}
	for _, p in ipairs(partiesA) do
		if not dansB[p] then
			table.insert(listeA, p)
		end
	end
	for _, p in ipairs(partiesB) do
		if not dansA[p] then
			table.insert(listeB, p)
		end
	end
	if #listeA == 0 or #listeB == 0 then
		return false
	end
	local sources = listeA
	local cibles = listeB
	if #listeB < #listeA then
		sources = listeB
		cibles = listeA
	end
	local estCible = {}
	for _, p in ipairs(cibles) do
		estCible[p] = true
	end
	local parametres = OverlapParams.new()
	parametres.FilterType = Enum.RaycastFilterType.Include
	parametres.FilterDescendantsInstances = cibles
	parametres.MaxParts = 1
	local marge = Vector3.new(0.2, 0.2, 0.2)
	for _, p in ipairs(sources) do
		local ok, resultat = pcall(function()
			return workspace:GetPartBoundsInBox(p.CFrame, p.Size + marge, parametres)
		end)
		if ok then
			if #resultat > 0 then
				return true
			end
		else
			local ok2, touches = pcall(function()
				return p:GetTouchingParts()
			end)
			if ok2 then
				for _, t in ipairs(touches) do
					if estCible[t] then
						return true
					end
				end
			end
		end
	end
	return false
end]],
	},
}

return {
	category = "monde",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Defs_Operateurs</string><ProtectedString name="Source"><![CDATA[-- Defs_Operateurs : blocs de la catégorie « Opérateurs »
-- calculs (+ − × ÷, reste, puissance, hasard, arrondi, fonctions mathématiques),
-- textes (joindre, lettre, longueur) et conditions (comparaisons, et / ou / non, contient).
--
-- Les opérandes numériques passent par g.num(...) (les littéraux restent lisibles),
-- les textes par g.str(...). Les blocs renvoient une seule expression, entre parenthèses
-- quand elle est composée.

local Util = require(script.Parent.Util)

-- Construit l'appel d'une fonction utile : nom(arg1, arg2, ...) et déclare l'aide.
local function appel(g, nom, ...)
	local args = {}
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		if v == nil then
			v = "nil"
		end
		args[i] = v
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ") .. ")"
end

-- Opérande d'un bloc « et / ou / non ». Si un bloc rond y est branché (a.raw[nom] == nil), sa valeur
-- passe par _vrai (règle de Scratch : 0, "", « faux »… sont faux), comme pour « si » et « tant que ».
-- Le résultat est alors toujours un vrai booléen.
local function conditionDe(a, g, nom)
	local expr = a[nom]
	if expr == nil or expr == "" then
		return "false"
	end
	if type(a.raw) ~= "table" or a.raw[nom] == nil then
		return g.helper("_vrai") .. "(" .. expr .. ")"
	end
	return expr
end

-- Deux entrées nombre A et B
local function deuxNombres(defautA, defautB)
	return {
		{ name = "A", kind = "number", default = defautA },
		{ name = "B", kind = "number", default = defautB },
	}
end

-- Opérateur binaire numérique : "(A op B)"
local function binaire(op)
	return function(a, g)
		return "(" .. g.num(a.A) .. " " .. op .. " " .. g.num(a.B) .. ")"
	end
end

-- Vrai si expr est un littéral numérique différent de 0 ("2", "(-4)", "0.5"…)
local function litteralNonNul(expr)
	if not Util.isNumberLiteral(expr) then
		return false
	end
	local n = tonumber((string.gsub(expr, "[%(%)]", "")))
	return n ~= nil and n ~= 0
end

-- Fonctions mathématiques de « %1 de %2 » : le code est un nom de fonction appliqué au nombre.
-- Les angles sont en degrés (aides _sinDeg, _cosDeg…).
local FONCTIONS = {
	{ "valeur absolue", "math.abs" },
	{ "racine carrée", "math.sqrt" },
	{ "partie entière", "math.floor" },
	{ "arrondi supérieur", "math.ceil" },
	{ "sinus", "_sinDeg", helper = "_sinDeg" },
	{ "cosinus", "_cosDeg", helper = "_cosDeg" },
	{ "tangente", "_tanDeg", helper = "_tanDeg" },
	{ "arc sinus", "_asinDeg", helper = "_asinDeg" },
	{ "arc cosinus", "_acosDeg", helper = "_acosDeg" },
	{ "arc tangente", "_atanDeg", helper = "_atanDeg" },
	{ "logarithme naturel (ln)", "math.log" },
	{ "logarithme décimal (log)", "math.log10" },
	{ "e puissance", "math.exp" },
	{ "10 puissance", "_dixPuissance", helper = "_dixPuissance" },
}

local CODES_FONCTIONS = {}
for _, option in ipairs(FONCTIONS) do
	CODES_FONCTIONS[option[2]] = true
end

local blocks = {
	---------------------------------------------------------------------------
	-- Calculs
	---------------------------------------------------------------------------
	{
		id = "op_plus",
		shape = "reporter",
		label = "%1 + %2",
		inputs = deuxNombres(1, 1),
		keywords = "plus addition additionner somme ajouter",
		tooltip = "La somme des deux nombres.",
		gen = binaire("+"),
	},
	{
		id = "op_moins",
		shape = "reporter",
		label = "%1 - %2",
		inputs = deuxNombres(10, 1),
		keywords = "moins soustraction soustraire difference retirer",
		tooltip = "Le premier nombre moins le second.",
		gen = binaire("-"),
	},
	{
		id = "op_fois",
		shape = "reporter",
		label = "%1 × %2",
		inputs = deuxNombres(2, 3),
		keywords = "fois multiplication multiplier produit x",
		tooltip = "Le produit des deux nombres (multiplication).",
		gen = binaire("*"),
	},
	{
		id = "op_divise",
		shape = "reporter",
		label = "%1 ÷ %2",
		inputs = deuxNombres(10, 2),
		keywords = "divise division diviser partager quotient",
		tooltip = "Le premier nombre divisé par le second. Une division par 0 donne 0.",
		gen = function(a, g)
			local A, B = g.num(a.A), g.num(a.B)
			if litteralNonNul(B) then
				return "(" .. A .. " / " .. B .. ")"
			end
			return appel(g, "_diviser", A, B)
		end,
	},
	{
		id = "op_modulo",
		shape = "reporter",
		label = "reste de %1 ÷ %2",
		inputs = deuxNombres(10, 3),
		keywords = "reste modulo division pair impair",
		tooltip = "Le reste de la division du premier nombre par le second (reste de 10 ÷ 3 = 1). Pratique pour savoir si un nombre est pair. Avec 0, donne 0.",
		gen = function(a, g)
			local A, B = g.num(a.A), g.num(a.B)
			if litteralNonNul(B) then
				return "(" .. A .. " % " .. B .. ")"
			end
			return appel(g, "_reste", A, B)
		end,
	},
	{
		id = "op_puissance",
		shape = "reporter",
		label = "%1 puissance %2",
		inputs = deuxNombres(2, 3),
		keywords = "puissance exposant carre cube power",
		tooltip = "Le premier nombre élevé à la puissance du second (2 puissance 3 = 8).",
		gen = binaire("^"),
	},
	{
		id = "op_aleatoire",
		shape = "reporter",
		label = "nombre au hasard entre %1 et %2",
		inputs = deuxNombres(1, 10),
		keywords = "hasard aleatoire random nombre de",
		tooltip = "Un nombre au hasard entre les deux bornes (incluses, dans n'importe quel ordre). Si les deux bornes sont des nombres entiers, le résultat est entier ; sinon c'est un nombre à virgule.",
		gen = function(a, g)
			return appel(g, "_nombreHasard", g.num(a.A), g.num(a.B))
		end,
	},
	{
		id = "op_arrondi",
		shape = "reporter",
		label = "arrondi de %1",
		inputs = { { name = "N", kind = "number", default = 3.6 } },
		keywords = "arrondi arrondir entier round",
		tooltip = "Le nombre arrondi à l'entier le plus proche (2,5 donne 3).",
		gen = function(a, g)
			return "math.round(" .. g.num(a.N) .. ")"
		end,
	},
	{
		id = "op_math",
		shape = "reporter",
		label = "%1 de %2",
		inputs = {
			{ name = "FONCTION", kind = "dropdown", options = FONCTIONS, default = "math.sqrt" },
			{ name = "N", kind = "number", default = 9 },
		},
		keywords = "math fonction racine carree valeur absolue sinus cosinus tangente trigonometrie partie entiere arrondi superieur logarithme exponentielle",
		tooltip = "Applique une fonction mathématique au nombre : valeur absolue, racine carrée, partie entière, arrondi supérieur, sinus, cosinus, tangente (angles en degrés), logarithme…",
		gen = function(a, g)
			local code = a.FONCTION
			if type(code) ~= "string" or not CODES_FONCTIONS[code] then
				g.warn("Bloc « fonction mathématique » : fonction inconnue, « valeur absolue » utilisée à la place.")
				code = "math.abs"
			end
			if string.sub(code, 1, 1) == "_" then
				g.helper(code)
			end
			return code .. "(" .. g.num(a.N) .. ")"
		end,
	},
	{
		id = "op_min",
		shape = "reporter",
		label = "le plus petit entre %1 et %2",
		inputs = deuxNombres(3, 7),
		keywords = "minimum min plus petit moins",
		tooltip = "Le plus petit des deux nombres.",
		gen = function(a, g)
			return "math.min(" .. g.num(a.A) .. ", " .. g.num(a.B) .. ")"
		end,
	},
	{
		id = "op_max",
		shape = "reporter",
		label = "le plus grand entre %1 et %2",
		inputs = deuxNombres(3, 7),
		keywords = "maximum max plus grand",
		tooltip = "Le plus grand des deux nombres.",
		gen = function(a, g)
			return "math.max(" .. g.num(a.A) .. ", " .. g.num(a.B) .. ")"
		end,
	},

	---------------------------------------------------------------------------
	-- Textes
	---------------------------------------------------------------------------
	{
		id = "op_joindre",
		shape = "reporter",
		label = "joindre %1 et %2",
		inputs = {
			{ name = "A", kind = "text", default = "bonjour " },
			{ name = "B", kind = "text", default = "monde" },
		},
		keywords = "joindre coller concatener texte assembler ajouter",
		tooltip = "Colle deux textes l'un après l'autre (pense à l'espace entre les mots !).",
		gen = function(a, g)
			return "(" .. g.str(a.A) .. " .. " .. g.str(a.B) .. ")"
		end,
	},
	{
		id = "op_lettre",
		shape = "reporter",
		label = "lettre %1 de %2",
		inputs = {
			{ name = "N", kind = "number", default = 1 },
			{ name = "TEXTE", kind = "text", default = "bonjour" },
		},
		keywords = "lettre caractere position texte",
		tooltip = "La lettre qui se trouve à cette position dans le texte (1 = première lettre). Les lettres accentuées comptent pour une seule lettre. Donne un texte vide si la position n'existe pas.",
		gen = function(a, g)
			return appel(g, "_lettreDe", g.num(a.N), g.str(a.TEXTE))
		end,
	},
	{
		id = "op_longueur",
		shape = "reporter",
		label = "longueur de %1",
		inputs = { { name = "TEXTE", kind = "text", default = "bonjour" } },
		keywords = "longueur taille nombre de lettres caracteres texte",
		tooltip = "Le nombre de lettres du texte (les lettres accentuées comptent pour une seule).",
		gen = function(a, g)
			return appel(g, "_longueurTexte", g.str(a.TEXTE))
		end,
	},

	---------------------------------------------------------------------------
	-- Conditions
	---------------------------------------------------------------------------
	{
		id = "op_superieur",
		shape = "boolean",
		label = "%1 > %2",
		inputs = deuxNombres(10, 5),
		keywords = "superieur plus grand que comparer",
		tooltip = "Vrai si le premier nombre est plus grand que le second.",
		gen = binaire(">"),
	},
	{
		id = "op_inferieur",
		shape = "boolean",
		label = "%1 < %2",
		inputs = deuxNombres(5, 10),
		keywords = "inferieur plus petit que comparer",
		tooltip = "Vrai si le premier nombre est plus petit que le second.",
		gen = binaire("<"),
	},
	{
		id = "op_egal",
		shape = "boolean",
		label = "%1 = %2",
		inputs = {
			{ name = "A", kind = "any", default = "10" },
			{ name = "B", kind = "any", default = "10" },
		},
		keywords = "egal egalite pareil meme comparer",
		tooltip = "Vrai si les deux valeurs sont égales. Les nombres sont comparés comme des nombres, les textes sans tenir compte des majuscules.",
		gen = function(a, g)
			return appel(g, "_egal", a.A, a.B)
		end,
	},
	{
		id = "op_different",
		shape = "boolean",
		label = "%1 ≠ %2",
		inputs = {
			{ name = "A", kind = "any", default = "10" },
			{ name = "B", kind = "any", default = "5" },
		},
		keywords = "different pas egal comparer",
		tooltip = "Vrai si les deux valeurs sont différentes (même règle que « = »).",
		gen = function(a, g)
			return "(not " .. appel(g, "_egal", a.A, a.B) .. ")"
		end,
	},
	{
		id = "op_sup_egal",
		shape = "boolean",
		label = "%1 ≥ %2",
		inputs = deuxNombres(10, 5),
		keywords = "superieur ou egal plus grand comparer",
		tooltip = "Vrai si le premier nombre est plus grand que le second ou égal.",
		gen = binaire(">="),
	},
	{
		id = "op_inf_egal",
		shape = "boolean",
		label = "%1 ≤ %2",
		inputs = deuxNombres(5, 10),
		keywords = "inferieur ou egal plus petit comparer",
		tooltip = "Vrai si le premier nombre est plus petit que le second ou égal.",
		gen = binaire("<="),
	},
	{
		id = "op_et",
		shape = "boolean",
		label = "%1 et %2",
		inputs = {
			{ name = "A", kind = "boolean" },
			{ name = "B", kind = "boolean" },
		},
		keywords = "et and les deux logique condition",
		tooltip = "Vrai si les deux conditions sont vraies.",
		gen = function(a, g)
			return "(" .. conditionDe(a, g, "A") .. " and " .. conditionDe(a, g, "B") .. ")"
		end,
	},
	{
		id = "op_ou",
		shape = "boolean",
		label = "%1 ou %2",
		inputs = {
			{ name = "A", kind = "boolean" },
			{ name = "B", kind = "boolean" },
		},
		keywords = "ou or l'un logique condition",
		tooltip = "Vrai si au moins une des deux conditions est vraie.",
		gen = function(a, g)
			return "(" .. conditionDe(a, g, "A") .. " or " .. conditionDe(a, g, "B") .. ")"
		end,
	},
	{
		id = "op_non",
		shape = "boolean",
		label = "non %1",
		inputs = { { name = "A", kind = "boolean" } },
		keywords = "non not inverse contraire pas logique condition",
		tooltip = "Inverse la condition : vrai devient faux et faux devient vrai.",
		gen = function(a, g)
			return "(not " .. conditionDe(a, g, "A") .. ")"
		end,
	},
	{
		id = "op_contient",
		shape = "boolean",
		label = "%1 contient %2",
		inputs = {
			{ name = "A", kind = "text", default = "bonjour" },
			{ name = "B", kind = "text", default = "jour" },
		},
		keywords = "contient trouver chercher dans texte inclut",
		tooltip = "Vrai si le premier texte contient le second, sans tenir compte des majuscules (accents compris).",
		gen = function(a, g)
			return appel(g, "_texteContient", g.str(a.A), g.str(a.B))
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------
local helpers = {
	-- Division : une division par 0 donne 0 (au lieu de l'infini)
	_diviser = {
		deps = {},
		services = {},
		code = [[
local function _diviser(a, b)
	a = tonumber(a) or 0
	b = tonumber(b) or 0
	if b == 0 then
		return 0
	end
	return a / b
end]],
	},

	-- Reste de la division (modulo) : avec 0, donne 0
	_reste = {
		deps = {},
		services = {},
		code = [[
local function _reste(a, b)
	a = tonumber(a) or 0
	b = tonumber(b) or 0
	if b == 0 then
		return 0
	end
	return a % b
end]],
	},

	-- Nombre au hasard entre deux bornes (dans n'importe quel ordre) :
	-- entier si les deux bornes sont entières, nombre à virgule sinon
	_nombreHasard = {
		deps = {},
		services = {},
		code = [[
local function _nombreHasard(a, b)
	a = tonumber(a) or 0
	b = tonumber(b) or 0
	if a ~= a or b ~= b then
		return 0
	end
	if a > b then
		a, b = b, a
	end
	if a == math.floor(a) and b == math.floor(b) then
		if math.abs(a) < 2147483647 and math.abs(b) < 2147483647 then
			return math.random(a, b)
		end
		return math.min(b, math.floor(a + math.random() * (b - a + 1)))
	end
	return a + math.random() * (b - a)
end]],
	},

	-- Trigonométrie en degrés (résultat arrondi à 10 décimales : sinus de 30 = 0,5)
	_sinDeg = {
		deps = {},
		services = {},
		code = [[
local function _sinDeg(angle)
	local v = math.sin(math.rad(tonumber(angle) or 0))
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_cosDeg = {
		deps = {},
		services = {},
		code = [[
local function _cosDeg(angle)
	local v = math.cos(math.rad(tonumber(angle) or 0))
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_tanDeg = {
		deps = {},
		services = {},
		code = [[
local function _tanDeg(angle)
	local r = math.rad(tonumber(angle) or 0)
	local c = math.floor(math.cos(r) * 1e10 + 0.5) / 1e10
	if c == 0 then
		if math.sin(r) > 0 then
			return math.huge
		end
		return -math.huge
	end
	local v = math.tan(r)
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_asinDeg = {
		deps = {},
		services = {},
		code = [[
local function _asinDeg(x)
	local v = math.deg(math.asin(tonumber(x) or 0))
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_acosDeg = {
		deps = {},
		services = {},
		code = [[
local function _acosDeg(x)
	local v = math.deg(math.acos(tonumber(x) or 0))
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_atanDeg = {
		deps = {},
		services = {},
		code = [[
local function _atanDeg(x)
	local v = math.deg(math.atan(tonumber(x) or 0))
	return math.floor(v * 1e10 + 0.5) / 1e10
end]],
	},

	_dixPuissance = {
		deps = {},
		services = {},
		code = [[
local function _dixPuissance(x)
	return 10 ^ (tonumber(x) or 0)
end]],
	},

	-- Lettre n° position d'un texte, en tenant compte des lettres accentuées (UTF-8)
	_lettreDe = {
		deps = { "_texte" },
		services = {},
		code = [[
local function _lettreDe(position, texte)
	texte = _texte(texte)
	position = tonumber(position) or 0
	if position ~= position then
		return ""
	end
	position = math.floor(position)
	local longueur = utf8.len(texte)
	if longueur == nil then
		-- texte qui n'est pas de l'UTF-8 valide : on compte les octets
		if position < 1 or position > #texte then
			return ""
		end
		return string.sub(texte, position, position)
	end
	if position < 1 or position > longueur then
		return ""
	end
	local debut = utf8.offset(texte, position)
	local fin = utf8.offset(texte, position + 1)
	if debut == nil or fin == nil then
		return ""
	end
	return string.sub(texte, debut, fin - 1)
end]],
	},

	-- Nombre de lettres d'un texte (une lettre accentuée compte pour une)
	_longueurTexte = {
		deps = { "_texte" },
		services = {},
		code = [[
local function _longueurTexte(texte)
	texte = _texte(texte)
	return utf8.len(texte) or #texte
end]],
	},

	-- Minuscules, y compris les majuscules accentuées françaises (É -> é, À -> à, Œ -> œ…)
	_minusculesFr = {
		deps = {},
		services = {},
		code = [[
local function _minusculesFr(texte)
	if type(texte) ~= "string" then
		texte = tostring(texte)
	end
	texte = string.lower(texte)
	texte = string.gsub(texte, "\195([\128-\158])", function(octet)
		local n = string.byte(octet)
		if n == 151 then
			return nil
		end
		return "\195" .. string.char(n + 32)
	end)
	texte = string.gsub(texte, "\197\146", "\197\147")
	return texte
end]],
	},

	-- Vrai si texte contient morceau (recherche simple, sans tenir compte des majuscules)
	_texteContient = {
		deps = { "_texte", "_minusculesFr" },
		services = {},
		code = [[
local function _texteContient(texte, morceau)
	texte = _minusculesFr(_texte(texte))
	morceau = _minusculesFr(_texte(morceau))
	return string.find(texte, morceau, 1, true) ~= nil
end]],
	},
}

return {
	category = "operateurs",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Defs_ToutPrets</string><ProtectedString name="Source"><![CDATA[-- Defs_ToutPrets : blocs de la catégorie « Tout prêts » (SPEC §19)
-- Des mécaniques de jeu complètes en un seul bloc : animations, hitbox et combat, recul,
-- projectile, dash, invincibilité, temps de recharge, barre de vie, zone de dégâts, PNJ…
--
-- Choix de conception :
--   * Les blocs acceptent un personnage, un joueur (-> son personnage), une partie d'un personnage
--     ou un PNJ (modèle avec un Humanoid). La résolution passe par _perso / _humanoid (Shared).
--   * Quand l'entrée vaut la valeur littérale « le personnage », le code produit est
--     « (personnage or joueur) » : sous un événement qui ne donne que « le joueur » (par exemple
--     « Quand je reçois le message … » dans un script serveur), c'est le personnage de ce joueur
--     qui est utilisé (_perso convertit un joueur en son personnage).
--   * L'état partagé par les blocs d'un même script (hitbox visibles, pistes d'animation en
--     cache, avertissements déjà affichés, zones et ennemis actifs…) est la table « _etatTP »,
--     déclarée une fois avec g.declare et passée en premier argument aux fonctions utiles qui en
--     ont besoin (les fonctions utiles sont émises avant les déclarations : elles ne peuvent pas
--     la lire directement).
--   * Le corps de « pour chaque ennemi dans une hitbox » reçoit les variables locales « cible »
--     (le personnage touché) et « joueurCible » (son joueur ou nil). Les blocs valeur
--     « la cible touchée » / « le joueur touché » déclarent aussi ces noms au niveau du script
--     (nil hors de la boucle).
--   * Aides réutilisées d'autres fichiers (CodeGen les résout partout) : _avertirCible,
--     _exigerPerso, _exigerHumanoid, _nombreOu (Defs_Joueurs), _idSon, _jouerSon,
--     _partiesOuAvertir (Defs_Actions). Les dégâts des hitbox sont infligés directement à l'Humanoid
--     trouvé (h:TakeDamage(max(dégâts, 0)), comme _infligerDegats) : pas de deuxième recherche.
--
-- Systèmes tout prêts (SPEC §22.1 : sprint, double saut, point de sauvegarde, téléporteur, objet à
-- ramasser, générateur, porte automatique, plateformes, tapis roulant, trampoline, zone de soin, cycle
-- jour/nuit, sauvegarde des statistiques, minuteur à l'écran, bouton d'achat) :
--   * Chaque bloc installe UNE fois son système sur un objet (une connexion par partie, jamais une
--     nouvelle connexion à chaque contact) ; appelé de nouveau, il change seulement ses réglages.
--     Les systèmes installés sont rangés dans _etatTP (tables à clés faibles).
--   * Ce qui doit être unique pour tous les scripts du même côté (réapparition sur les points de
--     sauvegarde, cycle jour/nuit, sauvegarde des statistiques) est rangé dans
--     shared.BlocsFR_ToutPrets (_tpPartage) : un script par point de sauvegarde fonctionne. Une
--     connexion morte (script détruit) est refaite par le prochain script qui utilise le bloc.
--   * Aides réutilisées : _estProtege, _boiteObjet, _demiHauteur (Defs_Actions), _objetNomme
--     (Defs_Monde), _ajouterStat, _statTrouver, _ecrireStat, _messageEcran, _teleporterJoueurSur,
--     _placerPerso (Defs_Joueurs), _surClic, _envoyerMessage, _lettreTouche, _toucheIgnoree
--     (Defs_Evenements).
-- NOTE: « zone de soin » utilise le moteur de « zone de dégâts » avec des dégâts négatifs (toutes les
--   0,25 s, boîte de chaque partie agrandie d'1 stud) au lieu de GetPartsInPart toutes les 0,5 s : le
--   soin par seconde est le même, et un joueur posé SUR une dalle de soin est soigné aussi.
-- NOTE: point de sauvegarde et téléporteur posent le personnage juste au-dessus de l'objet
--   (_teleporterJoueurSur, la hauteur du personnage comprise) plutôt qu'à 4 studs au-dessus de son
--   centre (une destination donnée par une position : 4 studs au-dessus).
-- NOTE: « minuteur à l'écran » ne fait pas attendre le script (le message envoyé à 0 sert de suite).
--   « porte automatique » réagit aux personnages des joueurs. « plateforme qui va et vient » donne
--   aussi à ses parties la vitesse de leur mouvement : les joueurs posés dessus sont emportés.
--   « bouton d'achat » refuse un outil déjà possédé, met une 2e copie dans StarterGear (gardée après
--   une réapparition) et affiche « Il te faut … » à un joueur qui n'a pas assez.
--
-- Optimisation (SPEC §34, même comportement, mêmes ids, mêmes entrées, même géométrie de hitbox) :
--   * Une seule boucle par système et par script, avec les registres dans _etatTP : zones de dégâts /
--     de soin (etat.zones, toutes les 0,25 s), PNJ ennemis (etat.ennemis, 0,2 s), portes automatiques
--     (etat.portes, 0,2 s), générateurs (etat.generateurs, une boucle qui dort jusqu'au prochain),
--     plateformes mobiles et projectiles (UNE connexion Heartbeat chacun, coupée quand la liste est
--     vide). L'invincibilité n'a plus de boucle (task.delay). Les registres sont parcourus sur une
--     copie : un bloc lancé pendant le tour (événement « meurt »…) ne gêne pas le parcours.
--   * OverlapParams créés une seule fois : etat.paramsHitbox (hitbox), etat.paramsRayon (ennemis
--     autour), un par zone. Les parties d'une zone sont relues toutes les secondes (pas à chaque tour).
--   * Personnage et Humanoid d'une partie : _tpPersoDe (cache etat.persos, clé faible = le parent de la
--     partie, vérifié à chaque usage) ; dans une hitbox / une zone, chaque parent n'est examiné qu'une
--     fois (les membres d'un personnage ont le même parent). Les joueurs en vie sont lus une seule fois
--     par tour pour tous les PNJ ennemis et toutes les portes.
--   * Tables anti-rebond / caches à clés faibles (trampoline, bouton d'achat, point de sauvegarde,
--     temps de recharge, pistes d'animation, etat.persos) : les personnages / joueurs qui ne sont plus
--     dans le jeu sont retirés quand une nouvelle clé arrive.
--   * Jamais de nouvelle connexion par contact ; boucles avec des pauses d'au moins 0,03 s ; aucun
--     FindFirstChild(…, true) dans une boucle par image (destination du téléporteur et outil du bouton
--     d'achat gardés en mémoire, cherchés de nouveau seulement s'ils ont disparu).
-- NOTE: _tpCiblesDevant renvoie aussi la liste des Humanoid (2e valeur) ; _tpProjectile,
--   _tpEnnemisAutour et _tpEnnemiProche reçoivent _etatTP en DERNIER argument (facultatif : sans lui,
--   ils marchent comme avant, sans cache).
-- NOTE: portes automatiques et PNJ ennemis lisent la liste des joueurs (une fois par tour) plutôt
--   qu'une requête GetPartBoundsInRadius : seuls les personnages des joueurs comptent, et c'est moins
--   cher. « se ramasse … revient après 0 s » cache l'objet tout de suite et le détruit 1 s plus tard :
--   si le script est dans l'objet, il a le temps de nettoyer le son joué dans le personnage.
--
-- Encore plus de systèmes tout prêts (SPEC §34 : élimine qui le touche, flotter, tourner sans arrêt,
-- ascenseur, chronomètre de course, lave qui monte, zones de vitesse et de super saut, porte réservée,
-- familier, PNJ qui réapparaît, butin) : mêmes principes (installés une fois par objet, registres dans
-- _etatTP, tables à clés faibles nettoyées à l'arrivée d'une nouvelle clé, jamais une connexion par
-- contact, boucles d'au moins 0,1 s). Tous « server » ; aucun ne fait attendre le script.
--   * Tout ce qui bouge à chaque image (flotter, tourner, ascenseur, lave, familiers) passe par UN moteur
--     par script (_tpMoteur : une connexion Heartbeat, coupée quand plus rien ne bouge ; une erreur
--     n'arrête que son objet). « flotter » et « tourner » sur le même objet se combinent (une seule
--     entrée, etat.animes). Les parties ancrées reçoivent la vitesse de leur mouvement (_tpBouger) :
--     ce qui est posé dessus est emporté.
-- NOTE: « faire flotter » monte de « hauteur » au-dessus de sa place puis revient (il ne descend jamais
--   sous sa place) ; vitesse 1 = un aller-retour en 2 s. Un objet déplacé par un autre bloc continue à
--   flotter / tourner à sa nouvelle place. Refusé sur le personnage d'un joueur (il serait figé).
-- NOTE: « lave … jusqu'à … » : hauteur AU-DESSUS de sa place de départ (pas une hauteur absolue). Une
--   partie Part posée à plat grandit vers le haut (son dessous ne bouge pas) ; un modèle (ou une autre
--   partie) monte. Elle élimine au contact (tous) et, toutes les 0,1 s, les personnages des JOUEURS
--   dans ses parties (requête limitée à eux : le décor noyé n'est jamais parcouru). Le message « fin »
--   la remet en bas ; elle remonte 3 s plus tard (une nouvelle manche).
-- NOTE: « ascenseur » : seul un personnage posé dessus le fait partir (0,5 s plus tard) ; 8 studs/s en
--   moyenne, départ et arrivée en douceur ; une hauteur négative le fait descendre.
-- NOTE: « chronomètre » : le temps part quand le joueur QUITTE le départ ; « Record » = plus petit temps
--   (NumberValue, centièmes) ; pilule « BlocsFR_Chrono » à 74 px du haut, sous celle du minuteur.
--   Départ = arrivée : chaque passage termine un tour et lance le suivant.
-- NOTE: zones de vitesse / de super saut : 0 s = jusqu'à la réapparition ; le bonus est rangé en
--   attributs de l'Humanoid, partagés par tous les scripts (deux zones ne s'empilent pas). Une zone
--   détruite pendant le bonus ne peut plus le terminer (dit dans l'info-bulle).
-- NOTE: « familier » : une CFrame qui rattrape la cible à chaque image (pas d'AlignPosition : un modèle
--   non soudé ne peut pas se défaire, rien ne tombe) ; un familier par joueur et par script. La copie
--   attend dans ServerStorage tant que le personnage du joueur n'est pas là.
-- NOTE: « porte réservée » ancre ses parties (ouverte = traversable : non ancrée, elle tomberait) ; un
--   minimum de 0 laisse passer tout le monde.
-- NOTE: « butin » : 20 pièces au plus (la valeur est répartie) ; une pièce dont le script a disparu
--   (PNJ réapparu…) est reprise par le prochain script de butin (_tpAdopterPieces).

local Shared = require(script.Parent.Shared)

---------------------------------------------------------------------------
-- Listes d'options
---------------------------------------------------------------------------

-- Animations R15 fournies par Roblox (utilisables dans n'importe quel jeu).
-- Le code est un texte entre guillemets : l'adresse de l'animation.
local ANIMATIONS = {
	{ "coup d'épée", '"rbxassetid://522635514"' },
	{ "coup en avant (estoc)", '"rbxassetid://522638767"' },
	{ "salut de la main", '"rbxassetid://507770239"' },
	{ "danse", '"rbxassetid://507771019"' },
	{ "danse 2", '"rbxassetid://507776043"' },
	{ "applaudir", '"rbxassetid://507770677"' },
	{ "rire", '"rbxassetid://507770818"' },
	{ "montrer du doigt", '"rbxassetid://507770453"' },
}

-- Même liste + « aucune » (pour l'attaque toute prête)
local ANIMATIONS_ATTAQUE = table.clone(ANIMATIONS)
table.insert(ANIMATIONS_ATTAQUE, { "aucune", '""' })

-- Cibles des blocs « repousser » / « faire clignoter en rouge »
local CIBLES = {
	{ "la cible touchée", "cible" },
	{ "le personnage", "personnage" },
	{ "la partie touchée", "partieTouchee" },
}

-- À qui s'applique un temps de recharge
local POUR_QUI = {
	{ "le joueur", "joueur" },
	{ "le personnage", "personnage" },
	{ "cet objet", "script.Parent" },
	{ "tout le monde (un seul temps pour tous)", '"tous"' },
}

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Entrée « personnage » (objet, « le personnage » par défaut ; accepte un bloc valeur)
local function persoInput(name)
	return Shared.objInput(name or "PERSO", "personnage")
end

-- Menu d'animation (accepte aussi un bloc valeur : texte ou nombre = ID d'animation)
local function animInput(options)
	return {
		name = "ANIM",
		kind = "dropdown",
		options = options or ANIMATIONS,
		default = ANIMATIONS[1][2],
		acceptReporter = true,
	}
end

-- Menu de cible (la cible touchée par défaut)
local function cibleInput()
	return {
		name = "CIBLE",
		kind = "dropdown",
		options = CIBLES,
		default = "cible",
		acceptReporter = true,
	}
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	local n = select("#", ...)
	local args = { ... }
	for i = 1, n do
		if args[i] == nil or args[i] == "" then
			args[i] = "nil"
		end
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ", 1, n) .. ")"
end

-- Expression d'une entrée « objet / personnage ». Le littéral « le personnage » devient
-- « (personnage or joueur) » : sous un événement qui ne fournit que le joueur, son personnage est utilisé.
local function persoOu(a, nom)
	if a.raw ~= nil and a.raw[nom] == "personnage" then
		return "(personnage or joueur)"
	end
	local expr = a[nom]
	if expr == nil or expr == "" then
		return "nil"
	end
	return expr
end

-- Table d'état partagée par les blocs « Tout prêts » d'un script
local function etatTP(g)
	return g.declare("_etatTP", "{ montrer = false }")
end

-- « cible » et « joueurCible » existent au niveau du script (nil hors de « pour chaque ennemi »)
local function declarerCibles(g)
	g.declare("cible", "nil")
	g.declare("joueurCible", "nil")
end

-- Dans un script local, « pour chaque ennemi dans une hitbox » (serveur) n'existe pas : la cible est
-- toujours vide, et les aides prendraient alors le personnage du joueur local. On prévient.
local function avertirCibleLocale(g, quoi)
	if g.mode == "local" then
		g.warn(
			"« "
				.. quoi
				.. " » n'existe que dans « pour chaque ennemi dans une hitbox » (script serveur) : dans un script local, cette valeur est toujours vide (rien)."
		)
	end
end

-- Entrée de cible : déclare « cible » si l'option « la cible touchée » est choisie
local function cibleOu(a, g, nom)
	if a.raw ~= nil and a.raw[nom] == "cible" then
		declarerCibles(g)
		if g.mode == "local" then
			avertirCibleLocale(g, "la cible touchée")
			-- false (et non nil) : _perso(nil) donnerait le personnage du joueur local
			return "(cible or false)"
		end
	end
	return persoOu(a, nom)
end

-- Code indenté d'un niveau, précédé d'un saut de ligne ("" si le code est vide)
local function corps(g, code)
	if code == nil or code == "" then
		return ""
	end
	return "\n" .. g.indent(code)
end

