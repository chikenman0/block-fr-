		label = "Quand le texte de %1 est validé",
		inputs = { guiInput("CHAMP", "champ", "Pseudo") },
		scriptType = "local",
		keywords = "quand texte champ valide valider entree ecrire saisir taper pseudo code interface gui textbox input enter",
		tooltip = "S'exécute quand le joueur a écrit dans ce champ de texte puis appuyé sur Entrée. Récupère ce qu'il a écrit avec le bloc « texte de … ». À mettre dans un script local.",
		gen = function(a, g)
			return chapeau(g, "_guiSurValide", a.CHAMP, a.BODY)
		end,
	},
	{
		id = "gui_quand_survol",
