	---------------------------------------------------------------------------
	-- Scripts modules (SPEC §20)
	-- Le module et le script qui l'utilise vont dans deux cibles différentes : le module dans un
	-- Folder « Outils » de ReplicatedStorage (ModuleScript « BlocsModule »), le script serveur dans
	-- une Part. Les blocs mod_* trouvent le module par le nom « Outils » (_trouverModule).
	-- Une case de paramètre vide est ignorée ; une case d'argument vide envoie nil.
	---------------------------------------------------------------------------
	{
		id = "module_outils",
		title = "Boîte à outils (script module)",
		description = "Un script module qui range deux fonctions utilisables par tous tes scripts : « soignerJoueur » soigne le joueur reçu dans le paramètre « qui », et « aleatoireEntre » renvoie un nombre au hasard entre « min » et « max ». Quand il est chargé, il range aussi la valeur « bonus ». Il va avec l'exemple « Tapis de soin (utilise le module) ».",
		mode = "module",
		cible = "un Folder « Outils » dans ReplicatedStorage",
		variables = {},
		piles = {
			{
				{ "mod_fonction", NOM = "soignerJoueur", P1 = "qui", P2 = "", P3 = "" },
				{ "j_soigner", JOUEUR = { "mod_parametre", NOM = "qui" }, POINTS = 50 },
				{
					"j_message_ecran",
					MESSAGE = "Te voilà soigné !",
					JOUEUR = { "mod_parametre", NOM = "qui" },
					DUREE = 2,
				},
			},
			{
				{ "mod_fonction", NOM = "aleatoireEntre", P1 = "min", P2 = "max", P3 = "" },
				{
					"mod_renvoyer",
					VALEUR = {
						"op_aleatoire",
						A = { "mod_parametre", NOM = "min" },
						B = { "mod_parametre", NOM = "max" },
					},
				},
			},
			{
				{ "mod_au_chargement" },
				{ "mod_definir_valeur", NOM = "bonus", VALEUR = "10" },
				{ "dbg_afficher", VALEUR = "Le module Outils est chargé !" },
			},
		},
		notes = {
			{ pile = 1, texte = "Le paramètre « qui » reçoit le joueur envoyé par le script qui appelle la fonction.", couleur = "bleu" },
		},
	},
	{
		id = "utiliser_module",
		title = "Tapis de soin (utilise le module)",
		description = "Un script serveur qui utilise le module « Outils » : le joueur qui marche sur le tapis est soigné par la fonction « soignerJoueur » et gagne entre 1 et 10 pièces grâce au résultat de « aleatoireEntre ». Au démarrage, il vérifie que le module existe et donne à chaque joueur la valeur « bonus » du module comme pièces de départ.",
		mode = "server",
		cible = "une Part plate dans Workspace (le tapis de soin). Le module de l'exemple « Boîte à outils (script module) » doit déjà être enregistré dans un Folder « Outils » de ReplicatedStorage.",
		variables = {},
		piles = {
			{
				{ "evt_touche_perso_delai", DELAI = 2 },
				{
					"mod_appeler",
					NOM = "soignerJoueur",
					MODULE = "Outils",
					A = { "val_joueur" },
					B = "",
					C = "",
				},
				{
					"j_ajouter_stat",
					VALEUR = { "mod_resultat", NOM = "aleatoireEntre", MODULE = "Outils", A = "1", B = "10", C = "" },
					NOM = "Pièces",
					JOUEUR = "joueur",
				},
			},
			{
				{ "evt_demarrage" },
				{
					"ctrl_si_sinon",
					COND = { "mod_existe", MODULE = "Outils" },
					DO = {
						{
							"j_creer_stat",
							NOM = "Pièces",
							DEPART = { "mod_valeur", NOM = "bonus", MODULE = "Outils" },
						},
					},
					ELSE = {
						{ "dbg_avertir", VALEUR = "Module Outils introuvable ! Crée-le dans un Folder « Outils » de ReplicatedStorage (voir le tutoriel du wiki)." },
					},
				},
				{ "app_couleur", OBJ = "script.Parent", COULEUR = { 60, 200, 90 } },
				{ "app_materiau", OBJ = "script.Parent", MATERIAU = "Enum.Material.Neon" },
			},
		},
	},

