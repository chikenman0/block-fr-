}

local tutoCombat = {
	id = "tuto_combat",
	title = "Système de combat : animation + hitbox",
	summary = "Appuie sur F : ton personnage donne un coup d'épée et les ennemis devant lui perdent de la vie. Deux scripts, un temps de recharge et une hitbox visible pour tes tests.",
	body = {
		p("Dans ce tutoriel, tu vas fabriquer une vraie attaque de jeu de combat avec les blocs de la catégorie **Tout prêts** : une animation de coup d'épée, une **hitbox** (une boîte invisible devant le personnage qui détecte les ennemis), des dégâts, un recul, un flash rouge… et un **temps de recharge** pour qu'on ne puisse pas spammer l'attaque."),
		h("Pourquoi deux scripts ?"),
		p("Le **clavier** ne se lit que dans un **script local** (chez le joueur). Mais les **dégâts** doivent être faits par un **script serveur** : sinon, seul le joueur qui attaque verrait l'ennemi perdre de la vie, et un tricheur pourrait faire n'importe quoi. Les deux scripts se parlent avec un **message** :"),
		etapes({
			"**Script local** : quand le joueur appuie sur F, il envoie le message `attaque` au serveur.",
			"**Script serveur** : quand il reçoit le message `attaque`, il vérifie le temps de recharge, puis lance l'attaque toute prête du personnage de ce joueur.",
		}),
		h("Où placer les deux scripts ?"),
		p("**Le script local** : dans **StarterPlayer → StarterPlayerScripts** (Blocs FR crée un `LocalScript`). Une Part de **Workspace** marche aussi : Blocs FR y crée un script réglé sur « Client » (RunContext Client), qui tourne chez chaque joueur."),
		p("**Le script serveur** : dans **ServerScriptService**, l'endroit idéal pour un script qui concerne tout le jeu. Une Part ou un modèle de Workspace marche aussi."),
		attention("Un objet ne contient qu'**un seul** script Blocs FR : si tu enregistres le deuxième projet dans le même objet que le premier, il le **remplace**. Mets donc le script local et le script serveur dans **deux cibles différentes**."),
		h("1. Le script local : la touche F"),
		etapes({
			"Dans l'Explorateur, ouvre **StarterPlayer** et sélectionne **StarterPlayerScripts**.",
			"Dans l'éditeur, clique sur **Nouveau**, puis choisis **Script local** en haut.",
			"Glisse « Quand la touche … est appuyée » (catégorie **Événements**) et choisis `F` dans son menu.",
			"Accroche dessous « envoyer le message … au serveur » (catégorie **Contrôle**) et écris `attaque`.",
			"Bonus : fais une deuxième pile avec « Quand le joueur clique avec la souris » (catégorie **Tout prêts**) et le même « envoyer le message … au serveur » avec `attaque` : le clic gauche (ou un toucher sur téléphone) attaque aussi.",
			"Clique sur **Enregistrer** : un script `BlocsLocal` apparaît dans StarterPlayerScripts.",
		}),
		exemple("combat_local"),
		h("2. Le script serveur : l'attaque"),
		etapes({
			"Sélectionne **ServerScriptService** et clique sur **Nouveau**. Choisis **Script serveur** en haut de l'éditeur.",
			"Glisse « Quand je reçois le message … » (catégorie **Événements**) et écris `attaque`, exactement comme dans le script local. Ici, « le joueur » est le joueur qui a appuyé sur F.",
			"Accroche dessous « avec un temps de recharge de … s pour … » (catégorie **Tout prêts**) : écris `0.6` et laisse « le joueur ».",
			"Dans ce bloc en forme de C, mets « attaque de … : animation …, … dégâts, portée … » (catégorie **Tout prêts**) : « le personnage », « coup d'épée », `20` dégâts et une portée de `6`.",
			"Fais une deuxième pile : « Quand ce script démarre » puis « montrer les hitbox : … » (catégorie **Tout prêts**) sur « oui ».",
			"Clique sur **Enregistrer** : un script `BlocsServeur` apparaît dans ServerScriptService.",
		}),
		exemple("combat_serveur"),
		astuce("Le détecteur affiche peut-être le conseil « Message jamais envoyé ici. » sur « Quand je reçois le message … » : c'est normal, le message `attaque` est envoyé par l'autre script, le script local."),
		h("Comment ça marche ?"),
		p("« attaque de … : animation …, … dégâts, portée … » fait tout en un seul bloc : le personnage joue l'animation, puis au moment de l'impact (0,25 seconde plus tard), une **hitbox** de 5 × 5 studs, longue comme la portée, est placée juste **devant** lui. Chaque ennemi dedans, joueur ou PNJ, perd les dégâts, est un peu repoussé et clignote en rouge. Le personnage qui attaque n'est jamais touché par sa propre hitbox."),
		p("Sous « Quand je reçois le message … », le serveur ne connaît que « le joueur » qui a envoyé le message : avec « le personnage », Blocs FR prend automatiquement le personnage de ce joueur."),
		p("« avec un temps de recharge de … s pour … » n'exécute les blocs qu'il contient que si la dernière attaque de ce joueur date d'au moins 0,6 seconde. Sinon, le message est simplement ignoré. Chaque joueur a son propre temps de recharge."),
		bloc("tp_montrer_hitbox"),
		astuce("Avec « montrer les hitbox : … » sur « oui », chaque hitbox apparaît pendant 0,2 seconde sous forme de boîte rouge transparente : tu vois exactement où frappe ton coup. Ce bloc doit être dans le **même script** que l'attaque (le script serveur). Remets-le sur « non » avant de publier ton jeu."),
		h("Tester avec un mannequin"),
		etapes({
			"Ajoute un ennemi d'entraînement : onglet **Avatar** → **Rig Builder**, puis choisis un mannequin **R15** (par exemple « Block Rig »). Il apparaît dans Workspace : c'est un modèle avec un Humanoid, donc un PNJ.",
			"Place-le près du point d'apparition. Si sa partie **HumanoidRootPart** est ancrée (case **Anchored** cochée), décoche-la : un objet ancré prend les dégâts mais ne peut pas être repoussé.",
			"Clique sur **Jouer**, puis clique dans la fenêtre du jeu pour qu'elle reçoive le clavier.",
			"Approche-toi du mannequin (moins de 6 studs), **tourne-toi vers lui** et appuie sur **F** : la boîte rouge apparaît devant toi, le mannequin clignote en rouge et perd 20 points de vie.",
			"Au 5e coup, le mannequin est éliminé. Il ne réapparaît pas : arrête le test et relance-le, tout revient comme avant. Duplique-le avec **Ctrl+D** pour avoir plusieurs cibles.",
			"Pour tester entre joueurs, lance dans l'onglet **Test** un serveur avec **2 joueurs** (Clients et serveurs) : chaque fenêtre est un joueur.",
		}),
		attention("Les animations de la liste sont faites pour les personnages **R15**. Si ton jeu utilise des avatars R6, la Sortie l'indique et l'animation n'est pas jouée (les dégâts marchent quand même) : choisis R15 dans **Paramètres du jeu → Avatar**, ou joue ta propre animation avec « jouer l'animation d'ID … sur … »."),
		h("Si ça ne marche pas"),
		p("**Rien ne se passe quand j'appuie sur F** : le premier projet doit être un **script local** (et pas dans ServerScriptService), le second un **script serveur**, chacun dans sa propre cible. Le nom du message doit être exactement `attaque` des deux côtés. Regarde aussi la **Sortie** : les lignes `[Blocs FR]` expliquent ce qui coince."),
		p("**La boîte rouge apparaît mais personne n'est touché** : l'ennemi est trop loin, ou il n'est pas **devant** toi. La hitbox suit la direction dans laquelle ton personnage regarde."),
		p("**Pas de boîte rouge** : « montrer les hitbox : … » doit être sur « oui », sous « Quand ce script démarre », dans le **script serveur**."),
		p("**Je peux attaquer trop vite** (ou pas assez) : change le nombre de secondes du temps de recharge."),
		h("Pour aller plus loin"),
		p("Pour régler chaque étape toi-même, remplace « attaque de … : animation …, … dégâts, portée … » par « jouer l'animation … sur … (vitesse …) », « attendre … secondes » avec `0.25`, puis « pour chaque ennemi dans une hitbox devant … (taille … × … × …) ». À l'intérieur, glisse « la cible touchée » dans « infliger … dégâts à … », puis ajoute « repousser … loin de … (force …) » et « faire clignoter … en rouge »."),
		bloc("tp_hitbox"),
		bloc("tp_cible"),
		p("Ajoute aussi une esquive : dans le script local, « Quand la touche … est appuyée » avec `Q`, puis « faire un dash à … sur … studs »."),
		lien("galerie", "Exemple : un PNJ ennemi qui riposte, avec sa barre de vie", "ex_pnj_ennemi"),
		lien("galerie", "Exemple : une zone de lave toute prête", "ex_zone_lave"),
		lien("cat_toutprets", "Tous les blocs « Tout prêts »"),
		lien("messages", "Les messages entre scripts"),
		lien("tuto_module", "Tutoriel suivant : une boîte à outils avec un module"),
	},
}

local tutoModule = {
	id = "tuto_module",
	title = "Une boîte à outils avec un module",
	summary = "Range tes fonctions dans un script module, puis utilise-les depuis un script serveur : un tapis qui soigne les joueurs et leur donne des pièces.",
	body = {
		p("Dans ce tutoriel, tu vas créer un **script module** nommé `Outils`, avec deux fonctions : `soignerJoueur` (soigne le joueur qu'on lui envoie) et `aleatoireEntre` (renvoie un nombre au hasard). Ensuite, le **script serveur** d'une Part les utilisera : le joueur qui marche dessus est soigné et gagne des pièces."),
		h("Pourquoi un module ?"),
		p("Un module se partage : demain, ta brique de lave, ton coffre au trésor ou ton PNJ pourront eux aussi appeler `soignerJoueur` ou `aleatoireEntre`, sans recopier un seul bloc. Et si tu changes la fonction dans le module, tous ces scripts suivent."),
		h("1. Le module : la boîte à outils"),
		etapes({
			"Dans l'**Explorateur**, survole **ReplicatedStorage**, clique sur le **＋** qui apparaît et ajoute un **Folder**. Renomme-le `Outils`.",
			"Sélectionne le Folder `Outils`. Dans l'éditeur de blocs, clique sur **Nouveau**, puis choisis **Script module** en haut de l'éditeur.",
			"Ouvre la catégorie **Modules** et glisse « Définir la fonction … (paramètres : … … …) » sur le canvas. Écris `soignerJoueur` dans la première case et `qui` dans la case du premier paramètre, puis vide les deux autres cases de paramètres.",
			"Accroche dessous « soigner … de … points » (catégorie **Joueurs**) et mets `50` points. Sur son menu « le joueur », lâche « paramètre … » (catégorie **Modules**) et écris `qui` dedans.",
			"Ajoute « afficher … à l'écran de … pendant … s » (catégorie **Joueurs**) avec le texte `Te voilà soigné !` et `2` secondes. Lâche encore un « paramètre … » avec `qui` sur son menu du joueur.",
			"Glisse une deuxième « Définir la fonction … (paramètres : … … …) » : écris `aleatoireEntre`, avec les paramètres `min` et `max`, et vide la troisième case.",
			"Accroche dessous « renvoyer … ». Dans sa case, glisse « nombre au hasard entre … et … » (catégorie **Opérateurs**), puis mets « paramètre … » avec `min` dans sa première case et « paramètre … » avec `max` dans la seconde.",
			"Enfin, glisse « Quand le module est chargé ». Accroche dessous « mettre la valeur … du module à … » avec `bonus` et `10`, puis « afficher … dans la sortie » (catégorie **Débogage**) avec `Le module Outils est chargé !`.",
			"Clique sur **Enregistrer** : un script module `BlocsModule` apparaît dans le Folder `Outils`.",
		}),
		exemple("module_outils"),
		astuce("Un module n'a pas besoin d'être dans une Part : il ne se touche pas et ne se clique pas. Un simple Folder suffit, et son nom sert d'adresse pour le retrouver."),
		h("2. Le script serveur : le tapis de soin"),
		etapes({
			"Ajoute une Part plate dans Workspace (ton tapis de soin) et sélectionne-la.",
			"Dans l'éditeur, clique sur **Nouveau**, puis choisis **Script serveur** en haut de l'éditeur.",
			"Glisse « Quand un personnage touche cet objet (délai … s) » (catégorie **Événements**) avec `2` secondes.",
			"Accroche dessous « appeler la fonction … du module … avec … … … » (catégorie **Modules**). Écris `soignerJoueur` dans la première case et `Outils` dans la deuxième. Dans la première case après « avec », glisse « le joueur » (catégorie **Valeurs**) : c'est lui qui arrivera dans le paramètre `qui`.",
			"Ajoute « ajouter … à la statistique … de … » (catégorie **Joueurs**) avec `Pièces` et « le joueur ». Dans sa première case, glisse « résultat de … du module … avec … … … » et remplis-le avec `aleatoireEntre`, `Outils`, `1` et `10`.",
			"Fais une deuxième pile : « Quand ce script démarre », puis le bloc « si … alors » qui possède une partie « sinon » (catégorie **Contrôle**). Dans sa condition, glisse « le module … existe » avec `Outils`.",
			"Dans la première partie, mets « créer la statistique … (départ …) » avec `Pièces`, et glisse « valeur … du module … » (`bonus`, `Outils`) dans la case du départ : chaque joueur commence avec 10 pièces.",
			"Dans la partie « sinon », mets « afficher l'avertissement … » (catégorie **Débogage**) avec un message qui t'aidera, par exemple `Module Outils introuvable !`.",
			"Bonus : sous le bloc « si … alors », ajoute « mettre la couleur de … à … » avec un vert, et « mettre le matériau de … à … » sur « néon ».",
			"Clique sur **Enregistrer**, puis sur **Jouer**. Blesse-toi un peu (sur une brique de lave par exemple), puis marche sur le tapis : tu es soigné et tu gagnes des pièces !",
		}),
		exemple("utiliser_module"),
		h("Comment ça marche ?"),
		p("Quand le script serveur arrive sur « appeler la fonction … du module … », il cherche un objet nommé `Outils` (d'abord dans ReplicatedStorage), charge le script module qu'il contient, puis lance sa fonction `soignerJoueur` en lui envoyant « le joueur ». Dans le module, « paramètre … » `qui` vaut alors ce joueur."),
		p("« résultat de … du module … » fait la même chose avec `aleatoireEntre`, mais récupère en plus ce que la fonction **renvoie** : un nombre entre `1` et `10`, ajouté aux pièces du joueur."),
		p("La première fois qu'un script utilise le module, les blocs sous « Quand le module est chargé » s'exécutent : la valeur `bonus` vaut `10`, et la Sortie affiche « Le module Outils est chargé ! » une seule fois, même si plusieurs scripts serveur utilisent le module."),
		astuce("Ajoute d'autres tapis en dupliquant la Part avec **Ctrl+D** : ils utilisent tous le même module. Pour soigner de `30` au lieu de `50`, change un seul bloc dans le module, enregistre… et tous les tapis suivent !"),
		attention("Les noms doivent être écrits exactement pareil dans le module et dans le script serveur : `soignerJoueur`, `aleatoireEntre`, `bonus` et `Outils`, majuscules comprises. Le détecteur d'erreurs te prévient quand il ne trouve pas un module ou une fonction."),
		h("Si ça ne marche pas"),
		p("**La Sortie dit que le module est introuvable** : le Folder doit s'appeler exactement `Outils`, être dans ReplicatedStorage et contenir le script `BlocsModule`. As-tu bien cliqué sur **Enregistrer** dans le projet du module ?"),
		p("**Rien ne se passe sur le tapis** : le script serveur doit être dans la Part elle-même, et le module doit être un projet séparé, dans le Folder. Un objet ne garde qu'un seul script Blocs FR : si tu enregistres le script serveur dans le Folder, il **remplace** le module."),
		p("**Je ne suis pas soigné** : vérifie que « paramètre … » contient bien `qui`, le même nom que dans « Définir la fonction … », et que « le joueur » est dans la première case après « avec »."),
		h("Pour aller plus loin"),
		p("Ajoute au module une fonction `teleporterAuDepart` avec le paramètre `qui`, et appelle-la depuis une brique piège. Comme le module est dans ReplicatedStorage, un **script local** peut aussi l'utiliser, par exemple pour calculer un nombre avec `aleatoireEntre`. Mais garde les soins et les pièces dans des scripts **serveur** : faits par un script local, ils ne compteraient que chez ce joueur."),
		lien("modules", "Tout savoir sur les scripts modules"),
		lien("cat_modules", "Tous les blocs « Modules »"),
		lien("tuto_menu", "Tutoriel suivant : un menu qui marche"),
	},
}

local tutoMenu = {
	id = "tuto_menu",
	title = "Un menu qui marche",
	summary = "Le menu principal de ton jeu en quelques clics : « Jouer » ferme le menu, « Boutique » et « Paramètres » ouvrent leurs écrans.",
	body = {
		p("Presque tous les jeux Roblox commencent par un **menu** : un grand titre, un bouton **Jouer**, une **Boutique**… Avec le Studio d'interface et ses modèles, le tien sera prêt en quelques minutes."),
		h("1. Le menu"),
		etapes({
			"Clique sur l'onglet **Interface** en haut de l'éditeur.",
			"À gauche, dans **Modèles d'interface**, clique sur **Menu principal** : un écran « Menu » apparaît, déjà dessiné, avec son titre, ses trois boutons et un compteur de pièces.",
			"Regarde la zone **Blocs de l'écran**, sous l'aperçu : « Quand le bouton Jouer est cliqué » et « cacher l'écran Menu avec fondu » sont déjà là.",
			"Change le titre : double-clique dessus et écris le nom de ton jeu.",
			"Clique sur **Enregistrer l'écran** : l'écran « Menu » est rangé dans StarterGui.",
		}),
		h("2. La boutique et les paramètres"),
		etapes({
			"Clique sur le modèle **Boutique**, puis sur **Nouvel écran avec ce modèle**, et enregistre-le.",
			"Fais pareil avec le modèle **Paramètres**.",
			"Ces deux écrans ne sont **pas visibles au démarrage** : ils attendent qu'un bloc les affiche. Leur bouton de fermeture a déjà son bloc (« cacher l'écran Boutique avec zoom »).",
		}),
		h("3. Relier les boutons du menu"),
		etapes({
			"En haut, ouvre le menu **Écran : … ▼** et choisis **Menu**.",
			"Dans l'aperçu, clique sur le bouton **Boutique**, puis sur **Ajouter un script au clic** dans les Propriétés.",
			"Sous « Quand le bouton Boutique est cliqué », accroche « afficher l'écran … avec … » (catégorie **Interface**). Choisis **Boutique** dans le premier menu ▼ et **zoom** dans le second.",
			"Fais pareil avec le bouton **Paramètres** : « afficher l'écran Paramètres avec fondu ».",
			"Clique sur **Enregistrer l'écran**, puis sur **Jouer** dans Studio.",
			"Clique sur **Boutique** : elle s'ouvre en zoomant. Ferme-la avec sa croix rouge, puis clique sur **Jouer** : le menu disparaît en fondu.",
		}),
		exemple("menu_jouer"),
		h("Comment ça marche ?"),
		p("Chaque écran est un ScreenGui de StarterGui, avec son propre script local (les blocs de l'écran). « afficher l'écran … » et « cacher l'écran … » cherchent l'écran **par son nom** chez le joueur : les blocs du menu peuvent donc ouvrir la boutique, même si elle a son propre script."),
		p("L'**effet** choisi anime l'écran pendant 0,3 seconde : fondu, glisser du haut, du bas, de la gauche ou de la droite, ou zoom. « sans effet » l'affiche d'un coup."),
		astuce("Pas besoin d'écrire les noms : le menu ▼ des cases te propose les écrans et les éléments que tu as déjà dessinés."),
		attention("Un écran garde son état quand le joueur meurt (propriété **Garder après la mort** de l'écran, cochée au départ) : une fois caché, le menu ne revient pas à chaque réapparition. Pour le montrer à nouveau, utilise « afficher l'écran Menu avec … »."),
		h("Pour aller plus loin"),
		p("Fais grossir le bouton Jouer quand la souris passe dessus : « Quand la souris entre sur Jouer » puis « animer Jouer : rebondir en 0,3 s ». Ajoute le modèle **Victoire** et affiche-le depuis la ligne d'arrivée de ton obby, avec un script serveur : « Quand un personnage touche cet objet » puis « afficher l'écran Victoire avec zoom »."),
		lien("blocs_ecran", "Les blocs sous l'écran"),
		lien("tuto_hud", "Tutoriel suivant : afficher les pièces et la vie (HUD)"),
	},
}

local tutoHud = {
	id = "tuto_hud",
	title = "Afficher les pièces et la vie (HUD)",
	summary = "Un HUD comme dans les vrais jeux : la barre de vie suit la vie du joueur, et le compteur affiche ses pièces.",
	body = {
		p("Le **HUD**, c'est tout ce qui reste affiché pendant la partie : la vie, les pièces, l'expérience, la quête du moment… Ici, la barre **Vie** va suivre la vie du personnage, et le texte **Pièces** son nombre de pièces."),
		h("1. Des pièces à ramasser"),
