			return "(#" .. appel(g, "_tpEnnemisAutour", persoOu(a, "PERSO"), g.num(a.RAYON), etatTP(g)) .. ")"
		end,
	},
	{
		id = "tp_ennemi_proche",
		shape = "reporter",
		label = "l'ennemi le plus proche de %1 (rayon %2)",
		inputs = {
			persoInput("PERSO"),
			nombre("RAYON", 50),
		},
		keywords = "ennemi plus proche cible viser rayon nearest closest enemy target npc pnj",
		tooltip = "Le personnage ennemi (joueur ou PNJ en vie) le plus proche, dans le rayon indiqué, ou rien s'il n'y en a pas. Exemple : faire marcher un PNJ vers l'ennemi le plus proche de cet objet.",
		gen = function(a, g)
			return appel(g, "_tpEnnemiProche", persoOu(a, "PERSO"), g.num(a.RAYON), etatTP(g))
		end,
	},

	---------------------------------------------------------------------------
	-- Systèmes de jeu tout prêts (SPEC §22.1) : un bloc = un système complet
	---------------------------------------------------------------------------
	{
		id = "tp_sprint",
		shape = "stack",
		label = "sprint avec %1 vitesse %2",
		inputs = {
			{ name = "TOUCHE", kind = "dropdown", options = Shared.TOUCHES, default = "Enum.KeyCode.LeftShift" },
			nombre("VITESSE", 28),
		},
		scriptType = "local",
		keywords = "sprint courir course vitesse rapide maj shift touche clavier run sprint speed shift key",
		tooltip = "Le joueur court plus vite tant qu'il garde la touche appuyée (maj par défaut), puis reprend sa vitesse d'avant quand il la relâche. Ça marche encore après une réapparition. À mettre dans un script local (par exemple dans StarterPlayerScripts), sous « Quand ce script démarre ». Astuce : 16 est la vitesse normale, 28 fait un bon sprint.",
		gen = function(a, g)
			return appel(g, "_tpSprint", etatTP(g), a.TOUCHE, g.num(a.VITESSE))
		end,
	},
	{
		id = "tp_double_saut",
		shape = "stack",
		label = "double saut (%1 saut(s) en l'air)",
		inputs = { nombre("SAUTS", 1) },
		scriptType = "local",
		keywords = "double saut sauter triple air obby parkour double jump air jump",
		tooltip = "Le joueur peut sauter encore en l'air : il appuie sur saut pendant qu'il tombe (1 = double saut, 2 = triple saut…). Ses sauts en l'air reviennent quand il touche le sol, et ça marche encore après une réapparition. À mettre dans un script local (par exemple dans StarterPlayerScripts), sous « Quand ce script démarre ». Astuce : avec « sprint », ton obby devient bien plus dynamique.",
		gen = function(a, g)
			return appel(g, "_tpDoubleSaut", etatTP(g), g.num(a.SAUTS))
		end,
	},
	{
		id = "tp_point_sauvegarde",
		shape = "stack",
		label = "%1 devient un point de sauvegarde",
		inputs = { Shared.objInput("OBJET") },
		scriptType = "server",
		keywords = "point de sauvegarde checkpoint obby reapparaitre respawn drapeau etape save point",
		tooltip = "Quand un joueur touche cet objet, il devient son point de sauvegarde (l'objet brille en vert la première fois) : quand il meurt, il réapparaît dessus. C'est le dernier point touché qui compte. À mettre dans un script serveur placé dans le point de sauvegarde, sous « Quand ce script démarre ». Astuce : mets un script comme ça dans chaque étape de ton obby, ils marchent ensemble.",
		gen = function(a, g)
			return appel(g, "_tpPointSauvegarde", etatTP(g), persoOu(a, "OBJET"))
		end,
	},
	{
		id = "tp_teleporteur",
		shape = "stack",
		label = "téléporter qui touche %1 vers %2",
		inputs = {
			Shared.objInput("OBJET"),
			{ name = "CIBLE", kind = "any", default = "Arrivée" },
		},
		scriptType = "server",
		keywords = "teleporteur teleporter portail passage arrivee destination toucher teleport portal pad",
		tooltip = "Tout personnage qui touche cet objet est téléporté sur la destination : le nom d'une partie (par exemple « Arrivée ») ou un objet. Une pause d'une seconde évite les allers-retours. À mettre dans un script serveur placé dans le téléporteur, sous « Quand ce script démarre ». Astuce : pose l'arrivée à côté du téléporteur du retour, pas dessus.",
		gen = function(a, g)
			return appel(g, "_tpTeleporteur", etatTP(g), persoOu(a, "OBJET"), a.CIBLE)
		end,
	},
	{
		id = "tp_ramasser",
		shape = "stack",
		label = "%1 se ramasse : + %2 %3, revient après %4 s",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("QUANTITE", 1),
			{ name = "STAT", kind = "text", default = "Pièces" },
			nombre("DELAI", 5),
		},
		scriptType = "server",
		keywords = "ramasser piece pieces collecter objet bonus gagner statistique leaderstats coin collect pickup",
		tooltip = "Quand un joueur touche l'objet, il gagne la quantité dans sa statistique du classement (créée si besoin), puis l'objet disparaît et revient après le délai (0 = il est détruit pour de bon). À mettre dans un script serveur placé dans la pièce, sous « Quand ce script démarre ». Astuce : ajoute « créer la statistique Pièces » dans un autre script pour qu'elle s'affiche dès le début.",
		gen = function(a, g)
			return appel(
				g,
				"_tpRamasser",
				etatTP(g),
				persoOu(a, "OBJET"),
				g.num(a.QUANTITE),
				g.str(a.STAT),
				g.num(a.DELAI)
			)
		end,
	},
	{
		id = "tp_generateur",
		shape = "stack",
		label = "générer une copie de %1 toutes les %2 s (max %3)",
		inputs = {
			{ name = "MODELE", kind = "any", default = "Pièce" },
			nombre("DELAI", 3),
			nombre("MAX", 10),
		},
		scriptType = "server",
		keywords = "generer generateur copie copier cloner apparaitre pieces ennemis vagues spawn spawner clone",
		tooltip = "Fait apparaître une copie du modèle (cherché par son nom dans ServerStorage, ReplicatedStorage puis Workspace) près de cet objet, toutes les quelques secondes, sans dépasser le maximum de copies en même temps. À mettre dans un script serveur placé dans une partie « générateur », sous « Quand ce script démarre ». Astuce : range le modèle dans ServerStorage ; pour des pièces, mets « revient après 0 s » dans le script de la pièce.",
		gen = function(a, g)
			return appel(g, "_tpGenerateur", etatTP(g), a.MODELE, g.num(a.DELAI), g.num(a.MAX))
		end,
	},
	{
		id = "tp_porte_auto",
		shape = "stack",
		label = "porte automatique %1 s'ouvre à %2 studs",
		inputs = {
			Shared.objInput("PORTE"),
			nombre("DISTANCE", 10),
		},
		scriptType = "server",
		keywords = "porte automatique ouvrir fermer approcher distance coulissante door automatic open sliding",
		tooltip = "La porte monte toute seule (de sa hauteur) quand un joueur s'approche à moins de la distance indiquée, puis redescend quand il n'y a plus personne. La porte est ancrée. À mettre dans un script serveur placé dans la porte (une partie ou un modèle), sous « Quand ce script démarre ». Astuce : un personnage mesure environ 5 studs de haut.",
		gen = function(a, g)
			return appel(g, "_tpPorteAuto", etatTP(g), persoOu(a, "PORTE"), g.num(a.DISTANCE))
		end,
	},
	{
		id = "tp_plateforme_mobile",
		shape = "stack",
		label = "plateforme %1 va-et-vient vers %2 en %3 s",
		inputs = {
			Shared.objInput("OBJET"),
			{ name = "CIBLE", kind = "any", default = "Point2" },
			nombre("DUREE", 3),
		},
		scriptType = "server",
		keywords = "plateforme mobile bouge deplacer va et vient aller retour ascenseur obby moving platform elevator",
		tooltip = "La plateforme va et vient sans fin entre sa place de départ et la destination (le nom d'une partie, par exemple « Point2 »), en douceur : chaque trajet dure le temps indiqué. Elle est ancrée et emporte les joueurs posés dessus. À mettre dans un script serveur placé dans la plateforme, sous « Quand ce script démarre ». Astuce : rends « Point2 » transparente, ancrée et sans collision.",
		gen = function(a, g)
			return appel(g, "_tpPlateformeMobile", etatTP(g), persoOu(a, "OBJET"), a.CIBLE, g.num(a.DUREE))
		end,
	},
	{
		id = "tp_plateforme_disparait",
		shape = "stack",
		label = "plateforme %1 disparaît au contact, revient après %2 s",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("DELAI", 3),
		},
		scriptType = "server",
		keywords = "plateforme disparait disparaitre clignoter tomber piege obby revient disappearing platform fading trap",
		tooltip = "Quand un personnage la touche, la plateforme clignote 0,6 seconde, puis devient invisible et traversable, et revient après le délai. À mettre dans un script serveur placé dans la plateforme, sous « Quand ce script démarre ». Astuce : parfait dans un obby, pour obliger à sauter vite !",
		gen = function(a, g)
			return appel(g, "_tpPlateformeDisparait", etatTP(g), persoOu(a, "OBJET"), g.num(a.DELAI))
		end,
	},
	{
		id = "tp_tapis_roulant",
		shape = "stack",
		label = "tapis roulant %1 vitesse %2",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("VITESSE", 16),
		},
		scriptType = "server",
		keywords = "tapis roulant convoyeur transporter pousser glisser usine obby conveyor belt treadmill",
		tooltip = "La partie devient un tapis roulant : elle reste en place (ancrée) mais emporte ce qui est posé dessus vers sa face avant (Front), à la vitesse indiquée. À mettre dans un script serveur placé dans la partie, sous « Quand ce script démarre ». Astuce : une vitesse négative fait rouler le tapis dans l'autre sens.",
		gen = function(a, g)
			return appel(g, "_tpTapisRoulant", etatTP(g), persoOu(a, "OBJET"), g.num(a.VITESSE))
		end,
	},
	{
		id = "tp_trampoline",
		shape = "stack",
		label = "trampoline %1 force %2",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("FORCE", 120),
		},
		scriptType = "server",
		keywords = "trampoline rebondir rebond sauter propulser haut champignon obby bounce jump pad",
		tooltip = "Fait rebondir très haut tout personnage qui touche l'objet (120 = un grand saut, 60 = un petit). À mettre dans un script serveur placé dans le trampoline, sous « Quand ce script démarre ». Astuce : mets le trampoline en néon pour qu'on le repère de loin.",
		gen = function(a, g)
			return appel(g, "_tpTrampoline", etatTP(g), persoOu(a, "OBJET"), g.num(a.FORCE))
		end,
	},
	{
		id = "tp_zone_soin",
		shape = "stack",
		label = "zone de soin %1 : + %2 vie par seconde",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("SOIN", 10),
		},
		scriptType = "server",
		keywords = "zone de soin soigner guerir vie sante regenerer infirmerie heal zone healing regen",
		tooltip = "Chaque personnage dans la zone (ou posé dessus) regagne ce nombre de points de vie par seconde, sans dépasser sa vie maximum. À mettre dans un script serveur placé dans la zone, sous « Quand ce script démarre ». Astuce : fais une grande partie verte, transparente et sans collision, dans laquelle on entre.",
		gen = function(a, g)
			return appel(g, "_tpZoneSoin", etatTP(g), persoOu(a, "OBJET"), g.num(a.SOIN))
		end,
	},
	{
		id = "tp_jour_nuit",
		shape = "stack",
		label = "cycle jour/nuit de %1 minutes",
		inputs = { nombre("MINUTES", 10) },
		scriptType = "server",
		keywords = "cycle jour nuit heure soleil lune temps ciel lumiere day night cycle time sun",
		tooltip = "Le soleil et la lune tournent tout seuls, en douceur : une journée complète dure le nombre de minutes indiqué. Un seul cycle tourne dans le jeu (un deuxième bloc change seulement sa durée). À mettre dans un script serveur (par exemple dans ServerScriptService), sous « Quand ce script démarre ». Astuce : place « mettre l'heure à 6 h » juste avant pour commencer au lever du soleil.",
		gen = function(a, g)
			return appel(g, "_tpJourNuit", g.num(a.MINUTES))
		end,
	},
	{
		id = "tp_sauver_stats",
		shape = "stack",
		label = "sauvegarder les statistiques des joueurs",
		inputs = {},
		scriptType = "server",
		keywords = "sauvegarder sauvegarde enregistrer statistiques leaderstats pieces progression datastore save data stats",
		tooltip = "Enregistre les statistiques du classement (leaderstats) de chaque joueur quand il quitte le jeu, et les lui rend quand il revient. Un seul bloc suffit pour tout le jeu. À mettre dans un script serveur (par exemple dans ServerScriptService), sous « Quand ce script démarre ». Astuce : pour tester dans Studio, publie le jeu puis active « Accès aux services API » dans Paramètres du jeu > Sécurité.",
		gen = function(_a, g)
			return appel(g, "_tpSauverStats", etatTP(g))
		end,
	},
	{
		id = "tp_minuteur_ecran",
		shape = "stack",
		label = "minuteur à l'écran de %1 s puis envoyer %2",
		inputs = {
			nombre("SECONDES", 60),
			{ name = "MESSAGE", kind = "text", default = "fin" },
		},
		keywords = "minuteur compte a rebours chrono temps ecran manche fin message timer countdown round",
		tooltip = "Affiche un compte à rebours en haut de l'écran, puis envoie le message quand il arrive à 0 (reçu par « Quand je reçois le message »). Le script continue tout de suite, et un nouveau minuteur remplace l'ancien. Dans un script serveur, tous les joueurs le voient ; dans un script local, seulement toi. Mets-le par exemple sous « Quand ce script démarre ». Astuce : « Quand je reçois le message fin » peut terminer la manche.",
		gen = function(a, g)
			-- comme « envoyer le message » : hors script local, le joueur du contexte accompagne le message
			local qui = "joueur"
			if g.mode == "local" then
				qui = "nil"
			end
			return appel(g, "_tpMinuteurEcran", etatTP(g), g.num(a.SECONDES), g.str(a.MESSAGE), qui)
		end,
	},
	{
		id = "tp_bouton_achat",
		shape = "stack",
		label = "bouton %1 : donner %2 pour %3 %4",
		inputs = {
			Shared.objInput("OBJET"),
			{ name = "OUTIL", kind = "text", default = "Épée" },
			nombre("PRIX", 100),
			{ name = "STAT", kind = "text", default = "Pièces" },
		},
		scriptType = "server",
		keywords = "bouton acheter achat boutique magasin outil arme epee prix pieces payer shop buy tool sword",
		tooltip = "Quand un joueur clique sur l'objet et qu'il a assez de la statistique (par exemple 100 Pièces), le prix lui est retiré et il reçoit une copie de l'outil (Tool) rangé dans ServerStorage, ReplicatedStorage ou Lighting ; il le garde même après une réapparition. L'objet brille en vert, ou en rouge s'il n'a pas assez. À mettre dans un script serveur placé dans le bouton, sous « Quand ce script démarre ». Astuce : range ton outil « Épée » dans ServerStorage.",
		gen = function(a, g)
			return appel(
				g,
				"_tpBoutonAchat",
				etatTP(g),
				persoOu(a, "OBJET"),
				g.str(a.OUTIL),
				g.num(a.PRIX),
				g.str(a.STAT)
			)
		end,
	},

	---------------------------------------------------------------------------
	-- Encore plus de systèmes tout prêts (SPEC §34) : un bloc = un système complet, installé une
	-- seule fois par objet (appelé de nouveau, il change seulement ses réglages)
	---------------------------------------------------------------------------
	{
		id = "tp_mortel",
		shape = "stack",
		label = "%1 élimine qui le touche",
		inputs = { Shared.objInput("OBJET") },
		scriptType = "server",
		keywords = "mortel mortelle brique tuer eliminer mourir piege lave obby toucher kill brick killbrick lava trap deadly",
		tooltip = "Tout personnage (joueur ou PNJ) qui touche l'objet est éliminé d'un coup : c'est la brique mortelle des obbys. Un seul bloc suffit, même pour un modèle avec plusieurs parties. À mettre dans un script serveur placé dans la brique, sous « Quand ce script démarre ». Astuce : fais-la en néon rouge pour que les joueurs voient le danger.",
		gen = function(a, g)
			return appel(g, "_tpMortel", etatTP(g), persoOu(a, "OBJET"))
		end,
	},
	{
		id = "tp_flotter",
		shape = "stack",
		label = "faire flotter %1 (hauteur %2, vitesse %3)",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("HAUTEUR", 2),
			nombre("VITESSE", 1),
		},
		scriptType = "server",
		keywords = "flotter flottant monter descendre bouger piece bonus haut bas vague float floating bob hover coin",
		tooltip = "L'objet monte doucement de la hauteur indiquée (en studs) au-dessus de sa place, puis redescend, sans fin. Vitesse 1 = un aller-retour toutes les 2 secondes, 2 = deux fois plus vite. L'objet est ancré. À mettre dans un script serveur placé dans l'objet, sous « Quand ce script démarre ». Astuce : ajoute « faire tourner … sans arrêt » sur le même objet : ta pièce flotte ET tourne, comme dans les vrais jeux !",
		gen = function(a, g)
			return appel(g, "_tpFlotter", etatTP(g), persoOu(a, "OBJET"), g.num(a.HAUTEUR), g.num(a.VITESSE))
		end,
	},
	{
		id = "tp_rotation",
		shape = "stack",
		label = "faire tourner %1 sans arrêt (vitesse %2)",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("VITESSE", 90),
		},
		scriptType = "server",
		keywords = "tourner rotation tourne sans arret toupie piece obstacle helice moulin spin spinner rotate rotating coin",
		tooltip = "L'objet tourne sur lui-même autour de l'axe vertical, sans fin. Vitesse en degrés par seconde : 90 = un quart de tour par seconde, 360 = un tour ; un nombre négatif tourne dans l'autre sens. L'objet est ancré et emporte les joueurs posés dessus. À mettre dans un script serveur placé dans l'objet, sous « Quand ce script démarre ». Astuce : une longue barre qui tourne + « élimine qui le touche » = un obstacle d'obby redoutable.",
		gen = function(a, g)
			return appel(g, "_tpRotation", etatTP(g), persoOu(a, "OBJET"), g.num(a.VITESSE))
		end,
	},
	{
		id = "tp_ascenseur",
		shape = "stack",
		label = "ascenseur %1 monte de %2 studs quand on monte dessus",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("HAUTEUR", 20),
		},
		scriptType = "server",
		keywords = "ascenseur monter descendre plateforme etage elevateur obby lift elevator platform",
		tooltip = "Quand un joueur monte dessus, la plateforme monte de la hauteur indiquée (en douceur, en l'emportant), attend 3 secondes en haut, puis redescend. Elle est ancrée, et un contact par le côté ne la fait pas partir. À mettre dans un script serveur placé dans la plateforme, sous « Quand ce script démarre ». Astuce : avec un nombre négatif, l'ascenseur descend (vers une cave).",
		gen = function(a, g)
			return appel(g, "_tpAscenseur", etatTP(g), persoOu(a, "OBJET"), g.num(a.HAUTEUR))
		end,
	},
	{
		id = "tp_chrono_course",
		shape = "stack",
		label = "chronomètre : départ %1, arrivée %2",
		inputs = {
			{ name = "DEPART", kind = "any", default = "Départ" },
			{ name = "ARRIVEE", kind = "any", default = "Arrivée" },
		},
		scriptType = "server",
		keywords = "chronometre chrono course temps record depart arrivee meilleur temps circuit obby speedrun timer race stopwatch",
		tooltip = "Un chronomètre de course pour chaque joueur : il démarre quand le joueur quitte « Départ » et s'arrête quand il touche « Arrivée » (des noms de parties, ou des objets). Le temps s'affiche en haut de l'écran, et le meilleur temps va dans la statistique « Record » du classement. À mettre dans un script serveur (par exemple dans ServerScriptService), sous « Quand ce script démarre ». Astuce : retourner au départ relance le chrono ; si le départ et l'arrivée sont la même partie, il chronomètre un tour de circuit.",
		gen = function(a, g)
			return appel(g, "_tpChronoCourse", etatTP(g), a.DEPART, a.ARRIVEE)
		end,
	},
	{
		id = "tp_lave_montante",
		shape = "stack",
		label = "la lave %1 monte de %2 studs par seconde jusqu'à %3",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("VITESSE", 1),
			nombre("HAUTEUR", 50),
		},
		scriptType = "server",
		keywords = "lave montante monter mortel inondation eau acide manche survie tour rising lava flood floor is lava survival",
		tooltip = "La lave monte toute seule (en studs par seconde) jusqu'à la hauteur indiquée au-dessus de sa place de départ, puis s'arrête. Tout joueur qui la touche, ou qu'elle rattrape, est éliminé. Quand le message « fin » est envoyé, elle redescend d'un coup et remonte 3 secondes plus tard. À mettre dans un script serveur placé dans la partie de lave, sous « Quand ce script démarre ». Astuce : « minuteur à l'écran de 60 s puis envoyer fin » remet la lave en bas à la fin de la manche.",
		gen = function(a, g)
			return appel(g, "_tpLaveMontante", etatTP(g), persoOu(a, "OBJET"), g.num(a.VITESSE), g.num(a.HAUTEUR))
		end,
	},
	{
		id = "tp_zone_vitesse",
		shape = "stack",
		label = "zone de vitesse %1 : vitesse %2 pendant %3 s",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("VITESSE", 40),
			nombre("DUREE", 3),
		},
		scriptType = "server",
		keywords = "zone vitesse rapide courir bonus boost acceleration accelerateur dalle pad speed boost run",
		tooltip = "Quand un personnage touche la zone, il court à la vitesse indiquée pendant quelques secondes, puis reprend sa vitesse d'avant (0 s = jusqu'à sa réapparition). La retoucher recharge le temps. À mettre dans un script serveur placé dans la zone, sous « Quand ce script démarre ». Astuce : 16 est la vitesse normale, 40 va très vite. Garde la zone dans le jeu : détruite pendant le bonus, elle ne pourrait plus rendre la vitesse d'avant.",
		gen = function(a, g)
			return appel(
				g,
				"_tpZoneBoost",
