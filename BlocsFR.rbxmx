		inputs = {
			guiInput("ECRAN", "ecran", "Menu"),
			{ name = "EFFET", kind = "dropdown", options = EFFETS_ECRAN, default = '"fondu"' },
		},
		keywords = "cacher ecran fermer masquer menu fenetre interface gui fondu glisser zoom hide close screen",
		tooltip = "Cache un écran de ton interface avec un effet (fondu, glisser vers un bord, zoom…). L'effet dure 0,3 s, puis le script continue. Astuce : place-le sous « Quand le bouton Fermer est cliqué »." .. SERVEUR,
		gen = function(a, g)
			return appel(g, "_guiCacherEcran", "joueur", a.ECRAN, a.EFFET)
		end,
	},
	{
