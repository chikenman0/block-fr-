				'"vitesse"',
				g.num(a.VITESSE),
				g.num(a.DUREE)
			)
		end,
	},
	{
		id = "tp_zone_saut",
		shape = "stack",
		label = "zone de super saut %1 : force %2 pendant %3 s",
		inputs = {
			Shared.objInput("OBJET"),
			nombre("FORCE", 100),
			nombre("DUREE", 5),
