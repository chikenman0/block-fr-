<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Script" referent="RBX0"><Properties><string name="Name">BlocsFR</string><ProtectedString name="Source"><![CDATA[-- Blocs FR : point d'entrée du plugin.
-- Programmez vos objets Roblox avec des blocs, comme dans Scratch, entièrement en français.
--  * Pendant un test (Jouer / Exécuter) : seul ErrorWatcher tourne. Il note les erreurs des scripts
--    Blocs FR dans les réglages du plugin (« BlocsFR_ErreursTest ») ; l'éditeur les affiche ensuite.
--  * En édition : les paramètres (module Reglages, SPEC §31) sont lus et appliqués au thème AVANT de
--    charger le moindre module d'interface ; barre d'outils « Blocs FR » (Éditeur de blocs, Wiki,
--    Interface), fenêtre de l'éditeur et fenêtre du wiki (créée à la première ouverture).
--  * host.rebuildApp() (Paramètres › Appliquer) : l'éditeur est reconstruit avec une copie fraîche des
--    modules (les valeurs du thème recopiées au chargement suivent les nouveaux paramètres), en gardant
--    les projets ouverts (app:exportState() -> App.new(host, state)). Le wiki est refait lui aussi.
--  * Versions de développement : pré-chargement de chaque module, DevBridge (pont de test) et
--    DevReload (rechargement des modules sans redémarrer Studio).
-- La version vient de MiseAJour.VERSION (seule source, SPEC §25), sinon DEFAULT_VERSION.

local RunService = game:GetService("RunService")

local DEFAULT_VERSION = "2.1.0"
local SESSION_START = os.time()

-- Dossier des modules : le script lui-même, un dossier rechargé par DevReload, ou la copie fraîche
-- faite par host.rebuildApp
local moduleRoot = script

local function req(name)
	return require(moduleRoot:WaitForChild(name, 10))
end

---------------------------------------------------------------------------
-- Pendant un test : uniquement la surveillance des erreurs (pas de barre d'outils ni de fenêtre)
---------------------------------------------------------------------------
local okRunning, isRunning = pcall(function()
	return RunService:IsRunning()
end)
if okRunning and isRunning then
	local watcherModule = script:FindFirstChild("ErrorWatcher")
	local okModule, ErrorWatcher = false, "module ErrorWatcher introuvable"
	if watcherModule ~= nil then
		okModule, ErrorWatcher = pcall(require, watcherModule)
	end
	if okModule and type(ErrorWatcher) == "table" and type(ErrorWatcher.start) == "function" then
		local okStart, stopOrErr = pcall(ErrorWatcher.start, plugin)
		if not okStart then
			warn("[Blocs FR] Surveillance des erreurs indisponible : " .. tostring(stopOrErr))
		elseif type(stopOrErr) == "function" then
			-- Fin du test : les erreurs encore en attente (écritures groupées toutes les 0,3 s) sont
			-- enregistrées tout de suite, sinon les dernières (par exemple en quittant) seraient perdues
			plugin.Unloading:Connect(function()
				pcall(stopOrErr)
			end)
		end
	else
		warn("[Blocs FR] Module ErrorWatcher indisponible : " .. tostring(ErrorWatcher))
	end
	return
end

---------------------------------------------------------------------------
-- Édition
---------------------------------------------------------------------------

local isDev = script:FindFirstChild("DevBridge") ~= nil

-- Réglages du plugin (partagés avec ErrorWatcher pendant les tests)
local function getSetting(key)
	local ok, value = pcall(function()
		return plugin:GetSetting(key)
	end)
	if ok then
		return value
	end
	return nil
end

local function setSetting(key, value)
	pcall(function()
		plugin:SetSetting(key, value)
	end)
end

-- Paramètres (SPEC §31) : lus puis appliqués au thème du dossier de modules « root ». À faire avant de
-- charger les modules d'interface : Renderer, Canvas, DetecteurPanel… recopient des valeurs du thème
-- quand ils sont chargés. Renvoie true si c'est fait.
local settingsHost = {
	plugin = plugin,
	getSetting = getSetting,
	setSetting = setSetting,
	sessionStart = SESSION_START,
}

local function applySettings(root)
	local inst = root:FindFirstChild("Reglages")
	if inst == nil or not inst:IsA("ModuleScript") then
		return false
	end
	local okModule, Reglages = pcall(require, inst)
	if not okModule or type(Reglages) ~= "table" then
		warn("[Blocs FR] Paramètres indisponibles : " .. tostring(Reglages))
		return false
	end
	local ok, err = pcall(function()
		if type(Reglages.init) == "function" then
			Reglages.init(settingsHost)
		else
			Reglages.applyToTheme(Reglages.load(settingsHost))
		end
	end)
	if not ok then
		warn("[Blocs FR] Paramètres : " .. tostring(err))
	end
	return ok
end

-- Charge chaque module séparément pour signaler toutes les erreurs d'un coup (développement)
local function precheck(folder)
	local failures = 0
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("ModuleScript") then
			local ok, err = pcall(require, child)
			if not ok then
				failures += 1
				warn("[Blocs FR][dev] Erreur dans le module " .. child.Name .. " : " .. tostring(err))
			end
		end
	end
	print("[Blocs FR][dev] Modules chargés, erreurs : " .. failures)
	return failures
end

applySettings(script)
if isDev then
	precheck(script)
end

-- Version du plugin : MiseAJour.VERSION (seule source), sinon DEFAULT_VERSION
local function readVersion()
	local inst = script:FindFirstChild("MiseAJour")
	if inst ~= nil and inst:IsA("ModuleScript") then
		local ok, MiseAJour = pcall(require, inst)
		if ok and type(MiseAJour) == "table" then
			local version = MiseAJour.VERSION
			if (type(version) == "string" and version ~= "") or type(version) == "number" then
				return tostring(version)
			end
		end
	end
	return DEFAULT_VERSION
end

local VERSION = readVersion()

local Theme = req("Theme")

-- Icône des boutons : le logo importé sur Roblox (sinon le logo de l'éditeur, sinon aucune)
local ICON = ""
if type(Theme.ToolbarIconId) == "string" and Theme.ToolbarIconId ~= "" then
	ICON = Theme.ToolbarIconId
elseif type(Theme.LogoAssetId) == "string" then
	ICON = Theme.LogoAssetId
end

local toolbar = plugin:CreateToolbar("Blocs FR")
local editorButton = toolbar:CreateButton(
	"BlocsFR_Ouvrir",
	"Ouvrir l'éditeur de scripts en blocs (en français)",
	ICON,
	"Éditeur de blocs"
)
editorButton.ClickableWhenViewportHidden = true
local wikiButton = toolbar:CreateButton(
	"BlocsFR_Wiki",
	"Ouvrir le wiki de Blocs FR : tutoriels, exemples et explication de chaque bloc",
	ICON,
	"Wiki"
)
wikiButton.ClickableWhenViewportHidden = true
local interfaceButton = toolbar:CreateButton(
	"BlocsFR_Interface",
	"Ouvrir le Studio d'interface : dessine les écrans de ton jeu (menus, boutons, barres de vie…) et mets leurs blocs juste en dessous",
	ICON,
	"Interface"
)
interfaceButton.ClickableWhenViewportHidden = true

---------------------------------------------------------------------------
-- Fenêtre de l'éditeur
---------------------------------------------------------------------------

local editorInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float, -- fenêtre flottante au premier lancement
	false, -- ne pas l'ouvrir automatiquement
	false, -- Studio restaure l'état de la session précédente
	1150, -- largeur par défaut
	720, -- hauteur par défaut
	760, -- largeur minimale
	460 -- hauteur minimale
)

local editorWidget = plugin:CreateDockWidgetPluginGui("BlocsFR_Editeur", editorInfo)
editorWidget.Name = "BlocsFR"
editorWidget.Title = "Blocs FR — scripts en blocs"
editorWidget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local connections = {}
local app = nil
local editorRoot = nil
local appWorkspace = "blocs" -- onglet affiché par l'éditeur (bouton « Interface » de la barre d'outils)
local splashShown = false -- écran d'ouverture : la première fois que l'éditeur s'ouvre dans cette session
local rebuilding = false

local wikiWidget = nil
local wikiRoot = nil
local wiki = nil
local wikiFailed = false

local devStop = nil
local reloadStop = nil

-- définis plus bas (utilisés par le wiki, l'éditeur et les outils de développement)
local ensureApp
local rebuildApp
local startDevBridge

local function makeRoot(parent)
	local frame = Instance.new("Frame")
	frame.Name = "Racine"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Theme.Colors.Background
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Parent = parent
	return frame
end

-- Boutons de la barre d'outils « enfoncés » : l'éditeur ouvert ; « Interface » quand son onglet est affiché
local function updateButtons()
	local open = editorWidget.Enabled
	editorButton:SetActive(open)
	interfaceButton:SetActive(open and app ~= nil and appWorkspace == "interface")
end

---------------------------------------------------------------------------
-- Fenêtre du wiki (créée à la première ouverture)
---------------------------------------------------------------------------

local function ensureWikiWidget()
	if wikiWidget then
		return wikiWidget
	end
	local info = DockWidgetPluginGuiInfo.new(
		Enum.InitialDockState.Float,
		false, -- fermée à la création : on l'ouvre nous-mêmes
		true, -- ignore l'état mémorisé (la fenêtre n'existe qu'après un clic)
		900,
		660,
		600,
		420
	)
	local okCreate, widget = pcall(function()
		return plugin:CreateDockWidgetPluginGui("BlocsFR_Wiki", info)
	end)
	if not okCreate or widget == nil then
		warn("[Blocs FR] Impossible de créer la fenêtre du wiki : " .. tostring(widget))
		return nil
	end
	widget.Name = "BlocsFR_Wiki"
	widget.Title = "Wiki Blocs FR"
	widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	wikiWidget = widget
	table.insert(connections, widget:GetPropertyChangedSignal("Enabled"):Connect(function()
		wikiButton:SetActive(widget.Enabled)
	end))
	return widget
end

-- Crée le wiki (contenu de la fenêtre) si besoin ; renvoie wiki ou nil
local function ensureWiki()
	if wiki then
		return wiki
	end
	if wikiFailed then
		return nil
	end
	local widget = ensureWikiWidget()
	if widget == nil then
		return nil
	end
	if moduleRoot:FindFirstChild("Wiki") == nil then
		wikiFailed = true
		warn("[Blocs FR] Module Wiki introuvable : le wiki n'est pas disponible.")
		return nil
	end
	local okModule, Wiki = pcall(req, "Wiki")
	if not okModule or type(Wiki) ~= "table" or type(Wiki.new) ~= "function" then
		wikiFailed = true
		warn("[Blocs FR] Impossible de charger le wiki : " .. tostring(Wiki))
		return nil
	end

	wikiRoot = makeRoot(widget)
	local wikiHost = {
		root = wikiRoot,
		plugin = plugin,
		widget = widget,
		version = VERSION,
		sessionStart = SESSION_START,
		getMousePosition = function()
			return widget:GetRelativeMousePosition()
		end,
		getSetting = getSetting,
		setSetting = setSetting,
		openEditor = function()
			editorWidget.Enabled = true
			return ensureApp() ~= nil
		end,
	}
	local okWiki, result = pcall(Wiki.new, wikiRoot, {
		host = wikiHost,
		onLoadExample = function(exampleId)
			editorWidget.Enabled = true
			local editor = ensureApp()
			if editor == nil then
				warn("[Blocs FR] L'éditeur n'a pas pu s'ouvrir pour charger l'exemple.")
				return
			end
			local okLoad, err = pcall(function()
				editor:loadExample(exampleId)
			end)
			if not okLoad then
				warn("[Blocs FR] Chargement de l'exemple « " .. tostring(exampleId) .. " » : " .. tostring(err))
			end
		end,
	})
	if not okWiki or type(result) ~= "table" then
		wikiFailed = true
		warn("[Blocs FR] Erreur au démarrage du wiki : " .. tostring(result))
		wikiRoot:Destroy()
		wikiRoot = nil
		return nil
	end
	wiki = result
	return wiki
end

-- Ouvre la fenêtre du wiki : fiche du bloc defId, sinon page pageId (nil = accueil).
-- Renvoie true si le wiki est affiché.
local function openWiki(pageId, defId)
	local widget = ensureWikiWidget()
	if widget == nil then
		return false
	end
	widget.Enabled = true
	local w = ensureWiki()
	if w == nil then
		widget.Enabled = false -- pas de fenêtre vide : l'erreur est dans la sortie
		return false
	end
	local ok, err = pcall(function()
		if defId ~= nil then
			w:openBlock(defId)
		else
			w:open(pageId)
		end
	end)
	if not ok then
		warn("[Blocs FR] Wiki : " .. tostring(err))
	end
	return true
end

-- Page affichée par le wiki ({ page } ou { block }), pour la rouvrir après une reconstruction
local function wikiLocation()
	if wiki == nil then
		return nil
	end
	local current = nil
	pcall(function()
		current = wiki.current
	end)
	if type(current) ~= "table" or current.query ~= nil then
		return nil
	end
	if type(current.block) == "string" then
		return { block = current.block }
	end
	if type(current.page) == "string" then
		return { page = current.page }
	end
	return nil
end

---------------------------------------------------------------------------
-- Éditeur
---------------------------------------------------------------------------

-- Crée l'éditeur s'il n'existe pas. state (facultatif) = app:exportState() d'un éditeur précédent.
ensureApp = function(state)
	if app then
		return app
	end
	local okModule, App = pcall(req, "App")
	if not okModule or type(App) ~= "table" or type(App.new) ~= "function" then
		warn("[Blocs FR] Impossible de charger l'éditeur : " .. tostring(App))
		return nil
	end
	editorRoot = makeRoot(editorWidget)
	local host = {
		root = editorRoot,
		plugin = plugin,
		widget = editorWidget,
		version = VERSION,
		sessionStart = SESSION_START,
		-- écran d'ouverture (Anim.splash) : seulement la première fois dans cette session de Studio
		showSplash = not splashShown and type(state) ~= "table",
		getMousePosition = function()
			return editorWidget:GetRelativeMousePosition()
		end,
		openWiki = openWiki,
		getSetting = getSetting,
		setSetting = setSetting,
		-- « Paramètres › Appliquer » : éditeur reconstruit en gardant les projets ouverts
		rebuildApp = function()
			return rebuildApp()
		end,
		-- l'éditeur a changé d'onglet (« Blocs » / « Interface ») : bouton « Interface » de la barre d'outils
		onWorkspaceChanged = function(name)
			if name == "interface" then
				appWorkspace = "interface"
			else
				appWorkspace = "blocs"
			end
			updateButtons()
		end,
	}
	local okApp, result = pcall(App.new, host, state)
	if not okApp or type(result) ~= "table" then
		warn("[Blocs FR] Erreur au démarrage de l'éditeur : " .. tostring(result))
		editorRoot:Destroy()
		editorRoot = nil
		return nil
	end
	splashShown = true
	app = result
	if type(app.getWorkspace) == "function" then
		local okWorkspace, name = pcall(app.getWorkspace, app)
		if okWorkspace and name == "interface" then
			appWorkspace = "interface"
		else
			appWorkspace = "blocs"
		end
	end
	updateButtons()
	return app
end

-- Ferme l'éditeur (contenu de la fenêtre ; la fenêtre reste)
local function closeEditor()
	if app then
		local old = app
		app = nil
		pcall(function()
			old:destroy()
		end)
	end
	if editorRoot then
		local frame = editorRoot
		editorRoot = nil
		pcall(function()
			frame:Destroy()
		end)
	end
end

-- Ferme le wiki (contenu de la fenêtre ; la fenêtre reste)
local function closeWiki()
	if wiki then
		local old = wiki
		wiki = nil
		pcall(function()
			old:destroy()
		end)
	end
	if wikiRoot then
		local frame = wikiRoot
		wikiRoot = nil
		pcall(function()
			frame:Destroy()
		end)
	end
end

-- Ferme l'éditeur et le wiki (contenu des fenêtres ; les fenêtres restent)
local function closeContents()
	closeEditor()
	closeWiki()
end

-- Copie des ModuleScripts du dossier actuel dans un nouveau dossier (hors du DataModel), ou nil
local function cloneModules()
	local ok, folder = pcall(function()
		local copy = Instance.new("Folder")
		copy.Name = "BlocsFR_Modules"
		for _, child in ipairs(moduleRoot:GetChildren()) do
			if child:IsA("ModuleScript") then
				local clone = child:Clone()
				clone.Parent = copy
			end
		end
		return copy
	end)
	if not ok or typeof(folder) ~= "Instance" then
		warn("[Blocs FR] Copie des modules impossible : " .. tostring(folder))
		return nil
	end
	if folder:FindFirstChild("App") == nil or folder:FindFirstChild("Theme") == nil then
		pcall(function()
			folder:Destroy()
		end)
		return nil
	end
	return folder
end

-- host.rebuildApp() : détruit l'éditeur et en construit un nouveau (modules frais, paramètres appliqués)
-- en gardant les projets, les cibles, l'onglet et l'écran ouvert. Renvoie true si l'éditeur est prêt.
rebuildApp = function()
	if rebuilding or app == nil then
		return false
	end
	rebuilding = true
	local ok, result = pcall(function()
		local old = app
		local state = nil
		local okState, exported = pcall(function()
			return old:exportState()
		end)
		if okState and type(exported) == "table" then
			state = exported
		else
			warn("[Blocs FR] L'état de l'éditeur n'a pas pu être gardé : " .. tostring(exported))
		end
		local wikiPlace = wikiLocation()
		local hadWiki = wiki ~= nil
		local wikiOpen = wikiWidget ~= nil and wikiWidget.Enabled

		-- Modules frais : les valeurs du thème recopiées à leur chargement suivent les paramètres
		local previousRoot, previousTheme = moduleRoot, Theme
		local fresh = cloneModules()
		-- (l'ancien éditeur écrit ici le brouillon de ses projets non enregistrés)
		closeEditor()
		if fresh ~= nil then
			local okTheme, newTheme = pcall(require, fresh:FindFirstChild("Theme"))
			if okTheme and type(newTheme) == "table" then
				moduleRoot = fresh
				Theme = newTheme
				applySettings(fresh)
			else
				warn("[Blocs FR] Rechargement du thème impossible : " .. tostring(newTheme))
			end
		end

		local newApp = ensureApp(state)
		if newApp == nil and moduleRoot ~= previousRoot then
			warn("[Blocs FR] L'éditeur repart avec les modules d'avant (les nouveaux n'ont pas démarré).")
			moduleRoot = previousRoot
			Theme = previousTheme
			newApp = ensureApp(state)
		end
		if newApp == nil and state ~= nil then
			-- dernier recours : un éditeur neuf (les projets non enregistrés sont dans les brouillons)
			newApp = ensureApp(nil)
		end

		if moduleRoot ~= previousRoot then
			-- Wiki : refait avec les nouvelles couleurs, sur la même page
			if hadWiki then
				closeWiki()
				wikiFailed = false
				if wikiOpen then
					if wikiPlace ~= nil then
						openWiki(wikiPlace.page, wikiPlace.block)
					else
						openWiki(nil, nil)
					end
				end
			end
			-- Pont de test : avec les nouveaux modules
			if isDev and devStop ~= nil then
				pcall(devStop)
				devStop = nil
				startDevBridge()
			end
		end
		return newApp ~= nil
	end)
	rebuilding = false
	if not ok then
		warn("[Blocs FR] Reconstruction de l'éditeur : " .. tostring(result))
		if app == nil and editorWidget.Enabled then
			ensureApp(nil)
		end
		return false
	end
	return result == true
end

table.insert(connections, editorButton.Click:Connect(function()
	editorWidget.Enabled = not editorWidget.Enabled
end))

table.insert(connections, wikiButton.Click:Connect(function()
	if wikiWidget ~= nil and wikiWidget.Enabled then
		wikiWidget.Enabled = false
		return
	end
	openWiki(nil, nil)
end))

-- « Interface » : ouvre l'éditeur sur l'onglet Interface (le referme s'il y est déjà)
table.insert(connections, interfaceButton.Click:Connect(function()
	if editorWidget.Enabled and app ~= nil and appWorkspace == "interface" then
		editorWidget.Enabled = false
		return
	end
	editorWidget.Enabled = true
	local current = ensureApp()
	if current == nil then
		updateButtons()
		return
	end
	if type(current.setWorkspace) == "function" then
		local ok, err = pcall(current.setWorkspace, current, "interface")
		if not ok then
			warn("[Blocs FR] Onglet Interface : " .. tostring(err))
		end
	end
	updateButtons()
end))

table.insert(connections, editorWidget:GetPropertyChangedSignal("Enabled"):Connect(function()
	if editorWidget.Enabled then
		ensureApp()
	end
	updateButtons()
end))

if editorWidget.Enabled then
	ensureApp()
end
updateButtons()
wikiButton:SetActive(false)

---------------------------------------------------------------------------
-- Outils de développement (uniquement dans les versions --dev)
---------------------------------------------------------------------------

startDevBridge = function()
	if moduleRoot:FindFirstChild("DevBridge") == nil then
		warn("[Blocs FR][dev] DevBridge introuvable dans " .. moduleRoot.Name)
		return
	end
	local ok, DevBridge = pcall(req, "DevBridge")
	if not ok or type(DevBridge) ~= "table" or type(DevBridge.start) ~= "function" then
		warn("[Blocs FR][dev] DevBridge introuvable : " .. tostring(DevBridge))
		return
	end
	local okStart, stop = pcall(DevBridge.start, {
		getApp = function()
			return app
		end,
		openEditor = function()
			editorWidget.Enabled = true
			return ensureApp() ~= nil
		end,
		openWiki = function(pageId, defId)
			return openWiki(pageId, defId)
		end,
		getWiki = function()
			return wiki
		end,
		rebuildApp = function()
			return rebuildApp()
		end,
		plugin = plugin,
		widget = editorWidget,
		version = VERSION,
	})
	if okStart and type(stop) == "function" then
		devStop = stop
	else
		warn("[Blocs FR][dev] DevBridge.start a échoué : " .. tostring(stop))
	end
end

-- DevReload : remplace les modules par ceux du dossier téléchargé, puis rouvre les fenêtres.
-- Renvoie ok, erreur.
local function swapModules(folder)
	if typeof(folder) ~= "Instance" then
		return false, "dossier de modules invalide"
	end
	if folder:FindFirstChild("App") == nil or folder:FindFirstChild("Theme") == nil then
		return false, "dossier de modules incomplet (App ou Theme manquant)"
	end
	local okTheme, newTheme = pcall(require, folder:FindFirstChild("Theme"))
	if not okTheme or type(newTheme) ~= "table" then
		return false, "Theme : " .. tostring(newTheme)
	end
	-- paramètres appliqués au nouveau thème avant que les autres modules ne le lisent
	applySettings(folder)
	local failures = precheck(folder)
	local editorWasOpen = editorWidget.Enabled
	local wikiWasOpen = wikiWidget ~= nil and wikiWidget.Enabled
	closeContents()
	if devStop then
		pcall(devStop)
		devStop = nil
	end
	moduleRoot = folder
	Theme = newTheme
	wikiFailed = false
	startDevBridge()
	if editorWasOpen and ensureApp() == nil then
		return false, "l'éditeur n'a pas redémarré (" .. failures .. " module(s) en erreur, voir la sortie)"
	end
	if wikiWasOpen then
		ensureWiki()
	end
	return true, nil
end

if isDev then
	startDevBridge()
	if script:FindFirstChild("DevReload") ~= nil then
		local ok, DevReload = pcall(req, "DevReload")
		if ok and type(DevReload) == "table" and type(DevReload.start) == "function" then
			local okStart, stop = pcall(DevReload.start, { swap = swapModules })
			if okStart and type(stop) == "function" then
				reloadStop = stop
			else
				warn("[Blocs FR][dev] DevReload.start a échoué : " .. tostring(stop))
			end
		else
			warn("[Blocs FR][dev] DevReload introuvable : " .. tostring(DevReload))
		end
	end
end

---------------------------------------------------------------------------
-- Déchargement du plugin
---------------------------------------------------------------------------
plugin.Unloading:Connect(function()
	if reloadStop then
		pcall(reloadStop)
		reloadStop = nil
	end
	if devStop then
		pcall(devStop)
		devStop = nil
	end
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	connections = {}
	closeContents()
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Anim</string><ProtectedString name="Source"><![CDATA[-- Anim : petit moteur d'animations de l'éditeur Blocs FR (SPEC §24, planche « Animations de l'éditeur »).
--
-- Un seul RunService.Heartbeat, connecté seulement pendant qu'une animation tourne (pas de TweenService :
-- on ne compte pas sur lui en mode édition). Valeurs animables : nombre, Color3, UDim2, UDim, Vector2.
-- Courbes : "linear", "quadOut", "quadIn", "quintOut", "backOut", "sineInOut" (ou une fonction t -> k).
--
-- Règles :
--   * une nouvelle animation d'une propriété d'une instance remplace celle qui tournait (l'ancienne
--     s'arrête là où elle en est, sans appeler son onDone) ;
--   * une instance détruite ne provoque jamais d'erreur (chaque écriture est protégée par pcall) ;
--   * animations désactivées (menu « ? ») : l'état final est appliqué tout de suite, puis onDone ;
--   * garde-fou : au-delà de MAX_ACTIVE animations en même temps, les nouvelles sautent à l'état final ;
--   * les boucles (pulse, hop) s'arrêtent seules quand leur instance est détruite.
-- Anim peut être utilisé avant Anim.init (animations activées par défaut).
--
-- API (SPEC §24) :
--   Anim.init(host) ; Anim.enabled() -> bool ; Anim.setEnabled(bool)   (réglage « BlocsFR_Animations »)
--   Anim.tween(inst, props, duration, easing?, onDone?, delay?) -> handle  (handle:cancel(), :finish(), :isPlaying())
--   Anim.hover(button, normalColor, hoverColor) -> disconnectFn   (BackgroundColor3, 0,12 s quadOut)
--   Anim.press(button) -> disconnectFn                           (UIScale 0,94 à l'appui, 1,03 -> 1 au relâcher)
--   Anim.popIn(frame, fromScale?)                                (UIScale 0,92 -> 1, 0,14 s backOut)
--   Anim.slideIn(frame, fromOffset, duration?, delay?) ; Anim.slideOut(frame, toOffset, duration?, onDone?)
--   Anim.fadeIn(obj, duration?, delay?) ; Anim.fadeOut(obj, duration?, onDone?)  (lui + 60 descendants au plus)
--   Anim.stagger(objects, step?, fromOffset?, coverColor?)      (70 ms, -16 px, 0,22 s, 14 premiers ;
--     fromOffset = décalage horizontal (nombre) ou Vector2 ; coverColor = voile de cette couleur qui
--     s'efface au lieu d'un fondu, pour les objets faits de cadres superposés comme les blocs)
--   Anim.flash(frame, onDone?) ; Anim.poof(layer, screenPos, color) ; Anim.shake(frame)
--   Anim.pulse(target, low?, high?, period?) -> stopFn ; Anim.hop(obj, height?, period?) -> stopFn
--   Anim.lift(frame, on) ; Anim.countTo(label, from, to, duration?, formatFn?) ; Anim.splash(root, onDone?)
-- Extensions : Anim.step(fn(k, a), duration, easing?, onDone?, key?, delay?) -> handle (animation libre ;
--   une nouvelle animation avec la même clé remplace la précédente), Anim.stopAll() (tout finit tout de
--   suite), Anim.activeCount(), Anim.isInitialized(), Anim.factor() (vitesse des réglages),
--   Anim.scaled(secondes) -> secondes × facteur (pour caler un task.delay sur une animation).
--
-- Vitesse (SPEC §31) : toutes les durées, tous les délais et toutes les périodes des boucles sont
-- multipliés par Theme.Anim.Facteur (1 par défaut ; « lente » 1,5, « rapide » 0,6, écrit par Reglages),
-- lu à chaque nouvelle animation.
--
-- NOTE: les effets d'échelle utilisent un UIScale nommé « AnimEchelle » ; si l'objet a déjà un autre
-- UIScale (zoom du canvas, réduction d'un bloc), on n'y touche pas et l'effet d'échelle est ignoré.
-- NOTE: stagger dans un parent qui a un UIListLayout / UIGridLayout : fondu seulement (pas de glissement,
-- la disposition impose la position).
-- NOTE: les rappels onDone / onCancel tournent dans leur propre thread, protégés par pcall (une erreur
-- est signalée une fois dans la sortie avec warn, sans casser le moteur).

local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Theme)
local Logo = require(script.Parent.Logo)

local Anim = {}

local SETTING = "BlocsFR_Animations"
local MAX_ACTIVE = 64 -- animations simultanées au plus (au-delà : état final tout de suite)
local MAX_FADE_DESCENDANTS = 60
local STAGGER_MAX = 14
local SCALE_NAME = "AnimEchelle"
local MAX_DT = 1 / 20 -- après un ralentissement, l'animation reprend au lieu de sauter à la fin
local WHITE = Color3.fromRGB(255, 255, 255)

local DURATIONS = Theme.Anim or {}
local FAST = DURATIONS.Fast or 0.12
local NORMAL = DURATIONS.Normal or 0.22
local FACTOR_MIN, FACTOR_MAX = 0.25, 4
local MAX_REPORTED = 40 -- messages d'erreur différents signalés au plus

local enabled = true
local initialized = false
local hostRef = nil

local records = {} -- animations en cours
local owners = setmetatable({}, { __mode = "k" }) -- [objet] = { [propriété] = animation }
local fades = setmetatable({}, { __mode = "k" }) -- [objet] = fondu en cours { entries = { {inst, prop, origine} } }
local slides = setmetatable({}, { __mode = "k" }) -- [cadre] = glissement en cours { home = UDim2 }
local shakes = setmetatable({}, { __mode = "k" }) -- [cadre] = position de repos pendant une secousse
local heartbeat = nil
local reported = {}
local reportedCount = 0

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local function report(err)
	local text = tostring(err)
	if reported[text] or reportedCount >= MAX_REPORTED then
		return
	end
	reported[text] = true
	reportedCount += 1
	warn("[Blocs FR] Animation : " .. text)
end

-- Vitesse des animations (réglage « Animations › vitesse ») : Theme.Anim.Facteur, 1 par défaut.
-- Lu à chaque nouvelle animation : Reglages peut le changer à tout moment.
local function speedFactor()
	local anim = Theme.Anim
	local f = nil
	if type(anim) == "table" then
		f = tonumber(anim.Facteur)
	end
	if f == nil or f ~= f then
		return 1
	end
	if f < FACTOR_MIN then
		return FACTOR_MIN
	elseif f > FACTOR_MAX then
		return FACTOR_MAX
	end
	return f
end

-- Appelle un rappel dans son propre thread, protégé : une erreur ne casse jamais le moteur
local function callDone(fn)
	if type(fn) == "function" then
		task.spawn(function()
			local ok, err = pcall(fn)
			if not ok then
				report(err)
			end
		end)
	end
end

local function assign(inst, prop, value)
	inst[prop] = value
end

local function read(inst, prop)
	return inst[prop]
end

local function trySet(inst, prop, value)
	return (pcall(assign, inst, prop, value))
end

local function tryGet(inst, prop)
	local ok, value = pcall(read, inst, prop)
	if ok then
		return value
	end
	return nil
end

local function isGui(obj)
	return typeof(obj) == "Instance" and obj:IsA("GuiObject")
end

local function noop() end

---------------------------------------------------------------------------
-- Courbes et interpolation
---------------------------------------------------------------------------

local function quadOut(t)
	return 1 - (1 - t) * (1 - t)
end

local EASINGS = {
	linear = function(t)
		return t
	end,
	quadOut = quadOut,
	quadIn = function(t)
		return t * t
	end,
	quintOut = function(t)
		local u = 1 - t
		return 1 - u * u * u * u * u
	end,
	backOut = function(t)
		local c1 = 1.70158
		local u = t - 1
		return 1 + (c1 + 1) * u * u * u + c1 * u * u
	end,
	sineInOut = function(t)
		return (1 - math.cos(math.pi * t)) / 2
	end,
}

local function easingOf(easing)
	if type(easing) == "function" then
		return easing
	end
	return EASINGS[easing] or quadOut
end

local function lerp(a, b, k)
	local kind = typeof(a)
	if kind ~= typeof(b) then
		if k >= 1 then
			return b
		end
		return a
	end
	if kind == "number" then
		return a + (b - a) * k
	elseif kind == "Color3" then
		return a:Lerp(b, k)
	elseif kind == "UDim2" then
		return UDim2.new(
			a.X.Scale + (b.X.Scale - a.X.Scale) * k,
			a.X.Offset + (b.X.Offset - a.X.Offset) * k,
			a.Y.Scale + (b.Y.Scale - a.Y.Scale) * k,
			a.Y.Offset + (b.Y.Offset - a.Y.Offset) * k
		)
	elseif kind == "UDim" then
		return UDim.new(a.Scale + (b.Scale - a.Scale) * k, a.Offset + (b.Offset - a.Offset) * k)
	elseif kind == "Vector2" then
		return Vector2.new(a.X + (b.X - a.X) * k, a.Y + (b.Y - a.Y) * k)
	end
	if k >= 1 then
		return b
	end
	return a
end

---------------------------------------------------------------------------
-- Moteur
---------------------------------------------------------------------------
-- animation = { props = { [prop] = { to, from } } | fn = function(k, a), inst, count, keys,
--               duration, ease, elapsed (négatif pendant le délai), loop (période) | nil,
--               onStart, onDone, onCancel, watch, seen, started, done, notified, cancelled }

local function release(r)
	local keys = r.keys
	r.keys = {}
	for _, key in ipairs(keys) do
		local map = owners[key[1]]
		if map ~= nil and map[key[2]] == r then
			map[key[2]] = nil
		end
	end
end

local function cancelRecord(r)
	if r.cancelled or r.done then
		return
	end
	r.cancelled = true
	release(r)
	callDone(r.onCancel)
end

-- r devient le propriétaire de (owner, prop) : l'animation précédente perd cette propriété
local function claim(r, owner, prop)
	local map = owners[owner]
	if map == nil then
		map = {}
		owners[owner] = map
	end
	local old = map[prop]
	if old ~= nil and old ~= r then
		map[prop] = nil
		if old.props ~= nil and old.props[prop] ~= nil then
			old.props[prop] = nil
			old.count -= 1
			if old.count <= 0 then
				cancelRecord(old)
			end
		else
			cancelRecord(old)
		end
	end
	map[prop] = r
	table.insert(r.keys, { owner, prop })
end

-- Durée et délai multipliés par la vitesse des réglages (une durée nulle reste instantanée)
local function newRecord(duration, easing, delay)
	local f = speedFactor()
	return {
		keys = {},
		count = 0,
		duration = math.max(0, tonumber(duration) or NORMAL) * f,
		ease = easingOf(easing),
		elapsed = -math.max(0, tonumber(delay) or 0) * f,
		started = false,
		done = false,
		notified = false,
		cancelled = false,
	}
end

-- Valeurs de départ lues au début de l'animation (après son délai)
local function capture(r)
	if r.props ~= nil then
		for prop, p in pairs(r.props) do
			p.from = tryGet(r.inst, prop)
		end
	end
	if r.onStart ~= nil then
		local ok, err = pcall(r.onStart)
		if not ok then
			report(err)
		end
	end
end

-- Applique l'avancement a (0..1) ; renvoie false si l'animation libre a échoué
local function apply(r, a)
	local k = 1
	if a < 1 then
		k = r.ease(a)
	end
	if r.props ~= nil then
		local inst = r.inst
		for prop, p in pairs(r.props) do
			if a >= 1 or p.from == nil then
				trySet(inst, prop, p.to)
			else
				trySet(inst, prop, lerp(p.from, p.to, k))
			end
		end
	elseif r.fn ~= nil then
		local ok, err = pcall(r.fn, k, a)
		if not ok then
			report(err)
			return false
		end
	end
	return true
end

-- Termine une animation tout de suite (état final + onDone) ; une boucle est simplement arrêtée
local function finishNow(r)
	if r.cancelled then
		return
	end
	if r.done then
		if not r.notified then
			r.notified = true
			release(r)
			callDone(r.onDone)
		end
		return
	end
	if r.loop then
		cancelRecord(r)
		return
	end
	if not r.started then
		r.started = true
		capture(r)
	end
	apply(r, 1)
	r.done = true
	r.notified = true
	release(r)
	callDone(r.onDone)
end

local function stepAll(dt)
	if type(dt) ~= "number" or dt < 0 then
		dt = 0
	elseif dt > MAX_DT then
		dt = MAX_DT
	end
	local list = records
	local n = #list
	for i = 1, n do
		local r = list[i]
		if r ~= nil and not r.done and not r.cancelled then
			r.elapsed += dt
			if r.elapsed >= 0 then
				if not r.started then
					r.started = true
					capture(r)
				end
				local a
				if r.loop then
					a = (r.elapsed % r.loop) / r.loop
				elseif r.duration <= 0 then
					a = 1
				else
					a = math.min(1, r.elapsed / r.duration)
				end
				if not apply(r, a) then
					cancelRecord(r)
				elseif r.loop then
					-- une boucle s'arrête quand son instance est détruite (Parent = nil)
					local watched = r.watch
					if watched ~= nil then
						if watched.Parent ~= nil then
							r.seen = true
						elseif r.seen or r.elapsed > 2 then
							cancelRecord(r)
						end
					end
				elseif a >= 1 then
					r.done = true
				end
			end
		end
	end
	local kept = {}
	local finished = {}
	for _, r in ipairs(records) do
		if r.done then
			if not r.notified then
				r.notified = true
				table.insert(finished, r)
			end
		elseif not r.cancelled then
			table.insert(kept, r)
		end
	end
	records = kept
	for _, r in ipairs(finished) do
		release(r)
		callDone(r.onDone)
	end
	if #records == 0 and heartbeat ~= nil then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

local function finishAll()
	local list = records
	records = {}
	if heartbeat ~= nil then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	for _, r in ipairs(list) do
		local ok, err = pcall(finishNow, r)
		if not ok then
			report(err)
		end
	end
end

local function ensureRunning()
	if heartbeat ~= nil then
		return
	end
	heartbeat = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepAll, dt)
		if not ok then
			report(err)
			pcall(finishAll)
		end
	end)
end

local function addRecord(r)
	table.insert(records, r)
	ensureRunning()
end

-- Démarre une animation (ou applique tout de suite son état final si désactivé / trop d'animations /
-- durée nulle sans délai)
local function launch(r)
	local instant = r.duration <= 0 and r.elapsed >= 0 and not r.loop
	if not enabled or instant or #records >= MAX_ACTIVE then
		finishNow(r)
		return false
	end
	addRecord(r)
	return true
end

---------------------------------------------------------------------------
-- Poignées
---------------------------------------------------------------------------

local Handle = {}
Handle.__index = Handle

local function handleOf(r)
	return setmetatable({ _r = r }, Handle)
end

-- Arrête l'animation là où elle en est (onDone n'est pas appelé)
function Handle:cancel()
	local r = self._r
	self._r = nil
	if r ~= nil then
		cancelRecord(r)
	end
end

-- Termine l'animation tout de suite (état final, puis onDone)
function Handle:finish()
	local r = self._r
	self._r = nil
	if r ~= nil then
		finishNow(r)
	end
end

function Handle:isPlaying()
	local r = self._r
	return r ~= nil and not r.done and not r.cancelled
end

---------------------------------------------------------------------------
-- Animations de propriétés et animations libres
---------------------------------------------------------------------------

local function startTween(inst, props, duration, easing, onDone, delay, onCancel)
	local r = newRecord(duration, easing, delay)
	r.inst = inst
	r.props = {}
	r.onDone = onDone
	r.onCancel = onCancel
	local map = owners[inst]
	for prop, value in pairs(props) do
		-- valeur déjà atteinte et rien ne l'anime : inutile de créer une animation
		local running = map ~= nil and map[prop] ~= nil
		if running or r.elapsed < 0 or tryGet(inst, prop) ~= value then
			r.props[prop] = { to = value }
			r.count += 1
		end
	end
	if r.count == 0 then
		r.done = true
		r.notified = true
		callDone(onDone)
		return handleOf(nil)
	end
	for prop in pairs(r.props) do
		claim(r, inst, prop)
	end
	launch(r)
	return handleOf(r)
end

local function startStep(fn, duration, easing, onDone, key, delay, onCancel)
	local r = newRecord(duration, easing, delay)
	r.fn = fn
	r.onDone = onDone
	r.onCancel = onCancel
	if key ~= nil then
		claim(r, key, "__step")
	end
	launch(r)
	return handleOf(r)
end

-- Valeur de repos d'une propriété : celle gardée par une boucle qui tourne déjà dessus, sinon l'actuelle
local function restingValue(target, prop)
	local map = owners[target]
	local running = map ~= nil and map[prop] or nil
	if running ~= nil and running.loop and running.restoreValue ~= nil then
		return running.restoreValue
	end
	return tryGet(target, prop)
end

-- Boucle infinie (pulse, hop) ; renvoie la fonction qui l'arrête (et remet restoreValue)
local function startLoop(target, prop, period, fn, restoreValue)
	local r = newRecord(0, "linear", 0)
	r.loop = math.max(0.2, (tonumber(period) or 1.4) * speedFactor())
	r.watch = target
	r.restoreValue = restoreValue
	r.fn = fn
	r.onCancel = function()
		if restoreValue ~= nil then
			trySet(target, prop, restoreValue)
		end
	end
	claim(r, target, prop)
	if not enabled or #records >= MAX_ACTIVE then
		cancelRecord(r)
		return noop
	end
	addRecord(r)
	return function()
		cancelRecord(r)
	end
end

-- UIScale « AnimEchelle » de l'objet (créé si besoin) ; nil si un autre UIScale existe déjà
local function scaleOf(obj)
	if not isGui(obj) then
		return nil
	end
	local own = obj:FindFirstChild(SCALE_NAME)
	if own ~= nil and own:IsA("UIScale") then
		return own
	end
	if obj:FindFirstChildOfClass("UIScale") ~= nil then
		return nil
	end
	local s = Instance.new("UIScale")
	s.Name = SCALE_NAME
	s.Parent = obj
	return s
end

local function hasLayout(obj)
	return typeof(obj) == "Instance" and obj:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
end

---------------------------------------------------------------------------
-- Fondus
---------------------------------------------------------------------------

-- Propriétés de transparence de obj et de ses descendants (60 au plus) qui ne sont pas déjà invisibles
local function fadeEntries(obj)
	local entries = {}
	local function add(inst)
		if inst:IsA("GuiObject") then
			table.insert(entries, { inst, "BackgroundTransparency" })
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				table.insert(entries, { inst, "TextTransparency" })
			elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
				table.insert(entries, { inst, "ImageTransparency" })
			end
			if inst:IsA("ScrollingFrame") then
				table.insert(entries, { inst, "ScrollBarImageTransparency" })
			end
		elseif inst:IsA("UIStroke") then
			table.insert(entries, { inst, "Transparency" })
		end
	end
	add(obj)
	local count = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if count >= MAX_FADE_DESCENDANTS then
			break
		end
		-- les voiles / éclairs d'autres animations ne font pas partie de l'objet
		if (d:IsA("GuiObject") or d:IsA("UIStroke")) and string.sub(d.Name, 1, 4) ~= "Anim" then
			count += 1
			add(d)
		end
	end
	local kept = {}
	for _, e in ipairs(entries) do
		local value = tryGet(e[1], e[2])
		if type(value) == "number" and value < 1 then
			e[3] = value
			table.insert(kept, e)
		end
	end
	return kept
end

-- Fondu d'un groupe : vers les valeurs d'origine (toOriginal) ou vers 1 ; after() à la fin
local function runFade(obj, st, toOriginal, duration, delay, after)
	local entries = st.entries
	local from = {}
	local r = newRecord(duration, "quadOut", delay)
	r.onStart = function()
		for i, e in ipairs(entries) do
			from[i] = tryGet(e[1], e[2])
		end
	end
	r.fn = function(k)
		for i, e in ipairs(entries) do
			local f = from[i]
			if type(f) == "number" then
				local goal = 1
				if toOriginal then
					goal = e[3]
				end
				trySet(e[1], e[2], f + (goal - f) * k)
			end
		end
	end
	r.onDone = function()
		if fades[obj] == st and st.record == r then
			fades[obj] = nil
		end
		if after ~= nil then
			after()
		end
	end
	st.record = r
	claim(r, obj, "__fade")
	launch(r)
end

local function fadeInImpl(obj, duration, delay)
	if not isGui(obj) then
		return
	end
	local st = fades[obj]
	if st == nil then
		local entries = fadeEntries(obj)
		if #entries == 0 then
			return
		end
		st = { entries = entries }
		fades[obj] = st
		if enabled then
			for _, e in ipairs(entries) do
				trySet(e[1], e[2], 1)
			end
		end
	end
	runFade(obj, st, true, tonumber(duration) or 0.18, delay, nil)
end

local function fadeOutImpl(obj, duration, onDone)
	if not isGui(obj) then
		callDone(onDone)
		return
	end
	local st = fades[obj]
	if st == nil then
		st = { entries = fadeEntries(obj) }
		fades[obj] = st
	end
	runFade(obj, st, false, tonumber(duration) or 0.18, 0, function()
		trySet(obj, "Visible", false)
		if type(onDone) == "function" then
			local ok, err = pcall(onDone)
			if not ok then
				report(err)
			end
		end
		-- valeurs d'origine remises (l'objet est caché) pour le prochain affichage
		for _, e in ipairs(st.entries) do
			trySet(e[1], e[2], e[3])
		end
	end)
end

---------------------------------------------------------------------------
-- Glissements
---------------------------------------------------------------------------

-- État de glissement : la position de repos (« home ») reste celle d'avant le premier glissement
local function slideState(frame)
	local previous = slides[frame]
	local home = frame.Position
	if previous ~= nil then
		home = previous.home
	end
	local st = { home = home }
	slides[frame] = st
	local function clear()
		if slides[frame] == st then
			slides[frame] = nil
		end
	end
	return st, previous, clear
end

local function slideInImpl(frame, fromOffset, duration, delay)
	if not isGui(frame) then
		return
	end
	local off = fromOffset
	if typeof(off) ~= "Vector2" then
		off = Vector2.new(24, 0)
	end
	local st, previous, clear = slideState(frame)
	if enabled and previous == nil then
		frame.Position = st.home + UDim2.fromOffset(off.X, off.Y)
	end
	startTween(frame, { Position = st.home }, tonumber(duration) or 0.25, "quintOut", clear, delay, clear)
end

local function slideOutImpl(frame, toOffset, duration, onDone)
	if not isGui(frame) then
		callDone(onDone)
		return
	end
	local off = toOffset
	if typeof(off) ~= "Vector2" then
		off = Vector2.new(24, 0)
	end
	local st, _, clear = slideState(frame)
	local home = st.home
	startTween(frame, { Position = home + UDim2.fromOffset(off.X, off.Y) }, tonumber(duration) or 0.2, "quadIn", function()
		clear()
		trySet(frame, "Visible", false)
		if type(onDone) == "function" then
			local ok, err = pcall(onDone)
			if not ok then
				report(err)
			end
		end
		trySet(frame, "Position", home)
	end, 0, clear)
end

---------------------------------------------------------------------------
-- Effets composés
---------------------------------------------------------------------------

-- Voile de la couleur du fond posé sur obj puis effacé : l'objet « apparaît » d'un seul bloc
-- (pas d'effet de transparence sur les cadres superposés d'un bloc). Couvre aussi les enfants qui
-- dépassent à droite (étiquette « serveur » d'un bloc de la palette).
local function coverImpl(obj, color, duration, delay)
	local extraW = 0
	if obj.Size.X.Scale == 0 then
		local baseW = obj.Size.X.Offset
		for _, child in ipairs(obj:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible and child.Position.X.Scale == 0 and child.Size.X.Scale == 0 then
				extraW = math.max(extraW, child.Position.X.Offset + child.Size.X.Offset - baseW)
			end
		end
	end
	local veil = Instance.new("Frame")
	veil.Name = "AnimVoile"
	veil.BackgroundColor3 = color
	veil.BackgroundTransparency = 0
	veil.BorderSizePixel = 0
	veil.Active = false
	veil.Position = UDim2.fromOffset(-2, -2)
	veil.Size = UDim2.new(1, 4 + math.max(0, extraW), 1, 4)
	veil.ZIndex = 1000
	veil.Parent = obj
	local function remove()
		pcall(function()
			veil:Destroy()
		end)
	end
	startTween(veil, { BackgroundTransparency = 1 }, duration, "quadOut", remove, delay, remove)
end

local function staggerImpl(objects, step, fromOffset, coverColor)
	if not enabled or type(objects) ~= "table" then
		return
	end
	local gap = tonumber(step) or 0.07
	-- décalage de départ : un nombre (horizontal, -16 par défaut) ou un Vector2
	local offset = Vector2.new(-16, 0)
	if typeof(fromOffset) == "Vector2" then
		offset = fromOffset
	elseif tonumber(fromOffset) ~= nil then
		offset = Vector2.new(tonumber(fromOffset), 0)
	end
	local n = 0
	for _, obj in ipairs(objects) do
		if n >= STAGGER_MAX then
			break
		end
		if isGui(obj) and obj.Parent ~= nil then
			n += 1
			local delay = (n - 1) * gap
			if offset.Magnitude > 0 and not hasLayout(obj.Parent) then
				slideInImpl(obj, offset, NORMAL, delay)
			end
			if typeof(coverColor) == "Color3" and not hasLayout(obj) then
				coverImpl(obj, coverColor, NORMAL, delay)
			else
				fadeInImpl(obj, NORMAL, delay)
			end
		end
	end
end

local function flashImpl(frame, onDone)
	if not enabled or not isGui(frame) then
		callDone(onDone)
		return
	end
	-- l'éclair est un contour blanc ; si le cadre en a déjà un, il va sur un cadre posé par-dessus
	local target = frame
	local overlay = nil
	if frame:FindFirstChildOfClass("UIStroke") ~= nil then
		if hasLayout(frame) then
			target = nil
		else
			overlay = Instance.new("Frame")
			overlay.Name = "AnimEclair"
			overlay.BackgroundTransparency = 1
			overlay.BorderSizePixel = 0
			overlay.Active = false
			overlay.Size = UDim2.fromScale(1, 1)
			overlay.ZIndex = 1000
			local corner = frame:FindFirstChildOfClass("UICorner")
			if corner ~= nil then
				local copy = Instance.new("UICorner")
				copy.CornerRadius = corner.CornerRadius
				copy.Parent = overlay
			end
			overlay.Parent = frame
			target = overlay
		end
	end
	local stroke = nil
	if target ~= nil then
		stroke = Instance.new("UIStroke")
		stroke.Name = "AnimEclair"
		stroke.Color = WHITE
		stroke.Thickness = 3
		stroke.Transparency = 0
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = target
	end
	local ended = false
	local function cleanup()
		if ended then
			return
		end
		ended = true
		if stroke ~= nil then
			pcall(function()
				stroke:Destroy()
			end)
		end
		if overlay ~= nil then
			pcall(function()
				overlay:Destroy()
			end)
		end
		callDone(onDone)
	end
	local s = scaleOf(frame)
	if s ~= nil then
		s.Scale = 1.04
		startTween(s, { Scale = 1 }, 0.25, "quadOut")
	end
	if stroke ~= nil then
		startTween(stroke, { Transparency = 1, Thickness = 8 }, 0.25, "quadOut", cleanup, 0, cleanup)
	else
		cleanup()
	end
end

local POOF_DIRS = { { -26, -30 }, { 30, -24 }, { 34, 22 }, { -30, 26 }, { 4, -38 }, { 2, 38 } }
local POOF_SIZES = { 10, 8, 12, 7, 9, 9 }

local function poofImpl(layer, screenPos, color)
	if not enabled or not isGui(layer) or typeof(screenPos) ~= "Vector2" then
		return
	end
	local base = color
	if typeof(base) ~= "Color3" then
		base = Theme.Colors.Accent
	end
	local light = base:Lerp(WHITE, 0.35)
	local colors = { light, WHITE, base, light, WHITE, base }
	local origin = layer.AbsolutePosition
	local px, py = screenPos.X - origin.X, screenPos.Y - origin.Y
	local parts = {}
	for i = 1, #POOF_DIRS do
		local dot = Instance.new("Frame")
		dot.Name = "AnimConfetti"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BackgroundColor3 = colors[i]
		dot.BorderSizePixel = 0
		dot.Active = false
		dot.Position = UDim2.fromOffset(px, py)
		dot.Size = UDim2.fromOffset(3, 3)
		dot.ZIndex = 5000
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = dot
		dot.Parent = layer
		parts[i] = dot
	end
	local function cleanup()
		for _, dot in ipairs(parts) do
			pcall(function()
				dot:Destroy()
			end)
		end
	end
	local r = newRecord(0.3, "quadOut", 0)
	r.fn = function(k, a)
		for i, dot in ipairs(parts) do
			local d = POOF_DIRS[i]
			local size = POOF_SIZES[i] * (0.3 + 0.7 * k)
			trySet(dot, "Position", UDim2.fromOffset(px + d[1] * k, py + d[2] * k))
			trySet(dot, "Size", UDim2.fromOffset(size, size))
			trySet(dot, "BackgroundTransparency", a * a)
		end
	end
	r.onDone = cleanup
	r.onCancel = cleanup
	launch(r)
end

local function shakeImpl(frame)
	if not enabled or not isGui(frame) then
		return
	end
	local home = shakes[frame] or frame.Position
	shakes[frame] = home
	local function forget()
		if shakes[frame] == home then
			shakes[frame] = nil
		end
	end
	local r = newRecord(0.25, "linear", 0)
	r.fn = function(_, a)
		local amplitude = 6 * (1 - a)
		local offset = math.floor(math.sin(a * math.pi * 6) * amplitude + 0.5)
		trySet(frame, "Position", home + UDim2.fromOffset(offset, 0))
	end
	r.onDone = function()
		trySet(frame, "Position", home)
		forget()
	end
	r.onCancel = forget
	claim(r, frame, "Position")
	launch(r)
end

-- Petit saut (pastille « ! » qui saute) : repos 58 % du temps, saut de 7 px puis rebond de 2 px
local function hopCurve(a)
	if a < 0.58 then
		return 0
	elseif a < 0.68 then
		return math.sin((a - 0.58) / 0.10 * math.pi / 2)
	elseif a < 0.78 then
		return math.cos((a - 0.68) / 0.10 * math.pi / 2)
	elseif a < 0.86 then
		return 0.28 * math.sin((a - 0.78) / 0.08 * math.pi / 2)
	elseif a < 1 then
		return 0.28 * math.cos((a - 0.86) / 0.14 * math.pi / 2)
	end
	return 0
end

local function liftImpl(frame, on)
	if not isGui(frame) then
		return
	end
	local shadow = frame:FindFirstChild("Ombre")
	if shadow ~= nil and not shadow:IsA("GuiObject") then
		shadow = nil
	end
	local s = scaleOf(frame)
	if on then
		if enabled and shadow ~= nil then
			shadow.BackgroundTransparency = 1
			shadow.Position = UDim2.fromOffset(0, 0)
		end
		if s ~= nil then
			startTween(s, { Scale = 1.05 }, 0.1, "quadOut")
		end
		if shadow ~= nil then
			startTween(shadow, { BackgroundTransparency = 0.55, Position = UDim2.fromOffset(0, 10) }, 0.1, "quadOut")
		end
	else
		if s ~= nil then
			startTween(s, { Scale = 1 }, 0.1, "quadOut")
		end
		if shadow ~= nil then
			startTween(shadow, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0) }, 0.1, "quadOut")
		end
	end
end

---------------------------------------------------------------------------
-- Écran d'ouverture
---------------------------------------------------------------------------

local function splashLabel(parent, text, size, font, color, y)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0, y)
	label.Size = UDim2.new(1, 0, 0, size + 6)
	label.Font = font
	label.TextSize = size
	label.TextColor3 = color
	label.Text = text
	label.TextTransparency = 1
	label.ZIndex = 3
	label.Parent = parent
	return label
end

local function splashImpl(root, finish)
	local C = Theme.Colors
	local overlay = Instance.new("TextButton") -- un clic passe l'animation
	overlay.Name = "AnimOuverture"
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.BackgroundColor3 = C.Background
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 1000

	-- halo bleuté derrière le logo (deux disques pour un dégradé doux)
	for i, spec in ipairs({ { 380, 0.55 }, { 240, 0.4 } }) do
		local halo = Instance.new("Frame")
		halo.Name = "Halo"
		halo.AnchorPoint = Vector2.new(0.5, 0.5)
		halo.Position = UDim2.new(0.5, 0, 0.5, -22)
		halo.Size = UDim2.fromOffset(spec[1], spec[1])
		halo.BackgroundColor3 = Color3.fromRGB(31, 42, 68)
		halo.BackgroundTransparency = spec[2]
		halo.BorderSizePixel = 0
		halo.ZIndex = i
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = halo
		halo.Parent = overlay
	end

	local center = Instance.new("Frame")
	center.Name = "Centre"
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(280, 170)
	center.BackgroundTransparency = 1
	center.BorderSizePixel = 0
	center.ZIndex = 3
	center.Parent = overlay

	local logo = Logo.create(center, 64, 3)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.new(0.5, 0, 0, 36)
	logo.Rotation = -12

	local title = splashLabel(center, "Blocs FR", 22, Theme.Fonts.UIBold, C.Text, 102)
	local subtitle = splashLabel(center, "Des blocs en français pour créer tes jeux", 12, Theme.Fonts.UI, C.TextDim, 124)

	local track = Instance.new("Frame")
	track.Name = "Barre"
	track.AnchorPoint = Vector2.new(0.5, 0)
	track.Position = UDim2.new(0.5, 0, 0, 152)
	track.Size = UDim2.fromOffset(120, 4)
	track.BackgroundColor3 = C.PanelBorder
	track.BorderSizePixel = 0
	track.ZIndex = 3
	track.Parent = center
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(0, 2)
	trackCorner.Parent = track
	local fill = Instance.new("Frame")
	fill.Name = "Remplissage"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = C.Accent
	fill.BorderSizePixel = 0
	fill.ZIndex = 4
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 2)
	fillCorner.Parent = fill

	overlay.Parent = root

	-- logo : 0,55 -> 1,1 -> 1 et -12° -> 3° -> 0° ; titre qui monte ; barre de progression
	local handles = {}
	local scale = scaleOf(logo)
	if scale ~= nil then
		scale.Scale = 0.55
		table.insert(handles, startTween(scale, { Scale = 1.1 }, 0.2, "quadOut", function()
			startTween(scale, { Scale = 1 }, 0.14, "sineInOut")
		end))
	end
	table.insert(handles, startTween(logo, { Rotation = 3 }, 0.2, "quadOut", function()
		startTween(logo, { Rotation = 0 }, 0.14, "sineInOut")
	end))
	fadeInImpl(logo, 0.16, 0)
	table.insert(handles, startTween(title, { TextTransparency = 0, Position = UDim2.new(0.5, 0, 0, 92) }, 0.2, "quadOut", nil, 0.2))
	table.insert(handles, startTween(subtitle, { TextTransparency = 0 }, 0.2, "quadOut", nil, 0.28))
	table.insert(handles, startTween(fill, { Size = UDim2.fromScale(1, 1) }, 0.5, "sineInOut", nil, 0.3))

	local closing = false
	local clickConnection = nil
	local closer = nil
	local function close(duration)
		if closing then
			return
		end
		closing = true
		if clickConnection ~= nil then
			clickConnection:Disconnect()
			clickConnection = nil
		end
		if closer ~= nil then
			closer:cancel()
		end
		for _, h in ipairs(handles) do
			h:finish()
		end
		fadeOutImpl(overlay, duration, function()
			pcall(function()
				overlay:Destroy()
			end)
			finish()
		end)
	end
	clickConnection = overlay.MouseButton1Click:Connect(function()
		close(0.12)
	end)
	-- 0,9 s puis fondu de 0,2 s : 1,1 s en tout
	closer = startStep(noop, 0.9, "linear", function()
		close(0.2)
	end, nil, 0, nil)
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

function Anim.init(host)
	hostRef = host
	initialized = true
	local value = nil
	if type(host) == "table" and type(host.getSetting) == "function" then
		local ok, v = pcall(host.getSetting, SETTING)
		if ok then
			value = v
		end
	end
	enabled = value ~= false
	if not enabled then
		pcall(finishAll)
	end
end

function Anim.isInitialized()
	return initialized
end

function Anim.enabled()
	return enabled
end

-- Active / désactive les animations (réglage du plugin) ; désactivées : tout finit tout de suite
function Anim.setEnabled(on)
	enabled = on == true
	if type(hostRef) == "table" and type(hostRef.setSetting) == "function" then
		pcall(hostRef.setSetting, SETTING, enabled)
	end
	if not enabled then
		pcall(finishAll)
	end
end

-- Termine toutes les animations tout de suite (état final ; les boucles sont arrêtées)
function Anim.stopAll()
	pcall(finishAll)
end

function Anim.activeCount()
	return #records
end

-- Vitesse des animations (Theme.Anim.Facteur, entre 0,25 et 4 ; 1 par défaut)
function Anim.factor()
	return speedFactor()
end

-- Durée réelle d'une animation de « seconds » secondes (pour caler un task.delay sur elle)
function Anim.scaled(seconds)
	return math.max(0, tonumber(seconds) or 0) * speedFactor()
end

function Anim.tween(inst, props, duration, easing, onDone, delay)
	if typeof(inst) ~= "Instance" or type(props) ~= "table" then
		callDone(onDone)
		return handleOf(nil)
	end
	local ok, result = pcall(startTween, inst, props, duration, easing, onDone, delay, nil)
	if ok then
		return result
	end
	report(result)
	for prop, value in pairs(props) do
		trySet(inst, prop, value)
	end
	callDone(onDone)
	return handleOf(nil)
end

-- Animation libre : fn(k, a) à chaque image (k = avancement selon la courbe, a = avancement brut)
function Anim.step(fn, duration, easing, onDone, key, delay)
	if type(fn) ~= "function" then
		callDone(onDone)
		return handleOf(nil)
	end
	local ok, result = pcall(startStep, fn, duration, easing, onDone, key, delay, nil)
	if ok then
		return result
	end
	report(result)
	pcall(fn, 1, 1)
	callDone(onDone)
	return handleOf(nil)
end

function Anim.hover(button, normalColor, hoverColor)
	local connections = {}
	local function disconnect()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
	end
	if not isGui(button) or typeof(normalColor) ~= "Color3" or typeof(hoverColor) ~= "Color3" then
		return disconnect
	end
	local ok, err = pcall(function()
		table.insert(connections, button.MouseEnter:Connect(function()
			Anim.tween(button, { BackgroundColor3 = hoverColor }, FAST, "quadOut")
		end))
		table.insert(connections, button.MouseLeave:Connect(function()
			Anim.tween(button, { BackgroundColor3 = normalColor }, FAST, "quadOut")
		end))
	end)
	if not ok then
		report(err)
	end
	return disconnect
end

function Anim.press(button)
	local connections = {}
	local scale = nil
	local down = false
	local function getScale()
		if scale == nil or scale.Parent ~= button then
			scale = scaleOf(button)
		end
		return scale
	end
	local function releasePress()
		if not down then
			return
		end
		down = false
		local s = getScale()
		if s ~= nil then
			Anim.tween(s, { Scale = 1.03 }, 0.08, "quadOut", function()
				if not down and s.Parent ~= nil then
					Anim.tween(s, { Scale = 1 }, 0.1, "quadOut")
				end
			end)
		end
	end
	local function disconnect()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
		down = false
		if scale ~= nil and scale.Parent ~= nil then
			Anim.tween(scale, { Scale = 1 }, 0)
		end
	end
	if typeof(button) ~= "Instance" or not button:IsA("GuiButton") then
		return disconnect
	end
	local ok, err = pcall(function()
		table.insert(connections, button.MouseButton1Down:Connect(function()
			down = true
			local s = getScale()
			if s ~= nil then
				Anim.tween(s, { Scale = 0.94 }, 0.07, "quadOut")
			end
		end))
		table.insert(connections, button.MouseButton1Up:Connect(releasePress))
		table.insert(connections, button.MouseLeave:Connect(releasePress))
	end)
	if not ok then
		report(err)
	end
	return disconnect
end

function Anim.popIn(frame, fromScale)
	local ok, err = pcall(function()
		if not isGui(frame) then
			return
		end
		if not enabled then
			local own = frame:FindFirstChild(SCALE_NAME)
			if own ~= nil and own:IsA("UIScale") then
				startTween(own, { Scale = 1 }, 0)
			end
			return
		end
		local s = scaleOf(frame)
		if s == nil then
			return
		end
		s.Scale = tonumber(fromScale) or 0.92
		startTween(s, { Scale = 1 }, 0.14, "backOut")
	end)
	if not ok then
		report(err)
	end
end

function Anim.slideIn(frame, fromOffset, duration, delay)
	local ok, err = pcall(slideInImpl, frame, fromOffset, duration, delay)
	if not ok then
		report(err)
	end
end

function Anim.slideOut(frame, toOffset, duration, onDone)
	local ok, err = pcall(slideOutImpl, frame, toOffset, duration, onDone)
	if not ok then
		report(err)
		if isGui(frame) then
			trySet(frame, "Visible", false)
		end
		callDone(onDone)
	end
end

function Anim.fadeIn(obj, duration, delay)
	local ok, err = pcall(fadeInImpl, obj, duration, delay)
	if not ok then
		report(err)
	end
end

function Anim.fadeOut(obj, duration, onDone)
	local ok, err = pcall(fadeOutImpl, obj, duration, onDone)
	if not ok then
		report(err)
		if isGui(obj) then
			trySet(obj, "Visible", false)
		end
		callDone(onDone)
	end
end

function Anim.stagger(objects, step, fromOffset, coverColor)
	local ok, err = pcall(staggerImpl, objects, step, fromOffset, coverColor)
	if not ok then
		report(err)
	end
end

function Anim.flash(frame, onDone)
	local ok, err = pcall(flashImpl, frame, onDone)
	if not ok then
		report(err)
		callDone(onDone)
	end
end

function Anim.poof(layer, screenPos, color)
	local ok, err = pcall(poofImpl, layer, screenPos, color)
	if not ok then
		report(err)
	end
end

function Anim.shake(frame)
	local ok, err = pcall(shakeImpl, frame)
	if not ok then
		report(err)
	end
end

-- Respiration (contour des problèmes, fantôme d'aimantation) : Transparency d'un UIStroke (ou
-- BackgroundTransparency d'un cadre) entre low et high. Renvoie la fonction qui l'arrête.
function Anim.pulse(target, low, high, period)
	local ok, result = pcall(function()
		if not enabled or typeof(target) ~= "Instance" then
			return noop
		end
		local prop = "BackgroundTransparency"
		if target:IsA("UIStroke") then
			prop = "Transparency"
		elseif not target:IsA("GuiObject") then
			return noop
		end
		local original = restingValue(target, prop)
		local lo = tonumber(low) or 0
		local hi = tonumber(high) or 0.55
		return startLoop(target, prop, tonumber(period) or 1.4, function(_, a)
			trySet(target, prop, lo + (hi - lo) * (0.5 - 0.5 * math.cos(2 * math.pi * a)))
		end, original)
	end)
	if ok and type(result) == "function" then
		return result
	end
	if not ok then
		report(result)
	end
	return noop
end

-- Petit saut périodique (pastille « ! » des problèmes). Renvoie la fonction qui l'arrête.
function Anim.hop(obj, height, period)
	local ok, result = pcall(function()
		if not enabled or not isGui(obj) then
			return noop
		end
		local home = restingValue(obj, "Position")
		if typeof(home) ~= "UDim2" then
			return noop
		end
		local h = tonumber(height) or 7
		return startLoop(obj, "Position", tonumber(period) or 2.8, function(_, a)
			trySet(obj, "Position", home + UDim2.fromOffset(0, -math.floor(hopCurve(a) * h + 0.5)))
		end, home)
	end)
	if ok and type(result) == "function" then
		return result
	end
	if not ok then
		report(result)
	end
	return noop
end

function Anim.lift(frame, on)
	local ok, err = pcall(liftImpl, frame, on == true)
	if not ok then
		report(err)
	end
end

function Anim.countTo(label, from, to, duration, formatFn)
	local ok, err = pcall(function()
		if typeof(label) ~= "Instance" then
			return
		end
		local format = formatFn
		if type(format) ~= "function" then
			format = function(v)
				return tostring(math.floor(v + 0.5))
			end
		end
		local a0 = tonumber(from) or 0
		local a1 = tonumber(to) or 0
		local r = newRecord(tonumber(duration) or 0.4, "quadOut", 0)
		r.fn = function(k)
			local okText, text = pcall(format, a0 + (a1 - a0) * k)
			if okText then
				trySet(label, "Text", tostring(text))
			end
		end
		claim(r, label, "Text")
		launch(r)
	end)
	if not ok then
		report(err)
	end
end

-- Écran d'ouverture (1,1 s ; un clic le passe). onDone est appelé une fois, à la fin.
function Anim.splash(root, onDone)
	local called = false
	local function finish()
		if called then
			return
		end
		called = true
		callDone(onDone)
	end
	if not enabled or not isGui(root) then
		finish()
		return
	end
	local ok, err = pcall(splashImpl, root, finish)
	if not ok then
		report(err)
		pcall(function()
			local overlay = root:FindFirstChild("AnimOuverture")
			if overlay ~= nil then
				overlay:Destroy()
			end
		end)
		finish()
	end
end

return Anim
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">App</string><ProtectedString name="Source"><![CDATA[-- App : assemble l'éditeur Blocs FR et garde son état (projets, cibles, scripts, écrans, problèmes).
--
-- Disposition dans host.root (SPEC §13, §15, §21.8) :
--   ┌ TopBar (Theme.Layout.TopBarHeight = 48) ─────────────────────────────────────────────────┐
--   │ Onglet « Blocs »     : Palette (Theme.Layout.PanelWidth) │ Canvas                          │
--   │ Onglet « Interface » : colonne gauche (GuiEditor : éléments, modèles, calques ; 250 px)     │
--   │   │ colonne du milieu : aperçu de l'écran / séparateur réglable (14 px) / zone « Blocs de    │
--   │   │ l'écran » (en-tête 40 px, puis la palette (230 px) et le canvas : les MÊMES, re-parentés) │
--   │   │ colonne droite (GuiEditor : propriétés ; 300 px). Fenêtre étroite : colonnes réduites    │
--   │   │ jusqu'à 190 / 220 px, palette de la zone jusqu'à 150 px.                                 │
--   └ Barre d'état (Theme.Layout.StatusBarHeight = 28) ────────────────────────────────────────┘
-- Calques (frères plein écran, ZIndex croissant) : contenu, vue du code, panneaux de droite (détecteur,
-- explication), glisser-déposer, dialogues (+ prévisualiseur de hitbox Z 5, paramètres Z 6, fenêtres
-- « Partager / Importer un code » Z 7, sous les menus et fenêtres de Dialogs Z 10+).
--
-- Deux sessions de blocs (SPEC §21.8) : « blocs » (le projet de la cible choisie dans l'Explorateur, comme
-- avant) et « interface » (le script local « BlocsLocal » de l'écran ouvert ; cible = son ScreenGui, nil
-- tant que l'écran n'a jamais été enregistré). self.model / self.target / self.scriptInstance sont ceux de
-- l'onglet affiché (DevBridge les lit et les écrit directement) ; changer d'onglet échange les sessions sans
-- rien enregistrer ni perdre (vue du canvas comprise).
--
-- Détecteur d'erreurs (SPEC §17) : Detecteur.analyze 0,4 s après chaque modification (et avant
-- l'enregistrement), avec ctx.guiNames (écrans de StarterGui + écran en cours, même pas enregistré) ;
-- les erreurs des tests (réglage « BlocsFR_ErreursTest » écrit par ErrorWatcher) sont relues toutes les 2 s.
--
-- API (App.new(host, state?) ; state = app:exportState() d'un éditeur précédent : projets, cibles, scripts,
-- onglet, vues, écran ouvert — utilisé par host.rebuildApp() après « Paramètres › Appliquer ») :
--   Projet : newProject, openFromSelection, save, setMode, showCode, toggleCode, showCodeAt(blockId|nil),
--     explain(forceShow?), undo, redo, zoomIn, zoomOut, resetZoom, cleanUp, help, openWiki(pageId),
--     openWikiBlock(defId|nil), openHelp(defId), loadExample(id), insertModele(id, screenPos|nil),
--     loadModel(model, target, script), getModel(), setStatus(text, kind), toggleProblems, recheck,
--     clearTestErrors, getProblems, openHitboxPreview(blockId|nil), openSettings(section?), shareScript,
--     importCode, setAnimations(on), toggleFavorite(defId), isFavorite(defId), focusBlock(blockId),
--     selectInExplorer("cible" | "script")
--   Onglets et écrans : setWorkspace("blocs" | "interface"), getWorkspace(), getGuiEditor(),
--     openScreen(screenGui | nom), openGuiScreen(screenGui) (sans question), newScreen(),
--     insertTemplate(id), saveScreen(), renameScreen(), deleteScreen(), togglePreview(), listScreens(),
--     listTemplates(), toggleZone(collapse?), cycleSplit()
--   Pour GuiEditor (deps.app ; les mêmes sont aussi passées en fonctions dans deps) :
--     getInterfaceModel() -> Model des blocs de l'écran (aussi deps.getModel) ; blocksForElement(nom) ->
--     { { blockId, defId, text, hat } } ; addClickScript(nom) -> blockId (« Ajouter un script au clic ») ;
--     focusBlock(blockId) ; loadScreenBlocks(données Model) ; getGuiNames(filtre) ;
--     deps.requestScreen(genre, arg) (le Studio demande « nouveau » / « modele » / « ouvrir » : App pose
--     la question « Enregistrer ? » puis charge les blocs du nouvel écran) ; deps.saveScreen() ;
--     onScreenChanged({ reason, screenGui?, templateId?, blocs? }) (le Studio a changé d'écran tout seul).
--     App écoute editor.SelectionChanged (lien bloc ↔ élément : contour cyan), editor.DocChanged(raison,
--     info) (aperçu modifié, écran renommé : les blocs qui le nomment suivent) et editor.PreviewChanged.
--   Lignes entre les blocs (SPEC §36) : getLinkMode() / setLinkMode("toujours" | "survol" | "jamais"),
--     aussi passées au canvas (deps.getLinkMode / deps.setLinkMode).
--   Brouillons : saveDraft(force?), clearDraft(onglet? | "*", chemin?), checkDraft() (aussi pour DevBridge).
--   État : exportState(), getDebugState(), destroy()
-- host (Main) : root, plugin, widget, version, sessionStart, getMousePosition, openWiki(pageId, defId),
--   getSetting, setSetting, rebuildApp() (Paramètres › Appliquer), showSplash (écran d'ouverture : la
--   première fois dans la session de Studio), onWorkspaceChanged(nom) (bouton « Interface » de Studio).
--
-- NOTE: en plus de la SPEC : brouillons par cible (réglage « BlocsFR_Brouillon » = { version = 2, entries =
-- { { json, targetPath, workspace, time, mode, screen, count } } }, 4 au plus, aussi écrits à la fermeture) ;
-- un ancien brouillon unique { json, targetPath, workspace, time } est encore lu.
-- NOTE: Model n'a pas de méthode « marquer non enregistré » : un projet repris d'un brouillon ou d'un
-- état exporté reçoit dirty = true et _savedIndex = nil (voir markUnsaved).

local Selection = game:GetService("Selection")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local Model = require(script.Parent.Model)
local Storage = require(script.Parent.Storage)
local CodeGen = require(script.Parent.CodeGen)
local Dialogs = require(script.Parent.Dialogs)
local Canvas = require(script.Parent.Canvas)
local Palette = require(script.Parent.Palette)
local TopBar = require(script.Parent.TopBar)
local CodeView = require(script.Parent.CodeView)

local App = {}
App.__index = App

-- Couleurs du thème lues à chaque usage (les paramètres peuvent changer le thème)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})

local ANALYSIS_DELAY = 0.4 -- délai (s) entre une modification et l'analyse
local ANALYSIS_WAIT_MAX = 3 -- attente maximale (s) d'une analyse en cours avant l'enregistrement
local TEST_POLL_INTERVAL = 2 -- relecture des erreurs des tests (s)
local TEST_SETTING = "BlocsFR_ErreursTest" -- = ErrorWatcher.SETTING
local TEST_TITLE = "Pendant le dernier test"
local IMPORT_GAP = 80 -- espace entre tes blocs et des blocs ajoutés à droite (exemple, code partagé)
local DEFAULT_STACK_WIDTH = 320
local DEFAULT_STACK_HEIGHT = 60
local MODULE_LOADED_AT = os.time()

local WORKSPACES = { blocs = true, interface = true }
local SPLIT_DEFAULT = 0.55 -- part de l'aperçu dans la colonne du milieu (onglet Interface)
local SPLIT_CYCLE = { 0.55, 0.25, 0.8 } -- « Agrandir » : 55 % -> 25 % -> 80 % (part de l'aperçu)
local CROSSFADE_TIME = 0.2
local ZONE_PALETTE_MIN = 150
local GUI_LEFT_MIN = 190
local GUI_RIGHT_MIN = 220
local GUI_CENTER_MIN = 420
local DRAFT_SETTING = "BlocsFR_Brouillon"
local DRAFT_MAX_ENTRIES = 4
local DRAFT_MAX_CHARS = 400000
local DRAFT_RETRY = 30 -- brouillon désactivé : le réglage est relu toutes les 30 s
local SHARE_PREFIX = "BLOCSFR1:"
local SETTINGS_PREFIX = "BLOCSFR_REGLAGES1:"
local LINKS_SETTING = "BlocsFR_Liens" -- lignes entre les blocs (SPEC §36), si Reglages n'a pas « zone.liens »
local LINK_MODES = { toujours = true, survol = true, jamais = true }
local Z_TEXT_WINDOW = 7 -- fenêtres « Partager / Importer » (sous les menus et fenêtres de Dialogs)
local WHITE = Color3.fromRGB(255, 255, 255)

local SEVERITY_RANK = { erreur = 3, avertissement = 2, conseil = 1 }
local SEVERITY_ORDER = { "erreur", "avertissement", "conseil" }
local SEVERITY_WORDS = {
	erreur = { "erreur", "erreurs" },
	avertissement = { "avertissement", "avertissements" },
	conseil = { "conseil", "conseils" },
}

-- Couleurs (noms des couleurs du thème, lues au moment de l'affichage)
local STATUS_KEYS = {
	info = "TextSoft",
	success = "SuccessText",
	warning = "WarningText",
	error = "DangerText",
}
local SEVERITY_TEXT_KEYS = {
	erreur = "DangerText",
	avertissement = "WarningText",
	conseil = "InfoText",
}

local STATUS_TEXT_SIZE = 12
local STATUS_MARGIN = 12

-- Aide de secours (quand le wiki n'est pas disponible)
local SHORT_HELP = table.concat({
	"1. Sélectionne un objet dans l'Explorateur : c'est la « Cible ».",
	"2. Glisse un bloc « Quand … » (Événements) dans la zone de travail, puis des blocs en dessous.",
	"3. Les blocs ronds (valeurs) et pointus (conditions) se glissent dans les cases des autres blocs.",
	"4. Glisse des blocs sur la palette pour les supprimer ; clic droit pour plus d'options (sélectionner, wiki, supprimer…).",
	"5. « Enregistrer » écrit le script dans la cible. Le bouton des problèmes (⚠) explique les erreurs.",
	"6. L'onglet « Interface » sert à dessiner les écrans de ton jeu (menus, boutons) et leurs blocs.",
}, "\n")

-- Préfixes de conteneurs « Starter » dont les scripts sont copiés dans le personnage pendant un test
local CHARACTER_PREFIXES = { "StarterPlayer.StarterCharacterScripts.", "StarterPack." }

-- Types de script (SPEC §20) : mode -> { « un script … », message de la barre d'état quand on le choisit }
local MODES = {
	server = {
		article = "un script serveur",
		status = "Mode script serveur : le script s'exécutera sur le serveur (BlocsServeur).",
	},
	["local"] = {
		article = "un script local",
		status = "Mode script local : le script s'exécutera chez chaque joueur (BlocsLocal).",
	},
	module = {
		article = "un script module",
		status = "Mode script module : tes blocs forment un module (BlocsModule) de fonctions et de valeurs que les autres scripts peuvent utiliser.",
	},
}

-- Mode valide d'un projet ("server" par défaut)
local function modeOf(model)
	local mode = model and model.mode
	if MODES[mode] ~= nil then
		return mode
	end
	return "server"
end

---------------------------------------------------------------------------
-- Fonctions utiles (toujours protégées : l'éditeur ne doit jamais planter)
---------------------------------------------------------------------------

-- Modules facultatifs (wiki, détecteur, Studio d'interface…) : une erreur dans l'un d'eux (ou un module
-- pas encore écrit) ne casse pas l'éditeur
local optionalCache = {}
local optionalErrors = {}

local function optionalModule(name)
	local cached = optionalCache[name]
	if cached ~= nil then
		if cached == false then
			return nil, optionalErrors[name]
		end
		return cached, nil
	end
	local moduleScript = script.Parent:FindFirstChild(name)
	if moduleScript == nil or not moduleScript:IsA("ModuleScript") then
		optionalCache[name] = false
		optionalErrors[name] = "module « " .. name .. " » introuvable"
		return nil, optionalErrors[name]
	end
	local ok, result = pcall(require, moduleScript)
	if not ok or type(result) ~= "table" then
		optionalCache[name] = false
		optionalErrors[name] = tostring(result)
		warn("[Blocs FR] Module " .. name .. " indisponible : " .. tostring(result))
		return nil, optionalErrors[name]
	end
	optionalCache[name] = result
	return result, nil
end

local function getAnim()
	local Anim = optionalModule("Anim")
	return Anim
end

local function animEnabled()
	local Anim = getAnim()
	if Anim == nil or type(Anim.enabled) ~= "function" then
		return false
	end
	local ok, on = pcall(Anim.enabled)
	return ok and on == true
end

local function themeColor(key)
	local color = Theme.Colors[key]
	if typeof(color) == "Color3" then
		return color
	end
	return Color3.fromRGB(200, 200, 205)
end

local function firstSelected()
	local ok, list = pcall(function()
		return Selection:Get()
	end)
	if ok and type(list) == "table" then
		return list[1]
	end
	return nil
end

-- Vrai si inst fait encore partie du jeu (un objet dont un ancêtre a été supprimé n'en fait plus partie,
-- même si son propre Parent n'est pas nil)
local function isAlive(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	if inst == game then
		return true
	end
	local ok, inGame = pcall(function()
		return inst:IsDescendantOf(game)
	end)
	return ok and inGame == true
end

local function pathOf(inst)
	if typeof(inst) ~= "Instance" then
		return "(aucune)"
	end
	local ok, path = pcall(Storage.pathOf, inst)
	if ok and type(path) == "string" then
		return path
	end
	local okFull, full = pcall(function()
		return inst:GetFullName()
	end)
	if okFull then
		return full
	end
	return "?"
end

-- "Workspace.Porte" -> l'objet, ou nil (noms avec des points : introuvables)
local function resolvePath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end
	local inst = game
	for segment in string.gmatch(path, "[^%.]+") do
		local child = nil
		pcall(function()
			child = inst:FindFirstChild(segment)
		end)
		if child == nil and inst == game then
			pcall(function()
				child = game:GetService(segment)
			end)
		end
		if child == nil then
			return nil
		end
		inst = child
	end
	if inst == game then
		return nil
	end
	return inst
end

local function isProjectScript(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, result = pcall(Storage.isProjectScript, inst)
	return ok and result == true
end

local function findProjectScript(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	local ok, found = pcall(Storage.findProjectScript, inst)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- Charge le projet d'un script ; renvoie model ou nil, messageFR, avertissements (tableau)
local function loadScript(scriptInst)
	local ok, model, err, warnings = pcall(Storage.load, scriptInst)
	if not ok then
		return nil, "Erreur au chargement du projet : " .. tostring(model), {}
	end
	if not model then
		return nil, tostring(err or "Impossible de lire le projet de blocs de ce script."), {}
	end
	if type(warnings) ~= "table" then
		warnings = {}
	end
	return model, nil, warnings
end

-- Message de la barre d'état après un chargement : avertissements éventuels, sinon succès
local function loadedMessage(scriptInst, warnings)
	if type(warnings) == "table" and #warnings > 0 then
		local text = "⚠ " .. tostring(warnings[1])
		if #warnings > 1 then
			text = text .. " (+" .. (#warnings - 1) .. ")"
		end
		return text, "warning"
	end
	return "Projet chargé depuis " .. pathOf(scriptInst) .. ".", "success"
end

local function plural(n, word)
	if n > 1 then
		return n .. " " .. word .. "s"
	end
	return n .. " " .. word
end

local function severityWord(severity, n)
	local words = SEVERITY_WORDS[severity]
	if n > 1 then
		return n .. " " .. words[2]
	end
	return n .. " " .. words[1]
end

local function normalizeSeverity(severity)
	if SEVERITY_RANK[severity] ~= nil then
		return severity
	end
	return "avertissement"
end

-- Copie validée d'un problème (champs inconnus conservés pour le panneau)
local function sanitizeProblem(p, defaultSource)
	if type(p) ~= "table" then
		return nil
	end
	local out = {}
	for key, value in pairs(p) do
		out[key] = value
	end
	out.severity = normalizeSeverity(p.severity)
	out.title = tostring(p.title or "Problème")
	out.message = tostring(p.message or "")
	if type(p.source) == "string" and p.source ~= "" then
		out.source = p.source
	else
		out.source = defaultSource
	end
	if type(p.blockId) == "string" and p.blockId ~= "" then
		out.blockId = p.blockId
	else
		out.blockId = nil
	end
	out.line = tonumber(p.line)
	if p.raw ~= nil then
		out.raw = tostring(p.raw)
	end
	return out
end

-- Chemin d'un script pendant un test -> chemin équivalent dans l'éditeur
-- (les scripts de StarterGui / StarterPlayerScripts / StarterPack sont copiés chez le joueur)
local function stripGame(path)
	local text = tostring(path or "")
	text = string.gsub(text, "^game%.", "")
	return text
end

local function normalizeRuntimePath(path)
	local text = stripGame(path)
	local rest = string.match(text, "^Players%.[^%.]+%.PlayerGui%.(.+)$")
	if rest then
		return "StarterGui." .. rest
	end
	rest = string.match(text, "^Players%.[^%.]+%.PlayerScripts%.(.+)$")
	if rest then
		return "StarterPlayer.StarterPlayerScripts." .. rest
	end
	rest = string.match(text, "^Players%.[^%.]+%.Backpack%.(.+)$")
	if rest then
		return "StarterPack." .. rest
	end
	return text
end

-- Nombre de fois qu'une erreur du test s'est produite (ErrorWatcher regroupe les répétitions : « count »)
local function recordCount(record)
	local n = tonumber(record.count)
	if n == nil or n ~= n or n < 1 then
		return 1
	end
	return math.floor(math.min(n, 1e9))
end

local function deepEqual(a, b, depth)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	depth = (depth or 0) + 1
	if depth > 80 then
		return false
	end
	for key, value in pairs(a) do
		if not deepEqual(value, b[key], depth) then
			return false
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false
		end
	end
	return true
end

-- Projet vide d'un type de script donné (l'historique commence avec ce type : « Annuler » ne le change pas)
local function emptyModel(mode)
	local ok, model = pcall(Model.fromData, {
		format = Model.FORMAT,
		version = Model.VERSION,
		mode = mode or "server",
		variables = {},
		tops = {},
		blocks = {},
	})
	if ok and type(model) == "table" then
		return model
	end
	local fallback = Model.new()
	pcall(function()
		fallback:setMode(mode or "server")
	end)
	return fallback
end

-- Projet repris (brouillon, état exporté) : il n'est pas enregistré
local function markUnsaved(model)
	pcall(function()
		model.dirty = true
		model._savedIndex = nil
		model._savedMark = nil
	end)
end

local function countOf(model)
	local blocks, notes = 0, 0
	pcall(function()
		blocks = tonumber(model:count()) or 0
	end)
	pcall(function()
		notes = #model:noteIds()
	end)
	return blocks, notes
end

-- Taille d'une pile (canvas), sans créer d'Instance
local function stackSize(model, topId)
	local Renderer = optionalModule("Renderer")
	if Renderer and type(Renderer.measure) == "function" then
		local ok, w, h = pcall(Renderer.measure, model, topId)
		if ok and type(w) == "number" and w == w and w > 0 and w < 100000 then
			if type(h) ~= "number" or h ~= h or h <= 0 or h > 100000 then
				h = DEFAULT_STACK_HEIGHT
			end
			return w, h
		end
	end
	return DEFAULT_STACK_WIDTH, DEFAULT_STACK_HEIGHT
end

-- Coin haut-gauche des piles de données sérialisées (SPEC §6) : minX, minY (nil si aucune pile)
local function dataBounds(data)
	if type(data) ~= "table" or type(data.tops) ~= "table" or type(data.blocks) ~= "table" then
		return nil, nil
	end
	local minX, minY = nil, nil
	for _, id in ipairs(data.tops) do
		local block = data.blocks[id]
		if type(block) == "table" then
			local x = tonumber(block.x) or 0
			local y = tonumber(block.y) or 0
			if minX == nil or x < minX then
				minX = x
			end
			if minY == nil or y < minY then
				minY = y
			end
		end
	end
	return minX, minY
end

-- Position de la première pile de données sérialisées (0, 0 sinon)
local function firstTopPosition(data)
	if type(data) == "table" and type(data.tops) == "table" and type(data.blocks) == "table" then
		local block = data.blocks[data.tops[1]]
		if type(block) == "table" then
			return tonumber(block.x) or 0, tonumber(block.y) or 0
		end
	end
	return 0, 0
end

-- Importe des blocs à droite des piles existantes (même hauteur que la plus haute). Les notes suivent.
local function importBeside(model, data)
	local right, top = nil, nil
	for _, id in ipairs(table.clone(model.tops)) do
		local block = model:get(id)
		if block then
			local x = tonumber(block.x) or 0
			local y = tonumber(block.y) or 0
			local w = stackSize(model, id)
			local r = x + w
			if right == nil or r > right then
				right = r
			end
			if top == nil or y < top then
				top = y
			end
		end
	end
	local minX, minY = dataBounds(data)
	local dx, dy = 0, 0
	if right ~= nil and minX ~= nil then
		dx = right + IMPORT_GAP - minX
		dy = top - minY
	end
	local newTops, warnings = model:importData(data, dx, dy)
	if type(newTops) ~= "table" then
		newTops = {}
	end
	return newTops, warnings
end

local function findExample(examples, exampleId)
	for _, entry in ipairs(examples) do
		if type(entry) == "table" and entry.id == exampleId then
			return entry
		end
	end
	return nil
end

-- « du 10/11 à 14 h 32 »
local function formatTime(t)
	local ok, d = pcall(os.date, "*t", tonumber(t) or 0)
	if not ok or type(d) ~= "table" then
		return "?"
	end
	return string.format("%02d/%02d à %d h %02d", d.day, d.month, d.hour, d.min)
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

-- Hauteur d'un texte qui passe à la ligne dans une largeur donnée (ne cède jamais la main)
local function wrappedHeight(text, size, font, width)
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 100000))
	end)
	if ok and typeof(result) == "Vector2" then
		return math.ceil(result.Y)
	end
	local w = Util.textSize(text, size, font).X
	return math.max(1, math.ceil(w / math.max(1, width))) * (size + 4)
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = 13,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

local function layer(name, zIndex, parent)
	return Util.create("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex,
		Parent = parent,
	})
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function App.new(host, state)
	local self = setmetatable({}, App)
	self.host = host or {}
	self.root = self.host.root
	self.connections = {}
	self.modelConnection = nil
	self.statusText = ""
	self.statusKind = "info"
	self._destroyed = false
	self._saving = false

	-- Détecteur d'erreurs
	self._staticProblems = {}
	self._testProblems = {}
	self._problems = {}
	self._problemCounts = { erreur = 0, avertissement = 0, conseil = 0 }
	self._analysisToken = 0
	self._analyzing = false
	self._analysisPending = false
	self._analyzedOnce = false
	self._detectorAvailable = true
	self._codeOk = nil -- vérification du code généré (pied du panneau) : true / false / nil
	self._codeErr = nil
	self._lastGuiNames = nil

	-- Erreurs pendant les tests
	self._testRecords = {}
	self._lastTestId = 0
	self._testSignature = ""
	self._polling = false
	self._sessionStart = tonumber(self.host.sessionStart) or MODULE_LOADED_AT

	-- Onglets, sessions, Studio d'interface
	self.workspace = "blocs"
	self.sessions = {}
	self._activeSession = nil
	self.guiEditor = nil
	self._guiEditorFailed = false
	self._guiEditorError = nil
	self._screenDoc = nil -- document de l'écran affiché par l'éditeur (détecte un changement d'écran)
	self._lastScreenName = nil -- nom connu de l'écran (détecte un renommage)
	self._screenOpening = false
	self._screenInitialized = false
	self._restoringScreen = nil
	self._lastEdited = "blocs" -- Annuler / Refaire de l'onglet Interface : "gui" ou "blocs"
	self._previewOn = false
	self._split = SPLIT_DEFAULT
	self._splitIndex = 1
	self._zoneCollapsed = false
	self._splitDrag = nil
	self._linkName = nil -- élément sélectionné dans l'aperçu (contour cyan sur ses blocs)
	self._paletteWidth = nil

	-- Panneaux, fenêtres, brouillons, mises à jour
	self.hitboxPreview = nil
	self.settingsPanel = nil
	self.explicationPanel = nil
	self._textWindow = nil
	self._draftToken = 0
	self._draftSignatures = {}
	self._updateInfo = nil
	self._stopUpdates = nil
	self._templatesCache = nil

	-- 1. Paramètres (avant toute interface ; Main l'a normalement déjà fait)
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.isLoaded) == "function" and type(Reglages.init) == "function" then
		local okLoaded, loaded = pcall(Reglages.isLoaded)
		if okLoaded and not loaded then
			local ok, err = pcall(Reglages.init, self.host)
			if not ok then
				warn("[Blocs FR] Paramètres : " .. tostring(err))
			end
		end
	end
	-- « zone.liens » (lignes entre les blocs, SPEC §36) remis dans les réglages après chaque changement
	-- (branché avant le canvas : ce rappel passe avant le sien)
	if Reglages and type(Reglages.Changed) == "table" and type(Reglages.Changed.Connect) == "function" then
		local okConnect, connection = pcall(function()
			return Reglages.Changed:Connect(function()
				if not self._destroyed then
					self:_injectLinkMode()
				end
			end)
		end)
		if okConnect and connection then
			table.insert(self.connections, connection)
		end
	end
	self:_injectLinkMode()
	-- 2. Animations (réglage « Animations »)
	local Anim = getAnim()
	if Anim and type(Anim.init) == "function" then
		pcall(Anim.init, self.host)
	end

	Registry.load()

	-- 3. Sessions (projet de la cible, script de l'écran)
	self:_initSessions(state)
	self:_useSession("blocs")

	self:_buildLayout()
	self:_createModules()

	self:_connectModel()
	if self.canvas and self.canvas.ZoomChanged then
		table.insert(self.connections, self.canvas.ZoomChanged:Connect(function()
			if not self._destroyed then
				self:_updateTopBar()
			end
		end))
	end
	local okSel, selConnection = pcall(function()
		return Selection.SelectionChanged:Connect(function()
			self:_onSelectionChanged()
		end)
	end)
	if okSel and selConnection then
		table.insert(self.connections, selConnection)
	end

	-- 4. Contenu de départ
	if type(state) == "table" then
		self:_restoreState(state)
	else
		self:_initialLoad()
	end

	self:_publishProblems()
	self:_scheduleAnalysis(0.1)
	self:_startTestPolling()
	self:_startDraftTimer()
	self:_startUpdates(type(state) == "table")

	-- 5. Écran d'ouverture (la première fois que l'éditeur s'ouvre dans cette session de Studio)
	local splash = false
	if type(state) ~= "table" and self.host.showSplash == true and Anim and type(Anim.splash) == "function" then
		splash = animEnabled()
		local ok, err = pcall(Anim.splash, self.root)
		if not ok then
			warn("[Blocs FR] Écran d'ouverture : " .. tostring(err))
		end
	end
	if type(state) ~= "table" then
		-- brouillon d'un projet non enregistré (après l'écran d'ouverture)
		local delay = 0.4
		if splash then
			delay = 1.4
		end
		task.delay(delay, function()
			if not self._destroyed then
				self:_offerDraft("blocs", true)
			end
		end)
	end
	return self
end

-- Sessions de départ : nouvelles, ou reprises de l'état exporté par l'éditeur précédent
function App:_initSessions(state)
	local blocsTarget = workspace
	local okTarget, target = pcall(Storage.defaultTarget)
	if okTarget and typeof(target) == "Instance" then
		blocsTarget = target
	end
	self.sessions = {
		blocs = { model = Model.new(), target = blocsTarget, scriptInstance = nil, view = nil },
		interface = { model = emptyModel("local"), target = nil, scriptInstance = nil, view = nil },
	}
	if type(state) ~= "table" or type(state.sessions) ~= "table" then
		return
	end
	for name, entry in pairs(state.sessions) do
		local session = self.sessions[name]
		if session ~= nil and type(entry) == "table" then
			if type(entry.data) == "table" then
				local ok, model = pcall(Model.fromData, entry.data)
				if ok and type(model) == "table" then
					if entry.dirty == true then
						markUnsaved(model)
					end
					session.model = model
				end
			end
			if isAlive(entry.target) then
				session.target = entry.target
			elseif name == "interface" then
				session.target = nil
			end
			if isAlive(entry.scriptInstance) then
				session.scriptInstance = entry.scriptInstance
			end
			if type(entry.view) == "table" and state.resetViews ~= true then
				session.view = entry.view
			end
		end
	end
end

-- Recopie les champs d'une session dans self (sans rien redessiner)
function App:_useSession(name)
	local s = self.sessions[name]
	self._activeSession = name
	self.model = s.model
	self.target = s.target
	self.scriptInstance = s.scriptInstance
end

-- Au démarrage : si la cible contient (ou est) un script Blocs FR, on l'ouvre
function App:_initialLoad()
	local found = findProjectScript(self.target)
	if found then
		local model, err, warnings = loadScript(found)
		if model then
			self:loadModel(model, found.Parent, found)
			self:setStatus(loadedMessage(found, warnings))
		else
			self.target = found.Parent or workspace
			self.scriptInstance = found
			self:_refreshAll()
			self:setStatus(tostring(err) .. " Il sera remplacé si tu enregistres.", "error")
		end
	else
		self:_refreshAll()
		self:setStatus("Bienvenue ! Choisis une cible dans l'Explorateur, puis glisse des blocs depuis la palette.", "info")
	end
end

function App:_buildLayout()
	local root = self.root
	local top = Theme.Layout.TopBarHeight
	local bottom = Theme.Layout.StatusBarHeight

	self.mainLayer = layer("Contenu", 1, root)
	self.codeLayer = layer("CalqueCode", 2, root)
	self.problemsLayer = layer("CalqueProblemes", 3, root)
	self.dragLayer = layer("CalqueGlisser", 4, root)
	self.dialogLayer = layer("CalqueDialogues", 5, root)

	self.topBarHost = Util.create("Frame", {
		Name = "ZoneBarreHaut",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, top),
		ZIndex = 3,
		Parent = self.mainLayer,
	})

	self.body = Util.create("Frame", {
		Name = "Corps",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 1, -(top + bottom)),
		ZIndex = 1,
		Parent = self.mainLayer,
	})

	self:_buildBlocsBody()
	self:_buildStatusBar(bottom)
end

-- Onglet « Blocs » : palette à gauche, canvas à droite (les deux hôtes passent dans la zone « Blocs de
-- l'écran » dans l'onglet Interface)
function App:_buildBlocsBody()
	local panelW = Theme.Layout.PanelWidth
	self.blocsBody = Util.create("Frame", {
		Name = "Blocs",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = self.body,
	})
	self.paletteHost = Util.create("Frame", {
		Name = "ZonePalette",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(0, panelW - 1, 1, 0),
		ZIndex = 2,
		Parent = self.blocsBody,
	})
	Util.create("Frame", {
		Name = "BordurePalette",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(panelW - 1, 0),
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 3,
		Parent = self.blocsBody,
	})
	self.canvasHost = Util.create("Frame", {
		Name = "ZoneCanvas",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(panelW, 0),
		Size = UDim2.new(1, -panelW, 1, 0),
		ZIndex = 1,
		Parent = self.blocsBody,
	})
	self._paletteWidth = panelW
end

-- Barre d'état : message à gauche ; à droite le bouton des problèmes et le nombre de blocs
function App:_buildStatusBar(height)
	local status = Util.create("Frame", {
		Name = "BarreEtat",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -height),
		Size = UDim2.new(1, 0, 0, height),
		ZIndex = 2,
		Parent = self.mainLayer,
	})
	self.statusBar = status
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 2,
		Parent = status,
	})
	self.statusLabel = Util.create("TextLabel", {
		Name = "Message",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = STATUS_TEXT_SIZE,
		TextColor3 = themeColor(STATUS_KEYS.info),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		Position = UDim2.fromOffset(STATUS_MARGIN, 1),
		Size = UDim2.new(1, -260, 1, -1),
		Parent = status,
	})
	self.countLabel = Util.create("TextLabel", {
		Name = "NombreBlocs",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = STATUS_TEXT_SIZE,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0 bloc",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -STATUS_MARGIN, 0, 1),
		Size = UDim2.new(0, 60, 1, -1),
		Parent = status,
	})
	self.statusSeparator = Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -80, 0.5, 1),
		Size = UDim2.fromOffset(1, 14),
		Parent = status,
	})
	-- Bouton des problèmes (ouvre / ferme le détecteur ; clic droit : revérifier…)
	self.problemsButton = Util.create("TextButton", {
		Name = "Problemes",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.ButtonHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -90, 0.5, 1),
		Size = UDim2.fromOffset(120, 22),
		Parent = status,
	})
	Util.corner(self.problemsButton, 6)
	self.problemsLabel = Util.create("TextLabel", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UIBold,
		TextSize = STATUS_TEXT_SIZE,
		TextColor3 = C.SuccessText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "✓ Aucun problème",
		Size = UDim2.fromScale(1, 1),
		Parent = self.problemsButton,
	})
	table.insert(self.connections, self.problemsButton.MouseEnter:Connect(function()
		if self.problemsButton then
			self.problemsButton.BackgroundColor3 = C.ButtonHover
			self.problemsButton.BackgroundTransparency = 0
		end
	end))
	table.insert(self.connections, self.problemsButton.MouseLeave:Connect(function()
		if self.problemsButton then
			self.problemsButton.BackgroundTransparency = 1
		end
	end))
	table.insert(self.connections, self.problemsButton.MouseButton1Click:Connect(function()
		self:toggleProblems()
	end))
	table.insert(self.connections, self.problemsButton.MouseButton2Click:Connect(function()
		self:_openProblemsMenu()
	end))
	self:_layoutStatus()
end

-- Recalcule les largeurs de la barre d'état (textes de longueur variable)
function App:_layoutStatus()
	if not self.countLabel or not self.problemsLabel then
		return
	end
	local countW = math.max(40, Util.textSize(self.countLabel.Text, STATUS_TEXT_SIZE, Theme.Fonts.UI).X + 4)
	local problemsW = Util.textSize(self.problemsLabel.Text, STATUS_TEXT_SIZE, Theme.Fonts.UIBold).X + 20
	countW = math.ceil(countW)
	problemsW = math.ceil(problemsW)
	self.countLabel.Size = UDim2.new(0, countW, 1, -1)
	local sepRight = STATUS_MARGIN + countW + 8
	self.statusSeparator.Position = UDim2.new(1, -sepRight, 0.5, 1)
	local problemsRight = sepRight + 9
	self.problemsButton.Position = UDim2.new(1, -problemsRight, 0.5, 1)
	self.problemsButton.Size = UDim2.fromOffset(problemsW, 22)
	local used = problemsRight + problemsW + 12
	self.statusLabel.Size = UDim2.new(1, -(STATUS_MARGIN + used), 1, -1)
end

-- Ordre de création : Dialogs → Canvas → Palette → TopBar → CodeView → panneau des problèmes
function App:_createModules()
	self.dialogs = Dialogs.new(self.dialogLayer, self.host)
	local function getModel()
		return self.model
	end
	local function setStatus(text, kind)
		self:setStatus(text, kind)
	end
	local function openHelp(defId)
		self:openHelp(defId)
	end
	local function openWiki(defId)
		self:openWikiBlock(defId)
	end
	local function toggleFavorite(defId)
		return self:toggleFavorite(defId)
	end
	local function isFavorite(defId)
		return self:isFavorite(defId)
	end
	local function getWorkspace()
		return self.workspace
	end

	-- deps du canvas (SPEC §35 ; chacun facultatif pour le canvas)
	self.canvas = Canvas.new(self.canvasHost, {
		host = self.host,
		dialogs = self.dialogs,
		getModel = getModel,
		isOverPalette = function(p)
			return self.palette ~= nil and self.palette:isInside(p)
		end,
		setStatus = setStatus,
		dragLayer = self.dragLayer,
		openHelp = openHelp,
		getGuiNames = function(filter)
			return self:getGuiNames(filter)
		end,
		promptText = function(title, defaultText, onOk)
			self.dialogs:prompt(
				title,
				"Écris le nom exact (comme dans le Studio d'interface) :",
				tostring(defaultText or ""),
				onOk
			)
		end,
		onBlockHover = function(blockId, entering)
			self:_onBlockHover(blockId, entering)
		end,
		openHitboxPreview = function(blockId)
			self:openHitboxPreview(blockId)
		end,
		canPreviewHitbox = function(defId)
			return self:_canPreviewHitbox(defId)
		end,
		explain = function()
			self:explain(true)
		end,
		showCodeAt = function(blockId)
			self:showCodeAt(blockId)
		end,
		showCode = function()
			self:showCode()
		end,
		openWiki = openWiki,
		openSettings = function(section)
			self:openSettings(section)
		end,
		shareScript = function()
			self:shareScript()
		end,
		importCode = function()
			self:importCode()
		end,
		toggleFavorite = toggleFavorite,
		isFavorite = isFavorite,
		getWorkspace = getWorkspace,
		-- lignes entre les blocs (SPEC §36) : « toujours » | « survol » | « jamais »
		getLinkMode = function()
			return self:getLinkMode()
		end,
		setLinkMode = function(mode)
			return self:setLinkMode(mode)
		end,
	})
	self.palette = Palette.new(self.paletteHost, {
		host = self.host,
		dialogs = self.dialogs,
		canvas = self.canvas,
		getModel = getModel,
		setStatus = setStatus,
		openHelp = openHelp,
		insertModele = function(id, screenPos)
			return self:insertModele(id, screenPos)
		end,
		toggleFavorite = toggleFavorite,
		isFavorite = isFavorite,
		openWiki = openWiki,
		getWorkspace = getWorkspace,
	})
	self.topbar = TopBar.new(self.topBarHost, { app = self, dialogs = self.dialogs, host = self.host })
	self.codeview = CodeView.new(self.codeLayer, { dialogs = self.dialogs })
	-- Vue du code fermée par son « × » : « Voir le code » ne reste pas enfoncé dans la barre
	local codePanel = self.codeview and self.codeview.panel
	if typeof(codePanel) == "Instance" then
		table.insert(self.connections, codePanel:GetPropertyChangedSignal("Visible"):Connect(function()
			if not self._destroyed then
				self:_updateTopBar()
			end
		end))
	end
	self:_createProblemsPanel()
end

function App:_createProblemsPanel()
	local DetecteurPanel, err = optionalModule("DetecteurPanel")
	if DetecteurPanel == nil or type(DetecteurPanel.new) ~= "function" then
		warn("[Blocs FR] Panneau du détecteur indisponible : " .. tostring(err))
		return
	end
	local ok, panel = pcall(DetecteurPanel.new, self.problemsLayer, {
		dialogs = self.dialogs,
		host = self.host,
		onSelectProblem = function(problem)
			self:_selectProblem(problem)
		end,
		onRecheck = function()
			self:recheck()
		end,
		onClearTest = function()
			self:clearTestErrors()
		end,
		-- Fermeture par le « × » du panneau : le bouton de la barre d'outils ne reste pas enfoncé
		onVisibilityChanged = function()
			if not self._destroyed then
				self:_updateTopBar()
			end
		end,
	})
	if ok and type(panel) == "table" then
		self.problemsPanel = panel
	else
		warn("[Blocs FR] Impossible de créer le panneau du détecteur : " .. tostring(panel))
	end
end

---------------------------------------------------------------------------
-- Modèle et rafraîchissements
---------------------------------------------------------------------------

function App:_safe(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[Blocs FR] " .. name .. " : " .. tostring(err))
		self:setStatus("Erreur interne (" .. name .. ") : " .. tostring(err), "error")
	end
	return ok
end

function App:_mouse()
	local fn = self.host.getMousePosition
	if type(fn) == "function" then
		local ok, p = pcall(fn)
		if ok and typeof(p) == "Vector2" then
			return p
		end
	end
	return Vector2.new(0, 0)
end

function App:_connectModel()
	if self.modelConnection then
		local old = self.modelConnection
		self.modelConnection = nil
		pcall(function()
			old:Disconnect()
		end)
	end
	local model = self.model
	if model and model.Changed then
		self.modelConnection = model.Changed:Connect(function(reason)
			if self._destroyed or self.model ~= model then
				return
			end
			self:_onModelChanged(reason)
		end)
	end
end

function App:_onModelChanged(reason)
	if self.workspace == "interface" and reason ~= "undo" and reason ~= "redo" then
		self._lastEdited = "blocs"
	end
	self:_safe("canvas", function()
		self.canvas:refresh()
	end)
	self:_safe("palette", function()
		self.palette:refresh()
	end)
	self:_updateTopBar()
	self:_updateCount()
	self:_updateZoneHeader()
	if self:_codeVisible() then
		self:_showGeneratedCode(true)
	end
	if self.workspace == "interface" then
		self:_refreshLinkHighlight()
	end
	self:_scheduleAnalysis()
end

function App:_refreshAll()
	if self.canvas then
		self:_safe("canvas", function()
			self.canvas:refresh()
		end)
	end
	if self.palette then
		self:_safe("palette", function()
			self.palette:refresh()
		end)
	end
	self:_updateTopBar()
	self:_updateCount()
	self:_updateZoneHeader()
end

function App:_hasScript()
	return isAlive(self.scriptInstance)
end

function App:_targetPath()
	if self.target == nil then
		if self.workspace == "interface" then
			return "(écran pas encore enregistré)"
		end
		return "(aucune)"
	end
	if not isAlive(self.target) then
		return "(cible supprimée)"
	end
	return pathOf(self.target)
end

-- Le script ouvert a été déplacé dans l'Explorateur : la cible le suit (sinon l'enregistrement
-- suivant créerait un deuxième script dans l'ancienne cible). Renvoie true si la cible a changé.
function App:_followScript()
	if self.workspace == "interface" then
		return false
	end
	local scriptInst = self.scriptInstance
	if not isAlive(scriptInst) then
		return false
	end
	local ok, parent = pcall(function()
		return scriptInst.Parent
	end)
	if not ok or typeof(parent) ~= "Instance" or parent == game or parent == self.target then
		return false
	end
	if isProjectScript(parent) then
		return false
	end
	self.target = parent
	return true
end

function App:_problemsVisible()
	local panel = self.problemsPanel
	if not panel then
		return false
	end
	local ok, visible = pcall(function()
		return panel:isVisible()
	end)
	return ok and visible == true
end

function App:_explainVisible()
	local panel = self.explicationPanel
	if not panel then
		return false
	end
	local ok, visible = pcall(function()
		return panel:isVisible()
	end)
	return ok and visible == true
end

function App:_codeVisible()
	local codeview = self.codeview
	if not codeview then
		return false
	end
	local ok, visible = pcall(function()
		return codeview:isVisible()
	end)
	return ok and visible == true
end

-- Un seul panneau à la fois sur la droite (détecteur, explication, code)
function App:_hideRightPanels(except)
	if except ~= "problems" and self:_problemsVisible() then
		pcall(function()
			self.problemsPanel:hide()
		end)
	end
	if except ~= "explain" and self:_explainVisible() then
		pcall(function()
			self.explicationPanel:hide()
		end)
	end
	if except ~= "code" and self:_codeVisible() then
		pcall(function()
			self.codeview:hide()
		end)
	end
end

-- Largeur du canvas cachée à droite par un panneau ouvert (pour centrer un bloc dans la partie visible)
function App:_rightInset()
	local visible = self:_problemsVisible() or self:_explainVisible() or self:_codeVisible()
	if not visible then
		return 0
	end
	local panelW = Theme.Layout.ProblemsPanelWidth or 430
	local frame = self.canvas and self.canvas.frame
	if not frame or not self.root then
		return panelW
	end
	local rootRight = self.root.AbsolutePosition.X + self.root.AbsoluteSize.X
	local canvasRight = frame.AbsolutePosition.X + frame.AbsoluteSize.X
	return math.max(0, canvasRight - (rootRight - panelW))
end

function App:_updateTopBar()
	if self._destroyed or not self.topbar then
		return
	end
	local model = self.model
	local interface = self.workspace == "interface"
	local canUndo, canRedo = false, false
	if interface then
		canUndo = self:_undoRoute("undo") ~= nil
		canRedo = self:_undoRoute("redo") ~= nil
	else
		pcall(function()
			canUndo = model:canUndo() == true
			canRedo = model:canRedo() == true
		end)
	end
	local zoom = 1
	if self.canvas then
		pcall(function()
			zoom = tonumber(self.canvas:getZoom()) or 1
		end)
	end
	-- problems = nil tant qu'aucune analyse n'a eu lieu (la barre affiche alors un ✓ neutre)
	local problems = nil
	local counts = self._problemCounts
	if (self._analyzedOnce and self._detectorAvailable) or #self._problems > 0 then
		problems = {
			erreur = counts.erreur,
			avertissement = counts.avertissement,
			conseil = counts.conseil,
		}
	end
	local dirty = model ~= nil and model.dirty == true
	if interface then
		dirty = dirty or self:_editorDirty()
	end
	local state = {
		workspace = self.workspace,
		targetPath = self:_targetPath(),
		mode = model and model.mode,
		dirty = dirty,
		canUndo = canUndo,
		canRedo = canRedo,
		zoom = zoom,
		hasScript = self:_hasScript(),
		problems = problems,
		problemsVisible = self:_problemsVisible(),
		explainVisible = self:_explainVisible(),
		codeVisible = self:_codeVisible(),
		screenName = self:_currentScreenName(),
		screenSaved = self:_currentScreenGui() ~= nil,
		screenPath = self:_screenPath(),
		previewOn = self._previewOn == true,
	}
	self:_safe("barre d'outils", function()
		self.topbar:update(state)
	end)
end

function App:_updateCount()
	if not self.countLabel then
		return
	end
	local n = 0
	pcall(function()
		n = tonumber(self.model:count()) or 0
	end)
	self.countLabel.Text = plural(n, "bloc")
	self:_layoutStatus()
end

-- Remplace le projet affiché (session de l'onglet affiché). target / script facultatifs.
function App:loadModel(model, target, scriptInst)
	if self._destroyed or not model then
		return
	end
	self.model = model
	if typeof(target) == "Instance" then
		self.target = target
	elseif typeof(scriptInst) == "Instance" and scriptInst.Parent then
		self.target = scriptInst.Parent
	end
	if typeof(scriptInst) == "Instance" then
		self.scriptInstance = scriptInst
	else
		self.scriptInstance = nil
	end
	self:_syncSession()
	self:_connectModel()
	if self.canvas then
		pcall(function()
			self.canvas:resetView()
		end)
	end
	-- Les problèmes de l'ancien projet ne concernent plus ces blocs
	self._staticProblems = {}
	self._codeOk = nil
	self._codeErr = nil
	self:_rebuildTestProblems()
	self:_refreshAll()
	if self:_codeVisible() then
		self:_showGeneratedCode(true)
	end
	self:_scheduleAnalysis(0.05)
end

function App:getModel()
	return self.model
end

---------------------------------------------------------------------------
-- Sessions et onglets (SPEC §21.8)
---------------------------------------------------------------------------

-- Recopie self.model / target / scriptInstance dans la session affichée
function App:_syncSession()
	local name = self._activeSession
	local s = name and self.sessions[name]
	if s then
		s.model = self.model
		s.target = self.target
		s.scriptInstance = self.scriptInstance
	end
end

-- Champs à jour d'une session (ceux de self pour la session affichée)
function App:_sessionState(name)
	if name ~= nil and name == self._activeSession then
		return { model = self.model, target = self.target, scriptInstance = self.scriptInstance }
	end
	return self.sessions[name]
end

function App:_canvasView()
	local canvas = self.canvas
	if not canvas or type(canvas.getViewState) ~= "function" then
		return nil
	end
	local ok, view = pcall(canvas.getViewState, canvas)
	if ok and type(view) == "table" then
		return view
	end
	return nil
end

function App:_restoreView(view)
	local canvas = self.canvas
	if not canvas then
		return
	end
	if type(view) == "table" and type(canvas.setViewState) == "function" then
		local ok = pcall(canvas.setViewState, canvas, view)
		if ok then
			return
		end
	end
	pcall(function()
		canvas:resetView()
	end)
end

-- Affiche une session : modèle, cible, script, vue du canvas, problèmes, analyse
function App:_activateSession(name)
	local previous = self._activeSession
	if previous ~= nil and self.sessions[previous] then
		self:_syncSession()
		if previous ~= name then
			self.sessions[previous].view = self:_canvasView()
		end
	end
	local s = self.sessions[name]
	self._activeSession = name
	self.model = s.model
	self.target = s.target
	self.scriptInstance = s.scriptInstance
	self:_connectModel()
	if self.canvas and type(self.canvas.clearSelection) == "function" then
		pcall(self.canvas.clearSelection, self.canvas)
	end
	self._staticProblems = {}
	self._codeOk = nil
	self._codeErr = nil
	self:_rebuildTestProblems()
	self:_refreshAll()
	self:_restoreView(s.view)
	if self:_codeVisible() then
		self:_showGeneratedCode(true)
	end
	self:_scheduleAnalysis(0.05)
end

-- Remplace la session de l'écran (modèle, ScreenGui, script) ; la réaffiche si elle est affichée
function App:_setInterfaceSession(model, target, scriptInst)
	local s = self.sessions.interface
	local active = self._activeSession == "interface"
	if active then
		self:_syncSession()
	end
	s.model = model or emptyModel("local")
	if isAlive(target) then
		s.target = target
	else
		s.target = nil
	end
	if isAlive(scriptInst) then
		s.scriptInstance = scriptInst
	else
		s.scriptInstance = nil
	end
	s.view = nil
	if active then
		self._activeSession = nil -- (pas de recopie : la session vient d'être remplacée)
		self:_activateSession("interface")
	end
	-- le Studio suit le nouveau Model (points cyan des calques, « Blocs de cet élément »)
	local editor = self.guiEditor
	if editor and type(editor.refreshLinks) == "function" then
		pcall(editor.refreshLinks, editor)
	end
end

-- Change la cible / le script de la session de l'écran (après un enregistrement)
function App:_setInterfaceTarget(target, scriptInst)
	local s = self.sessions.interface
	if isAlive(target) then
		s.target = target
	end
	if scriptInst ~= nil then
		if isAlive(scriptInst) then
			s.scriptInstance = scriptInst
		end
	end
	if self._activeSession == "interface" then
		self.target = s.target
		self.scriptInstance = s.scriptInstance
	end
end

function App:getWorkspace()
	return self.workspace
end

function App:getGuiEditor()
	return self.guiEditor
end

-- « Blocs » (projets des objets) ou « Interface » (écrans + leurs blocs). instant : sans fondu.
function App:setWorkspace(name, instant)
	if self._destroyed or WORKSPACES[name] == nil then
		return false
	end
	if name == self.workspace then
		if name == "interface" then
			self:_ensureGuiEditor()
		end
		return true
	end
	self:_onBlockHover(nil, false)
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	self:_endSplitDrag()
	self.workspace = name
	self:_applyWorkspaceLayout()
	if name == "interface" then
		self:_ensureGuiEditor()
	end
	self:_activateSession(name)
	self:_updateCanvasHint()
	self:_refreshLinkHighlight()
	self:_updateZoneHeader()
	self:_updateTopBar()
	if instant ~= true then
		self:_crossFade()
	end
	if name == "interface" then
		if self.guiEditor == nil then
			self:setStatus(
				"Le Studio d'interface n'a pas pu être chargé : tu peux quand même modifier les blocs des écrans existants (menu « Écran »).",
				"warning"
			)
		elseif self:_currentScreenName() == nil then
			self:setStatus("Crée ton premier écran : un écran vide ou un des 8 modèles (menu « Écran »).", "info")
		else
			self:setStatus(
				"Écran « " .. self:_currentScreenName() .. " » : dessine-le au-dessus, ses blocs vont en dessous.",
				"info"
			)
		end
	else
		self:setStatus("Onglet Blocs : programme l'objet choisi dans l'Explorateur.", "info")
	end
	-- Main : bouton « Interface » de la barre d'outils de Studio
	local notify = self.host.onWorkspaceChanged
	if type(notify) == "function" then
		pcall(notify, name)
	end
	return true
end

-- Place les hôtes de la palette et du canvas selon l'onglet
function App:_applyWorkspaceLayout()
	if self.workspace == "interface" then
		self:_buildGuiBody()
		self.blocsBody.Visible = false
		self.guiBody.Visible = true
		self.paletteHost.Parent = self.zoneBody
		self.canvasHost.Parent = self.zoneBody
		self:_layoutGui()
	else
		if self.guiBody then
			self.guiBody.Visible = false
		end
		self.blocsBody.Visible = true
		local panelW = Theme.Layout.PanelWidth
		self.paletteHost.Parent = self.blocsBody
		self.paletteHost.Position = UDim2.fromOffset(0, 0)
		self.paletteHost.Size = UDim2.new(0, panelW - 1, 1, 0)
		self.canvasHost.Parent = self.blocsBody
		self.canvasHost.Position = UDim2.fromOffset(panelW, 0)
		self.canvasHost.Size = UDim2.new(1, -panelW, 1, 0)
		self:_notifyPaletteWidth(panelW)
	end
end

-- La palette change de largeur (zone « Blocs de l'écran ») : palette:setWidth(w) si elle sait se
-- remettre en page (sinon elle suit la taille de son cadre)
function App:_notifyPaletteWidth(w)
	if w == self._paletteWidth then
		return
	end
	self._paletteWidth = w
	local palette = self.palette
	if palette and type(palette.setWidth) == "function" then
		pcall(palette.setWidth, palette, w)
	end
end

-- Changement d'onglet : le contenu réapparaît en fondu (0,2 s)
function App:_crossFade()
	local Anim = getAnim()
	if not Anim or not animEnabled() or not self.body then
		return
	end
	local veil = Util.create("Frame", {
		Name = "TransitionOnglet",
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = self.body,
	})
	Anim.tween(veil, { BackgroundTransparency = 1 }, CROSSFADE_TIME, "quadOut", function()
		pcall(function()
			veil:Destroy()
		end)
	end)
end

-- Astuce du canvas selon l'onglet (canvas:setHint si le canvas la propose)
function App:_updateCanvasHint()
	local canvas = self.canvas
	if not canvas or type(canvas.setHint) ~= "function" then
		return
	end
	local text = nil
	if self.workspace == "interface" then
		text = "Glisse des blocs ici · survole un bloc : son élément s'allume dans l'aperçu"
	end
	pcall(canvas.setHint, canvas, text)
end

---------------------------------------------------------------------------
-- Onglet Interface : disposition, séparateur, en-tête de la zone « Blocs de l'écran »
---------------------------------------------------------------------------

function App:_buildGuiBody()
	if self.guiBody then
		return
	end
	local L = Theme.Layout
	local headerH = L.GuiBlocksHeaderHeight or 40
	local body = Util.create("Frame", {
		Name = "Interface",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = self.body,
	})
	self.guiBody = body
	self.guiLeft = Util.create("Frame", {
		Name = "ColonneGauche",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(0, 249, 1, 0),
		ZIndex = 2,
		Parent = body,
	})
	self.guiLeftBorder = Util.create("Frame", {
		Name = "BordureGauche",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 3,
		Parent = body,
	})
	self.guiRight = Util.create("Frame", {
		Name = "ColonneDroite",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 299, 1, 0),
		ZIndex = 2,
		Parent = body,
	})
	self.guiRightBorder = Util.create("Frame", {
		Name = "BordureDroite",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 3,
		Parent = body,
	})
	self.guiCenter = Util.create("Frame", {
		Name = "ColonneCentre",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = body,
	})
	self.previewHost = Util.create("Frame", {
		Name = "Apercu",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = self.guiCenter,
	})

	-- Séparateur réglable (glisser ; clic droit : menu de la zone)
	local splitter = Util.create("TextButton", {
		Name = "Separateur",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Splitter or C.Panel,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = self.guiCenter,
	})
	self.splitter = splitter
	for _, spec in ipairs({ { 0, 0 }, { 1, -1 } }) do
		Util.create("Frame", {
			Name = "Trait",
			BackgroundColor3 = C.PanelBorder,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.new(0, 0, spec[1], spec[2]),
			Size = UDim2.new(1, 0, 0, 1),
			ZIndex = 4,
			Parent = splitter,
		})
	end
	self.splitterGrip = Util.create("Frame", {
		Name = "Poignee",
		BackgroundColor3 = C.ButtonActive,
		BorderSizePixel = 0,
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(44, 4),
		ZIndex = 4,
		Parent = splitter,
	})
	Util.corner(self.splitterGrip, 2)

	-- Zone « Blocs de l'écran » : en-tête + corps (palette | canvas)
	self.zone = Util.create("Frame", {
		Name = "BlocsEcran",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = self.guiCenter,
	})
	local header = Util.create("TextButton", {
		Name = "Entete",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.darken(C.Panel, 0.06),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, headerH),
		ZIndex = 2,
		Parent = self.zone,
	})
	self.zoneHeader = header
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 3,
		Parent = header,
	})
	self.zoneArrow = makeLabel({
		Name = "Fleche",
		Text = "▼",
		TextSize = 10,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 18, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		ZIndex = 3,
		Parent = header,
	})
	self.zoneTitle = makeLabel({
		Name = "Titre",
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 32, 0.5, 0),
		Size = UDim2.fromOffset(200, 20),
		ZIndex = 3,
		Parent = header,
	})
	self.zoneBadge = Util.create("Frame", {
		Name = "Badge",
		BackgroundColor3 = Theme.darken(C.Info, 0.55),
		BorderSizePixel = 0,
		Active = false,
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(120, 20),
		ZIndex = 3,
		Parent = header,
	})
	Util.corner(self.zoneBadge, 6)
	self.zoneBadgeLabel = makeLabel({
		Name = "Texte",
		Font = Theme.Fonts.UIBold,
		TextSize = 11,
		TextColor3 = C.AccentText,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = self.zoneBadge,
	})
	self.zoneProblems = Util.create("TextButton", {
		Name = "Problemes",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.ButtonHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(110, 26),
		ZIndex = 3,
		Parent = header,
	})
	Util.corner(self.zoneProblems, 6)
	self.zoneProblemsLabel = makeLabel({
		Name = "Texte",
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextColor3 = C.SuccessText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = self.zoneProblems,
	})
	self.zoneCode = self:_zoneButton("VoirCode", "Voir le code", function()
		self:toggleCode()
	end)
	self.zoneGrow = self:_zoneButton("Agrandir", "Agrandir", function()
		self:cycleSplit()
	end)

	self.zoneBody = Util.create("Frame", {
		Name = "Corps",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, headerH),
		Size = UDim2.new(1, 0, 1, -headerH),
		ZIndex = 1,
		Parent = self.zone,
	})
	self.zonePaletteBorder = Util.create("Frame", {
		Name = "BordurePalette",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 3,
		Parent = self.zoneBody,
	})

	local c = self.connections
	table.insert(c, splitter.MouseButton1Down:Connect(function()
		self:_beginSplitDrag()
	end))
	table.insert(c, splitter.MouseButton2Click:Connect(function()
		self:_openZoneMenu()
	end))
	table.insert(c, splitter.MouseEnter:Connect(function()
		if self.splitterGrip then
			self.splitterGrip.BackgroundColor3 = C.TextDim
		end
	end))
	table.insert(c, splitter.MouseLeave:Connect(function()
		if self.splitterGrip then
			self.splitterGrip.BackgroundColor3 = C.ButtonActive
		end
	end))
	table.insert(c, header.MouseButton1Click:Connect(function()
		self:toggleZone()
	end))
	table.insert(c, header.MouseButton2Click:Connect(function()
		self:_openZoneMenu()
	end))
	table.insert(c, self.zoneProblems.MouseEnter:Connect(function()
		self.zoneProblems.BackgroundTransparency = 0
	end))
	table.insert(c, self.zoneProblems.MouseLeave:Connect(function()
		self.zoneProblems.BackgroundTransparency = 1
	end))
	table.insert(c, self.zoneProblems.MouseButton1Click:Connect(function()
		self:toggleProblems()
	end))
	table.insert(c, self.zoneProblems.MouseButton2Click:Connect(function()
		self:_openProblemsMenu()
	end))
	table.insert(c, self.body:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if self.workspace == "interface" then
			self:_layoutGui()
		end
	end))
	table.insert(c, header:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_layoutZoneHeader()
	end))
	self:_updateZoneHeader()
end

-- Bouton de l'en-tête de la zone (28 px, comme « Voir le code » sur le board)
function App:_zoneButton(name, text, onClick)
	local button = Util.create("TextButton", {
		Name = name,
		Text = text,
		Font = Theme.Fonts.UI,
		TextSize = 12,
		TextColor3 = C.Text,
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(textWidth(text, 12, Theme.Fonts.UI) + 24, 28),
		ZIndex = 3,
		Parent = self.zoneHeader,
	})
	Util.corner(button, 7)
	local Anim = getAnim()
	if Anim and type(Anim.hover) == "function" then
		local okHover, disconnectHover = pcall(Anim.hover, button, C.Button, C.ButtonHover)
		if okHover and type(disconnectHover) == "function" then
			table.insert(self.connections, { Disconnect = disconnectHover })
		end
	end
	if Anim and type(Anim.press) == "function" then
		local okPress, disconnectPress = pcall(Anim.press, button)
		if okPress and type(disconnectPress) == "function" then
			table.insert(self.connections, { Disconnect = disconnectPress })
		end
	end
	table.insert(self.connections, button.MouseButton1Click:Connect(function()
		local ok, err = pcall(onClick)
		if not ok then
			warn("[Blocs FR] Zone des blocs de l'écran : " .. tostring(err))
		end
	end))
	return button
end

-- Largeurs des colonnes gauche / droite : réduites quand la fenêtre est étroite
function App:_guiSideWidths(totalW)
	local L = Theme.Layout
	local leftW = L.GuiLeftWidth or 250
	local rightW = L.GuiRightWidth or 300
	local center = totalW - leftW - rightW
	if center < GUI_CENTER_MIN then
		local excess = GUI_CENTER_MIN - center
		local canLeft = math.max(0, leftW - GUI_LEFT_MIN)
		local canRight = math.max(0, rightW - GUI_RIGHT_MIN)
		local total = canLeft + canRight
		if total > 0 then
			local k = math.min(1, excess / total)
			leftW = math.floor(leftW - canLeft * k)
			rightW = math.floor(rightW - canRight * k)
		end
	end
	return leftW, rightW
end

function App:_layoutGui()
	if self._destroyed or not self.guiBody or not self.body then
		return
	end
	local size = self.body.AbsoluteSize
	local W, H = size.X, size.Y
	if W < 20 or H < 20 then
		return
	end
	local L = Theme.Layout
	local leftW, rightW = self:_guiSideWidths(W)
	self.guiLeft.Size = UDim2.new(0, leftW - 1, 1, 0)
	self.guiLeftBorder.Position = UDim2.fromOffset(leftW - 1, 0)
	self.guiRight.Size = UDim2.new(0, rightW - 1, 1, 0)
	self.guiRightBorder.Position = UDim2.new(1, -rightW, 0, 0)
	self.guiCenter.Position = UDim2.fromOffset(leftW, 0)
	self.guiCenter.Size = UDim2.new(1, -(leftW + rightW), 1, 0)

	local splitterH = L.GuiSplitterHeight or 14
	local headerH = L.GuiBlocksHeaderHeight or 40
	local minPreview = L.GuiPreviewMinHeight or 200
	local minBlocks = L.GuiBlocksMinHeight or 160
	local avail = math.max(0, H - splitterH)
	local previewH
	if self._zoneCollapsed then
		previewH = math.max(0, avail - headerH)
	else
		local maxPreview = avail - minBlocks
		if maxPreview < minPreview then
			-- pas la place pour les deux minimums : partage proportionnel
			previewH = math.floor(avail * minPreview / (minPreview + minBlocks))
		else
			previewH = math.floor(Util.clamp(avail * self._split, minPreview, maxPreview) + 0.5)
		end
	end
	self.previewHost.Position = UDim2.fromOffset(0, 0)
	self.previewHost.Size = UDim2.new(1, 0, 0, previewH)
	self.splitter.Position = UDim2.fromOffset(0, previewH)
	self.splitter.Size = UDim2.new(1, 0, 0, splitterH)
	self.zone.Position = UDim2.fromOffset(0, previewH + splitterH)
	self.zone.Size = UDim2.new(1, 0, 1, -(previewH + splitterH))
	self.zoneBody.Visible = not self._zoneCollapsed

	-- palette de la zone : 230 px, moins quand la colonne est étroite
	local centerW = W - leftW - rightW
	local paletteW = math.floor(Util.clamp(centerW * 0.38, ZONE_PALETTE_MIN, L.GuiPaletteWidth or 230))
	self.zonePaletteBorder.Position = UDim2.fromOffset(paletteW - 1, 0)
	if self.workspace == "interface" then
		self.paletteHost.Position = UDim2.fromOffset(0, 0)
		self.paletteHost.Size = UDim2.new(0, paletteW - 1, 1, 0)
		self.canvasHost.Position = UDim2.fromOffset(paletteW, 0)
		self.canvasHost.Size = UDim2.new(1, -paletteW, 1, 0)
		self:_notifyPaletteWidth(paletteW)
	end
	self:_layoutZoneHeader()
end

-- Texte du bouton « Agrandir » : ce que fera le prochain clic
function App:_growLabel()
	if self._zoneCollapsed then
		return "Déplier"
	end
	local nextIndex = (self._splitIndex % #SPLIT_CYCLE) + 1
	if SPLIT_CYCLE[nextIndex] < self._split then
		return "Agrandir"
	end
	return "Réduire"
end

function App:_updateZoneHeader()
	if self._destroyed or not self.zoneHeader then
		return
	end
	local name = self:_currentScreenName()
	if name then
		self.zoneTitle.Text = "Blocs de l'écran « " .. name .. " »"
	else
		self.zoneTitle.Text = "Blocs de l'écran"
	end
	local s = self:_sessionState("interface")
	local badge
	if name == nil then
		badge = "aucun écran ouvert"
	elseif s and isAlive(s.scriptInstance) then
		local kind = "script local"
		if s.model and s.model.mode ~= "local" then
			kind = "script"
		end
		local where = name
		local gui = self:_currentScreenGui()
		if gui then
			where = gui.Name
		end
		badge = kind .. " · " .. where .. " → " .. s.scriptInstance.Name
	else
		badge = "pas encore enregistré"
	end
	self.zoneBadgeLabel.Text = badge

	-- Problèmes des blocs de l'écran (ceux de l'onglet affiché)
	local counts = self._problemCounts
	local total = counts.erreur + counts.avertissement + counts.conseil
	local label = self.zoneProblemsLabel
	if self.workspace ~= "interface" or not self._analyzedOnce then
		label.Text = "Analyse…"
		label.TextColor3 = C.TextDim
	elseif total == 0 then
		label.Text = "✓ Aucun problème"
		label.TextColor3 = C.SuccessText
	else
		local worst = "conseil"
		if counts.erreur > 0 then
			worst = "erreur"
		elseif counts.avertissement > 0 then
			worst = "avertissement"
		end
		label.Text = "⚠ " .. total
		label.TextColor3 = themeColor(SEVERITY_TEXT_KEYS[worst])
	end
	if self._zoneCollapsed then
		self.zoneArrow.Rotation = -90
	else
		self.zoneArrow.Rotation = 0
	end
	self.zoneGrow.Text = self:_growLabel()
	self:_layoutZoneHeader()
end

-- Place les éléments de l'en-tête (de droite à gauche : Agrandir, Voir le code, problèmes ; puis le titre
-- et le badge) ; quand l'en-tête est étroit, le badge puis « Voir le code » disparaissent
function App:_layoutZoneHeader()
	if not self.zoneHeader then
		return
	end
	local W = self.zoneHeader.AbsoluteSize.X
	if W < 40 then
		return
	end
	local growW = textWidth(self.zoneGrow.Text, 12, Theme.Fonts.UI) + 24
	local codeW = textWidth(self.zoneCode.Text, 12, Theme.Fonts.UI) + 24
	local problemsW = textWidth(self.zoneProblemsLabel.Text, 12, Theme.Fonts.UIBold) + 14
	local titleX = 32
	local minTitle = 90
	local showCode = W >= titleX + minTitle + problemsW + codeW + growW + 40
	local showProblems = W >= titleX + minTitle + problemsW + growW + 30
	local x = W - 10
	self.zoneGrow.Position = UDim2.new(0, x, 0.5, 0)
	self.zoneGrow.Size = UDim2.fromOffset(growW, 28)
	x -= growW + 8
	self.zoneCode.Visible = showCode
	if showCode then
		self.zoneCode.Position = UDim2.new(0, x, 0.5, 0)
		self.zoneCode.Size = UDim2.fromOffset(codeW, 28)
		x -= codeW + 8
	end
	self.zoneProblems.Visible = showProblems
	if showProblems then
		self.zoneProblems.Position = UDim2.new(0, x, 0.5, 0)
		self.zoneProblems.Size = UDim2.fromOffset(problemsW, 26)
		x -= problemsW + 8
	end
	local avail = x - titleX - 4
	local titleNatural = textWidth(self.zoneTitle.Text, 13, Theme.Fonts.UIBold) + 2
	local badgeW = textWidth(self.zoneBadgeLabel.Text, 11, Theme.Fonts.UIBold) + 16
	local showBadge = avail >= titleNatural + 10 + badgeW
	local reserved = 0
	if showBadge then
		reserved = badgeW + 10
	end
	local titleW = math.max(0, math.min(titleNatural, avail - reserved))
	self.zoneTitle.Size = UDim2.fromOffset(titleW, 20)
	self.zoneBadge.Visible = showBadge
	if showBadge then
		self.zoneBadge.Position = UDim2.new(0, titleX + titleW + 10, 0.5, 0)
		self.zoneBadge.Size = UDim2.fromOffset(badgeW, 20)
	end
end

-- Replie (collapse = true) ou déplie la zone des blocs de l'écran (nil : bascule)
function App:toggleZone(collapse)
	if self._destroyed then
		return
	end
	if collapse == nil then
		collapse = not self._zoneCollapsed
	end
	self._zoneCollapsed = collapse == true
	self:_layoutGui()
	self:_updateZoneHeader()
end

-- « Agrandir » : la part de l'aperçu passe de 55 % à 25 % puis 80 % (la zone repliée se déplie d'abord)
function App:cycleSplit()
	if self._destroyed then
		return
	end
	if self._zoneCollapsed then
		self:toggleZone(false)
		return
	end
	local nextIndex = (self._splitIndex % #SPLIT_CYCLE) + 1
	self._splitIndex = nextIndex
	self:_animateSplit(SPLIT_CYCLE[nextIndex])
end

function App:_animateSplit(target)
	local from = self._split
	local Anim = getAnim()
	if not Anim or not animEnabled() or type(Anim.step) ~= "function" then
		self._split = target
		self:_layoutGui()
		self:_updateZoneHeader()
		return
	end
	-- (le texte du bouton suit la valeur visée tout de suite)
	self._split = target
	self:_updateZoneHeader()
	self._split = from
	Anim.step(function(k)
		if self._destroyed then
			return
		end
		self._split = from + (target - from) * k
		self:_layoutGui()
	end, 0.22, "quintOut", function()
		if not self._destroyed then
			self._split = target
			self:_layoutGui()
			self:_updateZoneHeader()
		end
	end, self)
end

-- Glisser le séparateur entre l'aperçu et les blocs de l'écran
function App:_beginSplitDrag()
	if self._destroyed or self._splitDrag or not self.guiCenter or not self.dragLayer then
		return
	end
	if self._zoneCollapsed then
		self:toggleZone(false)
	end
	local splitterH = Theme.Layout.GuiSplitterHeight or 14
	local startMouse = self:_mouse()
	local startPreview = self.previewHost.AbsoluteSize.Y
	local maid = Util.Maid.new()
	local drag = { maid = maid }
	self._splitDrag = drag
	local overlay = Util.create("TextButton", {
		Name = "GlisserSeparateur",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1000,
		Parent = self.dragLayer,
	})
	maid:give(overlay)
	local function finish()
		if self._splitDrag ~= drag then
			return
		end
		self._splitDrag = nil
		maid:clean()
		if self._destroyed or not self.guiCenter then
			return
		end
		-- la part réelle (bornée par les hauteurs minimales) ; « Agrandir » repart de la valeur la plus proche
		local avail = self.guiCenter.AbsoluteSize.Y - splitterH
		if avail > 0 then
			self._split = Util.clamp(self.previewHost.AbsoluteSize.Y / avail, 0.02, 0.98)
		end
		local best, bestDistance = 1, math.huge
		for i, value in ipairs(SPLIT_CYCLE) do
			local distance = math.abs(value - self._split)
			if distance < bestDistance then
				best, bestDistance = i, distance
			end
		end
		self._splitIndex = best
		self:_updateZoneHeader()
	end
	drag.finish = finish
	maid:give(RunService.Heartbeat:Connect(function()
		if self._destroyed or not self.guiCenter then
			finish()
			return
		end
		local p = self:_mouse()
		local avail = self.guiCenter.AbsoluteSize.Y - splitterH
		if avail <= 0 then
			return
		end
		local h = startPreview + (p.Y - startMouse.Y)
		self._split = Util.clamp(h / avail, 0.02, 0.98)
		self:_layoutGui()
	end))
	maid:give(overlay.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish()
		end
	end))
	maid:give(overlay.MouseButton1Up:Connect(finish))
	local widget = self.host.widget
	if typeof(widget) == "Instance" then
		pcall(function()
			maid:give(widget.WindowFocusReleased:Connect(finish))
		end)
	end
end

function App:_endSplitDrag()
	local drag = self._splitDrag
	if drag and type(drag.finish) == "function" then
		drag.finish()
	end
end

-- Clic droit sur l'en-tête de la zone ou sur le séparateur
function App:_openZoneMenu()
	if self._destroyed or not self.dialogs then
		return
	end
	local growText = "Agrandir la zone des blocs"
	if self:_growLabel() == "Réduire" then
		growText = "Réduire la zone des blocs"
	end
	local foldText = "Replier la zone des blocs"
	if self._zoneCollapsed then
		foldText = "Déplier la zone des blocs"
	end
	local items = {
		{ label = "Voir le code", value = "code", icon = "≡" },
		{ label = "Expliquer ce script", value = "expliquer", icon = "?" },
		{ label = "Détecteur d'erreurs", value = "problemes", icon = "⚠" },
		"separator",
		{ label = growText, value = "agrandir", hidden = self._zoneCollapsed },
		{ label = foldText, value = "replier", icon = "▼" },
		{ label = "Taille normale", value = "normal" },
		"separator",
		{ label = "Partager ce script…", value = "partager", icon = "→" },
		{ label = "Importer un code…", value = "importer", icon = "←" },
	}
	self.dialogs:menu(nil, items, function(value)
		if self._destroyed then
			return
		end
		if value == "code" then
			self:showCode()
		elseif value == "expliquer" then
			self:explain(true)
		elseif value == "problemes" then
			self:toggleProblems()
		elseif value == "agrandir" then
			self:cycleSplit()
		elseif value == "replier" then
			self:toggleZone()
		elseif value == "normal" then
			self._zoneCollapsed = false
			self._splitIndex = 1
			self:_animateSplit(SPLIT_DEFAULT)
		elseif value == "partager" then
			self:shareScript()
		elseif value == "importer" then
			self:importCode()
		end
	end)
end

-- Clic droit sur un bouton des problèmes (barre d'état, en-tête de la zone)
function App:_openProblemsMenu()
	if self._destroyed or not self.dialogs then
		return
	end
	local label = "Ouvrir le détecteur d'erreurs"
	if self:_problemsVisible() then
		label = "Fermer le détecteur d'erreurs"
	end
	local items = {
		{ label = label, value = "detecteur", icon = "⚠" },
		{ label = "Revérifier maintenant", value = "reverifier", icon = "✓" },
		"separator",
		{ label = "Effacer les erreurs du dernier test", value = "effacer", icon = "×" },
	}
	self.dialogs:menu(nil, items, function(value)
		if self._destroyed then
			return
		end
		if value == "detecteur" then
			self:toggleProblems()
		elseif value == "reverifier" then
			self:recheck()
		elseif value == "effacer" then
			self:clearTestErrors()
		end
	end)
end

---------------------------------------------------------------------------
-- Studio d'interface : l'éditeur d'écrans (GuiEditor, SPEC §21.8)
---------------------------------------------------------------------------

-- Crée l'éditeur d'écrans la première fois qu'on ouvre l'onglet Interface. Renvoie l'éditeur ou nil.
function App:_ensureGuiEditor()
	if self.guiEditor or self._guiEditorFailed or self._destroyed then
		return self.guiEditor
	end
	self:_buildGuiBody()
	local GuiEditor, err = optionalModule("GuiEditor")
	if GuiEditor == nil or type(GuiEditor.new) ~= "function" then
		self._guiEditorFailed = true
		self._guiEditorError = tostring(err or "module GuiEditor introuvable")
		self:_showEditorPlaceholder(self._guiEditorError)
		return nil
	end
	local deps = {
		app = self,
		dialogs = self.dialogs,
		host = self.host,
		dragLayer = self.dragLayer,
		-- Model des blocs de l'écran (zone du bas)
		getModel = function()
			return self:getInterfaceModel()
		end,
		-- Le Studio demande un autre écran (carte de départ, modèles, menus) : App s'en charge (même
		-- fenêtre « Enregistrer / Ne pas enregistrer / Annuler » et mêmes sessions de blocs que la barre)
		requestScreen = function(kind, arg)
			return self:_requestScreen(kind, arg)
		end,
		saveScreen = function()
			return self:saveScreen()
		end,
		-- (les mêmes que les méthodes de deps.app, pour un éditeur qui préfère des fonctions)
		getInterfaceModel = function()
			return self:getInterfaceModel()
		end,
		blocksForElement = function(name)
			return self:blocksForElement(name)
		end,
		addClickScript = function(name)
			return self:addClickScript(name)
		end,
		focusBlock = function(blockId)
			return self:focusBlock(blockId)
		end,
		loadScreenBlocks = function(data)
			return self:loadScreenBlocks(data)
		end,
		onScreenChanged = function(info)
			self:onScreenChanged(info)
		end,
		getGuiNames = function(filter)
			return self:getGuiNames(filter)
		end,
		setStatus = function(text, kind)
			self:setStatus(text, kind)
		end,
	}
	local ok, editor = pcall(GuiEditor.new, { left = self.guiLeft, preview = self.previewHost, right = self.guiRight }, deps)
	if not ok or type(editor) ~= "table" then
		self._guiEditorFailed = true
		self._guiEditorError = tostring(editor)
		warn("[Blocs FR] Studio d'interface indisponible : " .. tostring(editor))
		self:_showEditorPlaceholder(self._guiEditorError)
		return nil
	end
	self.guiEditor = editor
	local selectionSignal = editor.SelectionChanged
	if type(selectionSignal) == "table" and type(selectionSignal.Connect) == "function" then
		local okConnect, connection = pcall(function()
			return selectionSignal:Connect(function(id)
				self:_onEditorSelection(id)
			end)
		end)
		if okConnect and connection then
			table.insert(self.connections, connection)
		end
	end
	local docSignal = editor.DocChanged
	if type(docSignal) == "table" and type(docSignal.Connect) == "function" then
		local okConnect, connection = pcall(function()
			return docSignal:Connect(function(reason, info)
				self:_onEditorDocChanged(reason, info)
			end)
		end)
		if okConnect and connection then
			table.insert(self.connections, connection)
		end
	end
	-- Aperçu quitté depuis le Studio lui-même (bandeau « Quitter l'aperçu ») : la barre suit
	local previewSignal = editor.PreviewChanged
	if type(previewSignal) == "table" and type(previewSignal.Connect) == "function" then
		local okConnect, connection = pcall(function()
			return previewSignal:Connect(function(on)
				if self._destroyed then
					return
				end
				self._previewOn = on == true
				self:_updateTopBar()
			end)
		end)
		if okConnect and connection then
			table.insert(self.connections, connection)
		end
	end
	-- Premier écran : celui de l'éditeur précédent (paramètres appliqués), sinon la sélection, sinon le
	-- premier écran de StarterGui
	if self._restoringScreen ~= nil then
		local st = self._restoringScreen
		self._restoringScreen = nil
		self:_restoreEditorScreen(st)
	else
		self:_openInitialScreen()
	end
	self._screenDoc = self:_editorDoc()
	self._lastScreenName = self:_currentScreenName()
	return editor
end

-- Le Studio d'interface n'a pas pu être chargé : message dans l'aperçu
function App:_showEditorPlaceholder(err)
	if not self.previewHost then
		return
	end
	local old = self.previewHost:FindFirstChild("EditeurIndisponible")
	if old then
		old:Destroy()
	end
	local card = Util.create("Frame", {
		Name = "EditeurIndisponible",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 120),
		Parent = self.previewHost,
	})
	Util.corner(card, 12)
	Util.stroke(card, C.PanelBorder, 1)
	makeLabel({
		Text = "Le Studio d'interface n'a pas pu être chargé",
		Font = Theme.Fonts.UIBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(12, 16),
		Size = UDim2.new(1, -24, 0, 22),
		Parent = card,
	})
	makeLabel({
		Text = "Tu peux quand même modifier et enregistrer les blocs des écrans existants (menu « Écran » en haut). Détail : "
			.. tostring(err),
		TextSize = 12,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(16, 46),
		Size = UDim2.new(1, -32, 0, 64),
		Parent = card,
	})
end

function App:_editorDoc()
	local editor = self.guiEditor
	if not editor or type(editor.getDoc) ~= "function" then
		return nil
	end
	local ok, doc = pcall(editor.getDoc, editor)
	if ok and type(doc) == "table" then
		return doc
	end
	return nil
end

function App:_editorScreenGui()
	local editor = self.guiEditor
	if not editor or type(editor.getScreenGui) ~= "function" then
		return nil
	end
	local ok, gui = pcall(editor.getScreenGui, editor)
	if ok and isAlive(gui) then
		return gui
	end
	return nil
end

function App:_editorDirty()
	local editor = self.guiEditor
	if not editor then
		return false
	end
	if type(editor.isDirty) == "function" then
		local ok, dirty = pcall(editor.isDirty, editor)
		if ok then
			return dirty == true
		end
	end
	local doc = self:_editorDoc()
	return doc ~= nil and doc.dirty == true
end

-- Écran ouvert : son ScreenGui dans StarterGui (nil tant qu'il n'est pas enregistré)
function App:_currentScreenGui()
	local s = self:_sessionState("interface")
	local target = s and s.target
	if isAlive(target) then
		return target
	end
	return nil
end

function App:_currentScreenName()
	local doc = self:_editorDoc()
	if doc and type(doc.name) == "string" and doc.name ~= "" then
		return doc.name
	end
	local gui = self:_currentScreenGui()
	if gui then
		return gui.Name
	end
	return nil
end

-- « StarterGui → Menu » (puce de la barre d'outils), nil si l'écran n'est pas enregistré
function App:_screenPath()
	local gui = self:_currentScreenGui()
	if not gui then
		return nil
	end
	local parent = gui.Parent
	if parent ~= nil and parent.Name == "StarterGui" then
		return "StarterGui → " .. gui.Name
	end
	return pathOf(gui)
end

-- L'écran ou ses blocs ont des modifications non enregistrées
function App:_interfaceDirty()
	local s = self:_sessionState("interface")
	if s and s.model and s.model.dirty == true then
		return true
	end
	return self:_editorDirty()
end

-- Premier passage dans l'onglet : l'écran sélectionné dans l'Explorateur, sinon le premier de StarterGui
function App:_openInitialScreen()
	if self._screenInitialized then
		return
	end
	self._screenInitialized = true
	local GuiStorage = optionalModule("GuiStorage")
	if not GuiStorage then
		return
	end
	local screen = nil
	local sel = firstSelected()
	if sel and type(GuiStorage.screenOf) == "function" then
		local ok, found = pcall(GuiStorage.screenOf, sel)
		if ok and typeof(found) == "Instance" then
			screen = found
		end
	end
	if screen == nil and type(GuiStorage.list) == "function" then
		local ok, list = pcall(GuiStorage.list)
		if ok and type(list) == "table" and type(list[1]) == "table" and typeof(list[1].instance) == "Instance" then
			screen = list[1].instance
		end
	end
	if screen ~= nil then
		self:openScreen(screen, { force = true })
	end
end

-- Remet l'écran de l'éditeur précédent (état exporté avant « Paramètres › Appliquer »)
function App:_restoreEditorScreen(st)
	self._screenInitialized = true
	local editor = self.guiEditor
	if type(st) ~= "table" or not editor then
		return
	end
	self._screenOpening = true
	local restored = false
	local lostDesign = false
	-- (chaque essai compte s'il ne plante pas ET ne renvoie pas false : importState renvoie false
	-- quand aucun écran n'était ouvert)
	local function try(fn, ...)
		local okCall, result = pcall(fn, editor, ...)
		return okCall and result ~= false
	end
	if st.editorState ~= nil and type(editor.importState) == "function" then
		restored = try(editor.importState, st.editorState)
	end
	if not restored and type(st.doc) == "table" and st.docDirty == true and type(editor.loadDoc) == "function" then
		restored = try(editor.loadDoc, st.doc, st.screenGui)
	end
	if not restored and isAlive(st.screenGui) and type(editor.openScreen) == "function" then
		restored = try(editor.openScreen, st.screenGui)
		if restored and st.docDirty == true then
			lostDesign = true
		end
	end
	self._screenOpening = false
	self._screenDoc = self:_editorDoc()
	self._lastScreenName = self:_currentScreenName()
	if lostDesign and self.dialogs then
		self.dialogs:toast(
			"Les changements non enregistrés du dessin de l'écran n'ont pas pu être gardés (ses blocs, eux, sont gardés).",
			"warning",
			7
		)
	end
end

-- Charge le script de l'écran (ou un projet local vide) dans la session de l'écran
function App:_loadScreenSession(screenGui)
	local scriptInst = nil
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.screenScript) == "function" and isAlive(screenGui) then
		local ok, found = pcall(GuiStorage.screenScript, screenGui)
		if ok and typeof(found) == "Instance" then
			scriptInst = found
		end
	end
	local model = nil
	local warnings = nil
	if scriptInst then
		local loaded, err, w = loadScript(scriptInst)
		if loaded then
			model = loaded
			warnings = w
		else
			self:setStatus(tostring(err) .. " Il sera remplacé si tu enregistres l'écran.", "error")
		end
	end
	if model == nil then
		model = emptyModel("local")
	end
	self:_setInterfaceSession(model, screenGui, scriptInst)
	if type(warnings) == "table" and #warnings > 0 then
		self:setStatus("⚠ " .. tostring(warnings[1]), "warning")
	end
	task.delay(0.2, function()
		if not self._destroyed then
			self:_offerDraft("interface", false)
		end
	end)
end

-- Après un changement d'écran : barre d'outils, en-tête, liens, analyse
function App:_afterScreenChange()
	self:_refreshLinkHighlight()
	self:_updateZoneHeader()
	self:_updateTopBar()
	self:_scheduleAnalysis(0.05)
end

-- Fenêtre à plusieurs boutons (Dialogs:_openModal) ; buttons = { { text, style, action } } (le dernier est
-- le plus à droite). Sans _openModal : simple confirmation dont le « oui » est le dernier bouton.
function App:_choice(title, message, buttons)
	local dialogs = self.dialogs
	if not dialogs or self._destroyed then
		return
	end
	local function run(action)
		if type(action) == "function" then
			task.spawn(function()
				local ok, err = pcall(action)
				if not ok then
					warn("[Blocs FR] " .. tostring(err))
				end
			end)
		end
	end
	if type(dialogs._openModal) == "function" and type(dialogs._closeModal) == "function" then
		local list = {}
		for _, b in ipairs(buttons) do
			local action = b.action
			table.insert(list, {
				text = b.text,
				style = b.style or "normal",
				action = function()
					pcall(dialogs._closeModal, dialogs)
					run(action)
				end,
			})
		end
		local ok, err = pcall(dialogs._openModal, dialogs, {
			title = title,
			message = message,
			width = 480,
			buttons = list,
		})
		if ok then
			return
		end
		warn("[Blocs FR] Fenêtre de choix : " .. tostring(err))
	end
	local last = buttons[#buttons]
	local first = buttons[1]
	dialogs:confirm(title, message, function()
		run(last and last.action)
	end, (last and last.text) or "OK", (first and first.text) or "Annuler")
end

-- Écran (ou ses blocs) non enregistré avant d'en ouvrir un autre : Enregistrer / Ne pas enregistrer / Annuler
function App:_confirmLeaveScreen(proceed)
	local name = self:_currentScreenName() or "cet écran"
	self:_choice(
		"Écran non enregistré",
		"L'écran « " .. name .. " » ou ses blocs ont des modifications non enregistrées. Que veux-tu faire ?",
		{
			{ text = "Annuler", style = "normal" },
			{ text = "Ne pas enregistrer", style = "danger", action = proceed },
			{
				text = "Enregistrer",
				style = "primary",
				action = function()
					if self:saveScreen() then
						proceed()
					end
				end,
			},
		}
	)
end

-- Ouvre un écran de StarterGui (ScreenGui ou nom) dans l'éditeur et ses blocs dans la zone du bas.
-- opts.force : sans demander d'enregistrer l'écran ouvert.
function App:openScreen(screen, opts)
	if self._destroyed then
		return false
	end
	opts = opts or {}
	local GuiStorage = optionalModule("GuiStorage")
	if type(screen) == "string" and GuiStorage and type(GuiStorage.find) == "function" then
		local ok, found = pcall(GuiStorage.find, screen)
		if ok then
			screen = found
		end
	end
	if not isAlive(screen) then
		self.dialogs:toast("Cet écran n'existe plus dans StarterGui.", "error")
		return false
	end
	-- (un objet à l'intérieur d'un écran Blocs FR : cet écran)
	if GuiStorage and type(GuiStorage.screenOf) == "function" then
		local okOf, root = pcall(GuiStorage.screenOf, screen)
		if okOf and typeof(root) == "Instance" then
			screen = root
		end
	end
	-- déjà ouvert : rien à recharger (ses changements non enregistrés restent)
	if not opts.force and screen == self:_currentScreenGui() and self:_editorDoc() ~= nil then
		if self.workspace ~= "interface" then
			self:setWorkspace("interface")
		end
		return true
	end
	if not opts.force and screen ~= self:_currentScreenGui() and self:_interfaceDirty() then
		self:_confirmLeaveScreen(function()
			self:openScreen(screen, { force = true })
		end)
		return false
	end
	if self.workspace ~= "interface" then
		self._screenInitialized = true -- (pas d'ouverture automatique : on ouvre celui-ci)
		self:setWorkspace("interface")
	end
	local editor = self:_ensureGuiEditor()
	if editor and type(editor.openScreen) == "function" then
		self._screenOpening = true
		local ok, opened, err = pcall(editor.openScreen, editor, screen)
		self._screenOpening = false
		if not ok then
			warn("[Blocs FR] Ouverture de l'écran : " .. tostring(opened))
			self.dialogs:toast("Impossible d'ouvrir l'écran : " .. tostring(opened), "error")
			return false
		end
		if opened == false then
			-- (le Studio a déjà affiché pourquoi) : l'écran ouvert et ses blocs ne changent pas
			self:setStatus(tostring(err or "Impossible d'ouvrir cet écran."), "error")
			return false
		end
	end
	self._screenInitialized = true
	self._screenDoc = self:_editorDoc()
	self._lastScreenName = self:_currentScreenName()
	self._previewOn = false
	self._linkName = nil
	self:_loadScreenSession(screen)
	self:_afterScreenChange()
	self:setStatus(
		"Écran « " .. tostring(self:_currentScreenName() or screen.Name) .. " » ouvert : dessine-le au-dessus, ses blocs vont en dessous.",
		"info"
	)
	return true
end

-- (DevBridge « guiOpen ») ouvre un écran sans rien demander. Renvoie true si c'est fait.
function App:openGuiScreen(screen)
	return self:openScreen(screen, { force = true })
end

-- « ＋ Nouvel écran »
function App:newScreen(opts)
	if self._destroyed then
		return false
	end
	opts = opts or {}
	if self.workspace ~= "interface" then
		self._screenInitialized = true
		self:setWorkspace("interface")
	end
	local editor = self:_ensureGuiEditor()
	if not editor or type(editor.newScreen) ~= "function" then
		self.dialogs:toast("Le Studio d'interface n'est pas disponible pour le moment.", "warning")
		return false
	end
	-- Aucun écran ouvert : les blocs déjà posés dans la zone deviennent ceux du nouvel écran
	local current = self:_sessionState("interface")
	local adopt = self:_editorDoc() == nil and current ~= nil and not isAlive(current.target)
	if not opts.force and not adopt and self:_interfaceDirty() then
		self:_confirmLeaveScreen(function()
			self:newScreen({ force = true })
		end)
		return false
	end
	self._screenOpening = true
	local ok, err = pcall(editor.newScreen, editor)
	self._screenOpening = false
	if not ok then
		self.dialogs:toast("Impossible de créer l'écran : " .. tostring(err), "error")
		return false
	end
	self._screenInitialized = true
	self._screenDoc = self:_editorDoc()
	self._lastScreenName = self:_currentScreenName()
	self._previewOn = false
	self._linkName = nil
	if adopt then
		if type(editor.refreshLinks) == "function" then
			pcall(editor.refreshLinks, editor)
		end
	else
		self:_setInterfaceSession(emptyModel("local"), self:_editorScreenGui(), nil)
	end
	self:_afterScreenChange()
	self:setStatus(
		"Nouvel écran « " .. tostring(self:_currentScreenName() or "Écran") .. " » : glisse des éléments sur l'aperçu, puis « Enregistrer l'écran ».",
		"info"
	)
	return true
end

-- Projet de blocs d'un modèle d'écran (renommé comme l'écran ouvert), et l'entrée du modèle
function App:_templateModel(templateId)
	local model = emptyModel("local")
	local GuiTemplates = optionalModule("GuiTemplates")
	if not GuiTemplates or type(GuiTemplates.get) ~= "function" then
		return model, nil
	end
	local name = self:_currentScreenName()
	local ok, entry = pcall(GuiTemplates.get, templateId, name)
	if not ok or type(entry) ~= "table" then
		return model, nil
	end
	if type(entry.blocs) == "table" then
		local okModel, loaded = pcall(Model.fromData, entry.blocs)
		if okModel and type(loaded) == "table" then
			model = loaded
		end
	end
	return model, entry
end

-- « Nouvel écran depuis un modèle » : l'éditeur pose le modèle, ses blocs vont dans la zone du bas
function App:insertTemplate(templateId, opts)
	if self._destroyed then
		return false
	end
	opts = opts or {}
	if not opts.force and self:_interfaceDirty() then
		self:_confirmLeaveScreen(function()
			self:insertTemplate(templateId, { force = true })
		end)
		return false
	end
	if self.workspace ~= "interface" then
		self._screenInitialized = true
		self:setWorkspace("interface")
	end
	local editor = self:_ensureGuiEditor()
	if not editor or type(editor.insertTemplate) ~= "function" then
		self.dialogs:toast("Le Studio d'interface n'est pas disponible pour le moment.", "warning")
		return false
	end
	local docBefore = self:_editorDoc()
	self._screenOpening = true
	local ok, inserted, insertedEntry = pcall(editor.insertTemplate, editor, templateId)
	self._screenOpening = false
	if not ok then
		self.dialogs:toast("Impossible d'ajouter ce modèle : " .. tostring(inserted), "error")
		return false
	end
	if inserted == false then
		return false -- (le Studio a déjà dit pourquoi)
	end
	local doc = self:_editorDoc()
	self._screenDoc = doc
	self._lastScreenName = self:_currentScreenName()
	self._screenInitialized = true
	-- Blocs du modèle : ceux que le Studio a préparés (déjà renommés pour le nom libre de l'écran),
	-- sinon ceux de GuiTemplates
	local model, entry = nil, nil
	if type(insertedEntry) == "table" then
		entry = insertedEntry
		if type(insertedEntry.blocs) == "table" then
			local okModel, loaded = pcall(Model.fromData, insertedEntry.blocs)
			if okModel and type(loaded) == "table" then
				model = loaded
			end
		end
	end
	if model == nil then
		local fallbackModel, fallbackEntry = self:_templateModel(templateId)
		model = fallbackModel
		entry = entry or fallbackEntry
	end
	local title = tostring((entry and entry.title) or templateId)
	if doc ~= docBefore or docBefore == nil then
		-- nouvel écran : ses blocs remplacent ceux de la zone (pas encore enregistrés)
		local blocks, notes = countOf(model)
		if blocks + notes > 0 then
			markUnsaved(model)
		end
		self._previewOn = false
		self._linkName = nil
		self:_setInterfaceSession(model, self:_editorScreenGui(), nil)
	else
		-- le modèle a été posé dans l'écran ouvert : ses blocs rejoignent ceux de l'écran
		local blocks = countOf(model)
		if blocks > 0 then
			local okData, data = pcall(function()
				return model:serialize()
			end)
			if okData then
				self:loadScreenBlocks(data)
			end
		end
	end
	self:_afterScreenChange()
	-- (le Studio a déjà affiché sa notification « Modèle … prêt » : ici, la barre d'état)
	local withBlocks = ""
	local templateBlocks = countOf(model)
	if templateBlocks > 0 then
		withBlocks = " avec ses blocs (" .. plural(templateBlocks, "bloc") .. ")"
	end
	self:setStatus(
		"Modèle « " .. title .. " » ajouté" .. withBlocks .. " : clique sur « Enregistrer l'écran » pour le mettre dans StarterGui.",
		"success"
	)
	return true
end

-- Le Studio demande un autre écran (deps.requestScreen : carte de départ, modèles, menus) : App s'en
-- charge (enregistrer l'écran ouvert ?, puis blocs du nouvel écran). Renvoie false si ce n'est pas géré.
function App:_requestScreen(kind, arg)
	if self._destroyed then
		return true
	end
	if kind == "nouveau" then
		self:newScreen()
	elseif kind == "modele" then
		self:insertTemplate(arg)
	elseif kind == "ouvrir" then
		self:openScreen(arg)
	else
		return false
	end
	return true
end

-- L'éditeur a ouvert, créé ou fermé un écran tout seul (deps.onScreenChanged, appelé avant DocChanged,
-- ou DocChanged « nouveau » / « ouvrir » / « modele » / « fermer ») ; ignoré quand c'est App qui l'a
-- demandé. info = { reason = texte|nil, screenGui = ScreenGui|nil, templateId = id|nil,
-- blocs = données Model|nil }
function App:onScreenChanged(info)
	if self._destroyed or self._screenOpening then
		return
	end
	info = type(info) == "table" and info or {}
	local hadScreen = self._screenDoc ~= nil
	local oldName = self._lastScreenName
	self._screenDoc = self:_editorDoc()
	self._lastScreenName = self:_currentScreenName()
	self._screenInitialized = true
	self._previewOn = false
	self._linkName = nil
	if info.reason == "restaurer" or info.reason == "enregistrer" then
		-- (même écran, mêmes blocs)
		self:_afterScreenChange()
		return
	end
	local current = self:_sessionState("interface")
	if info.reason == "nouveau" and not hadScreen and current and current.model and not isAlive(current.target) then
		-- premier écran : les blocs déjà posés dans la zone deviennent les siens
		local editor = self.guiEditor
		if editor and type(editor.refreshLinks) == "function" then
			pcall(editor.refreshLinks, editor)
		end
		self:_afterScreenChange()
		return
	end
	self:_keepOldScreenBlocks(oldName)
	local screenGui = info.screenGui
	if not isAlive(screenGui) then
		screenGui = self:_editorScreenGui()
	end
	local model = nil
	if type(info.blocs) == "table" then
		local okModel, loaded = pcall(Model.fromData, info.blocs)
		if okModel and type(loaded) == "table" then
			model = loaded
		end
	end
	if model == nil and info.templateId ~= nil then
		model = self:_templateModel(info.templateId)
	end
	if model ~= nil then
		local blocks, notes = countOf(model)
		if blocks + notes > 0 then
			markUnsaved(model)
		end
		self:_setInterfaceSession(model, screenGui, nil)
	elseif screenGui ~= nil then
		self:_loadScreenSession(screenGui)
	else
		self:_setInterfaceSession(emptyModel("local"), nil, nil)
	end
	self:_afterScreenChange()
end

-- Avant un changement d'écran imprévu : les blocs non enregistrés de l'écran précédent vont en brouillon
-- (oldName : nom de cet écran ; le Studio affiche peut-être déjà le suivant)
function App:_keepOldScreenBlocks(oldName)
	local s = self:_sessionState("interface")
	if not s or not s.model or s.model.dirty ~= true then
		return
	end
	local blocks, notes = countOf(s.model)
	if blocks + notes == 0 then
		return
	end
	if type(oldName) == "string" and oldName ~= "" then
		self._draftScreenName = oldName
	end
	local ok = pcall(self._writeDrafts, self, true)
	self._draftScreenName = nil
	if ok and self.dialogs then
		self.dialogs:toast(
			"Les blocs non enregistrés de l'écran précédent sont gardés en brouillon : rouvre cet écran pour les retrouver.",
			"warning",
			7
		)
	end
end

-- « Enregistrer l'écran » : l'écran dans StarterGui (GuiEditor), puis son script local (Storage)
function App:saveScreen()
	if self._destroyed or self._saving then
		return false
	end
	self._saving = true
	local ok, result = pcall(self._saveScreenImpl, self)
	self._saving = false
	if not ok then
		local msg = "Échec de l'enregistrement de l'écran : " .. tostring(result)
		warn("[Blocs FR] " .. msg)
		if self.dialogs then
			self.dialogs:toast(msg, "error")
		end
		self:setStatus(msg, "error")
		return false
	end
	return result == true
end

function App:_saveScreenImpl()
	self:_syncSession()
	local editor = self.guiEditor
	local screenGui = nil
	if editor and type(editor.save) == "function" and self:_editorDoc() ~= nil then
		local okCall, saved, gui = pcall(editor.save, editor)
		if not okCall then
			error(saved, 0)
		end
		if typeof(gui) ~= "Instance" and typeof(saved) == "Instance" then
			gui = saved
			saved = true
		end
		if saved == false or not isAlive(gui) then
			if type(gui) == "string" and gui ~= "" then
				self.dialogs:toast(gui, "error")
			end
			self:setStatus("L'écran n'a pas été enregistré.", "warning")
			return false
		end
		screenGui = gui
	else
		screenGui = self:_currentScreenGui()
		if screenGui == nil then
			self.dialogs:toast("Crée d'abord un écran (menu « Écran », puis « Nouvel écran »).", "warning")
			return false
		end
	end
	self:_setInterfaceTarget(screenGui, nil)
	self._screenDoc = self:_editorDoc()

	-- Script de l'écran : quand il y a des blocs, ou qu'un script existe déjà
	local s = self:_sessionState("interface")
	local model = s.model
	local existing = nil
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.screenScript) == "function" then
		local okScript, found = pcall(GuiStorage.screenScript, screenGui)
		if okScript and typeof(found) == "Instance" then
			existing = found
		end
	end
	if existing == nil and isAlive(s.scriptInstance) then
		existing = s.scriptInstance
	end
	local blocks, notes = countOf(model)
	local warnings = {}
	if blocks + notes > 0 or existing ~= nil then
		local okSave, inst, err, saveWarnings = pcall(Storage.save, model, screenGui, existing)
		if not okSave then
			err = tostring(inst)
			inst = nil
		end
		if typeof(inst) ~= "Instance" then
			local msg = "L'écran est enregistré, mais pas ses blocs : " .. tostring(err or "erreur inconnue")
			self.dialogs:toast(msg, "error")
			self:setStatus(msg, "error")
			self:_afterScreenChange()
			return false
		end
		pcall(function()
			model:markSaved()
		end)
		self:_setInterfaceTarget(screenGui, inst)
		if type(saveWarnings) == "table" then
			warnings = saveWarnings
		end
	end
	self:_clearDraft("interface", pathOf(screenGui))
	self:_rebuildTestProblems()
	local name = screenGui.Name
	self.dialogs:toast("Écran « " .. name .. " » enregistré dans StarterGui ✓", "success")
	if #warnings > 0 then
		self:setStatus("⚠ " .. tostring(warnings[1]), "warning")
	else
		self:setStatus("Écran « " .. name .. " » enregistré dans StarterGui.", "success")
	end
	self:_afterScreenChange()
	return true
end

-- « Renommer l'écran… »
function App:renameScreen()
	if self._destroyed then
		return
	end
	local doc = self:_editorDoc()
	if not doc then
		self.dialogs:toast("Ouvre d'abord un écran.", "warning")
		return
	end
	self.dialogs:prompt(
		"Renommer l'écran",
		"Nouveau nom de l'écran (c'est aussi son nom dans StarterGui) :",
		tostring(doc.name or ""),
		function(text)
			if self._destroyed then
				return
			end
			local editor = self.guiEditor
			local current = self:_editorDoc()
			if not current then
				return
			end
			-- (un autre écran a pu s'ouvrir pendant la fenêtre : sélection dans l'Explorateur)
			if current ~= doc then
				self.dialogs:toast("Un autre écran a été ouvert entre-temps : rien n'a été renommé.", "warning")
				return
			end
			local ok, err
			if editor and type(editor.renameScreen) == "function" then
				local okCall, result, message = pcall(editor.renameScreen, editor, text)
				ok = okCall and result ~= false
				err = message
				if not okCall then
					err = result
				end
			else
				local okCall, result, message = pcall(current.setName, current, text)
				ok = okCall and result == true
				err = message
				if not okCall then
					err = result
				end
				if ok then
					pcall(current.commit, current, "renommer l'écran")
				end
			end
			if not ok then
				self.dialogs:toast(tostring(err or "Ce nom n'est pas valable."), "error")
				return
			end
			self:_onEditorDocChanged("renommer l'écran")
			self:setStatus("Écran renommé : clique sur « Enregistrer l'écran » pour le renommer aussi dans StarterGui.", "info")
		end
	)
end

-- Les blocs de l'écran qui nomment l'écran (« cacher l'écran Menu ») suivent son nouveau nom.
-- Renvoie le nombre d'entrées changées.
function App:_renameScreenRefs(old, new)
	if type(old) ~= "string" or type(new) ~= "string" or old == new or old == "" then
		return 0
	end
	local model = self.sessions.interface.model
	if self._activeSession == "interface" then
		model = self.model
	end
	if not model or type(model.blocks) ~= "table" then
		return 0
	end
	local changes = {}
	for id, block in pairs(model.blocks) do
		local def = Registry.get(block.def)
		if def and type(def.inputs) == "table" then
			for _, spec in ipairs(def.inputs) do
				if spec.kind == "gui" then
					local input = block.inputs and block.inputs[spec.name]
					local v = input and input.value
					if type(v) == "string" and input.block == nil then
						local newValue = nil
						if spec.filter == "ecran" then
							if v == old then
								newValue = new
							end
						elseif string.sub(v, 1, #old + 1) == old .. "/" then
							newValue = new .. string.sub(v, #old + 1)
						end
						if newValue ~= nil then
							table.insert(changes, { id, spec.name, newValue })
						end
					end
				end
			end
		end
	end
	for _, change in ipairs(changes) do
		pcall(function()
			model:setInput(change[1], change[2], change[3])
		end)
	end
	if #changes > 0 then
		pcall(function()
			model:commit("renommer l'écran")
		end)
	end
	return #changes
end

-- « Supprimer l'écran… » (avec confirmation ; Annuler de Studio le fait revenir)
function App:deleteScreen()
	if self._destroyed then
		return
	end
	local screenGui = self:_currentScreenGui()
	local doc = self:_editorDoc()
	local name = self:_currentScreenName() or "cet écran"
	if screenGui == nil then
		if doc == nil then
			self.dialogs:toast("Aucun écran ouvert.", "info")
			return
		end
		self.dialogs:confirm(
			"Abandonner l'écran",
			"L'écran « " .. name .. " » n'a jamais été enregistré : il va disparaître, avec ses blocs. Continuer ?",
			function()
				if self._destroyed then
					return
				end
				if self:_editorDoc() ~= doc then
					self.dialogs:toast("Un autre écran a été ouvert entre-temps : rien n'a été abandonné.", "warning")
					return
				end
				self:_afterScreenRemoved(nil)
			end,
			"Abandonner",
			"Annuler",
			true
		)
		return
	end
	self.dialogs:confirm(
		"Supprimer l'écran",
		"Supprimer l'écran « "
			.. name
			.. " » de StarterGui, avec ses blocs ? Tu pourras le récupérer avec « Annuler » (Ctrl+Z) de Studio.",
		function()
			if self._destroyed then
				return
			end
			local GuiStorage = optionalModule("GuiStorage")
			if not GuiStorage or type(GuiStorage.remove) ~= "function" then
				self.dialogs:toast("Impossible de supprimer l'écran pour le moment.", "error")
				return
			end
			local path = pathOf(screenGui)
			local ok, removed, err = pcall(GuiStorage.remove, screenGui)
			if not ok or removed == false then
				self.dialogs:toast(tostring(err or removed or "Impossible de supprimer l'écran."), "error")
				return
			end
			self:_clearDraft("interface", path)
			if self:_editorDoc() == doc then
				self:_afterScreenRemoved(name)
			else
				-- (un autre écran a été ouvert pendant la fenêtre : il reste ouvert)
				self.dialogs:toast("Écran « " .. name .. " » supprimé.", "info")
			end
		end,
		"Supprimer",
		"Annuler",
		true
	)
end

-- Après une suppression : l'écran suivant de StarterGui, sinon aucun écran
function App:_afterScreenRemoved(name)
	local nextScreen = nil
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.list) == "function" then
		local ok, list = pcall(GuiStorage.list)
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and isAlive(entry.instance) then
					nextScreen = entry.instance
					break
				end
			end
		end
	end
	if nextScreen ~= nil then
		self:openScreen(nextScreen, { force = true })
	else
		local editor = self.guiEditor
		if editor and type(editor.openScreen) == "function" then
			self._screenOpening = true
			pcall(editor.openScreen, editor, nil)
			self._screenOpening = false
		end
		self._screenDoc = self:_editorDoc()
		self._lastScreenName = self:_currentScreenName()
		self._linkName = nil
		self:_setInterfaceSession(emptyModel("local"), nil, nil)
		self:_afterScreenChange()
	end
	if name then
		self.dialogs:toast("Écran « " .. name .. " » supprimé.", "info")
	end
end

-- « Aperçu » : essayer l'écran comme dans le jeu (les boutons réagissent, rien n'est modifié)
function App:togglePreview()
	if self._destroyed then
		return
	end
	local editor = self.guiEditor
	if not editor or type(editor.togglePreview) ~= "function" then
		self.dialogs:toast("L'aperçu n'est pas disponible pour le moment.", "warning")
		return
	end
	local ok, result = pcall(editor.togglePreview, editor)
	if not ok then
		self.dialogs:toast("Aperçu impossible : " .. tostring(result), "error")
		return
	end
	if type(result) == "boolean" then
		self._previewOn = result
	else
		self._previewOn = not self._previewOn
	end
	self:_updateTopBar()
	if self._previewOn then
		self:setStatus("Aperçu : essaie ton écran comme dans le jeu. Clique encore sur « Aperçu » pour revenir à l'édition.", "info")
	else
		self:setStatus("Retour à l'édition de l'écran.", "info")
	end
end

-- Écrans du menu « Écran ▼ » : { { name, instance, current, saved } }
function App:listScreens()
	local out = {}
	local current = self:_currentScreenGui()
	local doc = self:_editorDoc()
	local listed = false
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.list) == "function" then
		local ok, list = pcall(GuiStorage.list)
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and typeof(entry.instance) == "Instance" then
					local isCurrent = entry.instance == current
					local name = tostring(entry.name or entry.instance.Name)
					if isCurrent and doc and type(doc.name) == "string" and doc.name ~= "" then
						name = doc.name -- (renommé, pas encore enregistré)
					end
					table.insert(out, { name = name, instance = entry.instance, current = isCurrent, saved = true })
					if isCurrent then
						listed = true
					end
				end
			end
		end
	end
	if not listed and doc and type(doc.name) == "string" then
		table.insert(out, 1, { name = doc.name, instance = nil, current = true, saved = false })
	end
	return out
end

-- Modèles d'écran (menu « Écran ▼ ») : { { id, title } }
function App:listTemplates()
	if self._templatesCache then
		return table.clone(self._templatesCache)
	end
	local out = {}
	local GuiTemplates = optionalModule("GuiTemplates")
	if GuiTemplates and type(GuiTemplates.list) == "function" then
		local ok, list = pcall(GuiTemplates.list)
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.id ~= nil then
					table.insert(out, { id = entry.id, title = tostring(entry.title or entry.id) })
				end
			end
		end
	end
	self._templatesCache = out
	return table.clone(out)
end

-- Modèle des blocs de l'écran (pour GuiEditor)
function App:getInterfaceModel()
	local s = self:_sessionState("interface")
	return s and s.model
end

-- Ajoute des blocs (données Model) dans la zone de l'écran : remplacent une zone vide, sinon à droite
function App:loadScreenBlocks(data)
	if self._destroyed or type(data) ~= "table" then
		return false
	end
	local s = self:_sessionState("interface")
	local model = s and s.model
	if not model then
		return false
	end
	local blocks, notes = countOf(model)
	local ok, err = pcall(function()
		if blocks + notes == 0 then
			model:importData(data, 0, 0)
		else
			importBeside(model, data)
		end
	end)
	if not ok then
		self.dialogs:toast("Impossible d'ajouter ces blocs : " .. tostring(err), "error")
		return false
	end
	pcall(function()
		model:commit("modele")
	end)
	return true
end

-- Nom de l'élément de l'écran ouvert visé par un bloc (première entrée « gui » qui n'est pas un écran)
function App:_guiTargetOf(blockId)
	local model = self.model
	local block = model and blockId and model:get(blockId)
	if not block then
		return nil
	end
	local def = Registry.get(block.def)
	if not def or type(def.inputs) ~= "table" then
		return nil
	end
	local screenName = self:_currentScreenName()
	for _, spec in ipairs(def.inputs) do
		if spec.kind == "gui" and spec.filter ~= "ecran" then
			local input = block.inputs and block.inputs[spec.name]
			local v = input and input.value
			if type(v) == "string" and v ~= "" then
				local slash = string.find(v, "/", 1, true)
				if slash then
					if screenName ~= nil and string.sub(v, 1, slash - 1) == screenName then
						return string.sub(v, slash + 1)
					end
				else
					return v
				end
			end
		end
	end
	return nil
end

-- Ids des blocs d'un projet qui nomment l'élément « name » de l'écran ouvert (« Jouer » ou « Menu/Jouer »)
function App:_blocksNaming(model, name)
	local ids = {}
	if not model or type(model.blocks) ~= "table" or type(name) ~= "string" or name == "" then
		return ids
	end
	local screenName = self:_currentScreenName()
	local qualified = nil
	if screenName then
		qualified = screenName .. "/" .. name
	end
	for id, block in pairs(model.blocks) do
		local def = Registry.get(block.def)
		if def and type(def.inputs) == "table" then
			for _, spec in ipairs(def.inputs) do
				if spec.kind == "gui" and spec.filter ~= "ecran" then
					local input = block.inputs and block.inputs[spec.name]
					local v = input and input.value
					if type(v) == "string" and (v == name or v == qualified) then
						table.insert(ids, id)
						break
					end
				end
			end
		end
	end
	return ids
end

-- « Blocs de cet élément » (GuiEditor) : { { blockId, defId, text, hat } }, les événements d'abord
function App:blocksForElement(name)
	local model = self:getInterfaceModel()
	local out = {}
	if not model then
		return out
	end
	local Explication = optionalModule("Explication")
	for _, id in ipairs(self:_blocksNaming(model, name)) do
		local block = model:get(id)
		local def = block and Registry.get(block.def)
		local text = nil
		if Explication and type(Explication.sentence) == "function" then
			local ok, sentence = pcall(Explication.sentence, model, id)
			if ok and type(sentence) == "string" and sentence ~= "" then
				text = sentence
			end
		end
		if text == nil and def then
			pcall(function()
				text = Registry.plainLabel(def)
			end)
		end
		table.insert(out, {
			blockId = id,
			defId = block and block.def,
			text = text or tostring(id),
			hat = def ~= nil and def.shape == "hat",
			y = (block and tonumber(block.y)) or 0,
		})
	end
	table.sort(out, function(a, b)
		if a.hat ~= b.hat then
			return a.hat
		end
		if a.y ~= b.y then
			return a.y < b.y
		end
		return tostring(a.blockId) < tostring(b.blockId)
	end)
	return out
end

-- « Ajouter un script au clic » (boutons) : un « Quand le bouton X est cliqué » sous les piles de l'écran,
-- ou celui qui existe déjà. Renvoie l'id du bloc.
function App:addClickScript(name)
	if self._destroyed or type(name) ~= "string" or name == "" then
		return nil
	end
	if self.workspace ~= "interface" then
		self:setWorkspace("interface")
	end
	local model = self:getInterfaceModel()
	if not model then
		return nil
	end
	local screenName = self:_currentScreenName()
	for _, id in ipairs(table.clone(model.tops)) do
		local block = model:get(id)
		if block and block.def == "gui_quand_clic" then
			local input = block.inputs and block.inputs.BOUTON
			local v = input and input.value
			if v == name or (screenName ~= nil and v == screenName .. "/" .. name) then
				task.defer(function()
					self:focusBlock(id)
				end)
				self:setStatus("Ce bouton a déjà son bloc « Quand le bouton " .. name .. " est cliqué ».", "info")
				return id
			end
		end
	end
	-- sous les piles existantes
	local x, y = 40, 40
	local bottom, left = nil, nil
	for _, id in ipairs(model.tops) do
		local block = model:get(id)
		if block then
			local _, h = stackSize(model, id)
			local by = (tonumber(block.y) or 0) + h
			if bottom == nil or by > bottom then
				bottom = by
			end
			local bx = tonumber(block.x) or 0
			if left == nil or bx < left then
				left = bx
			end
		end
	end
	if bottom ~= nil then
		x = left
		y = bottom + 40
	end
	local okCreate, id = pcall(function()
		return model:create("gui_quand_clic", x, y, { BOUTON = name })
	end)
	if not okCreate or id == nil then
		self.dialogs:toast("Impossible d'ajouter le bloc : " .. tostring(id), "error")
		return nil
	end
	model:commit("script au clic")
	self._lastEdited = "blocs"
	if self.workspace == "interface" and self._zoneCollapsed then
		self:toggleZone(false)
	end
	task.defer(function()
		if not self._destroyed then
			self:focusBlock(id)
		end
	end)
	self.dialogs:toast("Bloc « Quand le bouton " .. name .. " est cliqué » ajouté : glisse des blocs dessous.", "success")
	return id
end

-- Contour cyan sur les blocs qui nomment l'élément sélectionné dans l'aperçu
function App:_refreshLinkHighlight()
	local canvas = self.canvas
	if not canvas or type(canvas.setLinkHighlight) ~= "function" then
		return
	end
	local ids = {}
	if self.workspace == "interface" and self._linkName ~= nil then
		ids = self:_blocksNaming(self.model, self._linkName)
	end
	pcall(canvas.setLinkHighlight, canvas, ids)
end

function App:_onEditorSelection(id)
	if self._destroyed then
		return
	end
	local name = nil
	local doc = self:_editorDoc()
	if doc and id ~= nil and type(doc.get) == "function" then
		local ok, el = pcall(doc.get, doc, id)
		if ok and type(el) == "table" and type(el.name) == "string" then
			name = el.name
		end
	end
	self._linkName = name
	self:_refreshLinkHighlight()
end

-- Raisons de DocChanged qui ne sont pas une modification de l'écran par l'utilisateur
local SCREEN_EVENTS = {
	undo = true,
	redo = true,
	ouvrir = true,
	charger = true,
	nouveau = true,
	modele = true,
	fermer = true,
	restaurer = true,
	enregistrer = true,
}

-- editor.DocChanged(reason, info) : écran modifié, ou changement d'écran (voir onScreenChanged)
function App:_onEditorDocChanged(reason, info)
	if self._destroyed then
		return
	end
	info = type(info) == "table" and info or {}
	local doc = self:_editorDoc()
	local switched = false
	if doc ~= self._screenDoc then
		if self._screenOpening then
			-- App est en train de changer d'écran : un autre nom n'est pas un renommage (les blocs de
			-- l'écran précédent ne doivent pas suivre)
			self._screenDoc = doc
			self._lastScreenName = self:_currentScreenName()
			switched = true
		else
			-- l'éditeur a changé d'écran tout seul (sans prévenir par deps.onScreenChanged)
			self:onScreenChanged({
				reason = reason,
				screenGui = info.screenGui,
				templateId = info.templateId,
				blocs = info.blocs,
			})
			return
		end
	end
	if not SCREEN_EVENTS[reason] then
		self._lastEdited = "gui"
	end
	-- l'écran a changé de nom : les blocs qui le nomment suivent
	local name = doc and doc.name
	if not switched and type(name) == "string" and name ~= "" then
		local old = self._lastScreenName
		self._lastScreenName = name
		if type(old) == "string" and old ~= name then
			local n = self:_renameScreenRefs(old, name)
			if n > 0 then
				self:setStatus("Écran renommé « " .. name .. " » : " .. plural(n, "bloc") .. " mis à jour.", "info")
			end
		end
	end
	-- l'élément sélectionné a pu être renommé
	if self._linkName ~= nil and doc and type(doc.findByName) == "function" then
		local ok, found = pcall(doc.findByName, doc, self._linkName)
		if not ok or found == nil then
			self._linkName = nil
		end
	end
	self:_refreshLinkHighlight()
	self:_updateTopBar()
	self:_updateZoneHeader()
	self:_scheduleAnalysis()
end

-- Survol d'un bloc des blocs de l'écran : son élément s'allume dans l'aperçu
function App:_onBlockHover(blockId, entering)
	local editor = self.guiEditor
	if not editor or type(editor.highlightByName) ~= "function" then
		return
	end
	local name = nil
	if entering and self.workspace == "interface" then
		name = self:_guiTargetOf(blockId)
	end
	pcall(editor.highlightByName, editor, name)
end

-- Noms proposés par les cases « gui » des blocs (SPEC §21.6) : l'écran en cours (même pas enregistré)
-- d'abord, puis ceux de StarterGui ; { { label, value } } ; nom seul quand il est unique, sinon
-- « Écran/Nom » (étiquette « Jouer (Boutique) »).
function App:getGuiNames(filter)
	local GuiDoc = optionalModule("GuiDoc")
	local allowed = nil
	if filter ~= nil and filter ~= "element" and filter ~= "ecran" and GuiDoc and type(GuiDoc.FILTERS) == "table" then
		allowed = GuiDoc.FILTERS[filter]
	end
	local screens = {}
	local seen = {}
	local doc = self:_editorDoc()
	if doc and type(doc.name) == "string" and doc.name ~= "" then
		local elements = {}
		if type(doc.names) == "function" then
			local ok, list = pcall(doc.names, doc, nil)
			if ok and type(list) == "table" then
				elements = list
			end
		end
		table.insert(screens, { name = doc.name, elements = elements })
		seen[doc.name] = true
	end
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.allNames) == "function" then
		local ok, all = pcall(GuiStorage.allNames)
		if ok and type(all) == "table" and type(all.screens) == "table" then
			local elementsByScreen = all.elements or {}
			for _, screenName in ipairs(all.screens) do
				if type(screenName) == "string" and not seen[screenName] then
					seen[screenName] = true
					table.insert(screens, { name = screenName, elements = elementsByScreen[screenName] or {} })
				end
			end
		end
	end
	local out = {}
	if filter == "ecran" then
		for _, s in ipairs(screens) do
			table.insert(out, { label = s.name, value = s.name })
		end
		return out
	end
	local counts = {}
	for _, s in ipairs(screens) do
		for _, e in ipairs(s.elements) do
			if type(e) == "table" and type(e.name) == "string" and (allowed == nil or allowed[e.type]) then
				counts[e.name] = (counts[e.name] or 0) + 1
			end
		end
	end
	local added = {}
	for _, s in ipairs(screens) do
		for _, e in ipairs(s.elements) do
			if type(e) == "table" and type(e.name) == "string" and (allowed == nil or allowed[e.type]) then
				local value, label = e.name, e.name
				if (counts[e.name] or 0) > 1 then
					value = s.name .. "/" .. e.name
					label = e.name .. " (" .. s.name .. ")"
				end
				if not added[value] then
					added[value] = true
					table.insert(out, { label = label, value = value })
				end
			end
		end
	end
	return out
end

-- Noms pour le détecteur : { screens = { … }, elements = { [écran] = { [nom] = type } } }, écran en cours
-- compris (même pas enregistré)
function App:_guiNamesForDetector()
	local result = { screens = {}, elements = {} }
	local GuiStorage = optionalModule("GuiStorage")
	if GuiStorage and type(GuiStorage.allNames) == "function" then
		local ok, all = pcall(GuiStorage.allNames)
		if ok and type(all) == "table" and type(all.screens) == "table" then
			local elementsByScreen = all.elements or {}
			for _, screen in ipairs(all.screens) do
				if type(screen) == "string" and result.elements[screen] == nil then
					table.insert(result.screens, screen)
					local map = {}
					for _, e in ipairs(elementsByScreen[screen] or {}) do
						if type(e) == "table" and type(e.name) == "string" then
							map[e.name] = e.type
						end
					end
					result.elements[screen] = map
				end
			end
		end
	end
	local doc = self:_editorDoc()
	if doc and type(doc.name) == "string" and doc.name ~= "" then
		local map = {}
		if type(doc.names) == "function" then
			local ok, list = pcall(doc.names, doc, nil)
			if ok and type(list) == "table" then
				for _, e in ipairs(list) do
					if type(e) == "table" and type(e.name) == "string" then
						map[e.name] = e.type
					end
				end
			end
		end
		if result.elements[doc.name] == nil then
			table.insert(result.screens, doc.name)
		end
		result.elements[doc.name] = map
	end
	return result
end

---------------------------------------------------------------------------
-- Sélection dans l'Explorateur
---------------------------------------------------------------------------

function App:_onSelectionChanged()
	if self._destroyed then
		return
	end
	if self.workspace == "interface" then
		self:_onSelectionChangedInterface()
		return
	end
	if self:_followScript() then
		self:_syncSession()
		self:_updateTopBar()
		self:_rebuildTestProblems()
		self:_scheduleAnalysis()
		self:setStatus("Le script Blocs FR a été déplacé : nouvelle cible " .. pathOf(self.target) .. ".", "info")
	end
	local sel = firstSelected()
	if not sel then
		return
	end
	if sel == self.target or sel == self.scriptInstance then
		return
	end
	if self.scriptInstance and isAlive(self.scriptInstance) then
		local inside = false
		pcall(function()
			inside = sel:IsDescendantOf(self.scriptInstance)
		end)
		if inside then
			return
		end
	end
	local count = 0
	pcall(function()
		count = tonumber(self.model:count()) or 0
	end)
	local found = findProjectScript(sel)
	-- Projet modifié : on ne le remplace pas. Seul un projet vide qui n'a pas encore de script peut
	-- changer de cible (il garde son type de script et ses variables).
	if self.model.dirty and (found ~= nil or count > 0 or self:_hasScript()) then
		self:setStatus("Projet modifié : enregistre-le avant de changer de cible.", "warning")
		return
	end
	if found then
		if found == self.scriptInstance then
			return
		end
		local model, err, warnings = loadScript(found)
		if model then
			self:loadModel(model, found.Parent, found)
			self:setStatus(loadedMessage(found, warnings))
			self:_offerDraft("blocs", false)
		else
			self:setStatus(tostring(err), "error")
		end
		return
	end
	if count == 0 then
		self.target = sel
		self.scriptInstance = nil
		self:_syncSession()
		self:_updateTopBar()
		self:_rebuildTestProblems()
		self:_scheduleAnalysis()
		self:setStatus("Nouvelle cible : " .. pathOf(sel) .. ".", "info")
		self:_offerDraft("blocs", false)
	else
		self:setStatus("Clique sur « Nouveau » pour programmer " .. pathOf(sel) .. ".", "info")
	end
end

-- Onglet Interface : sélectionner un écran Blocs FR (ou un de ses objets) l'ouvre si rien n'est modifié
function App:_onSelectionChangedInterface()
	local sel = firstSelected()
	if not sel then
		return
	end
	local GuiStorage = optionalModule("GuiStorage")
	if not GuiStorage or type(GuiStorage.screenOf) ~= "function" then
		return
	end
	local ok, screen = pcall(GuiStorage.screenOf, sel)
	if not ok or typeof(screen) ~= "Instance" then
		return
	end
	if screen == self:_currentScreenGui() then
		return
	end
	if self:_interfaceDirty() then
		self:setStatus("Écran modifié : enregistre-le (« Enregistrer l'écran ») avant d'en ouvrir un autre.", "warning")
		return
	end
	self:openScreen(screen, { force = true })
end

-- Sélectionne la cible (ou le script) dans l'Explorateur de Studio
function App:selectInExplorer(what)
	if self._destroyed then
		return
	end
	local inst = self.target
	if what == "script" then
		inst = self.scriptInstance
	end
	if not isAlive(inst) then
		if what == "script" then
			self.dialogs:toast("Il n'y a pas encore de script : clique sur « Enregistrer ».", "info")
		else
			self.dialogs:toast("Cet objet n'existe pas (ou plus) dans le jeu.", "warning")
		end
		return
	end
	local ok, err = pcall(function()
		Selection:Set({ inst })
	end)
	if not ok then
		self.dialogs:toast("Sélection impossible : " .. tostring(err), "error")
		return
	end
	self:setStatus(pathOf(inst) .. " est sélectionné dans l'Explorateur.", "info")
end

---------------------------------------------------------------------------
-- Actions (utilisées par la barre d'outils)
---------------------------------------------------------------------------

function App:setStatus(text, kind)
	text = tostring(text or "")
	if not STATUS_KEYS[kind] then
		kind = "info"
	end
	self.statusText = text
	self.statusKind = kind
	if self.statusLabel then
		self.statusLabel.Text = text
		self.statusLabel.TextColor3 = themeColor(STATUS_KEYS[kind])
	end
end

function App:newProject()
	if self._destroyed then
		return
	end
	if self.workspace ~= "blocs" then
		self:setWorkspace("blocs")
	end
	local function start()
		if self._destroyed then
			return
		end
		local target = firstSelected()
		if target and isProjectScript(target) then
			target = target.Parent
		end
		if not isAlive(target) then
			target = workspace
		end
		local existing = findProjectScript(target)
		self:loadModel(Model.new(), target, nil)
		if existing then
			self:setStatus(
				"Nouveau projet pour " .. pathOf(target) .. " : son script Blocs FR actuel sera remplacé à l'enregistrement.",
				"warning"
			)
		else
			self:setStatus("Nouveau projet pour " .. pathOf(target) .. ".", "info")
		end
	end
	if self.model.dirty then
		self.dialogs:confirm(
			"Nouveau projet",
			"Le projet n'est pas enregistré. Continuer quand même ?",
			start,
			"Continuer",
			"Annuler"
		)
	else
		start()
	end
end

function App:openFromSelection()
	if self._destroyed then
		return
	end
	if self.workspace ~= "blocs" then
		self:setWorkspace("blocs")
	end
	local sel = firstSelected()
	if not sel then
		self.dialogs:toast(
			"Sélectionne d'abord, dans l'Explorateur, l'objet qui contient le script Blocs FR.",
			"error"
		)
		return
	end
	local found = findProjectScript(sel)
	if not found then
		self.dialogs:toast("Aucun script Blocs FR dans « " .. pathOf(sel) .. " ».", "error")
		return
	end
	local function open()
		if self._destroyed then
			return
		end
		local model, err, warnings = loadScript(found)
		if not model then
			self.dialogs:toast(tostring(err), "error")
			self:setStatus(tostring(err), "error")
			return
		end
		self:loadModel(model, found.Parent, found)
		self.dialogs:toast("Projet ouvert : " .. pathOf(found), "success")
		self:setStatus(loadedMessage(found, warnings))
		self:_offerDraft("blocs", false)
	end
	if self.model.dirty then
		self.dialogs:confirm(
			"Ouvrir un projet",
			"Le projet n'est pas enregistré. Continuer quand même ?",
			open,
			"Continuer",
			"Annuler"
		)
	else
		open()
	end
end

-- « Enregistrer » (onglet Interface : « Enregistrer l'écran »)
function App:save()
	if self._destroyed or self._saving then
		return false
	end
	if self.workspace == "interface" then
		return self:saveScreen()
	end
	self._saving = true
	local ok, result = pcall(self._saveImpl, self)
	self._saving = false
	if not ok then
		local msg = "Échec de l'enregistrement : " .. tostring(result)
		warn("[Blocs FR] " .. msg)
		if self.dialogs then
			self.dialogs:toast(msg, "error")
		end
		self:setStatus(msg, "error")
		return false
	end
	return result == true
end

function App:_saveImpl()
	-- Le script a été déplacé dans l'Explorateur : on le met à jour là où il est maintenant
	self:_followScript()

	-- Analyse à jour avant d'écrire le script (le détecteur ne bloque jamais l'enregistrement)
	local okAnalysis, analysisErr = pcall(self._analyzeNow, self)
	if not okAnalysis then
		warn("[Blocs FR] Détecteur avant l'enregistrement : " .. tostring(analysisErr))
	end
	if self._destroyed then
		return false
	end
	self:_followScript() -- (l'analyse a pu céder la main : le script a pu bouger entre-temps)

	-- La cible a été supprimée : on enregistre dans la sélection actuelle (ou le Workspace)
	if not isAlive(self.target) then
		local newTarget = firstSelected()
		if newTarget and isProjectScript(newTarget) then
			newTarget = newTarget.Parent
		end
		if not isAlive(newTarget) then
			newTarget = workspace
		end
		self.target = newTarget
		self.scriptInstance = nil
		self.dialogs:toast(
			"L'ancienne cible n'existe plus : le script sera enregistré dans " .. pathOf(newTarget) .. ".",
			"warning"
		)
	end

	-- Script existant à mettre à jour (évite d'en créer un deuxième dans la même cible)
	local existing = self.scriptInstance
	if not isAlive(existing) then
		existing = findProjectScript(self.target)
	end

	local ok, scriptInst, err, warnings = pcall(Storage.save, self.model, self.target, existing)
	if not ok then
		err = tostring(scriptInst)
		scriptInst = nil
	end
	if typeof(scriptInst) ~= "Instance" then
		local msg = "Échec de l'enregistrement : " .. tostring(err or "erreur inconnue")
		self.dialogs:toast(msg, "error")
		self:setStatus(msg, "error")
		return false
	end

	pcall(function()
		self.model:markSaved()
	end)
	self.scriptInstance = scriptInst
	self:_syncSession()
	self:_clearDraft("blocs", pathOf(self.target))
	self:_rebuildTestProblems()

	local warningCount = 0
	if type(warnings) == "table" then
		warningCount = #warnings
	end
	local errorCount = self._problemCounts.erreur or 0
	local savedWhat = "Script"
	local isModule = modeOf(self.model) == "module"
	pcall(function()
		isModule = isModule or scriptInst:IsA("ModuleScript")
	end)
	if isModule then
		savedWhat = "Module"
	end
	local msg = savedWhat .. " enregistré dans " .. pathOf(self.target) .. " (" .. scriptInst.Name .. ")"
	if errorCount > 0 then
		self.dialogs:toast(
			msg .. ", mais le détecteur a trouvé " .. severityWord("erreur", errorCount) .. " : ouvre le détecteur (⚠).",
			"warning",
			6
		)
	elseif warningCount > 0 then
		self.dialogs:toast(msg .. " — " .. plural(warningCount, "avertissement"), "success")
	else
		self.dialogs:toast(msg, "success")
	end
	if warningCount > 0 then
		local extra = ""
		if warningCount > 1 then
			extra = " (+" .. plural(warningCount - 1, "autre") .. ", voir « Voir le code »)"
		end
		self:setStatus("⚠ " .. tostring(warnings[1]) .. extra, "warning")
	elseif errorCount > 0 then
		self:setStatus(msg .. " — " .. severityWord("erreur", errorCount) .. " à corriger (détecteur ⚠).", "warning")
	else
		self:setStatus(msg .. ".", "success")
	end
	self:_updateTopBar()
	return true
end

-- mode : "server" | "local" | "module"
function App:setMode(mode)
	if self._destroyed or MODES[mode] == nil then
		return
	end
	if self.model.mode == mode then
		return
	end
	if self.workspace == "interface" then
		self:setStatus("Le script d'un écran est toujours un script local (il tourne chez chaque joueur).", "info")
		self:_updateTopBar()
		return
	end
	self.model:setMode(mode)
	if self.model.mode ~= mode then
		-- le modèle a refusé ce type de script : rien n'a changé, pas d'étape d'annulation
		self:setStatus("Ce type de script n'est pas disponible pour le moment.", "error")
		self:_updateTopBar()
		return
	end
	self.model:commit("mode")
	self:setStatus(MODES[mode].status, "info")
end

-- Génère le code et l'affiche. Renvoie ok, résultat de CodeGen.generate.
function App:_showGeneratedCode(silent)
	if not self.codeview then
		return false, nil
	end
	local mode = modeOf(self.model)
	local ok, result = pcall(CodeGen.generate, self.model, mode)
	if not ok or type(result) ~= "table" then
		local msg = "Impossible de générer le code : " .. tostring(result)
		if not silent then
			self.dialogs:toast(msg, "error")
		end
		self:setStatus(msg, "error")
		return false, nil
	end
	local list = {}
	for _, e in ipairs(result.errors or {}) do
		table.insert(list, "Erreur : " .. tostring(e))
	end
	for _, w in ipairs(result.warnings or {}) do
		table.insert(list, tostring(w))
	end
	self:_safe("vue du code", function()
		self.codeview:show(tostring(result.code or ""), list, mode)
	end)
	return true, result
end

function App:showCode()
	if self._destroyed then
		return
	end
	-- La vue du code, le détecteur et l'explication occupent le même côté : un seul à la fois
	self:_hideRightPanels("code")
	self:_showGeneratedCode(false)
	self:_updateTopBar()
end

-- « Voir le code » de la barre : ouvre ou ferme la vue du code
function App:toggleCode()
	if self._destroyed then
		return
	end
	if self:_codeVisible() then
		pcall(function()
			self.codeview:hide()
		end)
		self:_updateTopBar()
		return
	end
	self:showCode()
end

-- Entrée de la table des lignes pour un bloc (ou le premier de ses parents qui y figure)
function App:_lineEntryFor(lineMap, blockId)
	if type(lineMap) ~= "table" then
		return nil
	end
	local index = {}
	for _, entry in ipairs(lineMap) do
		if type(entry) == "table" and entry.block ~= nil and index[entry.block] == nil then
			index[entry.block] = entry
		end
	end
	local id = blockId
	local guard = 0
	while id ~= nil and guard < 2000 do
		if index[id] then
			return index[id]
		end
		local block = self.model:get(id)
		id = block and block.parent
		guard += 1
	end
	return nil
end

-- « Voir dans le code » : la vue du code s'ouvre sur les lignes du bloc (nil : juste le code)
function App:showCodeAt(blockId)
	if self._destroyed then
		return
	end
	self:_hideRightPanels("code")
	local ok, result = self:_showGeneratedCode(false)
	if ok and blockId ~= nil and type(result) == "table" then
		local entry = self:_lineEntryFor(result.lineMap, blockId)
		local line = entry and tonumber(entry.line)
		if line and self.codeview and type(self.codeview.scrollToLine) == "function" then
			pcall(self.codeview.scrollToLine, self.codeview, line, tonumber(entry.last))
		else
			self:setStatus(
				"Ce bloc n'apparaît pas dans le code : il n'est pas sous un événement, ou il est désactivé.",
				"info"
			)
		end
	end
	self:_updateTopBar()
end

-- Onglet Interface : « Annuler / Refaire » agit sur l'écran ou sur ses blocs (ce qui a été modifié en
-- dernier, sinon l'autre). Renvoie "gui", "blocs" ou nil.
function App:_undoRoute(kind)
	local editor = self.guiEditor
	local function editorCan()
		if not editor then
			return false
		end
		local fn = editor.canRedo
		if kind == "undo" then
			fn = editor.canUndo
		end
		if type(fn) ~= "function" then
			return false
		end
		local ok, can = pcall(fn, editor)
		return ok and can == true
	end
	local function modelCan()
		local ok, can = pcall(function()
			if kind == "undo" then
				return self.model:canUndo()
			end
			return self.model:canRedo()
		end)
		return ok and can == true
	end
	if self._lastEdited == "gui" then
		if editorCan() then
			return "gui"
		end
		if modelCan() then
			return "blocs"
		end
	else
		if modelCan() then
			return "blocs"
		end
		if editorCan() then
			return "gui"
		end
	end
	return nil
end

function App:undo()
	if self._destroyed then
		return
	end
	if self.workspace == "interface" then
		local route = self:_undoRoute("undo")
		if route == "gui" then
			pcall(self.guiEditor.undo, self.guiEditor)
			self:setStatus("Action annulée sur l'écran.", "info")
			self:_updateTopBar()
		elseif route == "blocs" then
			self.model:undo()
			self:setStatus("Action annulée dans les blocs de l'écran.", "info")
		else
			self:setStatus("Rien à annuler.", "info")
		end
		return
	end
	if self.model:canUndo() then
		self.model:undo()
		self:setStatus("Action annulée.", "info")
	else
		self:setStatus("Rien à annuler.", "info")
	end
end

function App:redo()
	if self._destroyed then
		return
	end
	if self.workspace == "interface" then
		local route = self:_undoRoute("redo")
		if route == "gui" then
			pcall(self.guiEditor.redo, self.guiEditor)
			self:setStatus("Action refaite sur l'écran.", "info")
			self:_updateTopBar()
		elseif route == "blocs" then
			self.model:redo()
			self:setStatus("Action refaite dans les blocs de l'écran.", "info")
		else
			self:setStatus("Rien à refaire.", "info")
		end
		return
	end
	if self.model:canRedo() then
		self.model:redo()
		self:setStatus("Action refaite.", "info")
	else
		self:setStatus("Rien à refaire.", "info")
	end
end

function App:zoomIn()
	if self.canvas then
		self.canvas:zoomIn()
	end
end

function App:zoomOut()
	if self.canvas then
		self.canvas:zoomOut()
	end
end

function App:resetZoom()
	if not self.canvas then
		return
	end
	local frame = self.canvas.frame or self.canvasHost
	local center = frame.AbsolutePosition + frame.AbsoluteSize / 2
	self.canvas:setZoom(1, center)
end

function App:cleanUp()
	if self.canvas then
		self.canvas:cleanUp()
		self:setStatus("Blocs rangés.", "info")
	end
end

-- Centre la vue sur un bloc (dans la partie du canvas que les panneaux de droite ne cachent pas)
function App:focusBlock(blockId)
	if self._destroyed or blockId == nil or self.model == nil or self.model:get(blockId) == nil then
		return false
	end
	if self.workspace == "interface" and self._zoneCollapsed then
		self:toggleZone(false)
	end
	local canvas = self.canvas
	if not canvas or type(canvas.focusBlock) ~= "function" then
		return false
	end
	local ok, result = pcall(canvas.focusBlock, canvas, blockId, self:_rightInset())
	return ok and result ~= false
end

-- Animations de l'éditeur (menu « ? ») : réglage d'Anim et paramètre « animations.actives »
function App:setAnimations(on)
	on = on == true
	local Anim = getAnim()
	if Anim and type(Anim.setEnabled) == "function" then
		pcall(Anim.setEnabled, on)
	end
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.set) == "function" then
		pcall(Reglages.set, self.host, "animations.actives", on)
	end
	if on and self.canvas then
		-- les contours des problèmes reprennent leur respiration au prochain dessin
		self:_safe("canvas", function()
			self.canvas:refresh()
		end)
	end
end

-- Favoris (SPEC §32)
function App:isFavorite(defId)
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.isFavorite) == "function" then
		local ok, result = pcall(Reglages.isFavorite, defId)
		return ok and result == true
	end
	return false
end

function App:toggleFavorite(defId)
	local Reglages = optionalModule("Reglages")
	if not Reglages or type(Reglages.toggleFavorite) ~= "function" then
		self:setStatus("Les favoris ne sont pas disponibles pour le moment.", "warning")
		return false
	end
	local ok, on = pcall(Reglages.toggleFavorite, self.host, defId)
	if not ok then
		self:setStatus("Favoris : " .. tostring(on), "error")
		return false
	end
	local label = tostring(defId)
	pcall(function()
		label = Registry.plainLabel(Registry.get(defId))
	end)
	if on then
		self:setStatus("« " .. label .. " » est dans tes favoris (en haut de la palette).", "success")
	else
		self:setStatus("« " .. label .. " » n'est plus dans tes favoris.", "info")
	end
	return on == true
end

-- Lignes entre les blocs (SPEC §36) : paramètre « zone.liens » = "toujours" | "survol" | "jamais"
-- (défaut "toujours"). Passage de la clé (SPEC §35) : tant que Reglages ne la connaît pas (sa
-- validation retire les clés inconnues à chaque load / save / set), la valeur est gardée dans un réglage
-- du plugin à part (LINKS_SETTING) et remise dans Reglages.current().zone après chaque
-- Reglages.Changed, là où le canvas la lit.

-- Vrai quand Reglages garde lui-même « zone.liens »
local function reglagesKnowsLinks(Reglages)
	local defaults = Reglages and Reglages.DEFAULTS
	return type(defaults) == "table" and type(defaults.zone) == "table" and defaults.zone.liens ~= nil
end

function App:_storedLinkMode()
	local get = self.host.getSetting
	if type(get) == "function" then
		local ok, value = pcall(get, LINKS_SETTING)
		if ok and LINK_MODES[value] then
			return value
		end
	end
	return "toujours"
end

-- Remet « zone.liens » dans les réglages actuels (quand Reglages ne connaît pas la clé)
function App:_injectLinkMode()
	local Reglages = optionalModule("Reglages")
	if not Reglages or type(Reglages.current) ~= "function" or reglagesKnowsLinks(Reglages) then
		return
	end
	local ok, current = pcall(Reglages.current)
	if ok and type(current) == "table" and type(current.zone) == "table" then
		current.zone.liens = self:_storedLinkMode()
	end
end

function App:getLinkMode()
	local Reglages = optionalModule("Reglages")
	if Reglages and reglagesKnowsLinks(Reglages) and type(Reglages.get) == "function" then
		local ok, value = pcall(Reglages.get, "zone.liens")
		if ok and LINK_MODES[value] then
			return value
		end
	end
	return self:_storedLinkMode()
end

function App:setLinkMode(mode)
	if self._destroyed or not LINK_MODES[mode] then
		return false
	end
	local stored = false
	local set = self.host.setSetting
	if type(set) == "function" then
		stored = pcall(set, LINKS_SETTING, mode)
	end
	local Reglages = optionalModule("Reglages")
	if Reglages and reglagesKnowsLinks(Reglages) and type(Reglages.set) == "function" then
		stored = pcall(Reglages.set, self.host, "zone.liens", mode) or stored
	else
		self:_injectLinkMode()
	end
	if self.canvas then
		self:_safe("canvas", function()
			self.canvas:refresh()
		end)
	end
	local texts = {
		toujours = "Lignes entre les blocs : toujours affichées.",
		survol = "Lignes entre les blocs : seulement quand la souris est sur un bloc.",
		jamais = "Lignes entre les blocs : cachées.",
	}
	self:setStatus(texts[mode], "info")
	return stored
end

---------------------------------------------------------------------------
-- Wiki et aide
---------------------------------------------------------------------------

-- Ouvre la fenêtre du wiki (page pageId ou fiche du bloc defId). Renvoie true si c'est fait.
function App:_openWiki(pageId, defId)
	local fn = self.host.openWiki
	if type(fn) ~= "function" then
		return false
	end
	local ok, result = pcall(fn, pageId, defId)
	if not ok then
		warn("[Blocs FR] Ouverture du wiki : " .. tostring(result))
		return false
	end
	return result ~= false
end

function App:openWiki(pageId)
	if self._destroyed then
		return
	end
	if self:_openWiki(pageId, nil) then
		return
	end
	self.dialogs:alert("Wiki Blocs FR", "Le wiki n'est pas disponible pour le moment.\n\n" .. SHORT_HELP)
end

-- « Ouvrir dans le wiki » (canvas, palette) : la fiche du bloc ; nil = l'accueil du wiki
function App:openWikiBlock(defId)
	if self._destroyed then
		return
	end
	if defId == nil then
		self:openWiki(nil)
		return
	end
	self:openHelp(defId)
end

-- « Aide sur l'éditeur » : la page « L'éditeur » du wiki (onglets, palette, zone de travail, menus…)
function App:help()
	if self._destroyed then
		return
	end
	if self:_openWiki("editeur", nil) then
		return
	end
	self.dialogs:alert("Aide — Blocs FR", SHORT_HELP)
end

-- Aide sur un bloc (palette, clic droit sur un bloc) : sa fiche dans le wiki, sinon son explication
function App:openHelp(defId)
	if self._destroyed then
		return
	end
	if type(defId) == "string" and self:_openWiki(nil, defId) then
		return
	end
	local def = nil
	if type(defId) == "string" then
		def = Registry.get(defId)
	end
	if def == nil then
		self.dialogs:alert("Aide", "Aucune aide pour ce bloc.")
		return
	end
	local title = def.id
	pcall(function()
		title = Registry.plainLabel(def)
	end)
	local text = tostring(def.tooltip or "")
	if text == "" then
		text = "Pas encore d'explication pour ce bloc."
	end
	self.dialogs:alert(title, text)
end

---------------------------------------------------------------------------
-- Exemples (SPEC §16) et modèles (SPEC §22.2)
---------------------------------------------------------------------------

-- Projet vide : l'exemple le remplace (avec son mode) ; sinon ses blocs sont ajoutés à droite.
-- Renvoie ok, messageFR
function App:loadExample(exampleId)
	if self._destroyed then
		return false, "L'éditeur est fermé."
	end
	if self.workspace ~= "blocs" then
		self:setWorkspace("blocs")
	end
	local Examples, loadErr = optionalModule("Examples")
	if type(Examples) ~= "table" then
		local msg = "Les exemples ne sont pas disponibles : " .. tostring(loadErr)
		self.dialogs:toast(msg, "error")
		self:setStatus(msg, "error")
		return false, msg
	end
	local entry = findExample(Examples, exampleId)
	if entry == nil or type(entry.data) ~= "table" then
		local msg = "Exemple introuvable : « " .. tostring(exampleId) .. " »."
		self.dialogs:toast(msg, "error")
		self:setStatus(msg, "error")
		return false, msg
	end
	local title = tostring(entry.title or entry.id)
	local mode = entry.mode
	if MODES[mode] == nil then
		mode = entry.data.mode
	end
	if MODES[mode] == nil then
		mode = nil
	end

	local model = self.model
	local empty = false
	pcall(function()
		empty = model:count() == 0
	end)
	local ok, newTops, warnings = pcall(function()
		if empty then
			-- Projet vide : l'exemple le remplace (ses variables, son mode)
			table.clear(model.variables)
			if mode then
				model:setMode(mode)
			end
			return model:importData(entry.data, 0, 0)
		end
		return importBeside(model, entry.data)
	end)
	if not ok then
		local msg = "Impossible de charger l'exemple « " .. title .. " » : " .. tostring(newTops)
		warn("[Blocs FR] " .. msg)
		self.dialogs:toast(msg, "error")
		self:setStatus(msg, "error")
		self:_refreshAll()
		return false, msg
	end
	if type(newTops) ~= "table" then
		newTops = {}
	end
	model:commit("exemple")

	if self.canvas then
		if empty then
			pcall(function()
				self.canvas:resetView()
			end)
		elseif newTops[1] ~= nil then
			local first = newTops[1]
			task.defer(function()
				if not self._destroyed and self.model == model and model:get(first) ~= nil then
					self:focusBlock(first)
				end
			end)
		end
	end

	local text
	if empty then
		text = "Exemple « " .. title .. " » chargé."
	else
		text = "Exemple « " .. title .. " » ajouté à droite de tes blocs."
	end
	self.dialogs:toast(text, "success")
	if not empty and mode ~= nil and mode ~= model.mode then
		local wanted = MODES[mode].article
		self.dialogs:toast(
			"Cet exemple est prévu pour " .. wanted .. " : change le type de script si ses blocs sont signalés.",
			"warning",
			6
		)
	end
	local status, kind = text, "success"
	if type(entry.cible) == "string" and entry.cible ~= "" then
		local cible = string.gsub(entry.cible, "[%.%s]+$", "")
		status = status .. " Cible conseillée : " .. cible .. "."
	end
	if type(warnings) == "table" and #warnings > 0 then
		status = "⚠ " .. tostring(warnings[1])
		kind = "warning"
	end
	self:setStatus(status, kind)
	return true, nil
end

-- Centre de la partie visible du canvas (point écran), ou nil
function App:_visibleCanvasCenter()
	local frame = self.canvas and self.canvas.frame
	if not frame then
		return nil
	end
	local size = frame.AbsoluteSize
	local w = math.max(40, size.X - self:_rightInset())
	return Vector2.new(frame.AbsolutePosition.X + w / 2, frame.AbsolutePosition.Y + size.Y / 2)
end

-- Modèle de la palette (script tout fait) : la première pile arrive au point de dépôt (screenPos) ou au
-- centre de la zone visible (clic) ; projet vide (onglet Blocs) : le type de script suit le modèle.
function App:insertModele(id, screenPos)
	if self._destroyed then
		return false
	end
	local Modeles = optionalModule("Modeles")
	if type(Modeles) ~= "table" or type(Modeles.get) ~= "function" then
		self.dialogs:toast("Les modèles ne sont pas disponibles pour le moment.", "error")
		return false
	end
	local okEntry, entry = pcall(Modeles.get, id)
	if not okEntry or type(entry) ~= "table" or type(entry.data) ~= "table" then
		self.dialogs:toast("Modèle introuvable : « " .. tostring(id) .. " ».", "error")
		return false
	end
	-- Modèle d'écran (champ ecran = id de GuiTemplates) : l'écran ET ses blocs s'ouvrent dans le Studio
	-- d'interface, comme « Nouvel écran depuis un modèle » (le point de dépôt ne compte pas)
	if type(entry.ecran) == "string" and entry.ecran ~= "" then
		return self:insertTemplate(entry.ecran)
	end
	local title = tostring(entry.title or entry.id or id)
	local model = self.model
	local blocks, notes = countOf(model)
	local empty = blocks + notes == 0
	local mode = entry.mode
	if MODES[mode] == nil then
		mode = entry.data.mode
	end
	if MODES[mode] == nil then
		mode = nil
	end

	local centered = typeof(screenPos) ~= "Vector2"
	local point = nil
	local canvas = self.canvas
	if canvas and type(canvas.screenToCanvas) == "function" then
		local p = screenPos
		if centered then
			p = self:_visibleCanvasCenter()
		end
		if typeof(p) == "Vector2" then
			local ok, cp = pcall(canvas.screenToCanvas, canvas, p)
			if ok and typeof(cp) == "Vector2" then
				point = cp
			end
		end
	end
	local x0, y0 = firstTopPosition(entry.data)
	if point == nil then
		point = Vector2.new(x0, y0)
	end
	local dx, dy = math.floor(point.X - x0 + 0.5), math.floor(point.Y - y0 + 0.5)
	local ok, newTops = pcall(function()
		if empty and mode and self.workspace == "blocs" then
			model:setMode(mode)
		end
		return model:importData(entry.data, dx, dy)
	end)
	if not ok then
		local msg = "Impossible d'ajouter le modèle « " .. title .. " » : " .. tostring(newTops)
		warn("[Blocs FR] " .. msg)
		self.dialogs:toast(msg, "error")
		self:_refreshAll()
		return false
	end
	if type(newTops) ~= "table" then
		newTops = {}
	end
	-- clic (sans point de dépôt) : la première pile est centrée dans la zone visible
	if centered and newTops[1] ~= nil and canvas ~= nil then
		local w, h = stackSize(model, newTops[1])
		local sx, sy = -math.floor(w / 2), -math.floor(math.min(h, 240) / 2)
		for _, topId in ipairs(newTops) do
			local block = model:get(topId)
			if block then
				model:moveTo(topId, block.x + sx, block.y + sy)
				pcall(function()
					model:moveNotesWith(model:stackIds(topId), sx, sy)
				end)
			end
		end
	end
	model:commit("modele")
	self.dialogs:toast("Modèle « " .. title .. " » ajouté", "success")
	if mode ~= nil and mode ~= model.mode then
		self.dialogs:toast("Ce modèle est prévu pour " .. MODES[mode].article .. ".", "warning", 6)
	end
	self:setStatus("Modèle « " .. title .. " » ajouté (" .. plural(#newTops, "pile") .. ").", "success")
	return true
end

---------------------------------------------------------------------------
-- Explique-moi ce script (SPEC §28)
---------------------------------------------------------------------------

function App:_ensureExplanationPanel()
	if self.explicationPanel then
		return self.explicationPanel
	end
	local ExplicationPanel, err = optionalModule("ExplicationPanel")
	if ExplicationPanel == nil or type(ExplicationPanel.new) ~= "function" then
		return nil, err
	end
	local ok, panel = pcall(ExplicationPanel.new, self.problemsLayer, {
		dialogs = self.dialogs,
		onSelectBlock = function(blockId)
			self:focusBlock(blockId)
		end,
		onSimulate = function(blockId)
			self:openHitboxPreview(blockId)
		end,
		onPlayStep = function(blockId)
			self:_onPlayStep(blockId)
		end,
		onVisibilityChanged = function()
			if not self._destroyed then
				self:_updateTopBar()
			end
		end,
	})
	if not ok or type(panel) ~= "table" then
		warn("[Blocs FR] Panneau « Ce que fait ce script » indisponible : " .. tostring(panel))
		return nil, panel
	end
	self.explicationPanel = panel
	return panel
end

-- Lecture pas à pas : chaque étape montre son bloc (sélectionné) ; nil = fin de la lecture
function App:_onPlayStep(blockId)
	if self._destroyed then
		return
	end
	local canvas = self.canvas
	if blockId == nil then
		if canvas and type(canvas.clearSelection) == "function" then
			pcall(canvas.clearSelection, canvas)
		end
		return
	end
	if self.model:get(blockId) == nil then
		return
	end
	self:focusBlock(blockId)
	if canvas and type(canvas.select) == "function" then
		pcall(canvas.select, canvas, { blockId }, false)
	end
end

-- « Expliquer » : ouvre (ou ferme) le panneau « Ce que fait ce script ». forceShow : toujours l'ouvrir.
function App:explain(forceShow)
	if self._destroyed then
		return
	end
	local panel, err = self:_ensureExplanationPanel()
	if not panel then
		self.dialogs:toast("« Expliquer » n'est pas disponible pour le moment : " .. tostring(err), "warning")
		return
	end
	if self:_explainVisible() and forceShow ~= true then
		pcall(function()
			panel:hide()
		end)
		self:_updateTopBar()
		return
	end
	self:_hideRightPanels("explain")
	self:_refreshExplanation(true)
	pcall(function()
		panel:show()
	end)
	self:_updateTopBar()
end

-- Recalcule l'explication (si le panneau est ouvert, ou force = true)
function App:_refreshExplanation(force)
	local panel = self.explicationPanel
	if not panel or (force ~= true and not self:_explainVisible()) then
		return
	end
	local Explication = optionalModule("Explication")
	if not Explication or type(Explication.explain) ~= "function" then
		return
	end
	local target = nil
	if isAlive(self.target) then
		target = self.target
	end
	local ok, result = pcall(Explication.explain, self.model, {
		mode = modeOf(self.model),
		target = target,
		problems = self._problems,
		guiNames = self._lastGuiNames,
	})
	if ok and type(result) == "table" then
		pcall(function()
			panel:setContent(result)
		end)
	elseif not ok then
		warn("[Blocs FR] Explication : " .. tostring(result))
	end
end

---------------------------------------------------------------------------
-- Prévisualiseur de hitbox (SPEC §27)
---------------------------------------------------------------------------

function App:_canPreviewHitbox(defId)
	local HitboxPreview = optionalModule("HitboxPreview")
	if not HitboxPreview or type(HitboxPreview.supports) ~= "function" or defId == nil then
		return false
	end
	local ok, result = pcall(HitboxPreview.supports, defId)
	return ok and result == true and defId ~= "libre"
end

-- Ouvre le prévisualiseur pour un bloc de combat (ses entrées peuvent être modifiées) ou « libre » (nil)
function App:openHitboxPreview(blockId)
	if self._destroyed then
		return
	end
	local HitboxPreview, err = optionalModule("HitboxPreview")
	if not HitboxPreview or type(HitboxPreview.open) ~= "function" then
		self.dialogs:toast("Le prévisualiseur de hitbox n'est pas disponible : " .. tostring(err), "warning")
		return
	end
	if self.hitboxPreview then
		local old = self.hitboxPreview
		self.hitboxPreview = nil
		pcall(function()
			old:close()
		end)
	end
	local model = self.model
	if blockId ~= nil then
		local block = model:get(blockId)
		if block == nil or not self:_canPreviewHitbox(block.def) then
			blockId = nil
		end
	end
	local onApply = nil
	if blockId ~= nil then
		-- Le prévisualiseur affiche seul le résultat : sa notification de réussite quand cette fonction
		-- se termine normalement, « Impossible d'appliquer les réglages au bloc : <message> » quand elle
		-- lève une erreur. Donc pas de notification ici, et une erreur (niveau 0) quand rien n'est changé.
		onApply = function(values)
			if self._destroyed then
				return false
			end
			if self.model ~= model or model:get(blockId) == nil then
				error("ce bloc n'existe plus dans le script ouvert, rien n'a été changé.", 0)
			end
			local changed = 0
			if type(values) == "table" then
				for name, value in pairs(values) do
					local ok, done = pcall(function()
						return model:setInput(blockId, name, value)
					end)
					if ok and done == true then
						changed += 1
					end
				end
			end
			if changed == 0 then
				error("aucune valeur n'a pu être mise dans le bloc.", 0)
			end
			model:commit("hitbox")
			return true
		end
	end
	local target = nil
	if isAlive(self.target) then
		target = self.target
	end
	local preview = nil
	local ok, result = pcall(HitboxPreview.open, self.dialogLayer, {
		host = self.host,
		dialogs = self.dialogs,
		model = model,
		blockId = blockId,
		onApply = onApply,
		onClose = function()
			if self.hitboxPreview == preview then
				self.hitboxPreview = nil
			end
		end,
		targetPath = target and pathOf(target),
		mode = modeOf(model),
		openSettings = function(section)
			self:openSettings(section)
		end,
	})
	if not ok then
		warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(result))
		self.dialogs:toast("Impossible d'ouvrir le prévisualiseur : " .. tostring(result), "error")
		return
	end
	preview = result
	self.hitboxPreview = preview
end

---------------------------------------------------------------------------
-- Paramètres (SPEC §31)
---------------------------------------------------------------------------

function App:openSettings(section)
	if self._destroyed then
		return
	end
	local ReglagesPanel, err = optionalModule("ReglagesPanel")
	if not ReglagesPanel or type(ReglagesPanel.open) ~= "function" then
		self.dialogs:toast("Les paramètres ne sont pas disponibles pour le moment : " .. tostring(err), "warning")
		return
	end
	if self.settingsPanel then
		local old = self.settingsPanel
		self.settingsPanel = nil
		pcall(function()
			old:close()
		end)
	end
	local panel = nil
	local ok, result = pcall(ReglagesPanel.open, self.dialogLayer, {
		host = self.host,
		dialogs = self.dialogs,
		version = self.host.version,
		section = section,
		onApply = function(s)
			self:_applySettings(s)
		end,
		onClose = function()
			if self.settingsPanel == panel then
				self.settingsPanel = nil
			end
		end,
	})
	if not ok then
		warn("[Blocs FR] Paramètres : " .. tostring(result))
		self.dialogs:toast("Impossible d'ouvrir les paramètres : " .. tostring(result), "error")
		return
	end
	panel = result
	self.settingsPanel = panel
	-- Ouvert pour une section (« previsualisation » depuis le prévisualiseur de hitbox) : on y descend
	-- quand la liste a sa taille (NOTE: ReglagesPanel n'a pas d'API publique pour cela)
	if type(section) == "string" and section ~= "" and type(panel) == "table" then
		task.delay(0.15, function()
			if self._destroyed or self.settingsPanel ~= panel then
				return
			end
			local sections = panel.sections
			if type(sections) ~= "table" then
				return
			end
			local scroll = panel.showSection or panel._scrollToSection
			for i, entry in ipairs(sections) do
				if type(entry) == "table" and type(entry.def) == "table" and entry.def.id == section then
					if type(panel.showSection) == "function" then
						pcall(scroll, panel, section)
					elseif type(scroll) == "function" then
						pcall(scroll, panel, i)
					end
					break
				end
			end
		end)
	end
end

-- « Appliquer » : enregistre, applique au thème, puis l'éditeur est reconstruit (host.rebuildApp) en
-- gardant les projets ouverts
function App:_applySettings(s)
	if self._destroyed then
		return
	end
	local Reglages = optionalModule("Reglages")
	-- « zone.liens » (SPEC §36) : gardé à part si Reglages ne connaît pas la clé (sinon il la perdrait)
	if type(s) == "table" and type(s.zone) == "table" and LINK_MODES[s.zone.liens] then
		local set = self.host.setSetting
		if type(set) == "function" then
			pcall(set, LINKS_SETTING, s.zone.liens)
		end
	end
	-- « Taille des blocs » (zoom de départ) changée : les vues reprennent ce zoom après la reconstruction
	local zoomBefore = type(Theme.Canvas) == "table" and Theme.Canvas.Zoom or nil
	if Reglages then
		if type(Reglages.save) == "function" then
			local ok, saved = pcall(Reglages.save, self.host, s)
			if ok and type(saved) == "table" then
				s = saved
			end
		end
		if type(Reglages.applyToTheme) == "function" then
			pcall(Reglages.applyToTheme, s)
		end
	end
	if type(Theme.Canvas) == "table" and Theme.Canvas.Zoom ~= zoomBefore then
		self._resetViews = true
	end
	local rebuild = self.host.rebuildApp
	if type(rebuild) ~= "function" then
		self:_refreshAll()
		self.dialogs:toast("Paramètres appliqués (certaines couleurs changeront à la prochaine ouverture).", "success")
		return
	end
	local function doRebuild()
		if self._destroyed then
			return
		end
		self._settingsNotice = "Paramètres appliqués ✓"
		task.defer(function()
			local ok, err = pcall(rebuild)
			if not ok then
				warn("[Blocs FR] Reconstruction de l'éditeur : " .. tostring(err))
			end
		end)
	end
	-- l'éditeur d'écrans ne sait pas garder un dessin non enregistré : on demande d'abord
	local editor = self.guiEditor
	local canKeep = editor ~= nil and (type(editor.exportState) == "function" or type(editor.loadDoc) == "function")
	if editor ~= nil and not canKeep and self:_editorDirty() then
		self:_choice(
			"Appliquer les paramètres",
			"Pour appliquer les paramètres, l'éditeur se recharge. Ton écran « "
				.. tostring(self:_currentScreenName() or "")
				.. " » n'est pas enregistré : enregistre-le d'abord pour ne pas perdre son dessin.",
			{
				{ text = "Plus tard", style = "normal" },
				{ text = "Appliquer sans enregistrer", style = "danger", action = doRebuild },
				{
					text = "Enregistrer puis appliquer",
					style = "primary",
					action = function()
						if self:saveScreen() then
							doRebuild()
						end
					end,
				},
			}
		)
		return
	end
	doRebuild()
end

---------------------------------------------------------------------------
-- Code de partage (SPEC §32)
---------------------------------------------------------------------------

function App:_closeTextWindow()
	local win = self._textWindow
	if not win then
		return
	end
	self._textWindow = nil
	win.maid:clean()
end

-- Fenêtre avec une grande zone de texte (partager / importer un code), dans le calque des dialogues.
-- spec = { title, message, text, readOnly, placeholder, closeOnOverlay, buttons = { { text, style,
-- action = fn(win) } } } ; win = { getText(), setError(texte), selectAll(), close() }
function App:_openTextWindow(spec)
	self:_closeTextWindow()
	local layerFrame = self.dialogLayer
	if not layerFrame then
		return nil
	end
	if self.dialogs then
		pcall(function()
			self.dialogs:closeAll()
		end)
	end
	local maid = Util.Maid.new()
	local win = { maid = maid }
	self._textWindow = win
	local size = layerFrame.AbsoluteSize
	local W = math.floor(math.min(560, math.max(300, size.X - 40)))
	local H = math.floor(math.min(380, math.max(250, size.Y - 60)))
	local readOnly = spec.readOnly == true

	local overlay = Util.create("TextButton", {
		Name = "FenetreTexte",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		BackgroundColor3 = C.Overlay,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_TEXT_WINDOW,
		Parent = layerFrame,
	})
	maid:give(overlay)
	-- la fenêtre est un bouton : un clic à l'intérieur ne traverse pas jusqu'au fond
	local box = Util.create("TextButton", {
		Name = "Fenetre",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Parent = overlay,
	})
	Util.corner(box, 12)
	Util.stroke(box, C.PopupBorder, 1)
	makeLabel({
		Name = "Titre",
		Text = tostring(spec.title or ""),
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.fromOffset(W - 70, 22),
		Parent = box,
	})
	local closeButton = Util.create("TextButton", {
		Name = "Fermer",
		Text = "×",
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		TextColor3 = C.TextDim,
		AutoButtonColor = false,
		BackgroundColor3 = C.PopupHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(28, 28),
		Parent = box,
	})
	Util.corner(closeButton, 7)
	maid:give(closeButton.MouseEnter:Connect(function()
		closeButton.BackgroundTransparency = 0
	end))
	maid:give(closeButton.MouseLeave:Connect(function()
		closeButton.BackgroundTransparency = 1
	end))

	local message = tostring(spec.message or "")
	local messageH = wrappedHeight(message, 12, Theme.Fonts.UI, W - 36)
	makeLabel({
		Name = "Message",
		Text = message,
		TextSize = 12,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.fromOffset(W - 36, messageH),
		Parent = box,
	})
	local areaY = 44 + messageH + 10
	local buttonsH = 32
	local errorH = 18
	local areaH = math.max(70, H - areaY - 10 - errorH - buttonsH - 16)
	local area = Util.create("ScrollingFrame", {
		Name = "Zone",
		BackgroundColor3 = C.FieldBg,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(18, areaY),
		Size = UDim2.fromOffset(W - 36, areaH),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = box,
	})
	Util.corner(area, 8)
	local areaStroke = Util.stroke(area, C.PopupBorder, 1)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = area,
	})
	local content = tostring(spec.text or "")
	local textBox = Util.create("TextBox", {
		Name = "Texte",
		Text = content,
		PlaceholderText = tostring(spec.placeholder or ""),
		PlaceholderColor3 = C.TextDisabled,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextEditable = not readOnly,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.Code,
		TextSize = 12,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, math.max(20, areaH - 16)),
		Parent = area,
	})
	maid:give(textBox.Focused:Connect(function()
		areaStroke.Color = C.Accent
		areaStroke.Thickness = 2
	end))
	maid:give(textBox.FocusLost:Connect(function()
		areaStroke.Color = C.PopupBorder
		areaStroke.Thickness = 1
	end))
	if readOnly then
		-- lecture seule : le texte revient tout seul s'il a été modifié
		maid:give(textBox:GetPropertyChangedSignal("Text"):Connect(function()
			if textBox.Text ~= content then
				task.defer(function()
					if textBox.Parent ~= nil and textBox.Text ~= content then
						textBox.Text = content
					end
				end)
			end
		end))
	end
	local errorLabel = makeLabel({
		Name = "Erreur",
		TextSize = 12,
		TextColor3 = C.DangerText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, areaY + areaH + 6),
		Size = UDim2.fromOffset(W - 36, errorH),
		Visible = false,
		Parent = box,
	})

	function win.getText()
		return textBox.Text
	end
	function win.setError(text)
		local value = tostring(text or "")
		errorLabel.Text = value
		errorLabel.Visible = value ~= ""
		local Anim = getAnim()
		if value ~= "" and Anim and type(Anim.shake) == "function" then
			pcall(Anim.shake, box)
		end
	end
	function win.selectAll()
		task.defer(function()
			if textBox.Parent == nil then
				return
			end
			pcall(function()
				textBox:CaptureFocus()
				textBox.CursorPosition = #textBox.Text + 1
				textBox.SelectionStart = 1
			end)
		end)
	end
	function win.close()
		if self._textWindow == win then
			self:_closeTextWindow()
		end
	end
	maid:give(closeButton.MouseButton1Click:Connect(win.close))
	if spec.closeOnOverlay == true then
		maid:give(overlay.MouseButton1Click:Connect(win.close))
	end

	-- Boutons alignés à droite (le dernier de la liste est le plus à droite)
	local buttons = spec.buttons or {}
	local right = W - 18
	for i = #buttons, 1, -1 do
		local b = buttons[i]
		local text = tostring(b.text or "OK")
		local bw = math.max(96, textWidth(text, 13, Theme.Fonts.UIBold) + 30)
		right -= bw
		local bg, hover, textColor = C.Button, C.ButtonHover, C.Text
		if b.style == "primary" then
			bg, hover, textColor = C.Accent, C.AccentHover, WHITE
		elseif b.style == "danger" then
			bg, hover, textColor = C.Danger, Theme.lighten(C.Danger, 0.12), WHITE
		end
		local button = Util.create("TextButton", {
			Name = "Bouton",
			Text = text,
			Font = Theme.Fonts.UIBold,
			TextSize = 13,
			TextColor3 = textColor,
			AutoButtonColor = false,
			BackgroundColor3 = bg,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(right, H - 16 - buttonsH),
			Size = UDim2.fromOffset(bw, buttonsH),
			Parent = box,
		})
		Util.corner(button, 8)
		maid:give(button.MouseEnter:Connect(function()
			button.BackgroundColor3 = hover
		end))
		maid:give(button.MouseLeave:Connect(function()
			button.BackgroundColor3 = bg
		end))
		local action = b.action
		maid:give(button.MouseButton1Click:Connect(function()
			if type(action) == "function" then
				local ok, err = pcall(action, win)
				if not ok then
					warn("[Blocs FR] Fenêtre de texte : " .. tostring(err))
					win.setError("Erreur : " .. tostring(err))
				end
			end
		end))
		right -= 8
	end

	-- Apparition : le fond s'assombrit, la fenêtre « se pose »
	local Anim = getAnim()
	if Anim and animEnabled() then
		overlay.BackgroundTransparency = 1
		Anim.tween(overlay, { BackgroundTransparency = 0.45 }, 0.12, "quadOut")
		if type(Anim.popIn) == "function" then
			Anim.popIn(box, 0.92)
		end
	end
	if readOnly then
		win.selectAll()
	else
		task.defer(function()
			if textBox.Parent ~= nil then
				pcall(function()
					textBox:CaptureFocus()
				end)
			end
		end)
	end
	return win
end

-- « Partager ce script… » : un code « BLOCSFR1:{…} » à copier et envoyer
function App:shareScript()
	if self._destroyed then
		return
	end
	local model = self.model
	local blocks, notes = countOf(model)
	if blocks + notes == 0 then
		self.dialogs:toast("Il n'y a encore aucun bloc à partager.", "info")
		return
	end
	local okJson, json, err = pcall(Storage.toJson, model)
	if not okJson then
		err = json
		json = nil
	end
	if type(json) ~= "string" then
		self.dialogs:toast("Impossible de préparer le code : " .. tostring(err), "error")
		return
	end
	local what = plural(blocks, "bloc")
	if notes > 0 then
		what = what .. " et " .. plural(notes, "note")
	end
	self:_openTextWindow({
		title = "Partager ce script",
		message = "Copie ce code (clique dedans, puis Ctrl+A et Ctrl+C) et envoie-le à un ami : il le colle dans Blocs FR avec « Importer un code… ». Il contient "
			.. what
			.. ".",
		text = SHARE_PREFIX .. json,
		readOnly = true,
		closeOnOverlay = true,
		buttons = {
			{
				text = "Tout sélectionner",
				style = "normal",
				action = function(win)
					win.selectAll()
				end,
			},
			{
				text = "Fermer",
				style = "primary",
				action = function(win)
					win.close()
				end,
			},
		},
	})
	self:setStatus("Code de partage prêt : " .. what .. ".", "info")
end

-- « Importer un code… » : colle un code de partage, ses blocs arrivent à côté des tiens
function App:importCode()
	if self._destroyed then
		return
	end
	self:_openTextWindow({
		title = "Importer un code",
		message = "Colle ici un code de partage Blocs FR (Ctrl+V). Il commence par « BLOCSFR1: ». Ses blocs seront ajoutés à côté des tiens (tu pourras annuler).",
		text = "",
		readOnly = false,
		placeholder = "BLOCSFR1:{…}",
		buttons = {
			{
				text = "Annuler",
				style = "normal",
				action = function(win)
					win.close()
				end,
			},
			{
				text = "Importer",
				style = "primary",
				action = function(win)
					local ok, err = self:_importCodeText(win.getText())
					if ok then
						win.close()
					else
						win.setError(err)
					end
				end,
			},
		},
	})
end

-- Vérifie un code de partage puis l'importe. Renvoie ok, erreurFR.
function App:_importCodeText(text)
	local body = Util.trim(tostring(text or ""))
	if body == "" then
		return false, "Colle d'abord le code de partage (Ctrl+V)."
	end
	if string.sub(body, 1, #SETTINGS_PREFIX) == SETTINGS_PREFIX then
		return false, "Ce texte est un code de réglages : importe-le dans « Paramètres… » (bouton « Importer »)."
	end
	if string.sub(body, 1, #SHARE_PREFIX) == SHARE_PREFIX then
		body = Util.trim(string.sub(body, #SHARE_PREFIX + 1))
	end
	if string.sub(body, 1, 1) ~= "{" then
		return false, "Ce texte n'est pas un code Blocs FR : il doit commencer par « BLOCSFR1: »."
	end
	local okJson, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not okJson or type(data) ~= "table" then
		return false, "Le code est abîmé (il manque peut-être un morceau) : recopie-le en entier."
	end
	if data.format ~= nil and data.format ~= Model.FORMAT then
		return false, "Ce code ne vient pas de Blocs FR."
	end
	local okModel, check = pcall(Model.fromData, data)
	if not okModel or type(check) ~= "table" then
		return false, "Ce code ne peut pas être lu : " .. tostring(check)
	end
	local codeBlocks, codeNotes = countOf(check)
	pcall(function()
		check:destroy()
	end)
	if codeBlocks + codeNotes == 0 then
		return false, "Ce code ne contient aucun bloc."
	end

	local model = self.model
	local blocks, notes = countOf(model)
	local empty = blocks + notes == 0
	local mode = data.mode
	if MODES[mode] == nil then
		mode = nil
	end
	local ok, newTops, warnings = pcall(function()
		if empty then
			if mode and self.workspace == "blocs" then
				model:setMode(mode)
			end
			return model:importData(data, 0, 0)
		end
		return importBeside(model, data)
	end)
	if not ok then
		return false, "Import impossible : " .. tostring(newTops)
	end
	if type(newTops) ~= "table" then
		newTops = {}
	end
	model:commit("importer")
	if self.canvas then
		if empty then
			pcall(function()
				self.canvas:resetView()
			end)
		elseif newTops[1] ~= nil then
			local first = newTops[1]
			task.defer(function()
				if not self._destroyed and self.model == model and model:get(first) ~= nil then
					self:focusBlock(first)
				end
			end)
		end
	end
	self.dialogs:toast("Code importé : " .. plural(codeBlocks, "bloc") .. " ajouté(s).", "success")
	if mode ~= nil and mode ~= model.mode then
		self.dialogs:toast(
			"Ce code a été fait pour " .. MODES[mode].article .. " : change le type de script si ses blocs sont signalés.",
			"warning",
			6
		)
	end
	if type(warnings) == "table" and #warnings > 0 then
		self:setStatus("⚠ " .. tostring(warnings[1]), "warning")
	else
		self:setStatus("Code importé (" .. plural(codeBlocks, "bloc") .. ").", "success")
	end
	return true, nil
end

---------------------------------------------------------------------------
-- Brouillon automatique (SPEC §32)
---------------------------------------------------------------------------

-- Intervalle des brouillons (s) : réglage « sauvegarde.brouillon » (0 = désactivé)
function App:_draftInterval()
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.get) == "function" then
		local ok, value = pcall(Reglages.get, "sauvegarde.brouillon")
		if ok and type(value) == "number" and value == value then
			return math.max(0, value)
		end
	end
	return 30
end

-- Brouillons gardés, du plus récent au plus ancien
function App:_readDrafts()
	local get = self.host.getSetting
	if type(get) ~= "function" then
		return {}
	end
	local ok, raw = pcall(get, DRAFT_SETTING)
	if not ok or type(raw) ~= "table" then
		return {}
	end
	local list = raw.entries
	if type(list) ~= "table" then
		list = {}
		if type(raw.json) == "string" then
			list = { raw } -- (ancien format : un seul brouillon)
		end
	end
	local entries = {}
	for _, entry in ipairs(list) do
		if type(entry) == "table" and type(entry.json) == "string" and type(entry.targetPath) == "string" then
			if entry.workspace ~= "interface" then
				entry.workspace = "blocs"
			end
			table.insert(entries, entry)
		end
	end
	table.sort(entries, function(a, b)
		return (tonumber(a.time) or 0) > (tonumber(b.time) or 0)
	end)
	return entries
end

function App:_writeDraftEntries(entries)
	local set = self.host.setSetting
	if type(set) ~= "function" then
		return
	end
	table.sort(entries, function(a, b)
		return (tonumber(a.time) or 0) > (tonumber(b.time) or 0)
	end)
	while #entries > DRAFT_MAX_ENTRIES do
		table.remove(entries)
	end
	pcall(set, DRAFT_SETTING, { version = 2, entries = entries })
end

-- Nom de l'écran des blocs de la session « interface » (celui de l'écran précédent pendant un
-- changement d'écran fait par le Studio lui-même)
function App:_draftScreenOf()
	if type(self._draftScreenName) == "string" then
		return self._draftScreenName
	end
	return self:_currentScreenName()
end

-- Chemin qui identifie le brouillon d'une session
function App:_draftPathOf(name, live)
	if name == "interface" then
		if live and isAlive(live.target) then
			return pathOf(live.target)
		end
		return "StarterGui." .. tostring(self:_draftScreenOf() or "?")
	end
	if live and isAlive(live.target) then
		return pathOf(live.target)
	end
	return "(aucune)"
end

-- Brouillon d'une session non enregistrée, ou nil
function App:_draftFor(name)
	local live = self:_sessionState(name)
	local model = live and live.model
	if not model or model.dirty ~= true then
		return nil
	end
	local blocks, notes = countOf(model)
	if blocks + notes == 0 then
		return nil
	end
	local okJson, json = pcall(Storage.toJson, model)
	if not okJson or type(json) ~= "string" or #json > DRAFT_MAX_CHARS then
		return nil
	end
	local entry = {
		json = json,
		targetPath = self:_draftPathOf(name, live),
		workspace = name,
		time = os.time(),
		mode = model.mode,
		count = blocks,
	}
	if name == "interface" then
		entry.screen = self:_draftScreenOf()
	end
	return entry
end

-- Écrit le brouillon des projets modifiés (force : même s'il n'a pas changé depuis le dernier)
function App:_writeDrafts(force)
	if type(self.host.setSetting) ~= "function" or self:_draftInterval() <= 0 then
		return
	end
	local entries = nil
	local changed = false
	for _, name in ipairs({ "blocs", "interface" }) do
		local draft = self:_draftFor(name)
		if draft then
			local key = draft.workspace .. "|" .. draft.targetPath
			if force == true or self._draftSignatures[key] ~= draft.json then
				if entries == nil then
					entries = self:_readDrafts()
				end
				for i = #entries, 1, -1 do
					local e = entries[i]
					if e.workspace == draft.workspace and e.targetPath == draft.targetPath then
						table.remove(entries, i)
					end
				end
				table.insert(entries, draft)
				self._draftSignatures[key] = draft.json
				changed = true
			end
		end
	end
	if changed and entries ~= nil then
		self:_writeDraftEntries(entries)
	end
end

-- Enregistré (ou ignoré) : le brouillon de cette cible n'a plus lieu d'être
function App:_clearDraft(name, path)
	self._draftSignatures[tostring(name) .. "|" .. tostring(path)] = nil
	local entries = self:_readDrafts()
	local removed = false
	for i = #entries, 1, -1 do
		local e = entries[i]
		if e.workspace == name and e.targetPath == path then
			table.remove(entries, i)
			removed = true
		end
	end
	if removed then
		self:_writeDraftEntries(entries)
	end
	return removed
end

-- (aussi pour DevBridge « draft ») Écrit tout de suite le brouillon des projets non enregistrés
function App:saveDraft(force)
	if self._destroyed then
		return false
	end
	local ok, err = pcall(self._writeDrafts, self, force ~= false)
	if not ok then
		warn("[Blocs FR] Brouillon : " .. tostring(err))
	end
	return ok
end

-- Efface le brouillon d'une session (nil : celle de l'onglet affiché ; "*" : tous). Renvoie true si un
-- brouillon a été effacé.
function App:clearDraft(name, path)
	if name == "*" then
		local had = #self:_readDrafts() > 0
		self._draftSignatures = {}
		self:_writeDraftEntries({})
		return had
	end
	if name ~= "blocs" and name ~= "interface" then
		name = self.workspace
	end
	if type(path) ~= "string" then
		path = self:_draftPathOf(name, self:_sessionState(name))
	end
	return self:_clearDraft(name, path)
end

-- Propose le brouillon de l'onglet affiché s'il y en a un. Renvoie true si la question est posée.
function App:checkDraft()
	if self._destroyed then
		return false
	end
	return self:_offerDraft(self.workspace, false) == true
end

function App:_startDraftTimer()
	self._draftToken += 1
	local token = self._draftToken
	local function schedule(delay)
		task.delay(delay, function()
			if self._destroyed or token ~= self._draftToken then
				return
			end
			local interval = self:_draftInterval()
			if interval > 0 then
				local ok, err = pcall(self._writeDrafts, self, false)
				if not ok then
					warn("[Blocs FR] Brouillon automatique : " .. tostring(err))
				end
				schedule(interval)
			else
				schedule(DRAFT_RETRY)
			end
		end)
	end
	local first = self:_draftInterval()
	if first <= 0 then
		first = DRAFT_RETRY
	end
	schedule(first)
end

-- Propose de reprendre le brouillon d'une session (anyTarget : au démarrage, le plus récent de cet onglet
-- même pour une autre cible). Rien si le brouillon est identique à ce qui est enregistré. Renvoie true
-- quand la question est posée.
function App:_offerDraft(name, anyTarget, attempt)
	if self._destroyed or self:_draftInterval() <= 0 then
		return
	end
	attempt = attempt or 0
	if self.dialogs and self.dialogs:isOpen() then
		if attempt < 5 then
			task.delay(2, function()
				if not self._destroyed then
					self:_offerDraft(name, anyTarget, attempt + 1)
				end
			end)
		end
		return
	end
	local live = self:_sessionState(name)
	if not live or not live.model or live.model.dirty == true then
		return
	end
	local path = self:_draftPathOf(name, live)
	local entries = self:_readDrafts()
	local chosen = nil
	for _, e in ipairs(entries) do
		if e.workspace == name and e.targetPath == path then
			chosen = e
			break
		end
	end
	if chosen == nil and anyTarget == true then
		for _, e in ipairs(entries) do
			if e.workspace == name then
				chosen = e
				break
			end
		end
	end
	if chosen == nil then
		return
	end
	local okDraft, draftModel = pcall(Storage.fromJson, chosen.json)
	if not okDraft or type(draftModel) ~= "table" then
		self:_clearDraft(name, chosen.targetPath)
		return
	end
	-- Ce qui est enregistré pour cette cible
	local reference = nil
	if chosen.targetPath == path then
		reference = live.model
	else
		local inst = resolvePath(chosen.targetPath)
		local found = findProjectScript(inst)
		if found then
			reference = loadScript(found)
		end
	end
	if reference ~= nil then
		local okA, a = pcall(function()
			return draftModel:serialize()
		end)
		local okB, b = pcall(function()
			return reference:serialize()
		end)
		if okA and okB and deepEqual(a, b) then
			self:_clearDraft(name, chosen.targetPath)
			return
		end
	end
	local blocks = countOf(draftModel)
	local where = chosen.targetPath
	if name == "interface" and type(chosen.screen) == "string" then
		where = "l'écran « " .. chosen.screen .. " »"
	else
		where = "« " .. where .. " »"
	end
	self:_choice(
		"Brouillon retrouvé",
		"Un brouillon non enregistré du "
			.. formatTime(chosen.time)
			.. " a été trouvé pour "
			.. where
			.. " ("
			.. plural(blocks, "bloc")
			.. "). Veux-tu le restaurer ?",
		{
			{
				text = "Ignorer",
				style = "normal",
				action = function()
					self:_clearDraft(name, chosen.targetPath)
				end,
			},
			{
				text = "Restaurer",
				style = "primary",
				action = function()
					self:_restoreDraft(name, chosen, draftModel)
				end,
			},
		}
	)
	return true
end

function App:_restoreDraft(name, entry, draftModel)
	if self._destroyed or type(draftModel) ~= "table" then
		return
	end
	local note = nil
	if name == "interface" then
		local live = self:_sessionState("interface")
		self:_setInterfaceSession(draftModel, live and live.target, live and live.scriptInstance)
		markUnsaved(draftModel)
	else
		local target = resolvePath(entry.targetPath)
		if not isAlive(target) then
			local live = self:_sessionState("blocs")
			target = live and live.target
			note = "L'objet « " .. tostring(entry.targetPath) .. " » n'existe plus : le brouillon est dans la cible actuelle."
		end
		if self.workspace ~= "blocs" then
			self:setWorkspace("blocs")
		end
		self:loadModel(draftModel, target, findProjectScript(target))
		markUnsaved(draftModel)
	end
	self:_updateTopBar()
	self.dialogs:toast("Brouillon restauré : pense à enregistrer.", "success")
	if note then
		self.dialogs:toast(note, "warning", 6)
	end
	self:setStatus("Brouillon restauré : clique sur « Enregistrer » pour le garder.", "info")
end

---------------------------------------------------------------------------
-- Mises à jour du plugin (SPEC §25)
---------------------------------------------------------------------------

function App:_startUpdates(restored)
	local MiseAJour = optionalModule("MiseAJour")
	if not MiseAJour or type(MiseAJour.start) ~= "function" then
		return
	end
	local ok, stop = pcall(MiseAJour.start, {
		host = self.host,
		-- NOTE: la carte va dans le calque des panneaux (sous celui des glissements et des dialogues) : un
		-- glissement relâché au-dessus d'elle arrive bien au bouton de suivi du canvas ou du Studio d'interface,
		-- et les fenêtres, menus et panneaux passent devant elle (voir la NOTE de MiseAJour.lua).
		getLayer = function()
			return self.problemsLayer or self.dialogLayer
		end,
		openWiki = function(pageId)
			self:openWiki(pageId)
		end,
		onStatus = function(info)
			self:_onUpdateStatus(info)
		end,
		-- (en plus de la SPEC) éditeur reconstruit après les paramètres : pas de nouvelle carte ;
		-- paramètre « Mises à jour › vérifier »
		restored = restored == true,
		isEnabled = function()
			local Reglages = optionalModule("Reglages")
			if Reglages and type(Reglages.get) == "function" then
				local okGet, value = pcall(Reglages.get, "majs.verifier")
				if okGet and value == false then
					return false
				end
			end
			return true
		end,
	})
	if not ok then
		warn("[Blocs FR] Vérification des mises à jour : " .. tostring(stop))
		return
	end
	if type(stop) == "function" then
		self._stopUpdates = stop
	end
end

function App:_onUpdateStatus(info)
	if self._destroyed then
		return
	end
	self._updateInfo = info
	local on = type(info) == "table" and info.status == "nouvelle"
	if self.topbar and type(self.topbar.setUpdateDot) == "function" then
		pcall(self.topbar.setUpdateDot, self.topbar, on)
	end
end

---------------------------------------------------------------------------
-- Détecteur d'erreurs (SPEC §17)
---------------------------------------------------------------------------

-- Analyse dans « delay » secondes ; chaque nouvel appel repousse l'analyse (anti-rebond)
function App:_scheduleAnalysis(delay)
	if self._destroyed then
		return
	end
	self._analysisToken += 1
	local token = self._analysisToken
	task.delay(delay or ANALYSIS_DELAY, function()
		if self._destroyed or token ~= self._analysisToken then
			return
		end
		self:_runAnalysis()
	end)
end

-- Problèmes statiques + code. Renvoie la liste, si le détecteur est disponible, et les infos du code
-- de Detecteur.analyze ({ codeOk, codeErr, … } pour le pied du panneau) ou nil
function App:_collectProblems(model)
	local problems = {}
	local mode = modeOf(model)
	-- CodeGen plante : le code ne peut pas être fabriqué (signalé ici, le détecteur ne le voit pas)
	local function checkGeneration()
		local okGen, gen = pcall(CodeGen.generate, model, mode)
		if okGen and type(gen) == "table" and type(gen.code) == "string" then
			return
		end
		table.insert(problems, {
			severity = "erreur",
			source = "code",
			title = "Erreur interne de Blocs FR.",
			message = "Le code n'a pas pu être fabriqué à partir des blocs. Annule la dernière modification (bouton « Annuler ») et réessaie.",
			raw = tostring(gen),
		})
	end

	local Detecteur = optionalModule("Detecteur")
	if Detecteur == nil or type(Detecteur.analyze) ~= "function" then
		checkGeneration()
		return problems, false, nil
	end
	local target = nil
	if isAlive(self.target) then
		target = self.target
	end
	local guiNames = nil
	local okNames, names = pcall(self._guiNamesForDetector, self)
	if okNames and type(names) == "table" then
		guiNames = names
		self._lastGuiNames = names
	end
	-- Pas de « code » dans ctx : le détecteur génère lui-même le code, ce qui lui permet de signaler
	-- les erreurs de CodeGen (blocs ignorés) et de relier une erreur de compilation à son bloc
	local okAnalyze, result, info = pcall(Detecteur.analyze, model, { mode = mode, target = target, guiNames = guiNames })
	if type(info) ~= "table" or type(info.code) ~= "string" then
		checkGeneration() -- le détecteur n'a pas pu générer le code
	end
	if not okAnalyze then
		warn("[Blocs FR] Détecteur d'erreurs : " .. tostring(result))
		table.insert(problems, {
			severity = "conseil",
			source = "statique",
			title = "Le détecteur d'erreurs a rencontré un problème.",
			message = "L'analyse n'a pas pu se terminer. Tes blocs ne sont pas en cause : réessaie avec « Revérifier ».",
			raw = tostring(result),
		})
		return problems, true, nil
	end
	if type(result) == "table" then
		for _, p in ipairs(result) do
			local clean = sanitizeProblem(p, "statique")
			if clean ~= nil then
				table.insert(problems, clean)
			end
		end
	end
	if type(info) ~= "table" then
		info = nil
	end
	return problems, true, info
end

function App:_runAnalysis()
	if self._destroyed then
		return
	end
	if self._analyzing then
		self._analysisPending = true
		return
	end
	self._analyzing = true
	self._analysisPending = false
	local model = self.model
	local ok, problems, available, info = pcall(self._collectProblems, self, model)
	self._analyzing = false
	if self._destroyed then
		return
	end
	if model == self.model then
		self._codeOk = nil
		self._codeErr = nil
		if ok and type(problems) == "table" then
			self._staticProblems = problems
			self._detectorAvailable = available == true
			if type(info) == "table" and (info.codeOk == true or info.codeOk == false) then
				self._codeOk = info.codeOk
				self._codeErr = info.codeErr
			end
		else
			warn("[Blocs FR] Analyse impossible : " .. tostring(problems))
			self._staticProblems = {}
		end
		self._analyzedOnce = true
		self:_publishProblems()
	else
		self._analysisPending = true -- le projet a été remplacé pendant l'analyse
	end
	if self._analysisPending then
		self._analysisPending = false
		self:_scheduleAnalysis(0.05)
	end
end

-- Analyse immédiate (attend la fin d'une analyse en cours)
function App:_analyzeNow()
	self._analysisToken += 1 -- annule l'analyse programmée : elle est faite maintenant
	local waited = 0
	while self._analyzing and waited < ANALYSIS_WAIT_MAX and not self._destroyed do
		waited += task.wait(0.05)
	end
	if self._destroyed then
		return
	end
	if self._analyzing then
		self._analysisPending = true
		return
	end
	self:_runAnalysis()
end

-- Envoie les problèmes (tests + analyse) au panneau, au canvas, à la barre d'outils et à la barre d'état
function App:_publishProblems()
	if self._destroyed then
		return
	end
	local entries = {}
	for _, p in ipairs(self._testProblems) do
		table.insert(entries, p)
	end
	for _, p in ipairs(self._staticProblems) do
		table.insert(entries, p)
	end
	-- Tri stable : gravité décroissante, puis ordre d'origine
	local indexed = {}
	for i, p in ipairs(entries) do
		indexed[i] = { p = p, i = i, rank = SEVERITY_RANK[normalizeSeverity(p.severity)] }
	end
	table.sort(indexed, function(a, b)
		if a.rank ~= b.rank then
			return a.rank > b.rank
		end
		return a.i < b.i
	end)
	local all = {}
	for _, item in ipairs(indexed) do
		table.insert(all, item.p)
	end
	self._problems = all

	local counts = { erreur = 0, avertissement = 0, conseil = 0 }
	local map = {}
	local model = self.model
	for _, p in ipairs(all) do
		local severity = normalizeSeverity(p.severity)
		counts[severity] += 1
		local blockId = p.blockId
		if blockId ~= nil and model:get(blockId) ~= nil then
			local current = map[blockId]
			if current == nil or SEVERITY_RANK[severity] > SEVERITY_RANK[current] then
				map[blockId] = severity
			end
		end
	end
	self._problemCounts = counts

	if self.problemsPanel then
		self:_safe("détecteur", function()
			self.problemsPanel:setProblems(all, self._codeOk, self._codeErr)
		end)
	end
	if self.canvas and type(self.canvas.setProblems) == "function" then
		self:_safe("canvas", function()
			self.canvas:setProblems(map)
		end)
	end
	self:_updateTopBar()
	self:_updateProblemsIndicator()
	self:_updateZoneHeader()
	self:_refreshExplanation(false)
end

function App:_updateProblemsIndicator()
	if not self.problemsLabel then
		return
	end
	local counts = self._problemCounts
	local parts = {}
	local worst = nil
	for _, severity in ipairs(SEVERITY_ORDER) do
		local n = counts[severity] or 0
		if n > 0 then
			table.insert(parts, severityWord(severity, n))
			if worst == nil then
				worst = severity
			end
		end
	end
	local text, color
	if worst ~= nil then
		text = "⚠ " .. table.concat(parts, " · ")
		color = themeColor(SEVERITY_TEXT_KEYS[worst])
	elseif not self._analyzedOnce then
		text = "Analyse…"
		color = C.TextDim
	elseif not self._detectorAvailable then
		text = "Détecteur indisponible"
		color = C.TextDim
	else
		text = "✓ Aucun problème"
		color = C.SuccessText
	end
	self.problemsLabel.Text = text
	self.problemsLabel.TextColor3 = color
	self:_layoutStatus()
end

function App:_selectProblem(problem)
	if self._destroyed or type(problem) ~= "table" then
		return
	end
	local blockId = problem.blockId
	if blockId ~= nil and self.model:get(blockId) ~= nil then
		self:focusBlock(blockId)
		return
	end
	if problem.source == "test" then
		self:setStatus(
			"Ce bloc n'existe plus dans le projet ouvert : il a été supprimé ou le projet a changé depuis le test.",
			"warning"
		)
	else
		self:setStatus("Ce problème concerne tout le script, pas un bloc précis.", "info")
	end
end

function App:toggleProblems()
	if self._destroyed then
		return
	end
	local panel = self.problemsPanel
	if not panel then
		self.dialogs:toast("Le détecteur d'erreurs n'a pas pu être chargé.", "error")
		return
	end
	if self:_problemsVisible() then
		self:_safe("détecteur", function()
			panel:hide()
		end)
	else
		-- La vue du code, l'explication et le détecteur occupent le même côté : un seul à la fois
		self:_hideRightPanels("problems")
		self:_safe("détecteur", function()
			panel:setProblems(self._problems, self._codeOk, self._codeErr)
			panel:show()
		end)
		self:_pollTestErrors()
	end
	self:_updateTopBar()
end

-- « Revérifier » (panneau du détecteur)
function App:recheck()
	if self._destroyed then
		return
	end
	self:_pollTestErrors()
	self:_analyzeNow()
	local counts = self._problemCounts
	local total = counts.erreur + counts.avertissement + counts.conseil
	if total == 0 then
		self:setStatus("Analyse terminée : aucun problème trouvé.", "success")
	else
		self:setStatus("Analyse terminée : " .. plural(total, "problème") .. ".", "info")
	end
end

function App:getProblems()
	return table.clone(self._problems)
end

---------------------------------------------------------------------------
-- Erreurs pendant les tests (écrites par ErrorWatcher dans les réglages du plugin)
---------------------------------------------------------------------------

function App:_isEditorVisible()
	local widget = self.host.widget
	if typeof(widget) ~= "Instance" then
		return true
	end
	local ok, enabled = pcall(function()
		return widget.Enabled
	end)
	return not ok or enabled == true
end

function App:_startTestPolling()
	task.spawn(function()
		while not self._destroyed do
			task.wait(TEST_POLL_INTERVAL)
			if self._destroyed then
				break
			end
			if self:_isEditorVisible() then
				self:_pollTestErrors()
			end
		end
	end)
	local widget = self.host.widget
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(self.connections, widget.WindowFocused:Connect(function()
				self:_pollTestErrors()
			end))
		end)
		pcall(function()
			table.insert(self.connections, widget:GetPropertyChangedSignal("Enabled"):Connect(function()
				if widget.Enabled then
					self:_pollTestErrors()
				end
			end))
		end)
	end
	task.defer(function()
		self:_pollTestErrors()
	end)
end

-- Chemins possibles du script de la cible actuelle (script ouvert, ou script à venir)
function App:_scriptPaths()
	local paths = {}
	if isAlive(self.scriptInstance) then
		table.insert(paths, pathOf(self.scriptInstance))
	end
	if isAlive(self.target) and self.target ~= game then
		local base = pathOf(self.target)
		table.insert(paths, base .. "." .. Storage.SERVER_NAME)
		table.insert(paths, base .. "." .. Storage.LOCAL_NAME)
		table.insert(paths, base .. "." .. (Storage.MODULE_NAME or "BlocsModule"))
	end
	return paths
end

-- Vrai si l'erreur du test concerne le script de la cible actuelle. 2e valeur : true quand l'erreur
-- s'est produite dans un module appelé par ce script (record.via écrit par ErrorWatcher, SPEC §20) :
-- elle est alors montrée sur le bloc qui a appelé la fonction (record.viaBlockId).
function App:_recordMatches(record, paths)
	if self:_pathMatches(record.script, paths) then
		return true, false
	end
	if type(record.via) == "string" and record.via ~= "" and self:_pathMatches(record.via, paths) then
		return true, true
	end
	return false, false
end

-- Vrai si ce chemin de script (enregistrement d'une erreur du test) est celui de la cible actuelle
function App:_pathMatches(path, paths)
	local raw = stripGame(path)
	if raw == "" then
		return false
	end
	local normalized = normalizeRuntimePath(raw)
	for _, candidate in ipairs(paths) do
		if raw == candidate or normalized == candidate then
			return true
		end
		-- Scripts copiés dans le personnage : « Workspace.<joueur>.<suite> »
		for _, prefix in ipairs(CHARACTER_PREFIXES) do
			if string.sub(candidate, 1, #prefix) == prefix then
				local tail = string.sub(candidate, #prefix + 1)
				local rest = string.match(raw, "^Workspace%.[^%.]+%.(.+)$")
				if rest ~= nil and rest == tail then
					return true
				end
			end
		end
	end
	return false
end

-- Reconstruit les problèmes « test » à partir des derniers enregistrements lus
function App:_rebuildTestProblems()
	local paths = self:_scriptPaths()
	local groups = {}
	local order = {}
	-- Du plus récent au plus ancien ; les erreurs identiques (même bloc, même message) sont regroupées
	for i = #self._testRecords, 1, -1 do
		local record = self._testRecords[i]
		local matches, viaHere = self:_recordMatches(record, paths)
		if matches then
			local rawMessage = tostring(record.message or "")
			local explication = record.explication
			if type(explication) ~= "string" or explication == "" then
				explication = rawMessage
			end
			if explication == "" then
				explication = "Erreur inconnue pendant le test."
			end
			local blockRef, label, line = record.blockId, record.label, record.line
			if viaHere then
				-- erreur dans une fonction d'un module appelée par ce script : sur le bloc qui l'a appelée
				blockRef, label, line = record.viaBlockId, record.viaLabel, record.viaLine
				local inBlock = ""
				if type(record.label) == "string" and record.label ~= "" then
					inBlock = " (bloc « " .. record.label .. " »)"
				end
				explication = "Erreur dans le module « "
					.. stripGame(record.script)
					.. " »"
					.. inBlock
					.. ", appelé ici : "
					.. explication
					.. " Ouvre ce module pour voir le bloc en cause."
			end
			local blockId = nil
			if type(blockRef) == "string" and blockRef ~= "" then
				blockId = blockRef
			end
			local key = tostring(blockId) .. "|" .. explication .. "|" .. rawMessage
			local group = groups[key]
			if group == nil then
				group = {
					record = record,
					blockId = blockId,
					explication = explication,
					raw = rawMessage,
					count = 0,
					label = label,
					line = line,
				}
				groups[key] = group
				table.insert(order, group)
			end
			group.count += recordCount(record)
		end
	end
	local problems = {}
	for _, group in ipairs(order) do
		local message = group.explication
		local record = group.record
		if group.blockId == nil or self.model:get(group.blockId) == nil then
			if type(group.label) == "string" and group.label ~= "" then
				message = "Bloc « " .. group.label .. " » : " .. message
			end
		end
		if group.count > 1 then
			message = message .. " (" .. group.count .. " fois)"
		end
		local raw = nil
		if group.raw ~= "" then
			raw = group.raw
		end
		table.insert(problems, {
			severity = "erreur",
			source = "test",
			blockId = group.blockId,
			title = TEST_TITLE,
			message = message,
			raw = raw,
			line = tonumber(group.line),
			side = record.side,
			time = tonumber(record.time),
		})
	end
	self._testProblems = problems
	self:_publishProblems()
end

function App:_pollTestErrors()
	if self._destroyed or self._polling then
		return
	end
	if type(self.host.getSetting) ~= "function" then
		return
	end
	self._polling = true
	local ok, err = pcall(self._pollTestErrorsImpl, self)
	self._polling = false
	if not ok then
		warn("[Blocs FR] Lecture des erreurs du test : " .. tostring(err))
	end
end

function App:_pollTestErrorsImpl()
	local okRead, list = pcall(self.host.getSetting, TEST_SETTING)
	if not okRead or type(list) ~= "table" then
		list = {}
	end
	local records = {}
	local maxId = 0
	local sessionMaxId = 0
	local totalCount = 0 -- une erreur répétée garde son id mais son « count » augmente
	for _, record in ipairs(list) do
		if type(record) == "table" then
			local id = tonumber(record.id)
			if id ~= nil then
				if id > maxId then
					maxId = id
				end
				-- Seulement les tests de cette session de Studio (pas ceux d'hier)
				local t = tonumber(record.time)
				if t == nil or t >= self._sessionStart - 2 then
					table.insert(records, record)
					totalCount += recordCount(record)
					if id > sessionMaxId then
						sessionMaxId = id
					end
				end
			end
		end
	end
	-- Liste vidée (ou compteur remis à zéro) : on repart de zéro
	if maxId < self._lastTestId then
		self._lastTestId = 0
	end

	local paths = self:_scriptPaths()
	local newMine, newOthers = 0, 0
	for _, record in ipairs(records) do
		if tonumber(record.id) > self._lastTestId then
			if self:_recordMatches(record, paths) then
				newMine += 1
			else
				newOthers += 1
			end
		end
	end
	if maxId > self._lastTestId then
		self._lastTestId = maxId
	end

	local signature = #records .. ":" .. sessionMaxId .. ":" .. totalCount
	if signature ~= self._testSignature then
		self._testSignature = signature
		self._testRecords = records
		self:_rebuildTestProblems()
	end

	if newMine > 0 then
		local text = newMine .. " erreur(s) pendant le test — ouvre le détecteur"
		if newOthers > 0 then
			text = text .. " (+" .. newOthers .. " dans d'autres scripts)"
		end
		self.dialogs:toast(text, "error", 6)
		self:setStatus(text .. ".", "error")
	elseif newOthers > 0 then
		local text = newOthers .. " erreur(s) pendant le test dans d'autres scripts Blocs FR : ouvre-les pour les voir."
		self.dialogs:toast(text, "warning", 6)
		self:setStatus(text, "warning")
	end
end

-- « Effacer les erreurs du test » (panneau du détecteur)
function App:clearTestErrors()
	if self._destroyed then
		return
	end
	if type(self.host.setSetting) == "function" then
		pcall(self.host.setSetting, TEST_SETTING, {})
	end
	self._testRecords = {}
	self._testSignature = ""
	self._testProblems = {}
	self:_publishProblems()
	self:setStatus("Erreurs du dernier test effacées.", "info")
end

---------------------------------------------------------------------------
-- État (reconstruction après les paramètres), débogage et fermeture
---------------------------------------------------------------------------

-- Tout ce qu'il faut pour reconstruire l'éditeur à l'identique (App.new(host, state)) : projets (données,
-- « non enregistré »), cibles, scripts, vues, onglet, écran ouvert, séparateur
function App:exportState()
	self:_syncSession()
	if self._activeSession and self.sessions[self._activeSession] then
		self.sessions[self._activeSession].view = self:_canvasView()
	end
	local state = {
		version = 1,
		workspace = self.workspace,
		split = self._split,
		splitIndex = self._splitIndex,
		zoneCollapsed = self._zoneCollapsed,
		lastEdited = self._lastEdited,
		screenInitialized = self._screenInitialized,
		notice = self._settingsNotice,
		resetViews = self._resetViews == true, -- (zoom de départ changé : vues non reprises)
		sessions = {},
	}
	for name, s in pairs(self.sessions) do
		local entry = { target = s.target, scriptInstance = s.scriptInstance, view = s.view }
		local ok, data = pcall(function()
			return s.model:serialize()
		end)
		if ok and type(data) == "table" then
			entry.data = data
		end
		entry.dirty = s.model ~= nil and s.model.dirty == true
		state.sessions[name] = entry
	end
	local editor = self.guiEditor
	if editor then
		local screen = { screenGui = self:_editorScreenGui() }
		if type(editor.exportState) == "function" then
			local ok, st = pcall(editor.exportState, editor)
			if ok then
				screen.editorState = st
			end
		end
		local doc = self:_editorDoc()
		if doc then
			local ok, data = pcall(function()
				return doc:serialize()
			end)
			if ok and type(data) == "table" then
				screen.doc = data
			end
			screen.docDirty = self:_editorDirty()
		end
		state.screen = screen
	elseif self._restoringScreen ~= nil then
		state.screen = self._restoringScreen -- (onglet Interface pas encore rouvert)
	end
	return state
end

function App:_restoreState(state)
	local split = tonumber(state.split)
	if split ~= nil and split == split then
		self._split = Util.clamp(split, 0.02, 0.98)
	end
	local splitIndex = tonumber(state.splitIndex)
	if splitIndex ~= nil and SPLIT_CYCLE[splitIndex] ~= nil then
		self._splitIndex = splitIndex
	end
	self._zoneCollapsed = state.zoneCollapsed == true
	if state.lastEdited == "gui" then
		self._lastEdited = "gui"
	end
	if type(state.screen) == "table" then
		self._restoringScreen = state.screen
	elseif state.screenInitialized == true then
		self._screenInitialized = true
	end
	self:_refreshAll()
	self:_restoreView(self.sessions.blocs.view)
	if state.workspace == "interface" then
		self:setWorkspace("interface", true)
	end
	if type(state.notice) == "string" and state.notice ~= "" then
		self.dialogs:toast(state.notice, "success")
		self:setStatus(state.notice, "success")
	else
		self:setStatus("Éditeur prêt.", "info")
	end
end

function App:getDebugState()
	local model = self.model
	local zoom = 1
	if self.canvas then
		pcall(function()
			zoom = tonumber(self.canvas:getZoom()) or 1
		end)
	end
	local count = 0
	pcall(function()
		count = tonumber(model:count()) or 0
	end)
	local counts = self._problemCounts
	local editorState = nil
	if self.guiEditor and type(self.guiEditor.getDebugState) == "function" then
		local ok, st = pcall(self.guiEditor.getDebugState, self.guiEditor)
		if ok then
			editorState = st
		end
	end
	local topbarState = nil
	if self.topbar and type(self.topbar.getDebugState) == "function" then
		local ok, st = pcall(self.topbar.getDebugState, self.topbar)
		if ok then
			topbarState = st
		end
	end
	local drafts = 0
	pcall(function()
		drafts = #self:_readDrafts()
	end)
	return {
		workspace = self.workspace,
		targetPath = self:_targetPath(),
		mode = model.mode,
		dirty = model.dirty == true,
		blockCount = count,
		tops = #(model.tops or {}),
		variables = table.clone(model.variables or {}),
		status = self.statusText,
		statusKind = self.statusKind,
		zoom = zoom,
		hasScript = self:_hasScript(),
		problems = {
			erreur = counts.erreur,
			avertissement = counts.avertissement,
			conseil = counts.conseil,
		},
		testProblems = #self._testProblems,
		problemsVisible = self:_problemsVisible(),
		detectorAvailable = self._detectorAvailable,
		analyzing = self._analyzing,
		codeVisible = self:_codeVisible(),
		explainVisible = self:_explainVisible(),
		hitboxOpen = self.hitboxPreview ~= nil,
		settingsOpen = self.settingsPanel ~= nil,
		textWindowOpen = self._textWindow ~= nil,
		screen = self:_currentScreenName(),
		screenSaved = self:_currentScreenGui() ~= nil,
		interfaceDirty = self:_interfaceDirty(),
		editorAvailable = self.guiEditor ~= nil,
		editorError = self._guiEditorError,
		editor = editorState,
		split = self._split,
		zoneCollapsed = self._zoneCollapsed,
		lastEdited = self._lastEdited,
		previewOn = self._previewOn,
		linkName = self._linkName,
		drafts = drafts,
		updateStatus = type(self._updateInfo) == "table" and self._updateInfo.status or nil,
		topbar = topbarState,
	}
end

function App:destroy()
	if self._destroyed then
		return
	end
	-- brouillon des projets non enregistrés (Studio qui se ferme, plugin rechargé…)
	pcall(self._writeDrafts, self, false)
	self:_endSplitDrag()
	self._destroyed = true
	self._analysisToken += 1
	self._draftToken += 1
	self:_closeTextWindow()
	for _, key in ipairs({ "hitboxPreview", "settingsPanel" }) do
		local panel = self[key]
		if panel then
			self[key] = nil
			pcall(function()
				panel:close()
			end)
		end
	end
	if self._stopUpdates then
		local stop = self._stopUpdates
		self._stopUpdates = nil
		pcall(stop)
	end
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.modelConnection then
		local old = self.modelConnection
		self.modelConnection = nil
		pcall(function()
			old:Disconnect()
		end)
	end
	for _, key in ipairs({
		"explicationPanel",
		"problemsPanel",
		"codeview",
		"topbar",
		"guiEditor",
		"palette",
		"canvas",
		"dialogs",
	}) do
		local module = self[key]
		if module then
			pcall(function()
				module:destroy()
			end)
			self[key] = nil
		end
	end
	for _, key in ipairs({ "dialogLayer", "dragLayer", "problemsLayer", "codeLayer", "mainLayer" }) do
		local frame = self[key]
		if frame then
			pcall(function()
				frame:Destroy()
			end)
			self[key] = nil
		end
	end
	self.statusLabel = nil
	self.countLabel = nil
	self.problemsLabel = nil
	self.problemsButton = nil
	self.statusSeparator = nil
	self.zoneHeader = nil
	self.guiBody = nil
end

return App
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Canvas</string><ProtectedString name="Source"><![CDATA[-- Canvas : zone de travail de Blocs FR (SPEC §10, §15, §18).
-- Fond sombre à points (grille de 22 unités), déplacement de la vue (glisser le fond avec le bouton
-- gauche ou du milieu), zoom à la molette autour du curseur (0,4 à 2), glisser-déposer des blocs avec
-- aimantation, menus du clic droit, groupe de zoom flottant en bas à droite (− 100 % + ◎) et astuce en
-- bas à gauche.
--
-- Repères :
--   * « écran »  = même espace que GuiObject.AbsolutePosition et host.getMousePosition() ;
--   * « canvas » = unités des blocs (block.x / block.y), zoom 1.
--   écran = frame.AbsolutePosition + pan + canvas × zoom
-- Les piles sont dessinées dans self.world (UIScale = zoom, Position = pan).
--
-- Glisser-déposer : le modèle est modifié dès le début du glissement (bloc détaché, ou créé pour un bloc
-- venant de la palette, sans commit). La pile glissée n'est plus dessinée dans le canvas mais dans
-- deps.dragLayer (UIScale = zoom, ombre douce). Au relâchement, l'assemblage choisi est appliqué puis
-- model:commit(...) est appelé une seule fois (une seule étape d'annulation).
-- Le suivi de la souris utilise un TextButton transparent plein écran dans dragLayer
-- (InputChanged / InputEnded) et une boucle RunService.Heartbeat qui lit host.getMousePosition().
--
-- Animations (SPEC §24, module Anim ; état final immédiat quand elles sont désactivées) :
--   * zoom fluide (0,15 s) aux boutons et à la molette ; getZoom() renvoie le zoom visé pendant
--     l'animation ; « Recentrer » et focusBlock (0,35 s quintOut) font glisser la vue ;
--   * pile glissée soulevée (105 %, ombre) autour du point saisi ; fantôme d'aimantation qui respire ;
--   * éclair blanc sur les blocs qui viennent de s'accrocher ; blocs lâchés sur la palette : ils
--     rétrécissent et éclatent en confettis, la palette rougit pendant le survol
--     (palette:setDeleteHint, palette enregistrée par canvas:setPalette ou deps.setDeleteHint) ;
--   * contours des problèmes qui respirent et pastilles « ! » qui sautent (au plus MAX_PULSES).
--     Ils sont retrouvés par leur nom dans les vues du Renderer : « Probleme » et « Pastille ».
--     Fenêtre fermée ou zone de travail repliée : ces boucles s'arrêtent, et repartent à son retour.
--
-- Phase 2 (SPEC §21.8, §29, §31-§33) :
--   * notes (§29) : dessinées au-dessus des blocs (calque « Notes » du monde) : bandeau « NOTE » /
--     « À FAIRE », pastilles de couleur, « − » replier, « × » supprimer, texte sur plusieurs lignes
--     (double-clic pour écrire), déplacement par le bandeau, largeur par la poignée en bas à droite,
--     pointillés jusqu'au bloc attaché. Quand des blocs bougent, leurs notes les suivent
--     (Renderer.blockPositions avant / après, dans le même commit) ;
--   * sélection (§32) : clic = ce bloc, Maj+clic = ajouter / retirer, Maj+glisser sur le fond =
--     rectangle de sélection ; contour blanc de 2 px ; glisser une pile entièrement sélectionnée
--     déplace aussi les autres piles entièrement sélectionnées ;
--   * menus du clic droit « comme le bureau de Windows » (§33) : bloc, sélection, fond, note ;
--   * copier / couper / coller (§32) : presse-papiers JSON partagé (host.setSetting
--     « BlocsFR_PressePapiers ») ; raccourcis Ctrl+C / X / V / D / A / Z / Y, Suppr et Échap quand la
--     souris est sur la zone de travail et que le dernier clic y a eu lieu ;
--   * mini-carte (§32) en bas à gauche ; grille « points » / « lignes » / « aucune » et sa taille,
--     aimant et zoom de départ lus dans les réglages (Theme.Canvas, Theme.Block.SnapDistance) ;
--   * liens avec le Studio d'interface (§21.8) : setLinkHighlight(ids) (contour cyan) et
--     deps.onBlockHover(blockId, entering).
--   * lignes entre les blocs (§36, planche « Lignes entre les blocs ») : calque « Liens » du monde,
--     sous les piles et au-dessus de la grille. Lignes automatiques (rien n'est enregistré) : message
--     envoyé -> « Quand je reçois le message » du même nom (ambre), appel d'une fonction de module ->
--     « Définir la fonction » du même nom (ardoise), variable modifiée -> utilisée (rouge, seulement
--     pour le bloc survolé ou sélectionné). Pointillés (un point de 3 tous les 10) en courbe de Bézier
--     du bord droit du bloc de départ au bord gauche du bloc d'arrivée, rond d'arrivée, étiquette au
--     milieu ; des points lumineux avancent du départ vers l'arrivée quand les animations sont
--     activées (une seule animation Anim, arrêtée quand aucune ligne n'est visible). Survoler un bloc
--     allume ses lignes (et entoure les blocs reliés), les autres pâlissent. Lignes tracées à la main
--     (model.liens, si le modèle les connaît : addLink / setLink / removeLink) : menu d'un bloc
--     « Relier à un autre bloc… » puis clic sur le deuxième bloc (Échap / clic droit : annuler) ;
--     clic droit sur une ligne ou son étiquette : Renommer, Style ›, Couleur ›, Supprimer. Réglage
--     « zone.liens » = "toujours" (défaut) | "survol" | "jamais" (lignes automatiques).
-- deps facultatifs (chacun vérifié avant usage) : getGuiNames(filter), promptText(title, default, onOk),
-- onBlockHover(blockId, entering), openHitboxPreview(blockId), canPreviewHitbox(defId), explain(),
-- showCodeAt(blockId|nil), showCode(), openWiki(defId|nil), openSettings(section), shareScript(),
-- importCode(), toggleFavorite(defId), isFavorite(defId), openHelp(defId) (ancien nom de « ouvrir dans
-- le wiki »).
-- NOTE: ajouts à la SPEC : canvas.SelectionChanged (Util.Signal(ids)), canvas:setViewState(state),
-- canvas:addBlockAtCenter(defId, presets), canvas:beginGhostDrag(spec) (cartes « Modèles » de la
-- palette), canvas:copySelection() / cutSelection() / paste(screenPos) / deleteSelection() /
-- duplicateSelection() / selectAll(), canvas:setHint(text|nil) (astuce en bas à gauche, nil = celle
-- d'origine), canvas:getLinks() -> { { kind, from, to, id, label, style, visible } } (lignes dessinées,
-- pour les tests).

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local Renderer = require(script.Parent.Renderer)
local Anim = require(script.Parent.Anim)

-- Module facultatif (écrit en parallèle) : chargé une seule fois, sans jamais faire échouer le canvas
local optionalCache = {}
local function optionalModule(name)
	local cached = optionalCache[name]
	if cached ~= nil then
		return cached or nil
	end
	local result = false
	local ok, module = pcall(function()
		local inst = script.Parent:FindFirstChild(name)
		if inst and inst:IsA("ModuleScript") then
			return require(inst)
		end
		return nil
	end)
	if ok and type(module) == "table" then
		result = module
	end
	optionalCache[name] = result
	return result or nil
end

local Canvas = {}
Canvas.__index = Canvas

local MIN_ZOOM = 0.4
local MAX_ZOOM = 2.0
local WHEEL_STEP = 1.1
local BUTTON_STEP = 1.2
local GRID = 22 -- espacement de la grille par défaut (Theme.Canvas.GridSize, unités du canvas)
local MAX_DOTS = 1500
local MAX_LINES = 400 -- grille « lignes » : traits au plus
local DOT_SIZE = 2
local DRAG_THRESHOLD = 4 -- pixels avant qu'un appui sur un bloc devienne un glissement
local SNAP_DEFAULT = 28 -- aimant par défaut (Theme.Block.SnapDistance, lu à chaque glissement)
local SNAP_OFF = 10 -- aimant « désactivé » (0) : il faut lâcher le bloc presque à sa place
local CLEAN_MARGIN = 24
local VIEW_MARGIN = 40
local Z_GHOST = 9000
local Z_FLASH = 9500
local Z_FLOATING = 20 -- groupe de zoom, astuce
local Z_DRAG = 900 -- blocs glissés (dans dragLayer)
local Z_TRACK = 1000 -- bouton de suivi de la souris (dans dragLayer)
local WHITE = Color3.fromRGB(255, 255, 255)
local HINT_TEXT = "Glisse un bloc sur la palette pour le supprimer · clic droit pour plus d'options"
local ZOOM_TIME = 0.15 -- zoom fluide (boutons et molette)
local FOCUS_TIME = 0.35 -- focusBlock : déplacement de la vue
local RECENTER_TIME = 0.3
local MAX_PULSES = 8 -- contours de problèmes animés au plus (et autant de pastilles)
local SHRINK_TIME = 0.18 -- blocs lâchés sur la palette
local LIFT_SCALE = 1.05 -- pile glissée soulevée (105 %)
local LIFT_TIME = 0.1
local FLASH_MAX = 6 -- blocs qui reçoivent l'éclair d'accrochage, au plus
local Z_SNAP_FLASH = 9990 -- éclair d'accrochage (sous les contours des problèmes)
local GHOST_PERIOD = 0.9 -- respiration du fantôme d'aimantation
local Z_RING = 9980 -- contours de sélection / de lien (dans la vue de la pile)
local Z_NOTES = 8500 -- calque des notes (dans le monde, au-dessus des piles)
local Z_SELECT_BOX = 9600 -- rectangle de sélection (dans le monde)
local FRONT_Z0 = 5000 -- pile cliquée : passe devant (ZIndex de sa vue)
local LINK_COLOR = Color3.fromRGB(34, 211, 238) -- lien bloc ↔ élément d'interface (#22D3EE)
local MAX_RINGS = 300

-- Notes (SPEC §29, planche « Notes »)
local NOTE_HEADER_H = 26
local NOTE_PAD_X = 11
local NOTE_PAD_TOP = 4
local NOTE_PAD_BOTTOM = 11
local NOTE_MIN_BODY = 18
local NOTE_MIN_W = 120
local NOTE_MAX_W = 600
local NOTE_RADIUS = 10
local NOTE_DOT = 9
local NOTE_CONNECTOR_STEP = 7 -- pointillés vers le bloc : un point tous les 7 unités
local NOTE_CONNECTOR_MAX = 90
local NOTE_COLORS = { "jaune", "vert", "bleu", "rose", "violet" }
local NOTE_COLOR_NAMES = { jaune = "Jaune", vert = "Vert", bleu = "Bleu", rose = "Rose", violet = "Violet" }
local NOTE_FALLBACK_COLORS = {
	Fond = Color3.fromRGB(253, 230, 138),
	Entete = Color3.fromRGB(252, 211, 77),
	Texte = Color3.fromRGB(66, 32, 6),
}
local NOTE_PLACEHOLDER = "Double-clique pour écrire…"
local DOUBLE_CLICK = 0.4

-- Presse-papiers partagé (SPEC §32)
local CLIPBOARD_KEY = "BlocsFR_PressePapiers"
local PASTE_OFFSET = 30
local memoryClipboard = nil -- copie de secours (sans host.setSetting), partagée par les canvas

-- Mini-carte (SPEC §32)
local MINI_W = 170
local MINI_H = 110
local MINI_PAD = 6

-- Blocs de combat que le prévisualiseur de hitbox sait montrer (si HitboxPreview est absent)
local HITBOX_BLOCKS = { tp_attaque_melee = true, tp_hitbox_degats = true, tp_hitbox = true }

-- Zoom › (menu du fond)
local ZOOM_STEPS = { 0.5, 0.75, 1, 1.25, 1.5 }

-- Lignes entre les blocs (SPEC §36, planche « Lignes entre les blocs »)
local LINK_DOT = 3 -- taille d'un point (unités du canvas)
local LINK_SPACING = 10 -- pointillés : un point tous les 10
local LINK_SOLID_SPACING = 3 -- « trait plein » / « flèche » : points serrés
local LINK_MAX_DOTS = 140 -- points d'une ligne au plus (les longues lignes ont des points plus espacés)
local LINK_MAX_DOTS_SOLID = 240
local LINK_TOTAL_DOTS = 1800 -- points de toutes les lignes au plus
local LINK_VAR_DOTS = 500 -- points des lignes « variable » au plus
local LINK_END_DOT = 10 -- rond d'arrivée
local LINK_PILL_H = 22
local LINK_MIN_LABEL_LEN = 110 -- ligne plus courte : pas d'étiquette
local LINK_MAX = 60 -- lignes automatiques + tracées dessinées au plus
local LINK_MAX_VAR = 24 -- lignes « variable » au plus
local LINK_FOCUS_SELECTION = 12 -- sélection plus grande : elle n'allume pas ses lignes
local LINK_HIT = 8 -- clic droit à moins de 8 px d'une ligne : menu de la ligne
local LINK_BAND_DOTS = 90 -- ligne en cours de tracé (elle suit la souris)
local LINK_ALPHA = { normal = 0.12, vif = 0, terne = 0.78 } -- transparence des points selon l'état
local FLOW_CYCLE = 2 -- secondes par tour de l'animation des points lumineux
local FLOW_SPEED = 26 -- vitesse des points lumineux (unités du canvas par seconde)
local FLOW_GAP = 60 -- un point lumineux tous les 60
local FLOW_MAX_RUNNERS = 10
local FLOW_DOT = 5
local FLOW_FADE = 14 -- les points lumineux s'effacent près des deux bouts
local LINK_COLORS = {
	message = Color3.fromRGB(240, 180, 60), -- #F0B43C
	module = Color3.fromRGB(148, 163, 184), -- #94A3B8
	variable = Color3.fromRGB(226, 87, 74), -- #E2574A
	manuel = Color3.fromRGB(253, 230, 138), -- #FDE68A
}
-- Étiquettes des lignes automatiques (planche) : fond, texte, contour
local LINK_PILLS = {
	message = { bg = Color3.fromRGB(42, 34, 16), text = Color3.fromRGB(253, 230, 138), stroke = Color3.fromRGB(138, 106, 28) },
	module = { bg = Color3.fromRGB(35, 40, 51), text = Color3.fromRGB(203, 213, 225), stroke = Color3.fromRGB(71, 85, 105) },
	variable = { bg = Color3.fromRGB(56, 22, 20), text = Color3.fromRGB(252, 165, 165), stroke = Color3.fromRGB(150, 52, 44) },
}
-- Blocs qui envoient un message (entrée MESSAGE) ; reçu par « Quand je reçois le message » (evt_message)
local MESSAGE_SENDERS = {
	ctrl_envoyer_message = true,
	ctrl_envoyer_message_tous = true,
	ctrl_envoyer_message_joueur = true,
	ctrl_envoyer_message_serveur = true,
	tp_minuteur_ecran = true,
}
local LINK_STYLES = { { "Pointillés", "points" }, { "Trait plein", "plein" }, { "Flèche", "fleche" } }
local LINK_STYLE_SET = { points = true, plein = true, fleche = true }
-- Couleurs proposées pour une ligne tracée à la main (la première est celle par défaut)
local MANUAL_LINK_COLORS = {
	{ "Jaune", { 253, 230, 138 } },
	{ "Orange", { 251, 146, 60 } },
	{ "Rouge", { 248, 113, 113 } },
	{ "Rose", { 244, 114, 182 } },
	{ "Violet", { 167, 139, 250 } },
	{ "Bleu", { 96, 165, 250 } },
	{ "Vert", { 74, 222, 128 } },
	{ "Blanc", { 244, 244, 245 } },
}

local function round(x)
	return math.floor(x + 0.5)
end

local function sameMap(a, b)
	for k, v in pairs(a) do
		if b[k] ~= v then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Font = Theme.Fonts.UI,
		TextSize = Theme.TextSize.UI,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Réglages lus au moment de l'usage (SPEC §31 : Reglages.applyToTheme modifie Theme sur place)
local function clampZoom(z)
	return Util.clamp(tonumber(z) or 1, MIN_ZOOM, MAX_ZOOM)
end

-- Zoom de départ (« Taille des blocs », Theme.Canvas.Zoom = blocs.echelle)
local function defaultZoom()
	local canvasTheme = Theme.Canvas
	local z = 1
	if type(canvasTheme) == "table" then
		z = tonumber(canvasTheme.Zoom) or 1
	end
	z = clampZoom(z)
	if math.abs(z - 1) < 0.02 then
		z = 1
	end
	return math.floor(z * 1000 + 0.5) / 1000
end

-- Distance d'aimantation (unités du canvas) ; 0 = aimant « désactivé » : il faut lâcher presque à la place
local function snapDistance()
	local d = tonumber(Theme.Block.SnapDistance)
	if d == nil then
		return SNAP_DEFAULT
	end
	if d <= 0 then
		return SNAP_OFF
	end
	return Util.clamp(d, SNAP_OFF, 80)
end

local function gridSettings()
	local canvasTheme = Theme.Canvas
	local style, size = "points", GRID
	if type(canvasTheme) == "table" then
		if canvasTheme.GridStyle == "lignes" or canvasTheme.GridStyle == "aucune" then
			style = canvasTheme.GridStyle
		end
		size = Util.clamp(tonumber(canvasTheme.GridSize) or GRID, 8, 80)
	end
	return style, size
end

local function miniMapEnabled()
	local canvasTheme = Theme.Canvas
	return not (type(canvasTheme) == "table" and canvasTheme.MiniCarte == false)
end

-- Réglages actuels (Reglages.current()) ou nil
local function currentSettings()
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.current) == "function" then
		local ok, s = pcall(Reglages.current)
		if ok and type(s) == "table" then
			return s
		end
	end
	return nil
end

-- Couleurs d'une note : { Fond, Entete, Texte }
local function noteColors(couleur)
	local all = Theme.NoteColors
	if type(all) == "table" and type(all[couleur]) == "table" then
		return all[couleur]
	end
	if type(all) == "table" and type(all.jaune) == "table" then
		return all.jaune
	end
	return NOTE_FALLBACK_COLORS
end

-- Taille du texte des notes (réglage « notes.taille », 12 par défaut)
local function noteTextSize()
	local s = currentSettings()
	local size = 12
	if s and type(s.notes) == "table" then
		size = tonumber(s.notes.taille) or 12
	end
	return math.floor(Util.clamp(size, 9, 24))
end

-- Hauteur d'un texte qui passe à la ligne dans la largeur donnée (TextService ne cède jamais la main)
local wrapCache = {}
local wrapCacheCount = 0
local function wrappedHeight(text, size, font, width)
	text = tostring(text or "")
	if text == "" then
		return size
	end
	local key = font.Name .. "|" .. size .. "|" .. math.floor(width) .. "|" .. text
	local cached = wrapCache[key]
	if cached then
		return cached
	end
	local ok, v = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(math.max(10, width), 100000))
	end)
	local h
	if ok and typeof(v) == "Vector2" then
		h = math.ceil(v.Y)
	else
		-- estimation de secours : caractères par ligne × lignes
		local perLine = math.max(1, math.floor(width / (size * 0.55)))
		local lines = 0
		for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
			lines += math.max(1, math.ceil(#line / perLine))
		end
		h = math.max(1, lines) * math.ceil(size * 1.25)
	end
	if wrapCacheCount > 400 then
		wrapCache = {}
		wrapCacheCount = 0
	end
	wrapCache[key] = h
	wrapCacheCount += 1
	return h
end

-- Texte d'une note sur une seule ligne, raccourci (note repliée)
local function firstLine(text, maxChars)
	local line = string.match(tostring(text or ""), "^[^\n]*") or ""
	line = Util.trim(line)
	local ok, len = pcall(utf8.len, line)
	if ok and type(len) == "number" and len > maxChars then
		local cut = utf8.offset(line, maxChars + 1)
		if cut then
			line = string.sub(line, 1, cut - 1) .. "…"
		end
	end
	return line
end

-- Vrai si le texte d'une note commence par « à faire » (titre « À FAIRE »)
local function isTodo(text)
	local line = string.match(Util.trim(tostring(text or "")), "^[^\n]*") or ""
	return string.sub(Util.fold(line), 1, 7) == "a faire"
end

-- Nombre d'éléments d'un ensemble { [clé] = true }
local function setCount(set)
	local n = 0
	for _ in pairs(set) do
		n += 1
	end
	return n
end

local function pluralBlocs(n)
	if n == 1 then
		return "1 bloc"
	end
	return tostring(n) .. " blocs"
end

---------------------------------------------------------------------------
-- Lignes entre les blocs : calculs (SPEC §36)
---------------------------------------------------------------------------

-- Réglage « zone.liens » (lignes automatiques) : "toujours" (défaut), "survol" ou "jamais"
local function linkSetting()
	local s = currentSettings()
	local value = s and type(s.zone) == "table" and s.zone.liens or nil
	if value == "survol" or value == "jamais" then
		return value
	end
	return "toujours"
end

-- Ordre stable des ids (« b2 » avant « b10 ») : préfixe, puis nombre final, puis texte complet
-- (un ordre total : table.sort ne peut jamais recevoir de comparaisons contradictoires)
local function idKey(id)
	local s = tostring(id)
	local prefix, digits = string.match(s, "^(.-)(%d+)$")
	if prefix ~= nil then
		return prefix, tonumber(digits) or 0, s
	end
	return s, -1, s
end

local function idLess(a, b)
	local pa, na, sa = idKey(a)
	local pb, nb, sb = idKey(b)
	if pa ~= pb then
		return pa < pb
	end
	if na ~= nb then
		return na < nb
	end
	return sa < sb
end

-- Texte écrit dans une entrée (nil si un bloc y est branché ou si elle est vide)
local function literalText(block, name)
	local inputs = block and block.inputs
	local state = type(inputs) == "table" and inputs[name] or nil
	if type(state) ~= "table" or state.block ~= nil then
		return nil
	end
	local value = state.value
	if type(value) == "number" then
		value = tostring(value)
	end
	if type(value) ~= "string" or value == "" then
		return nil
	end
	return value
end

-- Variable d'un bloc (première entrée « variable ») : nom, et vrai si le bloc la lit (bloc valeur)
-- plutôt que de la modifier (instruction)
local function variableOf(def, block)
	if type(def) ~= "table" or type(def.inputs) ~= "table" or block == nil then
		return nil, false
	end
	for _, spec in ipairs(def.inputs) do
		if type(spec) == "table" and spec.kind == "variable" then
			local name = literalText(block, spec.name)
			if name == nil then
				return nil, false
			end
			return name, def.shape == "reporter" or def.shape == "boolean"
		end
	end
	return nil, false
end

-- Courbe de Bézier entre deux blocs ; a, b = { x, w, cy } (cy = milieu de la première ligne).
-- Bloc d'arrivée à droite : bord droit -> bord gauche ; à gauche : bord gauche -> bord droit ;
-- l'un au-dessus de l'autre : boucle par la droite (bord droit -> bord droit).
local function linkCurve(a, b)
	local aRight = a.x + a.w
	local bRight = b.x + b.w
	if b.x >= aRight + 24 then
		local p0 = Vector2.new(aRight, a.cy)
		local p3 = Vector2.new(b.x, b.cy)
		local dx = math.max(36, (p3.X - p0.X) * 0.5)
		return p0, p0 + Vector2.new(dx, 0), p3 - Vector2.new(dx, 0), p3
	elseif bRight <= a.x - 24 then
		local p0 = Vector2.new(a.x, a.cy)
		local p3 = Vector2.new(bRight, b.cy)
		local dx = math.max(36, (p0.X - p3.X) * 0.5)
		return p0, p0 - Vector2.new(dx, 0), p3 + Vector2.new(dx, 0), p3
	end
	local p0 = Vector2.new(aRight, a.cy)
	local p3 = Vector2.new(bRight, b.cy)
	local reach = math.max(aRight, bRight) + 50 + math.min(90, math.abs(b.cy - a.cy) * 0.12)
	return p0, Vector2.new(reach, a.cy), Vector2.new(reach, b.cy), p3
end

-- Points de la courbe (pas régulier en t) et longueur cumulée : samples, cum, longueur totale
local function sampleCurve(p0, c1, c2, p3)
	local approx = (c1 - p0).Magnitude + (c2 - c1).Magnitude + (p3 - c2).Magnitude
	local n = math.floor(Util.clamp(approx / 6, 12, 240))
	local samples = { p0 }
	local cum = { 0 }
	local prev = p0
	local total = 0
	for i = 1, n do
		local t = i / n
		local u = 1 - t
		local p = p0 * (u * u * u) + c1 * (3 * u * u * t) + c2 * (3 * u * t * t) + p3 * (t * t * t)
		total += (p - prev).Magnitude
		samples[i + 1] = p
		cum[i + 1] = total
		prev = p
	end
	return samples, cum, total
end

-- Point de la courbe à la distance s du départ (recherche dichotomique dans les longueurs cumulées)
local function pointAt(samples, cum, s)
	local n = #cum
	if n == 0 then
		return Vector2.new(0, 0)
	end
	if s <= 0 then
		return samples[1]
	end
	if s >= cum[n] then
		return samples[n]
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = math.floor((lo + hi) / 2)
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local seg = cum[hi] - cum[lo]
	local f = 0
	if seg > 0 then
		f = (s - cum[lo]) / seg
	end
	return samples[lo]:Lerp(samples[hi], f)
end

-- Distance d'un point à un segment
local function distToSegment(p, a, b)
	local ab = b - a
	local len2 = ab.X * ab.X + ab.Y * ab.Y
	if len2 <= 0 then
		return (p - a).Magnitude
	end
	local t = Util.clamp(((p - a).X * ab.X + (p - a).Y * ab.Y) / len2, 0, 1)
	return (p - (a + ab * t)).Magnitude
end

local function sameRgb(color, rgb)
	if typeof(color) ~= "Color3" or type(rgb) ~= "table" then
		return false
	end
	return math.floor(color.R * 255 + 0.5) == rgb[1]
		and math.floor(color.G * 255 + 0.5) == rgb[2]
		and math.floor(color.B * 255 + 0.5) == rgb[3]
end

-- Info-bulle de l'étiquette d'une ligne
local function linkTooltip(line)
	local name = tostring(line.name or "")
	if line.kind == "message" then
		return "Le message « " .. name .. " » part du bloc de départ et arrive au bloc au bout de la ligne.\nClic : aller au bloc qui le reçoit · clic droit : plus d'options."
	elseif line.kind == "module" then
		return "Ce bloc appelle la fonction « " .. name .. " » définie au bout de la ligne.\nClic : aller à la fonction · clic droit : plus d'options."
	elseif line.kind == "variable" then
		return "La variable « " .. name .. " » est changée au départ et utilisée au bout de la ligne.\nClic : aller au bloc qui l'utilise."
	end
	return "Ta ligne entre deux blocs.\nClic : aller au bloc d'arrivée · clic droit : renommer, style, couleur, supprimer."
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

-- deps = { host, dialogs, getModel, isOverPalette, setStatus, dragLayer, openHelp?,
--          setDeleteHint? = fn(bool) (sinon la palette enregistrée par canvas:setPalette) }
function Canvas.new(parentFrame, deps)
	local self = setmetatable({}, Canvas)
	deps = deps or {}
	self.deps = deps
	self.host = deps.host or {}
	self.dialogs = deps.dialogs
	self.getModel = deps.getModel or function()
		return nil
	end
	self.dragLayer = deps.dragLayer
	self.zoom = defaultZoom() -- « Taille des blocs » des réglages (SPEC §31)
	self.panX = 0
	self.panY = 0
	self.views = {} -- [topId] = view (Renderer)
	self.problems = {} -- [blockId] = "erreur" | "avertissement" | "conseil"
	self.connections = {}
	self.ZoomChanged = Util.Signal.new()
	self.SelectionChanged = Util.Signal.new() -- (ids) : la sélection a changé
	self.selection = {} -- [blockId] = true (SPEC §32)
	self._selectionModel = nil -- modèle de la sélection (un autre projet l'efface)
	self._linkIds = {} -- [blockId] = true : contour cyan (SPEC §21.8)
	self._rings = {} -- contours de sélection / de lien dessinés
	self._noteMaid = Util.Maid.new() -- notes dessinées (cadres et connexions)
	self._noteViews = {} -- [noteId] = { container, card, ... }
	self._editingNote = nil -- note dont le texte est en cours de saisie
	self._pendingEditNote = nil -- note à ouvrir en saisie après le prochain dessin
	self._miniRects = {} -- rectangles de la mini-carte (réutilisés)
	self._gridLines = {} -- traits de la grille « lignes » (réutilisés)
	self._gridStyle = nil
	self._kbActive = false -- raccourcis clavier actifs (dernier clic dans la zone de travail)
	self._shiftDown = false
	self._ctrlDown = false
	self._lastPointerInput = nil -- dernier appui de souris (InputObject) et son heure
	self._lastPointerTime = 0
	self._lastKey = nil
	self._lastKeyTime = 0
	self._hoverBlock = nil -- bloc survolé (deps.onBlockHover)
	self._frontZ = FRONT_Z0
	self.drag = nil -- glissement de blocs en cours
	self._tracking = nil -- suivi de la souris en cours (glissement, déplacement de la vue)
	self._dots = {}
	self._gridKey = nil
	self._refreshCount = 0
	self._lastWheel = 0
	self._flashes = {}
	self._viewAnim = nil -- animation de la vue en cours (zoom, recentrage, focusBlock)
	self._zoomTarget = nil -- zoom visé pendant une animation de zoom
	self._pulses = {} -- arrêts des animations des problèmes (contours, pastilles)
	self._pulsesParked = false -- animations des problèmes en attente : zone de travail cachée
	self._ghostPulse = nil -- arrêt de la respiration du fantôme d'aimantation
	self._palette = nil -- palette (indice de suppression), voir Canvas:setPalette
	self._deleteHint = false -- la palette rougit (pile glissée au-dessus)
	self._dotsShown = 0 -- points de la grille visibles (les premiers de self._dots)
	self._editing = false
	self._problemsPending = false
	self._refreshPending = false -- dessin reporté pendant la saisie dans un champ
	self._renderedModel = nil -- modèle des vues affichées
	self._pendingFieldCommit = nil -- modèle dont un champ a changé pendant un glissement (sans commit)
	self._opts = nil
	self._lastMouse = Vector2.new(0, 0)
	self._destroyed = false
	-- lignes entre les blocs (SPEC §36)
	self._baseLines = {} -- lignes automatiques (messages, modules) et tracées à la main, dessinées
	self._varLines = {} -- lignes « variable » du bloc survolé / sélectionné
	self._linkMaid = Util.Maid.new()
	self._varLinkMaid = Util.Maid.new()
	self._linkSig = nil -- signature des lignes dessinées (rien n'est refait si elle ne change pas)
	self._varLinkSig = nil
	self._linkSetting = "toujours"
	self._linkFocus = {} -- [blockId] = true : blocs sélectionnés dont les lignes s'allument
	self._hoverLinkKey = nil -- ligne dont l'étiquette est survolée
	self._linkRingIds = {} -- [blockId] = couleur : blocs reliés au bloc survolé (contour)
	self._linkRingSig = ""
	self._linkHoverPending = false
	self._linking = nil -- ligne en cours de tracé (« Relier à un autre bloc… »)
	self._flowHandle = nil -- animation des points lumineux
	self._flowBase = 0
	self._flowKey = {}
	self._flowWaiting = false

	self:_build(parentFrame)
	self:_applyView()
	self:refresh()
	return self
end

function Canvas:_build(parentFrame)
	self.frame = Util.create("Frame", {
		Name = "Canvas",
		BackgroundColor3 = Theme.Colors.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parentFrame,
	})

	-- Fond cliquable (déplacement de la vue, clic droit, molette)
	self.background = Util.create("TextButton", {
		Name = "Fond",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = self.frame,
	})

	-- Grille de points (cadres réutilisés, seulement la zone visible)
	self.gridFrame = Util.create("Frame", {
		Name = "Grille",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = 2,
		Parent = self.frame,
	})

	-- Monde : contient les piles (unités du canvas)
	self.world = Util.create("Frame", {
		Name = "Monde",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = 3,
		Parent = self.frame,
	})
	self.worldScale = Util.create("UIScale", { Scale = 1, Parent = self.world })

	-- Lignes entre les blocs (SPEC §36) : sous toutes les piles (ZIndex 0), au-dessus de la grille
	self.linksLayer = Util.create("Frame", {
		Name = "Liens",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = 0,
		Parent = self.world,
	})

	-- Fantôme d'aimantation : blanc translucide
	self.ghost = Util.create("Frame", {
		Name = "Aimant",
		BackgroundColor3 = Theme.Colors.SnapHighlight or WHITE,
		BackgroundTransparency = 0.84,
		BorderSizePixel = 0,
		Active = false,
		Visible = false,
		ZIndex = Z_GHOST,
		Parent = self.world,
	})
	self.ghostCorner = Util.corner(self.ghost, 6)
	self.ghostStroke = Util.stroke(self.ghost, Theme.Colors.SnapHighlight or WHITE, 2, 0.45)

	-- Notes (SPEC §29) : au-dessus de toutes les piles
	self.notesLayer = Util.create("Frame", {
		Name = "Notes",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = Z_NOTES,
		Parent = self.world,
	})

	-- Rectangle de sélection (Maj + glisser sur le fond)
	self.selectBox = Util.create("Frame", {
		Name = "Selection",
		BackgroundColor3 = Theme.Colors.Accent,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Active = false,
		Visible = false,
		ZIndex = Z_SELECT_BOX,
		Parent = self.world,
	})
	Util.corner(self.selectBox, 4)
	Util.stroke(self.selectBox, Theme.Colors.Accent, 1.5, 0.1)

	self:_buildEmptyState()
	self:_buildHint()
	self:_buildZoomCluster()
	self:_buildMinimap()

	local c = self.connections
	table.insert(c, self.background.MouseButton1Down:Connect(function()
		self:_onBackgroundPress()
	end))
	table.insert(c, self.background.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton3 then
			self._kbActive = true
			self:_beginPan(Enum.UserInputType.MouseButton3)
		else
			self:_onInput(input, true)
		end
	end))
	table.insert(c, self.background.InputEnded:Connect(function(input)
		self:_onInput(input, false)
	end))
	table.insert(c, self.background.MouseButton2Click:Connect(function()
		self._kbActive = true
		self:_backgroundMenu()
	end))
	table.insert(c, self.background.InputChanged:Connect(function(input)
		self:_onInputChanged(input)
	end))
	table.insert(c, self.frame.InputChanged:Connect(function(input)
		self:_onInputChanged(input)
	end))
	-- clavier (raccourcis) et touches de modification : reçus par les objets sous la souris
	table.insert(c, self.frame.InputBegan:Connect(function(input)
		self:_onInput(input, true)
	end))
	table.insert(c, self.frame.InputEnded:Connect(function(input)
		self:_onInput(input, false)
	end))
	table.insert(c, self.frame.MouseLeave:Connect(function()
		-- (MouseLeave arrive aussi en passant sur certains enfants : on vérifie la position)
		if not self._destroyed and self.frame and not Util.pointInGui(self:_mouse(), self.frame) then
			self._kbActive = false
			self._shiftDown = false
			self._ctrlDown = false
		end
	end))
	table.insert(c, self.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_updateGrid()
		self:_layoutFloating()
		self:_updateMinimap()
		-- zone repliée (hauteur nulle) : les animations des problèmes s'arrêtent ; dépliée : elles
		-- repartent, et les points lumineux des lignes aussi
		self:_syncPulses()
		self:_maybeStartFlow()
	end))
	local widget = self.host and self.host.widget
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(c, widget.WindowFocusReleased:Connect(function()
				self._kbActive = false
				self._shiftDown = false
				self._ctrlDown = false
			end))
		end)
		-- fenêtre fermée : les contours et pastilles des problèmes s'arrêtent (l'App reste en vie, leurs
		-- boucles tourneraient toute la session) ; fenêtre rouverte : ils repartent, ainsi que les points
		-- lumineux des lignes (qui s'arrêtent d'eux-mêmes fenêtre fermée)
		pcall(function()
			table.insert(c, widget:GetPropertyChangedSignal("Enabled"):Connect(function()
				if not self._destroyed then
					self:_syncPulses()
					self:_maybeStartFlow()
				end
			end))
		end)
	end
end

function Canvas:_buildEmptyState()
	local holder = Util.create("Frame", {
		Name = "Vide",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(440, 60),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Visible = false,
		ZIndex = 4,
		Parent = self.frame,
	})
	makeLabel({
		Text = "Glisse un bloc ici pour commencer",
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		ZIndex = 4,
		Parent = holder,
	})
	makeLabel({
		Text = "Commence par un bloc « Quand… » de la catégorie Événements.",
		TextSize = 13,
		TextColor3 = Theme.Colors.TextDisabled or Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 28),
		ZIndex = 4,
		Parent = holder,
	})
	self.emptyState = holder
end

function Canvas:_buildHint()
	local textSize = 12
	local tw = Util.textSize(HINT_TEXT, textSize, Theme.Fonts.UI).X
	self._hintWidth = math.ceil(tw) + 26
	local chip = Util.create("Frame", {
		Name = "Astuce",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(self._hintWidth, 28),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = Z_FLOATING,
		Parent = self.frame,
	})
	Util.corner(chip, 14)
	Util.stroke(chip, Theme.Colors.PanelBorder, 1)
	self.hintLabel = makeLabel({
		Name = "Texte",
		Text = HINT_TEXT,
		TextSize = textSize,
		TextColor3 = Theme.Colors.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(13, 0),
		Size = UDim2.new(1, -26, 1, 0),
		ZIndex = Z_FLOATING + 1,
		Parent = chip,
	})
	self.hint = chip
end

-- Texte de l'astuce en bas à gauche (onglet Interface, par exemple) ; nil ou "" = l'astuce d'origine
function Canvas:setHint(text)
	if self._destroyed or not self.hintLabel then
		return
	end
	if type(text) ~= "string" or text == "" then
		text = HINT_TEXT
	end
	self.hintLabel.Text = text
	self._hintWidth = math.ceil(Util.textSize(text, 12, Theme.Fonts.UI).X) + 26
	self:_layoutFloating()
end

function Canvas:_buildZoomCluster()
	local BTN = 30
	local LABEL_W = 58
	local H = 34
	local width = 4 + BTN + LABEL_W + BTN + 9 + BTN + 4
	self._clusterWidth = width
	local cluster = Util.create("Frame", {
		Name = "Zoom",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(width, H),
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		ZIndex = Z_FLOATING,
		Parent = self.frame,
	})
	Util.corner(cluster, 10)
	Util.stroke(cluster, Theme.Colors.PanelBorder, 1)
	self.zoomCluster = cluster

	local function button(x, w, text, font, size, color, tip, onClick)
		-- ancré au centre : l'appui (Anim.press) rétrécit le bouton sur lui-même
		local b = Util.create("TextButton", {
			Name = "Bouton",
			Text = text,
			Font = font,
			TextSize = size,
			TextColor3 = color,
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Colors.ButtonHover,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x + math.floor(w / 2), math.floor(H / 2)),
			Size = UDim2.fromOffset(w, H - 6),
			ZIndex = Z_FLOATING + 1,
			Parent = cluster,
		})
		Util.corner(b, 7)
		table.insert(self.connections, { Disconnect = Anim.press(b) })
		table.insert(self.connections, b.MouseEnter:Connect(function()
			Anim.tween(b, { BackgroundTransparency = 0 }, Theme.Anim.Fast, "quadOut")
			if self.dialogs then
				self.dialogs:tooltip(tip, self:_mouse())
			end
		end))
		table.insert(self.connections, b.MouseLeave:Connect(function()
			Anim.tween(b, { BackgroundTransparency = 1 }, Theme.Anim.Fast, "quadOut")
			if self.dialogs then
				self.dialogs:hideTooltip()
			end
		end))
		table.insert(self.connections, b.MouseButton1Click:Connect(function()
			if self.dialogs then
				self.dialogs:hideTooltip()
			end
			onClick()
		end))
		return b
	end

	local x = 4
	button(x, BTN, "−", Theme.Fonts.UIBold, 18, Theme.Colors.Text, "Zoom arrière", function()
		self:zoomOut()
	end)
	x += BTN
	-- (zoom de départ des réglages : « Taille des blocs », 100 % par défaut)
	self.zoomLabel = button(x, LABEL_W, "100 %", Theme.Fonts.UI, 12, Theme.Colors.TextSoft, "Revenir à la taille normale", function()
		self:setZoom(defaultZoom(), self:_center())
	end)
	x += LABEL_W
	button(x, BTN, "+", Theme.Fonts.UIBold, 18, Theme.Colors.Text, "Zoom avant", function()
		self:zoomIn()
	end)
	x += BTN
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(x + 4, 8),
		Size = UDim2.fromOffset(1, H - 16),
		ZIndex = Z_FLOATING + 1,
		Parent = cluster,
	})
	x += 9
	button(x, BTN, "◎", Theme.Fonts.UIBold, 15, Theme.Colors.Text, "Recentrer sur les blocs", function()
		self:recenter()
	end)
end

-- L'astuce rétrécit (ou disparaît) quand la zone est étroite
function Canvas:_layoutFloating()
	if self._destroyed or not self.hint then
		return
	end
	local W = self.frame.AbsoluteSize.X
	if W <= 0 then
		return
	end
	local available = W - (self._clusterWidth or 160) - 12 * 3
	if available < 150 then
		self.hint.Visible = false
	else
		self.hint.Visible = true
		self.hint.Size = UDim2.fromOffset(math.min(self._hintWidth or 300, available), 28)
	end
	-- mini-carte au-dessus de l'astuce (en bas à gauche quand l'astuce est cachée)
	if self.minimap then
		local bottom = 12
		if self.hint.Visible then
			bottom = 12 + 28 + 8
		end
		self.minimap.Position = UDim2.new(0, 12, 1, -bottom)
	end
end

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

function Canvas:_mouse()
	local host = self.host
	if host and type(host.getMousePosition) == "function" then
		local ok, p = pcall(host.getMousePosition)
		if ok and typeof(p) == "Vector2" then
			self._lastMouse = p
			return p
		end
	end
	return self._lastMouse
end

function Canvas:_center()
	if not self.frame then
		return Vector2.new(0, 0)
	end
	return self.frame.AbsolutePosition + self.frame.AbsoluteSize / 2
end

function Canvas:_status(text, kind)
	local fn = self.deps.setStatus
	if type(fn) == "function" then
		pcall(fn, text, kind)
	end
end

function Canvas:_overPalette(p)
	local fn = self.deps.isOverPalette
	if type(fn) ~= "function" then
		return false
	end
	local ok, result = pcall(fn, p)
	return ok and result == true
end

function Canvas:_overCanvas(p)
	return self.frame ~= nil and Util.pointInGui(p, self.frame)
end

-- Palette qui rougit quand une pile glissée passe au-dessus (Palette.new l'enregistre elle-même)
function Canvas:setPalette(palette)
	if type(palette) == "table" then
		self._palette = palette
	else
		self._palette = nil
	end
end

-- Indice de suppression : deps.setDeleteHint(bool), sinon palette:setDeleteHint(bool)
function Canvas:_setDeleteHint(on)
	on = on == true
	if self._deleteHint == on then
		return
	end
	self._deleteHint = on
	local fn = self.deps.setDeleteHint
	if type(fn) == "function" then
		pcall(fn, on)
		return
	end
	local palette = self._palette
	if palette ~= nil and type(palette.setDeleteHint) == "function" then
		pcall(palette.setDeleteHint, palette, on)
	end
end

-- Enregistre l'action (Changed redessine via App) ; redessine soi-même si personne ne l'a fait
-- (force : voir Canvas:refresh, utilisé à la fin d'un glissement)
function Canvas:_commit(reason, force)
	local model = self.getModel()
	if not model then
		return
	end
	local before = self._refreshCount
	local ok, err = pcall(function()
		model:commit(reason)
	end)
	if not ok then
		warn("[Blocs FR] Canvas : commit impossible : " .. tostring(err))
	end
	if not self._destroyed and self._refreshCount == before then
		self:refresh(force)
	end
end

---------------------------------------------------------------------------
-- Coordonnées, zoom, déplacement de la vue
---------------------------------------------------------------------------

function Canvas:screenToCanvas(v2)
	local o = self.frame.AbsolutePosition
	return Vector2.new((v2.X - o.X - self.panX) / self.zoom, (v2.Y - o.Y - self.panY) / self.zoom)
end

function Canvas:canvasToScreen(v2)
	local o = self.frame.AbsolutePosition
	return Vector2.new(o.X + self.panX + v2.X * self.zoom, o.Y + self.panY + v2.Y * self.zoom)
end

-- Zoom visé (pendant une animation de zoom) ou zoom affiché
function Canvas:getZoom()
	return self._zoomTarget or self.zoom
end

function Canvas:getViewState()
	return { zoom = self.zoom, panX = self.panX, panY = self.panY }
end

function Canvas:_applyView()
	if self._destroyed then
		return
	end
	self.world.Position = UDim2.fromOffset(self.panX, self.panY)
	self.worldScale.Scale = self.zoom
	self:_updateGrid()
	if self.zoomLabel then
		self.zoomLabel.Text = tostring(round(self.zoom * 100)) .. " %"
	end
	self:_updateMinimapView()
	-- une ligne revient dans la partie visible : ses points lumineux repartent
	if self._flowHandle == nil and not self._flowWaiting then
		self:_maybeStartFlow()
	end
end

function Canvas:_setPan(x, y)
	self.panX = round(x)
	self.panY = round(y)
	self:_applyView()
end

function Canvas:_setZoomValue(z)
	local old = self.zoom
	self.zoom = z
	if old ~= z then
		self.ZoomChanged:Fire(z)
	end
end

-- La pile glissée suit l'échelle du canvas (et reste sous la souris)
function Canvas:_syncDragScale()
	local d = self.drag
	if d then
		self:_placeDragVisual(d)
	end
end

-- Arrête l'animation de la vue (zoom, recentrage, focusBlock) là où elle en est
function Canvas:_stopViewAnimation()
	local handle = self._viewAnim
	self._viewAnim = nil
	self._zoomTarget = nil
	if handle then
		handle:cancel()
	end
end

-- Zoom (0,4 à 2) en gardant fixe le point du canvas sous anchorScreenPos (centre par défaut).
-- Animé (0,15 s) sauf si instant = true ou si les animations sont désactivées.
function Canvas:setZoom(z, anchorScreenPos, instant)
	if self._destroyed then
		return
	end
	-- une animation en cours s'arrête où elle en est : on repart de la vue affichée
	self:_stopViewAnimation()
	z = Util.clamp(tonumber(z) or 1, MIN_ZOOM, MAX_ZOOM)
	if math.abs(z - 1) < 0.02 then
		z = 1
	end
	z = math.floor(z * 1000 + 0.5) / 1000
	local anchor = anchorScreenPos
	if typeof(anchor) ~= "Vector2" then
		anchor = self:_center()
	end
	local before = self:screenToCanvas(anchor)
	local o = self.frame.AbsolutePosition
	local function show(zoom)
		self.zoom = zoom
		self.panX = round(anchor.X - o.X - before.X * zoom)
		self.panY = round(anchor.Y - o.Y - before.Y * zoom)
		self:_applyView()
		self:_syncDragScale()
	end
	local z0 = self.zoom
	if instant == true or not Anim.enabled() or math.abs(z - z0) < 0.0005 then
		local old = self.zoom
		show(z)
		if old ~= z then
			self.ZoomChanged:Fire(z)
		end
		return
	end
	self._zoomTarget = z
	self.ZoomChanged:Fire(z)
	local handle
	handle = Anim.step(function(k)
		if self._destroyed then
			return
		end
		if k >= 1 then
			show(z)
		else
			show(z0 + (z - z0) * k)
		end
	end, ZOOM_TIME, "quadOut", function()
		if self._viewAnim == handle then
			self._viewAnim = nil
			self._zoomTarget = nil
		end
	end, self)
	if handle:isPlaying() then
		self._viewAnim = handle
	else
		self._zoomTarget = nil
	end
end

function Canvas:zoomIn()
	self:setZoom(self:getZoom() * BUTTON_STEP, self:_center())
end

function Canvas:zoomOut()
	self:setZoom(self:getZoom() / BUTTON_STEP, self:_center())
end

-- Anime la vue (zoom et déplacement ensemble) jusqu'à (z, px, py)
function Canvas:_animateView(z, px, py, duration)
	if self._destroyed then
		return
	end
	self:_stopViewAnimation()
	px, py = round(px), round(py)
	local z0, x0, y0 = self.zoom, self.panX, self.panY
	if not Anim.enabled() then
		self.panX, self.panY = px, py
		self:_setZoomValue(z)
		self:_applyView()
		self:_syncDragScale()
		return
	end
	if z ~= z0 then
		self._zoomTarget = z
		self.ZoomChanged:Fire(z)
	end
	local handle
	handle = Anim.step(function(k)
		if self._destroyed then
			return
		end
		if k >= 1 then
			self.zoom = z
			self.panX, self.panY = px, py
		else
			self.zoom = z0 + (z - z0) * k
			self.panX = round(x0 + (px - x0) * k)
			self.panY = round(y0 + (py - y0) * k)
		end
		self:_applyView()
		self:_syncDragScale()
	end, duration or RECENTER_TIME, "quintOut", function()
		if self._viewAnim == handle then
			self._viewAnim = nil
			self._zoomTarget = nil
		end
	end, self)
	if handle:isPlaying() then
		self._viewAnim = handle
	else
		self._zoomTarget = nil
	end
end

-- Limites (unités du canvas) de toutes les piles, ou nil si le projet est vide
function Canvas:_contentBounds()
	local model = self.getModel()
	if not model or type(model.tops) ~= "table" or #model.tops == 0 then
		return nil
	end
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, id in ipairs(model.tops) do
		local block = model:get(id)
		if block then
			local ok, w, h = pcall(Renderer.measure, model, id)
			if not ok then
				w, h = 100, 40
			end
			local x, y = tonumber(block.x) or 0, tonumber(block.y) or 0
			minX = math.min(minX, x)
			minY = math.min(minY, y)
			maxX = math.max(maxX, x + w)
			maxY = math.max(maxY, y + h)
		end
	end
	if minX == math.huge then
		return nil
	end
	return { minX = minX, minY = minY, maxX = maxX, maxY = maxY }
end

-- Zoom de départ des réglages (100 % par défaut) ; le coin haut-gauche des blocs est montré près du
-- coin de la zone
function Canvas:resetView()
	if self._destroyed then
		return
	end
	self:_stopViewAnimation()
	local z = defaultZoom()
	local bounds = self:_contentBounds()
	if bounds then
		self.panX = round(VIEW_MARGIN - bounds.minX * z)
		self.panY = round(VIEW_MARGIN - bounds.minY * z)
	else
		self.panX, self.panY = 0, 0
	end
	self:_setZoomValue(z)
	self:_applyView()
end

-- Zoom animé autour du centre de la zone (SPEC §35)
function Canvas:setZoomAnimated(z)
	self:setZoom(z, self:_center())
end

-- Remet une vue gardée par getViewState (reconstruction de l'éditeur après les paramètres)
function Canvas:setViewState(state)
	if self._destroyed or type(state) ~= "table" then
		return
	end
	self:_stopViewAnimation()
	local z = clampZoom(tonumber(state.zoom) or self.zoom)
	local px, py = tonumber(state.panX), tonumber(state.panY)
	if px and px == px and math.abs(px) < 1e7 then
		self.panX = round(px)
	end
	if py and py == py and math.abs(py) < 1e7 then
		self.panY = round(py)
	end
	self:_setZoomValue(z)
	self:_applyView()
end

-- « Recentrer » (◎) : montre tous les blocs (zoom ≤ 100 %), centrés quand ils tiennent.
-- La vue glisse jusque-là (0,3 s) au lieu de sauter.
function Canvas:recenter()
	if self._destroyed then
		return
	end
	local bounds = self:_contentBounds()
	local size = self.frame.AbsoluteSize
	if not bounds or size.X < 60 or size.Y < 60 then
		self:resetView()
		return
	end
	local bw = math.max(1, bounds.maxX - bounds.minX)
	local bh = math.max(1, bounds.maxY - bounds.minY)
	local fit = math.min((size.X - 2 * VIEW_MARGIN) / bw, (size.Y - 2 * VIEW_MARGIN) / bh)
	local z = Util.clamp(math.min(1, fit), MIN_ZOOM, MAX_ZOOM)
	z = math.floor(z * 100) / 100
	if z < MIN_ZOOM then
		z = MIN_ZOOM
	end
	local panX, panY
	if bw * z <= size.X - 2 * VIEW_MARGIN then
		panX = size.X / 2 - (bounds.minX + bw / 2) * z
	else
		panX = VIEW_MARGIN - bounds.minX * z
	end
	if bh * z <= size.Y - 2 * VIEW_MARGIN then
		panY = size.Y / 2 - (bounds.minY + bh / 2) * z
	else
		panY = VIEW_MARGIN - bounds.minY * z
	end
	self:_animateView(z, panX, panY, RECENTER_TIME)
end

function Canvas:_onInputChanged(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		self:_onWheel(input)
	end
end

-- Molette : zoom autour du curseur. Plusieurs objets peuvent signaler le même cran : on ignore
-- les doublons arrivés presque en même temps.
function Canvas:_onWheel(input)
	if self._destroyed or self._tracking then
		return
	end
	local now = os.clock()
	if now - self._lastWheel < 0.012 then
		return
	end
	local dz = input.Position.Z
	if dz == 0 then
		return
	end
	self._lastWheel = now
	local factor = WHEEL_STEP
	if dz < 0 then
		factor = 1 / WHEEL_STEP
	end
	-- à partir du zoom visé : plusieurs crans rapides s'additionnent pendant l'animation
	self:setZoom(self:getZoom() * factor, self:_mouse())
end

---------------------------------------------------------------------------
-- Grille de points
---------------------------------------------------------------------------

-- Cache tous les points et tous les traits (changement de style de grille)
function Canvas:_hideGrid()
	for i = 1, math.min(self._dotsShown or 0, #self._dots) do
		self._dots[i].Visible = false
	end
	self._dotsShown = 0
	for _, line in ipairs(self._gridLines) do
		line.Visible = false
	end
	self._gridKey = nil
end

-- Grille « lignes » : traits verticaux et horizontaux réutilisés (zone visible seulement)
function Canvas:_updateGridLines(spacing, W, H)
	local sp = spacing * self.zoom
	local cols, rows = 0, 0
	for _ = 1, 10 do
		cols = math.ceil(W / sp) + 2
		rows = math.ceil(H / sp) + 2
		if cols + rows <= MAX_LINES then
			break
		end
		sp *= 2
	end
	local key = string.format("L%.4f/%d/%d/%d/%d", sp, cols, rows, math.floor(W), math.floor(H))
	if key ~= self._gridKey then
		self._gridKey = key
		local color = Theme.Colors.GridDot
		local count = 0
		local function line(px, py, w, h)
			count += 1
			local f = self._gridLines[count]
			if not f then
				f = Util.create("Frame", {
					Name = "Trait",
					BorderSizePixel = 0,
					Active = false,
					Parent = self.gridFrame,
				})
				self._gridLines[count] = f
			end
			f.BackgroundColor3 = color
			f.BackgroundTransparency = 0.35
			f.Position = UDim2.fromOffset(px, py)
			f.Size = UDim2.fromOffset(w, h)
			f.Visible = true
		end
		local totalW = round(cols * sp)
		local totalH = round(rows * sp)
		for i = 0, cols - 1 do
			line(round(i * sp), 0, 1, totalH)
		end
		for j = 0, rows - 1 do
			line(0, round(j * sp), totalW, 1)
		end
		for k = count + 1, #self._gridLines do
			self._gridLines[k].Visible = false
		end
	end
	local m0x = math.floor(-self.panX / sp)
	local m0y = math.floor(-self.panY / sp)
	self.gridFrame.Position = UDim2.fromOffset(round(self.panX + m0x * sp), round(self.panY + m0y * sp))
end

function Canvas:_updateGrid()
	if self._destroyed or not self.gridFrame then
		return
	end
	local size = self.frame.AbsoluteSize
	local W, H = math.max(0, size.X), math.max(0, size.Y)
	-- style et taille des réglages (SPEC §31), lus à chaque mise à jour
	local style, spacing = gridSettings()
	if style ~= self._gridStyle then
		self:_hideGrid()
		self._gridStyle = style
	end
	if style == "aucune" then
		self.gridFrame.Visible = false
		return
	end
	self.gridFrame.Visible = true
	if style == "lignes" then
		self:_updateGridLines(spacing, W, H)
		return
	end
	local sp = spacing * self.zoom
	local cols, rows = 0, 0
	for _ = 1, 10 do
		cols = math.ceil(W / sp) + 2
		rows = math.ceil(H / sp) + 2
		if cols * rows <= MAX_DOTS then
			break
		end
		sp *= 2 -- moins de points quand on dézoome (la grille reste alignée)
	end
	local key = string.format("%.4f/%d/%d", sp, cols, rows)
	if key ~= self._gridKey then
		-- (pendant un zoom animé, la grille change à chaque image : seuls les points qui
		-- apparaissent ou disparaissent changent de Visible)
		self._gridKey = key
		local shown = self._dotsShown or 0
		local count = 0
		for j = 0, rows - 1 do
			for i = 0, cols - 1 do
				if count < MAX_DOTS then
					count += 1
					local dot = self._dots[count]
					if not dot then
						dot = Util.create("Frame", {
							Name = "Point",
							BackgroundColor3 = Theme.Colors.GridDot,
							BorderSizePixel = 0,
							Active = false,
							Size = UDim2.fromOffset(DOT_SIZE, DOT_SIZE),
							Parent = self.gridFrame,
						})
						self._dots[count] = dot
					end
					dot.Position = UDim2.fromOffset(round(i * sp) - 1, round(j * sp) - 1)
					if count > shown then
						dot.Visible = true
					end
				end
			end
		end
		for k = count + 1, math.min(shown, #self._dots) do
			self._dots[k].Visible = false
		end
		self._dotsShown = count
	end
	local m0x = math.floor(-self.panX / sp)
	local m0y = math.floor(-self.panY / sp)
	self.gridFrame.Position = UDim2.fromOffset(round(self.panX + m0x * sp), round(self.panY + m0y * sp))
end

---------------------------------------------------------------------------
-- Dessin des piles
---------------------------------------------------------------------------

function Canvas:_renderOpts()
	if not self._opts then
		self._opts = {
			interactive = true,
			problems = {},
			callbacks = {
				onBlockPointerDown = function(blockId)
					self:_onBlockPointerDown(blockId)
				end,
				onBlockContextMenu = function(blockId)
					self:_onBlockContextMenu(blockId)
				end,
				onInputCommit = function(blockId, inputName, value, srcModel)
					self:_onInputCommit(blockId, inputName, value, srcModel)
				end,
				openMenu = function(screenPos, items, onChoose)
					if self.dialogs then
						self.dialogs:menu(screenPos, items, onChoose)
					end
				end,
				openColorPicker = function(screenPos, rgb, onChoose)
					if self.dialogs then
						self.dialogs:colorPicker(screenPos, rgb, onChoose)
					end
				end,
				getVariables = function()
					local model = self.getModel()
					return (model and model.variables) or {}
				end,
				onWheel = function(input)
					self:_onWheel(input)
				end,
				onFieldFocus = function(_, _, focused)
					self:_onFieldFocus(focused)
				end,
				onBodyInput = function(_, input, began)
					if began and input.UserInputType == Enum.UserInputType.MouseButton1 then
						self._kbActive = true
					end
					self:_onInput(input, began)
				end,
				onHover = function(blockId, entering)
					self:_onBlockHover(blockId, entering)
				end,
				-- champs « gui » (SPEC §21.6) : noms des écrans / éléments, « Autre nom… »
				promptText = function(title, defaultText, onOk)
					self:_promptText(title, defaultText, onOk)
				end,
			},
		}
	end
	local cb = self._opts.callbacks
	if type(self.deps.getGuiNames) == "function" then
		cb.getGuiNames = function(filter)
			local ok, list = pcall(self.deps.getGuiNames, filter)
			if ok and type(list) == "table" then
				return list
			end
			return {}
		end
	else
		cb.getGuiNames = nil
	end
	self._opts.problems = self.problems
	return self._opts
end

-- Demande un texte : deps.promptText s'il existe, sinon la fenêtre de saisie de Dialogs
function Canvas:_promptText(title, defaultText, onOk)
	local fn = self.deps.promptText
	if type(fn) == "function" then
		local ok = pcall(fn, title, defaultText, onOk)
		if ok then
			return
		end
	end
	if self.dialogs then
		self.dialogs:prompt(title, "Écris le nom exact (comme dans le Studio d'interface) :", tostring(defaultText or ""), onOk)
	end
end

-- Survol d'un bloc (SPEC §21.8) : deps.onBlockHover(blockId, entering)
function Canvas:_onBlockHover(blockId, entering)
	if self._destroyed then
		return
	end
	if entering then
		self._hoverBlock = blockId
	elseif self._hoverBlock == blockId then
		self._hoverBlock = nil
	end
	-- ses lignes s'allument, les autres pâlissent (SPEC §36)
	self:_scheduleLinkHover()
	local fn = self.deps.onBlockHover
	if type(fn) == "function" then
		pcall(fn, blockId, entering == true)
	end
end

-- Redessine toutes les piles du modèle (sauf la pile en cours de glissement).
-- Pendant la saisie dans un champ, le dessin est reporté à la perte du focus (sauf force = true ou
-- changement de modèle) : il détruirait le TextBox qui a le focus (clic direct d'un champ à l'autre).
function Canvas:refresh(force)
	if self._destroyed then
		return
	end
	local model = self.getModel()
	if self._editing and force ~= true and model == self._renderedModel then
		self._refreshPending = true
		return
	end
	self._refreshCount += 1
	self._problemsPending = false
	self._refreshPending = false
	-- aucun champ ne survit au nouveau dessin (ses connexions sont coupées avant son FocusLost)
	self._editing = false
	self._editingNote = nil
	self._frontZ = FRONT_Z0
	-- le bloc survolé disparaît avec son dessin : fin du survol (son élément d'interface s'éteint)
	local hovered = self._hoverBlock
	if hovered ~= nil then
		self._hoverBlock = nil
		local hoverFn = self.deps.onBlockHover
		if type(hoverFn) == "function" then
			pcall(hoverFn, hovered, false)
		end
	end
	self:_stopPulses()
	self:_clearRings()
	for _, view in pairs(self.views) do
		pcall(function()
			view:destroy()
		end)
	end
	self.views = {}
	self._renderedModel = model
	self:_pruneSelection(model)

	local drawn = 0
	local failures = 0
	local firstError = nil
	if model and type(model.tops) == "table" then
		local opts = self:_renderOpts()
		local dragged = nil
		if self.drag and self.drag.model == model then
			dragged = self.drag.rootId
		end
		for index, topId in ipairs(model.tops) do
			if topId ~= dragged then
				drawn += 1
				local ok, view = pcall(Renderer.renderStack, model, topId, self.world, opts)
				if ok and type(view) == "table" and view.frame then
					view.frame.ZIndex = index
					self.views[topId] = view
				else
					failures += 1
					if firstError == nil then
						firstError = view
					end
				end
			end
		end
	end
	local hasNotes = model ~= nil and type(model.notes) == "table" and next(model.notes) ~= nil
	self.emptyState.Visible = drawn == 0 and self.drag == nil and not hasNotes
	if failures > 0 then
		warn("[Blocs FR] Canvas : " .. failures .. " pile(s) impossible(s) à dessiner : " .. tostring(firstError))
		self:_status("Certains blocs n'ont pas pu être dessinés (" .. failures .. " pile(s)).", "error")
	end
	local okNotes, errNotes = pcall(self._renderNotes, self, model)
	if not okNotes then
		warn("[Blocs FR] Canvas : notes impossibles à dessiner : " .. tostring(errNotes))
	end
	local okLinks, errLinks = pcall(self._renderLinks, self, model)
	if not okLinks then
		warn("[Blocs FR] Canvas : lignes entre les blocs impossibles à dessiner : " .. tostring(errLinks))
	end
	self:_updateRings()
	self:_updateMinimap()
	self:_startPulses(model)
end

-- Arrête les respirations des contours de problèmes et les sauts des pastilles
function Canvas:_stopPulses()
	local list = self._pulses
	self._pulses = {}
	for _, stop in ipairs(list) do
		pcall(stop)
	end
end

-- Contours des problèmes qui respirent (1,4 s) et pastilles « ! » qui sautent, sur les vues qui
-- contiennent un bloc à problème (cadres « Probleme » et « Pastille » dessinés par le Renderer)
function Canvas:_startPulses(model)
	self:_stopPulses()
	if not model or not Anim.enabled() or next(self.problems) == nil then
		return
	end
	-- zone de travail cachée (fenêtre fermée, zone repliée) : rien ne tourne ; _syncPulses les lance
	-- quand elle réapparaît
	if not self:_canvasShown() then
		self._pulsesParked = true
		return
	end
	self._pulsesParked = false
	local roots = {}
	for blockId in pairs(self.problems) do
		local ok, rootId = pcall(model.root, model, blockId)
		if ok and rootId ~= nil and self.views[rootId] ~= nil then
			roots[rootId] = true
		end
	end
	local rings, badges = 0, 0
	for rootId in pairs(roots) do
		local view = self.views[rootId]
		if view and view.frame then
			for _, child in ipairs(view.frame:GetChildren()) do
				if child.Name == "Probleme" and rings < MAX_PULSES then
					local stroke = child:FindFirstChildOfClass("UIStroke")
					if stroke then
						rings += 1
						table.insert(self._pulses, Anim.pulse(stroke, 0, 0.55, 1.4))
					end
				elseif child.Name == "Pastille" and badges < MAX_PULSES and child:IsA("GuiObject") then
					badges += 1
					table.insert(self._pulses, Anim.hop(child, 7, 2.8))
				end
			end
		end
		if rings >= MAX_PULSES and badges >= MAX_PULSES then
			break
		end
	end
end

-- Fenêtre fermée ou ouverte, zone de travail repliée ou dépliée : les animations des problèmes
-- s'arrêtent quand la zone est cachée (sinon leurs boucles tournent sans fin) et repartent sur les vues
-- dessinées quand elle réapparaît
function Canvas:_syncPulses()
	if self._destroyed then
		return
	end
	if not self:_canvasShown() then
		if #self._pulses > 0 then
			self:_stopPulses()
			self._pulsesParked = true
		end
	elseif self._pulsesParked then
		self._pulsesParked = false
		local model = self._renderedModel
		if model ~= nil and model == self.getModel() then
			self:_startPulses(model)
		end
	end
end

-- Contours et pastilles des problèmes (SPEC §18) : map = { [blockId] = gravité }
function Canvas:setProblems(map)
	if self._destroyed then
		return
	end
	local clean = {}
	if type(map) == "table" then
		for id, severity in pairs(map) do
			if type(id) == "string" and (severity == "erreur" or severity == "avertissement" or severity == "conseil") then
				clean[id] = severity
			end
		end
	end
	if sameMap(clean, self.problems) then
		return
	end
	self.problems = clean
	if self._editing then
		-- un champ est en cours de saisie : on redessinera quand il perdra le focus
		self._problemsPending = true
		return
	end
	self:refresh()
end

function Canvas:_onFieldFocus(focused)
	self._editing = focused == true
	if not self._editing and (self._problemsPending or self._refreshPending) then
		task.delay(0.05, function()
			if not self._destroyed and (self._problemsPending or self._refreshPending) and not self._editing then
				self:refresh()
			end
		end)
	end
end

-- Rectangle (unités du canvas) d'un bloc dessiné, ou nil
function Canvas:_blockCanvasRect(blockId)
	local model = self.getModel()
	if not model or blockId == nil or model:get(blockId) == nil then
		return nil
	end
	local rootId = model:root(blockId)
	local view = rootId and self.views[rootId]
	if not view or not view.frame then
		return nil
	end
	local info = view.blocks and view.blocks[blockId]
	if not info then
		return nil
	end
	local fp = view.frame.Position
	return { x = fp.X.Offset + info.x, y = fp.Y.Offset + info.y, w = info.w, h = info.h }
end

---------------------------------------------------------------------------
-- Sélection et contours (SPEC §32, §21.8)
---------------------------------------------------------------------------

function Canvas:_clearRings()
	for _, ring in ipairs(self._rings) do
		pcall(function()
			ring:Destroy()
		end)
	end
	self._rings = {}
end

-- Contour (UIStroke) autour d'un rectangle d'une vue (au-dessus des blocs de la pile)
function Canvas:_addRing(view, x, y, w, h, radius, color, thickness)
	if #self._rings >= MAX_RINGS or not view.frame then
		return
	end
	local ring = Util.create("Frame", {
		Name = "Contour",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(round(x), round(y)),
		Size = UDim2.fromOffset(math.max(2, round(w)), math.max(2, round(h))),
		ZIndex = Z_RING,
		Parent = view.frame,
	})
	Util.corner(ring, radius)
	Util.stroke(ring, color, thickness, 0)
	table.insert(self._rings, ring)
end

local function ringRadius(info, extra)
	if info.shape == "reporter" or info.shape == "boolean" then
		return math.floor((info.ringH or info.h or 20) / 2) + extra
	end
	return (tonumber(Theme.Block.Corner) or 6) + extra
end

-- Contours de la sélection (blanc, 2 px ; une pile entièrement sélectionnée : un seul contour) et des
-- blocs liés à l'élément d'interface choisi (cyan)
function Canvas:_updateRings()
	self:_clearRings()
	if self._destroyed then
		return
	end
	local model = self.getModel()
	if not model or model ~= self._renderedModel then
		return
	end
	-- blocs reliés par une ligne au bloc survolé (couleur de la ligne, SPEC §36) : sous la sélection
	for id, color in pairs(self._linkRingIds or {}) do
		if typeof(color) == "Color3" and model:get(id) ~= nil then
			local view = self.views[model:root(id)]
			local info = view and view.blocks and view.blocks[id]
			if info then
				local y = info.ringY or info.y
				local h = info.ringH or info.h
				self:_addRing(view, info.x - 4, y - 4, info.w + 8, h + 8, ringRadius(info, 4), color, 2)
			end
		end
	end
	-- bloc de départ d'une ligne en cours de tracé
	local linking = self._linking
	if linking and linking.model == model and model:get(linking.from) ~= nil then
		local view = self.views[model:root(linking.from)]
		local info = view and view.blocks and view.blocks[linking.from]
		if info then
			local y = info.ringY or info.y
			local h = info.ringH or info.h
			self:_addRing(view, info.x - 5, y - 5, info.w + 10, h + 10, ringRadius(info, 5), LINK_COLORS.manuel, 2.5)
		end
	end
	local white = Theme.Colors.SnapHighlight or WHITE
	local byRoot = {}
	for id in pairs(self.selection) do
		if model:get(id) ~= nil then
			local rootId = model:root(id)
			if rootId ~= nil then
				byRoot[rootId] = byRoot[rootId] or {}
				table.insert(byRoot[rootId], id)
			end
		end
	end
	for rootId, ids in pairs(byRoot) do
		local view = self.views[rootId]
		if view and view.frame and view.blocks then
			local whole = false
			if #ids > 1 then
				local ok, all = pcall(model.stackIds, model, rootId)
				whole = ok and type(all) == "table" and #all == #ids
			end
			if whole then
				self:_addRing(view, -4, -4, (view.width or 40) + 8, (view.height or 30) + 8, 9, white, 2)
			else
				for _, id in ipairs(ids) do
					local info = view.blocks[id]
					if info then
						local y = info.ringY or info.y
						local h = info.ringH or info.h
						self:_addRing(view, info.x - 3, y - 3, info.w + 6, h + 6, ringRadius(info, 3), white, 2)
					end
				end
			end
		end
	end
	local cyan = Theme.Colors.LinkHighlight or LINK_COLOR
	for id in pairs(self._linkIds) do
		if model:get(id) ~= nil then
			local view = self.views[model:root(id)]
			local info = view and view.blocks and view.blocks[id]
			if info then
				local y = info.ringY or info.y
				local h = info.ringH or info.h
				self:_addRing(view, info.x - 5, y - 5, info.w + 10, h + 10, ringRadius(info, 5), cyan, 2)
			end
		end
	end
end

-- Un autre projet efface la sélection ; les blocs disparus en sortent
function Canvas:_pruneSelection(model)
	if model ~= self._selectionModel then
		self._selectionModel = model
		self._linkIds = {}
		if next(self.selection) ~= nil then
			self.selection = {}
			self.SelectionChanged:Fire({})
		end
		return
	end
	if not model then
		return
	end
	local changed = false
	for id in pairs(self.selection) do
		if model:get(id) == nil then
			self.selection[id] = nil
			changed = true
		end
	end
	if changed then
		self.SelectionChanged:Fire(self:getSelection())
	end
end

-- Ids des blocs sélectionnés (triés)
function Canvas:getSelection()
	local ids = {}
	for id in pairs(self.selection) do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

function Canvas:_setSelection(set)
	if self._destroyed then
		return
	end
	self._selectionModel = self.getModel()
	if sameMap(set, self.selection) then
		return
	end
	self.selection = set
	self:_updateRings()
	-- lignes des blocs sélectionnés (variables, lignes allumées), SPEC §36
	self:_refreshHoverLinks()
	self.SelectionChanged:Fire(self:getSelection())
end

-- Sélectionne des blocs (liste d'ids, ensemble { [id] = true } ou un id) ; additive : garde la sélection
function Canvas:select(ids, additive)
	local model = self.getModel()
	local set = {}
	if additive then
		for id in pairs(self.selection) do
			set[id] = true
		end
	end
	if type(ids) == "string" then
		ids = { ids }
	end
	if type(ids) == "table" and model then
		for key, value in pairs(ids) do
			local id = nil
			if type(value) == "string" then
				id = value
			elseif value == true and type(key) == "string" then
				id = key
			end
			if id ~= nil and model:get(id) ~= nil then
				set[id] = true
			end
		end
	end
	self:_setSelection(set)
end

function Canvas:clearSelection()
	self:_setSelection({})
end

function Canvas:selectAll()
	local model = self.getModel()
	if not model or type(model.blocks) ~= "table" then
		return
	end
	local set = {}
	for id in pairs(model.blocks) do
		set[id] = true
	end
	self:_setSelection(set)
	local n = setCount(set)
	if n > 0 then
		self:_status(pluralBlocs(n) .. " sélectionné" .. (n > 1 and "s" or "") .. ".", "info")
	end
end

-- Tous les blocs de la pile d'un bloc
function Canvas:_selectGroup(blockId)
	local model = self.getModel()
	if not model or model:get(blockId) == nil then
		return
	end
	local ok, ids = pcall(model.stackIds, model, model:root(blockId))
	if ok and type(ids) == "table" then
		self:select(ids, false)
		self:_status(pluralBlocs(#ids) .. " sélectionné" .. (#ids > 1 and "s" or "") .. ".", "info")
	end
end

function Canvas:_toggleSelected(blockId)
	local set = {}
	for id in pairs(self.selection) do
		set[id] = true
	end
	if set[blockId] then
		set[blockId] = nil
	else
		set[blockId] = true
	end
	self:_setSelection(set)
end

-- Blocs reliés à l'élément d'interface sélectionné (SPEC §21.8) : contour cyan
function Canvas:setLinkHighlight(ids)
	if self._destroyed then
		return
	end
	local set = {}
	if type(ids) == "string" then
		set[ids] = true
	elseif type(ids) == "table" then
		for key, value in pairs(ids) do
			if type(value) == "string" then
				set[value] = true
			elseif value == true and type(key) == "string" then
				set[key] = true
			end
		end
	end
	-- (un autre projet vient d'être ouvert : on oublie d'abord ce qui concernait l'ancien)
	self:_pruneSelection(self.getModel())
	if sameMap(set, self._linkIds) then
		return
	end
	self._linkIds = set
	self:_updateRings()
end

-- Piles (racines) dont tous les blocs sont sélectionnés, sauf exceptRoot
function Canvas:_fullySelectedStacks(model, exceptRoot)
	local out = {}
	local seen = {}
	for id in pairs(self.selection) do
		if model:get(id) ~= nil then
			local rootId = model:root(id)
			if rootId ~= nil and rootId ~= exceptRoot and not seen[rootId] then
				seen[rootId] = true
				local ok, all = pcall(model.stackIds, model, rootId)
				local full = ok and type(all) == "table" and #all > 0
				if full then
					for _, bid in ipairs(all) do
						if not self.selection[bid] then
							full = false
							break
						end
					end
				end
				if full then
					table.insert(out, rootId)
				end
			end
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Les notes suivent leurs blocs (SPEC §29)
---------------------------------------------------------------------------

-- Position absolue (unités du canvas) d'un bloc, calculée sans dessin (cache par pile)
function Canvas:_absBlockPos(model, blockId, cache)
	local rootId = model:root(blockId)
	local root = rootId and model:get(rootId)
	if not root then
		return nil
	end
	local map = cache[rootId]
	if map == nil then
		local ok, result = pcall(Renderer.blockPositions, model, rootId)
		if ok and type(result) == "table" then
			map = result
		else
			map = false
		end
		cache[rootId] = map
	end
	if not map then
		return nil
	end
	local p = map[blockId]
	if not p then
		return nil
	end
	return Vector2.new((tonumber(root.x) or 0) + p.x, (tonumber(root.y) or 0) + p.y)
end

-- Avant une action qui déplace des blocs : position actuelle du bloc de chaque note attachée
function Canvas:_captureNoteAnchors(model)
	local anchors = {}
	if not model or type(model.notes) ~= "table" or next(model.notes) == nil then
		return anchors
	end
	local cache = {}
	for noteId, note in pairs(model.notes) do
		if type(note) == "table" and note.blockId ~= nil and model:get(note.blockId) ~= nil then
			local pos = self:_absBlockPos(model, note.blockId, cache)
			if pos then
				anchors[noteId] = pos
			end
		end
	end
	return anchors
end

-- Après l'action (avant le commit) : chaque note bouge comme son bloc
function Canvas:_followNotes(model, anchors)
	if not model or type(anchors) ~= "table" or next(anchors) == nil or type(model.setNote) ~= "function" then
		return
	end
	local cache = {}
	for noteId, old in pairs(anchors) do
		local note = model:getNote(noteId)
		if note and note.blockId ~= nil and model:get(note.blockId) ~= nil then
			local new = self:_absBlockPos(model, note.blockId, cache)
			if new then
				local delta = new - old
				if math.abs(delta.X) >= 0.5 or math.abs(delta.Y) >= 0.5 then
					pcall(model.setNote, model, noteId, {
						x = round((tonumber(note.x) or 0) + delta.X),
						y = round((tonumber(note.y) or 0) + delta.Y),
					})
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Notes : dessin et interactions (SPEC §29, planche « Notes »)
---------------------------------------------------------------------------

-- Point d'accroche d'une note sur son bloc : bord droit, milieu de la première ligne
function Canvas:_noteBlockAnchor(model, blockId)
	local rootId = model:root(blockId)
	local view = rootId and self.views[rootId]
	local info = view and view.blocks and view.blocks[blockId]
	if not info or not view.frame then
		return nil
	end
	local fp = view.frame.Position
	local y = info.ringY or info.y
	local h = info.ringH or info.h
	return Vector2.new(fp.X.Offset + info.x + info.w, fp.Y.Offset + y + math.min(h, 36) / 2)
end

-- Pointillés (courbe de Bézier à tangentes horizontales) entre le bloc et la note
function Canvas:_drawNoteConnector(nv, from, color)
	local w = nv.w
	local ny = nv.y + NOTE_HEADER_H / 2
	local to
	if from.X <= nv.x + w / 2 then
		to = Vector2.new(nv.x, ny)
	else
		to = Vector2.new(nv.x + w, ny)
	end
	local dist = (to - from).Magnitude
	if dist < 8 then
		return
	end
	local dx = to.X - from.X
	local c1 = from + Vector2.new(dx * 0.45, 0)
	local c2 = to - Vector2.new(dx * 0.45, 0)
	local n = math.floor(Util.clamp(dist * 1.1 / NOTE_CONNECTOR_STEP, 2, NOTE_CONNECTOR_MAX))
	nv.dots = {}
	for i = 0, n do
		local t = i / n
		local u = 1 - t
		local p = from * (u * u * u) + c1 * (3 * u * u * t) + c2 * (3 * u * t * t) + to * (t * t * t)
		local dot = Util.create("Frame", {
			Name = "Pointille",
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(round(p.X - 1.5), round(p.Y - 1.5)),
			Size = UDim2.fromOffset(3, 3),
			ZIndex = 1,
			Parent = self.notesLayer,
		})
		Util.corner(dot, 2)
		self._noteMaid:give(dot)
		table.insert(nv.dots, dot)
	end
end

function Canvas:_hideNoteConnector(noteId)
	local nv = self._noteViews[noteId]
	if nv and nv.dots then
		for _, dot in ipairs(nv.dots) do
			dot.Visible = false
		end
	end
end

-- Taille d'une note dessinée (largeur w ; hauteur selon le texte), sans la reconstruire
function Canvas:_layoutNoteView(nv, w)
	nv.w = w
	local innerW = w - 2 * NOTE_PAD_X
	local h = NOTE_HEADER_H
	if not nv.collapsed then
		local text = nv.text
		if nv.box and nv.box.Parent then
			text = nv.box.Text
		end
		if text == "" then
			text = NOTE_PLACEHOLDER
		end
		local th = math.max(NOTE_MIN_BODY, wrappedHeight(text, nv.textSize, nv.font, innerW))
		h = NOTE_HEADER_H + NOTE_PAD_TOP + th + NOTE_PAD_BOTTOM
		if nv.body then
			nv.body.Size = UDim2.fromOffset(innerW, th)
		end
		if nv.box and nv.box.Parent then
			nv.box.Size = UDim2.fromOffset(innerW, th)
		end
	end
	nv.h = h
	nv.container.Size = UDim2.fromOffset(w, h)
	nv.card.Size = UDim2.fromOffset(w, h)
	nv.shadow.Size = UDim2.fromOffset(w, h)
	nv.header.Size = UDim2.fromOffset(w, NOTE_HEADER_H)
	if nv.filler then
		nv.filler.Size = UDim2.fromOffset(w, 10)
	end
	if nv.grip then
		nv.grip.Position = UDim2.fromOffset(w - 14, h - 14)
	end
end

-- Petit bouton du bandeau (« − », « × ») ancré à droite
local function noteHeaderButton(parent, text, rightOffset, colors, maid)
	local b = Util.create("TextButton", {
		Name = "Bouton",
		Text = text,
		Font = Theme.Fonts.UIBold,
		TextSize = 14,
		TextColor3 = colors.Texte,
		AutoButtonColor = false,
		BackgroundColor3 = colors.Texte,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -rightOffset, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		ZIndex = 6,
		Parent = parent,
	})
	Util.corner(b, 5)
	maid:give(b.MouseEnter:Connect(function()
		b.BackgroundTransparency = 0.86
	end))
	maid:give(b.MouseLeave:Connect(function()
		b.BackgroundTransparency = 1
	end))
	return b
end

-- Dessine une note (cadre « Note_<id> » dans le calque des notes)
function Canvas:_buildNote(model, noteId, note)
	local maid = self._noteMaid
	local colors = noteColors(note.couleur)
	local w = Util.clamp(tonumber(note.w) or 200, NOTE_MIN_W, NOTE_MAX_W)
	local x, y = round(tonumber(note.x) or 0), round(tonumber(note.y) or 0)
	local text = tostring(note.text or "")
	local collapsed = note.replie == true
	local nv = {
		id = noteId,
		x = x,
		y = y,
		w = w,
		text = text,
		collapsed = collapsed,
		textSize = noteTextSize(),
		font = Theme.Fonts.UI,
		colors = colors,
	}
	nv.container = Util.create("Frame", {
		Name = "Note_" .. tostring(noteId),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, NOTE_HEADER_H),
		ZIndex = 2,
		Parent = self.notesLayer,
	})
	maid:give(nv.container)
	nv.shadow = Util.create("Frame", {
		Name = "Ombre",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.62,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.fromOffset(w, NOTE_HEADER_H),
		ZIndex = 1,
		Parent = nv.container,
	})
	Util.corner(nv.shadow, NOTE_RADIUS)
	nv.card = Util.create("TextButton", {
		Name = "Carte",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = colors.Fond,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, NOTE_HEADER_H),
		ZIndex = 2,
		Parent = nv.container,
	})
	Util.corner(nv.card, NOTE_RADIUS)
	if not collapsed then
		-- bas du bandeau carré (le haut garde les coins arrondis de la carte)
		nv.filler = Util.create("Frame", {
			Name = "BandeauBas",
			BackgroundColor3 = colors.Entete,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(0, NOTE_HEADER_H - 10),
			Size = UDim2.fromOffset(w, 10),
			ZIndex = 3,
			Parent = nv.container,
		})
	end
	nv.header = Util.create("TextButton", {
		Name = "Bandeau",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = colors.Entete,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, NOTE_HEADER_H),
		ZIndex = 4,
		Parent = nv.container,
	})
	Util.corner(nv.header, NOTE_RADIUS)

	-- bandeau : titre, pastilles de couleur, « − », « × »
	local title = "NOTE"
	if isTodo(text) then
		title = "À FAIRE"
	end
	if collapsed and text ~= "" then
		title = title .. " · " .. firstLine(text, 28)
	end
	local showDots = w >= 176 and not collapsed
	local rightW = 50
	if showDots then
		rightW = 50 + #NOTE_COLORS * (NOTE_DOT + 4) + 2
	end
	makeLabel({
		Name = "Titre",
		Text = title,
		Font = Theme.Fonts.UIBold,
		TextSize = 11,
		TextColor3 = colors.Texte,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -(9 + rightW), 1, 0),
		ZIndex = 5,
		Parent = nv.header,
	})
	local collapseButton = noteHeaderButton(nv.header, collapsed and "＋" or "−", 26, colors, maid)
	local deleteButton = noteHeaderButton(nv.header, "×", 6, colors, maid)
	maid:give(collapseButton.MouseButton1Click:Connect(function()
		self:_setNoteFields(noteId, { replie = not collapsed }, "note")
	end))
	maid:give(deleteButton.MouseButton1Click:Connect(function()
		self:_removeNote(noteId)
	end))
	if showDots then
		for i, couleur in ipairs(NOTE_COLORS) do
			local dotColors = noteColors(couleur)
			local right = 50 + (#NOTE_COLORS - i) * (NOTE_DOT + 4)
			local dot = Util.create("TextButton", {
				Name = "Couleur_" .. couleur,
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = dotColors.Fond,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -right, 0.5, 0),
				Size = UDim2.fromOffset(NOTE_DOT, NOTE_DOT),
				ZIndex = 6,
				Parent = nv.header,
			})
			Util.corner(dot, math.ceil(NOTE_DOT / 2))
			if couleur == note.couleur then
				Util.stroke(dot, colors.Texte, 1.5, 0.15)
			else
				Util.stroke(dot, Color3.new(0, 0, 0), 1.5, 0.75)
			end
			maid:give(dot.MouseButton1Click:Connect(function()
				if couleur ~= note.couleur then
					self:_setNoteFields(noteId, { couleur = couleur }, "note")
				end
			end))
		end
	end

	-- texte (double-clic pour écrire)
	if not collapsed then
		local shown = text
		local placeholder = text == ""
		if placeholder then
			shown = NOTE_PLACEHOLDER
		end
		nv.body = Util.create("TextButton", {
			Name = "Texte",
			Text = shown,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = nv.font,
			TextSize = nv.textSize,
			TextColor3 = colors.Texte,
			TextTransparency = placeholder and 0.45 or 0,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(NOTE_PAD_X, NOTE_HEADER_H + NOTE_PAD_TOP),
			Size = UDim2.fromOffset(w - 2 * NOTE_PAD_X, NOTE_MIN_BODY),
			ZIndex = 3,
			Parent = nv.container,
		})
		-- poignée de largeur (en bas à droite)
		nv.grip = Util.create("TextButton", {
			Name = "Poignee",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(14, 14),
			ZIndex = 5,
			Parent = nv.container,
		})
		for _, p in ipairs({ { 9, 3 }, { 6, 6 }, { 9, 6 }, { 3, 9 }, { 6, 9 }, { 9, 9 } }) do
			Util.create("Frame", {
				Name = "Point",
				BackgroundColor3 = colors.Texte,
				BackgroundTransparency = 0.55,
				BorderSizePixel = 0,
				Active = false,
				Position = UDim2.fromOffset(p[1], p[2]),
				Size = UDim2.fromOffset(2, 2),
				ZIndex = 5,
				Parent = nv.grip,
			})
		end
		maid:give(nv.grip.MouseButton1Down:Connect(function()
			self:_beginNoteResize(noteId)
		end))
		maid:give(nv.body.MouseButton1Click:Connect(function()
			local now = os.clock()
			if self._lastNoteClick == noteId and now - (self._lastNoteClickTime or 0) < DOUBLE_CLICK then
				self._lastNoteClick = nil
				self:_editNote(noteId)
			else
				self._lastNoteClick = noteId
				self._lastNoteClickTime = now
			end
		end))
	end
	self:_layoutNoteView(nv, w)

	-- interactions communes : déplacement par le bandeau, menu, molette, clavier
	maid:give(nv.header.MouseButton1Down:Connect(function()
		self:_beginNoteDrag(noteId)
	end))
	local function wire(obj)
		maid:give(obj.MouseButton2Click:Connect(function()
			self:_noteMenu(noteId)
		end))
		maid:give(obj.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				self:_onWheel(input)
			end
		end))
		maid:give(obj.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				self._kbActive = true
			end
			self:_onInput(input, true)
		end))
		maid:give(obj.InputEnded:Connect(function(input)
			self:_onInput(input, false)
		end))
	end
	wire(nv.card)
	wire(nv.header)
	if nv.body then
		wire(nv.body)
	end

	-- pointillés vers le bloc attaché
	if note.blockId ~= nil and model:get(note.blockId) ~= nil then
		local from = self:_noteBlockAnchor(model, note.blockId)
		if from then
			self:_drawNoteConnector(nv, from, colors.Fond)
		end
	end
	self._noteViews[noteId] = nv
	return nv
end

-- Dessine toutes les notes du modèle (les notes des blocs en cours de glissement sont cachées)
function Canvas:_renderNotes(model)
	self._noteMaid:clean()
	self._noteViews = {}
	if self._destroyed or not model or type(model.notes) ~= "table" or type(model.noteIds) ~= "function" then
		self._pendingEditNote = nil
		return
	end
	local hidden = nil
	local d = self.drag
	if d and d.model == model and d.idSet then
		hidden = d.idSet
	end
	local ok, ids = pcall(model.noteIds, model)
	if not ok or type(ids) ~= "table" then
		return
	end
	for _, noteId in ipairs(ids) do
		local note = model:getNote(noteId)
		if note and not (hidden and note.blockId ~= nil and hidden[note.blockId]) then
			local okNote, err = pcall(self._buildNote, self, model, noteId, note)
			if not okNote then
				warn("[Blocs FR] Canvas : note " .. tostring(noteId) .. " impossible à dessiner : " .. tostring(err))
			end
		end
	end
	local pending = self._pendingEditNote
	self._pendingEditNote = nil
	if pending ~= nil and self._noteViews[pending] then
		task.defer(function()
			if not self._destroyed and self._noteViews[pending] then
				self:_editNote(pending)
			end
		end)
	end
end

-- Modifie une note puis enregistre (une étape d'annulation)
function Canvas:_setNoteFields(noteId, fields, reason)
	local model = self.getModel()
	if self._destroyed or not model or type(model.setNote) ~= "function" or model:getNote(noteId) == nil then
		return false
	end
	local ok, result = pcall(model.setNote, model, noteId, fields)
	if ok and result ~= false then
		self:_commit(reason or "note")
		return true
	end
	return false
end

function Canvas:_removeNote(noteId)
	local model = self.getModel()
	if self._destroyed or not model or type(model.removeNote) ~= "function" then
		return
	end
	if model:removeNote(noteId) then
		self:_commit("note")
		self:_status("Note supprimée (Ctrl+Z ou « Annuler » pour la récupérer).", "info")
	end
end

-- Écrit dans une note : le texte devient un champ de saisie sur plusieurs lignes (enregistré quand
-- il perd le focus)
function Canvas:_editNote(noteId)
	if self._destroyed then
		return
	end
	local model = self.getModel()
	local note = model and model:getNote(noteId)
	local nv = self._noteViews[noteId]
	if not note or not nv then
		return
	end
	if note.replie then
		-- note repliée : on la déplie puis on écrit dedans après le dessin
		self._pendingEditNote = noteId
		self:_setNoteFields(noteId, { replie = false }, "note")
		return
	end
	if not nv.body or (nv.box and nv.box.Parent) then
		return
	end
	local colors = nv.colors
	nv.body.Visible = false
	local box = Util.create("TextBox", {
		Name = "Saisie",
		Text = tostring(note.text or ""),
		PlaceholderText = NOTE_PLACEHOLDER,
		PlaceholderColor3 = colors.Texte:Lerp(colors.Fond, 0.45),
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextEditable = true,
		Font = nv.font,
		TextSize = nv.textSize,
		TextColor3 = colors.Texte,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = nv.body.Position,
		Size = nv.body.Size,
		ZIndex = 4,
		Parent = nv.container,
	})
	nv.box = box
	local maid = self._noteMaid
	maid:give(box:GetPropertyChangedSignal("Text"):Connect(function()
		if nv.box == box and box.Parent then
			self:_layoutNoteView(nv, nv.w)
		end
	end))
	maid:give(box.Focused:Connect(function()
		self._editingNote = noteId
		self:_onFieldFocus(true)
	end))
	maid:give(box.FocusLost:Connect(function()
		local newText = box.Text
		if self._editingNote == noteId then
			self._editingNote = nil
		end
		-- jamais de nouveau dessin (qui détruit ce champ) pendant son propre FocusLost
		task.defer(function()
			if self._destroyed then
				return
			end
			self:_onFieldFocus(false)
			local m = self.getModel()
			local current = m and m == model and m:getNote(noteId)
			if current and newText ~= tostring(current.text or "") then
				self:_setNoteFields(noteId, { text = newText }, "note")
				return
			end
			-- texte inchangé : le champ redevient un simple texte
			if nv.box == box then
				nv.box = nil
			end
			pcall(function()
				box:Destroy()
			end)
			if nv.body and nv.body.Parent then
				nv.body.Visible = true
				self:_layoutNoteView(nv, nv.w)
			end
		end)
	end))
	-- (le mode saisie ne commence qu'au Focused : si le focus ne vient pas, rien ne reste bloqué)
	pcall(function()
		box:CaptureFocus()
	end)
end

-- Déplacement d'une note par son bandeau (un simple clic ne change rien ; double-clic : écrire)
function Canvas:_beginNoteDrag(noteId)
	if self._destroyed or self._tracking then
		return
	end
	local model = self.getModel()
	local note = model and model:getNote(noteId)
	local nv = self._noteViews[noteId]
	if not note or not nv then
		return
	end
	self._kbActive = true
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	local start = self:_mouse()
	local x0, y0 = tonumber(note.x) or 0, tonumber(note.y) or 0
	local moved = false
	nv.container.ZIndex = 3 -- devant les autres notes pendant le déplacement
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			if not moved and (p - start).Magnitude >= DRAG_THRESHOLD then
				moved = true
				self:_hideNoteConnector(noteId)
			end
			if moved and nv.container.Parent then
				local d = (p - start) / self.zoom
				nv.container.Position = UDim2.fromOffset(round(x0 + d.X), round(y0 + d.Y))
			end
		end,
		onEnd = function(p)
			if not moved then
				local now = os.clock()
				if self._lastHeaderClick == noteId and now - (self._lastHeaderClickTime or 0) < DOUBLE_CLICK then
					self._lastHeaderClick = nil
					self:_editNote(noteId)
				else
					self._lastHeaderClick = noteId
					self._lastHeaderClickTime = now
				end
				return
			end
			if self.getModel() ~= model or model:getNote(noteId) == nil then
				self:refresh(true)
				return
			end
			local d = (p - start) / self.zoom
			pcall(model.setNote, model, noteId, { x = round(x0 + d.X), y = round(y0 + d.Y) })
			self:_commit("note", true)
		end,
	})
end

-- Largeur d'une note par la poignée en bas à droite
function Canvas:_beginNoteResize(noteId)
	if self._destroyed or self._tracking then
		return
	end
	local model = self.getModel()
	local note = model and model:getNote(noteId)
	local nv = self._noteViews[noteId]
	if not note or not nv then
		return
	end
	self._kbActive = true
	local start = self:_mouse()
	local w0 = nv.w
	local moved = false
	local newW = w0
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			if not moved and (p - start).Magnitude >= 2 then
				moved = true
				self:_hideNoteConnector(noteId)
			end
			if moved and nv.container.Parent then
				newW = round(Util.clamp(w0 + (p.X - start.X) / self.zoom, NOTE_MIN_W, NOTE_MAX_W))
				self:_layoutNoteView(nv, newW)
			end
		end,
		onEnd = function()
			if not moved then
				return
			end
			if self.getModel() ~= model or model:getNote(noteId) == nil then
				self:refresh(true)
				return
			end
			pcall(model.setNote, model, noteId, { w = newW })
			self:_commit("note", true)
		end,
	})
end

-- Nouvelle note attachée à un bloc (à sa droite), ouverte en saisie
function Canvas:_addNoteForBlock(blockId)
	local model = self.getModel()
	if self._destroyed or not model or type(model.addNote) ~= "function" or model:get(blockId) == nil then
		return
	end
	local rect = self:_blockCanvasRect(blockId)
	local x, y
	if rect then
		x = rect.x + rect.w + 40
		y = rect.y
		local view = self.views[model:root(blockId)]
		local info = view and view.blocks and view.blocks[blockId]
		if info and info.ringY then
			y = view.frame.Position.Y.Offset + info.ringY - 4
		end
	else
		local pos = self:_absBlockPos(model, blockId, {}) or Vector2.new(0, 0)
		x, y = pos.X + 240, pos.Y
	end
	local ok, noteId = pcall(model.addNote, model, round(x), round(y), blockId)
	if not ok or noteId == nil then
		self:_status("Impossible d'ajouter une note ici.", "error")
		return
	end
	self._pendingEditNote = noteId
	self:_commit("note")
	self:_status("Note ajoutée : écris ton texte, puis clique ailleurs.", "info")
end

-- Nouvelle note libre à un point de l'écran, ouverte en saisie
function Canvas:_addNoteAt(screenPos)
	local model = self.getModel()
	if self._destroyed or not model or type(model.addNote) ~= "function" then
		return
	end
	local p = screenPos
	if typeof(p) ~= "Vector2" or not self:_overCanvas(p) then
		p = self:_center()
	end
	local c = self:screenToCanvas(p)
	local ok, noteId = pcall(model.addNote, model, round(c.X - 20), round(c.Y - 12), nil)
	if not ok or noteId == nil then
		self:_status("Impossible d'ajouter une note ici.", "error")
		return
	end
	self._pendingEditNote = noteId
	self:_commit("note")
	self:_status("Note ajoutée : écris ton texte, puis clique ailleurs.", "info")
end

-- Menu du clic droit d'une note (SPEC §33)
function Canvas:_noteMenu(noteId)
	if self._destroyed or self._tracking or not self.dialogs then
		return
	end
	local model = self.getModel()
	local note = model and model:getNote(noteId)
	if not note then
		return
	end
	self._kbActive = true
	local colorItems = {}
	for _, couleur in ipairs(NOTE_COLORS) do
		table.insert(colorItems, {
			label = NOTE_COLOR_NAMES[couleur] or couleur,
			value = "couleur:" .. couleur,
			checked = note.couleur == couleur,
		})
	end
	local attached = note.blockId ~= nil and model:get(note.blockId) ~= nil
	local items = {
		{ label = "Écrire dans la note", value = "ecrire", hint = "double-clic" },
		{ label = "Couleur", icon = "●", submenu = colorItems },
		{ label = note.replie and "Déplier la note" or "Replier la note", value = "replier", icon = "−" },
		{ label = "Détacher du bloc", value = "detacher", icon = "←", hidden = not attached },
		{ label = "Dupliquer la note", value = "dupliquer", icon = "＋" },
		"separator",
		{ label = "Supprimer la note", value = "supprimer", icon = "×", danger = true },
	}
	self.dialogs:menu(self:_mouse(), items, function(value)
		if self._destroyed or self.getModel() ~= model or model:getNote(noteId) == nil then
			return
		end
		if value == "ecrire" then
			self:_editNote(noteId)
		elseif type(value) == "string" and string.sub(value, 1, 8) == "couleur:" then
			self:_setNoteFields(noteId, { couleur = string.sub(value, 9) }, "note")
		elseif value == "replier" then
			self:_setNoteFields(noteId, { replie = not note.replie }, "note")
		elseif value == "detacher" then
			if self:_setNoteFields(noteId, { blockId = false }, "note") then
				self:_status("La note n'est plus attachée au bloc.", "info")
			end
		elseif value == "dupliquer" then
			local ok, newId = pcall(model.addNote, model, (tonumber(note.x) or 0) + 24, (tonumber(note.y) or 0) + 24, note.blockId)
			if ok and newId ~= nil then
				pcall(model.setNote, model, newId, { text = note.text or "", couleur = note.couleur, w = note.w })
				self:_commit("note")
			end
		elseif value == "supprimer" then
			self:_removeNote(noteId)
		end
	end)
end

---------------------------------------------------------------------------
-- Centrer sur un bloc (SPEC §18)
---------------------------------------------------------------------------

-- Surbrillance de focusBlock pendant 1 s : elle se pose (108 % -> 100 %) puis s'efface
-- (sans animations : elle reste 1 s puis disparaît)
function Canvas:_flash(rect)
	local w = round(rect.w + 10)
	local h = round(rect.h + 10)
	local f = Util.create("Frame", {
		Name = "Surbrillance",
		BackgroundColor3 = Theme.Colors.Accent,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(round(rect.x - 5) + w / 2, round(rect.y - 5) + h / 2),
		Size = UDim2.fromOffset(w, h),
		ZIndex = Z_FLASH,
		Parent = self.world,
	})
	Util.corner(f, 9)
	local stroke = Util.stroke(f, Theme.Colors.Accent, 3, 0)
	table.insert(self._flashes, f)
	if Anim.enabled() then
		Anim.popIn(f, 1.08)
		Anim.tween(f, { BackgroundTransparency = 1 }, 0.45, "quadIn", nil, 0.55)
		Anim.tween(stroke, { Transparency = 1 }, 0.45, "quadIn", nil, 0.55)
	end
	-- (calé sur la vitesse des animations des réglages : le fondu n'est jamais coupé)
	task.delay(Anim.scaled(1.05), function()
		for i, other in ipairs(self._flashes) do
			if other == f then
				table.remove(self._flashes, i)
				break
			end
		end
		pcall(function()
			f:Destroy()
		end)
	end)
end

-- Déplace la vue pour centrer le bloc puis le met en surbrillance pendant 1 s. Renvoie true si trouvé.
-- rightInset (facultatif) : largeur cachée à droite par un panneau (ex. le détecteur d'erreurs)
function Canvas:focusBlock(blockId, rightInset)
	if self._destroyed or blockId == nil then
		return false
	end
	local rect = self:_blockCanvasRect(blockId)
	if not rect then
		self:refresh()
		rect = self:_blockCanvasRect(blockId)
	end
	if not rect then
		return false
	end
	local size = self.frame.AbsoluteSize
	local inset = math.max(0, tonumber(rightInset) or 0)
	local visibleW = size.X - inset
	if visibleW < 160 then
		visibleW = size.X
	end
	-- zoom visé (un zoom animé peut être en cours) ; la vue glisse en 0,35 s (quintOut)
	local z = self:getZoom()
	-- pour un très grand bloc (bloc C), on centre surtout sa partie haute
	local focusW = math.min(rect.w, visibleW / z * 0.8)
	local focusH = math.min(rect.h, size.Y / z * 0.6)
	local cx = rect.x + focusW / 2
	local cy = rect.y + focusH / 2
	self:_animateView(z, visibleW / 2 - cx * z, size.Y / 2 - cy * z, FOCUS_TIME)
	self:_flash(rect)
	return true
end

---------------------------------------------------------------------------
-- Suivi de la souris (glissements et déplacement de la vue)
---------------------------------------------------------------------------

-- spec = { onMove = fn(p), onEnd = fn(p, how), endType = Enum.UserInputType, sticky = bool,
--          onCancel = fn()? }
-- sticky : le bouton n'est pas enfoncé (copie qui suit la souris, ligne en cours de tracé) ; on termine
-- au prochain clic (Échap ou clic droit : how = "annule"). onCancel : appelé si le suivi est arrêté sans
-- onEnd (_cancelTracking).
function Canvas:_startTracking(spec)
	self:_cancelTracking()
	local layer = self.dragLayer or self.frame
	local overlay = Util.create("TextButton", {
		Name = "SuiviSouris",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_TRACK,
		Parent = layer,
	})
	local t = { overlay = overlay, connections = {}, spec = spec, started = os.clock(), last = nil }
	self._tracking = t

	local function move()
		if self._tracking ~= t then
			return
		end
		local p = self:_mouse()
		if t.last == nil or p ~= t.last then
			t.last = p
			local ok, err = pcall(spec.onMove, p)
			if not ok then
				warn("[Blocs FR] Canvas : " .. tostring(err))
				self:_endTracking(t, "erreur")
			end
		end
	end
	local function finish(how)
		self:_endTracking(t, how)
	end

	local conns = t.connections
	table.insert(conns, overlay.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			move()
		end
	end))
	table.insert(conns, overlay.InputEnded:Connect(function(input)
		if not spec.sticky and input.UserInputType == spec.endType then
			finish("relache")
		end
	end))
	if spec.endType == Enum.UserInputType.MouseButton1 and not spec.sticky then
		table.insert(conns, overlay.MouseButton1Up:Connect(function()
			finish("relache")
		end))
	end
	-- un appui pendant le suivi (relâchement manqué, ou pose d'une copie) termine aussi
	table.insert(conns, overlay.MouseButton1Down:Connect(function()
		if spec.sticky or os.clock() - t.started > 0.15 then
			finish("clic")
		end
	end))
	-- clic droit : pose les blocs tenus ; annule une copie qui suit la souris
	table.insert(conns, overlay.MouseButton2Down:Connect(function()
		if spec.sticky then
			finish("annule")
		else
			finish("clic")
		end
	end))
	-- Échap : annule un suivi « collant » (copie qui suit la souris, ligne en cours de tracé)
	if spec.sticky then
		table.insert(conns, overlay.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
				finish("annule")
			end
		end))
	end
	table.insert(conns, RunService.Heartbeat:Connect(move))
	local widget = self.host and self.host.widget
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(conns, widget.WindowFocusReleased:Connect(function()
				finish("focus")
			end))
		end)
	end
end

function Canvas:_endTracking(t, how)
	if self._tracking ~= t then
		return
	end
	self._tracking = nil
	for _, connection in ipairs(t.connections) do
		connection:Disconnect()
	end
	t.connections = {}
	if t.overlay then
		t.overlay:Destroy()
		t.overlay = nil
	end
	local p = self:_mouse()
	local ok, err = pcall(t.spec.onEnd, p, how)
	if not ok then
		warn("[Blocs FR] Canvas : " .. tostring(err))
		self:_status("Erreur pendant le déplacement des blocs : " .. tostring(err), "error")
		if not self._destroyed then
			self:refresh(true)
		end
	end
end

-- Arrête le suivi sans appeler onEnd (spec.onCancel est appelé s'il existe)
function Canvas:_cancelTracking()
	local t = self._tracking
	if not t then
		return
	end
	self._tracking = nil
	for _, connection in ipairs(t.connections) do
		connection:Disconnect()
	end
	t.connections = {}
	if t.overlay then
		t.overlay:Destroy()
		t.overlay = nil
	end
	if t.spec and type(t.spec.onCancel) == "function" then
		local ok, err = pcall(t.spec.onCancel)
		if not ok then
			warn("[Blocs FR] Canvas : " .. tostring(err))
		end
	end
end

-- clearOnClick : un simple clic (sans déplacement) vide la sélection
function Canvas:_beginPan(buttonType, clearOnClick)
	if self._destroyed or self._tracking then
		return
	end
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	local start = self:_mouse()
	local sx, sy = self.panX, self.panY
	local moved = false
	self:_startTracking({
		endType = buttonType,
		onMove = function(p)
			local delta = p - start
			if delta.Magnitude >= DRAG_THRESHOLD then
				moved = true
			end
			self:_setPan(sx + delta.X, sy + delta.Y)
		end,
		onEnd = function()
			if clearOnClick and not moved then
				self:clearSelection()
			end
		end,
	})
end

-- Appui gauche sur le fond : Maj = rectangle de sélection, sinon déplacement de la vue
function Canvas:_onBackgroundPress()
	if self._destroyed or self._tracking then
		return
	end
	self._kbActive = true
	if self:_modifierHeld("shift") then
		self:_beginRectSelect()
	else
		self:_beginPan(Enum.UserInputType.MouseButton1, true)
	end
end

-- Rectangle de sélection : les blocs qu'il touche s'ajoutent à la sélection
function Canvas:_beginRectSelect()
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	local start = self:_mouse()
	local a = self:screenToCanvas(start)
	local base = {}
	for id in pairs(self.selection) do
		base[id] = true
	end
	local box = self.selectBox
	local function bounds(p)
		local b = self:screenToCanvas(p)
		return math.min(a.X, b.X), math.min(a.Y, b.Y), math.max(a.X, b.X), math.max(a.Y, b.Y)
	end
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			local x0, y0, x1, y1 = bounds(p)
			box.Position = UDim2.fromOffset(round(x0), round(y0))
			box.Size = UDim2.fromOffset(math.max(1, round(x1 - x0)), math.max(1, round(y1 - y0)))
			box.Visible = (p - start).Magnitude >= DRAG_THRESHOLD
		end,
		onEnd = function(p)
			box.Visible = false
			if self._destroyed or (p - start).Magnitude < DRAG_THRESHOLD then
				return
			end
			local x0, y0, x1, y1 = bounds(p)
			local set = {}
			for id in pairs(base) do
				set[id] = true
			end
			for _, view in pairs(self.views) do
				if view.frame then
					local fp = view.frame.Position
					local ox, oy = fp.X.Offset, fp.Y.Offset
					for id, info in pairs(view.blocks or {}) do
						local bx = ox + info.x
						local by = oy + (info.ringY or info.y)
						local bw = info.w
						local bh = info.ringH or info.h
						if bx < x1 and bx + bw > x0 and by < y1 and by + bh > y0 then
							set[id] = true
						end
					end
				end
			end
			self:_setSelection(set)
			local n = setCount(set)
			if n > 0 then
				self:_status(pluralBlocs(n) .. " sélectionné" .. (n > 1 and "s" or "") .. " : clic droit pour les copier, les désactiver…", "info")
			end
		end,
	})
end

-- Touche de modification enfoncée ? kind = "shift" | "ctrl" (Ctrl ou Cmd). Sources : le dernier appui
-- de souris (InputObject:IsModifierKeyDown), les touches suivies par _onInput, UserInputService.
function Canvas:_modifierHeld(kind)
	local input = self._lastPointerInput
	if input and os.clock() - self._lastPointerTime < 0.25 then
		local ok, down = pcall(function()
			if kind == "shift" then
				return input:IsModifierKeyDown(Enum.ModifierKey.Shift)
			end
			return input:IsModifierKeyDown(Enum.ModifierKey.Ctrl) or input:IsModifierKeyDown(Enum.ModifierKey.Meta)
		end)
		if ok and down == true then
			return true
		end
	end
	if kind == "shift" then
		if self._shiftDown then
			return true
		end
		local ok, down = pcall(function()
			return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		end)
		return ok and down == true
	end
	if self._ctrlDown then
		return true
	end
	local ok, down = pcall(function()
		return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	end)
	return ok and down == true
end

---------------------------------------------------------------------------
-- Glisser-déposer des blocs
---------------------------------------------------------------------------

-- Appui sur le corps d'un bloc : glissement après DRAG_THRESHOLD pixels
function Canvas:_onBlockPointerDown(blockId)
	if self._destroyed or self._tracking then
		return
	end
	local model = self.getModel()
	if not model or model:get(blockId) == nil then
		return
	end
	self._kbActive = true
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	local shift = self:_modifierHeld("shift")
	local start = self:_mouse()
	local pending = { blockId = blockId, model = model, start = start }
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			if self.drag then
				self:_updateDrag(p)
			elseif (p - start).Magnitude >= DRAG_THRESHOLD then
				self:_startBlockDrag(pending, p)
			end
		end,
		onEnd = function(p, how)
			if self.drag then
				self:_finishDrag(p, how)
			else
				-- simple clic : sélectionne ce bloc (Maj : l'ajoute / le retire de la sélection)
				if self.getModel() == model and model:get(blockId) ~= nil then
					if shift then
						self:_toggleSelected(blockId)
					else
						self:select({ blockId }, false)
					end
				end
				-- la pile passe devant les autres (affichage seulement)
				local rootId = model:root(blockId)
				local view = rootId and self.views[rootId]
				if view and view.frame then
					self._frontZ = (self._frontZ or FRONT_Z0) + 1
					view.frame.ZIndex = self._frontZ
				end
			end
		end,
	})
end

function Canvas:_startBlockDrag(pending, p)
	local model = pending.model
	if model ~= self.getModel() or model:get(pending.blockId) == nil then
		self:_cancelTracking()
		return
	end
	local blockId = pending.blockId
	local rect = self:_blockCanvasRect(blockId)
	if not rect then
		local root = model:get(model:root(blockId))
		rect = { x = root and root.x or 0, y = root and root.y or 0, w = 0, h = 0 }
	end
	local blockScreen = self:canvasToScreen(Vector2.new(rect.x, rect.y))
	-- point saisi, en unités du canvas (la pile reste accrochée à la souris par ce point)
	local grab = (pending.start - blockScreen) / self.zoom

	-- notes : position des blocs avant le glissement (elles suivront leur bloc au commit)
	local anchors = self:_captureNoteAnchors(model)
	-- glisser un bloc sélectionné emmène aussi les autres piles entièrement sélectionnées (SPEC §32)
	local otherRoots = {}
	if self.selection[blockId] then
		otherRoots = self:_fullySelectedStacks(model, model:root(blockId))
	end

	if model:isTop(blockId) then
		model:bringToFront(blockId)
	else
		model:detach(blockId)
	end
	model:moveTo(blockId, round(rect.x), round(rect.y))

	local d = {
		model = model,
		rootId = blockId,
		grab = grab,
		isNew = false,
		reason = "deplacer",
		anchors = anchors,
		startX = rect.x,
		startY = rect.y,
		others = {},
		otherRoots = {},
		idSet = {},
	}
	local okIds, ids = pcall(model.stackIds, model, blockId)
	if okIds and type(ids) == "table" then
		for _, id in ipairs(ids) do
			d.idSet[id] = true
		end
	end
	for _, rootId in ipairs(otherRoots) do
		local block = model:get(rootId)
		if block then
			table.insert(d.others, { id = rootId, x = tonumber(block.x) or 0, y = tonumber(block.y) or 0 })
			d.otherRoots[rootId] = true
			local okOther, otherIds = pcall(model.stackIds, model, rootId)
			if okOther and type(otherIds) == "table" then
				for _, id in ipairs(otherIds) do
					d.idSet[id] = true
				end
			end
		end
	end
	self.drag = d
	self:refresh(true) -- le reste de la pile se referme
	self:_createDragVisual(d)
	self:_updateDrag(p)
end

-- Bloc venant de la palette. grabOffset = souris - coin haut-gauche du prototype (pixels, échelle 1)
function Canvas:beginPaletteDrag(defId, presetInputs, grabOffset)
	if self._destroyed then
		return
	end
	if self.drag then
		self:_abortDrag()
	end
	self:_cancelTracking()
	local model = self.getModel()
	if not model then
		return
	end
	-- nombre de variables avant la création (un bloc variable peut créer « ma variable »)
	local varCount = nil
	if type(model.variables) == "table" then
		varCount = #model.variables
	end
	-- (un bloc inséré au milieu d'une pile pousse les blocs suivants : leurs notes suivront)
	local anchors = self:_captureNoteAnchors(model)
	local id = model:create(defId, 0, 0, presetInputs)
	if id == nil then
		self:_status("Bloc inconnu : " .. tostring(defId), "error")
		return
	end
	-- grabOffset est à l'échelle 1 : c'est déjà le point saisi en unités du canvas
	local grab = Vector2.new(10, 10)
	if typeof(grabOffset) == "Vector2" then
		grab = grabOffset
	end
	local d = {
		model = model,
		rootId = id,
		grab = grab,
		isNew = true,
		reason = "ajouter",
		varCount = varCount,
		anchors = anchors,
	}
	self.drag = d
	self:_createDragVisual(d)
	self:_updateDrag(self:_mouse())
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			self:_updateDrag(p)
		end,
		onEnd = function(p, how)
			self:_finishDrag(p, how)
		end,
	})
end

-- Copie qui suit la souris jusqu'au prochain clic (menu « Dupliquer »)
function Canvas:_beginStickyDrag(model, rootId)
	if self._destroyed then
		return
	end
	self:_cancelTracking()
	local grab = Vector2.new(18, 14) -- unités du canvas
	local d = {
		model = model,
		rootId = rootId,
		grab = grab,
		isNew = true,
		reason = "dupliquer",
		anchors = self:_captureNoteAnchors(model),
	}
	self.drag = d
	self:_createDragVisual(d)
	self:_updateDrag(self:_mouse())
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		sticky = true,
		onMove = function(p)
			self:_updateDrag(p)
		end,
		onEnd = function(p, how)
			self:_finishDrag(p, how)
		end,
	})
	self:_status("Clique dans la zone de travail pour poser la copie (clic droit : annuler).", "info")
end

-- Coin haut-gauche (écran) de la pile glissée posée : la souris moins le point saisi
function Canvas:_dragTopLeft(d, p)
	return p - d.grab * self.zoom
end

-- Échelle et position de la pile glissée : zoom du canvas × soulèvement (105 %), le point saisi
-- restant sous la souris. p = position de la souris (sinon la dernière connue).
function Canvas:_placeDragVisual(d, p)
	if not d or not d.container then
		return
	end
	if typeof(p) == "Vector2" then
		d.lastP = p
	else
		p = d.lastP
	end
	local lift = d.lift or 1
	if d.scale then
		d.scale.Scale = self.zoom * lift
	end
	if typeof(p) ~= "Vector2" then
		return
	end
	local layer = self.dragLayer or self.frame
	local origin = layer.AbsolutePosition
	local topLeft = p - d.grab * (self.zoom * lift)
	d.container.Position = UDim2.fromOffset(round(topLeft.X - origin.X), round(topLeft.Y - origin.Y))
end

function Canvas:_createDragVisual(d)
	local layer = self.dragLayer or self.frame
	local container = Util.create("Frame", {
		Name = "BlocsGlisses",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = Z_DRAG,
		Parent = layer,
	})
	d.lift = 1
	d.scale = Util.create("UIScale", { Scale = self.zoom, Parent = container })
	local ok, view = pcall(Renderer.renderStack, d.model, d.rootId, container, {
		interactive = false,
		callbacks = {
			getVariables = function()
				return d.model.variables or {}
			end,
		},
	})
	if ok and type(view) == "table" and view.frame then
		view.frame.Position = UDim2.fromOffset(0, 0)
		view.frame.ZIndex = 2
		d.view = view
		d.w = view.width
		d.h = view.height
		local head = view.blocks and view.blocks[d.rootId]
		d.headW = (head and head.w) or view.width
		d.headH = (head and head.h) or view.height
	else
		warn("[Blocs FR] Canvas : impossible de dessiner les blocs glissés : " .. tostring(view))
		local okMeasure, w, h = pcall(Renderer.measure, d.model, d.rootId)
		if not okMeasure then
			w, h = 120, 40
		end
		d.w, d.h, d.headW, d.headH = w, h, w, h
	end
	-- ombre douce sous la pile glissée : elle apparaît pendant que la pile se soulève (0,1 s)
	local shadow = Util.create("Frame", {
		Name = "Ombre",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(d.w, d.h),
		ZIndex = 1,
		Parent = container,
	})
	Util.corner(shadow, 8)
	d.container = container
	Anim.tween(shadow, { BackgroundTransparency = 0.55, Position = UDim2.fromOffset(0, 10) }, LIFT_TIME, "quadOut")
	-- soulèvement 100 % -> 105 % autour du point saisi (animations désactivées : 105 % tout de suite)
	d.liftHandle = Anim.step(function(k)
		d.lift = 1 + (LIFT_SCALE - 1) * k
		self:_placeDragVisual(d)
	end, LIFT_TIME, "quadOut")

	-- étiquette « supprimer » au-dessus de la palette
	local trashText = "×  Relâche pour supprimer"
	local tw = Util.textSize(trashText, 12, Theme.Fonts.UIBold).X
	d.trash = Util.create("TextLabel", {
		Name = "Supprimer",
		Text = trashText,
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextColor3 = WHITE,
		BackgroundColor3 = Theme.Colors.Danger,
		BorderSizePixel = 0,
		Active = false,
		Visible = false,
		Size = UDim2.fromOffset(math.ceil(tw) + 22, 24),
		ZIndex = Z_DRAG + 50,
		Parent = layer,
	})
	Util.corner(d.trash, 12)
	self.emptyState.Visible = false
end

function Canvas:_destroyDragVisual(d)
	if d.liftHandle then
		d.liftHandle:cancel()
		d.liftHandle = nil
	end
	if d.view then
		pcall(function()
			d.view:destroy()
		end)
		d.view = nil
	end
	if d.container then
		d.container:Destroy()
		d.container = nil
	end
	d.scale = nil
	if d.trash then
		d.trash:Destroy()
		d.trash = nil
	end
	self:_hideGhost()
	self:_setDeleteHint(false)
end

-- Blocs existants lâchés sur la palette : on garde leur dessin pour l'animation de suppression
-- (voir Canvas:_vanish). Renvoie nil s'il n'y a rien à animer.
function Canvas:_takeDragVisual(d, p)
	if not d.container then
		return nil
	end
	local lift = d.lift or 1
	local visual = {
		container = d.container,
		view = d.view,
		scale = d.scale,
		layer = self.dragLayer or self.frame,
		point = p,
		grab = d.grab * (self.zoom * lift), -- point saisi, en pixels, à l'échelle affichée
		scale0 = self.zoom * lift,
		color = self:_blockColor(d.model, d.rootId),
	}
	if d.liftHandle then
		d.liftHandle:cancel()
		d.liftHandle = nil
	end
	d.container = nil
	d.view = nil
	d.scale = nil
	return visual
end

-- Détruit un dessin gardé par _takeDragVisual
local function dropVisual(visual)
	if type(visual) ~= "table" then
		return
	end
	local view = visual.view
	visual.view = nil
	if view then
		pcall(function()
			view:destroy()
		end)
	end
	local container = visual.container
	visual.container = nil
	if container then
		pcall(function()
			container:Destroy()
		end)
	end
end

-- La pile supprimée rétrécit vers la souris (100 % -> 20 %, 0,18 s) puis éclate en confettis
function Canvas:_vanish(visual)
	if type(visual) ~= "table" or not visual.container then
		return
	end
	local layer = visual.layer
	local p = visual.point
	local origin = layer.AbsolutePosition
	local function cleanup()
		dropVisual(visual)
	end
	Anim.step(function(k)
		local container = visual.container
		if not container then
			return
		end
		local f = 1 - 0.8 * k
		if visual.scale then
			visual.scale.Scale = visual.scale0 * f
		end
		local topLeft = p - visual.grab * f
		container.Position = UDim2.fromOffset(round(topLeft.X - origin.X), round(topLeft.Y - origin.Y))
	end, SHRINK_TIME, "quadIn", function()
		cleanup()
		Anim.poof(layer, p, visual.color)
	end)
end

-- Couleur de la catégorie d'un bloc (confettis), bleu par défaut
function Canvas:_blockColor(model, blockId)
	local color = nil
	pcall(function()
		local def = model:def(blockId)
		if def then
			color = Registry.color(def)
		end
	end)
	if typeof(color) == "Color3" then
		return color
	end
	return Theme.Colors.Accent
end

-- Éclair blanc (Anim.flash : contour de 3 px qui s'élargit en s'effaçant, petit rebond) sur les
-- blocs qui viennent de s'accrocher. ids = blocs de la pile glissée (dessinés après le commit).
function Canvas:_flashBlocks(model, ids)
	if self._destroyed or not Anim.enabled() or type(ids) ~= "table" or model ~= self.getModel() then
		return
	end
	local count = 0
	for _, id in ipairs(ids) do
		if count >= FLASH_MAX then
			break
		end
		local rootId = model:root(id)
		local view = rootId and self.views[rootId]
		local info = view and view.blocks and view.blocks[id]
		if info and view.frame then
			count += 1
			local x = tonumber(info.x) or 0
			local y = tonumber(info.ringY) or tonumber(info.y) or 0
			local w = tonumber(info.w) or 40
			local h = tonumber(info.ringH) or tonumber(info.h) or 36
			local radius = Theme.Block.Corner or 6
			if info.shape == "reporter" or info.shape == "boolean" then
				radius = math.floor(h / 2)
			end
			-- ancré au centre : le rebond (UIScale) se fait autour du bloc
			local overlay = Util.create("Frame", {
				Name = "AnimAccroche",
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x + w / 2, y + h / 2),
				Size = UDim2.fromOffset(w, h),
				ZIndex = Z_SNAP_FLASH,
				Parent = view.frame,
			})
			Util.corner(overlay, radius)
			Anim.flash(overlay, function()
				pcall(function()
					overlay:Destroy()
				end)
			end)
		end
	end
end

-- Glissement depuis la palette annulé : retire les variables créées par le nouveau bloc
-- (« ma variable ») qui ne servent plus à aucun bloc.
function Canvas:_dropNewVariables(d)
	local model = d.model
	local count = d.varCount
	local vars = model and model.variables
	if type(count) ~= "number" or type(vars) ~= "table" then
		return
	end
	for i = #vars, count + 1, -1 do
		local ok, uses = pcall(model.countVariableUses, model, vars[i])
		if ok and uses == 0 then
			table.remove(vars, i)
		end
	end
end

-- Vrai si une modification de champ est arrivée pendant le glissement d (voir _onInputCommit) ;
-- elle doit alors être enregistrée avec le résultat du glissement.
function Canvas:_takeFieldCommit(d)
	local pending = self._pendingFieldCommit
	self._pendingFieldCommit = nil
	return pending ~= nil and pending == d.model
end

-- Abandonne un glissement sans rien appliquer (modèle remplacé, destruction…)
function Canvas:_abortDrag()
	local d = self.drag
	if not d then
		return
	end
	self.drag = nil
	local fieldPending = self:_takeFieldCommit(d)
	self:_cancelTracking()
	self:_destroyDragVisual(d)
	local current = d.model == self.getModel()
	if d.isNew and current and d.model:get(d.rootId) ~= nil then
		pcall(function()
			d.model:delete(d.rootId)
			self:_dropNewVariables(d)
		end)
	end
	if not self._destroyed then
		if fieldPending and current then
			self:_commit("modifier", true)
		else
			self:refresh(true)
		end
	end
end

function Canvas:_updateDrag(p)
	local d = self.drag
	if not d or not d.container then
		return
	end
	if d.model ~= self.getModel() then
		self:_abortDrag()
		return
	end
	local layer = self.dragLayer or self.frame
	local origin = layer.AbsolutePosition
	self:_placeDragVisual(d, p)
	local topLeft = self:_dragTopLeft(d, p)

	-- autres piles sélectionnées : elles suivent du même décalage (seulement leur dessin)
	if d.others and #d.others > 0 and d.startX then
		local c = self:screenToCanvas(topLeft)
		local dx, dy = c.X - d.startX, c.Y - d.startY
		for _, other in ipairs(d.others) do
			local view = self.views[other.id]
			if view and view.frame then
				view.frame.Position = UDim2.fromOffset(round(other.x + dx), round(other.y + dy))
			end
		end
	end

	local overPalette = self:_overPalette(p)
	d.overPalette = overPalette
	local deleting = overPalette and not d.isNew
	if d.trash then
		local wasVisible = d.trash.Visible
		d.trash.Visible = deleting
		d.trash.Position = UDim2.fromOffset(round(p.X - origin.X + 14), round(p.Y - origin.Y - 32))
		if deleting and not wasVisible then
			Anim.popIn(d.trash, 0.8)
		end
	end
	-- la palette rougit pendant que des blocs existants passent au-dessus
	self:_setDeleteHint(deleting)

	local target = nil
	if not overPalette and self:_overCanvas(p) then
		target = self:_findTarget(d, self:screenToCanvas(topLeft))
	end
	d.target = target
	self:_showGhost(d, target)
end

-- Vérifie avec le modèle qu'un assemblage est permis
function Canvas:_canApply(model, t, rootId)
	local result = false
	local ok = pcall(function()
		if t.kind == "next" then
			result = model:canAttachNext(t.blockId, rootId)
		elseif t.kind == "sub" then
			result = model:canAttachSub(t.blockId, t.slot, rootId)
		elseif t.kind == "input" then
			result = model:canAttachInput(t.blockId, t.input, rootId)
		elseif t.kind == "above" then
			result = model:canAttachAbove(t.blockId, rootId)
		end
	end)
	return ok and result == true
end

-- Meilleure cible d'aimantation pour la pile glissée dont le coin haut-gauche est pos (canvas)
function Canvas:_findTarget(d, pos)
	local model = d.model
	local def = model:def(d.rootId)
	if def == nil then
		return nil
	end
	local shape = def.shape
	local isValue = shape == "reporter" or shape == "boolean"
	local isHat = shape == "hat"
	local h = d.h or 0
	local snap = snapDistance() -- aimant des réglages (lu à chaque fois)
	local candidates = {}
	for rootId, view in pairs(self.views) do
		-- (les autres piles sélectionnées bougent avec la pile glissée : pas de cible chez elles)
		if not (d.otherRoots and d.otherRoots[rootId]) and view.frame then
			local fp = view.frame.Position
			local ox, oy = fp.X.Offset, fp.Y.Offset
			for _, t in ipairs(view.targets or {}) do
				local score = nil
				if isValue then
					if t.kind == "input" then
						-- point milieu-gauche de la valeur glissée, dans (ou près de) la case
						local px, py = pos.X, pos.Y + h / 2
						local tx, ty = ox + t.x, oy + t.y
						local dx = math.max(tx - px, 0, px - (tx + t.w))
						local dy = math.max(ty - py, 0, py - (ty + t.h))
						if dx <= snap * 0.75 and dy <= snap * 0.5 then
							score = dx + dy + t.w * 0.001
							if (shape == "boolean") ~= (t.boolean == true) then
								score += 4 -- préfère les cases du même type
							end
						end
					end
				elseif t.kind == "above" then
					-- coin bas-gauche de la pile glissée sur le haut de la pile cible
					local dx = pos.X - (ox + t.x)
					local dy = pos.Y + h - (oy + t.y)
					local dist = math.sqrt(dx * dx + dy * dy)
					if dist <= snap then
						score = dist
					end
				elseif not isHat and (t.kind == "next" or t.kind == "sub") then
					local dx = pos.X - (ox + t.x)
					local dy = pos.Y - (oy + t.y)
					local dist = math.sqrt(dx * dx + dy * dy)
					if dist <= snap then
						score = dist
					end
				end
				if score then
					table.insert(candidates, { t = t, score = score, ox = ox, oy = oy })
				end
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	table.sort(candidates, function(a, b)
		return a.score < b.score
	end)
	for _, c in ipairs(candidates) do
		local t = c.t
		if self:_canApply(model, t, d.rootId) then
			return {
				kind = t.kind,
				blockId = t.blockId,
				slot = t.slot,
				input = t.input,
				boolean = t.boolean,
				x = c.ox + t.x,
				y = c.oy + t.y,
				w = t.w,
				h = t.h,
			}
		end
	end
	return nil
end

-- Cache le fantôme d'aimantation (et arrête sa respiration)
function Canvas:_hideGhost()
	local stop = self._ghostPulse
	self._ghostPulse = nil
	if stop then
		pcall(stop)
	end
	if self.ghost then
		self.ghost.Visible = false
	end
end

function Canvas:_showGhost(d, target)
	if not target then
		self:_hideGhost()
		return
	end
	local x, y, w, h, r
	if target.kind == "input" then
		x, y, w, h = target.x, target.y, target.w or 20, target.h or 20
		r = math.floor(h / 2)
	elseif target.kind == "above" then
		x, y, w, h = target.x, target.y - (d.h or 0), d.w or 40, d.h or 36
		r = 6
	else
		x, y, w, h = target.x, target.y, d.headW or d.w or 40, d.headH or d.h or 36
		r = 6
	end
	self.ghost.Position = UDim2.fromOffset(round(x), round(y))
	self.ghost.Size = UDim2.fromOffset(math.max(4, math.ceil(w)), math.max(4, math.ceil(h)))
	self.ghostCorner.CornerRadius = UDim.new(0, r)
	self.ghost.Visible = true
	-- le contour du fantôme respire tant qu'il est affiché
	if self._ghostPulse == nil and self.ghostStroke then
		self._ghostPulse = Anim.pulse(self.ghostStroke, 0.05, 0.75, GHOST_PERIOD)
	end
end

-- Position (canvas) ramenée dans la partie visible de la zone de travail
function Canvas:_clampToView(pos, w, h)
	local o = self.frame.AbsolutePosition
	local a = self:screenToCanvas(o)
	local b = self:screenToCanvas(o + self.frame.AbsoluteSize)
	local minX, minY = a.X + 10, a.Y + 10
	local maxX = math.max(minX, b.X - math.min(w or 100, 140))
	local maxY = math.max(minY, b.Y - math.min(h or 40, 60))
	return Vector2.new(Util.clamp(pos.X, minX, maxX), Util.clamp(pos.Y, minY, maxY))
end

function Canvas:_applyTarget(model, d, target)
	local ok = false
	if target.kind == "next" then
		ok = model:attachNext(target.blockId, d.rootId)
	elseif target.kind == "sub" then
		ok = model:attachSub(target.blockId, target.slot, d.rootId)
	elseif target.kind == "input" then
		ok = model:attachInput(target.blockId, target.input, d.rootId)
	elseif target.kind == "above" then
		local head = model:get(target.blockId)
		if head then
			ok = model:attachAbove(target.blockId, d.rootId, head.x, round(head.y - (d.h or 0)))
		end
	end
	if ok then
		model:bringToFront(d.rootId)
	end
	return ok == true
end

-- Relâchement : supprime (au-dessus de la palette), assemble (aimantation) ou déplace, puis commit
function Canvas:_finishDrag(p, how)
	local d = self.drag
	if not d then
		return
	end
	self.drag = nil
	local fieldPending = self:_takeFieldCommit(d)
	local model = d.model
	-- blocs existants lâchés sur la palette : leur dessin est gardé pour l'animation de suppression
	local vanishing = nil
	if not self._destroyed and how ~= "focus" and not d.isNew and model == self.getModel() then
		if model:get(d.rootId) ~= nil and self:_overPalette(p) then
			vanishing = self:_takeDragVisual(d, p)
		end
	end
	self:_destroyDragVisual(d)
	if self._destroyed then
		return
	end
	-- fin sans commit du glissement : enregistre seule la modification de champ en attente
	local function settle()
		if fieldPending and model == self.getModel() then
			self:_commit("modifier", true)
		else
			self:refresh(true)
		end
	end
	if model ~= self.getModel() or model:get(d.rootId) == nil then
		dropVisual(vanishing)
		settle()
		return
	end

	if how == "annule" and d.isNew then
		-- copie abandonnée (clic droit)
		model:delete(d.rootId)
		self:_dropNewVariables(d)
		settle()
		self:_status("Copie annulée.", "info")
		return
	end

	if how ~= "focus" and self:_overPalette(p) then
		model:delete(d.rootId)
		if d.isNew then
			self:_dropNewVariables(d)
			settle()
		else
			-- les autres piles sélectionnées qui suivaient partent aussi
			for _, other in ipairs(d.others or {}) do
				if model:get(other.id) ~= nil then
					model:delete(other.id)
				end
			end
			self:_followNotes(model, d.anchors)
			self:_commit("supprimer", true)
			if self.dialogs then
				self.dialogs:toast("Blocs supprimés", "info")
			end
			-- la pile rétrécit puis éclate en confettis
			self:_vanish(vanishing)
			vanishing = nil
		end
		dropVisual(vanishing)
		return
	end
	dropVisual(vanishing) -- (jamais gardé hors de la palette ; par sécurité)

	local topLeft = self:screenToCanvas(self:_dragTopLeft(d, p))
	local overCanvas = self:_overCanvas(p)
	if not overCanvas then
		if d.isNew then
			-- nouveau bloc lâché hors de la zone de travail : annulé
			model:delete(d.rootId)
			self:_dropNewVariables(d)
			settle()
			return
		end
		topLeft = self:_clampToView(topLeft, d.w, d.h)
	end

	local applied = false
	-- blocs de la pile glissée (avant l'assemblage, qui leur ajoute la suite de la cible)
	local dragged = nil
	if overCanvas then
		local target = self:_findTarget(d, topLeft)
		if target then
			dragged = model:chain(d.rootId)
			applied = self:_applyTarget(model, d, target)
		end
	end
	if not applied then
		model:moveTo(d.rootId, round(topLeft.X), round(topLeft.Y))
	end
	-- autres piles sélectionnées : même décalage que la pile glissée (sans aimantation)
	if d.others and #d.others > 0 and d.startX then
		local dx, dy = topLeft.X - d.startX, topLeft.Y - d.startY
		for _, other in ipairs(d.others) do
			if model:get(other.id) ~= nil and model:isTop(other.id) then
				model:moveTo(other.id, round(other.x + dx), round(other.y + dy))
			end
		end
	end
	-- les notes suivent leurs blocs (même étape d'annulation)
	self:_followNotes(model, d.anchors)
	self:_commit(d.reason or "deplacer", true)
	if applied and dragged then
		-- éclair blanc sur les blocs qui viennent de s'accrocher (dessinés par le commit)
		self:_flashBlocks(model, dragged)
	end
end

---------------------------------------------------------------------------
-- Édition des champs
---------------------------------------------------------------------------

-- srcModel : modèle qui a dessiné le champ (fourni par Renderer)
function Canvas:_onInputCommit(blockId, inputName, value, srcModel)
	-- différé : ne jamais redessiner (détruire un TextBox) pendant son propre FocusLost
	task.defer(function()
		if self._destroyed then
			return
		end
		local model = self.getModel()
		if not model or model:get(blockId) == nil then
			return
		end
		if srcModel ~= nil and srcModel ~= model then
			-- un autre projet a été ouvert entre-temps : le même id y désigne un autre bloc
			return
		end
		local ok = false
		pcall(function()
			ok = model:setInput(blockId, inputName, value)
		end)
		if ok then
			local d = self.drag
			if d and d.model == model then
				-- glissement en cours (bloc pas encore posé, sans commit) : la modification sera
				-- enregistrée avec le résultat du glissement (_finishDrag / _abortDrag)
				self._pendingFieldCommit = model
				return
			end
			self:_commit("modifier")
		else
			self:_status("Valeur invalide pour ce champ.", "warning")
			self:refresh()
		end
	end)
end

---------------------------------------------------------------------------
-- Menus du clic droit
---------------------------------------------------------------------------

-- Aide rapide sur un bloc : son explication dans une fenêtre (« Ouvrir dans le wiki » a sa propre ligne)
function Canvas:_showHelp(def)
	if def == nil or not self.dialogs then
		return
	end
	local text = def.tooltip
	if type(text) ~= "string" or text == "" then
		text = "Pas d'explication disponible pour ce bloc."
	end
	local title = def.id
	pcall(function()
		title = Registry.plainLabel(def)
	end)
	self.dialogs:alert(title, text .. "\n\nPour tout savoir sur ce bloc : clic droit → « Ouvrir dans le wiki ».")
end

-- « Ouvrir dans le wiki » : deps.openWiki(defId), sinon deps.openHelp(defId), sinon host.openWiki
function Canvas:_openWiki(defId)
	local fn = self.deps.openWiki
	if type(fn) == "function" then
		local ok = pcall(fn, defId)
		if ok then
			return true
		end
	end
	if defId ~= nil and type(self.deps.openHelp) == "function" then
		local ok = pcall(self.deps.openHelp, defId)
		if ok then
			return true
		end
	end
	local hostOpen = self.host and self.host.openWiki
	if type(hostOpen) == "function" then
		local ok, shown = pcall(hostOpen, nil, defId)
		if ok and shown ~= false then
			return true
		end
	end
	self:_status("Le wiki n'est pas disponible pour le moment.", "warning")
	return false
end

-- Appelle un rappel facultatif de l'App (deps[name]) ; true s'il existe et n'a pas échoué
function Canvas:_callDep(name, ...)
	local fn = self.deps[name]
	if type(fn) ~= "function" then
		return false
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Blocs FR] Canvas : " .. tostring(name) .. " : " .. tostring(err))
		self:_status("Action impossible : " .. tostring(err), "error")
	end
	return ok
end

-- Favoris (SPEC §32) : deps.isFavorite / deps.toggleFavorite, sinon Reglages
function Canvas:_isFavorite(defId)
	local fn = self.deps.isFavorite
	if type(fn) == "function" then
		local ok, yes = pcall(fn, defId)
		if ok then
			return yes == true
		end
	end
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.isFavorite) == "function" then
		local ok, yes = pcall(Reglages.isFavorite, defId)
		if ok then
			return yes == true
		end
	end
	return false
end

function Canvas:_canFavorite()
	if type(self.deps.toggleFavorite) == "function" then
		return true
	end
	local Reglages = optionalModule("Reglages")
	return Reglages ~= nil and type(Reglages.toggleFavorite) == "function"
end

function Canvas:_toggleFavorite(defId)
	if type(defId) ~= "string" then
		return
	end
	local was = self:_isFavorite(defId)
	local ok = false
	if type(self.deps.toggleFavorite) == "function" then
		ok = pcall(self.deps.toggleFavorite, defId)
	else
		local Reglages = optionalModule("Reglages")
		if Reglages and type(Reglages.toggleFavorite) == "function" then
			ok = pcall(Reglages.toggleFavorite, self.host, defId)
		end
	end
	if not ok then
		self:_status("Impossible de changer les favoris.", "error")
		return
	end
	if self.dialogs then
		if was then
			self.dialogs:toast("Retiré des favoris", "info")
		else
			self.dialogs:toast("Ajouté aux favoris : il est en haut de la palette", "success")
		end
	end
end

-- Bloc de combat que le prévisualiseur de hitbox sait montrer (SPEC §27) : deps.canPreviewHitbox,
-- sinon HitboxPreview.supports, sinon la liste connue
function Canvas:_supportsHitbox(defId)
	if type(defId) ~= "string" then
		return false
	end
	local fn = self.deps.canPreviewHitbox
	if type(fn) == "function" then
		local ok, yes = pcall(fn, defId)
		if ok and type(yes) == "boolean" then
			return yes
		end
	end
	local HitboxPreview = optionalModule("HitboxPreview")
	if HitboxPreview and type(HitboxPreview.supports) == "function" then
		local ok, yes = pcall(HitboxPreview.supports, defId)
		if ok then
			return yes == true
		end
	end
	return HITBOX_BLOCKS[defId] == true
end

---------------------------------------------------------------------------
-- Copier / couper / coller, dupliquer, supprimer, désactiver (SPEC §32)
---------------------------------------------------------------------------

function Canvas:_readClipboardRaw()
	local getter = self.host and self.host.getSetting
	if type(getter) == "function" then
		local ok, value = pcall(getter, CLIPBOARD_KEY)
		if ok and type(value) == "string" and value ~= "" then
			return value
		end
	end
	return memoryClipboard
end

function Canvas:_hasClipboard()
	local raw = self:_readClipboardRaw()
	return type(raw) == "string" and string.sub(raw, 1, 1) == "{"
end

function Canvas:_readClipboard()
	local raw = self:_readClipboardRaw()
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" and type(data.blocks) == "table" then
		return data
	end
	return nil
end

-- Presse-papiers partagé entre les scripts et les sessions (réglage du plugin) + copie en mémoire
function Canvas:_writeClipboard(data)
	local ok, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok or type(json) ~= "string" then
		return false
	end
	memoryClipboard = json
	local setter = self.host and self.host.setSetting
	if type(setter) == "function" then
		pcall(setter, CLIPBOARD_KEY, json)
	end
	return true
end

-- Blocs à copier d'un ensemble { [id] = true } : des chaînes de blocs sélectionnés qui se suivent
-- (« unités ») ; le contenu d'un bloc (entrées, corps) vient toujours avec lui, et un bloc placé dans
-- le contenu d'un bloc sélectionné n'est pas copié une deuxième fois.
function Canvas:_unitsOf(model, idSet)
	local function covered(id)
		local current = model:get(id)
		local steps = 0
		while current and current.parent ~= nil and steps < 100000 do
			local slot = current.slot
			if idSet[current.parent] and type(slot) == "table" and slot.kind ~= "next" then
				return true
			end
			current = model:get(current.parent)
			steps += 1
		end
		return false
	end
	local heads = {}
	for id in pairs(idSet) do
		local block = model:get(id)
		if block and not covered(id) then
			local slot = block.slot
			local continues = block.parent ~= nil and type(slot) == "table" and slot.kind == "next" and idSet[block.parent]
			if not continues then
				table.insert(heads, id)
			end
		end
	end
	table.sort(heads)
	local units = {}
	for _, head in ipairs(heads) do
		local chain = { head }
		local current = model:get(head)
		local guard = 0
		while current and current.next ~= nil and idSet[current.next] and guard < 100000 do
			table.insert(chain, current.next)
			current = model:get(current.next)
			guard += 1
		end
		table.insert(units, chain)
	end
	return units
end

-- Unités de la sélection, ou d'un bloc (lui + sa suite) quand il n'est pas sélectionné avec d'autres
function Canvas:_unitsFor(model, blockId)
	if blockId == nil or (self.selection[blockId] and setCount(self.selection) >= 2) then
		return self:_unitsOf(model, self.selection)
	end
	if model:get(blockId) == nil then
		return {}
	end
	return { model:chain(blockId) }
end

-- Données (format de sérialisation, SPEC §6) de plusieurs unités, placées par rapport au coin
-- haut-gauche de l'ensemble. Renvoie data, origine (Vector2, unités du canvas), nombre de blocs.
function Canvas:_exportUnits(model, units)
	if type(model.exportStack) ~= "function" or #units == 0 then
		return nil
	end
	local cache = {}
	local heads = {}
	local minX, minY = math.huge, math.huge
	for _, chain in ipairs(units) do
		local head = chain[1]
		local pos = self:_absBlockPos(model, head, cache)
		if pos == nil then
			local block = model:get(head)
			pos = Vector2.new(tonumber(block and block.x) or 0, tonumber(block and block.y) or 0)
		end
		table.insert(heads, { id = head, chain = chain, pos = pos })
		minX = math.min(minX, pos.X)
		minY = math.min(minY, pos.Y)
	end
	table.sort(heads, function(a, b)
		if a.pos.Y ~= b.pos.Y then
			return a.pos.Y < b.pos.Y
		end
		return a.pos.X < b.pos.X
	end)
	local data = {
		format = "BlocsFR",
		version = 1,
		mode = model.mode,
		variables = {},
		tops = {},
		blocks = {},
	}
	local varSeen = {}
	local notes = nil
	local count = 0
	for _, h in ipairs(heads) do
		table.insert(data.tops, h.id)
		for i, id in ipairs(h.chain) do
			local ok, part = pcall(model.exportStack, model, id, true)
			if ok and type(part) == "table" and type(part.blocks) == "table" then
				for bid, entry in pairs(part.blocks) do
					if data.blocks[bid] == nil then
						count += 1
					end
					data.blocks[bid] = entry
				end
				for _, name in ipairs(part.variables or {}) do
					if not varSeen[name] then
						varSeen[name] = true
						table.insert(data.variables, name)
					end
				end
				if type(part.notes) == "table" then
					for noteId, n in pairs(part.notes) do
						local src = model:getNote(noteId)
						if src then
							n.x = round((tonumber(src.x) or 0) - minX)
							n.y = round((tonumber(src.y) or 0) - minY)
						end
						notes = notes or {}
						notes[noteId] = n
					end
				end
			end
			if i > 1 and data.blocks[h.chain[i - 1]] ~= nil then
				data.blocks[h.chain[i - 1]].next = id
			end
		end
		local entry = data.blocks[h.id]
		if entry then
			entry.x = round(h.pos.X - minX)
			entry.y = round(h.pos.Y - minY)
		end
	end
	if notes then
		data.notes = notes
	end
	-- lignes tracées à la main entre deux blocs copiés (SPEC §36 : importData leur donne de nouveaux ids)
	if type(model.liens) == "table" then
		for linkId, link in pairs(model.liens) do
			if type(link) == "table" and data.blocks[link.de] ~= nil and data.blocks[link.vers] ~= nil then
				data.liens = data.liens or {}
				data.liens[linkId] = {
					de = link.de,
					vers = link.vers,
					texte = link.texte,
					style = link.style,
					couleur = link.couleur,
				}
			end
		end
	end
	if count == 0 then
		return nil
	end
	return data, Vector2.new(minX, minY), count
end

-- Copie (blockId : ce bloc + sa suite, ou la sélection s'il en fait partie ; nil : la sélection)
function Canvas:_copy(blockId)
	local model = self.getModel()
	if self._destroyed or not model or type(model.exportStack) ~= "function" then
		return 0
	end
	local units = self:_unitsFor(model, blockId)
	if #units == 0 then
		self:_status("Sélectionne d'abord des blocs à copier (clic, ou Maj + glisser sur le fond).", "info")
		return 0
	end
	local data, _, count = self:_exportUnits(model, units)
	if not data or not self:_writeClipboard(data) then
		self:_status("Impossible de copier ces blocs.", "error")
		return 0
	end
	self:_status(pluralBlocs(count) .. " copié" .. (count > 1 and "s" or "") .. " : colle-les avec Ctrl+V ou clic droit → Coller, même dans un autre script.", "success")
	return count
end

function Canvas:copySelection()
	return self:_copy(nil)
end

-- Supprime des blocs un par un (chacun avec son contenu ; la suite remonte) ; renvoie le nombre supprimé
function Canvas:_deleteIds(model, ids, reason)
	local anchors = self:_captureNoteAnchors(model)
	local before = model:count()
	for _, id in ipairs(ids) do
		if model:get(id) ~= nil then
			pcall(model.deleteSingle, model, id)
		end
	end
	local removed = before - model:count()
	self:_followNotes(model, anchors)
	self:_commit(reason or "supprimer")
	return removed
end

function Canvas:_cut(blockId)
	local model = self.getModel()
	local count = self:_copy(blockId)
	if count <= 0 or not model or self.getModel() ~= model then
		return
	end
	if blockId ~= nil and model:get(blockId) ~= nil and not (self.selection[blockId] and setCount(self.selection) >= 2) then
		local anchors = self:_captureNoteAnchors(model)
		model:delete(blockId)
		self:_followNotes(model, anchors)
		self:_commit("couper")
	else
		self:_deleteIds(model, self:getSelection(), "couper")
	end
	self:_status(pluralBlocs(count) .. " coupé" .. (count > 1 and "s" or "") .. " : colle-les avec Ctrl+V ou clic droit → Coller.", "success")
end

function Canvas:cutSelection()
	self:_cut(nil)
end

-- Supprime les blocs sélectionnés ; renvoie le nombre de blocs supprimés
function Canvas:deleteSelection()
	local model = self.getModel()
	local ids = self:getSelection()
	if self._destroyed or not model or #ids == 0 then
		return 0
	end
	local removed = self:_deleteIds(model, ids, "supprimer")
	self:_status(pluralBlocs(removed) .. " supprimé" .. (removed > 1 and "s" or "") .. " (Ctrl+Z pour annuler).", "info")
	return removed
end

-- Sélectionne toutes les piles qui commencent par ces blocs ; renvoie le nombre de blocs
function Canvas:_selectStacksOf(model, tops)
	local set = {}
	for _, id in ipairs(tops) do
		local ok, ids = pcall(model.stackIds, model, id)
		if ok and type(ids) == "table" then
			for _, bid in ipairs(ids) do
				set[bid] = true
			end
		end
	end
	self:_setSelection(set)
	return setCount(set)
end

-- Colle le presse-papiers : le coin haut-gauche des blocs arrive sous la souris (ou au centre)
function Canvas:paste(screenPos)
	local model = self.getModel()
	if self._destroyed or not model or type(model.importData) ~= "function" then
		return false
	end
	local data = self:_readClipboard()
	if not data then
		self:_status("Rien à coller : copie d'abord des blocs (clic droit → Copier).", "info")
		return false
	end
	local p = screenPos
	if typeof(p) ~= "Vector2" or not self:_overCanvas(p) then
		p = self:_center()
	end
	local c = self:screenToCanvas(p)
	local ok, tops, warnings, newNotes = pcall(model.importData, model, data, round(c.X), round(c.Y))
	if not ok or type(tops) ~= "table" then
		self:_status("Impossible de coller ces blocs : " .. tostring(tops), "error")
		return false
	end
	if #tops == 0 and (type(newNotes) ~= "table" or #newNotes == 0) then
		self:_status("Rien à coller : ces blocs n'existent pas dans cette version de Blocs FR.", "warning")
		return false
	end
	self:_commit("coller")
	local count = self:_selectStacksOf(model, tops)
	self:_flashBlocks(model, tops)
	if type(warnings) == "table" and #warnings > 0 then
		self:_status(tostring(warnings[1]), "warning")
	else
		self:_status(pluralBlocs(count) .. " collé" .. (count > 1 and "s" or "") .. ".", "success")
	end
	return true
end

-- Duplique la sélection (décalée de 30) ; les copies deviennent la sélection
function Canvas:duplicateSelection()
	local model = self.getModel()
	if self._destroyed or not model or type(model.importData) ~= "function" then
		return
	end
	local units = self:_unitsOf(model, self.selection)
	if #units == 0 then
		self:_status("Sélectionne d'abord des blocs à dupliquer.", "info")
		return
	end
	local data, origin = self:_exportUnits(model, units)
	if not data then
		return
	end
	local ok, tops = pcall(model.importData, model, data, round(origin.X + PASTE_OFFSET), round(origin.Y + PASTE_OFFSET))
	if not ok or type(tops) ~= "table" then
		self:_status("Impossible de dupliquer : " .. tostring(tops), "error")
		return
	end
	self:_commit("dupliquer")
	local count = self:_selectStacksOf(model, tops)
	self:_flashBlocks(model, tops)
	self:_status(pluralBlocs(count) .. " dupliqué" .. (count > 1 and "s" or "") .. ".", "success")
end

-- Désactive (ou réactive) des blocs : ils restent dans le projet mais pas dans le code (SPEC §32)
function Canvas:_setDisabledIds(model, ids, disabled)
	if type(model.setDisabled) ~= "function" then
		return
	end
	local n = 0
	for _, id in ipairs(ids) do
		if model:get(id) ~= nil then
			local ok, result = pcall(model.setDisabled, model, id, disabled)
			if ok and result ~= false then
				n += 1
			end
		end
	end
	if n == 0 then
		return
	end
	if disabled then
		self:_commit("desactiver")
		self:_status(pluralBlocs(n) .. " désactivé" .. (n > 1 and "s" or "") .. " : ils restent là, mais ne sont plus dans le code.", "info")
	else
		self:_commit("reactiver")
		self:_status(pluralBlocs(n) .. " réactivé" .. (n > 1 and "s" or "") .. ".", "success")
	end
end

-- « Détacher ce bloc » : il sort de sa pile (la suite prend sa place) et se pose à droite du groupe
function Canvas:_detachBlock(blockId)
	local model = self.getModel()
	if self._destroyed or not model or type(model.detachSingle) ~= "function" or model:get(blockId) == nil then
		return
	end
	local rootId = model:root(blockId)
	local rootView = rootId and self.views[rootId]
	local rect = self:_blockCanvasRect(blockId)
	local anchors = self:_captureNoteAnchors(model)
	local ok, result = pcall(model.detachSingle, model, blockId)
	if not ok or result == false then
		self:_status("Impossible de détacher ce bloc.", "error")
		return
	end
	if rect then
		local right = rect.x + rect.w
		if rootView and rootView.frame then
			right = math.max(right, rootView.frame.Position.X.Offset + (rootView.width or 0))
		end
		model:moveTo(blockId, round(right + 40), round(rect.y))
	end
	model:bringToFront(blockId)
	self:_followNotes(model, anchors)
	self:_commit("detacher")
	self:_flashBlocks(model, { blockId })
	self:_status("Bloc détaché : il est seul, à droite de son groupe.", "info")
end

-- Ajoute un bloc au centre de la partie visible (palette : « Ajouter à la zone de travail »)
function Canvas:addBlockAtCenter(defId, presets)
	local model = self.getModel()
	if self._destroyed or not model then
		return nil
	end
	if self.drag then
		self:_abortDrag()
	end
	local id = model:create(defId, 0, 0, presets)
	if id == nil then
		self:_status("Bloc inconnu : " .. tostring(defId), "error")
		return nil
	end
	local okSize, w, h = pcall(Renderer.measure, model, id)
	if not okSize then
		w, h = 120, 40
	end
	local c = self:screenToCanvas(self:_center())
	local x, y = round(c.X - w / 2), round(c.Y - h / 2)
	-- décale tant qu'une pile commence déjà presque au même endroit
	for _ = 1, 12 do
		local taken = false
		for _, topId in ipairs(model.tops) do
			local block = topId ~= id and model:get(topId)
			if block and math.abs((tonumber(block.x) or 0) - x) < 8 and math.abs((tonumber(block.y) or 0) - y) < 8 then
				taken = true
				break
			end
		end
		if not taken then
			break
		end
		x += 24
		y += 24
	end
	model:moveTo(id, x, y)
	self:_commit("ajouter")
	self:select({ id }, false)
	self:_flashBlocks(model, { id })
	return id
end

---------------------------------------------------------------------------
-- Clavier (raccourcis quand la souris est sur la zone de travail)
---------------------------------------------------------------------------

function Canvas:_shortcutsAllowed()
	if self._destroyed or not self._kbActive or self._editing or self._editingNote ~= nil then
		return false
	end
	if self._tracking or self.drag then
		return false
	end
	if self.dialogs and self.dialogs:isOpen() then
		return false
	end
	if not self.frame or not Util.pointInGui(self:_mouse(), self.frame) then
		return false
	end
	local ok, focused = pcall(function()
		return UserInputService:GetFocusedTextBox()
	end)
	if ok and focused ~= nil then
		return false
	end
	return true
end

function Canvas:_undoRedo(redo)
	local model = self.getModel()
	if self._destroyed or not model then
		return
	end
	local before = self._refreshCount
	local done
	if redo then
		done = model:redo()
	else
		done = model:undo()
	end
	if done then
		self:_status(redo and "Action refaite." or "Action annulée.", "info")
	end
	if self._refreshCount == before then
		self:refresh()
	end
end

-- InputBegan / InputEnded reçus par la zone, le fond, les blocs et les notes
function Canvas:_onInput(input, began)
	if self._destroyed or typeof(input) ~= "Instance" then
		return
	end
	local inputType = input.UserInputType
	if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.MouseButton2 then
		if began then
			self._lastPointerInput = input
			self._lastPointerTime = os.clock()
		end
		return
	end
	if inputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local key = input.KeyCode
	local name = key.Name
	if name == "LeftShift" or name == "RightShift" then
		self._shiftDown = began == true
		return
	end
	if name == "LeftControl" or name == "RightControl" or name == "LeftMeta" or name == "RightMeta" or name == "LeftSuper" or name == "RightSuper" then
		self._ctrlDown = began == true
		return
	end
	if not began then
		return
	end
	-- (plusieurs objets reçoivent la même touche : une seule action)
	local now = os.clock()
	if self._lastKey == key and now - self._lastKeyTime < 0.06 then
		return
	end
	self._lastKey = key
	self._lastKeyTime = now
	-- Échap annule une ligne en cours de tracé ou une copie qui suit la souris
	local tracking = self._tracking
	if key == Enum.KeyCode.Escape and tracking and tracking.spec and tracking.spec.sticky then
		self:_endTracking(tracking, "annule")
		return
	end
	if not self:_shortcutsAllowed() then
		return
	end
	local ctrl = self._ctrlDown
	if not ctrl then
		local ok, down = pcall(function()
			return input:IsModifierKeyDown(Enum.ModifierKey.Ctrl) or input:IsModifierKeyDown(Enum.ModifierKey.Meta)
		end)
		ctrl = ok and down == true
	end
	if ctrl then
		if key == Enum.KeyCode.C then
			self:copySelection()
		elseif key == Enum.KeyCode.X then
			self:cutSelection()
		elseif key == Enum.KeyCode.V then
			self:paste(self:_mouse())
		elseif key == Enum.KeyCode.D then
			self:duplicateSelection()
		elseif key == Enum.KeyCode.A then
			self:selectAll()
		elseif key == Enum.KeyCode.Z then
			self:_undoRedo(false)
		elseif key == Enum.KeyCode.Y then
			self:_undoRedo(true)
		end
		return
	end
	if key == Enum.KeyCode.Delete then
		if next(self.selection) ~= nil then
			self:deleteSelection()
		end
	elseif key == Enum.KeyCode.Escape then
		self:clearSelection()
	end
end

---------------------------------------------------------------------------
-- Menus du clic droit « comme le bureau de Windows » (SPEC §33)
---------------------------------------------------------------------------

function Canvas:_onBlockContextMenu(blockId)
	if self._destroyed or self._tracking or not self.dialogs then
		return
	end
	local model = self.getModel()
	if not model or model:get(blockId) == nil then
		return
	end
	self._kbActive = true
	-- clic droit sur un bloc d'une sélection de plusieurs blocs : menu de la sélection
	if self.selection[blockId] and setCount(self.selection) >= 2 then
		self:_selectionMenu()
		return
	end
	-- comme sur le bureau : le bloc cliqué devient la sélection
	if not self.selection[blockId] then
		self:select({ blockId }, false)
	end
	self:_blockMenu(blockId)
end

-- Menu d'un bloc
function Canvas:_blockMenu(blockId)
	local model = self.getModel()
	local block = model and model:get(blockId)
	if not block then
		return
	end
	local def = model:def(blockId)
	local defId = def and def.id
	local mouse = self:_mouse()
	local deps = self.deps
	local hasNext = block.next ~= nil and model:get(block.next) ~= nil
	local isTop = block.parent == nil
	local stackCount, groupCount = 1, 1
	local okStack, stackIds = pcall(model.stackIds, model, model:root(blockId))
	if okStack and type(stackIds) == "table" then
		stackCount = #stackIds
	end
	local okGroup, groupIds = pcall(model.stackIds, model, blockId)
	if okGroup and type(groupIds) == "table" then
		groupCount = #groupIds
	end
	local ownDisabled = block.disabled == true
	local favorite = defId ~= nil and self:_isFavorite(defId)
	local items = {
		{ label = "Couper", value = "couper", hint = "Ctrl+X" },
		{ label = "Copier", value = "copier", hint = "Ctrl+C" },
		{ label = "Coller", value = "coller", hint = "Ctrl+V", disabled = not self:_hasClipboard() },
		{ label = "Dupliquer", value = "dupliquer", icon = "＋", hint = "Ctrl+D" },
		"separator",
		{ label = "Sélectionner uniquement ce bloc", value = "seul", icon = "◎" },
		{ label = "Sélectionner tout le groupe", value = "groupe_sel", hint = pluralBlocs(stackCount), disabled = stackCount <= 1 },
		{ label = "Tout sélectionner", value = "tout", hint = "Ctrl+A" },
		"separator",
		{ label = "Détacher ce bloc", value = "detacher", icon = "←", disabled = isTop and not hasNext, hidden = type(model.detachSingle) ~= "function" },
		{
			label = ownDisabled and "Réactiver ce bloc" or "Désactiver ce bloc",
			value = "desactiver",
			icon = ownDisabled and "✓" or "−",
			hidden = type(model.setDisabled) ~= "function",
		},
		{ label = "Ajouter une note", value = "note", icon = "＋", hidden = type(model.addNote) ~= "function" },
		{ label = "Relier à un autre bloc…", value = "relier", icon = "◆", hidden = type(model.addLink) ~= "function" },
		"separator",
		{
			label = favorite and "Retirer des favoris" or "Ajouter aux favoris",
			value = "favori",
			icon = "●",
			hidden = defId == nil or not self:_canFavorite(),
		},
		{
			label = "Prévisualiser la hitbox",
			value = "hitbox",
			icon = "⌂",
			hidden = type(deps.openHitboxPreview) ~= "function" or not self:_supportsHitbox(defId),
		},
		{ label = "Expliquer ce script", value = "expliquer", hidden = type(deps.explain) ~= "function" },
		{ label = "Voir dans le code", value = "code", icon = "→", hidden = type(deps.showCodeAt) ~= "function" },
		"separator",
		{ label = "Ouvrir dans le wiki", value = "wiki", icon = "≡", disabled = defId == nil },
		{ label = "Aide sur ce bloc", value = "aide", disabled = def == nil },
		"separator",
		{ label = "Supprimer ce bloc", value = "supprimer", icon = "×", danger = true, hint = "Suppr" },
		{ label = "Supprimer le groupe", value = "groupe", danger = true, hint = pluralBlocs(groupCount), hidden = not hasNext },
	}
	self.dialogs:menu(mouse, items, function(value)
		if self._destroyed or self.getModel() ~= model or model:get(blockId) == nil then
			return
		end
		if value == "couper" then
			self:_cut(blockId)
		elseif value == "copier" then
			self:_copy(blockId)
		elseif value == "coller" then
			self:paste(mouse)
		elseif value == "dupliquer" then
			-- la copie suit la souris jusqu'au prochain clic
			local newId = model:duplicate(blockId)
			if newId then
				self:_beginStickyDrag(model, newId)
			end
		elseif value == "seul" then
			self:select({ blockId }, false)
		elseif value == "groupe_sel" then
			self:_selectGroup(blockId)
		elseif value == "tout" then
			self:selectAll()
		elseif value == "detacher" then
			self:_detachBlock(blockId)
		elseif value == "desactiver" then
			self:_setDisabledIds(model, { blockId }, not ownDisabled)
		elseif value == "note" then
			self:_addNoteForBlock(blockId)
		elseif value == "relier" then
			self:_beginLinkMode(blockId)
		elseif value == "favori" then
			self:_toggleFavorite(defId)
		elseif value == "hitbox" then
			self:_callDep("openHitboxPreview", blockId)
		elseif value == "expliquer" then
			self:_callDep("explain")
		elseif value == "code" then
			self:_callDep("showCodeAt", blockId)
		elseif value == "wiki" then
			self:_openWiki(defId)
		elseif value == "aide" then
			self:_showHelp(def)
		elseif value == "supprimer" then
			local anchors = self:_captureNoteAnchors(model)
			model:deleteSingle(blockId)
			self:_followNotes(model, anchors)
			self:_commit("supprimer")
			self:_status("Bloc supprimé (Ctrl+Z pour annuler).", "info")
		elseif value == "groupe" then
			-- compte aussi les corps des blocs C et les valeurs branchées
			local anchors = self:_captureNoteAnchors(model)
			local before = model:count()
			model:delete(blockId)
			local count = before - model:count()
			self:_followNotes(model, anchors)
			self:_commit("supprimer")
			self:_status(pluralBlocs(count) .. " supprimé" .. (count > 1 and "s" or "") .. " (Ctrl+Z pour annuler).", "info")
		end
	end)
end

-- Menu d'une sélection de plusieurs blocs
function Canvas:_selectionMenu()
	local model = self.getModel()
	if not model then
		return
	end
	local ids = self:getSelection()
	local n = #ids
	local allDisabled = n > 0
	for _, id in ipairs(ids) do
		local block = model:get(id)
		if block and block.disabled ~= true then
			allDisabled = false
			break
		end
	end
	local items = {
		{ label = "Copier la sélection", value = "copier", hint = "Ctrl+C" },
		{ label = "Couper la sélection", value = "couper", hint = "Ctrl+X" },
		{ label = "Dupliquer la sélection", value = "dupliquer", icon = "＋", hint = "Ctrl+D" },
		{
			label = allDisabled and "Réactiver la sélection" or "Désactiver la sélection",
			value = "desactiver",
			icon = allDisabled and "✓" or "−",
			hidden = type(model.setDisabled) ~= "function",
		},
		"separator",
		{ label = "Tout sélectionner", value = "tout", hint = "Ctrl+A" },
		{ label = "Tout désélectionner", value = "aucun", hint = "Échap" },
		"separator",
		{ label = "Supprimer la sélection", value = "supprimer", icon = "×", danger = true, hint = pluralBlocs(n) },
	}
	self.dialogs:menu(self:_mouse(), items, function(value)
		if self._destroyed or self.getModel() ~= model then
			return
		end
		if value == "copier" then
			self:_copy(nil)
		elseif value == "couper" then
			self:_cut(nil)
		elseif value == "dupliquer" then
			self:duplicateSelection()
		elseif value == "desactiver" then
			self:_setDisabledIds(model, self:getSelection(), not allDisabled)
		elseif value == "tout" then
			self:selectAll()
		elseif value == "aucun" then
			self:clearSelection()
		elseif value == "supprimer" then
			self:deleteSelection()
		end
	end)
end

function Canvas:_backgroundMenu()
	if self._destroyed or self._tracking or not self.dialogs then
		return
	end
	local model = self.getModel()
	if not model then
		return
	end
	local mouse = self:_mouse()
	-- clic droit tout près d'une ligne entre deux blocs : le menu de cette ligne (SPEC §36)
	local line = self:_linkAt(mouse)
	if line then
		self:_linkMenu(line)
		return
	end
	local deps = self.deps
	local empty = #model.tops == 0
	local hasNotes = type(model.notes) == "table" and next(model.notes) ~= nil
	local zoomItems = {}
	local current = self:getZoom()
	for _, z in ipairs(ZOOM_STEPS) do
		table.insert(zoomItems, {
			label = tostring(round(z * 100)) .. " %",
			value = "zoom:" .. tostring(z),
			checked = math.abs(current - z) < 0.01,
		})
	end
	local hasCode = type(deps.showCodeAt) == "function" or type(deps.showCode) == "function"
	local items = {
		{ label = "Coller ici", value = "coller", hint = "Ctrl+V", disabled = not self:_hasClipboard() },
		{ label = "Ajouter une note ici", value = "note", icon = "＋", hidden = type(model.addNote) ~= "function" },
		"separator",
		{ label = "Tout sélectionner", value = "tout", hint = "Ctrl+A", disabled = empty },
		{ label = "Ranger les blocs", value = "ranger", disabled = empty },
		{ label = "Recentrer la vue", value = "recentrer", icon = "◎", disabled = empty and not hasNotes },
		{ label = "Zoom", icon = "🔍", submenu = zoomItems },
		"separator",
		{ label = "Annuler", value = "annuler", hint = "Ctrl+Z", disabled = not model:canUndo() },
		{ label = "Refaire", value = "refaire", hint = "Ctrl+Y", disabled = not model:canRedo() },
		"separator",
		{ label = "Expliquer ce script", value = "expliquer", disabled = empty, hidden = type(deps.explain) ~= "function" },
		{ label = "Voir le code", value = "code", icon = "→", hidden = not hasCode },
		{ label = "Partager ce script…", value = "partager", disabled = empty, hidden = type(deps.shareScript) ~= "function" },
		{ label = "Importer un code…", value = "importer", hidden = type(deps.importCode) ~= "function" },
		"separator",
		{ label = "Paramètres…", value = "parametres", hidden = type(deps.openSettings) ~= "function" },
		{ label = "Ouvrir le wiki", value = "wiki", icon = "≡" },
		"separator",
		{ label = "Tout effacer", value = "effacer", icon = "×", danger = true, disabled = empty and not hasNotes },
	}
	self.dialogs:menu(mouse, items, function(value)
		if self._destroyed or self.getModel() ~= model then
			return
		end
		if value == "coller" then
			self:paste(mouse)
		elseif value == "note" then
			self:_addNoteAt(mouse)
		elseif value == "tout" then
			self:selectAll()
		elseif value == "ranger" then
			self:cleanUp()
			self:_status("Blocs rangés.", "info")
		elseif value == "recentrer" then
			self:recenter()
		elseif type(value) == "string" and string.sub(value, 1, 5) == "zoom:" then
			local z = tonumber(string.sub(value, 6))
			if z then
				self:setZoom(z, self:_center())
			end
		elseif value == "annuler" then
			self:_undoRedo(false)
		elseif value == "refaire" then
			self:_undoRedo(true)
		elseif value == "expliquer" then
			self:_callDep("explain")
		elseif value == "code" then
			if type(deps.showCodeAt) == "function" then
				self:_callDep("showCodeAt", nil)
			else
				self:_callDep("showCode")
			end
		elseif value == "partager" then
			self:_callDep("shareScript")
		elseif value == "importer" then
			self:_callDep("importCode")
		elseif value == "parametres" then
			self:_callDep("openSettings")
		elseif value == "wiki" then
			self:_openWiki(nil)
		elseif value == "effacer" then
			self.dialogs:confirm(
				"Tout effacer",
				"Supprimer tous les blocs et toutes les notes de la zone de travail ? Tu pourras annuler avec « Annuler » (Ctrl+Z).",
				function()
					if self._destroyed or self.getModel() ~= model then
						return
					end
					model:clear()
					self:_commit("effacer")
					self:_status("Zone de travail effacée.", "info")
				end,
				"Tout effacer",
				"Annuler"
			)
		end
	end)
end

---------------------------------------------------------------------------
-- Lignes entre les blocs (SPEC §36) : dessin, survol, points lumineux, tracé à la main, menus
---------------------------------------------------------------------------

-- Signature d'une ligne placée (ce qui change son dessin)
local function linkSignature(line)
	local c = line.color
	return table.concat({
		tostring(line.key),
		tostring(line.style),
		tostring(line.label),
		string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)),
		string.format(
			"%d,%d,%d,%d,%d,%d,%d,%d",
			round(line.p0.X),
			round(line.p0.Y),
			round(line.c1.X),
			round(line.c1.Y),
			round(line.c2.X),
			round(line.c2.Y),
			round(line.p3.X),
			round(line.p3.Y)
		),
	}, "|")
end

-- Vrai si la boîte d'une ligne touche le rectangle visible (unités du canvas)
local function lineOnScreen(line, minX, minY, maxX, maxY)
	local bb = line.bbox
	if not bb then
		return false
	end
	return bb.maxX >= minX and bb.minX <= maxX and bb.maxY >= minY and bb.minY <= maxY
end

-- Extrémité d'une ligne : le bloc dessiné (unités du canvas), ou nil s'il n'est pas dessiné (pile en
-- cours de glissement…). x, w ; ry, rh = rangée principale (sans la bosse d'un événement) ;
-- cy = milieu de la première ligne du bloc.
function Canvas:_linkEnd(model, blockId)
	if not model or blockId == nil or model:get(blockId) == nil then
		return nil
	end
	local rootId = model:root(blockId)
	local view = rootId and self.views[rootId]
	local info = view and view.blocks and view.blocks[blockId]
	if not info or not view.frame then
		return nil
	end
	local fp = view.frame.Position
	local ry = fp.Y.Offset + (info.ringY or info.y)
	local rh = info.ringH or info.h or 30
	return {
		x = fp.X.Offset + info.x,
		w = info.w,
		ry = ry,
		rh = rh,
		cy = ry + math.min(rh, 36) / 2,
		rootId = rootId,
	}
end

-- Lignes tracées à la main (model.liens, SPEC §36), dans l'ordre de leurs ids
function Canvas:_collectManualLinks(model, out)
	local liens = model.liens
	if type(liens) ~= "table" then
		return
	end
	local ids = {}
	for id in pairs(liens) do
		table.insert(ids, id)
	end
	table.sort(ids, idLess)
	for _, id in ipairs(ids) do
		if #out >= LINK_MAX then
			return
		end
		local link = liens[id]
		local ok = type(link) == "table" and link.de ~= nil and link.vers ~= nil and link.de ~= link.vers
		if ok and model:get(link.de) ~= nil and model:get(link.vers) ~= nil then
			local style = link.style
			if not LINK_STYLE_SET[style] then
				style = "points"
			end
			local color = LINK_COLORS.manuel
			if type(link.couleur) == "table" then
				local okColor, c = pcall(Util.rgbToColor3, link.couleur)
				if okColor and typeof(c) == "Color3" then
					color = c
				end
			end
			local texte = link.texte
			if type(texte) ~= "string" then
				texte = ""
			end
			texte = Util.trim(texte)
			table.insert(out, {
				key = "manuel|" .. tostring(id),
				kind = "manuel",
				id = id,
				from = link.de,
				to = link.vers,
				name = texte,
				label = texte,
				style = style,
				color = color,
				flows = false,
			})
		end
	end
end

-- Lignes automatiques : message envoyé -> reçu, appel d'une fonction de module -> sa définition
function Canvas:_collectAutoLinks(model, out)
	local senders, receivers, callers, functions = {}, {}, {}, {}
	for id, block in pairs(model.blocks) do
		local defId = type(block) == "table" and block.def or nil
		if defId ~= nil and MESSAGE_SENDERS[defId] then
			local name = literalText(block, "MESSAGE")
			if name then
				table.insert(senders, { id = id, name = name })
			end
		elseif defId == "evt_message" then
			local name = literalText(block, "MESSAGE")
			if name then
				receivers[name] = receivers[name] or {}
				table.insert(receivers[name], id)
			end
		elseif defId == "mod_appeler" or defId == "mod_resultat" then
			local name = literalText(block, "NOM")
			if name then
				table.insert(callers, { id = id, name = name })
			end
		elseif defId == "mod_fonction" then
			local name = literalText(block, "NOM")
			if name then
				functions[name] = functions[name] or {}
				table.insert(functions[name], id)
			end
		end
	end
	local function byId(a, b)
		return idLess(a.id, b.id)
	end
	table.sort(senders, byId)
	table.sort(callers, byId)
	for _, list in pairs(receivers) do
		table.sort(list, idLess)
	end
	for _, list in pairs(functions) do
		table.sort(list, idLess)
	end
	for _, s in ipairs(senders) do
		for _, to in ipairs(receivers[s.name] or {}) do
			if #out >= LINK_MAX then
				return
			end
			if to ~= s.id then
				table.insert(out, {
					key = "message|" .. tostring(s.id) .. "|" .. tostring(to),
					kind = "message",
					from = s.id,
					to = to,
					name = s.name,
					label = "message « " .. s.name .. " »",
					style = "points",
					color = LINK_COLORS.message,
					flows = true,
				})
			end
		end
	end
	for _, c in ipairs(callers) do
		for _, to in ipairs(functions[c.name] or {}) do
			if #out >= LINK_MAX then
				return
			end
			if to ~= c.id then
				table.insert(out, {
					key = "module|" .. tostring(c.id) .. "|" .. tostring(to),
					kind = "module",
					from = c.id,
					to = to,
					name = c.name,
					label = "fonction du module",
					style = "points",
					color = LINK_COLORS.module,
					flows = true,
				})
			end
		end
	end
end

-- Lignes « variable » (variable modifiée -> utilisée) des blocs donnés seulement (bloc survolé, petite
-- sélection) : un bloc qui modifie une variable est relié aux blocs qui la lisent, et inversement
function Canvas:_collectVariableLinks(model, focus, out)
	local wanted = {}
	for id in pairs(focus) do
		local block = model:get(id)
		if block then
			local name = variableOf(model:def(id), block)
			if name then
				wanted[name] = true
			end
		end
	end
	if next(wanted) == nil then
		return
	end
	local writers, readers = {}, {}
	for id, block in pairs(model.blocks) do
		local name, isValue = variableOf(model:def(id), block)
		if name and wanted[name] then
			local map = writers
			if isValue then
				map = readers
			end
			map[name] = map[name] or {}
			table.insert(map[name], id)
		end
	end
	for _, list in pairs(writers) do
		table.sort(list, idLess)
	end
	for _, list in pairs(readers) do
		table.sort(list, idLess)
	end
	local seen = {}
	local function add(from, to, name)
		if from == to or #out >= LINK_MAX_VAR then
			return
		end
		local key = "variable|" .. tostring(from) .. "|" .. tostring(to)
		if seen[key] then
			return
		end
		seen[key] = true
		table.insert(out, {
			key = key,
			kind = "variable",
			from = from,
			to = to,
			name = name,
			label = "variable « " .. name .. " »",
			style = "points",
			color = LINK_COLORS.variable,
			flows = true,
		})
	end
	local focusIds = {}
	for id in pairs(focus) do
		table.insert(focusIds, id)
	end
	table.sort(focusIds, idLess)
	for _, id in ipairs(focusIds) do
		local block = model:get(id)
		if block then
			local name, isValue = variableOf(model:def(id), block)
			if name then
				if isValue then
					for _, writer in ipairs(writers[name] or {}) do
						add(writer, id, name)
					end
				else
					for _, reader in ipairs(readers[name] or {}) do
						add(id, reader, name)
					end
				end
			end
		end
	end
end

-- Place une ligne entre ses deux blocs dessinés (courbe) ; false si l'un d'eux n'est pas dessiné
function Canvas:_placeLink(model, line)
	local a = self:_linkEnd(model, line.from)
	local b = self:_linkEnd(model, line.to)
	if not a or not b then
		return false
	end
	line.fromRoot = a.rootId
	line.toRoot = b.rootId
	line.p0, line.c1, line.c2, line.p3 = linkCurve(a, b)
	return true
end

-- Étiquette au milieu d'une ligne (couleurs de la planche ; ligne tracée à la main : sa couleur)
function Canvas:_buildLinkPill(line, maid)
	local mid = pointAt(line.samples, line.cum, line.length / 2)
	local text = firstLine(line.label, 34)
	local colors = LINK_PILLS[line.kind]
	local bg, fg, strokeColor
	if colors then
		bg, fg, strokeColor = colors.bg, colors.text, colors.stroke
	else
		bg = line.color:Lerp(Color3.new(0, 0, 0), 0.78)
		fg = line.color
		strokeColor = line.color:Lerp(Color3.new(0, 0, 0), 0.45)
	end
	local font = Theme.Fonts.UIBold
	local tw = math.ceil(Util.textSize(text, 11, font).X)
	local pill = Util.create("TextButton", {
		Name = "Etiquette",
		Text = text,
		Font = font,
		TextSize = 11,
		TextColor3 = fg,
		AutoButtonColor = false,
		BackgroundColor3 = bg,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(round(mid.X), round(mid.Y)),
		Size = UDim2.fromOffset(tw + 20, LINK_PILL_H),
		ZIndex = 3,
		Parent = line.container,
	})
	Util.corner(pill, math.floor(LINK_PILL_H / 2))
	line.pillStroke = Util.stroke(pill, strokeColor, 1, 0)
	line.pill = pill
	maid:give(pill.MouseEnter:Connect(function()
		self._hoverLinkKey = line.key
		self:_scheduleLinkHover()
		if self.dialogs and not self._tracking then
			self.dialogs:tooltip(linkTooltip(line), self:_mouse())
		end
	end))
	maid:give(pill.MouseLeave:Connect(function()
		if self._hoverLinkKey == line.key then
			self._hoverLinkKey = nil
			self:_scheduleLinkHover()
		end
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
	end))
	maid:give(pill.MouseButton1Click:Connect(function()
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
		if not self._tracking then
			self:focusBlock(line.to)
		end
	end))
	maid:give(pill.MouseButton2Click:Connect(function()
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
		self:_linkMenu(line)
	end))
	maid:give(pill.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self:_onWheel(input)
		end
	end))
	maid:give(pill.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self._kbActive = true
		end
		self:_onInput(input, true)
	end))
	maid:give(pill.InputEnded:Connect(function(input)
		self:_onInput(input, false)
	end))
end

-- Dessine une ligne placée : points (pointillés ou serrés), rond ou pointe d'arrivée, points lumineux,
-- étiquette. budget = points encore permis. Renvoie le nombre de points créés.
function Canvas:_buildLinkVisual(line, maid, budget)
	local container = Util.create("Frame", {
		Name = "Lien",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = 1,
		Parent = self.linksLayer,
	})
	maid:give(container)
	line.container = container
	line.state = "normal"
	line.dots = {}
	line.runners = {}
	line.runnerPos = {}
	line.runnerAlpha = {}
	line.runnersShown = true
	local samples, cum, length = sampleCurve(line.p0, line.c1, line.c2, line.p3)
	line.samples, line.cum, line.length = samples, cum, length
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, p in ipairs(samples) do
		minX = math.min(minX, p.X)
		minY = math.min(minY, p.Y)
		maxX = math.max(maxX, p.X)
		maxY = math.max(maxY, p.Y)
	end
	line.bbox = { minX = minX - 8, minY = minY - 8, maxX = maxX + 8, maxY = maxY + 8 }

	local color = line.color
	local alpha = LINK_ALPHA.normal
	local style = line.style
	local solid = style == "plein" or style == "fleche"
	local spacing, maxDots = LINK_SPACING, LINK_MAX_DOTS
	if solid then
		spacing, maxDots = LINK_SOLID_SPACING, LINK_MAX_DOTS_SOLID
	end
	maxDots = math.max(8, math.min(maxDots, math.floor(tonumber(budget) or maxDots)))
	-- (les points s'arrêtent avant le rond d'arrivée ; la pointe de flèche commence au bout)
	local stop = LINK_END_DOT / 2 + 2
	if style == "fleche" then
		stop = 2
	end
	local usable = math.max(0, length - stop)
	local count = math.floor(usable / spacing) + 1
	if count > maxDots then
		count = maxDots
		spacing = usable / math.max(1, maxDots - 1)
	end
	local half = LINK_DOT / 2
	for i = 0, count - 1 do
		local p = pointAt(samples, cum, i * spacing)
		local dot = Util.create("Frame", {
			Name = "Point",
			BackgroundColor3 = color,
			BackgroundTransparency = alpha,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(round(p.X - half), round(p.Y - half)),
			Size = UDim2.fromOffset(LINK_DOT, LINK_DOT),
			ZIndex = 1,
			Parent = container,
		})
		if not solid then
			Util.corner(dot, 2)
		end
		table.insert(line.dots, dot)
	end
	local used = count

	if style == "fleche" then
		-- pointe de flèche en « V » faite de points, dans le sens de la fin de la courbe
		local back = pointAt(samples, cum, math.max(0, length - 8))
		local dir = line.p3 - back
		if dir.Magnitude < 0.01 then
			dir = Vector2.new(1, 0)
		end
		dir = dir.Unit
		local side = Vector2.new(-dir.Y, dir.X)
		for k = 1, 4 do
			for _, sign in ipairs({ -1, 1 }) do
				local q = line.p3 - dir * (k * 3) + side * (sign * k * 2.6)
				local dot = Util.create("Frame", {
					Name = "Pointe",
					BackgroundColor3 = color,
					BackgroundTransparency = alpha,
					BorderSizePixel = 0,
					Active = false,
					Position = UDim2.fromOffset(round(q.X - 2), round(q.Y - 2)),
					Size = UDim2.fromOffset(4, 4),
					ZIndex = 2,
					Parent = container,
				})
				table.insert(line.dots, dot)
			end
		end
		used += 8
	else
		local d = LINK_END_DOT
		local endDot = Util.create("Frame", {
			Name = "Arrivee",
			BackgroundColor3 = color,
			BackgroundTransparency = alpha,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(round(line.p3.X - d / 2), round(line.p3.Y - d / 2)),
			Size = UDim2.fromOffset(d, d),
			ZIndex = 2,
			Parent = container,
		})
		Util.corner(endDot, math.ceil(d / 2))
		line.endDot = endDot
		used += 1
	end

	-- points lumineux qui avancent du départ vers l'arrivée (animations activées seulement)
	if line.flows and Anim.enabled() and length > 30 then
		local n = math.floor(Util.clamp(length / FLOW_GAP, 1, FLOW_MAX_RUNNERS))
		line.runnerGap = length / n
		local light = Theme.lighten(color, 0.45)
		for k = 1, n do
			local p = pointAt(samples, cum, (k - 1) * line.runnerGap)
			local runner = Util.create("Frame", {
				Name = "Flux",
				BackgroundColor3 = light,
				BackgroundTransparency = 0,
				BorderSizePixel = 0,
				Active = false,
				Position = UDim2.fromOffset(round(p.X - FLOW_DOT / 2), round(p.Y - FLOW_DOT / 2)),
				Size = UDim2.fromOffset(FLOW_DOT, FLOW_DOT),
				ZIndex = 2,
				Parent = container,
			})
			Util.corner(runner, 3)
			table.insert(line.runners, runner)
		end
		used += n
	end

	if line.label ~= "" and length >= LINK_MIN_LABEL_LEN then
		self:_buildLinkPill(line, maid)
	end
	return used
end

-- Montre / cache une ligne et règle son éclat : "normal", "vif" (ligne du bloc survolé) ou "terne"
function Canvas:_setLinkVisual(line, visible, state)
	local container = line.container
	if not container then
		return
	end
	if container.Visible ~= visible then
		container.Visible = visible
	end
	-- points lumineux : cachés sur une ligne qui pâlit (et quand les animations sont coupées)
	local showRunners = state ~= "terne" and Anim.enabled()
	if line.runnersShown ~= showRunners then
		line.runnersShown = showRunners
		for _, runner in ipairs(line.runners or {}) do
			runner.Visible = showRunners
		end
	end
	if line.state == state then
		return
	end
	line.state = state
	local alpha = LINK_ALPHA[state] or LINK_ALPHA.normal
	for _, dot in ipairs(line.dots or {}) do
		dot.BackgroundTransparency = alpha
	end
	if line.endDot then
		line.endDot.BackgroundTransparency = alpha
	end
	if line.pill then
		local bgT, textT, strokeT = 0, 0, 0
		if state == "terne" then
			bgT, textT, strokeT = 0.55, 0.5, 0.6
		end
		line.pill.BackgroundTransparency = bgT
		line.pill.TextTransparency = textT
		if line.pillStroke then
			line.pillStroke.Transparency = strokeT
		end
	end
end

-- Dessine les lignes automatiques et tracées (après chaque dessin des piles). Rien n'est refait si
-- aucune ligne n'a changé (mêmes blocs, mêmes positions, même style).
function Canvas:_renderLinks(model)
	if self._destroyed or not self.linksLayer then
		return
	end
	local setting = linkSetting()
	self._linkSetting = setting
	local lines = {}
	if model and type(model.blocks) == "table" then
		self:_collectManualLinks(model, lines)
		if setting ~= "jamais" then
			self:_collectAutoLinks(model, lines)
		end
	end
	local placed = {}
	local parts = { tostring(model), setting, tostring(Anim.enabled()) }
	for _, line in ipairs(lines) do
		if self:_placeLink(model, line) then
			table.insert(placed, line)
			table.insert(parts, linkSignature(line))
		end
	end
	local sig = table.concat(parts, "\n")
	if sig ~= self._linkSig then
		self._linkSig = sig
		self._linkMaid:clean()
		self._baseLines = placed
		self._hoverLinkKey = nil
		local budget = LINK_TOTAL_DOTS
		for _, line in ipairs(placed) do
			local ok, used = pcall(self._buildLinkVisual, self, line, self._linkMaid, budget)
			if ok then
				budget = math.max(0, budget - (tonumber(used) or 0))
			else
				warn("[Blocs FR] Canvas : ligne " .. tostring(line.key) .. " impossible à dessiner : " .. tostring(used))
			end
		end
	end
	self:_refreshHoverLinks(true)
end

-- Lignes « variable » du bloc survolé et de la petite sélection (refaites seulement si elles changent)
function Canvas:_rebuildVariableLinks(model, focus)
	local lines = {}
	if model and type(model.blocks) == "table" and self._linkSetting ~= "jamais" and next(focus) ~= nil then
		self:_collectVariableLinks(model, focus, lines)
	end
	local placed = {}
	local parts = { tostring(model), tostring(Anim.enabled()) }
	for _, line in ipairs(lines) do
		if self:_placeLink(model, line) then
			table.insert(placed, line)
			table.insert(parts, linkSignature(line))
		end
	end
	local sig = table.concat(parts, "\n")
	if sig == self._varLinkSig then
		return
	end
	self._varLinkSig = sig
	self._varLinkMaid:clean()
	self._varLines = placed
	local budget = LINK_VAR_DOTS
	for _, line in ipairs(placed) do
		local ok, used = pcall(self._buildLinkVisual, self, line, self._varLinkMaid, budget)
		if ok then
			budget = math.max(0, budget - (tonumber(used) or 0))
		else
			warn("[Blocs FR] Canvas : ligne " .. tostring(line.key) .. " impossible à dessiner : " .. tostring(used))
		end
	end
end

-- Éclat et visibilité de chaque ligne : celles du bloc (ou de l'étiquette) survolé s'allument et les
-- autres pâlissent ; celles des blocs sélectionnés s'allument aussi. Réglage « survol » : les lignes
-- automatiques n'apparaissent que pour le bloc survolé / sélectionné. Pendant un glissement, les lignes
-- des autres piles qui bougent sont cachées (elles seraient à l'ancienne place).
function Canvas:_applyLinkStates()
	local focus = self._linkFocus or {}
	local hovered = self._hoverBlock
	local hoverKey = self._hoverLinkKey
	-- (survoler un bloc sans ligne ne change rien : les autres lignes ne pâlissent que si le bloc
	-- survolé en a)
	local hoverHit = false
	local keyFound = false
	for _, list in ipairs({ self._baseLines, self._varLines }) do
		for _, line in ipairs(list) do
			if hovered ~= nil and (line.from == hovered or line.to == hovered) then
				hoverHit = true
			end
			if hoverKey ~= nil and line.key == hoverKey then
				keyFound = true
			end
		end
	end
	-- (étiquette survolée disparue avec sa ligne : plus rien n'est survolé)
	if hoverKey ~= nil and not keyFound then
		self._hoverLinkKey = nil
		hoverKey = nil
	end
	local dim = hoverHit or hoverKey ~= nil
	local setting = self._linkSetting or "toujours"
	local moving = nil
	if self.drag and type(self.drag.otherRoots) == "table" then
		moving = self.drag.otherRoots
	end
	for _, list in ipairs({ self._baseLines, self._varLines }) do
		for _, line in ipairs(list) do
			local byHover = false
			if hovered ~= nil and (line.from == hovered or line.to == hovered) then
				byHover = true
			elseif hoverKey ~= nil and line.key == hoverKey then
				byHover = true
			end
			local bySelection = focus[line.from] == true or focus[line.to] == true
			local visible = true
			if line.kind ~= "manuel" and setting == "survol" then
				visible = byHover or bySelection
			end
			if moving and (moving[line.fromRoot] or moving[line.toRoot]) then
				visible = false
			end
			local state = "normal"
			if dim then
				if byHover then
					state = "vif"
				elseif not bySelection then
					state = "terne"
				end
			elseif bySelection then
				state = "vif"
			end
			self:_setLinkVisual(line, visible, state)
		end
	end
end

-- Blocs reliés au bloc (ou à l'étiquette) survolé : contour de la couleur de la ligne. Renvoie true si
-- la liste a changé.
function Canvas:_computeLinkRings()
	local rings = {}
	local hovered = self._hoverBlock
	local hoverKey = self._hoverLinkKey
	if hovered ~= nil or hoverKey ~= nil then
		for _, list in ipairs({ self._baseLines, self._varLines }) do
			for _, line in ipairs(list) do
				local related = false
				if hovered ~= nil and (line.from == hovered or line.to == hovered) then
					related = true
				elseif hoverKey ~= nil and line.key == hoverKey then
					related = true
				end
				if related and line.container and line.container.Visible then
					if rings[line.from] == nil then
						rings[line.from] = line.color
					end
					if rings[line.to] == nil then
						rings[line.to] = line.color
					end
				end
			end
		end
	end
	local keys = {}
	for id, color in pairs(rings) do
		table.insert(keys, string.format("%s:%d,%d,%d", tostring(id), math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)))
	end
	table.sort(keys)
	local sig = table.concat(keys, ";")
	self._linkRingIds = rings
	if sig == self._linkRingSig then
		return false
	end
	self._linkRingSig = sig
	return true
end

-- Survol ou sélection changés : lignes des variables, éclat des lignes, contours des blocs reliés.
-- skipRings : l'appelant redessine lui-même les contours (refresh).
function Canvas:_refreshHoverLinks(skipRings)
	if self._destroyed or not self.linksLayer then
		return
	end
	local model = self.getModel()
	if model ~= self._renderedModel then
		model = nil
	end
	local focus = {}
	local n = setCount(self.selection)
	if n > 0 and n <= LINK_FOCUS_SELECTION then
		for id in pairs(self.selection) do
			focus[id] = true
		end
	end
	self._linkFocus = focus
	local varFocus = {}
	for id in pairs(focus) do
		varFocus[id] = true
	end
	if self._hoverBlock ~= nil then
		varFocus[self._hoverBlock] = true
	end
	local ok, err = pcall(self._rebuildVariableLinks, self, model, varFocus)
	if not ok then
		warn("[Blocs FR] Canvas : lignes des variables impossibles à dessiner : " .. tostring(err))
	end
	self:_applyLinkStates()
	if self:_computeLinkRings() and not skipRings then
		self:_updateRings()
	end
	self:_maybeStartFlow()
end

-- Regroupe les entrées / sorties de survol d'une même image (une seule mise à jour)
function Canvas:_scheduleLinkHover()
	if self._linkHoverPending or self._destroyed then
		return
	end
	self._linkHoverPending = true
	task.defer(function()
		self._linkHoverPending = false
		if not self._destroyed then
			self:_refreshHoverLinks()
		end
	end)
end

-- Partie visible de la zone de travail (unités du canvas)
function Canvas:_visibleCanvasRect()
	local size = self.frame.AbsoluteSize
	local z = math.max(self.zoom, 0.05)
	local minX, minY = -self.panX / z, -self.panY / z
	return minX, minY, minX + size.X / z, minY + size.Y / z
end

-- Zone de travail affichée (fenêtre du plugin ouverte, taille non nulle)
function Canvas:_canvasShown()
	if self._destroyed or not self.frame or self.frame.Parent == nil then
		return false
	end
	local widget = self.host and self.host.widget
	if typeof(widget) == "Instance" then
		local ok, enabled = pcall(function()
			return widget.Enabled
		end)
		if ok and enabled == false then
			return false
		end
	end
	local size = self.frame.AbsoluteSize
	return size.X > 4 and size.Y > 4
end

-- Vrai si au moins une ligne à points lumineux est visible
function Canvas:_hasVisibleFlow()
	if not self.frame then
		return false
	end
	local minX, minY, maxX, maxY = self:_visibleCanvasRect()
	for _, list in ipairs({ self._baseLines, self._varLines }) do
		for _, line in ipairs(list) do
			local runners = line.runners
			if runners and #runners > 0 and line.runnersShown and line.container and line.container.Visible then
				if lineOnScreen(line, minX, minY, maxX, maxY) then
					return true
				end
			end
		end
	end
	return false
end

-- Une image de l'animation : chaque point lumineux avance le long de sa ligne (phase en unités du
-- canvas) ; seules les lignes visibles bougent, et une position n'est écrite que si elle change
function Canvas:_flowFrame(phase)
	if self._destroyed or not self.frame then
		return
	end
	local minX, minY, maxX, maxY = self:_visibleCanvasRect()
	local half = FLOW_DOT / 2
	for _, list in ipairs({ self._baseLines, self._varLines }) do
		for _, line in ipairs(list) do
			local runners = line.runners
			local len = tonumber(line.length) or 0
			if runners and #runners > 0 and len > 0 and line.runnersShown and line.container and line.container.Visible then
				if lineOnScreen(line, minX, minY, maxX, maxY) then
					local gap = line.runnerGap or len
					for k, runner in ipairs(runners) do
						local s = (phase + (k - 1) * gap) % len
						local p = pointAt(line.samples, line.cum, s)
						local x, y = round(p.X - half), round(p.Y - half)
						local last = line.runnerPos[k]
						if last == nil or last.X ~= x or last.Y ~= y then
							runner.Position = UDim2.fromOffset(x, y)
							line.runnerPos[k] = Vector2.new(x, y)
						end
						-- fondu près des deux bouts : un point qui repart du début n'apparaît pas d'un coup
						local edge = math.min(s, len - s)
						local alpha = 0
						if edge < FLOW_FADE then
							alpha = math.floor((1 - edge / FLOW_FADE) * 10 + 0.5) / 10
						end
						if line.runnerAlpha[k] ~= alpha then
							runner.BackgroundTransparency = alpha
							line.runnerAlpha[k] = alpha
						end
					end
				end
			end
		end
	end
end

-- Lance l'animation des points lumineux (une seule animation Anim de FLOW_CYCLE s, relancée à chaque
-- tour) quand une ligne qui en a est visible ; elle s'arrête d'elle-même sinon (fenêtre fermée, lignes
-- hors de la vue, animations désactivées)
function Canvas:_maybeStartFlow()
	if self._destroyed or self._flowHandle ~= nil or self._flowWaiting then
		return
	end
	if not Anim.enabled() or not self:_canvasShown() or not self:_hasVisibleFlow() then
		return
	end
	local started = os.clock()
	local base = self._flowBase or 0
	local handle = nil
	handle = Anim.step(function(_, a)
		if self._destroyed or (handle ~= nil and self._flowHandle ~= handle) then
			return
		end
		self:_flowFrame(base + (tonumber(a) or 0) * FLOW_CYCLE * FLOW_SPEED)
	end, FLOW_CYCLE, "linear", function()
		if handle ~= nil and self._flowHandle ~= handle then
			return
		end
		self._flowHandle = nil
		self._flowBase = (base + FLOW_CYCLE * FLOW_SPEED) % 1000000
		if self._destroyed then
			return
		end
		if os.clock() - started < 0.5 then
			-- fini tout de suite (animations coupées, trop d'animations à la fois) : nouvel essai plus tard
			self:_retryFlowLater()
			return
		end
		self:_maybeStartFlow()
	end, self._flowKey)
	if handle:isPlaying() then
		self._flowHandle = handle
	end
end

function Canvas:_retryFlowLater()
	if self._flowWaiting or self._destroyed then
		return
	end
	self._flowWaiting = true
	task.delay(3, function()
		self._flowWaiting = false
		if not self._destroyed then
			self:_maybeStartFlow()
		end
	end)
end

function Canvas:_stopFlow()
	local handle = self._flowHandle
	self._flowHandle = nil
	if handle then
		handle:cancel()
	end
end

-- Ligne la plus proche d'un point de l'écran (à moins de LINK_HIT px), ou nil
function Canvas:_linkAt(screenPos)
	if typeof(screenPos) ~= "Vector2" or not self.frame then
		return nil
	end
	local c = self:screenToCanvas(screenPos)
	local limit = LINK_HIT / math.max(self.zoom, 0.1)
	local best, bestD = nil, limit
	for _, list in ipairs({ self._baseLines, self._varLines }) do
		for _, line in ipairs(list) do
			local samples = line.samples
			local bb = line.bbox
			if samples and bb and line.container and line.container.Visible then
				if c.X >= bb.minX - limit and c.X <= bb.maxX + limit and c.Y >= bb.minY - limit and c.Y <= bb.maxY + limit then
					for i = 1, #samples - 1 do
						local d = distToSegment(c, samples[i], samples[i + 1])
						if d < bestD then
							best, bestD = line, d
						end
					end
				end
			end
		end
	end
	return best
end

-- Bloc le plus petit (le plus imbriqué) sous un point du canvas, ou nil
function Canvas:_blockAtCanvas(c)
	local best, bestArea = nil, math.huge
	for _, view in pairs(self.views) do
		if view.frame then
			local fp = view.frame.Position
			local ox, oy = fp.X.Offset, fp.Y.Offset
			local inside = c.X >= ox - 2 and c.Y >= oy - 2 and c.X <= ox + (view.width or 0) + 2 and c.Y <= oy + (view.height or 0) + 2
			if inside then
				for id, info in pairs(view.blocks or {}) do
					local x, y = ox + info.x, oy + info.y
					if c.X >= x and c.X <= x + info.w and c.Y >= y and c.Y <= y + info.h then
						local area = info.w * info.h
						if area < bestArea then
							best, bestArea = id, area
						end
					end
				end
			end
		end
	end
	return best
end

-- Cadre blanc translucide (fantôme d'aimantation) sur un rectangle du canvas
function Canvas:_showGhostRect(x, y, w, h, radius)
	if not self.ghost then
		return
	end
	self.ghost.Position = UDim2.fromOffset(round(x), round(y))
	self.ghost.Size = UDim2.fromOffset(math.max(4, round(w)), math.max(4, round(h)))
	if self.ghostCorner then
		self.ghostCorner.CornerRadius = UDim.new(0, radius or 8)
	end
	self.ghost.Visible = true
end

-- Ajoute une ligne tracée à la main entre deux blocs, puis commit (une étape d'annulation)
function Canvas:_addManualLink(model, fromId, toId)
	if type(model.liens) == "table" then
		for _, link in pairs(model.liens) do
			if type(link) == "table" and link.de == fromId and link.vers == toId then
				self:_status("Ces deux blocs sont déjà reliés par une ligne.", "info")
				return
			end
		end
	end
	local ok, linkId = pcall(model.addLink, model, fromId, toId, {})
	if not ok or linkId == nil or linkId == false then
		self:_status("Impossible de relier ces deux blocs.", "error")
		return
	end
	self:_commit("lien")
	self:_flashBlocks(model, { toId })
	self:_status("Ligne tracée : clic droit dessus pour lui écrire un petit texte, changer son style ou sa couleur.", "success")
end

-- « Relier à un autre bloc… » : une ligne suit la souris depuis le bloc ; le prochain clic sur un autre
-- bloc la trace (Échap, clic droit ou clic sur le fond : annulé)
function Canvas:_beginLinkMode(fromId)
	local model = self.getModel()
	if self._destroyed or self._tracking or not model or type(model.addLink) ~= "function" or model:get(fromId) == nil then
		return
	end
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	local band = Util.create("Frame", {
		Name = "LigneEnCours",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(1, 1),
		ZIndex = Z_GHOST - 1,
		Parent = self.world,
	})
	local dots = {}
	local linking = { from = fromId, model = model }
	self._linking = linking
	self:_updateRings()

	local function targetAt(p)
		if not self:_overCanvas(p) or self:_overPalette(p) then
			return nil
		end
		local id = self:_blockAtCanvas(self:screenToCanvas(p))
		if id == nil or id == fromId then
			return nil
		end
		return id
	end
	local function draw(p)
		if band.Parent == nil or self.getModel() ~= model then
			return
		end
		local a = self:_linkEnd(model, fromId)
		if not a then
			return
		end
		local targetId = targetAt(p)
		local b = nil
		if targetId ~= nil then
			b = self:_linkEnd(model, targetId)
		end
		if b then
			self:_showGhostRect(b.x - 4, b.ry - 4, b.w + 8, b.rh + 8, 8)
		else
			self:_hideGhost()
			local c = self:screenToCanvas(p)
			b = { x = c.X, w = 0, cy = c.Y }
		end
		local p0, c1, c2, p3 = linkCurve(a, b)
		local samples, cum, length = sampleCurve(p0, c1, c2, p3)
		local spacing = LINK_SPACING
		local count = math.floor(length / spacing) + 1
		if count > LINK_BAND_DOTS then
			count = LINK_BAND_DOTS
			spacing = length / (LINK_BAND_DOTS - 1)
		end
		for i = 1, count do
			local dot = dots[i]
			if not dot then
				dot = Util.create("Frame", {
					Name = "Point",
					BackgroundColor3 = LINK_COLORS.manuel,
					BorderSizePixel = 0,
					Active = false,
					Size = UDim2.fromOffset(4, 4),
					ZIndex = 1,
					Parent = band,
				})
				Util.corner(dot, 2)
				dots[i] = dot
			end
			local q = pointAt(samples, cum, (i - 1) * spacing)
			dot.Position = UDim2.fromOffset(round(q.X - 2), round(q.Y - 2))
			dot.Visible = true
		end
		for i = count + 1, #dots do
			dots[i].Visible = false
		end
	end
	local function cleanup()
		if self._linking == linking then
			self._linking = nil
		end
		pcall(function()
			band:Destroy()
		end)
		self:_hideGhost()
		if not self._destroyed then
			self:_updateRings()
		end
	end

	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		sticky = true,
		onMove = draw,
		onCancel = cleanup,
		onEnd = function(p, how)
			cleanup()
			if self._destroyed then
				return
			end
			if how ~= "clic" then
				self:_status("Ligne annulée.", "info")
				return
			end
			if self.getModel() ~= model or model:get(fromId) == nil then
				return
			end
			local targetId = targetAt(p)
			if targetId == nil or model:get(targetId) == nil then
				self:_status("Ligne annulée : pour relier deux blocs, clique sur le deuxième bloc.", "info")
				return
			end
			self:_addManualLink(model, fromId, targetId)
		end,
	})
	draw(self:_mouse())
	self:_status("Clique sur le bloc à relier (Échap ou clic droit : annuler).", "info")
	if self.dialogs then
		self.dialogs:toast("Clique sur le deuxième bloc pour tracer la ligne · Échap pour annuler", "info")
	end
end

-- Modifie une ligne tracée à la main puis enregistre
function Canvas:_setLinkFields(model, linkId, fields)
	if type(model.setLink) ~= "function" then
		return
	end
	local ok, result = pcall(model.setLink, model, linkId, fields)
	if ok and result ~= false then
		self:_commit("lien")
	else
		self:_status("Impossible de modifier cette ligne.", "error")
	end
end

-- « Renommer la ligne » : petit texte écrit sur la ligne
function Canvas:_renameLink(model, line)
	if not self.dialogs then
		return
	end
	self.dialogs:prompt(
		"Renommer la ligne",
		"Petit texte écrit sur la ligne (laisse vide pour l'enlever) :",
		tostring(line.label or ""),
		function(text)
			if self._destroyed or self.getModel() ~= model then
				return
			end
			local clean = Util.trim(tostring(text or ""))
			clean = (string.gsub(clean, "[\r\n]+", " "))
			if clean == (line.label or "") then
				return
			end
			self:_setLinkFields(model, line.id, { texte = clean })
		end
	)
end

-- Menu du clic droit d'une ligne (ou de son étiquette)
function Canvas:_linkMenu(line)
	if self._destroyed or self._tracking or not self.dialogs or type(line) ~= "table" then
		return
	end
	local model = self.getModel()
	if not model or model:get(line.from) == nil or model:get(line.to) == nil then
		return
	end
	self._kbActive = true
	local items
	if line.kind == "manuel" then
		local link = type(model.liens) == "table" and model.liens[line.id] or nil
		local canEdit = link ~= nil and type(model.setLink) == "function"
		local styleItems = {}
		for _, s in ipairs(LINK_STYLES) do
			table.insert(styleItems, { label = s[1], value = "style:" .. s[2], checked = line.style == s[2] })
		end
		local colorItems = {}
		for i, entry in ipairs(MANUAL_LINK_COLORS) do
			table.insert(colorItems, { label = entry[1], value = "couleur:" .. i, checked = sameRgb(line.color, entry[2]) })
		end
		local hint = nil
		if line.label ~= "" then
			hint = firstLine(line.label, 16)
		end
		items = {
			{ label = "Renommer la ligne", value = "renommer", hint = hint, hidden = not canEdit },
			{ label = "Style", submenu = styleItems, hidden = not canEdit },
			{ label = "Couleur", icon = "●", submenu = colorItems, hidden = not canEdit },
			"separator",
			{ label = "Aller au bloc de départ", value = "depart", icon = "←" },
			{ label = "Aller au bloc d'arrivée", value = "arrivee", icon = "→" },
			"separator",
			{
				label = "Supprimer la ligne",
				value = "supprimer",
				icon = "×",
				danger = true,
				hidden = link == nil or type(model.removeLink) ~= "function",
			},
		}
	else
		local startHint, endHint = "envoie", "reçoit"
		if line.kind == "module" then
			startHint, endHint = "appelle", "la fonction"
		elseif line.kind == "variable" then
			startHint, endHint = "change", "utilise"
		end
		items = {
			{ label = "Aller au bloc de départ", value = "depart", icon = "←", hint = startHint },
			{ label = "Aller au bloc d'arrivée", value = "arrivee", icon = "→", hint = endHint },
			"separator",
			{ label = "Réglages des lignes…", value = "reglages", hidden = type(self.deps.openSettings) ~= "function" },
		}
	end
	self.dialogs:menu(self:_mouse(), items, function(value)
		if self._destroyed or self.getModel() ~= model then
			return
		end
		if value == "depart" then
			self:focusBlock(line.from)
		elseif value == "arrivee" then
			self:focusBlock(line.to)
		elseif value == "reglages" then
			self:_callDep("openSettings", "zone")
		elseif value == "renommer" then
			self:_renameLink(model, line)
		elseif type(value) == "string" and string.sub(value, 1, 6) == "style:" then
			local style = string.sub(value, 7)
			if LINK_STYLE_SET[style] and style ~= line.style then
				self:_setLinkFields(model, line.id, { style = style })
			end
		elseif type(value) == "string" and string.sub(value, 1, 8) == "couleur:" then
			local entry = MANUAL_LINK_COLORS[tonumber(string.sub(value, 9)) or 0]
			if entry then
				self:_setLinkFields(model, line.id, { couleur = { entry[2][1], entry[2][2], entry[2][3] } })
			end
		elseif value == "supprimer" then
			if type(model.removeLink) ~= "function" then
				return
			end
			local ok, result = pcall(model.removeLink, model, line.id)
			if ok and result ~= false then
				self:_commit("lien")
				self:_status("Ligne supprimée (Ctrl+Z pour annuler).", "info")
			else
				self:_status("Impossible de supprimer cette ligne.", "error")
			end
		end
	end)
end

-- Lignes dessinées (pour les tests, DevBridge) : { { kind, from, to, id, label, style, visible } }
function Canvas:getLinks()
	local out = {}
	for _, list in ipairs({ self._baseLines or {}, self._varLines or {} }) do
		for _, line in ipairs(list) do
			table.insert(out, {
				kind = line.kind,
				from = line.from,
				to = line.to,
				id = line.id,
				label = line.label,
				style = line.style,
				visible = line.container ~= nil and line.container.Visible == true,
			})
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Mini-carte (SPEC §32) : les piles en rectangles colorés, la partie visible en cadre blanc
---------------------------------------------------------------------------

function Canvas:_buildMinimap()
	local mini = Util.create("TextButton", {
		Name = "MiniCarte",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -48),
		Size = UDim2.fromOffset(MINI_W, MINI_H),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = Z_FLOATING,
		Parent = self.frame,
	})
	Util.corner(mini, 8)
	Util.stroke(mini, Theme.Colors.PanelBorder, 1)
	self.minimap = mini
	self.miniContent = Util.create("Frame", {
		Name = "Piles",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_FLOATING + 1,
		Parent = mini,
	})
	self.miniView = Util.create("Frame", {
		Name = "Vue",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = Z_FLOATING + 3,
		Parent = mini,
	})
	Util.corner(self.miniView, 3)
	Util.stroke(self.miniView, WHITE, 1.5, 0.15)
	local c = self.connections
	table.insert(c, mini.MouseButton1Down:Connect(function()
		self:_beginMinimapPan()
	end))
	table.insert(c, mini.InputChanged:Connect(function(input)
		self:_onInputChanged(input)
	end))
	table.insert(c, mini.MouseEnter:Connect(function()
		if self.dialogs and not self._tracking then
			self.dialogs:tooltip("Mini-carte : clique ou glisse pour te déplacer", self:_mouse())
		end
	end))
	table.insert(c, mini.MouseLeave:Connect(function()
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
	end))
end

-- Redessine la mini-carte (cachée si désactivée dans les réglages, s'il y a moins de 2 piles ou si
-- la zone est trop petite). Pendant un glissement sur la mini-carte, son échelle reste fixe.
function Canvas:_updateMinimap()
	local mini = self.minimap
	if self._destroyed or not mini or not self.frame then
		return
	end
	local size = self.frame.AbsoluteSize
	local entries = {}
	for rootId, view in pairs(self.views) do
		if view.frame then
			local fp = view.frame.Position
			table.insert(entries, { id = rootId, x = fp.X.Offset, y = fp.Y.Offset, w = view.width or 40, h = view.height or 30 })
		end
	end
	local show = miniMapEnabled() and #entries >= 2 and size.X >= 420 and size.Y >= 300
	if not show then
		mini.Visible = false
		self._miniMap = nil
		return
	end
	local a = self:screenToCanvas(self.frame.AbsolutePosition)
	local b = self:screenToCanvas(self.frame.AbsolutePosition + size)
	local map = self._miniFrozen
	if map == nil then
		local minX, minY = math.min(a.X, b.X), math.min(a.Y, b.Y)
		local maxX, maxY = math.max(a.X, b.X), math.max(a.Y, b.Y)
		for _, e in ipairs(entries) do
			minX = math.min(minX, e.x)
			minY = math.min(minY, e.y)
			maxX = math.max(maxX, e.x + e.w)
			maxY = math.max(maxY, e.y + e.h)
		end
		local bw, bh = math.max(1, maxX - minX), math.max(1, maxY - minY)
		local innerW, innerH = MINI_W - 2 * MINI_PAD, MINI_H - 2 * MINI_PAD
		local scale = math.min(innerW / bw, innerH / bh)
		map = {
			minX = minX,
			minY = minY,
			scale = scale,
			offX = MINI_PAD + (innerW - bw * scale) / 2,
			offY = MINI_PAD + (innerH - bh * scale) / 2,
		}
	end
	self._miniMap = map
	mini.Visible = true
	local model = self.getModel()
	for i, e in ipairs(entries) do
		local rect = self._miniRects[i]
		if not rect then
			rect = Util.create("Frame", {
				Name = "Pile",
				BorderSizePixel = 0,
				Active = false,
				ZIndex = Z_FLOATING + 2,
				Parent = self.miniContent,
			})
			Util.corner(rect, 2)
			self._miniRects[i] = rect
		end
		rect.Position = UDim2.fromOffset(round(map.offX + (e.x - map.minX) * map.scale), round(map.offY + (e.y - map.minY) * map.scale))
		rect.Size = UDim2.fromOffset(math.max(2, round(e.w * map.scale)), math.max(2, round(e.h * map.scale)))
		rect.BackgroundColor3 = self:_blockColor(model, e.id)
		rect.Visible = true
	end
	for k = #entries + 1, #self._miniRects do
		self._miniRects[k].Visible = false
	end
	local vx = map.offX + (math.min(a.X, b.X) - map.minX) * map.scale
	local vy = map.offY + (math.min(a.Y, b.Y) - map.minY) * map.scale
	self.miniView.Position = UDim2.fromOffset(round(vx), round(vy))
	self.miniView.Size = UDim2.fromOffset(math.max(4, round(math.abs(b.X - a.X) * map.scale)), math.max(4, round(math.abs(b.Y - a.Y) * map.scale)))
end

-- La vue a bougé (déplacement, zoom) : la mini-carte suit
function Canvas:_updateMinimapView()
	if self.minimap and (self.minimap.Visible or self._miniFrozen) then
		self:_updateMinimap()
	end
end

-- Clic / glissement sur la mini-carte : centre la vue sur le point visé
function Canvas:_beginMinimapPan()
	if self._destroyed or self._tracking or not self._miniMap then
		return
	end
	self._kbActive = true
	self:_stopViewAnimation()
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	self._miniFrozen = self._miniMap
	local function centerOn(p)
		local map = self._miniFrozen
		if not map or not self.minimap then
			return
		end
		local localPos = p - self.minimap.AbsolutePosition
		local cx = map.minX + (localPos.X - map.offX) / map.scale
		local cy = map.minY + (localPos.Y - map.offY) / map.scale
		local size = self.frame.AbsoluteSize
		self:_setPan(size.X / 2 - cx * self.zoom, size.Y / 2 - cy * self.zoom)
	end
	centerOn(self:_mouse())
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = centerOn,
		onEnd = function()
			self._miniFrozen = nil
			self:_updateMinimap()
		end,
	})
end

---------------------------------------------------------------------------
-- Glisser un objet de la palette qui n'est pas un bloc (cartes « Modèles », SPEC §22.2)
---------------------------------------------------------------------------

-- spec = { visual = GuiObject (posé dans dragLayer et détruit à la fin), grab = Vector2 (point saisi
-- dans visual, en pixels), onDrop = fn(screenPos, how) } ; how = "clic" (pas de déplacement),
-- "depose" (lâché sur la zone de travail), "dehors" (ailleurs) ou "annule". Renvoie true si commencé.
function Canvas:beginGhostDrag(spec)
	if self._destroyed or type(spec) ~= "table" or typeof(spec.visual) ~= "Instance" then
		return false
	end
	if self._tracking or self.drag then
		return false
	end
	local layer = self.dragLayer or self.frame
	local visual = spec.visual
	local grab = Vector2.new(20, 20)
	if typeof(spec.grab) == "Vector2" then
		grab = spec.grab
	end
	local start = self:_mouse()
	local moved = false
	pcall(function()
		visual.Visible = false
		visual.ZIndex = Z_DRAG
		visual.Parent = layer
	end)
	local function place(p)
		local origin = layer.AbsolutePosition
		visual.Position = UDim2.fromOffset(round(p.X - grab.X - origin.X), round(p.Y - grab.Y - origin.Y))
	end
	if self.dialogs then
		self.dialogs:hideTooltip()
	end
	self:_startTracking({
		endType = Enum.UserInputType.MouseButton1,
		onMove = function(p)
			if not moved and (p - start).Magnitude >= DRAG_THRESHOLD then
				moved = true
				visual.Visible = true
				Anim.popIn(visual, 0.9)
			end
			if moved then
				place(p)
			end
		end,
		onEnd = function(p, how)
			pcall(function()
				visual:Destroy()
			end)
			local result
			if not moved then
				result = "clic"
			elseif how == "focus" or how == "annule" then
				result = "annule"
			elseif self:_overCanvas(p) and not self:_overPalette(p) then
				result = "depose"
			else
				result = "dehors"
			end
			if type(spec.onDrop) == "function" then
				local ok, err = pcall(spec.onDrop, p, result)
				if not ok then
					warn("[Blocs FR] Canvas : " .. tostring(err))
				end
			end
		end,
	})
	return true
end

---------------------------------------------------------------------------
-- Ranger
---------------------------------------------------------------------------

-- « Ranger » : piles en colonnes (événements d'abord, puis de haut en bas), puis commit
function Canvas:cleanUp()
	if self._destroyed then
		return
	end
	local model = self.getModel()
	if not model or type(model.tops) ~= "table" or #model.tops == 0 then
		return
	end
	if self.drag then
		self:_abortDrag()
	end
	-- les notes attachées suivent leur pile
	local anchors = self:_captureNoteAnchors(model)
	local tops = table.clone(model.tops)
	local info = {}
	for i, id in ipairs(tops) do
		local block = model:get(id)
		local def = model:def(id)
		local ok, w, h = pcall(Renderer.measure, model, id)
		if not ok then
			w, h = 120, 40
		end
		info[id] = {
			hat = def ~= nil and def.shape == "hat",
			x = (block and tonumber(block.x)) or 0,
			y = (block and tonumber(block.y)) or 0,
			w = w,
			h = h,
			i = i,
		}
	end
	table.sort(tops, function(a, b)
		local ia, ib = info[a], info[b]
		if ia.hat ~= ib.hat then
			return ia.hat
		end
		if ia.y ~= ib.y then
			return ia.y < ib.y
		end
		if ia.x ~= ib.x then
			return ia.x < ib.x
		end
		return ia.i < ib.i
	end)
	local gap = Theme.Block.StackGap or 40
	local viewH = self.frame.AbsoluteSize.Y / self.zoom
	local maxColumnH = math.max(400, viewH - 2 * CLEAN_MARGIN)
	local x, y, colW = CLEAN_MARGIN, CLEAN_MARGIN, 0
	for _, id in ipairs(tops) do
		local it = info[id]
		if y > CLEAN_MARGIN and y + it.h > CLEAN_MARGIN + maxColumnH then
			x += colW + gap
			y = CLEAN_MARGIN
			colW = 0
		end
		model:moveTo(id, x, y)
		y += it.h + gap
		colW = math.max(colW, it.w)
	end
	self:_followNotes(model, anchors)
	self:_stopViewAnimation()
	self:_setPan(0, 0)
	self:_commit("ranger")
end

---------------------------------------------------------------------------
-- Destruction
---------------------------------------------------------------------------

function Canvas:destroy()
	if self._destroyed then
		return
	end
	self:_cancelTracking()
	if self.drag then
		self:_destroyDragVisual(self.drag)
		self.drag = nil
	end
	self:_stopViewAnimation()
	self:_stopPulses()
	self:_stopFlow()
	self:_hideGhost()
	self:_setDeleteHint(false)
	self._palette = nil
	self._destroyed = true
	self._miniFrozen = nil
	self._linking = nil
	self:_clearRings()
	pcall(function()
		self._noteMaid:clean()
	end)
	self._noteViews = {}
	pcall(function()
		self._linkMaid:clean()
		self._varLinkMaid:clean()
	end)
	self._baseLines = {}
	self._varLines = {}
	for _, view in pairs(self.views) do
		pcall(function()
			view:destroy()
		end)
	end
	self.views = {}
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	for _, f in ipairs(self._flashes) do
		pcall(function()
			f:Destroy()
		end)
	end
	self._flashes = {}
	pcall(function()
		self.ZoomChanged:Destroy()
	end)
	pcall(function()
		self.SelectionChanged:Destroy()
	end)
	if self.frame then
		self.frame:Destroy()
		self.frame = nil
	end
end

return Canvas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Categories</string><ProtectedString name="Source"><![CDATA[-- Catégories de blocs (ordre de la palette : 2 colonnes, de gauche à droite puis de haut en bas)
-- color : couleur des blocs (texte blanc lisible, contraste >= 4,5:1)
-- dot   : pastille plus claire, visible sur le fond sombre de la palette

return {
	{ id = "evenements", name = "Événements", color = Color3.fromRGB(160, 86, 26), dot = Color3.fromRGB(215, 122, 53), module = "Defs_Evenements" },
	{ id = "debogage", name = "Débogage", color = Color3.fromRGB(194, 65, 12), dot = Color3.fromRGB(232, 102, 42), module = "Defs_Debogage" },
	{ id = "controle", name = "Contrôle", color = Color3.fromRGB(154, 103, 0), dot = Color3.fromRGB(210, 154, 28), module = "Defs_Controle" },
	{ id = "variables", name = "Variables", color = Color3.fromRGB(192, 54, 44), dot = Color3.fromRGB(226, 87, 74), module = "Defs_Variables" },
	{ id = "actions", name = "Actions", color = Color3.fromRGB(169, 34, 181), dot = Color3.fromRGB(207, 75, 217), module = "Defs_Actions" },
	{ id = "monde", name = "Monde", color = Color3.fromRGB(61, 90, 254), dot = Color3.fromRGB(109, 132, 255), module = "Defs_Monde" },
	{ id = "joueurs", name = "Joueurs", color = Color3.fromRGB(15, 118, 110), dot = Color3.fromRGB(43, 179, 163), module = "Defs_Joueurs" },
	{ id = "apparence", name = "Apparence", color = Color3.fromRGB(124, 58, 237), dot = Color3.fromRGB(155, 107, 242), module = "Defs_Apparence" },
	{ id = "operateurs", name = "Opérateurs", color = Color3.fromRGB(59, 125, 35), dot = Color3.fromRGB(95, 174, 60), module = "Defs_Operateurs" },
	{ id = "valeurs", name = "Valeurs", color = Color3.fromRGB(3, 105, 161), dot = Color3.fromRGB(58, 154, 216), module = "Defs_Valeurs" },
	{ id = "interface", name = "Interface", color = Color3.fromRGB(14, 116, 144), dot = Color3.fromRGB(34, 211, 238), module = "Defs_Interface" },
	{ id = "camera", name = "Caméra", color = Color3.fromRGB(90, 118, 8), dot = Color3.fromRGB(190, 242, 100), module = "Defs_Camera" },
	{ id = "vfx", name = "Effets", color = Color3.fromRGB(180, 30, 150), dot = Color3.fromRGB(240, 110, 210), module = "Defs_Effets" },
	{ id = "toutprets", name = "Tout prêts", color = Color3.fromRGB(190, 24, 93), dot = Color3.fromRGB(236, 72, 153), module = "Defs_ToutPrets" },
	{ id = "modules", name = "Modules", color = Color3.fromRGB(71, 85, 105), dot = Color3.fromRGB(148, 163, 184), module = "Defs_Modules" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">CodeGen</string><ProtectedString name="Source"><![CDATA[-- CodeGen : compile un projet de blocs (Model, ou ses données sérialisées) en script Luau.
-- Voir SPEC §5.3 (contexte g), §5.4 (fonctions utiles), §5.5 (forme du script) et §8.
--
-- NOTE: choix de robustesse (le code produit doit rester valide pour toute combinaison de blocs) :
--   * un événement sans aucun bloc en dessous n'est pas émis : un commentaire le signale (+ avertissement) ;
--   * une instruction qui commence par « ( », ou dont la dernière ligne est return / break / continue,
--     est entourée de « do … end » (ambiguïté d'appel en Luau ; return/break doivent terminer un bloc) ;
--   * en mode local, la ligne de contexte est protégée si Players.LocalPlayer vaut nil ;
--   * les variables utilisées par des blocs mais absentes de la liste du projet sont aussi initialisées à 0 ;
--   * un bloc valeur branché dans une case qui n'en accepte pas (variable, menu simple) est ignoré.
--
-- Table des lignes (SPEC §17) : pendant la génération, chaque événement et chaque instruction émis
-- sont entourés de deux lignes de commentaire « --@<id du bloc> » (début) et « --@/ » (fin).
-- Ce sont des commentaires placés entre deux instructions : ils ne changent rien au code. Une fois
-- le script assemblé, ces lignes sont retirées et leurs positions donnent
-- result.lineMap = { { line = n, last = m, block = id, def = idDeDefinition }, … } (lignes du code
-- FINAL ; l'en-tête et les fonctions utiles n'apparaissent pas). Le code final est identique, ligne
-- pour ligne, à celui produit sans marqueurs. NOTE: « last » (dernière ligne de la zone du bloc)
-- s'ajoute à la SPEC ; les zones sont imbriquées (un bloc C contient les blocs de son corps).
-- Si l'extraction échouait, le code est régénéré sans marqueurs (lineMap = {}).
--
-- Mode « module » (SPEC §20) : même en-tête de contexte qu'un script serveur, « local Module = {} »
-- juste avant les événements et « return Module » ajouté à la toute fin, APRÈS le calcul de la table
-- des lignes (les numéros de lignes ne changent pas). g.hatDefId = id de définition du chapeau qui
-- contient le bloc en cours (nil hors d'un chapeau) ; g.inFunction() = vrai dans le corps d'un
-- chapeau dont la définition a « functionBody = true » (« Définir la fonction »), sauf dans un corps
-- « newFunction » (lancer en parallèle, après … secondes). Un chapeau avec « emitEmpty = true » est
-- généré même sans bloc dessous (BODY = ""). Les modes « server » et « local » sont inchangés.
--
-- Blocs désactivés (SPEC §32, champ de bloc disabled = true) : une instruction désactivée est sautée
-- avec ses corps (la suite de la pile continue), un événement désactivé est remplacé par rien, un
-- bloc valeur désactivé laisse sa case à sa valeur écrite. result.disabled = nombre de blocs
-- désactivés rencontrés (NOTE: en plus de la SPEC).
-- Notes (SPEC §29, model.notes) : quand le réglage code.notes est vrai (par défaut), une note
-- attachée à un bloc devient des lignes « -- Note : … » / « --   … » (90 caractères au plus) juste
-- au-dessus du code de son bloc : elles font partie de la zone du bloc dans la table des lignes. Une
-- note attachée à un bloc valeur va au-dessus de l'instruction qui le contient. Les notes libres
-- vont sous « -- Notes » juste après l'en-tête (« -- Note (libre) : … »). Le texte est nettoyé :
-- jamais de saut de ligne ni de caractère de contrôle dans une ligne de commentaire.
-- Réglage code.entete (par défaut vrai) : faux = l'en-tête se réduit à sa première ligne
-- (« -- Script généré par Blocs FR (…) », lue par CodeView pour reconnaître le type de script).
-- Les réglages viennent de Reglages.current() (chargé avec pcall au moment de la génération) ; le
-- 3e argument de CodeGen.generate (NOTE: en plus de la SPEC) peut les forcer.

local Registry = require(script.Parent.Registry)
local Util = require(script.Parent.Util)

local CodeGen = {}

local TAB = "\t"
local MAX_DEPTH = 100 -- imbrication maximale (corps de blocs C + blocs valeur)
local MAX_CHAIN = 20000 -- garde-fou contre une pile « next » circulaire
local MAX_MESSAGE = 240 -- longueur maximale d'un message (octets)
local MAX_TOP_LOCALS = 190 -- au-delà : avertissement (limite Luau : 200 locales actives)
local MARKER_PREFIX = "--@" -- début de la zone d'un bloc : « --@<clé> » sur sa propre ligne
local MARKER_END = "--@/" -- fin de la zone du dernier bloc ouvert
local MAX_MARKER_ID = 60 -- au-delà (ou caractères spéciaux), la clé du marqueur est « #<n> »

local KEYWORDS = {
	["and"] = true,
	["break"] = true,
	["do"] = true,
	["else"] = true,
	["elseif"] = true,
	["end"] = true,
	["false"] = true,
	["for"] = true,
	["function"] = true,
	["if"] = true,
	["in"] = true,
	["local"] = true,
	["nil"] = true,
	["not"] = true,
	["or"] = true,
	["repeat"] = true,
	["return"] = true,
	["then"] = true,
	["true"] = true,
	["until"] = true,
	["while"] = true,
}

local MODE_LABEL = {
	server = "script serveur",
	["local"] = "script local",
	module = "script module",
}

-- NOTE: tutoiement comme tout le plugin (la SPEC §5.5 écrivait « Ne modifiez pas … rouvrez … ») ; rien ne lit
-- cette 2e ligne (CodeView ne lit que la 1re).
local HEADER_WARNING = "-- ⚠ Ne modifie pas ce code à la main : rouvre l'éditeur de blocs (plugin Blocs FR)."
local NO_HAT_COMMENT = "-- Aucun bloc événement : ajoute par exemple « Quand ce script démarre »."
local ALL_HATS_DISABLED_COMMENT = "-- Tous les événements sont désactivés : clic droit sur un bloc, puis « Réactiver »."

-- Notes de la zone de travail (SPEC §29)
local NOTES_SECTION = "-- Notes"
local NOTE_PREFIX = "-- Note : "
local NOTE_PREFIX_FREE = "-- Note (libre) : "
local NOTE_NEXT = "--   "
local NOTE_WRAP = 90 -- caractères de texte au plus par ligne de commentaire
local NOTE_MAX_BYTES = 5000
local TODO_SEPARATORS = { " ", ":", "-", "–", "—", ",", ".", "!" }

-- Mode « module » (SPEC §20)
local MODULE_TABLE = "Module" -- table renvoyée par le script module
local MODULE_USAGE = {
	"-- Ce script module ne s'exécute pas tout seul : il démarre la première fois qu'un autre script le",
	"-- charge avec require(…), qui renvoie la table « Module » (ses fonctions et ses valeurs).",
	"-- Avec Blocs FR : blocs « appeler la fonction … du module … », « résultat de … » et « valeur … du",
	"-- module … » (catégorie Modules). En Luau : require(chemin.vers.BlocsModule).maFonction(…)",
}
local MODULE_TABLE_COMMENT = "-- Module : la table renvoyée à « require » (fonctions et valeurs du module)"
local MODULE_SECTION = "-- Fonctions et événements du module"
local NO_HAT_COMMENT_MODULE = "-- Aucun bloc : ajoute par exemple « Définir la fonction … » (catégorie Modules)."

local CONTEXT_SERVER = {
	'local joueur, personnage, partieTouchee, deltaTemps, messageChat, dernierObjet = nil, nil, nil, 0, "", nil',
}

local CONTEXT_LOCAL = {
	'local joueur = game:GetService("Players").LocalPlayer',
	"local personnage = joueur and joueur.Character",
	'local partieTouchee, deltaTemps, messageChat, dernierObjet = nil, 0, "", nil',
	"if joueur then",
	"\tjoueur.CharacterAdded:Connect(function(p) personnage = p end)",
	"end",
}

---------------------------------------------------------------------------
-- Petites fonctions de texte
---------------------------------------------------------------------------

local function isPlainIdentifier(s)
	return type(s) == "string" and Util.isIdentifier(s) and not KEYWORDS[s]
end

-- Identifiant ou chemin d'identifiants séparés par des points (ex. "Enum.Material.Neon")
local function isSafePath(s)
	if type(s) ~= "string" or s == "" then
		return false
	end
	if s == "true" or s == "false" or s == "nil" then
		return true
	end
	if not string.match(s, "^[%w_%.]+$") then
		return false
	end
	if string.sub(s, 1, 1) == "." or string.sub(s, -1) == "." or string.find(s, "..", 1, true) then
		return false
	end
	for segment in string.gmatch(s, "[^%.]+") do
		if not isPlainIdentifier(segment) then
			return false
		end
	end
	return true
end

-- Coupe une chaîne sans casser un caractère UTF-8
local function truncateUtf8(s, maxBytes)
	if #s <= maxBytes then
		return s
	end
	local cut = maxBytes
	while cut > 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b < 0x80 or b >= 0xC0 then
			break
		end
		cut -= 1
	end
	return string.sub(s, 1, cut) .. "…"
end

-- Texte sur une seule ligne (pour les commentaires et les messages)
local function oneLine(value, maxBytes)
	local s = tostring(value)
	s = string.gsub(s, "%c+", " ")
	s = Util.trim(s)
	return truncateUtf8(s, maxBytes or MAX_MESSAGE)
end

local function isBlank(s)
	return s == nil or string.match(s, "^%s*$") ~= nil
end

-- Retire les lignes vides du début et les espaces de la fin (garde l'indentation de la 1re ligne)
local function stripBlankEdges(code)
	code = string.gsub(code, "\r\n", "\n")
	code = string.gsub(code, "^%s*\n", "")
	code = string.gsub(code, "%s+$", "")
	return code
end

-- Ajoute une tabulation devant chaque ligne non vide ; "" -> ""
local function indent(code)
	if code == nil then
		return ""
	end
	code = tostring(code)
	if code == "" then
		return ""
	end
	local out = {}
	for line in string.gmatch(code .. "\n", "(.-)\n") do
		if string.match(line, "^%s*$") then
			table.insert(out, "")
		else
			table.insert(out, TAB .. line)
		end
	end
	return table.concat(out, "\n")
end

-- Vrai si l'instruction doit être protégée par "do ... end"
local function needsDoBlock(code)
	local first = string.match(code, "^%s*(%S)")
	if first == "(" then
		return true
	end
	-- dernière ligne (parcours depuis la fin : linéaire même pour un très long code)
	local i = #code
	while i > 0 and string.byte(code, i) ~= 10 do
		i -= 1
	end
	local lastLine = string.sub(code, i + 1)
	local word = string.match(lastLine, "^%s*([%a_][%w_]*)")
	return word == "return" or word == "break" or word == "continue"
end

local function wrapDo(code)
	if not string.find(code, "\n", 1, true) and not string.find(code, "--", 1, true) then
		return "do " .. Util.trim(code) .. " end"
	end
	return "do\n" .. indent(code) .. "\nend"
end

local function labelOf(def)
	if type(def) ~= "table" then
		return "?"
	end
	local ok, text = pcall(Registry.plainLabel, def)
	if ok and type(text) == "string" then
		return oneLine(text, 120)
	end
	return tostring(def.id)
end

local function finiteOr0(x)
	local n = tonumber(x) or 0
	if n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return n
end

---------------------------------------------------------------------------
-- Notes -> commentaires (SPEC §29)
---------------------------------------------------------------------------

-- Texte UTF-8 valide et de longueur limitée, fins de ligne « \n » seulement
local function cleanNoteText(text)
	if type(text) == "number" then
		text = tostring(text)
	end
	if type(text) ~= "string" then
		return ""
	end
	if #text > NOTE_MAX_BYTES then
		text = truncateUtf8(text, NOTE_MAX_BYTES)
	end
	if utf8.len(text) == nil then
		text = string.gsub(text, "[\128-\255]", "?")
	end
	text = string.gsub(text, "\r\n", "\n")
	text = string.gsub(text, "\r", "\n")
	return text
end

-- Mot plus long qu'une ligne : coupé tous les `width` caractères (texte UTF-8 valide)
local function splitLongWord(word, width)
	local parts = {}
	local chars = {}
	for _, code in utf8.codes(word) do
		table.insert(chars, utf8.char(code))
		if #chars >= width then
			table.insert(parts, table.concat(chars))
			chars = {}
		end
	end
	if #chars > 0 then
		table.insert(parts, table.concat(chars))
	end
	return parts
end

-- Coupe un paragraphe (sans saut de ligne) en lignes de `width` caractères au plus, aux espaces
local function wrapParagraph(text, width)
	local lines = {}
	local current, currentLen = "", 0
	local function add(word, len)
		if currentLen == 0 then
			current, currentLen = word, len
		elseif currentLen + 1 + len <= width then
			current = current .. " " .. word
			currentLen += 1 + len
		else
			table.insert(lines, current)
			current, currentLen = word, len
		end
	end
	for word in string.gmatch(text, "%S+") do
		local len = utf8.len(word) or #word
		if len > width then
			for _, part in ipairs(splitLongWord(word, width)) do
				add(part, utf8.len(part) or #part)
			end
		else
			add(word, len)
		end
	end
	if currentLen > 0 then
		table.insert(lines, current)
	end
	return lines
end

-- « à faire : ajouter un son » -> « À FAIRE — ajouter un son » (comme l'en-tête de la note)
local function markTodo(line)
	local first, rest = string.match(line, "^(%S+)%s+(.*)$")
	if first == nil or Util.fold(first) ~= "a" then
		return line
	end
	local word, after = string.match(rest, "^(%a+)(.*)$")
	if word == nil or string.lower(word) ~= "faire" then
		return line
	end
	local changed = true
	while changed and after ~= "" do
		changed = false
		for _, sep in ipairs(TODO_SEPARATORS) do
			if string.sub(after, 1, #sep) == sep then
				after = string.sub(after, #sep + 1)
				changed = true
			end
		end
	end
	if after == "" then
		return "À FAIRE"
	end
	return "À FAIRE — " .. after
end

-- Lignes de commentaire d'une note : « -- Note : … » (ou « -- Note (libre) : … ») puis « --   … ».
-- Aucune ligne ne contient de saut de ligne ni de caractère de contrôle, et chacune commence par
-- « -- » suivi d'une espace (jamais un commentaire long « --[[ » ni un marqueur « --@ ») : un
-- commentaire de note ne peut donc jamais déborder sur le code. nil pour une note vide.
local function noteCommentLines(text, free)
	text = cleanNoteText(text)
	local paragraphs = {}
	for line in string.gmatch(text .. "\n", "(.-)\n") do
		line = string.gsub(line, "%c", " ")
		table.insert(paragraphs, Util.trim(line))
	end
	while #paragraphs > 0 and paragraphs[1] == "" do
		table.remove(paragraphs, 1)
	end
	while #paragraphs > 0 and paragraphs[#paragraphs] == "" do
		table.remove(paragraphs)
	end
	if #paragraphs == 0 then
		return nil
	end
	paragraphs[1] = markTodo(paragraphs[1])
	local prefix = NOTE_PREFIX
	if free then
		prefix = NOTE_PREFIX_FREE
	end
	local out = {}
	for _, paragraph in ipairs(paragraphs) do
		if paragraph == "" then
			table.insert(out, "--")
		else
			for _, line in ipairs(wrapParagraph(paragraph, NOTE_WRAP)) do
				if #out == 0 then
					table.insert(out, prefix .. line)
				else
					table.insert(out, NOTE_NEXT .. line)
				end
			end
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Valeurs littérales (SPEC §5.2)
---------------------------------------------------------------------------

local function channel(x)
	local n = tonumber(x) or 0
	if n ~= n then
		n = 0
	end
	return math.floor(Util.clamp(n, 0, 255) + 0.5)
end

local function toRgb(value)
	if typeof(value) == "Color3" then
		return Util.color3ToRgb(value)
	end
	if type(value) == "table" then
		return {
			channel(value[1] or value.r or value.R),
			channel(value[2] or value.g or value.G),
			channel(value[3] or value.b or value.B),
		}
	end
	return nil
end

local function findOption(spec, code)
	if type(spec.options) ~= "table" then
		return nil
	end
	for _, opt in ipairs(spec.options) do
		if type(opt) == "table" and opt[2] == code then
			return opt
		end
	end
	return nil
end

-- Renvoie le code de l'option à utiliser et l'option elle-même (ou nil si code inconnu mais sûr)
local function resolveDropdown(spec, value)
	if value ~= nil then
		local code = tostring(value)
		local opt = findOption(spec, code)
		if opt then
			return code, opt
		end
		if isSafePath(code) then
			return code, nil
		end
	end
	if spec.default ~= nil then
		local code = tostring(spec.default)
		local opt = findOption(spec, code)
		if opt then
			return code, opt
		end
		if isSafePath(code) then
			return code, nil
		end
	end
	local first = type(spec.options) == "table" and spec.options[1] or nil
	if type(first) == "table" and type(first[2]) == "string" then
		return first[2], first
	end
	return "nil", nil
end

-- hooks = { helper = fn(name)?, var = fn(name) -> expr ?, firstVariable = string? }
-- Renvoie : expression Luau, valeur brute utilisée
local function literalCore(spec, value, hooks)
	local kind = spec.kind
	if kind == "number" then
		if value == nil then
			value = spec.default
		end
		local n = value
		if type(n) ~= "number" then
			n = Util.parseNumber(n)
			if n == nil and type(value) == "string" then
				n = tonumber(Util.trim(value))
			end
		end
		local lit = Util.numLiteral(n)
		if lit == "0" then
			return lit, 0
		end
		return lit, n
	elseif kind == "text" or kind == "gui" then
		-- "gui" (SPEC §21.6) : nom d'un écran / élément de l'interface, toujours un texte littéral
		if value == nil then
			value = spec.default
		end
		if value == nil then
			value = ""
		end
		local s = tostring(value)
		return Util.strLiteral(s), s
	elseif kind == "any" then
		if value == nil then
			value = spec.default
		end
		if value == nil then
			value = ""
		end
		local n = Util.parseNumber(value)
		if n ~= nil and n == n and n ~= math.huge and n ~= -math.huge then
			return Util.numLiteral(n), value
		end
		return Util.strLiteral(tostring(value)), value
	elseif kind == "boolean" then
		local b = value
		if type(b) ~= "boolean" then
			b = spec.default
		end
		if b == true then
			return "true", true
		end
		return "false", false
	elseif kind == "dropdown" then
		local code, opt = resolveDropdown(spec, value)
		if opt and type(opt.helper) == "string" and hooks.helper then
			hooks.helper(opt.helper)
		end
		return code, code
	elseif kind == "color" then
		local rgb = toRgb(value) or toRgb(spec.default) or { 255, 255, 255 }
		return string.format("Color3.fromRGB(%d, %d, %d)", rgb[1], rgb[2], rgb[3]), rgb
	elseif kind == "variable" then
		local name = value
		if type(name) ~= "string" or name == "" then
			name = spec.default
		end
		if type(name) ~= "string" or name == "" then
			name = hooks.firstVariable or "ma variable"
		end
		if hooks.var then
			return hooks.var(name), name
		end
		return "V[" .. Util.strLiteral(name) .. "]", name
	end
	return "nil", value
end

local function acceptsReporter(spec)
	if spec.kind == "variable" or spec.kind == "gui" then
		return false
	end
	if spec.kind == "dropdown" then
		return spec.acceptReporter == true
	end
	return true
end

---------------------------------------------------------------------------
-- État d'une génération
---------------------------------------------------------------------------

local function addWarning(st, msg)
	if msg == nil then
		return
	end
	msg = oneLine(msg, 400)
	if msg == "" or st.warnSet[msg] then
		return
	end
	st.warnSet[msg] = true
	table.insert(st.warnings, msg)
end

local function addError(st, msg)
	if msg == nil then
		return
	end
	msg = oneLine(msg, 400)
	if msg == "" or st.errorSet[msg] then
		return
	end
	st.errorSet[msg] = true
	table.insert(st.errors, msg)
end

local function pushNote(st, line)
	if st.notes then
		table.insert(st.notes, line)
	end
end

-- Enregistre une fonction utile (et ses dépendances / services). Ordre final calculé à l'assemblage.
local function requireHelper(st, name, stack)
	if st.helperSet[name] then
		return true
	end
	if stack[name] then
		addError(st, "Dépendance circulaire entre fonctions utiles autour de « " .. name .. " ».")
		return false
	end
	local spec = Registry.helper(name)
	if type(spec) ~= "table" or type(spec.code) ~= "string" then
		local who = ""
		if st.currentDefId then
			who = " (bloc " .. tostring(st.currentDefId) .. ")"
		end
		addError(st, "Fonction utile inconnue « " .. tostring(name) .. " »" .. who .. ".")
		return false
	end
	stack[name] = true
	for _, dep in ipairs(spec.deps or {}) do
		if type(dep) == "string" then
			requireHelper(st, dep, stack)
		end
	end
	for _, service in ipairs(spec.services or {}) do
		if isPlainIdentifier(service) then
			st.services[service] = true
		end
	end
	stack[name] = nil
	st.helperSet[name] = spec
	return true
end

local function varExpr(st, name)
	if name == nil or name == "" then
		name = st.variables[1] or "ma variable"
	end
	name = tostring(name)
	if not st.varsUsedSet[name] then
		st.varsUsedSet[name] = true
		table.insert(st.varsUsed, name)
	end
	return "V[" .. Util.strLiteral(name) .. "]"
end

local function exprOrNil(expr)
	if expr == nil then
		return "nil"
	end
	expr = tostring(expr)
	if isBlank(expr) then
		return "nil"
	end
	return expr
end

-- Prépare les commentaires des notes (SPEC §29) : st.blockNotes[idDuBloc] = lignes (au-dessus du
-- code de ce bloc), st.freeNotes = lignes de la section « -- Notes ». Ordre : de haut en bas, puis
-- de gauche à droite. Une note dont le bloc n'existe pas devient une note libre.
local function collectNotes(st, model)
	local raw = model.notes
	if type(raw) ~= "table" then
		return
	end
	local list = {}
	for key, note in pairs(raw) do
		if type(note) == "table" then
			table.insert(list, { key = tostring(key), note = note, x = finiteOr0(note.x), y = finiteOr0(note.y) })
		end
	end
	table.sort(list, function(p, q)
		if p.y ~= q.y then
			return p.y < q.y
		end
		if p.x ~= q.x then
			return p.x < q.x
		end
		return p.key < q.key
	end)
	for _, item in ipairs(list) do
		local blockId = item.note.blockId
		local attached = blockId ~= nil and type(st.blocks[blockId]) == "table"
		local lines = noteCommentLines(item.note.text, not attached)
		if lines ~= nil then
			local target = st.freeNotes
			if attached then
				target = st.blockNotes[blockId]
				if target == nil then
					target = {}
					st.blockNotes[blockId] = target
				end
			end
			for _, line in ipairs(lines) do
				table.insert(target, line)
			end
		end
	end
end

-- Lignes tracées à la main (SPEC §36, model.liens) : une ligne qui a un texte devient un commentaire
-- « -- Lien vers « <bloc d'arrivée> » : <texte> » au-dessus du code de son bloc de départ (avec les
-- notes de ce bloc, donc seulement quand code.notes est vrai). Une seule ligne de commentaire, nettoyée
-- comme les notes (jamais de saut de ligne).
local LINK_COMMENT_MAX = 240 -- octets du texte de la ligne gardés dans le commentaire

local function collectLinkComments(st, model)
	local raw = model.liens
	if type(raw) ~= "table" then
		return
	end
	local list = {}
	for key, link in pairs(raw) do
		if type(link) == "table" and type(link.de) == "string" and type(link.vers) == "string" then
			local texte = type(link.texte) == "string" and oneLine(cleanNoteText(link.texte), LINK_COMMENT_MAX) or ""
			local from, to = st.blocks[link.de], st.blocks[link.vers]
			if texte ~= "" and type(from) == "table" and type(to) == "table" then
				table.insert(list, { key = tostring(key), link = link, texte = texte, to = to })
			end
		end
	end
	table.sort(list, function(p, q)
		return p.key < q.key
	end)
	for _, item in ipairs(list) do
		local label = "?"
		local def = type(item.to.def) == "string" and Registry.get(item.to.def) or nil
		if def ~= nil and type(def.label) == "string" then
			label = oneLine(cleanNoteText(Registry.plainLabel(def)), 90)
		end
		local blockId = item.link.de
		local target = st.blockNotes[blockId]
		if target == nil then
			target = {}
			st.blockNotes[blockId] = target
		end
		table.insert(target, "-- Lien vers « " .. label .. " » : " .. item.texte)
	end
end

local function newState(model, mode, useMarkers, options)
	options = type(options) == "table" and options or {}
	local blocks = type(model.blocks) == "table" and model.blocks or {}
	local variables = {}
	local seen = {}
	if type(model.variables) == "table" then
		for _, v in ipairs(model.variables) do
			if type(v) == "string" and v ~= "" and not seen[v] then
				seen[v] = true
				table.insert(variables, v)
			end
		end
	end
	local st = {
		blocks = blocks,
		mode = mode,
		variables = variables,
		services = {},
		helperSet = {},
		declares = {},
		declareSet = {},
		usedNames = {},
		uidCounter = 0,
		warnings = {},
		warnSet = {},
		errors = {},
		errorSet = {},
		varsUsed = {},
		varsUsedSet = {},
		visited = {},
		loopDepth = 0,
		inFunction = false, -- dans le corps d'une fonction de module (g.inFunction)
		notes = nil,
		currentDefId = nil,
		useMarkers = useMarkers == true,
		markers = {}, -- clé de marqueur -> { block = id, def = idDeDefinition }
		markerCount = 0,
		disabledCount = 0, -- blocs désactivés rencontrés (SPEC §32)
		entete = options.entete ~= false, -- long en-tête en français (réglage code.entete)
		blockNotes = {}, -- id de bloc -> lignes de commentaire de ses notes (SPEC §29)
		freeNotes = {}, -- lignes des notes libres
	}
	if options.notes ~= false then
		collectNotes(st, model)
		collectLinkComments(st, model)
	end
	if mode == "module" then
		-- « local Module = {} » est écrit par assemble : g.declare("Module", …) n'ajoute rien
		st.declareSet[MODULE_TABLE] = true
		st.usedNames[MODULE_TABLE] = true
	end
	st.hooks = {
		helper = function(name)
			requireHelper(st, name, {})
		end,
		var = function(name)
			return varExpr(st, name)
		end,
		firstVariable = variables[1],
	}
	return st
end

---------------------------------------------------------------------------
-- Marqueurs de lignes (table des lignes, SPEC §17)
---------------------------------------------------------------------------

-- Clé sûre pour le marqueur d'un bloc : l'id lui-même s'il est simple (« b12 »), sinon « #<n> »
-- (un id venant de données JSON pourrait contenir un saut de ligne : il ne doit jamais entrer
-- tel quel dans le code).
local function markerKey(st, id, defId)
	st.markerCount += 1
	local key
	if type(id) == "string" and #id <= MAX_MARKER_ID and string.match(id, "^[%w_%-%.]+$") then
		key = id
	else
		key = "#" .. tostring(st.markerCount)
	end
	if st.markers[key] == nil then
		local def = nil
		if type(defId) == "string" then
			def = defId
		end
		st.markers[key] = { block = id, def = def }
	end
	return key
end

-- Entoure le code d'un événement / d'une instruction de ses lignes de marqueurs ("" reste "")
local function withMarkers(st, id, defId, code)
	if not st.useMarkers or code == nil or code == "" then
		return code
	end
	return MARKER_PREFIX .. markerKey(st, id, defId) .. "\n" .. code .. "\n" .. MARKER_END
end

-- Retire les lignes de marqueurs du script assemblé. Renvoie le code final et la table des lignes
-- { { line = n, last = m, block = id, def = idDef }, … } dans l'ordre des débuts de zone.
local function extractMarkers(st, code)
	if next(st.markers) == nil then
		return code, {}
	end
	local out = {}
	local entries = {}
	local open = {} -- zones ouvertes (pile)
	local pending = {} -- zones dont la première ligne de code n'est pas encore connue
	local position = 1
	while true do
		local newline = string.find(code, "\n", position, true)
		local line
		if newline then
			line = string.sub(code, position, newline - 1)
		else
			line = string.sub(code, position)
		end
		local key = string.match(line, "^%s*%-%-@([%w_%-%.#/]+)%s*$")
		local isMarker = false
		if key == "/" then
			isMarker = true
			local entry = table.remove(open)
			if entry ~= nil then
				if entry.line == nil then
					-- zone vide : on l'oublie
					entry.dead = true
					for i = #pending, 1, -1 do
						if pending[i] == entry then
							table.remove(pending, i)
						end
					end
				else
					entry.last = math.max(#out, entry.line)
				end
			end
		elseif key ~= nil and st.markers[key] ~= nil then
			isMarker = true
			local info = st.markers[key]
			local entry = { block = info.block, def = info.def }
			table.insert(open, entry)
			table.insert(pending, entry)
			table.insert(entries, entry)
		end
		if not isMarker then
			table.insert(out, line)
			if #pending > 0 then
				for _, entry in ipairs(pending) do
					entry.line = #out
				end
				table.clear(pending)
			end
		end
		if newline == nil then
			break
		end
		position = newline + 1
	end
	local lineMap = {}
	for _, entry in ipairs(entries) do
		if not entry.dead and entry.line ~= nil then
			table.insert(lineMap, {
				line = entry.line,
				last = entry.last or entry.line,
				block = entry.block,
				def = entry.def,
			})
		end
	end
	return table.concat(out, "\n"), lineMap
end

-- Le contexte g passé aux fonctions gen (SPEC §5.3)
local function makeContext(st)
	local g = {}

	-- Tolère aussi l'appel avec ":" (g:indent(x)) en ignorant le premier argument
	local function method(impl)
		return function(first, ...)
			if first == g then
				return impl(...)
			end
			return impl(first, ...)
		end
	end

	g.mode = st.mode
	g.blockId = nil
	g.hatDefId = nil -- id de définition du chapeau qui contient le bloc en cours (SPEC §20)
	g.defId = nil -- NOTE: en plus de la SPEC : id de définition du bloc en cours
	g.variables = table.clone(st.variables) -- NOTE: en plus de la SPEC : noms des variables du projet

	g.indent = method(function(code)
		return indent(code)
	end)

	g.service = method(function(name)
		if not isPlainIdentifier(name) then
			error("nom de service invalide : " .. tostring(name), 0)
		end
		st.services[name] = true
		return name
	end)

	g.helper = method(function(name)
		if type(name) ~= "string" or name == "" then
			addError(st, "Fonction utile sans nom demandée par le bloc " .. tostring(st.currentDefId) .. ".")
			return tostring(name)
		end
		requireHelper(st, name, {})
		return name
	end)

	g.uid = method(function(prefix)
		local base = string.gsub(tostring(prefix or "v"), "[^%w_]", "_")
		if base == "" or string.match(base, "^%d") then
			base = "v" .. base
		end
		if #base > 40 then
			base = string.sub(base, 1, 40)
		end
		local name
		repeat
			st.uidCounter += 1
			name = base .. "_" .. st.uidCounter
		until not st.usedNames[name] and Registry.helper(name) == nil
		st.usedNames[name] = true
		return name
	end)

	g.declare = method(function(name, initCode)
		if not isPlainIdentifier(name) then
			error("nom invalide pour g.declare : " .. tostring(name), 0)
		end
		if not st.declareSet[name] then
			st.declareSet[name] = true
			st.usedNames[name] = true
			local init = "nil"
			if initCode ~= nil and not isBlank(tostring(initCode)) then
				init = Util.trim(tostring(initCode))
			end
			table.insert(st.declares, { name = name, init = init })
		end
		return name
	end)

	g.num = method(function(expr)
		expr = exprOrNil(expr)
		if Util.isNumberLiteral(expr) then
			return expr
		end
		requireHelper(st, "_num", {})
		return "_num(" .. expr .. ")"
	end)

	g.str = method(function(expr)
		expr = exprOrNil(expr)
		if Util.isStringLiteral(expr) then
			return expr
		end
		requireHelper(st, "_texte", {})
		return "_texte(" .. expr .. ")"
	end)

	g.var = method(function(name)
		return varExpr(st, name)
	end)

	g.inLoop = method(function()
		return st.loopDepth > 0
	end)

	-- Vrai dans le corps d'une fonction de module (« Définir la fonction »), hors corps newFunction
	g.inFunction = method(function()
		return st.inFunction == true
	end)

	g.warn = method(function(msg)
		addWarning(st, msg)
	end)

	return g
end

---------------------------------------------------------------------------
-- Compilation des blocs
---------------------------------------------------------------------------

local compileExpression -- (st, g, id, depth) -> expression
local compileChain -- (st, g, headId, depth) -> code

-- Nombre de blocs d'une pile (suite, corps et blocs valeur compris), sans récursion
local function countBlocks(blocks, startId)
	local count = 0
	local seen = {}
	local pending = { startId }
	while #pending > 0 do
		local id = table.remove(pending)
		local block = blocks[id]
		if not seen[id] and type(block) == "table" then
			seen[id] = true
			count += 1
			if block.next ~= nil then
				table.insert(pending, block.next)
			end
			if type(block.sub) == "table" then
				for _, subId in pairs(block.sub) do
					table.insert(pending, subId)
				end
			end
			if type(block.inputs) == "table" then
				for _, slot in pairs(block.inputs) do
					if type(slot) == "table" and slot.block ~= nil then
						table.insert(pending, slot.block)
					end
				end
			end
		end
	end
	return count
end

local function checkScriptType(st, def)
	local t = def.scriptType
	if t == "module" then
		if st.mode ~= "module" then
			addWarning(st, "Le bloc « " .. labelOf(def) .. " » ne fonctionne que dans un script module.")
		end
		return
	end
	if st.mode == "module" then
		-- un script module s'exécute du côté du script qui le charge (serveur ou joueur)
		return
	end
	if t == "local" and st.mode ~= "local" then
		addWarning(st, "Le bloc « " .. labelOf(def) .. " » ne fonctionne que dans un script local.")
	elseif t == "server" and st.mode ~= "server" then
		addWarning(st, "Le bloc « " .. labelOf(def) .. " » ne fonctionne que dans un script serveur.")
	end
end

local function runGen(st, g, id, def, a)
	local prevId, prevDefId, prevCurrent = g.blockId, g.defId, st.currentDefId
	g.blockId = id
	g.defId = def.id
	st.currentDefId = def.id
	local ok, result = pcall(def.gen, a, g)
	g.blockId = prevId
	g.defId = prevDefId
	st.currentDefId = prevCurrent
	return ok, result
end

-- Construit la table a (expressions des entrées + a.raw)
local function compileInputs(st, g, block, def, depth)
	local a = { raw = {} }
	local inputs = type(block.inputs) == "table" and block.inputs or {}
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" and type(spec.name) == "string" then
			local slot = inputs[spec.name]
			if type(slot) ~= "table" then
				slot = {}
			end
			local expr = nil
			if slot.block ~= nil then
				local plugged = st.blocks[slot.block]
				if type(plugged) == "table" and plugged.disabled == true then
					-- bloc valeur désactivé (SPEC §32) : la case garde sa valeur écrite
					st.disabledCount += 1
				elseif acceptsReporter(spec) then
					expr = compileExpression(st, g, slot.block, depth + 1)
				else
					addWarning(
						st,
						"Un bloc valeur branché dans « " .. labelOf(def) .. " » a été ignoré (cette case n'accepte pas de bloc)."
					)
				end
			end
			if expr ~= nil then
				a[spec.name] = expr
			else
				local prevCurrent = st.currentDefId
				st.currentDefId = def.id
				local lit, raw = literalCore(spec, slot.value, st.hooks)
				st.currentDefId = prevCurrent
				a[spec.name] = lit
				a.raw[spec.name] = raw
			end
		end
	end
	return a
end

-- Appelle gen d'un bloc instruction / événement et rend le code sûr
local function emitStatement(st, g, id, def, a, notes)
	local ok, result = runGen(st, g, id, def, a)
	local code
	if not ok then
		local msg = oneLine(result)
		addError(st, "Erreur dans le bloc « " .. labelOf(def) .. " » (" .. tostring(def.id) .. ") : " .. msg)
		code = "-- [Blocs FR] erreur dans le bloc " .. tostring(def.id) .. " : " .. msg
	elseif result == nil then
		code = ""
	elseif type(result) ~= "string" then
		addError(st, "Le bloc « " .. labelOf(def) .. " » (" .. tostring(def.id) .. ") a produit un code invalide.")
		code = "-- [Blocs FR] erreur dans le bloc " .. tostring(def.id) .. " : le code produit n'est pas du texte"
	else
		code = stripBlankEdges(result)
		if code ~= "" and needsDoBlock(code) then
			code = wrapDo(code)
		end
	end
	if notes and #notes > 0 then
		local prefix = table.concat(notes, "\n")
		if code == "" then
			code = prefix
		else
			code = prefix .. "\n" .. code
		end
	end
	return code
end

compileExpression = function(st, g, id, depth)
	local block = st.blocks[id]
	if type(block) ~= "table" then
		addWarning(st, "Un bloc valeur introuvable a été remplacé par « rien ».")
		return "nil"
	end
	if st.visited[id] then
		addError(st, "Le bloc " .. tostring(id) .. " est utilisé à deux endroits (projet abîmé) : il est ignoré.")
		return "nil"
	end
	if depth > MAX_DEPTH then
		addError(st, "Trop de blocs imbriqués les uns dans les autres : les plus profonds sont ignorés.")
		return "nil"
	end
	st.visited[id] = true
	local def = Registry.get(block.def)
	if def == nil then
		addWarning(st, "Bloc inconnu « " .. oneLine(block.def, 80) .. " » remplacé par « rien ».")
		return "nil"
	end
	if def.shape ~= "reporter" and def.shape ~= "boolean" then
		addWarning(st, "Le bloc « " .. labelOf(def) .. " » ne donne pas de valeur : il a été ignoré.")
		return "nil"
	end
	-- notes de ce bloc valeur : au-dessus de l'instruction (ou de l'événement) qui le contient
	local own = st.blockNotes[id]
	if own ~= nil then
		for _, line in ipairs(own) do
			pushNote(st, line)
		end
	end
	checkScriptType(st, def)
	local a = compileInputs(st, g, block, def, depth)
	local ok, result = runGen(st, g, id, def, a)
	if not ok then
		local msg = oneLine(result)
		addError(st, "Erreur dans le bloc « " .. labelOf(def) .. " » (" .. tostring(def.id) .. ") : " .. msg)
		pushNote(st, "-- [Blocs FR] erreur dans le bloc " .. tostring(def.id) .. " : " .. msg)
		return "nil"
	end
	if type(result) == "number" then
		return Util.numLiteral(result)
	end
	if type(result) ~= "string" or isBlank(result) then
		addError(st, "Le bloc « " .. labelOf(def) .. " » (" .. tostring(def.id) .. ") n'a produit aucune valeur.")
		return "nil"
	end
	return Util.trim(result)
end

-- Lignes à placer au-dessus du code d'un bloc : ses propres notes, puis celles de ses blocs valeur
-- et leurs commentaires d'erreur (inner)
local function withOwnNotes(st, id, inner)
	local own = st.blockNotes[id]
	if own == nil then
		return inner
	end
	local out = table.clone(own)
	for _, line in ipairs(inner) do
		table.insert(out, line)
	end
	return out
end

-- Compile un bloc instruction. Renvoie le code (non indenté, "" possible) et sa définition.
local function compileStatement(st, g, id, depth)
	local block = st.blocks[id]
	if type(block) ~= "table" then
		return "", nil
	end
	st.visited[id] = true
	if depth > MAX_DEPTH then
		addError(st, "Trop de blocs imbriqués les uns dans les autres : les plus profonds sont ignorés.")
		return "", nil
	end
	local def = Registry.get(block.def)
	if def == nil then
		local name = oneLine(block.def, 80)
		addWarning(st, "Bloc inconnu « " .. name .. " » ignoré.")
		return "-- [Blocs FR] bloc inconnu « " .. name .. " » ignoré", nil
	end
	local shape = def.shape
	if shape == "reporter" or shape == "boolean" or shape == "hat" then
		addWarning(st, "Le bloc « " .. labelOf(def) .. " » ne peut pas être placé dans une pile : il a été ignoré.")
		return "", def
	end
	checkScriptType(st, def)

	local savedNotes = st.notes
	st.notes = {}
	local a = compileInputs(st, g, block, def, depth)
	local notes = withOwnNotes(st, id, st.notes)
	st.notes = savedNotes

	if shape == "c" or shape == "c2" then
		local sub = type(block.sub) == "table" and block.sub or {}
		local savedDepth = st.loopDepth
		local savedInFunction = st.inFunction
		if def.newFunction then
			st.loopDepth = 0
			st.inFunction = false
		end
		if def.loop then
			st.loopDepth += 1
		end
		a.DO = compileChain(st, g, sub.DO, depth + 1)
		if shape == "c2" then
			a.ELSE = compileChain(st, g, sub.ELSE, depth + 1)
		else
			a.ELSE = ""
		end
		st.loopDepth = savedDepth
		st.inFunction = savedInFunction
	end

	return emitStatement(st, g, id, def, a, notes), def
end

compileChain = function(st, g, headId, depth)
	local parts = {}
	local id = headId
	local steps = 0
	while id ~= nil do
		steps += 1
		if steps > MAX_CHAIN then
			addError(st, "Pile de blocs trop longue ou circulaire : la fin est ignorée.")
			break
		end
		local block = st.blocks[id]
		if type(block) ~= "table" then
			addWarning(st, "Un bloc introuvable interrompt une pile : la suite est ignorée.")
			break
		end
		if st.visited[id] then
			addError(st, "Pile circulaire ou bloc utilisé deux fois (" .. tostring(id) .. ") : la suite est ignorée.")
			break
		end
		if block.disabled == true then
			-- instruction désactivée (SPEC §32) : sautée avec ses corps, la suite continue
			st.visited[id] = true
			st.disabledCount += 1
			id = block.next
			continue
		end
		local code, def = compileStatement(st, g, id, depth)
		if code ~= "" then
			-- marqueurs de la table des lignes (lignes de commentaire, retirées à la fin)
			table.insert(parts, withMarkers(st, id, block.def, code))
		end
		local nextId = block.next
		if nextId ~= nil and def ~= nil and (def.noNext or def.shape == "cap") then
			local n = countBlocks(st.blocks, nextId)
			addWarning(st, tostring(n) .. " bloc(s) placé(s) après « " .. labelOf(def) .. " » ont été ignorés.")
			break
		end
		id = nextId
	end
	return table.concat(parts, "\n")
end

local function compileHatBody(st, g, id, def, block)
	st.visited[id] = true
	checkScriptType(st, def)

	local savedNotes = st.notes
	st.notes = {}
	local a = compileInputs(st, g, block, def, 0)
	local notes = withOwnNotes(st, id, st.notes)
	st.notes = savedNotes

	local savedDepth = st.loopDepth
	if def.loop then
		st.loopDepth = 1
	else
		st.loopDepth = 0
	end
	a.BODY = compileChain(st, g, block.next, 1)
	st.loopDepth = savedDepth

	if isBlank(a.BODY) then
		-- Événement vide : rien à exécuter, on n'installe rien.
		addWarning(st, "« " .. labelOf(def) .. " » n'a aucun bloc en dessous : il ne fait rien.")
		if def.emitEmpty == true then
			-- généré quand même (ex. fonction de module vide : elle doit exister pour ses appelants)
			a.BODY = ""
			return emitStatement(st, g, id, def, a, notes)
		end
		local line = "-- « " .. labelOf(def) .. " » : aucun bloc à exécuter."
		if #notes > 0 then
			return table.concat(notes, "\n") .. "\n" .. line
		end
		return line
	end
	return emitStatement(st, g, id, def, a, notes)
end

-- Compile un chapeau : g.hatDefId et g.inFunction() valent pour tout ce qu'il contient
local function compileHat(st, g, id, def, block)
	local savedHat, savedInFunction = g.hatDefId, st.inFunction
	g.hatDefId = def.id
	st.inFunction = def.functionBody == true
	local code = compileHatBody(st, g, id, def, block)
	g.hatDefId = savedHat
	st.inFunction = savedInFunction
	return code
end

---------------------------------------------------------------------------
-- Assemblage du script
---------------------------------------------------------------------------

-- Ordre déterministe : noms triés, chaque fonction précédée de ses dépendances
local function orderHelpers(st)
	local names = {}
	for name in pairs(st.helperSet) do
		table.insert(names, name)
	end
	table.sort(names)
	local out = {}
	local done = {}
	local visiting = {}
	local function visit(name)
		if done[name] or visiting[name] then
			return
		end
		local spec = st.helperSet[name]
		if spec == nil then
			return
		end
		visiting[name] = true
		for _, dep in ipairs(spec.deps or {}) do
			visit(dep)
		end
		visiting[name] = nil
		done[name] = true
		table.insert(out, name)
	end
	for _, name in ipairs(names) do
		visit(name)
	end
	return out
end

local function topsOf(model, blocks)
	if type(model.tops) == "table" then
		return model.tops
	end
	-- Données sans "tops" : les blocs sans parent, triés par id
	local tops = {}
	for id, block in pairs(blocks) do
		if type(block) == "table" and block.parent == nil then
			table.insert(tops, id)
		end
	end
	table.sort(tops, function(p, q)
		return tostring(p) < tostring(q)
	end)
	return tops
end

local function assemble(st, hatCount, hatCodes, disabledHats)
	local out = {}
	local function push(line)
		table.insert(out, line)
	end

	local isModule = st.mode == "module"
	-- 1re ligne toujours présente (CodeView y lit le type de script) ; le reste de l'en-tête suit le
	-- réglage code.entete
	push("-- Script généré par Blocs FR (" .. MODE_LABEL[st.mode] .. ")")
	if st.entete then
		push(HEADER_WARNING)
		if isModule then
			for _, line in ipairs(MODULE_USAGE) do
				push(line)
			end
		end
	end
	push("")

	-- Notes libres (SPEC §29) : juste après l'en-tête
	if #st.freeNotes > 0 then
		push(NOTES_SECTION)
		for _, line in ipairs(st.freeNotes) do
			push(line)
		end
		push("")
	end

	local serviceNames = {}
	for name in pairs(st.services) do
		table.insert(serviceNames, name)
	end
	table.sort(serviceNames)
	for _, name in ipairs(serviceNames) do
		push("local " .. name .. ' = game:GetService("' .. name .. '")')
	end

	push("-- Variables")
	push("local V = {}")
	local initialised = {}
	for _, name in ipairs(st.variables) do
		initialised[name] = true
		push("V[" .. Util.strLiteral(name) .. "] = 0")
	end
	for _, name in ipairs(st.varsUsed) do
		if not initialised[name] then
			initialised[name] = true
			push("V[" .. Util.strLiteral(name) .. "] = 0")
		end
	end

	push("-- Contexte")
	local contextLines = CONTEXT_SERVER
	if st.mode == "local" then
		contextLines = CONTEXT_LOCAL
	end
	for _, line in ipairs(contextLines) do
		push(line)
	end

	local helperNames = orderHelpers(st)
	-- Luau limite le nombre de variables locales actives d'une fonction (200)
	-- services + fonctions utiles + déclarations + V + 6 variables de contexte
	local topLocals = #serviceNames + #helperNames + #st.declares + 1 + 6
	if isModule then
		topLocals += 1 -- Module
	end
	-- Au-delà de la limite, les fonctions utiles deviennent des fonctions globales DU SCRIPT (chaque
	-- script Roblox a son propre environnement : elles ne sont pas partagées avec les autres scripts).
	-- Elles sont écrites avant les événements (dépendances d'abord) : elles existent quand ils s'exécutent.
	local helpersGlobaux = topLocals > MAX_TOP_LOCALS and #helperNames > 0
	local localsRestants = topLocals
	if helpersGlobaux then
		localsRestants = topLocals - #helperNames
	end
	if localsRestants > MAX_TOP_LOCALS then
		addWarning(
			st,
			"Ce script déclare environ "
				.. localsRestants
				.. " variables locales au premier niveau (Luau en accepte 200) : il risque de ne pas démarrer. Répartis les blocs dans plusieurs scripts."
		)
	end
	if #helperNames > 0 or #st.declares > 0 then
		push("")
		push("-- Fonctions utiles")
		if helpersGlobaux then
			push("-- (beaucoup de blocs : ces fonctions sont globales à ce script, car Luau limite un script à 200 variables locales)")
		end
		for i, name in ipairs(helperNames) do
			if i > 1 then
				push("")
			end
			local code = stripBlankEdges(st.helperSet[name].code)
			if helpersGlobaux then
				code = string.gsub(code, "local function " .. name .. "%(", "function " .. name .. "(", 1)
			end
			push(code)
		end
		if #st.declares > 0 then
			if #helperNames > 0 then
				push("")
			end
			for _, d in ipairs(st.declares) do
				push("local " .. d.name .. " = " .. d.init)
			end
		end
	end

	if isModule then
		push("")
		push(MODULE_TABLE_COMMENT)
		push("local " .. MODULE_TABLE .. " = {}")
	end

	push("")
	if isModule then
		push(MODULE_SECTION)
	else
		push("-- Événements")
	end
	if hatCount == 0 then
		if (disabledHats or 0) > 0 then
			push(ALL_HATS_DISABLED_COMMENT)
		elseif isModule then
			push(NO_HAT_COMMENT_MODULE)
		else
			push(NO_HAT_COMMENT)
		end
	end
	for i, code in ipairs(hatCodes) do
		if i > 1 then
			push("")
		end
		push(code)
	end

	return table.concat(out, "\n") .. "\n"
end

local function normalizeMode(mode, model)
	if mode == "local" or mode == "server" or mode == "module" then
		return mode
	end
	if type(model) == "table" and (model.mode == "local" or model.mode == "module") then
		return model.mode
	end
	return "server"
end

local function generateImpl(model, mode, useMarkers, options)
	if type(model) ~= "table" then
		error("projet invalide (aucun modèle)", 0)
	end
	local st = newState(model, mode, useMarkers, options)
	local g = makeContext(st)

	-- 1. Piles de premier niveau : événements (compilés) et autres piles (ignorées).
	--    Un événement désactivé (SPEC §32) est remplacé par rien.
	local hatList = {}
	local ignored = 0
	local disabledHats = 0
	local seenTop = {}
	for index, id in ipairs(topsOf(model, st.blocks)) do
		local block = st.blocks[id]
		if id ~= nil and not seenTop[id] and type(block) == "table" then
			seenTop[id] = true
			local def = Registry.get(block.def)
			if def and def.shape == "hat" then
				if block.disabled == true then
					disabledHats += 1
					st.disabledCount += 1
				else
					table.insert(hatList, {
						id = id,
						block = block,
						def = def,
						order = finiteOr0(def.hatOrder or 1),
						x = finiteOr0(block.x),
						y = finiteOr0(block.y),
						index = index,
					})
				end
			else
				ignored += countBlocks(st.blocks, id)
			end
		end
	end
	if ignored > 0 then
		addWarning(st, tostring(ignored) .. " bloc(s) hors d'un événement ont été ignorés.")
	end

	-- hatOrder 1 d'abord, puis 2 ; chaque groupe trié par y puis x
	table.sort(hatList, function(p, q)
		if p.order ~= q.order then
			return p.order < q.order
		end
		if p.y ~= q.y then
			return p.y < q.y
		end
		if p.x ~= q.x then
			return p.x < q.x
		end
		return p.index < q.index
	end)

	-- 2. Compilation des événements
	local hatCodes = {}
	for _, h in ipairs(hatList) do
		local code = compileHat(st, g, h.id, h.def, h.block)
		if code ~= "" then
			table.insert(hatCodes, withMarkers(st, h.id, h.def.id, code))
		end
	end

	-- 3. Assemblage, puis retrait des marqueurs (table des lignes du code final)
	local code = assemble(st, #hatList, hatCodes, disabledHats)
	local lineMap = {}
	if st.useMarkers then
		code, lineMap = extractMarkers(st, code)
	end
	if st.mode == "module" then
		-- après la table des lignes : la dernière instruction du script module
		code = code .. "\nreturn " .. MODULE_TABLE .. "\n"
	end
	return {
		code = code,
		warnings = st.warnings,
		errors = st.errors,
		hats = #hatList,
		ignored = ignored,
		lineMap = lineMap,
		disabled = st.disabledCount,
	}
end

-- Réglages du code généré (SPEC §31 : Reglages.current().code = { notes, entete }, vrais par défaut).
-- Reglages est chargé ici, au moment de la génération et dans un pcall : s'il n'existe pas (encore)
-- ou contient une erreur, les valeurs par défaut sont utilisées. opts = { notes =, entete = }
-- (booléens, facultatifs) passe avant les réglages.
local function resolveOptions(opts)
	local options = { notes = true, entete = true }
	local ok, settings = pcall(function()
		local module = script.Parent:FindFirstChild("Reglages")
		if module == nil or not module:IsA("ModuleScript") then
			return nil
		end
		local Reglages = require(module)
		if type(Reglages) ~= "table" or type(Reglages.current) ~= "function" then
			return nil
		end
		return Reglages.current()
	end)
	if ok and type(settings) == "table" and type(settings.code) == "table" then
		if settings.code.notes == false then
			options.notes = false
		end
		if settings.code.entete == false then
			options.entete = false
		end
	end
	if type(opts) == "table" then
		if type(opts.notes) == "boolean" then
			options.notes = opts.notes
		end
		if type(opts.entete) == "boolean" then
			options.entete = opts.entete
		end
	end
	return options
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

-- CodeGen.generate(model, mode, opts?) -> { code, warnings, errors, hats, ignored, lineMap, disabled }
-- model : un Model (ou ses données sérialisées : mêmes champs blocks / tops / variables / mode / notes)
-- mode  : "server" | "local" | "module" (par défaut : model.mode)
-- opts  : (NOTE: en plus de la SPEC) { notes = bool, entete = bool } ; sans lui : réglages de Reglages
-- lineMap : { { line = n, last = m, block = id, def = idDef }, … } (voir l'en-tête du fichier)
function CodeGen.generate(model, mode, opts)
	mode = normalizeMode(mode, model)
	local options = resolveOptions(opts)
	local ok, result = pcall(generateImpl, model, mode, true, options)
	if ok then
		return result
	end
	-- Par sécurité : nouvelle tentative sans marqueurs (même code, sans table des lignes)
	local okPlain, plain = pcall(generateImpl, model, mode, false, options)
	if okPlain then
		return plain
	end
	local msg = oneLine(result)
	local tail = ""
	if mode == "module" then
		-- un script module doit toujours renvoyer une valeur
		tail = "return {}\n"
	end
	return {
		code = "-- Script généré par Blocs FR ("
			.. MODE_LABEL[mode]
			.. ")\n"
			.. HEADER_WARNING
			.. "\n\n-- [Blocs FR] erreur interne du générateur : "
			.. msg
			.. "\n"
			.. tail,
		warnings = {},
		errors = { "Erreur interne du générateur : " .. msg },
		hats = 0,
		ignored = 0,
		lineMap = {},
		disabled = 0,
	}
end

-- CodeGen.compileLiteral(inputSpec, value, g?) -> expression Luau d'une valeur littérale (SPEC §5.2)
-- g (optionnel) : contexte de génération, pour enregistrer les fonctions utiles des options de menu.
function CodeGen.compileLiteral(inputSpec, value, g)
	if type(inputSpec) ~= "table" then
		return "nil"
	end
	local hooks = {}
	if type(g) == "table" then
		if type(g.helper) == "function" then
			hooks.helper = g.helper
		end
		if type(g.var) == "function" then
			hooks.var = g.var
		end
		if type(g.variables) == "table" then
			hooks.firstVariable = g.variables[1]
		end
	end
	local ok, expr = pcall(literalCore, inputSpec, value, hooks)
	if ok and type(expr) == "string" then
		return expr
	end
	return "nil"
end

-- Utilitaires exposés (pratiques pour les tests et les autres modules)
CodeGen.indent = indent
CodeGen.isSafePath = isSafePath

return CodeGen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">CodeView</string><ProtectedString name="Source"><![CDATA[-- CodeView : panneau latéral (à droite) qui affiche le code Luau généré par Blocs FR.
-- En-tête « Code Luau généré » + pastille du mode + « Sélectionner le texte » + fermer ×,
-- encadré d'avertissements (texte WarningText sur fond orangé à 12 %), numéros de ligne (colonne fixe),
-- coloration syntaxique (Theme.Code, RichText) sur fond Theme.Colors.CodeBg, et un mode « texte
-- sélectionnable » (TextBox en lecture seule) pour copier le code avec Ctrl+C.
--
-- API :
--   CodeView.new(layerFrame, deps) -> codeview      deps = { dialogs }
--   codeview:show(code, warnings, mode?)            mode (extension) : "server" | "local" | "module"
--   codeview:hide() ; codeview:isVisible() ; codeview:isInside(screenPos) ; codeview:destroy()
--   codeview:scrollToLine(n, lastLine?) -> bool     fait défiler jusqu'à la ligne n (centrée) et la
--       surligne (lastLine : dernière ligne de la zone, ex. la région d'un bloc). À appeler après
--       show() ; appelé avant (vue cachée), il s'applique au prochain show(). Le surlignage reste
--       tant que le code ne change pas.
--   codeview:clearHighlight()
--
-- Animations (SPEC §24, module Anim ; durées × vitesse des réglages ; désactivées : tout est posé
-- tout de suite) : le panneau glisse depuis la droite (0,25 s quintOut) et repart vers la droite
-- (0,18 s) ; à l'ouverture, les lignes d'avertissement arrivent en cascade puis le code apparaît en
-- fondu ; boutons de l'en-tête : survol en fondu et appui ; défilement doux vers la ligne demandée,
-- dont le surlignage s'adoucit après un instant.

local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Anim = require(script.Parent.Anim)

local CodeView = {}
CodeView.__index = CodeView

-- Couleurs du thème lues à chaque usage (Reglages peut changer le thème)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})
local FONT = Theme.Fonts.UI
local FONT_BOLD = Theme.Fonts.UIBold
local CODE_SIZE = Theme.TextSize.Code
local CODE_FONT = Theme.Fonts.Code
local CHUNK = 80 -- lignes par TextLabel (évite les textes géants)
local TAB = "    " -- les tabulations sont affichées comme 4 espaces
local HEADER_H = 56
local CODE_PAD = 12
local GUTTER_PAD = 12
local WARNINGS_MAX_H = 140
local MIN_WIDTH = 420
local MAX_WIDTH = 900
local FAST = 0.12 -- survol des boutons
local SLIDE_IN = 0.25 -- le panneau arrive (quintOut)
local SLIDE_OUT = 0.18 -- le panneau repart (quadIn)
local SCROLL_TIME = 0.35 -- défilement vers une ligne
local HIGHLIGHT_W = 2400 -- largeur de la bande de surlignage (coupée par la zone du code)

local HIDDEN_ANCHOR = Vector2.new(0, 0) -- panneau juste à droite du calque (invisible)
local SHOWN_ANCHOR = Vector2.new(1, 0) -- panneau collé au bord droit

---------------------------------------------------------------------------
-- Coloration syntaxique
---------------------------------------------------------------------------

local KEYWORDS = {}
for _, word in ipairs({
	"and", "break", "continue", "do", "else", "elseif", "end", "false", "for", "function", "if",
	"in", "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while",
}) do
	KEYWORDS[word] = true
end

local BUILTINS = {}
for _, word in ipairs({
	"game", "workspace", "script", "task", "Instance", "Vector3", "Vector2", "Color3", "Enum",
	"CFrame", "UDim", "UDim2", "BrickColor", "TweenInfo", "Ray", "RaycastParams", "NumberRange",
	"NumberSequence", "ColorSequence", "Random", "math", "string", "table", "utf8", "os",
	"coroutine", "debug", "print", "warn", "error", "assert", "typeof", "type", "tostring",
	"tonumber", "pairs", "ipairs", "pcall", "xpcall", "select", "next", "require", "setmetatable",
	"getmetatable", "rawget", "rawset", "time", "tick", "unpack",
}) do
	BUILTINS[word] = true
end

local function hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- Couleurs de la coloration (Theme.Code, lu à chaque affichage)
local function codeColors()
	local code = Theme.Code
	return {
		keyword = hex(code.Keyword),
		string = hex(code.String),
		number = hex(code.Number),
		comment = hex(code.Comment),
		builtin = hex(code.Builtin),
	}
end

-- Échappe un texte pour l'insérer dans du RichText
local function escapeRich(s)
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	s = string.gsub(s, "\"", "&quot;")
	s = string.gsub(s, "'", "&apos;")
	return s
end

local BACKTICK = string.char(96)

-- Découpe le code en jetons { genre, texte } (les jetons peuvent contenir des retours à la ligne)
local function tokenize(code)
	local tokens = {}
	local n = #code
	local i = 1
	while i <= n do
		local c = string.sub(code, i, i)
		local nextC = string.sub(code, i + 1, i + 1)
		if c == "-" and nextC == "-" then
			-- commentaire (court ou long)
			local eqs = string.match(code, "^%[(=*)%[", i + 2)
			local stop
			if eqs then
				local _, e = string.find(code, "]" .. eqs .. "]", i + 4 + #eqs, true)
				stop = e or n
			else
				local nl = string.find(code, "\n", i, true)
				if nl then
					stop = nl - 1
				else
					stop = n
				end
			end
			table.insert(tokens, { "comment", string.sub(code, i, stop) })
			i = stop + 1
		elseif c == "\"" or c == "'" or c == BACKTICK then
			-- chaîne entre guillemets (s'arrête en fin de ligne si elle n'est pas fermée)
			local j = i + 1
			local stop = n
			while j <= n do
				local d = string.sub(code, j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					stop = j
					break
				elseif d == "\n" then
					stop = j - 1
					break
				else
					j += 1
				end
			end
			if stop > n then
				stop = n
			end
			table.insert(tokens, { "string", string.sub(code, i, stop) })
			i = stop + 1
		elseif c == "[" and string.match(code, "^%[=*%[", i) then
			-- chaîne longue
			local eqs = string.match(code, "^%[(=*)%[", i)
			local _, e = string.find(code, "]" .. eqs .. "]", i + 2 + #eqs, true)
			local stop = e or n
			table.insert(tokens, { "string", string.sub(code, i, stop) })
			i = stop + 1
		elseif string.match(c, "%d") or (c == "." and string.match(nextC, "%d")) then
			local num = string.match(code, "^0[xX][%x_]+", i)
				or string.match(code, "^0[bB][01_]+", i)
				or string.match(code, "^%d[%d_]*%.?[%d_]*[eE][%+%-]?%d+", i)
				or string.match(code, "^%d[%d_]*%.?[%d_]*", i)
				or string.match(code, "^%.%d+[eE][%+%-]?%d+", i)
				or string.match(code, "^%.%d+", i)
				or c
			table.insert(tokens, { "number", num })
			i += #num
		elseif string.match(c, "[%a_]") then
			local word = string.match(code, "^[%a_][%w_]*", i) or c
			local kind = "text"
			if KEYWORDS[word] then
				kind = "keyword"
			elseif BUILTINS[word] then
				kind = "builtin"
			end
			table.insert(tokens, { kind, word })
			i += #word
		else
			-- suite de symboles / espaces / caractères non ASCII (jusqu'au prochain début de jeton)
			local run = string.match(code, "^[^%w_\"'%-%[%.\96]+", i)
			if run == nil or run == "" then
				run = c
			end
			table.insert(tokens, { "text", run })
			i += #run
		end
	end
	return tokens
end

local function wrapSegment(kind, piece, colors)
	local expanded = string.gsub(piece, "\t", TAB)
	local escaped = escapeRich(expanded)
	local color = colors[kind]
	if color then
		return "<font color=\"" .. color .. "\">" .. escaped .. "</font>"
	end
	return escaped
end

-- Code -> tableau de lignes en RichText (une balise par segment, jamais à cheval sur deux lignes)
local function highlightLines(code)
	local colors = codeColors()
	local lines = { {} }
	for _, token in ipairs(tokenize(code)) do
		local kind, text = token[1], token[2]
		local start = 1
		while true do
			local nl = string.find(text, "\n", start, true)
			local piece
			if nl then
				piece = string.sub(text, start, nl - 1)
			else
				piece = string.sub(text, start)
			end
			if piece ~= "" then
				local current = lines[#lines]
				table.insert(current, wrapSegment(kind, piece, colors))
			end
			if not nl then
				break
			end
			table.insert(lines, {})
			start = nl + 1
		end
	end
	local out = {}
	for i, parts in ipairs(lines) do
		out[i] = table.concat(parts)
	end
	return out
end

-- Code -> tableau de lignes en texte brut (tabulations remplacées par des espaces)
local function plainLines(code)
	local out = {}
	for line in string.gmatch(code .. "\n", "([^\n]*)\n") do
		local expanded = string.gsub(line, "\t", TAB)
		table.insert(out, expanded)
	end
	return out
end

local function measureWrapped(text, size, font, maxWidth)
	maxWidth = math.max(10, maxWidth)
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(maxWidth, 100000))
	end)
	if ok and typeof(result) == "Vector2" then
		return Vector2.new(math.ceil(result.X), math.ceil(result.Y))
	end
	local w = Util.textSize(text, size, font).X
	return Vector2.new(maxWidth, math.max(1, math.ceil(w / maxWidth)) * (size + 3))
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = Theme.TextSize.UI,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Texte de la pastille pour chaque type de script
local MODE_PILLS = {
	server = "Script serveur",
	["local"] = "Script local",
	module = "Script module",
}

-- Mode d'après l'en-tête du code généré (« -- Script généré par Blocs FR (script serveur) »)
local function detectMode(code)
	local head = string.sub(code, 1, 400)
	if string.find(head, "(script local)", 1, true) then
		return "local"
	end
	if string.find(head, "(script module)", 1, true) then
		return "module"
	end
	if string.find(head, "(script serveur)", 1, true) then
		return "server"
	end
	return nil
end

local function plural(n, word)
	if n > 1 then
		return n .. " " .. word .. "s"
	end
	return n .. " " .. word
end

-- Vrai si le fondu d'Anim couvre tout l'objet (60 descendants au plus, sans les « Anim… ») : sinon
-- la fin d'un très long code apparaîtrait d'un coup pendant que le début se fond
local function fadeFits(obj)
	local count = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if (d:IsA("GuiObject") or d:IsA("UIStroke")) and string.sub(d.Name, 1, 4) ~= "Anim" then
			count += 1
			if count > 60 then
				return false
			end
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function CodeView.new(layerFrame, deps)
	local self = setmetatable({}, CodeView)
	self.layer = layerFrame
	self.deps = deps or {}
	self.dialogs = self.deps.dialogs
	self.connections = {}
	self.contentMaid = Util.Maid.new()
	self.selectable = false
	self._visible = false
	self._code = ""
	self._warnings = {}
	self._mode = nil
	self._lineCount = 0
	self._slide = nil -- glissement du panneau en cours (poignée Anim)
	self._highlight = nil -- { première ligne, dernière ligne } surlignées
	self._pendingLine = nil -- scrollToLine demandé avant show()
	self._highlightFrames = {}
	self._scrollToken = 0
	self._warningRows = {}
	self.codeLabels = {}
	self.selectBox = nil
	self.scroll = nil

	local top = Theme.Layout.TopBarHeight
	local bottom = Theme.Layout.StatusBarHeight

	-- Le panneau est un bouton : les clics ne traversent pas jusqu'au canvas.
	-- Caché : AnchorPoint (0, 0) au bord droit (hors écran) ; affiché : AnchorPoint (1, 0).
	self.panel = Util.create("TextButton", {
		Name = "VueCode",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		AnchorPoint = HIDDEN_ANCHOR,
		Position = UDim2.new(1, 0, 0, top),
		Size = UDim2.new(0.5, 0, 1, -(top + bottom)),
		Visible = false,
		Parent = layerFrame,
	})
	Util.create("UISizeConstraint", {
		MinSize = Vector2.new(MIN_WIDTH, 0),
		MaxSize = Vector2.new(MAX_WIDTH, math.huge),
		Parent = self.panel,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 5,
		Parent = self.panel,
	})

	-- En-tête : titre, pastille du mode + sous-titre, « Sélectionner le texte », fermer ×
	local header = Util.create("Frame", {
		Name = "EnTete",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, HEADER_H),
		Parent = self.panel,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = header,
	})

	local toggleW = math.max(
		textWidth("Sélectionner le texte", Theme.TextSize.UI, FONT),
		textWidth("Vue colorée", Theme.TextSize.UI, FONT)
	) + 26
	local rightReserve = toggleW + 30 + 12 + 8 + 12

	self.title = makeLabel({
		Name = "Titre",
		Text = "Code Luau généré",
		Font = FONT_BOLD,
		TextSize = 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(16, 9),
		Size = UDim2.new(1, -(16 + rightReserve), 0, 20),
		Parent = header,
	})
	self.modePill = Util.create("Frame", {
		Name = "Mode",
		BackgroundColor3 = C.ButtonActive,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 33),
		Size = UDim2.fromOffset(90, 16),
		Visible = false,
		Parent = header,
	})
	Util.corner(self.modePill, 8)
	Util.stroke(self.modePill, C.ButtonActiveStroke, 1)
	self.modePillLabel = makeLabel({
		Text = "",
		Font = FONT_BOLD,
		TextSize = 10,
		TextColor3 = C.TextSoft,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = self.modePill,
	})
	self.subtitle = makeLabel({
		Name = "SousTitre",
		Text = "",
		TextSize = Theme.TextSize.Small,
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(16, 33),
		Size = UDim2.new(1, -(16 + rightReserve), 0, 16),
		Parent = header,
	})
	self.rightReserve = rightReserve

	self.closeButton = self:_headerButton(header, "×", 30, UDim2.new(1, -12, 0.5, 0))
	self.toggleButton = self:_headerButton(header, "Sélectionner le texte", toggleW, UDim2.new(1, -(12 + 30 + 8), 0.5, 0))
	table.insert(self.connections, self.closeButton.button.MouseButton1Click:Connect(function()
		self:hide()
	end))
	table.insert(self.connections, self.toggleButton.button.MouseButton1Click:Connect(function()
		self.selectable = not self.selectable
		self:_applyMode(true)
	end))

	self.body = Util.create("Frame", {
		Name = "Contenu",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 1, -HEADER_H),
		ClipsDescendants = true,
		Parent = self.panel,
	})

	return self
end

-- Bouton de l'en-tête. position = bord droit du bouton (milieu vertical) ; il est ancré en son
-- centre pour que l'appui le fasse rétrécir sur lui-même.
function CodeView:_headerButton(parent, text, width, position)
	local button = Util.create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position - UDim2.fromOffset(width / 2, 0),
		Size = UDim2.fromOffset(width, 30),
		Parent = parent,
	})
	Util.corner(button, 7)
	local label = makeLabel({
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	local entry = { button = button, label = label, active = false }
	table.insert(self.connections, button.MouseEnter:Connect(function()
		entry.hovered = true
		self:_applyHeaderButtonLook(entry)
	end))
	table.insert(self.connections, button.MouseLeave:Connect(function()
		entry.hovered = false
		self:_applyHeaderButtonLook(entry)
	end))
	-- appui : 94 % puis petit rebond
	table.insert(self.connections, { Disconnect = Anim.press(button) })
	return entry
end

-- Couleur d'un bouton de l'en-tête (actif / survolé / normal), en fondu de 0,12 s
function CodeView:_applyHeaderButtonLook(entry, instant)
	local color = C.Button
	if entry.active then
		color = C.ButtonActive
	elseif entry.hovered then
		color = C.ButtonHover
	end
	local duration = FAST
	if instant == true then
		duration = 0
	end
	Anim.tween(entry.button, { BackgroundColor3 = color }, duration, "quadOut")
end

---------------------------------------------------------------------------
-- Contenu
---------------------------------------------------------------------------

function CodeView:_clearContent()
	self.contentMaid:clean()
	self.codeLabels = {}
	self.selectBox = nil
	self.scroll = nil
	self._numbers = nil
	self._codeArea = nil
	self._highlightFrames = {}
	self._warningRows = {}
	self._scrollToken += 1
	for _, child in ipairs(self.body:GetChildren()) do
		child:Destroy()
	end
end

function CodeView:_panelWidth()
	local w = self.panel.AbsoluteSize.X
	if w < 120 then
		w = math.clamp(self.layer.AbsoluteSize.X * 0.5, MIN_WIDTH, MAX_WIDTH)
	end
	return w
end

-- Encadré des avertissements (fond orangé à 12 %) ; renvoie sa hauteur (0 s'il n'y en a pas)
function CodeView:_buildWarnings(panelW)
	local warnings = self._warnings
	if #warnings == 0 then
		return 0
	end
	local innerW = math.max(120, panelW - 48)
	local items = {}
	local errorCount, warningCount = 0, 0
	local total = 10 + 18 + 4
	for _, w in ipairs(warnings) do
		local isError = string.sub(w, 1, #"Erreur") == "Erreur"
		if isError then
			errorCount += 1
		else
			warningCount += 1
		end
		local text = "⚠ " .. w
		local m = measureWrapped(text, 12, FONT, innerW)
		table.insert(items, { text = text, h = m.Y + 2, isError = isError })
		total += m.Y + 2 + 4
	end
	total += 6
	local areaH = math.min(total, WARNINGS_MAX_H)

	local headerParts = {}
	if errorCount > 0 then
		table.insert(headerParts, plural(errorCount, "erreur"))
	end
	if warningCount > 0 then
		table.insert(headerParts, plural(warningCount, "avertissement"))
	end

	local area = Util.create("ScrollingFrame", {
		Name = "Avertissements",
		BackgroundColor3 = C.Warning,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, areaH),
		CanvasSize = UDim2.fromOffset(0, total),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = (total > areaH) and 6 or 0,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = self.body,
	})
	local titleLabel = makeLabel({
		Name = "Titre",
		Text = table.concat(headerParts, " · "),
		Font = FONT_BOLD,
		TextSize = 12,
		TextColor3 = C.WarningText,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 18),
		Parent = area,
	})
	table.insert(self._warningRows, titleLabel)
	local y = 10 + 18 + 4
	for _, item in ipairs(items) do
		local color = C.WarningText
		if item.isError then
			color = C.DangerText
		end
		local row = makeLabel({
			Name = "Ligne",
			Text = item.text,
			TextWrapped = true,
			TextSize = 12,
			TextColor3 = color,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(16, y),
			Size = UDim2.new(0, innerW, 0, item.h),
			Parent = area,
		})
		table.insert(self._warningRows, row)
		y += item.h + 4
	end
	-- fine ligne sous l'encadré
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.Warning,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, areaH),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = self.body,
	})
	return areaH + 1
end

function CodeView:_build(keepScroll)
	local previous = nil
	if keepScroll and self.scroll then
		previous = self.scroll.CanvasPosition
	end
	self:_clearContent()

	local y = self:_buildWarnings(self:_panelWidth())

	local raw = string.gsub(self._code, "\r", "")
	local plain = plainLines(raw)
	local okRich, rich = pcall(highlightLines, raw)
	if not okRich or type(rich) ~= "table" or #rich ~= #plain then
		-- repli : texte échappé sans couleur
		rich = {}
		for i, line in ipairs(plain) do
			rich[i] = escapeRich(line)
		end
	end
	local n = #plain
	self._lineCount = n

	local charW = Util.textSize(string.rep("M", 20), CODE_SIZE, CODE_FONT).X / 20
	local twoLines = Util.textSize("Ag\nAg", CODE_SIZE, CODE_FONT).Y
	local lineH = math.max(CODE_SIZE, math.floor(twoLines / 2 + 0.5))
	local maxChars = 1
	for _, line in ipairs(plain) do
		local len = utf8.len(line) or #line
		if len > maxChars then
			maxChars = len
		end
	end
	local gutterW = math.ceil(math.max(3, #tostring(n)) * charW) + 2 * GUTTER_PAD
	local codeW = math.ceil(maxChars * charW) + 40
	local contentH = n * lineH + CODE_PAD * 2
	self._lineH = lineH
	self._contentH = contentH

	-- Zone du code : fond CodeBg, colonne des numéros fixe à gauche, code défilant à droite
	local area = Util.create("Frame", {
		Name = "Code",
		BackgroundColor3 = C.CodeBg,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 1, -y),
		ClipsDescendants = true,
		Parent = self.body,
	})
	self._codeArea = area

	local gutter = Util.create("Frame", {
		Name = "Numeros",
		BackgroundColor3 = C.CodeBg,
		BorderSizePixel = 0,
		Size = UDim2.new(0, gutterW, 1, 0),
		ClipsDescendants = true,
		Parent = area,
	})
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -1, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 3,
		Parent = gutter,
	})
	local numbers = Util.create("Frame", {
		Name = "Liste",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, contentH),
		Parent = gutter,
	})
	self._numbers = numbers

	local scroll = Util.create("ScrollingFrame", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(gutterW, 0),
		Size = UDim2.new(1, -gutterW, 1, 0),
		CanvasSize = UDim2.fromOffset(codeW + CODE_PAD * 2, contentH),
		ScrollingDirection = Enum.ScrollingDirection.XY,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.ButtonActive,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		HorizontalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = area,
	})
	self.scroll = scroll

	-- (textes au-dessus du surlignage des lignes : ZIndex 2)
	for chunkStart = 1, n, CHUNK do
		local chunkEnd = math.min(n, chunkStart + CHUNK - 1)
		local count = chunkEnd - chunkStart + 1
		local chunkY = CODE_PAD + (chunkStart - 1) * lineH
		local list = {}
		for i = chunkStart, chunkEnd do
			table.insert(list, tostring(i))
		end
		makeLabel({
			Name = "Numeros",
			Text = table.concat(list, "\n"),
			Font = CODE_FONT,
			TextSize = CODE_SIZE,
			TextColor3 = Theme.Code.LineNumber,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(0, chunkY),
			Size = UDim2.fromOffset(gutterW - GUTTER_PAD, count * lineH + 2),
			ZIndex = 2,
			Parent = numbers,
		})
		local codeLabel = makeLabel({
			Name = "Lignes",
			Text = table.concat(rich, "\n", chunkStart, chunkEnd),
			RichText = true,
			Font = CODE_FONT,
			TextSize = CODE_SIZE,
			TextColor3 = Theme.Code.Text,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(CODE_PAD, chunkY),
			Size = UDim2.fromOffset(codeW, count * lineH + 2),
			ZIndex = 2,
			Parent = scroll,
		})
		table.insert(self.codeLabels, codeLabel)
	end

	-- Les numéros suivent le défilement vertical du code (pas l'horizontal)
	self.contentMaid:give(scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		numbers.Position = UDim2.fromOffset(0, -scroll.CanvasPosition.Y)
	end))

	-- Texte sélectionnable (lecture seule) pour copier avec Ctrl+C
	self.selectBox = Util.create("TextBox", {
		Name = "TexteSelectionnable",
		Text = table.concat(plain, "\n"),
		TextEditable = false,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = CODE_FONT,
		TextSize = CODE_SIZE,
		TextColor3 = Theme.Code.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(CODE_PAD, CODE_PAD),
		Size = UDim2.fromOffset(codeW, n * lineH + 2),
		Visible = false,
		ZIndex = 2,
		Parent = scroll,
	})

	if n <= 1 and Util.trim(raw) == "" then
		makeLabel({
			Name = "Vide",
			Text = "Aucun code pour l'instant : ajoute un bloc « Quand … » puis des blocs en dessous.",
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(CODE_PAD, CODE_PAD),
			Size = UDim2.new(1, -2 * CODE_PAD, 0, 40),
			ZIndex = 2,
			Parent = scroll,
		})
	end

	self:_applyMode()

	if previous then
		local maxX = math.max(0, codeW + CODE_PAD * 2 - scroll.AbsoluteWindowSize.X)
		local maxY = math.max(0, contentH - scroll.AbsoluteWindowSize.Y)
		scroll.CanvasPosition = Vector2.new(math.min(previous.X, maxX), math.min(previous.Y, maxY))
	end
	numbers.Position = UDim2.fromOffset(0, -scroll.CanvasPosition.Y)
end

-- En-tête : pastille du mode + sous-titre
function CodeView:_applyHeader()
	local mode = self._mode
	local subtitleX = 16
	local text = MODE_PILLS[mode]
	if text then
		local w = textWidth(text, 10, FONT_BOLD) + 16
		self.modePillLabel.Text = text
		self.modePill.Size = UDim2.fromOffset(w, 18)
		self.modePill.Position = UDim2.fromOffset(16, 32)
		self.modePill.Visible = true
		subtitleX = 16 + w + 8
	else
		self.modePill.Visible = false
	end
	self.subtitle.Position = UDim2.fromOffset(subtitleX, 33)
	self.subtitle.Size = UDim2.new(1, -(subtitleX + self.rightReserve), 0, 16)
end

-- Bascule entre la vue colorée et le texte sélectionnable.
-- focus = true (clic sur le bouton) : le texte est sélectionné en entier pour Ctrl+C.
function CodeView:_applyMode(focus)
	local selectable = self.selectable
	for _, label in ipairs(self.codeLabels) do
		label.Visible = not selectable
	end
	local box = self.selectBox
	if box then
		box.Visible = selectable
		if selectable and focus then
			-- tout sélectionner pour pouvoir copier tout de suite (Ctrl+C)
			task.defer(function()
				if self.selectBox == box and box.Parent and self.selectable then
					pcall(function()
						box:CaptureFocus()
						box.CursorPosition = #box.Text + 1
						box.SelectionStart = 1
					end)
				end
			end)
		elseif not selectable then
			pcall(function()
				box:ReleaseFocus()
			end)
		end
	end
	local linesText = plural(self._lineCount, "ligne")
	self.toggleButton.active = selectable
	self:_applyHeaderButtonLook(self.toggleButton)
	if selectable then
		self.toggleButton.label.Text = "Vue colorée"
		self.subtitle.Text = linesText .. " · texte sélectionné : Ctrl+C pour copier"
	else
		self.toggleButton.label.Text = "Sélectionner le texte"
		self.subtitle.Text = linesText .. " · lecture seule (modifie les blocs)"
	end
end

---------------------------------------------------------------------------
-- Surlignage d'une ligne (« Voir dans le code »)
---------------------------------------------------------------------------

function CodeView:_removeHighlight()
	for _, f in ipairs(self._highlightFrames) do
		pcall(function()
			f:Destroy()
		end)
	end
	self._highlightFrames = {}
end

-- Dessine la bande de surlignage (derrière le texte) et sa marque dans la colonne des numéros.
-- animate : la bande apparaît vive puis s'adoucit. (Noms « Anim… » : le fondu d'ouverture de la
-- zone du code ne les touche pas.)
function CodeView:_drawHighlight(animate)
	self:_removeHighlight()
	local range = self._highlight
	local scroll = self.scroll
	if range == nil or scroll == nil or self._numbers == nil or self._lineH == nil then
		return
	end
	if range[1] > self._lineCount then
		self._highlight = nil
		return
	end
	local first = range[1]
	local last = math.min(range[2], self._lineCount)
	local lineH = self._lineH
	local y = CODE_PAD + (first - 1) * lineH - 1
	local h = (last - first + 1) * lineH + 2
	local band = Util.create("Frame", {
		Name = "AnimSurlignage",
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.fromOffset(HIGHLIGHT_W, h),
		ZIndex = 1,
		Parent = scroll,
	})
	local mark = Util.create("Frame", {
		Name = "AnimSurlignageNumero",
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, -1, 0, h),
		ZIndex = 1,
		Parent = self._numbers,
	})
	Util.create("Frame", {
		Name = "AnimBarre",
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.new(0, 3, 1, 0),
		ZIndex = 1,
		Parent = mark,
	})
	self._highlightFrames = { band, mark }
	if animate and Anim.enabled() then
		band.BackgroundTransparency = 0.45
		mark.BackgroundTransparency = 0.4
		Anim.tween(band, { BackgroundTransparency = 0.8 }, 0.9, "quadOut", nil, 0.35)
		Anim.tween(mark, { BackgroundTransparency = 0.72 }, 0.9, "quadOut", nil, 0.35)
	end
end

-- Défile en douceur pour montrer la zone surlignée (centrée ; son début si elle est trop haute).
-- Attend que la zone du code soit mise en page (juste après show(), sa taille n'est pas connue).
function CodeView:_scrollToHighlight()
	local range = self._highlight
	local scroll = self.scroll
	if range == nil or scroll == nil then
		return
	end
	self._scrollToken += 1
	local token = self._scrollToken
	local lineH = self._lineH or CODE_SIZE
	local contentH = self._contentH or 0
	task.spawn(function()
		for _ = 1, 30 do
			if self._scrollToken ~= token or self.scroll ~= scroll or scroll.Parent == nil then
				return
			end
			if scroll.AbsoluteWindowSize.Y > 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if self._scrollToken ~= token or self.scroll ~= scroll or scroll.Parent == nil then
			return
		end
		local windowH = scroll.AbsoluteWindowSize.Y
		if windowH <= 1 then
			windowH = 400
		end
		local top = CODE_PAD + (range[1] - 1) * lineH
		local bottom = CODE_PAD + range[2] * lineH
		local target
		if bottom - top + 2 * lineH > windowH then
			target = top - 2 * lineH
		else
			target = (top + bottom) / 2 - windowH / 2
		end
		local maxY = math.max(0, contentH - windowH)
		target = math.floor(Util.clamp(target, 0, maxY) + 0.5)
		Anim.tween(scroll, { CanvasPosition = Vector2.new(0, target) }, SCROLL_TIME, "quintOut")
	end)
end

-- Fait défiler le code jusqu'à la ligne n (centrée) et la surligne ; lastLine (facultatif) = dernière
-- ligne de la zone à surligner. Vue cachée : appliqué au prochain show(). Renvoie true si la ligne
-- existe dans le code affiché.
function CodeView:scrollToLine(n, lastLine)
	local first = math.floor(tonumber(n) or 0)
	if first < 1 then
		return false
	end
	local last = math.floor(tonumber(lastLine) or first)
	if last < first then
		last = first
	end
	if not self._visible or self.scroll == nil then
		self._pendingLine = { first, last }
		return false
	end
	if first > self._lineCount then
		return false
	end
	self._highlight = { first, math.min(last, self._lineCount) }
	self:_drawHighlight(true)
	self:_scrollToHighlight()
	return true
end

-- Enlève le surlignage (et une demande en attente)
function CodeView:clearHighlight()
	self._highlight = nil
	self._pendingLine = nil
	self:_removeHighlight()
end

---------------------------------------------------------------------------
-- Animations du panneau
---------------------------------------------------------------------------

-- Fait glisser le panneau vers sa place (shown = true) ou hors de la fenêtre, puis le cache
function CodeView:_slideTo(shown)
	local handle = self._slide
	self._slide = nil
	if handle then
		handle:cancel()
	end
	local panel = self.panel
	if panel == nil then
		return
	end
	if shown then
		self._slide = Anim.tween(panel, { AnchorPoint = SHOWN_ANCHOR }, SLIDE_IN, "quintOut")
	else
		self._slide = Anim.tween(panel, { AnchorPoint = HIDDEN_ANCHOR }, SLIDE_OUT, "quadIn", function()
			if not self._visible and self.panel == panel then
				panel.Visible = false
			end
		end)
	end
end

-- Ouverture : les lignes d'avertissement arrivent en cascade, puis le code apparaît en fondu
function CodeView:_animateContent()
	if not Anim.enabled() then
		return
	end
	local rows = self._warningRows
	if #rows > 0 then
		Anim.stagger(rows, 0.05, Vector2.new(0, 6))
	end
	if self._codeArea and fadeFits(self._codeArea) then
		Anim.fadeIn(self._codeArea, 0.2, 0.05 + math.min(#rows, 6) * 0.03)
	end
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

-- Affiche (ou met à jour) le code. warnings = tableau de textes (facultatif).
-- mode (facultatif, extension) : "server" | "local" | "module" ; sinon déduit de l'en-tête du code.
function CodeView:show(code, warnings, mode)
	if not self.panel then
		return
	end
	local newCode = tostring(code or "")
	if newCode ~= self._code then
		-- les numéros de ligne ont pu changer : l'ancien surlignage ne veut plus rien dire
		self._highlight = nil
	end
	self._code = newCode
	self._warnings = {}
	if type(warnings) == "table" then
		for _, w in ipairs(warnings) do
			table.insert(self._warnings, tostring(w))
		end
	end
	if MODE_PILLS[mode] ~= nil then
		self._mode = mode
	else
		self._mode = detectMode(self._code)
	end
	local wasVisible = self._visible
	self._visible = true
	-- (encore visible s'il était en train de repartir : il revient d'où il est)
	local onScreen = self.panel.Visible
	self.panel.Visible = true
	self:_applyHeader()
	self:_build(wasVisible)
	if self._pendingLine ~= nil then
		local pending = self._pendingLine
		self._pendingLine = nil
		self:scrollToLine(pending[1], pending[2])
	elseif self._highlight ~= nil then
		self:_drawHighlight(false)
	end
	if not wasVisible then
		if not onScreen then
			self.panel.AnchorPoint = HIDDEN_ANCHOR
		end
		self:_slideTo(true)
		self:_animateContent()
	end
end

function CodeView:hide()
	local wasVisible = self._visible
	self._visible = false
	self._scrollToken += 1
	if self.selectBox then
		pcall(function()
			self.selectBox:ReleaseFocus()
		end)
	end
	if self.panel then
		if wasVisible then
			self:_slideTo(false)
		elseif not (self._slide and self._slide:isPlaying()) then
			self.panel.Visible = false
			self.panel.AnchorPoint = HIDDEN_ANCHOR
		end
	end
	if self.dialogs then
		pcall(function()
			self.dialogs:hideTooltip()
		end)
	end
end

function CodeView:isVisible()
	return self._visible
end

-- Extension : vrai si le point écran est sur le panneau (affiché)
function CodeView:isInside(screenPos)
	if not self._visible or not self.panel or typeof(screenPos) ~= "Vector2" then
		return false
	end
	return Util.pointInGui(screenPos, self.panel)
end

function CodeView:destroy()
	self._visible = false
	self._scrollToken += 1
	if self._slide then
		self._slide:cancel()
		self._slide = nil
	end
	self.contentMaid:clean()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.panel then
		self.panel:Destroy()
		self.panel = nil
	end
end

return CodeView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Defs_Actions</string><ProtectedString name="Source"><![CDATA[-- Defs_Actions : blocs de la catégorie « Actions »
-- (déplacer, tourner, faire glisser, taille, ancrer, détruire, cloner, sons, propriétés…)
-- Les blocs acceptent une partie (BasePart), un modèle (Model) ou un joueur (-> son personnage).
-- Le code généré passe toujours par les aides de Shared (_obj, _parties, _partie, _pivot,
-- _setPivot, _pos, _avertir) : si l'objet n'existe pas, un avertissement en français est
-- affiché dans la sortie et rien ne se passe (le script ne plante jamais).

local Shared = require(script.Parent.Shared)

local objInput = Shared.objInput

-- Entrée nombre
local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	return g.helper(nom) .. "(" .. table.concat({ ... }, ", ") .. ")"
end

-- Sons intégrés à Roblox (fichiers livrés avec le client, aucun ID nécessaire)
local SONS = {
	{ "bip", '"rbxasset://sounds/electronicpingshort.wav"' },
	{ "clic de bouton", '"rbxasset://sounds/button.wav"' },
	{ "saut", '"rbxasset://sounds/action_jump.mp3"' },
	{ "souffle (swoosh)", '"rbxasset://sounds/swoosh.wav"' },
	{ "aïe (uuhhh)", '"rbxasset://sounds/uuhhh.mp3"' },
	{ "choc", '"rbxasset://sounds/collide.wav"' },
}

