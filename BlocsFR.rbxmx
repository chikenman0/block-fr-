								{ "vfx_eclair", CIBLE = { "tp_cible" }, COULEUR = { 251, 146, 60 } },
								{ "vfx_degats", TEXTE = "-20", CIBLE = { "tp_cible" } },
								{ "vfx_contour", CIBLE = { "tp_cible" }, COULEUR = { 239, 68, 68 }, DUREE = 0.5 },
