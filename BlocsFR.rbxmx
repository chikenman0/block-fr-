---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local function isFiniteNumber(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function finiteOr0(x)
	local n = tonumber(x)
	if isFiniteNumber(n) then
		return n
	end
	return 0
end

local function trim(s)
	return Util.trim(tostring(s or ""))
end

local function oneLine(value, maxLen)
	local s = string.gsub(tostring(value or ""), "%c+", " ")
	s = Util.trim(s)
	maxLen = maxLen or 300
	if #s > maxLen then
		local cut = maxLen
		while cut > 0 do
			local b = string.byte(s, cut + 1)
			if b == nil or b < 0x80 or b >= 0xC0 then
				break
			end
			cut -= 1
		end
		s = string.sub(s, 1, cut) .. "…"
	end
	return s
end

-- Nombre écrit à la française (virgule) pour les messages
local function frNumber(n)
	local text
	if n == math.floor(n) and math.abs(n) < 1e15 then
		text = string.format("%d", n)
	else
		text = string.format("%.3g", n)
	end
	return (string.gsub(text, "%.", ","))
end

local function quote(text)
	return "« " .. tostring(text) .. " »"
end

-- « a », « b », « c »… (au plus maxCount noms)
local function quoteList(names, maxCount)
	local out = {}
	for i, name in ipairs(names) do
		if i > maxCount then
			table.insert(out, "…")
			break
		end
		table.insert(out, quote(name))
	end
	return table.concat(out, ", ")
end

-- Clé de comparaison « presque pareil » : sans accents, minuscules, espaces retirés
local function looseKey(s)
	local folded = Util.fold(trim(s))
	return (string.gsub(folded, "%s+", ""))
end

-- Nom de la liste écrit « presque pareil » que name (accents, majuscules, espaces), ou nil
local function closeName(name, list)
	local key = looseKey(name)
	for _, other in ipairs(list) do
		if other ~= name and looseKey(other) == key then
			return other
		end
	end
	return nil
end

-- Nombre de lettres à changer pour passer de a à b (textes courts : au-delà de 40 octets, « loin »)
local function editDistance(a, b)
	local la, lb = #a, #b
	if la > 40 or lb > 40 then
		return math.huge
	end
	local previous = {}
	for j = 0, lb do
		previous[j] = j
	end
	for i = 1, la do
		local current = { [0] = i }
		local ca = string.byte(a, i)
		for j = 1, lb do
			local cost = 1
			if ca == string.byte(b, j) then
				cost = 0
			end
			current[j] = math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
		end
		previous = current
	end
	return previous[lb]
end

-- Nom proche dans la liste (presque pareil, sinon une ou deux lettres de différence), ou nil
local function similarName(name, list)
	local close = closeName(name, list)
	if close ~= nil then
		return close
	end
	local key = looseKey(name)
	if #key < 3 then
		return nil
	end
	local limit = 1
	if #key >= 6 then
		limit = 2
	end
	local best, bestDistance = nil, math.huge
	for _, other in ipairs(list) do
		if other ~= name then
			local d = editDistance(key, looseKey(other))
			if d <= limit and d < bestDistance then
				best, bestDistance = other, d
			end
		end
	end
	return best
end

local function plainLabel(def)
	if type(def) ~= "table" then
		return "?"
	end
	local ok, text = pcall(Registry.plainLabel, def)
	if ok and type(text) == "string" then
		return text
	end
	return tostring(def.id)
end

local function getDef(block)
	if type(block) ~= "table" or type(block.def) ~= "string" then
		return nil
	end
	return Registry.get(block.def)
end

local function inputSlot(block, name)
	if type(block) ~= "table" or type(block.inputs) ~= "table" then
		return nil
	end
	local slot = block.inputs[name]
	if type(slot) ~= "table" then
		return nil
	end
	return slot
end

-- Bloc branché dans une entrée (id) ou nil. Un bloc valeur désactivé (SPEC §32) compte comme absent :
-- comme dans CodeGen, la case garde alors sa valeur écrite.
local function pluggedId(A, block, name)
	local slot = inputSlot(block, name)
	if slot == nil or slot.block == nil then
		return nil
	end
	local plugged = A.blocks[slot.block]
	if type(plugged) ~= "table" or plugged.disabled == true then
		return nil
	end
	return slot.block
end

-- Vrai si un bloc valeur désactivé est branché dans cette entrée
local function disabledPlugged(A, block, name)
	local slot = inputSlot(block, name)
	if slot == nil or slot.block == nil then
		return false
	end
	local plugged = A.blocks[slot.block]
	return type(plugged) == "table" and plugged.disabled == true
end

-- Valeur littérale d'une entrée (nil si un bloc valeur y est branché)
local function literal(A, block, name)
	if pluggedId(A, block, name) ~= nil then
		return nil
	end
	local slot = inputSlot(block, name)
	if slot == nil then
		return nil
	end
	return slot.value
end

local function literalNumber(A, block, name)
	local value = literal(A, block, name)
	if value == nil then
		return nil
	end
	local n = Util.parseNumber(value)
	if n == nil and type(value) == "string" then
		n = tonumber(Util.trim(value))
	end
	if isFiniteNumber(n) then
		return n
	end
	return nil
end

local function literalText(A, block, name)
	local value = literal(A, block, name)
	if type(value) == "string" then
		return value
	end
	if isFiniteNumber(value) then
		return tostring(value)
	end
	return nil
end

-- Libellé d'un bloc pour les messages (« si … alors », variable « score »…)
local function nameOf(A, id)
	local block = A.blocks[id]
	local def = getDef(block)
	if def == nil then
		return "bloc inconnu"
	end
	if def.id == "var_valeur" then
		local name = literalText(A, block, "VAR")
		if name then
			return "variable " .. quote(name)
		end
		return "variable"
	end
	return plainLabel(def)
end

local function isWorldBlock(defId)
	if WORLD_BLOCKS[defId] then
		return true
	end
	for _, prefix in ipairs(WORLD_PREFIXES) do
		if string.sub(defId, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Accès au jeu (toujours protégé : le détecteur ne doit jamais planter)
---------------------------------------------------------------------------

local function findService(name)
	local ok, service = pcall(function()
		return game:FindService(name)
	end)
	if ok then
		return service
	end
	return nil
end

local function isA(inst, className)
	local ok, result = pcall(function()
		return inst:IsA(className)
	end)
	return ok and result == true
end

local function nameOfInstance(inst)
	local ok, name = pcall(function()
		return inst.Name
	end)
	if ok and type(name) == "string" then
		return name
	end
	return "?"
end

local function fullName(inst)
	local ok, name = pcall(function()
		return inst:GetFullName()
	end)
	if ok and type(name) == "string" then
		return name
	end
	return nameOfInstance(inst)
end

local function isAlive(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, inside = pcall(function()
		return inst == game or inst:IsDescendantOf(game)
	end)
	return ok and inside == true
end

-- Service (enfant direct de game) qui contient inst, ou nil
local function topService(inst)
	local ok, result = pcall(function()
		local current = inst
		local steps = 0
		while current ~= nil and current.Parent ~= game and steps < 1000 do
			current = current.Parent
			steps += 1
		end
		if current ~= nil and current.Parent == game then
			return current
		end
		return nil
	end)
	if ok then
		return result
	end
	return nil
end

-- Cherche un objet comme l'aide _objetNomme du code généré (Workspace, puis rangements, puis chemin)
local function findNamed(nom)
	local ok, found = pcall(function()
		if string.lower(nom) == "workspace" then
			return workspace
		end
		local f = workspace:FindFirstChild(nom, true)
		if f then
			return f
		end
		for _, serviceName in ipairs({ "ReplicatedStorage", "ServerStorage", "Lighting" }) do
			local service = findService(serviceName)
			if service then
				f = service:FindFirstChild(nom, true)
				if f then
					return f
				end
			end
		end
		if string.find(nom, ".", 1, true) then
			local current = game
			for part in string.gmatch(nom, "[^%.]+") do
				local nextInst = current:FindFirstChild(part)
				if nextInst == nil and current == game then
					nextInst = findService(part)
				end
				if nextInst == nil then
					return nil
				end
				current = nextInst
			end
			if current ~= game then
				return current
			end
			return nil
		end
		return findService(nom)
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- Index (mis en cache) des noms d'objets du jeu : minuscules -> vrai nom, et noms des outils
local nameIndex = { time = -math.huge, names = {}, tools = {}, toolsLower = {} }

local function getNameIndex()
	local now = os.clock()
	if now - nameIndex.time < INDEX_TTL then
		return nameIndex
	end
	local names, tools, toolsLower = {}, {}, {}
	local count = 0
	pcall(function()
		for _, serviceName in ipairs({ "Workspace", "ReplicatedStorage", "ServerStorage", "Lighting" }) do
			local service = findService(serviceName)
			if service then
				for _, d in ipairs(service:GetDescendants()) do
					count += 1
					if count > INDEX_MAX then
						return
					end
					local name = d.Name
					local lower = string.lower(name)
					if names[lower] == nil then
						names[lower] = name
					end
					if d:IsA("Tool") then
						tools[name] = true
						toolsLower[lower] = true
					end
				end
			end
		end
	end)
	nameIndex = { time = now, names = names, tools = tools, toolsLower = toolsLower }
	return nameIndex
end

---------------------------------------------------------------------------
-- Scripts modules du jeu (SPEC §20) : recherche comme l'aide _trouverModule, données d'un projet
---------------------------------------------------------------------------

-- inst lui-même s'il est un ModuleScript, sinon son enfant « BlocsModule », sinon son premier
-- enfant ModuleScript (nil s'il n'en contient aucun)
local function moduleOf(inst)
	local ok, found = pcall(function()
		if inst:IsA("ModuleScript") then
			return inst
		end
		local preferred = inst:FindFirstChild(MODULE_SCRIPT_NAME)
		if preferred ~= nil and preferred:IsA("ModuleScript") then
			return preferred
		end
		return inst:FindFirstChildOfClass("ModuleScript")
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

local function isBlocsModule(moduleScript)
	local ok, result = pcall(function()
		return moduleScript.Name == MODULE_SCRIPT_NAME or moduleScript:GetAttribute("BlocsFR") == true
	end)
	return ok and result == true
end

-- Objet nommé « name » (à toute profondeur dans container) qui est ou contient un module, comme
-- _trouverModule : un module Blocs FR est préféré, sinon le premier trouvé
local function findModuleIn(container, name)
	local ok, found = pcall(function()
		local first = container:FindFirstChild(name, true)
		if first == nil then
			return nil -- (réponse rapide : aucun objet de ce nom ici)
		end
		local direct = moduleOf(first)
		if direct ~= nil and isBlocsModule(direct) then
			return direct
		end
		local fallback = direct
		local count = 0
		for _, d in ipairs(container:GetDescendants()) do
			count += 1
			if count > INDEX_MAX then
				break
			end
			if d ~= first and d.Name == name then
				local other = moduleOf(d)
				if other ~= nil then
					if isBlocsModule(other) then
						return other
					end
					if fallback == nil then
						fallback = other
					end
				end
			end
		end
		return fallback
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- Chemin « Service.Dossier.Objet » (le premier morceau peut être « game »), comme _trouverModule :
-- module désigné et nom de son service, ou nil
local function moduleAtPath(path)
	if not string.find(path, ".", 1, true) then
		return nil, nil
	end
	local ok, found, serviceName = pcall(function()
		local current = game
		local service = nil
		for part in string.gmatch(path, "[^%.]+") do
			if not (current == game and part == "game") then
				local child = current:FindFirstChild(part)
				if child == nil and current == game then
					child = findService(part)
				end
				if child == nil then
					return nil, nil
				end
				if current == game then
					service = child
				end
				current = child
			end
		end
		if current == game or service == nil then
			return nil, nil
		end
		return moduleOf(current), service.ClassName
	end)
	if ok and typeof(found) == "Instance" then
		return found, serviceName
	end
	return nil, nil
end

-- Renvoie le module trouvé et le nom du service qui le contient (ou nil, nil)
local function searchModule(services, name)
	for _, serviceName in ipairs(services) do
		local service = findService(serviceName)
		if service ~= nil then
			local found = findModuleIn(service, name)
			if found ~= nil then
				return found, serviceName
			end
		end
	end
	return nil, nil
end

-- Texte JSON (morceaux recollés) des données d'un projet Blocs FR, ou nil
local function readProjectJson(inst)
	local ok, json = pcall(function()
		local parts = {}
		local index = 1
		while index < 1000 do
			local name = DATA_NAME
			if index > 1 then
				name = DATA_NAME .. "_" .. index
			end
			local holder = inst:FindFirstChild(name)
			if holder == nil or not holder:IsA("StringValue") then
				break
			end
			table.insert(parts, holder.Value)
			index += 1
		end
		if #parts == 0 then
			return nil
		end
		return table.concat(parts)
	end)
	if ok and type(json) == "string" and json ~= "" then
		return json
	end
	return nil
end

-- Ce que définit un module : fonctions (et celles qui renvoient un résultat) et valeurs
local function newModuleInfo()
	return {
		functions = {},
		functionList = {},
		returns = {},
		functionsWildcard = false, -- un nom de fonction est calculé (bloc branché) : on ne peut rien affirmer
		values = {},
		valueList = {},
		valuesWildcard = false,
	}
end

local function addName(set, list, name)
	if not set[name] then
		set[name] = true
		table.insert(list, name)
	end
end

-- Texte littéral (sans espaces autour, comme le code généré) d'une entrée d'un bloc sérialisé ;
-- 2e valeur : true si un bloc y est branché
local function dataInputText(block, name)
	if type(block.inputs) ~= "table" then
		return nil, false
	end
	local slot = block.inputs[name]
	if type(slot) ~= "table" then
		return nil, false
	end
	if slot.block ~= nil then
		return nil, true
	end
	if type(slot.value) == "string" then
		return Util.trim(slot.value), false
	end
	if isFiniteNumber(slot.value) then
		return tostring(slot.value), false
	end
	return nil, false
end

-- La pile sérialisée contient-elle « renvoyer … » (hors des blocs qui lancent une nouvelle fonction) ?
local function dataContainsReturn(blocks, headId, depth, visited)
	local current = headId
	local steps = 0
	while current ~= nil and steps < MAX_STEPS and depth <= MAX_DEPTH do
		steps += 1
		local block = blocks[current]
		if type(block) ~= "table" or visited[current] then
			return false
		end
		visited[current] = true
		if block.def == "mod_renvoyer" then
			return true
		end
		local def = nil
		if type(block.def) == "string" then
			def = Registry.get(block.def)
		end
		if type(block.sub) == "table" and not (def ~= nil and def.newFunction) then
			if dataContainsReturn(blocks, block.sub.DO, depth + 1, visited) then
				return true
			end
			if dataContainsReturn(blocks, block.sub.ELSE, depth + 1, visited) then
				return true
			end
		end
		current = block.next
	end
	return false
end

local function moduleInfoFromData(data)
	local info = newModuleInfo()
	local blocks = type(data.blocks) == "table" and data.blocks or {}
	local tops = type(data.tops) == "table" and data.tops or {}
	for _, topId in ipairs(tops) do
		local block = blocks[topId]
		if type(block) == "table" and block.def == "mod_fonction" then
			local name, plugged = dataInputText(block, "NOM")
			if plugged then
				info.functionsWildcard = true
			elseif name ~= nil and name ~= "" then
				addName(info.functions, info.functionList, name)
				if dataContainsReturn(blocks, block.next, 0, {}) then
					info.returns[name] = true
				end
			end
		end
	end
	for _, block in pairs(blocks) do
		if type(block) == "table" and block.def == "mod_definir_valeur" then
			local name, plugged = dataInputText(block, "NOM")
			if plugged then
				info.valuesWildcard = true
			elseif name ~= nil and name ~= "" then
				addName(info.values, info.valueList, name)
			end
		end
	end
	table.sort(info.valueList)
	return info
end

local moduleInfoCache = setmetatable({}, { __mode = "k" })

-- Ce que définit le projet Blocs FR enregistré dans ce ModuleScript (nil si illisible)
local function moduleInfoOf(inst)
	local json = readProjectJson(inst)
	if json == nil then
		return nil
	end
	local cached = moduleInfoCache[inst]
	if cached ~= nil and cached.json == json then
		return cached.info
	end
	local info = nil
	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if okDecode and type(data) == "table" then
		local okInfo, result = pcall(moduleInfoFromData, data)
		if okInfo and type(result) == "table" then
			info = result
		end
	end
	moduleInfoCache[inst] = { json = json, info = info }
	return info
end

local function isProjectModule(inst)
	local ok, result = pcall(function()
		if inst:GetAttribute("BlocsFR") == true then
			return true
		end
		local holder = inst:FindFirstChild(DATA_NAME)
		return holder ~= nil and holder:IsA("StringValue")
	end)
	return ok and result == true
end

---------------------------------------------------------------------------
-- Projets Blocs FR de la place (SPEC §21.9, §22.1) : statistiques créées, sauvegarde des statistiques
---------------------------------------------------------------------------

local placeIndex = { time = -math.huge, projects = {} }
local projectInfoCache = setmetatable({}, { __mode = "k" })

-- Script d'un projet Blocs FR (Script, LocalScript ou ModuleScript avec l'attribut BlocsFR)
local function isProjectScriptInst(inst)
	local ok, result = pcall(function()
		return (inst:IsA("BaseScript") or inst:IsA("ModuleScript")) and inst:GetAttribute("BlocsFR") == true
	end)
	return ok and result == true
end

-- Script Blocs FR rangé directement dans target (le projet enregistré de cette cible), ou nil
local function projectScriptIn(target)
	local ok, found = pcall(function()
		for _, child in ipairs(target:GetChildren()) do
			if (child:IsA("BaseScript") or child:IsA("ModuleScript")) and child:GetAttribute("BlocsFR") == true then
				return child
			end
		end
		return nil
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- Scripts Blocs FR de la place (liste mise en cache quelques secondes)
local function getPlaceProjects()
	local now = os.clock()
	if now - placeIndex.time < INDEX_TTL then
		return placeIndex.projects
	end
	local projects = {}
	local count = 0
	pcall(function()
		for _, serviceName in ipairs(PROJECT_SERVICES) do
			local service = findService(serviceName)
			if service then
				for _, d in ipairs(service:GetDescendants()) do
					count += 1
					if count > INDEX_MAX then
						return
					end
					if (d:IsA("BaseScript") or d:IsA("ModuleScript")) and d:GetAttribute("BlocsFR") == true then
						table.insert(projects, d)
					end
				end
			end
		end
	end)
	placeIndex = { time = now, projects = projects }
	return projects
end

-- Valeur écrite (texte exact) d'une entrée d'un bloc sérialisé ; nil si un bloc y est branché
local function dataInputRaw(block, name)
	if type(block.inputs) ~= "table" then
		return nil
	end
	local slot = block.inputs[name]
	if type(slot) ~= "table" or slot.block ~= nil then
		return nil
	end
	if type(slot.value) == "string" then
		return slot.value
	end
	if isFiniteNumber(slot.value) then
		return tostring(slot.value)
	end
	return nil
end

-- Ce que fait un projet enregistré : sauvegarde des statistiques ? statistiques créées ?
local function projectInfoFromData(data)
	local info = { sauverStats = false, stats = {} }
	local blocks = type(data.blocks) == "table" and data.blocks or {}
	for _, block in pairs(blocks) do
		if type(block) == "table" and type(block.def) == "string" and block.disabled ~= true then
			if block.def == "tp_sauver_stats" then
				info.sauverStats = true
			end
			local inputName = STAT_CREATORS[block.def]
			if inputName ~= nil then
				local name = dataInputRaw(block, inputName)
				if name ~= nil and trim(name) ~= "" then
					info.stats[name] = true
				end
			end
			local fixed = STAT_FIXED[block.def]
			if fixed ~= nil then
				info.stats[fixed] = true
			end
		end
	end
	return info
end

local function projectInfoOf(inst)
	local json = readProjectJson(inst)
	if json == nil then
		return nil
	end
	local cached = projectInfoCache[inst]
	if cached ~= nil and cached.json == json then
		return cached.info
	end
	local info = nil
	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if okDecode and type(data) == "table" then
		local okInfo, result = pcall(projectInfoFromData, data)
		if okInfo and type(result) == "table" then
			info = result
		end
	end
	projectInfoCache[inst] = { json = json, info = info }
	return info
end

-- Les autres projets Blocs FR de la place (sans celui qu'on édite) : { { inst, info } }
local function otherProjects(A)
	local out = {}
	for _, inst in ipairs(getPlaceProjects()) do
		if inst ~= A.ownProject and isAlive(inst) and isProjectScriptInst(inst) then
			local info = projectInfoOf(inst)
			if info ~= nil then
				table.insert(out, { inst = inst, info = info })
			end
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Objets cherchés par leur nom dans une case (SPEC §22.1)
---------------------------------------------------------------------------

-- Objet nommé nom (à toute profondeur) dans l'un des services, ou nil
local function findInServices(services, nom)
	for _, serviceName in ipairs(services) do
		local service = findService(serviceName)
		if service ~= nil then
			local ok, found = pcall(function()
				return service:FindFirstChild(nom, true)
			end)
			if ok and typeof(found) == "Instance" then
				return found
			end
		end
	end
	return nil
end

-- Outil (Tool) nommé nom, comme le bouton d'achat : nom exact, sinon sans tenir compte des majuscules
local function findTool(nom)
	local lower = string.lower(nom)
	local approx = nil
	local count = 0
	for _, serviceName in ipairs(TOOL_SERVICES) do
		local service = findService(serviceName)
		if service ~= nil then
			local ok, found = pcall(function()
				for _, d in ipairs(service:GetDescendants()) do
					count += 1
					if count > INDEX_MAX then
						return nil
					end
					if d:IsA("Tool") then
						if d.Name == nom then
							return d
						end
						if approx == nil and string.lower(d.Name) == lower then
							approx = d
						end
					end
				end
				return nil
			end)
			if ok and typeof(found) == "Instance" then
				return found
			end
		end
	end
	return approx
end

---------------------------------------------------------------------------
-- Écrans et éléments d'interface connus (SPEC §21.9)
---------------------------------------------------------------------------

-- Types d'un élément : attribut BlocsFR_Type (écrans Blocs FR), sinon d'après sa classe Roblox
local function guiTypesOf(obj)
	local t = obj:GetAttribute("BlocsFR_Type")
	if type(t) == "string" and t ~= "" then
		return { [t] = true }
	end
	if obj:IsA("ImageButton") then
		return { bouton = true, image = true }
	elseif obj:IsA("TextButton") then
		return { bouton = true }
	elseif obj:IsA("TextBox") then
		return { champ = true }
	elseif obj:IsA("TextLabel") then
		return { texte = true }
	elseif obj:IsA("ImageLabel") then
		return { image = true }
	elseif obj:IsA("ScrollingFrame") then
		return { liste = true, grille = true }
	end
	return { cadre = true }
end

-- index = { screens = { [nom] = { elements = { [nom] = types } } }, screenList, elements = { [nom] = types },
-- elementList } : écrans de StarterGui (faits avec Blocs FR ou non) + ctx.guiNames (écran non enregistré)
local function buildGuiIndex(guiNames)
	local index = { screens = {}, screenList = {}, elements = {}, elementList = {} }
	local function addScreen(name)
		local screen = index.screens[name]
		if screen == nil then
			screen = { elements = {} }
			index.screens[name] = screen
			table.insert(index.screenList, name)
		end
		return screen
	end
	local function addElement(screen, name, types)
		if type(name) ~= "string" or name == "" then
			return
		end
		local own = screen.elements[name]
		if own == nil then
			own = {}
			screen.elements[name] = own
		end
		local all = index.elements[name]
		if all == nil then
			all = {}
			index.elements[name] = all
			table.insert(index.elementList, name)
		end
		for t in pairs(types) do
			own[t] = true
			all[t] = true
		end
	end

	local starter = findService("StarterGui")
	if starter ~= nil then
		pcall(function()
			for _, child in ipairs(starter:GetChildren()) do
				if child:IsA("LayerCollector") then
					local screen = addScreen(child.Name)
					local madeWithBlocs = child:GetAttribute("BlocsFR_GUI") == true
					local count = 0
					for _, d in ipairs(child:GetDescendants()) do
						count += 1
						if count > GUI_MAX_DESCENDANTS then
							break
						end
						if
							d:IsA("GuiObject")
							and d:GetAttribute("BlocsFR_Partie") == nil
							and d:GetAttribute("BlocsFR_Racine") == nil
							and (not madeWithBlocs or d:GetAttribute("BlocsFR_Type") ~= nil)
						then
							addElement(screen, d.Name, guiTypesOf(d))
						end
					end
				end
			end
		end)
	end

	if type(guiNames) == "table" then
		if type(guiNames.screens) == "table" then
			for _, name in ipairs(guiNames.screens) do
				if type(name) == "string" and name ~= "" then
					addScreen(name)
				end
			end
		end
		if type(guiNames.elements) == "table" then
			for screenName, list in pairs(guiNames.elements) do
				if type(screenName) == "string" and type(list) == "table" then
					local screen = addScreen(screenName)
					for k, v in pairs(list) do
						-- { [nom] = type } (SPEC §21.8) ou { { name =, type = } } (GuiStorage.allNames)
						if type(k) == "string" and type(v) == "string" then
							addElement(screen, k, { [v] = true })
						elseif type(v) == "table" and type(v.name) == "string" then
							addElement(screen, v.name, { [tostring(v.type or "cadre")] = true })
						end
					end
				end
			end
		end
	end
	return index
end

---------------------------------------------------------------------------
-- Vérification de la syntaxe du code généré (comme DevBridge)
---------------------------------------------------------------------------

-- "Nom:12: message" -> "ligne 11 : message", 11 (lineOffset = lignes ajoutées avant le code)
local function formatCompileError(message, lineOffset)
	local text = tostring(message)
	local line, rest = string.match(text, "^.-:(%d+):%s*(.*)$")
	if line then
		local n = (tonumber(line) or 0) - lineOffset
		if n < 1 then
			n = 1
		end
		return "ligne " .. n .. " : " .. rest, n
	end
	return text, nil
end

local function checkWithLoadstring(code)
	local ls = loadstring
	if type(ls) ~= "function" then
		return nil
	end
	local okCall, fn, err = pcall(ls, code, "=BlocsFR_Code")
	if not okCall then
		return nil
	end
	if type(fn) == "function" then
		return { ok = true }
	end
	local text = tostring(err or "")
	local lower = string.lower(text)
	if text == "" or string.find(lower, "not available", 1, true) or string.find(lower, "loadstring", 1, true) then
		return nil
	end
	local errFR, line = formatCompileError(text, 0)
	return { ok = false, err = errFR, line = line }
end

local checkCounter = 0

local function findRelevant(messages, name)
	local fallback = nil
	for _, message in ipairs(messages) do
		if string.find(message, name, 1, true) then
			if string.find(message, name .. ":%d+:") then
				return message
			end
			if fallback == nil then
				fallback = message
			end
		end
	end
	return fallback
end

-- ModuleScript sans parent : "return function(...) <code> end" (compilé par require, jamais exécuté)
local function checkWithModule(code)
	local okLog, LogService = pcall(function()
		return game:GetService("LogService")
	end)
	checkCounter += 1
	local name = "BlocsFR_Verif_" .. checkCounter .. "_V"
	local moduleScript = Instance.new("ModuleScript")
	moduleScript.Name = name
	local okSource, sourceErr = pcall(function()
		moduleScript.Source = "return function(...)\n" .. code .. "\nend"
	end)
	if not okSource then
		moduleScript:Destroy()
		return { ok = nil, err = "vérification impossible : " .. tostring(sourceErr) }
	end
	local messages = {}
	local connection = nil
	if okLog and LogService then
		connection = LogService.MessageOut:Connect(function(message)
			if type(message) == "string" and string.find(message, name, 1, true) then
				table.insert(messages, message)
			end
		end)
	end
	local okRequire, requireErr = pcall(require, moduleScript)
	local result
	if okRequire then
		result = { ok = true }
	else
		local found = findRelevant(messages, name)
		local waited = 0
		while found == nil and waited < LOG_WAIT and connection ~= nil do
			waited += task.wait(0.03)
			found = findRelevant(messages, name)
		end
		local errFR, line
		if found then
			errFR, line = formatCompileError(found, 1)
		else
			errFR, line = formatCompileError(tostring(requireErr), 1)
		end
		result = { ok = false, err = errFR, line = line }
	end
	if connection then
		connection:Disconnect()
	end
	moduleScript:Destroy()
	return result
end

local codeCache = { code = nil, ok = nil, err = nil, line = nil }

-- Renvoie ok (true / false ; nil si la vérification est impossible), errFR, ligne
function Detecteur.checkCode(code)
	if type(code) ~= "string" then
		return false, "aucun code à vérifier", nil
	end
	if codeCache.code == code then
		return codeCache.ok, codeCache.err, codeCache.line
	end
	local okRun, result = pcall(function()
		return checkWithLoadstring(code) or checkWithModule(code)
	end)
	if not okRun or type(result) ~= "table" then
		return nil, "vérification impossible : " .. tostring(result), nil
	end
	local ok = result.ok
	local err = nil
	if ok ~= true then
		err = result.err
	end
	if ok ~= nil then
		codeCache = { code = code, ok = ok, err = err, line = result.line }
	end
	return ok, err, result.line
end

---------------------------------------------------------------------------
-- Explication des erreurs Luau pendant le jeu (partagée avec ErrorWatcher)
---------------------------------------------------------------------------

local TYPE_FR = {
	["nil"] = "« rien » (nil)",
	number = "un nombre",
	string = "un texte",
	boolean = "vrai / faux",
	table = "une liste (table)",
	["function"] = "une fonction",
	Instance = "un objet",
	userdata = "une valeur Roblox",
	Vector3 = "une position (Vector3)",
	Vector2 = "un Vector2",
	CFrame = "une position et une rotation (CFrame)",
	Color3 = "une couleur",
	BrickColor = "une couleur (BrickColor)",
	EnumItem = "un choix de menu (Enum)",
	UDim2 = "une taille d'interface (UDim2)",
	thread = "une tâche",
}

local ARITH_FR = {
	add = "une addition",
	sub = "une soustraction",
	mul = "une multiplication",
	div = "une division",
	idiv = "une division entière",
	mod = "un reste de division",
	pow = "une puissance",
	unm = "un changement de signe",
}

local function typeFr(t)
	return TYPE_FR[t] or ("une valeur de type " .. tostring(t))
end

-- Retire le préfixe « Chemin.Du.Script:12: » d'un message d'erreur
local function stripLocation(message)
	local text = tostring(message or "")
	local rest = string.match(text, "^[^\n]-:%d+:%s*(.*)$")
	if rest and rest ~= "" then
		return rest
	end
	return text
end

Detecteur.stripLocation = stripLocation

-- Renvoie l'explication (français simple) et un titre court
function Detecteur.explain(message)
	local raw = oneLine(stripLocation(message), 400)
	local lower = string.lower(raw)

	-- Scripts modules (SPEC §20)
	if string.find(lower, "requested module experienced an error while loading", 1, true) then
		return "Un script module utilisé ici a une erreur pendant son chargement : ses fonctions et ses valeurs ne sont pas disponibles. Ouvre ce module (son erreur est aussi affichée dans la sortie) et corrige-la.",
			"Module en erreur"
	end
	if string.find(lower, "required recursively", 1, true) then
		return "Deux scripts modules se chargent l'un l'autre (ou un module se charge lui-même) pendant leur chargement : Roblox ne peut pas finir. Retire l'un des deux appels, ou fais-le plus tard (dans une fonction plutôt que dans « Quand le module est chargé »).",
			"Modules qui se chargent en boucle"
	end
	if string.find(lower, "did not return exactly one value", 1, true) then
		return "Ce script module ne renvoie pas exactement une valeur à la fin de son code : les autres scripts ne peuvent pas l'utiliser. Un module Blocs FR le fait tout seul : réenregistre-le depuis l'éditeur de blocs.",
			"Module sans valeur renvoyée"
	end
	if string.find(lower, "attempted to call require with invalid argument", 1, true) then
		return "Le script a essayé de charger quelque chose qui n'est pas un script module. Vérifie le nom du module dans le bloc : il doit désigner un script module, ou un dossier qui en contient un.",
			"Ce n'est pas un module"
	end

	local key = string.match(raw, "attempt to index nil with '([^']*)'")
	if key ~= nil or string.find(lower, "attempt to index nil", 1, true) then
		local what = ""
		if key and key ~= "" then
			what = " (il voulait « " .. key .. " »)"
		end
		return "Le bloc essaie d'utiliser quelque chose qui n'existe pas : la valeur est « rien »"
			.. what
			.. ". Souvent : un objet introuvable (nom mal écrit dans « objet nommé … »), un joueur ou un personnage absent, ou un objet déjà détruit. Vérifie avec « … existe » avant de l'utiliser.",
			"Objet introuvable (« rien »)"
	end

	local indexedType, indexKey = string.match(raw, "attempt to index (%w+) with '([^']*)'")
	if indexedType then
		return "Le bloc traite "
			.. typeFr(indexedType)
			.. " comme un objet (il voulait « "
			.. indexKey
			.. " »). Vérifie que la case contient bien un objet (une partie, un modèle, un joueur…) et pas un nombre ou un texte.",
			"Ce n'est pas un objet"
	end

	local op, left, right = string.match(raw, "attempt to perform arithmetic %((%w+)%) on (%w+) and (%w+)")
	if op == nil then
		op, left = string.match(raw, "attempt to perform arithmetic %((%w+)%) on (%w+)")
	end
	if op then
		local types = typeFr(left)
		if right and right ~= left then
			types = types .. " et " .. typeFr(right)
		end
		return "Un calcul ("
			.. (ARITH_FR[op] or "opération")
			.. ") utilise une valeur qui n'est pas un nombre : "
			.. types
			.. ". Vérifie les cases du calcul : une variable vide, un texte ou un objet ne peuvent pas être calculés.",
			"Calcul impossible"
	end
	if string.find(lower, "attempt to perform arithmetic", 1, true) then
		return "Un calcul utilise une valeur qui n'est pas un nombre (un texte, un objet ou « rien »). Vérifie les cases du calcul.",
			"Calcul impossible"
	end

	local cmpA, cmpB = string.match(raw, "attempt to compare (%w+) [<>=~]+ (%w+)")
	if cmpA == nil then
		cmpA, cmpB = string.match(raw, "attempt to compare (%w+) and (%w+)")
	end
	if cmpA or string.find(lower, "attempt to compare", 1, true) then
		local detail = ""
		if cmpA then
			detail = " (" .. typeFr(cmpA) .. " et " .. typeFr(cmpB) .. ")"
		end
		return "Comparaison impossible"
			.. detail
			.. " : « plus grand que » et « plus petit que » ne marchent qu'avec deux nombres. Vérifie que les deux cases contiennent bien des nombres.",
			"Comparaison impossible"
	end

	local catA, catB = string.match(raw, "attempt to concatenate (%w+) with (%w+)")
	if catA or string.find(lower, "attempt to concatenate", 1, true) then
		local detail = ""
		if catA then
			detail = " (" .. typeFr(catA) .. " avec " .. typeFr(catB) .. ")"
		end
		return "Impossible de coller ces valeurs bout à bout"
			.. detail
			.. ". Utilise le bloc « joindre … et … », qui accepte toutes les valeurs.",
			"Texte impossible à joindre"
	end

	if string.find(lower, "attempt to call", 1, true) then
		return "Le script a essayé d'utiliser une fonction qui n'existe pas. C'est probablement une erreur interne de Blocs FR : signale-la avec le projet concerné.",
			"Fonction introuvable"
	end

	local member, className, objectName = string.match(raw, "^(.-) is not a valid member of (%w+) \"(.-)\"")
	if member == nil then
		member, className = string.match(raw, "^(.-) is not a valid member of (%w+)")
	end
	if member then
		local where = tostring(className)
		if objectName and objectName ~= "" then
			where = where .. " « " .. objectName .. " »"
		end
		return "« "
			.. member
			.. " » n'existe pas dans "
			.. where
			.. ". Vérifie l'orthographe du nom (majuscules comprises), ou que l'objet existe bien à ce moment-là (il est peut-être créé plus tard ou a été détruit).",
			"Nom introuvable"
	end

	if string.find(lower, "script timeout", 1, true) or string.find(lower, "exhausted allowed execution time", 1, true) then
		return "Le script a travaillé trop longtemps sans faire de pause et Roblox l'a arrêté. Une très longue boucle (« répéter 1000000 fois »…) doit contenir un bloc « attendre ».",
			"Script trop long sans pause"
	end

	local prop = string.match(raw, "Unable to assign property (%w+)")
	if prop then
		return "La valeur donnée à la propriété « "
			.. prop
			.. " » n'a pas le bon type (par exemple un texte au lieu d'un nombre, ou un nombre au lieu d'une couleur). Vérifie la valeur choisie.",
			"Valeur de propriété invalide"
	end

	local argN, fnName, expected, got = string.match(raw, "invalid argument #(%d+) to '([^']*)' %((%w+) expected, got (%w+)%)")
	if argN then
		return "Mauvaise valeur donnée à « "
			.. fnName
			.. " » : il fallait "
			.. typeFr(expected)
			.. ", mais il a reçu "
			.. typeFr(got)
			.. ". Vérifie la case correspondante du bloc.",
			"Mauvaise valeur"
	end
	if string.find(lower, "invalid argument", 1, true) then
		return "Un bloc a reçu une valeur qu'il ne sait pas utiliser. Vérifie les cases du bloc (nombre, texte, objet…).",
			"Mauvaise valeur"
	end

	if string.find(lower, "'for' initial value", 1, true) or string.find(lower, "'for' limit", 1, true) or string.find(lower, "'for' step", 1, true) or string.find(lower, "invalid 'for'", 1, true) then
		return "La boucle « répéter … fois » ou « pour … allant de … à … » a reçu une valeur qui n'est pas un nombre. Mets un nombre dans ses cases.",
			"Boucle sans nombre"
	end

	if string.find(lower, "stack overflow", 1, true) then
		return "Trop d'appels les uns dans les autres : quelque chose se relance lui-même sans fin (par exemple un message qui se renvoie lui-même). Ajoute une condition pour arrêter.",
			"Boucle d'appels sans fin"
	end

	if string.find(lower, "re-entrancy", 1, true) or string.find(lower, "reentrancy", 1, true) then
		return "Un événement se déclenche lui-même en boucle (par exemple « Quand je reçois le message » qui renvoie le même message). Ajoute une condition ou un « attendre ».",
			"Événement en boucle"
	end

	local locked = string.match(raw, "The Parent property of (.-) is locked")
	if locked or string.find(lower, "parent property", 1, true) then
		return "Impossible de déplacer cet objet"
			.. ((locked and (" (« " .. locked .. " »)")) or "")
			.. " : il a déjà été détruit (ou il est protégé par Roblox). Vérifie qu'il existe encore avant de l'utiliser.",
			"Objet détruit"
	end

	if string.find(lower, "attempt to get length", 1, true) then
		return "Impossible de compter la longueur de cette valeur : ce n'est pas un texte. Vérifie la case du bloc « longueur de … ».",
			"Longueur impossible"
	end

	local castFrom, castTo = string.match(raw, "Unable to cast (.-) to (%w+)")
	if castFrom then
		return "Type de valeur incorrect : « "
			.. castFrom
			.. " » ne peut pas être utilisé comme "
			.. castTo
			.. ". Vérifie que la case contient le bon genre de valeur.",
			"Type de valeur incorrect"
	end

	local waitingFor = string.match(raw, "Infinite yield possible on '(.-)'")
	if waitingFor then
		return "Le script attend un objet qui n'arrive jamais : « " .. waitingFor .. " ». Vérifie son nom et qu'il existe bien.",
			"Objet jamais trouvé"
	end

	if string.find(lower, "sound", 1, true) and (string.find(lower, "failed to load", 1, true) or string.find(lower, "asset", 1, true)) then
		return "Le son n'a pas pu être chargé : l'ID est peut-être faux, ou ce son n'est pas autorisé dans ton jeu.",
			"Son introuvable"
	end

	if string.find(lower, "expected", 1, true) and (string.find(lower, "got", 1, true) or string.find(lower, "near", 1, true)) then
		return "Le code contient une erreur d'écriture (syntaxe). C'est une erreur interne de Blocs FR : signale-la avec le projet concerné.",
			"Erreur interne de Blocs FR"
	end

	if raw == "" then
		return "Le script s'est arrêté à cause d'une erreur sans message.", "Erreur pendant le jeu"
	end
	return "Le script s'est arrêté à cause de cette erreur : « "
		.. raw
		.. " ». Les blocs suivants de cet événement n'ont pas été exécutés.",
		"Erreur pendant le jeu"
end

---------------------------------------------------------------------------
-- Tri, comptage, table des lignes
---------------------------------------------------------------------------

local function problemLess(p, q)
	local rp = SEVERITY_RANK[p.severity] or 4
	local rq = SEVERITY_RANK[q.severity] or 4
	if rp ~= rq then
		return rp < rq
	end
	local op = tonumber(p.order) or math.huge
	local oq = tonumber(q.order) or math.huge
	if op ~= oq then
		return op < oq
	end
	local ip = tonumber(p.index) or 0
	local iq = tonumber(q.index) or 0
	if ip ~= iq then
		return ip < iq
	end
	return tostring(p.key or p.title) < tostring(q.key or q.title)
end

-- Trie une liste de problèmes (statiques, code et test mélangés) sur place et la renvoie
function Detecteur.sort(problems)
	if type(problems) ~= "table" then
		return {}
	end
	pcall(table.sort, problems, problemLess)
	return problems
end

function Detecteur.count(problems)
	local counts = { erreur = 0, avertissement = 0, conseil = 0 }
	if type(problems) == "table" then
		for _, p in ipairs(problems) do
			if type(p) == "table" and counts[p.severity] ~= nil then
				counts[p.severity] += 1
			end
		end
	end
	return counts
end

-- Entrée la plus précise (zone la plus intérieure) qui contient la ligne, ou nil
function Detecteur.blockAtLine(lineMap, line)
	line = tonumber(line)
	if type(lineMap) ~= "table" or line == nil then
		return nil
	end
	local best = nil
	for _, entry in ipairs(lineMap) do
		if type(entry) == "table" then
			local first = tonumber(entry.line)
			local last = tonumber(entry.last)
			if first ~= nil and first <= line then
				local inside
				if last ~= nil then
					inside = line <= last
				else
					inside = true -- ancienne forme sans « last » : zone jusqu'à la suivante
				end
				if inside then
					if best == nil then
						best = entry
					else
						local bestFirst = tonumber(best.line) or 0
						local bestLast = tonumber(best.last) or math.huge
						local lastN = last or math.huge
						if first > bestFirst or (first == bestFirst and lastN <= bestLast) then
							best = entry
						end
					end
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- Analyse : état et ajout de problèmes
---------------------------------------------------------------------------

-- extra (facultatif) : champs ajoutés au problème ; extra.key remplace la clé de dédoublonnage
local function add(A, severity, blockId, title, message, extra)
	local key = severity .. "|" .. tostring(blockId) .. "|" .. title
	if type(extra) == "table" and type(extra.key) == "string" then
		key = extra.key
	end
	if A.seen[key] then
		return nil
	end
	A.seen[key] = true
	local problem = {
		severity = severity,
		blockId = blockId,
		title = title,
		message = message,
		source = "statique",
		key = key,
	}
	if type(extra) == "table" then
		for k, v in pairs(extra) do
			problem[k] = v
		end
	end
	if blockId ~= nil then
		problem.order = A.order[blockId] or (A.orderCount + 1)
	else
		problem.order = problem.order or -1
	end
	problem.index = #A.problems + 1
	table.insert(A.problems, problem)
	return problem
end

local function inputNames(block)
	local names = {}
	local def = getDef(block)
	if def then
		for _, spec in ipairs(def.inputs or {}) do
			if type(spec) == "table" and type(spec.name) == "string" then
				table.insert(names, spec.name)
			end
		end
	elseif type(block.inputs) == "table" then
		for name in pairs(block.inputs) do
			if type(name) == "string" then
				table.insert(names, name)
			end
		end
		table.sort(names)
	end
	return names
end

-- Numérote les blocs dans l'ordre de lecture (piles triées par y puis x, puis de haut en bas)
local function computeOrder(A)
	local list = {}
	for index, id in ipairs(A.tops) do
		local block = A.blocks[id]
		if type(block) == "table" then
			table.insert(list, { id = id, x = finiteOr0(block.x), y = finiteOr0(block.y), index = index })
		end
	end
	table.sort(list, function(p, q)
		if p.y ~= q.y then
			return p.y < q.y
		end
		if p.x ~= q.x then
			return p.x < q.x
		end
		return p.index < q.index
	end)
	local counter = 0
	local seen = {}
	local function visit(id, rootId, depth)
		local current = id
		local steps = 0
		while current ~= nil and steps < MAX_STEPS do
			steps += 1
			local block = A.blocks[current]
			if type(block) ~= "table" or seen[current] then
				break
			end
			seen[current] = true
			counter += 1
			A.order[current] = counter
			A.rootOf[current] = rootId
			if depth < MAX_DEPTH then
				for _, name in ipairs(inputNames(block)) do
					local slot = inputSlot(block, name)
					if slot and slot.block ~= nil then
						visit(slot.block, rootId, depth + 1)
					end
				end
				if type(block.sub) == "table" then
					if block.sub.DO ~= nil then
						visit(block.sub.DO, rootId, depth + 1)
					end
					if block.sub.ELSE ~= nil then
						visit(block.sub.ELSE, rootId, depth + 1)
					end
				end
			end
			current = block.next
		end
	end
	for _, top in ipairs(list) do
		visit(top.id, top.id, 0)
	end
	A.orderCount = counter
	A.sortedTops = list
end

-- Parcourt une pile (suite + corps + blocs valeur). fn(id, block, def) ; options :
-- skipNewFunction (ne pas entrer dans « lancer en parallèle » / « après »), skipLoops (ne pas entrer
-- dans les boucles), withInputs (visiter aussi les blocs valeur), includeDisabled (visiter aussi les
-- blocs désactivés, sautés sinon avec leurs corps comme dans CodeGen). Renvoie true dès que fn renvoie true.
local function scan(A, headId, options, fn, depth)
	depth = depth or 0
	if headId == nil or depth > MAX_DEPTH then
		return false
	end
	local current = headId
	local steps = 0
	local visited = {}
	while current ~= nil and steps < MAX_STEPS do
		steps += 1
		local block = A.blocks[current]
		if type(block) ~= "table" or visited[current] then
			return false
		end
		visited[current] = true
		if block.disabled == true and not options.includeDisabled then
			-- bloc désactivé (SPEC §32) : absent du code, la suite de la pile continue
			current = block.next
			continue
		end
		local def = getDef(block)
		if def ~= nil then
			if fn(current, block, def) then
				return true
			end
			if options.withInputs then
				for _, name in ipairs(inputNames(block)) do
					local plugged = pluggedId(A, block, name)
					if plugged ~= nil and scan(A, plugged, options, fn, depth + 1) then
						return true
					end
				end
			end
			if (def.shape == "c" or def.shape == "c2") and type(block.sub) == "table" then
				local enter = true
				if options.skipNewFunction and def.newFunction then
					enter = false
				end
				if options.skipLoops and def.loop then
					enter = false
				end
				if enter then
					if scan(A, block.sub.DO, options, fn, depth + 1) then
						return true
					end
					if def.shape == "c2" and scan(A, block.sub.ELSE, options, fn, depth + 1) then
						return true
					end
				end
			end
			if def.noNext or def.shape == "cap" then
				return false
			end
		end
		current = block.next
	end
	return false
end

-- Vrai si la pile fait attendre le script (attendre, glisser, boucle qui fait une pause…)
local function containsWait(A, headId)
	return scan(A, headId, { skipNewFunction = true }, function(_, _, def)
		return WAIT_BLOCKS[def.id] == true or YIELD_LOOPS[def.id] == true
	end)
end

local function containsVisual(A, headId)
	return scan(A, headId, { skipNewFunction = true }, function(_, _, def)
		return VISUAL_BLOCKS[def.id] == true
	end)
end

-- Premier bloc « qui compte » de la pile (id) ou nil
local function firstCounting(A, headId)
	local found = nil
	scan(A, headId, { skipNewFunction = false }, function(id, _, def)
		if COUNTING_BLOCKS[def.id] then
			found = id
			return true
		end
		return false
	end)
	return found
end

local function containsDefs(A, headId, ids, options)
	return scan(A, headId, options or {}, function(_, _, def)
		return ids[def.id] == true
	end)
end

-- Vrai si le corps d'une boucle peut en sortir (sortir de la boucle, arrêter, erreur)
local function loopCanExit(A, bodyId)
	local direct = scan(A, bodyId, { skipNewFunction = true, skipLoops = true }, function(_, _, def)
		return def.id == "ctrl_sortir_boucle"
	end)
	if direct then
		return true
	end
	return scan(A, bodyId, { skipNewFunction = true }, function(_, _, def)
		return def.id == "ctrl_arreter" or def.id == "dbg_erreur"
	end)
end

-- Idem dans un script module : « renvoyer … » termine aussi la fonction (donc la boucle)
local function moduleLoopCanExit(A, bodyId)
	if loopCanExit(A, bodyId) then
		return true
	end
	return scan(A, bodyId, { skipNewFunction = true }, function(_, _, def)
		return def.id == "mod_renvoyer"
	end)
end

---------------------------------------------------------------------------
-- Analyse : contrôles par bloc
---------------------------------------------------------------------------

local checkReporter -- (A, id, env)
local walkChain -- (A, headId, env, depth)

local function useContext(A, id, name, env)
	if name == "dernierObjet" then
		table.insert(A.lastObjectUses, id)
		return
	end
	if env.provided[name] then
		return
	end
	local key = tostring(env.hatId) .. "|" .. name
	if A.contextReported[key] then
		return
	end
	A.contextReported[key] = true
	local info = CONTEXT_INFO[name]
	if info == nil then
		return
	end
	-- Script module : la fonction ne sait pas de quel joueur il s'agit, il faut le lui donner
	local moduleContext = MODULE_CONTEXT[name]
	local hatDefId = env.hatDef and env.hatDef.id or nil
	if A.mode == "module" and moduleContext ~= nil and (hatDefId == "mod_fonction" or hatDefId == "mod_au_chargement") then
		local message
		if hatDefId == "mod_fonction" then
			message = "Dans un script module, « "
				.. moduleContext.what
				.. " » vaut « rien » sous « Définir la fonction … » : le module ne sait pas de qui il s'agit. Ajoute un paramètre à la fonction (par exemple « "
				.. moduleContext.param
				.. " ») et utilise le bloc « paramètre "
				.. moduleContext.param
				.. " » à la place : le script qui appelle la fonction le donnera (par exemple avec « "
				.. moduleContext.what
				.. " »)."
		else
			message = "« Quand le module est chargé » ne concerne personne en particulier : « "
				.. moduleContext.what
				.. " » vaut « rien » ici. Mets ces blocs dans une fonction (« Définir la fonction … ») qui reçoit "
				.. moduleContext.what
				.. " en paramètre."
		end
		add(A, "avertissement", id, info.title, message)
		return
	end
	local hatLabel = plainLabel(env.hatDef)
	if name == "personnage" and env.hatDef and env.hatDef.id == "evt_joueur_rejoint" then
		add(
			A,
			"avertissement",
			id,
			info.title,
			"Quand un joueur rejoint la partie, son personnage n'est pas encore apparu : « le personnage » vaut « rien » ici. Utilise plutôt l'événement « Quand un personnage apparaît »."
		)
		return
	end
	add(A, info.severity, id, info.title, string.format(info.message, hatLabel))
end

local function checkVariableInput(A, id, def, block, spec)
	local value = literal(A, block, spec.name)
	if type(value) ~= "string" or value == "" then
		add(
			A,
			"erreur",
			id,
			"Aucune variable choisie.",
			"Le bloc « " .. plainLabel(def) .. " » n'a pas de variable. Choisis-en une dans son menu ▼, ou crée une variable dans la catégorie Variables (« ＋ Créer une variable »)."
		)
		return nil
	end
	if not A.variableSet[value] then
		add(
			A,
			"erreur",
			id,
			"Variable inconnue : " .. quote(value) .. ".",
			"La variable "
				.. quote(value)
				.. " n'existe pas dans ce projet (elle a peut-être été supprimée ou renommée). Choisis une autre variable dans le menu ▼ du bloc, ou recrée-la dans la catégorie Variables."
		)
	end
	return value
end

local function checkEmptyCondition(A, id, def, spec)
	local valueText = "faux"
	if spec.default == true then
		valueText = "vrai"
	end
	local strict = STRICT_CONDITIONS[def.id]
	if strict then
		add(
			A,
			"erreur",
			id,
			"Condition vide.",
			"Le bloc « "
				.. plainLabel(def)
				.. " » n'a pas de condition : "
				.. strict
				.. " Glisse un bloc pointu dans la case (par exemple « … > … » dans Opérateurs, ou « vrai » dans Valeurs)."
		)
	else
		add(
			A,
			"avertissement",
			id,
			"Case de condition vide.",
			"Une case pointue du bloc « "
				.. plainLabel(def)
				.. " » est vide : elle vaut toujours « "
				.. valueText
				.. " ». Glisse un bloc condition (pointu) dedans pour qu'elle serve à quelque chose."
		)
	end
end

-- Contrôles communs à tous les blocs exécutés (instructions, événements et blocs valeur)
local function checkCommon(A, id, block, def, env)
	if def.scriptType == "module" then
		if A.mode ~= "module" then
			add(
				A,
				"erreur",
				id,
				"Bloc réservé aux scripts modules.",
				"Le bloc « "
					.. plainLabel(def)
					.. " » ne fonctionne que dans un script module (un script que les autres scripts chargent pour utiliser ses fonctions et ses valeurs). Passe le projet en « Script module » en haut de l'éditeur, ou remplace ce bloc. Pour utiliser un module depuis ce script, prends plutôt « appeler la fonction … du module … »."
			)
		end
	elseif def.scriptType == "local" and A.mode ~= "local" then
		if A.mode == "module" then
			-- un module tourne du côté du script qui le charge : un seul conseil (voir checkModules)
			if A.firstLocalInModule == nil then
				A.firstLocalInModule = id
			end
		elseif def.category == "camera" then
			-- SPEC §23 : message propre aux blocs Caméra
			add(
				A,
				"erreur",
				id,
				"Bloc Caméra dans un script serveur.",
				"« "
					.. plainLabel(def)
					.. " » : la caméra n'existe que chez le joueur : utilise un script local (bouton « Script local »). Dans un script serveur, ce bloc ne fait rien."
			)
		else
			add(
				A,
				"erreur",
				id,
				"Bloc réservé aux scripts locaux.",
				"Le bloc « "
					.. plainLabel(def)
					.. " » ne fonctionne que dans un script local (il concerne l'ordinateur d'un joueur : clavier, joueur local…). Passe le projet en « Script local » en haut de l'éditeur, ou remplace ce bloc."
			)
		end
	elseif def.scriptType == "server" and A.mode ~= "server" then
		if A.mode == "module" then
			if A.firstServerInModule == nil then
				A.firstServerInModule = id
			end
		else
			add(
				A,
				"erreur",
				id,
				"Bloc réservé aux scripts serveur.",
				"Le bloc « "
					.. plainLabel(def)
					.. " » ne fonctionne que dans un script serveur (un script local ne peut pas le faire pour tout le monde). Passe le projet en « Script serveur » en haut de l'éditeur, ou utilise « envoyer le message … au serveur »."
			)
		end
	end
	-- Blocs Interface dans un script serveur : ils agissent sur l'écran du « joueur » de l'événement
	-- (SPEC §21.7, §21.9). Un avertissement par événement.
	if A.mode == "server" and def.category == "interface" and def.shape ~= "hat" and not env.provided.joueur then
		add(
			A,
			"avertissement",
			id,
			"Bloc Interface sans joueur.",
			"« "
				.. plainLabel(def)
				.. " » : dans un script serveur, ce bloc a besoin d'un joueur : place-le sous un événement qui donne un joueur (« Quand un joueur rejoint la partie », « Quand cet objet est cliqué »…), ou utilise un script local (les blocs sous un écran en sont un).",
			{ key = "gui-joueur|" .. tostring(env.hatId) }
		)
	end
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" and type(spec.name) == "string" then
			local plugged = pluggedId(A, block, spec.name)
			if plugged ~= nil then
				checkReporter(A, plugged, env)
			elseif spec.kind == "boolean" then
				-- (condition désactivée exprès : on ne la signale pas comme une case vide)
				if not disabledPlugged(A, block, spec.name) then
					checkEmptyCondition(A, id, def, spec)
				end
			elseif spec.kind == "variable" then
				checkVariableInput(A, id, def, block, spec)
			elseif spec.kind == "gui" then
				-- nom d'écran / d'élément : vérifié après le parcours (checkGuiNames)
				local value = literalText(A, block, spec.name)
				if value == nil or trim(value) == "" then
					local what = "un élément de l'interface"
					if spec.filter == "ecran" then
						what = "un écran"
					end
					add(
						A,
						"avertissement",
						id,
						"Case d'interface vide.",
						"Une case de « "
							.. plainLabel(def)
							.. " » est vide : choisis "
							.. what
							.. " dans son menu ▼ (ou écris son nom exact), sinon le bloc ne fera rien."
					)
				else
					-- (le code généré enlève aussi les espaces au début et à la fin : _guiNom)
					table.insert(A.guiUses, { id = id, label = plainLabel(def), filter = spec.filter or "element", value = trim(value) })
				end
			elseif spec.kind == "dropdown" then
				local value = literal(A, block, spec.name)
				local contextName = nil
				if type(value) == "string" then
					contextName = CONTEXT_CODES[value]
				end
				-- Les blocs « Tout prêts » et « Effets » utilisent « (personnage or joueur) » : sous un
				-- événement qui ne fournit que le joueur (ex. « Quand je reçois le message … »), son
				-- personnage est pris.
				if
					contextName == "personnage"
					and PERSO_OR_PLAYER_CATEGORIES[def.category]
					and (env.provided.joueur or A.mode == "local")
				then
					contextName = nil
				end
				if contextName then
					useContext(A, id, contextName, env)
				end
			end
		end
	end
end

local function checkDuration(A, id, def, block, inputName, what)
	local n = literalNumber(A, block, inputName)
	if n == nil then
		return
	end
	if n < 0 then
		add(
			A,
			"avertissement",
			id,
			"Durée négative.",
			"« "
				.. plainLabel(def)
				.. " » a une durée de "
				.. frNumber(n)
				.. " seconde(s) : un nombre négatif compte comme 0, donc "
				.. what
				.. " tout de suite. Mets un nombre positif (les durées sont en secondes)."
		)
	elseif n > 300 then
		add(
			A,
			"avertissement",
			id,
			"Durée très longue.",
			"« "
				.. plainLabel(def)
				.. " » dure "
				.. frNumber(n)
				.. " secondes, soit environ "
				.. frNumber(math.floor(n / 60 + 0.5))
				.. " minutes. Si tu pensais en millisecondes, écris plutôt "
				.. frNumber(n / 1000)
				.. " (les durées sont en secondes)."
		)
	end
end

local function checkUnitRange(A, id, def, block, inputName, meaning)
	local n = literalNumber(A, block, inputName)
	if n ~= nil and (n < 0 or n > 1) then
		add(
			A,
			"avertissement",
			id,
			"Valeur hors limites.",
			"« " .. plainLabel(def) .. " » : " .. meaning .. " va de 0 à 1 (par exemple 0,5). La valeur " .. frNumber(n) .. " sera ramenée entre 0 et 1."
		)
	end
end

-- Boucles : corps vide déjà signalé ; pauses, boucles énormes, changements invisibles
local function checkLoop(A, id, block, def, env)
	local body = type(block.sub) == "table" and block.sub.DO or nil
	if body == nil then
		return
	end
	local waits = containsWait(A, body)
	if def.id == "ctrl_repeter" or def.id == "ctrl_pour" then
		local count = nil
		if def.id == "ctrl_repeter" then
			count = literalNumber(A, block, "FOIS")
		else
			local from = literalNumber(A, block, "DE")
			local to = literalNumber(A, block, "A")
			if from ~= nil and to ~= nil then
				count = math.abs(to - from) + 1
			end
		end
		if count ~= nil and count > 100000 and not waits then
			add(
				A,
				"avertissement",
				id,
				"Boucle énorme sans pause.",
				"« "
					.. plainLabel(def)
					.. " » fait "
					.. frNumber(count)
					.. " tours d'un coup, sans aucune pause : le jeu peut se figer (Roblox arrête un script qui travaille plus de 10 secondes sans pause). Ajoute un bloc « attendre » dans la boucle, ou réduis le nombre de tours."
			)
		elseif count ~= nil and count > 1 and not waits and containsVisual(A, body) then
			add(
				A,
				"conseil",
				id,
				"Tous les tours d'un coup.",
				"« "
					.. plainLabel(def)
					.. " » fait tous ses tours instantanément, sans pause : on ne verra que le résultat final. Pour voir chaque étape (mouvement, couleur…), ajoute « attendre 0,1 secondes » dans la boucle."
			)
		end
	elseif YIELD_LOOPS[def.id] then
		-- (condition vide : déjà signalée comme erreur, inutile d'en rajouter)
		local condEmpty = Registry.inputByName(def, "COND") ~= nil and pluggedId(A, block, "COND") == nil
		if not waits and not condEmpty then
			if containsVisual(A, body) then
				add(
					A,
					"conseil",
					id,
					"Boucle sans « attendre ».",
					"« "
						.. plainLabel(def)
						.. " » n'a aucun bloc « attendre » : elle tourne environ 60 fois par seconde. Les changements (couleur, position…) seront trop rapides pour être vus : ajoute par exemple « attendre 1 secondes » dans la boucle."
				)
			else
				add(
					A,
					"conseil",
					id,
					"Boucle sans « attendre ».",
					"« "
						.. plainLabel(def)
						.. " » n'a aucun bloc « attendre » : elle tourne environ 60 fois par seconde (Blocs FR fait une toute petite pause à chaque tour pour ne pas bloquer le jeu). Si c'est voulu, tout va bien ; sinon, ajoute un bloc « attendre » dans la boucle."
				)
			end
		end
	end
	-- Boucle sans fin dans un événement qui se déclenche souvent
	if def.id == "ctrl_toujours" and env.hatDef then
		if REPEATING_HATS[env.hatDef.id] and not env.inNewFunction then
			add(
				A,
				"avertissement",
				id,
				"Boucle sans fin relancée à chaque fois.",
				"« "
					.. plainLabel(env.hatDef)
					.. " » se déclenche souvent, et chaque fois il lance une nouvelle boucle « répéter indéfiniment » qui ne s'arrête jamais : elles s'additionnent (l'objet tourne ou clignote de plus en plus vite…). Place plutôt la boucle sous « Quand ce script démarre »."
			)
		elseif env.hatDef.id == "evt_toutes_les" then
			add(
				A,
				"avertissement",
				id,
				"Le minuteur ne recommence jamais.",
				"Sous « "
					.. plainLabel(env.hatDef)
					.. " », la boucle « répéter indéfiniment » ne s'arrête pas : les blocs ne repassent donc plus toutes les N secondes. Utilise soit le minuteur, soit « Quand ce script démarre » + « répéter indéfiniment » + « attendre »."
			)
		end
	end
	-- Script module : une boucle sans fin bloque le script qui appelle la fonction / charge le module
	if def.id == "ctrl_toujours" and A.mode == "module" and env.hatDef and not env.inNewFunction then
		local hatDefId = env.hatDef.id
		if (hatDefId == "mod_fonction" or hatDefId == "mod_au_chargement") and not moduleLoopCanExit(A, body) then
			if hatDefId == "mod_fonction" then
				local which = "cette fonction"
				if env.functionName ~= nil then
					which = "la fonction " .. quote(env.functionName)
				end
				add(
					A,
					"avertissement",
					id,
					"Fonction qui ne se termine jamais.",
					"« répéter indéfiniment » ne s'arrête jamais : "
						.. which
						.. " ne se termine donc pas, et le script qui l'appelle reste bloqué à l'attendre. Ajoute « sortir de la boucle » ou « renvoyer … » dans la boucle, ou mets la boucle dans « lancer en parallèle »."
				)
			else
				add(
					A,
					"avertissement",
					id,
					"Module bloqué au chargement.",
					"« Quand le module est chargé » s'exécute pendant le chargement du module : avec « répéter indéfiniment », le chargement ne finit jamais et le script qui utilise ce module reste bloqué. Mets la boucle dans « lancer en parallèle »."
				)
			end
		end
	end
	-- Boucle infinie (tant que vrai / jusqu'à faux) suivie d'autres blocs
	if block.next ~= nil and (def.id == "ctrl_tant_que" or def.id == "ctrl_repeter_jusqua") then
		local cond = pluggedId(A, block, "COND")
		local condDef = cond and getDef(A.blocks[cond]) or nil
		local endless = false
		if def.id == "ctrl_tant_que" and condDef and condDef.id == "val_vrai" then
			endless = true
		elseif def.id == "ctrl_repeter_jusqua" and (cond == nil or (condDef and condDef.id == "val_faux")) then
			endless = true
		end
		if endless and not loopCanExit(A, body) then
			add(
				A,
				"avertissement",
				block.next,
				"Blocs jamais exécutés.",
				"Les blocs placés sous « "
					.. plainLabel(def)
					.. " » ne s'exécuteront jamais : cette boucle ne s'arrête pas. Mets-les avant la boucle, dans « lancer en parallèle », ou ajoute « sortir de la boucle » à l'intérieur."
			)
		end
	end
end

-- Texte littéral sans espaces autour (comme les noms dans le code généré des blocs Modules), ou nil
local function literalName(A, block, name)
	local text = literalText(A, block, name)
	if text == nil then
		return nil
	end
	return trim(text)
end

-- « appeler la fonction … du module … », « résultat de … », « valeur … du module … », « le module … existe » :
-- noté pour checkModuleCalls (après le parcours, quand les fonctions du module ouvert sont connues)
local function collectModuleCall(A, id, block, def)
	local call = { id = id, defId = def.id, label = plainLabel(def), module = literalName(A, block, "MODULE"), name = nil }
	if def.id ~= "mod_existe" then
		call.name = literalName(A, block, "NOM")
		if call.name == "" then
			local what = "fonction"
			if def.id == "mod_valeur" then
				what = "valeur"
			end
			add(
				A,
				"avertissement",
				id,
				"Nom de " .. what .. " vide.",
				"« "
					.. call.label
					.. " » n'a pas de nom de "
					.. what
					.. " : il ne trouvera rien dans le module. Écris le nom exact, tel qu'il est écrit dans le module (majuscules comprises)."
			)
			call.name = nil
		end
	end
	if call.module ~= nil then
		table.insert(A.moduleCalls, call)
	end
end

-- « paramètre … » : seulement dans une fonction de module, avec un nom qu'elle déclare
local function checkParameter(A, id, block, env)
	if A.mode ~= "module" then
		return -- (bloc réservé aux modules : déjà signalé)
	end
	if env.functionHat == nil then
		add(
			A,
			"erreur",
			id,
			"« paramètre » hors d'une fonction.",
			"Le bloc « paramètre » donne ce que le script appelant a envoyé à une fonction : il n'a de valeur que sous « Définir la fonction … ». Ici, il vaut toujours « rien ». Place-le sous un bloc « Définir la fonction … » qui déclare ce paramètre."
		)
		return
	end
	local name = literalName(A, block, "NOM")
	if name == nil or env.functionParams == nil then
		return -- nom calculé par un bloc, ou paramètres de la fonction calculés : impossible de vérifier
	end
	if name == "" then
		add(A, "avertissement", id, "Paramètre sans nom.", "Le bloc « paramètre » n'a pas de nom : il vaudra toujours « rien ». Écris le nom d'un paramètre de la fonction (par exemple « a »).")
		return
	end
	if env.functionParams[name] then
		return
	end
	local subject = "Cette fonction"
	if env.functionName ~= nil then
		subject = "La fonction " .. quote(env.functionName)
	end
	local list = env.functionParamList or {}
	local known
	if #list == 0 then
		known = " Elle n'a aucun paramètre pour l'instant."
	else
		known = " Ses paramètres : " .. quoteList(list, 3) .. "."
	end
	local hint = ""
	local close = closeName(name, list)
	if close ~= nil then
		hint = " Voulais-tu dire " .. quote(close) .. " ? Les majuscules et les accents comptent."
	end
	add(
		A,
		"avertissement",
		id,
		"Paramètre inconnu : " .. quote(name) .. ".",
		subject
			.. " n'a pas de paramètre nommé "
			.. quote(name)
			.. " : ce bloc vaudra toujours « rien »."
			.. known
			.. hint
			.. " Écris exactement le nom d'un de ses paramètres, ou ajoute-le dans « Définir la fonction … »."
	)
end

local function checkSpecific(A, id, block, def, env)
	local defId = def.id
	if defId == "ctrl_attendre" then
		checkDuration(A, id, def, block, "SECONDES", "le script continue")
	elseif defId == "ctrl_apres" then
		checkDuration(A, id, def, block, "SECONDES", "les blocs à l'intérieur s'exécutent")
	elseif defId == "act_detruire_apres" then
		checkDuration(A, id, def, block, "SECONDES", "l'objet est détruit")
	elseif defId == "act_glisser" or defId == "act_glisser_de" then
		local n = literalNumber(A, block, "DUREE")
		if n ~= nil and n < 0 then
			add(A, "avertissement", id, "Durée négative.", "« " .. plainLabel(def) .. " » a une durée négative : l'objet sautera directement à l'arrivée. Mets une durée positive (en secondes).")
		end
	elseif defId == "ctrl_repeter" then
		local n = literalNumber(A, block, "FOIS")
		if n ~= nil and n < 1 then
			add(
				A,
				"avertissement",
				id,
				"Boucle qui ne tourne jamais.",
				"« répéter " .. frNumber(n) .. " fois » ne fait aucun tour : les blocs à l'intérieur ne s'exécuteront jamais. Mets un nombre plus grand que 0."
			)
		end
	elseif defId == "ctrl_sortir_boucle" then
		if not env.inLoop then
			local extra = ""
			if env.crossedFunction then
				extra = " Attention : à l'intérieur de « lancer en parallèle » ou de « après … secondes, faire », on n'est plus dans la boucle du dessus."
			end
			add(
				A,
				"erreur",
				id,
				"« sortir de la boucle » hors d'une boucle.",
				"Ce bloc n'est dans aucune boucle : il ne fait rien. Place-le à l'intérieur d'une boucle (« répéter … fois », « tant que … », « pour … », « répéter indéfiniment »…)."
					.. extra
			)
		end
	elseif defId == "dbg_erreur" then
		if block.next ~= nil then
			add(
				A,
				"conseil",
				block.next,
				"Blocs arrêtés par une erreur.",
				"« déclencher l'erreur » arrête cet événement : les blocs placés dessous ne s'exécuteront jamais. Si tu veux seulement afficher un message, utilise « afficher l'avertissement … »."
			)
		end
	elseif defId == "app_transparence" then
		checkUnitRange(A, id, def, block, "VALEUR", "la transparence")
	elseif defId == "app_reflet" then
		checkUnitRange(A, id, def, block, "VALEUR", "le reflet")
	elseif defId == "act_echelle" then
		local n = literalNumber(A, block, "FACTEUR")
		if n ~= nil and n <= 0 then
			add(
				A,
				"avertissement",
				id,
				"Taille impossible.",
				"« multiplier la taille de … par " .. frNumber(n) .. " » : le nombre doit être plus grand que 0 (2 = deux fois plus grand, 0,5 = deux fois plus petit)."
			)
		end
	elseif defId == "act_teleporter" or defId == "j_teleporter" then
		local y = literalNumber(A, block, "Y")
		if y ~= nil and y < A.fallenHeight then
			add(
				A,
				"avertissement",
				id,
				"Destination sous le monde.",
				"y = "
					.. frNumber(y)
					.. " est plus bas que la limite du monde ("
					.. frNumber(A.fallenHeight)
					.. ") : ce qui est téléporté là est détruit par Roblox. Choisis un y plus grand (y est la hauteur)."
			)
		end
	elseif defId == "act_jouer_son_id" then
		local idText = literalText(A, block, "ID")
		if idText ~= nil then
			local clean = trim(idText)
			if clean == "" then
				add(
					A,
					"avertissement",
					id,
					"Aucun son choisi.",
					"« jouer le son d'ID … » n'a pas d'ID : aucun son ne sera joué. Copie l'ID d'un son de la Boîte à outils (un nombre, par exemple 9125402735)."
				)
			elseif not (string.match(clean, "^%d+$") or string.find(string.lower(clean), "rbxassetid://", 1, true) or string.find(string.lower(clean), "rbxasset://", 1, true)) then
				add(
					A,
					"avertissement",
					id,
					"ID de son invalide.",
					"« " .. oneLine(clean, 60) .. " » n'est pas un ID de son : il faut un nombre (par exemple 9125402735) ou une adresse rbxassetid://…"
				)
			end
		end
	elseif defId == "act_propriete" then
		local nom = literalText(A, block, "NOM")
		if nom ~= nil then
			local clean = string.gsub(nom, "%s", "")
			if clean == "" then
				add(A, "avertissement", id, "Propriété sans nom.", "« mettre la propriété … » n'a pas de nom de propriété : il ne fera rien. Écris le nom anglais de la propriété (par exemple Transparency).")
			elseif A.target and literal(A, block, "OBJ") == "script.Parent" then
				local target = A.target
				local function has(prop)
					local ok = pcall(function()
						return target[prop]
					end)
					return ok
				end
				local alias = PROPERTY_ALIASES[string.lower(clean)]
				if not has(clean) and not (alias and has(alias)) then
					local className = "?"
					pcall(function()
						className = target.ClassName
					end)
					add(
						A,
						"avertissement",
						id,
						"Propriété inconnue : " .. quote(clean) .. ".",
						"« "
							.. nameOfInstance(target)
							.. " » ("
							.. className
							.. ") n'a pas de propriété "
							.. quote(clean)
							.. ". Les noms de propriétés sont en anglais et sensibles aux majuscules (Transparency, Color, Anchored…) ; regarde la fenêtre Propriétés de Studio."
					)
				end
			end
		end
	elseif defId == "j_donner_outil" then
		local outil = literalText(A, block, "OUTIL")
		if outil ~= nil then
			local clean = outil
			if trim(clean) == "" then
				add(A, "avertissement", id, "Outil sans nom.", "« donner l'outil … » n'a pas de nom d'outil : il ne donnera rien.")
			else
				local index = getNameIndex()
				if not index.tools[clean] and not index.toolsLower[string.lower(clean)] then
					add(
						A,
						"avertissement",
						id,
						"Outil introuvable : " .. quote(clean) .. ".",
						"Aucun outil (Tool) nommé "
							.. quote(clean)
							.. " dans ServerStorage, ReplicatedStorage, Lighting ou Workspace. Mets-en un (Boîte à outils) dans ServerStorage, ou corrige le nom."
					)
				end
			end
		end
	elseif defId == "j_ajouter_stat" or defId == "j_definir_stat" then
		if A.mode == "local" then
			add(
				A,
				"avertissement",
				id,
				"Statistique modifiée dans un script local.",
				"« "
					.. plainLabel(def)
					.. " » dans un script local ne change la statistique que sur l'écran de ce joueur : le serveur (et les autres joueurs) ne la voient pas. Fais-le dans un script serveur, par exemple avec « envoyer le message … au serveur »."
			)
		end
	end

	-- Données collectées pour les contrôles d'ensemble
	if defId == "var_definir" or defId == "var_ajouter" or defId == "var_multiplier" or defId == "ctrl_pour" then
		local name = literalText(A, block, "VAR")
		if name then
			A.writes[name] = true
		end
	end
	if defId == "ctrl_envoyer_message" or defId == "ctrl_envoyer_message_tous" or defId == "ctrl_envoyer_message_joueur" or defId == "ctrl_envoyer_message_serveur" then
		local name = literalText(A, block, "MESSAGE")
		if name == nil then
			A.senderWildcard = true
		else
			table.insert(A.senders, { name = name, id = id })
		end
	end
	if defId == "j_creer_stat" or defId == "j_ajouter_stat" or defId == "j_definir_stat" then
		local name = literalText(A, block, "NOM")
		if name then
			table.insert(A.stats, { name = name, id = id })
		end
	end
	-- Statistiques créées par ce projet (« afficher la statistique … » les cherche, SPEC §21.9)
	local statInput = STAT_CREATORS[defId]
	if statInput ~= nil then
		local name = literalText(A, block, statInput)
		if name ~= nil and trim(name) ~= "" then
			A.statCreated[name] = true
		end
	end
	if STAT_FIXED[defId] ~= nil then
		A.statCreated[STAT_FIXED[defId]] = true
	end
	if defId == "gui_lier_stat" then
		local name = literalText(A, block, "STAT")
		if name ~= nil then
			table.insert(A.guiStats, { name = name, id = id })
		end
	elseif defId == "tp_sauver_stats" then
		table.insert(A.saveStats, id)
	end
	if defId == "var_partagee_definir" or defId == "var_partagee_ajouter" then
		local name = literalText(A, block, "NOM")
		if name then
			table.insert(A.shared, { name = name, id = id })
		end
	end
	if defId == "act_cloner" or defId == "monde_creer_partie" then
		A.hasCreator = true
		if defId == "monde_creer_partie" then
			A.createdNames["Partie"] = true
		end
	end
	if A.mode == "local" and A.firstWorldLocal == nil and isWorldBlock(defId) then
		A.firstWorldLocal = id
	end
	if env.inBattement and not env.inNewFunction and (WAIT_BLOCKS[defId] or YIELD_LOOPS[defId]) then
		add(
			A,
			"avertissement",
			id,
			"Pause dans « À chaque image ».",
			"« À chaque image » s'exécute environ 60 fois par seconde : « "
				.. plainLabel(def)
				.. " » ici fait démarrer une nouvelle copie à chaque image, et elles s'accumulent. Utilise plutôt « Quand ce script démarre » + « répéter indéfiniment » avec « attendre »."
		)
	end

	-- Scripts modules (SPEC §20)
	if MODULE_CALL_BLOCKS[defId] then
		collectModuleCall(A, id, block, def)
	end
	if A.mode ~= "module" then
		return -- (les blocs réservés aux modules sont déjà signalés par checkCommon)
	end
	if defId == "mod_renvoyer" and not env.inFunction then
		local message
		if env.functionHat ~= nil then
			message = "Ici, « renvoyer » est à l'intérieur d'un bloc qui lance ses blocs à part (« lancer en parallèle », « après … secondes, faire »…) : il ne peut plus donner de résultat à la fonction et il est ignoré. Place-le directement sous « Définir la fonction … », en dehors de ce bloc."
		else
			message = "« renvoyer » donne le résultat d'une fonction : il ne fonctionne que sous « Définir la fonction … ». Ici, il est ignoré. Déplace-le dans une fonction, ou utilise « mettre la valeur … du module à … » pour partager une valeur."
		end
		add(A, "erreur", id, "« renvoyer » hors d'une fonction.", message)
	elseif defId == "mod_definir_valeur" then
		if pluggedId(A, block, "NOM") ~= nil then
			A.moduleValuesWildcard = true
		else
			local name = literalName(A, block, "NOM")
			if name ~= nil then
				if name == "" then
					add(
						A,
						"avertissement",
						id,
						"Valeur sans nom.",
						"« " .. plainLabel(def) .. " » n'a pas de nom de valeur : les autres scripts ne pourront pas la lire. Donne-lui un nom, par exemple « vitesse »."
					)
				else
					table.insert(A.moduleValues, { name = name, id = id })
				end
			end
		end
	elseif defId == "ctrl_arreter" then
		-- (le code généré ne fait qu'un « return » : un ModuleScript ne peut pas être désactivé)
		add(
			A,
			"conseil",
			id,
			"« arrêter ce script » dans un module.",
			"Un script module ne peut pas être désactivé : ici, « arrêter ce script » arrête seulement les blocs en cours (la fonction, l'événement ou « Quand le module est chargé »), et le module reste utilisable par les autres scripts. Pour terminer une fonction en donnant un résultat, utilise plutôt « renvoyer … »."
		)
	end
	-- Pause pendant « Quand le module est chargé » : le script qui charge le module attend aussi
	if
		env.inChargement
		and not env.inNewFunction
		and not env.inForever
		and defId ~= "ctrl_toujours"
		and (WAIT_BLOCKS[defId] or YIELD_LOOPS[defId])
	then
		add(
			A,
			"conseil",
			id,
			"Pause pendant le chargement du module.",
			"« Quand le module est chargé » s'exécute pendant le chargement du module : « "
				.. plainLabel(def)
				.. " » fait donc aussi attendre le script qui charge ce module. Si ce n'est pas voulu, mets ces blocs dans « lancer en parallèle ».",
			{ key = "module|chargement-pause|" .. tostring(env.hatId) }
		)
	end
end

-- Objet cherché par son nom comme l'aide _objetNomme : existe-t-il dans le jeu ? (effect = ce qui
-- arrive sinon, une phrase)
local function checkNamedObject(A, id, nom, effect)
	if A.createdNames[nom] then
		return
	end
	local found = findNamed(nom)
	if found then
		if A.mode == "local" then
			local storage = findService("ServerStorage")
			local inStorage = false
			if storage then
				pcall(function()
					inStorage = found:IsDescendantOf(storage)
				end)
			end
			if inStorage then
				add(
					A,
					"avertissement",
					id,
					"Objet inaccessible depuis un script local.",
					quote(nom)
						.. " est rangé dans ServerStorage, que les joueurs ne reçoivent jamais : un script local ne le trouvera pas. Déplace-le dans ReplicatedStorage (ou Workspace)."
				)
			end
		end
		return
	end
	local suggestion = getNameIndex().names[string.lower(nom)]
	local hint = ""
	if suggestion and suggestion ~= nom then
		hint = " Voulais-tu dire " .. quote(suggestion) .. " ? Les majuscules comptent."
	end
	add(
		A,
		"avertissement",
		id,
		"Objet introuvable : " .. quote(nom) .. ".",
		"Aucun objet nommé "
			.. quote(nom)
			.. " n'existe dans le jeu pour l'instant : "
			.. effect
			.. hint
			.. " S'il est créé pendant le jeu (copie, joueur…), tu peux ignorer ce message."
	)
end

-- Objet nommé : existe-t-il dans le jeu ?
local function checkObjectName(A, id, block)
	local nom = literalText(A, block, "NOM")
	if nom == nil then
		return
	end
	if trim(nom) == "" then
		add(
			A,
			"avertissement",
			id,
			"« objet nommé » sans nom.",
			"La case de « objet nommé … » est vide : ce bloc donnera toujours « rien ». Écris le nom exact de l'objet, tel qu'il apparaît dans l'Explorateur."
		)
		return
	end
	checkNamedObject(A, id, nom, "« objet nommé » donnera « rien » et les blocs qui l'utilisent ne feront rien.")
end

-- Noms d'objets écrits dans les cases des blocs tout prêts, Caméra et Effets (SPEC §22.1)
local function checkNamedInputs(A, id, block, def)
	local inputs = NAMED_INPUTS[def.id]
	if inputs == nil then
		return
	end
	local label = plainLabel(def)
	for _, spec in ipairs(def.inputs or {}) do
		local kind = type(spec) == "table" and inputs[spec.name] or nil
		-- (nil : un bloc valeur est branché dans la case, rien à vérifier)
		local nom = kind and literalText(A, block, spec.name)
		if nom ~= nil then
			local clean = trim(nom)
			if clean == "" then
				add(
					A,
					"avertissement",
					id,
					"Nom d'objet vide.",
					"Une case de « "
						.. label
						.. " » doit contenir le nom d'un objet, mais elle est vide : le bloc ne trouvera rien. Écris le nom exact de l'objet, tel qu'il apparaît dans l'Explorateur."
				)
			elseif Util.parseNumber(clean) == nil and not A.createdNames[nom] then
				if kind == "outil" then
					if findTool(nom) == nil then
						local hint = ""
						local suggestion = getNameIndex().names[string.lower(nom)]
						if suggestion ~= nil and suggestion ~= nom then
							hint = " Voulais-tu dire " .. quote(suggestion) .. " ?"
						end
						add(
							A,
							"avertissement",
							id,
							"Outil introuvable : " .. quote(nom) .. ".",
							"« "
								.. label
								.. " » donne une copie de l'outil (Tool) nommé "
								.. quote(nom)
								.. ", mais il n'y en a aucun dans ServerStorage, ReplicatedStorage ou Lighting : personne ne pourra l'acheter."
								.. hint
								.. " Range ton outil dans ServerStorage avec exactement ce nom."
						)
					end
				elseif kind == "modele" then
					if findInServices(MODEL_SERVICES, nom) == nil then
						local hint = ""
						local suggestion = getNameIndex().names[string.lower(nom)]
						if suggestion ~= nil and suggestion ~= nom then
							hint = " Voulais-tu dire " .. quote(suggestion) .. " ? Les majuscules comptent."
						end
						add(
							A,
							"avertissement",
							id,
							"Modèle introuvable : " .. quote(nom) .. ".",
							"« "
								.. label
								.. " » cherche un objet nommé "
								.. quote(nom)
								.. " dans ServerStorage, ReplicatedStorage, Workspace ou Lighting, mais il n'y en a aucun pour l'instant : rien ne sera copié."
								.. hint
								.. " Range ton modèle dans ServerStorage avec exactement ce nom."
						)
					end
				else
					checkNamedObject(A, id, nom, "« " .. label .. " » ne le trouvera pas et ne fera rien.")
				end
			end
		end
	end
end

-- « enfant … de cet objet » : la cible a-t-elle cet enfant ?
local function checkChildName(A, id, block)
	if A.target == nil or literal(A, block, "OBJ") ~= "script.Parent" then
		return
	end
	local nom = literalText(A, block, "NOM")
	if nom == nil or trim(nom) == "" or tonumber(nom) ~= nil then
		return
	end
	if A.createdNames[nom] then
		return
	end
	local found = nil
	pcall(function()
		found = A.target:FindFirstChild(nom, true)
	end)
	if found == nil then
		add(
			A,
			"avertissement",
			id,
			"Enfant introuvable : " .. quote(nom) .. ".",
			quote(nameOfInstance(A.target))
				.. " ne contient aucun objet nommé "
				.. quote(nom)
				.. " : « enfant … de … » donnera « rien ». Vérifie le nom dans l'Explorateur (majuscules comprises)."
		)
	end
end

checkReporter = function(A, id, env)
	if A.walked[id] then
		return
	end
	A.walked[id] = true
	local block = A.blocks[id]
	local def = getDef(block)
	if def == nil then
		return -- bloc inconnu : signalé par le contrôle d'ensemble
	end
	if def.shape ~= "reporter" and def.shape ~= "boolean" then
		return
	end
	A.compiled[id] = true
	checkCommon(A, id, block, def, env)
	local defId = def.id
	if defId == "var_valeur" then
		local name = literalText(A, block, "VAR")
		if name and A.reads[name] == nil then
			A.reads[name] = id
		end
	elseif CONTEXT_REPORTERS[defId] then
		useContext(A, id, CONTEXT_REPORTERS[defId], env)
	elseif defId == "monde_objet_nomme" then
		checkObjectName(A, id, block)
	elseif defId == "monde_enfant" then
		checkChildName(A, id, block)
	elseif defId == "op_divise" or defId == "op_modulo" then
		local divisor = literalNumber(A, block, "B")
		if divisor ~= nil and divisor == 0 then
			add(
				A,
				"conseil",
				id,
				"Division par zéro.",
				"« " .. plainLabel(def) .. " » divise par 0 : Blocs FR donne alors 0. Vérifie le second nombre."
			)
		end
	elseif defId == "j_stat_val" then
		local name = literalText(A, block, "NOM")
		if name then
			table.insert(A.stats, { name = name, id = id })
		end
	elseif defId == "var_partagee" then
		local name = literalText(A, block, "NOM")
		if name then
			table.insert(A.shared, { name = name, id = id })
		end
	elseif defId == "mod_parametre" then
		checkParameter(A, id, block, env)
	elseif MODULE_CALL_BLOCKS[defId] then
		collectModuleCall(A, id, block, def)
	elseif defId == "gui_texte_de" then
		-- Script serveur avec un joueur : le bloc marche, mais seulement pour les textes mis par le serveur
		-- (sans joueur, l'avertissement « Bloc Interface sans joueur » de checkCommon suffit)
		if A.mode == "server" and type(env.provided) == "table" and env.provided.joueur then
			add(
				A,
				"conseil",
				id,
				"Texte lu par le serveur.",
				"« "
					.. plainLabel(def)
					.. " » dans un script serveur : le serveur ne voit pas ce que le joueur écrit dans un champ, ni les textes changés par un script local. Utilise ce bloc dans un script local (les blocs sous un écran en sont un)."
			)
		end
	end
end

-- Environnement d'un corps de bloc C
local function bodyEnv(env, def)
	local child = {}
	for k, v in pairs(env) do
		child[k] = v
	end
	if def.newFunction then
		if env.inLoop then
			child.crossedFunction = true
		end
		child.inLoop = false
		child.inNewFunction = true
		-- « renvoyer » ne rend plus rien à la fonction du module (les paramètres restent connus)
		child.inFunction = false
	end
	if def.loop then
		child.inLoop = true
		child.crossedFunction = false
	end
	if def.id == "ctrl_toujours" then
		child.inForever = true
	end
	if def.id == "j_pour_chaque_joueur" then
		local provided = {}
		for k, v in pairs(env.provided) do
			provided[k] = v
		end
		provided.joueur = true
		provided.personnage = true
		child.provided = provided
	end
	return child
end

local function checkEmptyBody(A, id, block, def)
	local sub = type(block.sub) == "table" and block.sub or {}
	if def.shape == "c2" then
		if sub.DO == nil and sub.ELSE == nil then
			add(A, "avertissement", id, "Bloc vide.", "Le bloc « " .. plainLabel(def) .. " » est vide : glisse des blocs dans ses deux parties, sinon il ne sert à rien.")
		elseif sub.DO == nil then
			add(
				A,
				"avertissement",
				id,
				"Première partie vide.",
				"La première partie de « " .. plainLabel(def) .. " » est vide : quand la condition est vraie, rien ne se passe. Glisse des blocs dedans, ou utilise « si … alors » avec « non … » autour de la condition."
			)
		elseif sub.ELSE == nil then
			add(
				A,
				"conseil",
				id,
				"Partie « sinon » vide.",
				"La partie « sinon » est vide : tu peux utiliser le bloc plus simple « si … alors »."
			)
		end
	elseif sub.DO == nil then
		local why = "glisse des blocs à l'intérieur, sinon il ne sert à rien."
		if def.id == "ctrl_toujours" then
			why = "la boucle tourne sans rien faire. Glisse des blocs à l'intérieur."
		elseif def.id == "ctrl_si" then
			why = "même si la condition est vraie, rien ne se passe. Glisse des blocs à l'intérieur."
		end
		add(A, "avertissement", id, "Bloc vide.", "Le bloc « " .. plainLabel(def) .. " » est vide : " .. why)
	end
end

local function checkStatement(A, id, block, def, env, depth)
	A.compiled[id] = true
	checkCommon(A, id, block, def, env)
	checkSpecific(A, id, block, def, env)
	checkNamedInputs(A, id, block, def)
	if def.shape == "c" or def.shape == "c2" then
		checkEmptyBody(A, id, block, def)
		if def.loop then
			checkLoop(A, id, block, def, env)
		end
		local inner = bodyEnv(env, def)
		local sub = type(block.sub) == "table" and block.sub or {}
		if sub.DO ~= nil then
			walkChain(A, sub.DO, inner, depth + 1)
		end
		if def.shape == "c2" and sub.ELSE ~= nil then
			walkChain(A, sub.ELSE, inner, depth + 1)
		end
	end
end

walkChain = function(A, headId, env, depth)
	if depth > MAX_DEPTH then
		return
	end
	local current = headId
	local steps = 0
	while current ~= nil and steps < MAX_STEPS do
		steps += 1
		local block = A.blocks[current]
		if type(block) ~= "table" or A.walked[current] then
			return
		end
		A.walked[current] = true
		if block.disabled == true then
			-- instruction désactivée (SPEC §32) : sautée avec ses corps, comme dans CodeGen
			current = block.next
			continue
		end
		local def = getDef(block)
		if def ~= nil then
			if def.shape == "hat" or def.shape == "reporter" or def.shape == "boolean" then
				-- forme impossible dans une pile (données abîmées) : ignoré par le générateur
				add(A, "avertissement", current, "Bloc mal placé.", "Le bloc « " .. plainLabel(def) .. " » ne peut pas être placé dans une pile : il est ignoré. Déplace-le.")
			else
				checkStatement(A, current, block, def, env, depth)
			end
			if (def.noNext or def.shape == "cap") and block.next ~= nil then
				local why = "rien ne peut être exécuté après lui."
				if def.id == "ctrl_toujours" then
					why = "cette boucle ne s'arrête jamais."
				end
				add(
					A,
					"avertissement",
					block.next,
					"Blocs jamais exécutés.",
					"Les blocs placés sous « "
						.. plainLabel(def)
						.. " » ne s'exécuteront jamais : "
						.. why
						.. " Place-les avant, ou dans « lancer en parallèle »."
				)
				return
			end
		end
		current = block.next
	end
end

---------------------------------------------------------------------------
-- Analyse : événements, piles isolées, contrôles d'ensemble
---------------------------------------------------------------------------

local function providedFor(A, def)
	local provided = {}
	if type(def.provides) == "table" then
		for _, name in ipairs(def.provides) do
			provided[name] = true
		end
	end
	if A.mode == "local" then
		-- en-tête d'un script local : joueur = joueur local, personnage = son personnage
		provided.joueur = true
		provided.personnage = true
	end
	return provided
end

-- Partie ou modèle cible pour les événements de contact / de clic
local function checkEventTarget(A, id, def)
	local target = A.target
	if target == nil then
		return
	end
	local label = plainLabel(def)
	local isService = false
	pcall(function()
		isService = target == workspace or target.Parent == game
	end)
	if isService then
		add(
			A,
			"erreur",
			id,
			"Cible incompatible avec cet événement.",
			"« "
				.. label
				.. " » doit surveiller une partie ou un modèle, mais la cible est "
				.. quote(nameOfInstance(target))
				.. ". Sélectionne la partie à surveiller dans l'Explorateur, puis « Nouveau » (ou enregistre le projet dans cette partie)."
		)
		return
	end
	local isPart = isA(target, "BasePart")
	local isModel = isA(target, "Model")
	if TOUCH_HATS[def.id] then
		local hasParts = isPart
		if not hasParts then
			pcall(function()
				hasParts = target:FindFirstChildWhichIsA("BasePart", true) ~= nil
			end)
		end
		if not hasParts then
			local severity = "erreur"
			local what = "n'est ni une partie ni un modèle"
			if isModel then
				severity = "avertissement"
				what = "est un modèle qui ne contient (pour l'instant) aucune partie"
			end
			add(
				A,
				severity,
				id,
				"Rien à toucher.",
				quote(nameOfInstance(target))
					.. " "
					.. what
					.. " : « "
					.. label
					.. " » ne se déclenchera jamais. Choisis comme cible une partie (Part) ou un modèle qui contient des parties."
			)
		end
	elseif CLICK_HATS[def.id] then
		local hasDetector = false
		pcall(function()
			hasDetector = target:FindFirstChildOfClass("ClickDetector") ~= nil
		end)
		if not isPart and not isModel and not hasDetector then
			add(
				A,
				"erreur",
				id,
				"Objet impossible à cliquer.",
				quote(nameOfInstance(target))
					.. " n'est ni une partie ni un modèle : « "
					.. label
					.. " » ne pourra pas fonctionner. Choisis comme cible la partie (ou le modèle) sur laquelle les joueurs cliqueront."
			)
		end
	end
end

-- Événements d'un script module (SPEC §20) : « Définir la fonction … » (nom, paramètres),
-- « Quand le module est chargé », et les autres événements (conseil)
local function setupModuleHat(A, id, block, def, env)
	if def.id == "mod_fonction" then
		env.functionHat = id
		env.inFunction = true
		local wildcard = false
		local params, list = {}, {}
		for _, inputName in ipairs({ "P1", "P2", "P3" }) do
			if pluggedId(A, block, inputName) ~= nil then
				wildcard = true
			else
				local paramName = literalName(A, block, inputName)
				if paramName ~= nil and paramName ~= "" then
					if params[paramName] and A.mode == "module" then
						add(
							A,
							"avertissement",
							id,
							"Deux paramètres portent le même nom.",
							"Cette fonction a deux paramètres nommés "
								.. quote(paramName)
								.. " : seul le premier compte, la valeur reçue pour le second est perdue. Donne un nom différent à chaque paramètre."
						)
					end
					if not params[paramName] then
						params[paramName] = true
						table.insert(list, paramName)
					end
				end
			end
		end
		if not wildcard then
			env.functionParams = params
		end
		env.functionParamList = list
		local nameIsPlugged = pluggedId(A, block, "NOM") ~= nil
		local name = nil
		if not nameIsPlugged then
			name = literalName(A, block, "NOM")
		end
		if name ~= nil and name ~= "" then
			env.functionName = name
		end
		if A.mode ~= "module" then
			return
		end
		if nameIsPlugged then
			A.moduleFunctionsWildcard = true
		elseif name == "" then
			add(
				A,
				"avertissement",
				id,
				"Fonction sans nom.",
				"« Définir la fonction … » n'a pas de nom : les autres scripts ne pourront pas l'appeler. Donne-lui un nom, par exemple « ajouterPoints »."
			)
		elseif name ~= nil then
			table.insert(A.moduleFunctions, {
				name = name,
				id = id,
				returns = block.next ~= nil and containsDefs(A, block.next, { mod_renvoyer = true }, { skipNewFunction = true }),
			})
		end
	elseif def.id == "mod_au_chargement" then
		env.inChargement = true
	elseif A.mode == "module" and def.scriptType ~= "module" then
		local extra = ""
		if def.id == "evt_demarrage" then
			extra = " Pour exécuter des blocs une seule fois quand le module est chargé, « Quand le module est chargé » (catégorie Modules) est plus clair."
		end
		add(
			A,
			"conseil",
			id,
			"Événement dans un script module.",
			"Dans un script module, « "
				.. plainLabel(def)
				.. " » ne commence à fonctionner que lorsqu'un autre script charge ce module (avec « appeler la fonction … du module … », « valeur … du module … »…). Si aucun script ne l'utilise, il ne se déclenchera jamais."
				.. extra
		)
	end
end

local function checkHat(A, id, block, def)
	local env = {
		hatId = id,
		hatDef = def,
		inLoop = def.loop == true,
		crossedFunction = false,
		inNewFunction = false,
		provided = providedFor(A, def),
		inBattement = def.id == "evt_battement",
		-- Scripts modules : fonction en cours (pour « renvoyer » / « paramètre ») et chargement
		inFunction = false,
		inChargement = false,
		inForever = false,
		functionHat = nil,
		functionName = nil,
		functionParams = nil, -- nil : paramètres calculés par des blocs (impossible à vérifier)
		functionParamList = nil,
	}
	A.compiled[id] = true
	A.walked[id] = true
	setupModuleHat(A, id, block, def, env)
	checkCommon(A, id, block, def, env)

	if TOUCH_HATS[def.id] or CLICK_HATS[def.id] then
		checkEventTarget(A, id, def)
	end
	if def.id == "evt_message" then
		local name = literalText(A, block, "MESSAGE")
		if name then
			table.insert(A.receivers, { name = name, id = id })
		end
	elseif def.id == "evt_toutes_les" then
		local n = literalNumber(A, block, "SECONDES")
		if n ~= nil and n < 0.03 then
			add(
				A,
				"conseil",
				id,
				"Intervalle trop petit.",
				"« Toutes les " .. frNumber(n) .. " secondes » : le plus court possible est 0,03 seconde (environ 30 fois par seconde). Pour chaque image, utilise « À chaque image »."
			)
		end
	elseif def.id == "evt_touche_delai" or def.id == "evt_touche_perso_delai" then
		local n = literalNumber(A, block, "DELAI")
		if n ~= nil and n <= 0 then
			add(
				A,
				"conseil",
				id,
				"Délai nul.",
				"Avec un délai de " .. frNumber(n) .. " seconde, cet événement n'attend pas entre deux contacts. Mets par exemple 1 seconde, ou utilise la version sans délai."
			)
		end
	end

	if block.next == nil then
		local title = "Événement vide."
		local message = "« " .. plainLabel(def) .. " » n'a aucun bloc en dessous : il ne fait rien. Accroche des blocs sous cet événement."
		if def.id == "mod_fonction" then
			title = "Fonction vide."
			local which = "Cette fonction"
			if env.functionName ~= nil then
				which = "La fonction " .. quote(env.functionName)
			end
			message = which
				.. " n'a aucun bloc en dessous : elle ne fait rien. Accroche dessous les blocs qu'elle doit exécuter (et « renvoyer … » si elle doit donner un résultat)."
		elseif def.id == "mod_au_chargement" then
			message = "« Quand le module est chargé » n'a aucun bloc en dessous : il ne fait rien. Accroche dessous les blocs à exécuter au chargement du module, ou supprime-le."
		end
		add(A, "avertissement", id, title, message)
		return
	end

	-- Contact sans délai qui « compte » : il risque de compter plusieurs fois
	if def.id == "evt_touche" or def.id == "evt_touche_perso" then
		local counting = firstCounting(A, block.next)
		if counting ~= nil and not containsDefs(A, block.next, { act_detruire = true }) then
			add(
				A,
				"conseil",
				counting,
				"Contact compté plusieurs fois.",
				"« "
					.. plainLabel(def)
					.. " » se déclenche plusieurs fois pendant un seul contact (chaque partie du corps qui touche compte) : « "
					.. nameOf(A, counting)
					.. " » risque d'être exécuté plusieurs fois d'affilée. Utilise plutôt « Quand un personnage touche cet objet (délai … s) »."
			)
		end
	end

	walkChain(A, block.next, env, 1)
end

-- Pile de premier niveau qui ne commence pas par un événement
local function checkLooseStack(A, id, block, def)
	if def.shape == "reporter" or def.shape == "boolean" then
		add(
			A,
			"conseil",
			id,
			"Bloc valeur isolé.",
			"Le bloc « "
				.. nameOf(A, id)
				.. " » n'est branché nulle part : il est ignoré. Glisse-le dans une case d'un autre bloc, ou supprime-le."
		)
		return
	end
	local count = 0
	scan(A, id, { withInputs = true, includeDisabled = true }, function()
		count += 1
		return false
	end)
	local what = "Ce bloc n'est attaché"
	if count > 1 then
		what = "Ces " .. count .. " blocs ne sont attachés"
	end
	local how = "Accroche-les sous un bloc « Quand … » de la catégorie Événements (par exemple « Quand ce script démarre »)."
	if A.mode == "module" then
		how = "Accroche-les sous « Définir la fonction … » ou « Quand le module est chargé » (catégorie Modules)."
	end
	add(
		A,
		"conseil",
		id,
		"Blocs hors d'un événement.",
		what
			.. " à aucun événement : "
			.. ((count > 1) and "ils ne s'exécuteront" or "il ne s'exécutera")
			.. " jamais. "
			.. how
	)
end

-- Blocs mis hors du code par un bloc désactivé (SPEC §32, comme model:isDisabled(id, true)) : le bloc
-- lui-même, ses cases et ses corps ; pour un événement désactivé, toute sa pile
local function computeInactive(A)
	local inactive = {}
	local function mark(id, followNext, depth)
		local current = id
		local steps = 0
		while current ~= nil and steps < MAX_STEPS and depth <= MAX_DEPTH do
			steps += 1
			local block = A.blocks[current]
			if type(block) ~= "table" or inactive[current] then
				return
			end
			inactive[current] = true
			if type(block.inputs) == "table" then
				for _, slot in pairs(block.inputs) do
					if type(slot) == "table" and slot.block ~= nil then
						mark(slot.block, false, depth + 1)
					end
				end
			end
			if type(block.sub) == "table" then
				mark(block.sub.DO, true, depth + 1)
				mark(block.sub.ELSE, true, depth + 1)
			end
			if not followNext then
				return
			end
			current = block.next
		end
	end
	for id, block in pairs(A.blocks) do
		if type(block) == "table" and block.disabled == true then
			local def = getDef(block)
			mark(id, def ~= nil and def.shape == "hat", 0)
		end
	end
	return inactive
end

local function checkUnknownBlocks(A)
	local ids = {}
	local inactive = computeInactive(A)
	for id, block in pairs(A.blocks) do
		if type(block) == "table" and getDef(block) == nil and not inactive[id] then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(p, q)
		local op, oq = A.order[p] or math.huge, A.order[q] or math.huge
		if op ~= oq then
			return op < oq
		end
		return tostring(p) < tostring(q)
	end)
	for _, id in ipairs(ids) do
		local name = oneLine(A.blocks[id].def, 60)
		add(
			A,
			"erreur",
			id,
			"Bloc inconnu : " .. quote(name) .. ".",
			"Ce bloc n'existe pas dans cette version de Blocs FR (projet créé avec une autre version ?). Il est ignoré : supprime-le et remplace-le par un bloc de la palette."
		)
	end
end

local function checkMessages(A)
	local exact = {}
	local loose = {}
	for _, s in ipairs(A.senders) do
		exact[s.name] = true
		local key = looseKey(s.name)
		if loose[key] == nil then
			loose[key] = s.name
		end
		if trim(s.name) == "" then
			add(A, "avertissement", s.id, "Message sans nom.", "« " .. nameOf(A, s.id) .. " » envoie un message sans nom : personne ne pourra le recevoir. Donne-lui un nom, par exemple « porte ».")
		end
	end
	for _, r in ipairs(A.receivers) do
		local name = r.name
		if trim(name) == "" then
			add(A, "avertissement", r.id, "Message sans nom.", "« Quand je reçois le message … » a un nom vide : donne-lui le même nom que dans « envoyer le message … ».")
		elseif not exact[name] then
			local close = loose[looseKey(name)]
			if close ~= nil then
				add(
					A,
					"avertissement",
					r.id,
					"Nom de message presque identique.",
					"Ce bloc attend le message "
						.. quote(name)
						.. ", mais le projet envoie "
						.. quote(close)
						.. " : pour Roblox ce sont deux messages différents. Écris exactement le même nom (majuscules, accents et espaces compris)."
				)
			elseif not A.senderWildcard then
				add(
					A,
					"conseil",
					r.id,
					"Message jamais envoyé ici.",
					"Aucun bloc « envoyer le message "
						.. quote(name)
						.. " » dans ce projet. C'est normal si un autre script l'envoie ; sinon, ajoute ce bloc ou vérifie l'orthographe du nom."
				)
			end
		end
		if name ~= trim(name) and trim(name) ~= "" then
			add(
				A,
				"conseil",
				r.id,
				"Espace au début ou à la fin.",
				"Le nom du message " .. quote(name) .. " commence ou finit par un espace : il doit être écrit exactement pareil dans « envoyer le message … ». Mieux vaut l'enlever."
			)
		end
	end
end

-- Noms écrits presque pareil (statistiques, valeurs partagées).
-- item = { name (affiché), id, exact = nom réellement utilisé par Roblox (facultatif, sinon name) } ;
-- what = « de statistique » (titre), plural = « statistiques » (message)
local function checkNearNames(A, list, keyFn, what, plural)
	local groups = {}
	local order = {}
	for _, item in ipairs(list) do
		local key = keyFn(item.exact or item.name)
		if groups[key] == nil then
			groups[key] = {}
			table.insert(order, key)
		end
		table.insert(groups[key], item)
	end
	for _, key in ipairs(order) do
		local items = groups[key]
		local first = items[1]
		local firstExact = first.exact or first.name
		for _, item in ipairs(items) do
			if (item.exact or item.name) ~= firstExact then
				add(
					A,
					"avertissement",
					item.id,
					"Nom " .. what .. " presque identique.",
					quote(item.name)
						.. " et "
						.. quote(first.name)
						.. " sont deux "
						.. plural
						.. " différentes pour Roblox. Écris le nom exactement pareil partout (majuscules et accents compris)."
				)
			end
		end
	end
end

-- Nom d'attribut sans les majuscules : clé de regroupement des valeurs partagées
local function sharedKey(name)
	local folded = Util.fold(tostring(name))
	local clean = string.gsub(folded, "[^%w_]", "_")
	return string.lower(clean)
end

-- Accents retirés par l'aide _nomPartage (Defs_Variables) : les autres caractères deviennent des _
local SHARED_ACCENTS = {
	["à"] = "a", ["á"] = "a", ["â"] = "a", ["ä"] = "a", ["ç"] = "c",
	["è"] = "e", ["é"] = "e", ["ê"] = "e", ["ë"] = "e",
	["ì"] = "i", ["í"] = "i", ["î"] = "i", ["ï"] = "i", ["ñ"] = "n",
	["ò"] = "o", ["ó"] = "o", ["ô"] = "o", ["ö"] = "o",
	["ù"] = "u", ["ú"] = "u", ["û"] = "u", ["ü"] = "u", ["ÿ"] = "y",
	["À"] = "A", ["Â"] = "A", ["Ä"] = "A", ["Ç"] = "C",
	["È"] = "E", ["É"] = "E", ["Ê"] = "E", ["Ë"] = "E",
	["Î"] = "I", ["Ï"] = "I", ["Ô"] = "O", ["Ö"] = "O",
	["Ù"] = "U", ["Û"] = "U", ["Ü"] = "U",
	["œ"] = "oe", ["Œ"] = "OE", ["æ"] = "ae", ["Æ"] = "AE",
}

-- Nom d'attribut exact, comme l'aide _nomPartage (les majuscules sont gardées)
local function sharedExact(name)
	local text = tostring(name)
	text = string.gsub(text, "[\192-\223][\128-\191]", function(c)
		return SHARED_ACCENTS[c]
	end)
	text = string.gsub(text, "[^%w_]", "_")
	if text == "" then
		text = "valeur"
	end
	if string.sub(text, 1, 3) == "RBX" then
		text = "_" .. text
	end
	return string.sub(text, 1, 100)
end

local function checkProject(A)
	-- Variables lues mais jamais modifiées
	local readNames = {}
	for name in pairs(A.reads) do
		table.insert(readNames, name)
	end
	table.sort(readNames)
	for _, name in ipairs(readNames) do
		if not A.writes[name] and A.variableSet[name] then
			add(
				A,
				"conseil",
				A.reads[name],
				"Variable jamais modifiée.",
				"La variable "
					.. quote(name)
					.. " est lue mais jamais modifiée : elle vaut toujours 0. Utilise « mettre "
					.. name
					.. " à … » ou « ajouter … à "
					.. name
					.. " » quelque part."
			)
		end
	end

	checkMessages(A)

	-- Statistiques : mêmes noms à un accent / une majuscule près
	checkNearNames(A, A.stats, looseKey, "de statistique", "statistiques")
	-- Valeurs partagées : le nom est nettoyé (accents, espaces) ; seules les majuscules les séparent
	local sharedList = {}
	for _, item in ipairs(A.shared) do
		table.insert(sharedList, { name = item.name, exact = sharedExact(item.name), id = item.id })
	end
	checkNearNames(A, sharedList, sharedKey, "de valeur partagée", "valeurs partagées")

	-- « le dernier objet créé » sans aucun bloc qui crée d'objet
	if not A.hasCreator and #A.lastObjectUses > 0 then
		add(
			A,
			"avertissement",
			A.lastObjectUses[1],
			"« le dernier objet créé » est toujours vide.",
			"Aucun bloc « cloner … » ni « créer une partie … » n'est utilisé dans ce projet : « le dernier objet créé » vaudra toujours « rien »."
		)
	end

	-- Script local qui modifie le monde
	if A.firstWorldLocal ~= nil then
		add(
			A,
			"conseil",
			A.firstWorldLocal,
			"Changement visible par un seul joueur.",
			"Dans un script local, « "
				.. nameOf(A, A.firstWorldLocal)
				.. " » (et les blocs du même genre) ne change le monde que sur l'écran de ce joueur : les autres ne voient rien. Si tout le monde doit le voir, passe en « Script serveur »."
		)
	end
end

---------------------------------------------------------------------------
-- Version 2.1.0 : blocs désactivés, interface, statistiques de la place (SPEC §21.9, §22.1, §32)
---------------------------------------------------------------------------

-- Un seul conseil pour tous les blocs désactivés ; « Voir le bloc » montre le premier (ordre de lecture)
local function checkDisabled(A)
	local ids = {}
	local hats = 0
	for id, block in pairs(A.blocks) do
		if type(block) == "table" and block.disabled == true then
			table.insert(ids, id)
			local def = getDef(block)
			if def ~= nil and def.shape == "hat" then
				hats += 1
			end
		end
	end
	local n = #ids
	if n == 0 then
		return
	end
	table.sort(ids, function(p, q)
		local op, oq = A.order[p] or math.huge, A.order[q] or math.huge
		if op ~= oq then
			return op < oq
		end
		return tostring(p) < tostring(q)
	end)
	local title, message
	if n == 1 then
		title = "1 bloc est désactivé."
		message = "« "
			.. nameOf(A, ids[1])
			.. " » reste dans le projet mais n'est pas dans le script : le jeu fait comme s'il n'existait pas."
	else
		title = tostring(n) .. " blocs sont désactivés."
		message = "Ces blocs restent dans le projet mais ne sont pas dans le script : le jeu fait comme s'ils n'existaient pas. « Voir le bloc » montre le premier."
	end
	if hats > 0 then
		message = message .. " Un événement désactivé arrête aussi tous les blocs accrochés dessous."
	end
	message = message .. " Pour remettre un bloc : clic droit dessus, puis « Réactiver ce bloc »."
	add(A, "conseil", ids[1], title, message, { key = "desactives" })
end

-- Noms d'écrans et d'éléments écrits dans les blocs Interface (SPEC §21.9)
local function checkGuiNames(A)
	if #A.guiUses == 0 then
		return
	end
	local index = buildGuiIndex(A.guiNames)
	for _, use in ipairs(A.guiUses) do
		local value = use.value
		if use.filter == "ecran" then
			if index.screens[value] == nil then
				local hint = ""
				local close = similarName(value, index.screenList)
				if close ~= nil then
					hint = " Voulais-tu dire " .. quote(close) .. " ?"
				end
				add(
					A,
					"avertissement",
					use.id,
					"Écran introuvable : " .. quote(value) .. ".",
					"L'écran "
						.. quote(value)
						.. " n'existe pas dans StarterGui : « "
						.. use.label
						.. " » ne trouvera rien pendant le jeu."
						.. hint
						.. " Crée-le (et enregistre-le) dans l'onglet Interface, ou choisis un écran dans le menu ▼ du bloc."
				)
			end
		else
			local types = index.elements[value]
			local missingText = nil
			local candidates = index.elementList
			if types == nil then
				local screenName, elementName = string.match(value, "^([^/]+)/(.+)$")
				if screenName ~= nil then
					local screen = index.screens[screenName]
					if screen == nil then
						missingText = "L'écran " .. quote(screenName) .. " n'existe pas dans StarterGui."
						candidates = index.screenList
						value = screenName
					else
						types = screen.elements[elementName]
						if types == nil then
							missingText = "L'élément "
								.. quote(elementName)
								.. " n'existe pas dans l'écran "
								.. quote(screenName)
								.. "."
							candidates = {}
							for name in pairs(screen.elements) do
								table.insert(candidates, name)
							end
							table.sort(candidates)
							value = elementName
						end
					end
				else
					missingText = "L'élément " .. quote(value) .. " n'existe dans aucun écran."
				end
			end
			if missingText ~= nil then
				local hint = ""
				local close = similarName(value, candidates)
				if close ~= nil then
					hint = " Voulais-tu dire " .. quote(close) .. " ?"
				end
				add(
					A,
					"avertissement",
					use.id,
					"Élément introuvable : " .. quote(use.value) .. ".",
					missingText
						.. hint
						.. " Vérifie son nom dans le Studio d'interface (onglet Interface), ou choisis-le dans le menu ▼ du bloc : sinon « "
						.. use.label
						.. " » ne fera rien."
				)
			elseif types ~= nil and GUI_FILTER_TYPES[use.filter] ~= nil then
				local allowed = GUI_FILTER_TYPES[use.filter]
				local fits = false
				local actual = {}
				for t in pairs(types) do
					if allowed[t] then
						fits = true
					end
					table.insert(actual, GUI_TYPE_FR[t] or t)
				end
				if not fits then
					table.sort(actual)
					add(
						A,
						"avertissement",
						use.id,
						"Mauvais type d'élément : " .. quote(use.value) .. ".",
						"« "
							.. use.label
							.. " » attend "
							.. (GUI_FILTER_FR[use.filter] or "un autre type d'élément")
							.. ", mais "
							.. quote(use.value)
							.. " est "
							.. table.concat(actual, " ou ")
							.. " : le bloc ne pourra pas s'en servir. Choisis un autre élément dans le menu ▼ du bloc, ou change l'élément dans le Studio d'interface."
					)
				end
			end
		end
	end
end

-- Statistiques affichées dans l'interface mais jamais créées ; sauvegarde des statistiques en double
local function checkPlaceStats(A)
	local needStats = #A.guiStats > 0
	local needSave = #A.saveStats > 0
	if not needStats and not needSave then
		return
	end
	local others = otherProjects(A)

	if needSave then
		if #A.saveStats >= 2 then
			add(
				A,
				"avertissement",
				A.saveStats[2],
				"Sauvegarde des statistiques en double.",
				"Ce script contient "
					.. tostring(#A.saveStats)
					.. " blocs « sauvegarder les statistiques des joueurs » : un seul suffit pour tout le jeu. Supprime les autres."
			)
		end
		local paths = {}
		for _, project in ipairs(others) do
			if project.info.sauverStats then
				table.insert(paths, fullName(project.inst))
			end
		end
		table.sort(paths)
		if #paths > 0 then
			local where = "le script " .. quote(paths[1])
			if #paths > 1 then
				where = "les scripts " .. quoteList(paths, 3)
			end
			add(
				A,
				"avertissement",
				A.saveStats[1],
				"Statistiques déjà sauvegardées ailleurs.",
				"« sauvegarder les statistiques des joueurs » est aussi dans "
					.. where
					.. ". Un seul bloc suffit pour tout le jeu : deux sauvegardes en même temps peuvent se gêner. Garde-le dans un seul script, par exemple dans ServerScriptService."
			)
		end
	end

	if needStats then
		local created = {}
		local known = {}
		local function remember(name)
			if not created[name] then
				created[name] = true
				table.insert(known, name)
			end
		end
		for name in pairs(A.statCreated) do
			remember(name)
		end
		for _, project in ipairs(others) do
			for name in pairs(project.info.stats) do
				remember(name)
			end
		end
		table.sort(known)
		for _, stat in ipairs(A.guiStats) do
			if trim(stat.name) == "" then
				add(
					A,
					"avertissement",
					stat.id,
					"Statistique sans nom.",
					"« afficher la statistique … dans … » n'a pas de nom de statistique : il n'affichera rien. Écris le nom d'une statistique du classement, par exemple « Pièces »."
				)
			elseif not created[stat.name] then
				local hint = ""
				local close = similarName(stat.name, known)
				if close ~= nil then
					hint = " Voulais-tu dire " .. quote(close) .. " ? Les majuscules et les accents comptent."
				end
				add(
					A,
					"conseil",
					stat.id,
					"Statistique jamais créée : " .. quote(stat.name) .. ".",
					"« afficher la statistique … dans … » attend la statistique "
						.. quote(stat.name)
						.. " du classement, mais aucun script Blocs FR de ta place ne la crée."
						.. hint
						.. " Ajoute « créer la statistique "
						.. stat.name
						.. " (départ 0) » dans un script serveur (par exemple dans ServerScriptService), avec exactement le même nom."
				)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Scripts modules : contrôles d'ensemble (SPEC §20)
---------------------------------------------------------------------------

-- Ce que définit le module en cours d'édition (pour un module qui s'appelle lui-même par son nom)
local function liveModuleInfo(A)
	local info = newModuleInfo()
	info.functionsWildcard = A.moduleFunctionsWildcard
	info.valuesWildcard = A.moduleValuesWildcard
	for _, f in ipairs(A.moduleFunctions) do
		addName(info.functions, info.functionList, f.name)
		if f.returns then
			info.returns[f.name] = true
		end
	end
	for _, v in ipairs(A.moduleValues) do
		addName(info.values, info.valueList, v.name)
	end
	table.sort(info.valueList)
	return info
end

-- Module que l'aide _trouverModule trouvera pour ce nom : { module, service, serverOnly, serverService }
-- (serverOnly : script local, module trouvé seulement dans ServerScriptService / ServerStorage)
local function lookupModule(A, name)
	local cached = A.moduleLookups[name]
	if cached ~= nil then
		return cached
	end
	local result = {}
	-- un chemin « Dossier.Outils » est essayé d'abord, puis la recherche par nom
	local byPath, pathService = moduleAtPath(name)
	if byPath ~= nil then
		if A.mode == "local" and (pathService == "ServerScriptService" or pathService == "ServerStorage") then
			result.serverOnly, result.serverService = byPath, pathService
		else
			result.module, result.service = byPath, pathService
			A.moduleLookups[name] = result
			return result
		end
	end
	if A.mode == "local" then
		result.module, result.service = searchModule(MODULE_SERVICES_CLIENT, name)
		if result.module ~= nil then
			result.serverOnly, result.serverService = nil, nil
		elseif result.serverOnly == nil then
			result.serverOnly, result.serverService = searchModule(SERVER_ONLY_SERVICES, name)
		end
	else
		result.module, result.service = searchModule(MODULE_SERVICES_SERVER, name)
	end
	A.moduleLookups[name] = result
	return result
end

-- Fonction / valeur demandée à un module Blocs FR dont on connaît le contenu
local function checkCallNames(A, call, moduleInst, info)
	local name = call.name
	if name == nil then
		return
	end
	local moduleText = quote(call.module)
	local where = quote(fullName(moduleInst))
	if call.defId == "mod_valeur" then
		if info.valuesWildcard or info.values[name] or info.functions[name] then
			return
		end
		local known = " Ce module ne met encore aucune valeur."
		if #info.valueList > 0 then
			known = " Ses valeurs : " .. quoteList(info.valueList, 6) .. "."
		end
		local hint = ""
		local close = closeName(name, info.valueList)
		if close ~= nil then
			hint = " Voulais-tu dire " .. quote(close) .. " ? Les majuscules et les accents comptent."
		end
		add(
			A,
			"avertissement",
			call.id,
			"Valeur introuvable : " .. quote(name) .. ".",
			"Le module "
				.. moduleText
				.. " ("
				.. where
				.. ") ne met jamais de valeur "
				.. quote(name)
				.. " (aucun bloc « mettre la valeur "
				.. name
				.. " du module à … ») : ce bloc donnera « rien »."
				.. known
				.. hint
				.. " Corrige le nom, ou ajoute ce bloc dans le module puis réenregistre-le."
		)
		return
	end
	-- « appeler la fonction … » / « résultat de … »
	if info.functionsWildcard then
		return
	end
	if info.functions[name] then
		if call.defId == "mod_resultat" and not info.returns[name] then
			add(
				A,
				"conseil",
				call.id,
				"Fonction sans résultat.",
				"La fonction "
					.. quote(name)
					.. " du module "
					.. moduleText
					.. " ne contient aucun bloc « renvoyer … » : « "
					.. call.label
					.. " » vaudra toujours « rien ». Ajoute « renvoyer … » dans la fonction, ou utilise « appeler la fonction … » si tu n'as pas besoin de résultat."
			)
		end
		return
	end
	if info.values[name] then
		add(
			A,
			"avertissement",
			call.id,
			"Ce n'est pas une fonction.",
			quote(name)
				.. " est une valeur du module "
				.. moduleText
				.. ", pas une fonction : on ne peut pas l'appeler. Utilise plutôt le bloc « valeur "
				.. name
				.. " du module "
				.. call.module
				.. " »."
		)
		return
	end
	local known = " Ce module ne définit encore aucune fonction."
	if #info.functionList > 0 then
		known = " Ses fonctions : " .. quoteList(info.functionList, 6) .. "."
	end
	local hint = ""
	local close = closeName(name, info.functionList)
	if close ~= nil then
		hint = " Voulais-tu dire " .. quote(close) .. " ? Les majuscules et les accents comptent."
	end
	local effect = "ne fera rien"
	if call.defId == "mod_resultat" then
		effect = "donnera « rien »"
	end
	add(
		A,
		"avertissement",
		call.id,
		"Fonction introuvable : " .. quote(name) .. ".",
		"Le module "
			.. moduleText
			.. " ("
			.. where
			.. ") n'a pas de fonction "
			.. quote(name)
			.. " : pendant le jeu, ce bloc affichera un avertissement et "
			.. effect
			.. "."
			.. known
			.. hint
			.. " Corrige le nom, ou ajoute « Définir la fonction "
			.. name
			.. " » dans le module puis réenregistre-le."
	)
end

-- Blocs qui utilisent un module par son nom : le module existe-t-il, est-il accessible, a-t-il ce nom ?
local function checkModuleCalls(A)
	for _, call in ipairs(A.moduleCalls) do
		local moduleName = call.module
		if trim(moduleName) == "" then
			if call.defId ~= "mod_existe" then
				add(
					A,
					"avertissement",
					call.id,
					"Module sans nom.",
					"La case du module de « "
						.. call.label
						.. " » est vide : aucun module ne sera trouvé. Écris le nom du script module (ou du dossier qui le contient), par exemple « Outils »."
				)
			end
		else
			local found = lookupModule(A, moduleName)
			if found.module == nil and found.serverOnly ~= nil then
				add(
					A,
					"avertissement",
					call.id,
					"Module inaccessible depuis un script local.",
					"Le module "
						.. quote(moduleName)
						.. " est rangé dans "
						.. tostring(found.serverService)
						.. " ("
						.. quote(fullName(found.serverOnly))
						.. ") : ce dossier n'est jamais envoyé aux joueurs, donc un script local ne le trouvera pas. Range ce module dans ReplicatedStorage (par exemple dans un dossier "
						.. quote(moduleName)
						.. ")."
				)
			elseif found.module == nil then
				if call.defId ~= "mod_existe" then
					local hint = ""
					local suggestion = getNameIndex().names[string.lower(moduleName)]
					if suggestion ~= nil and suggestion ~= moduleName then
						hint = " Voulais-tu dire " .. quote(suggestion) .. " ? Les majuscules comptent."
					end
					local places = "ReplicatedStorage, ServerScriptService, ServerStorage, Workspace, ReplicatedFirst ou StarterPlayer"
					if A.mode == "local" then
						places = "ReplicatedStorage, Workspace, ReplicatedFirst ou StarterPlayer (les seuls endroits qu'un script local peut voir)"
					end
					add(
						A,
						"avertissement",
						call.id,
						"Module introuvable : " .. quote(moduleName) .. ".",
						"Aucun script module nommé "
							.. quote(moduleName)
							.. " (ni dossier ou objet de ce nom qui contient un script module) n'existe dans "
							.. places
							.. " : pendant le jeu, ce bloc ne pourra rien faire."
							.. hint
							.. " Crée ce module (un projet Blocs FR en « Script module », enregistré par exemple dans un dossier "
							.. quote(moduleName)
							.. " de ReplicatedStorage) ou corrige le nom."
					)
				end
			elseif call.defId ~= "mod_existe" then
				local info = nil
				if A.ownScript ~= nil and found.module == A.ownScript then
					info = liveModuleInfo(A)
				elseif isProjectModule(found.module) then
					info = moduleInfoOf(found.module)
				end
				if info ~= nil then
					checkCallNames(A, call, found.module, info)
				end
			end
		end
	end
end

local function checkModules(A)
	if A.mode == "module" then
		-- Deux fonctions du même nom : la dernière définie remplace l'autre
		local firstByName = {}
		for _, f in ipairs(A.moduleFunctions) do
			if firstByName[f.name] == nil then
				firstByName[f.name] = f
			else
				add(
					A,
					"erreur",
					f.id,
					"Deux fonctions portent le même nom.",
					"Une autre fonction de ce module s'appelle déjà "
						.. quote(f.name)
						.. " : l'une remplace l'autre, et les scripts qui appellent "
						.. quote(f.name)
						.. " n'en utiliseront qu'une. Donne un nom différent à chaque fonction."
				)
			end
		end
		-- Valeur qui porte le nom d'une fonction : elle la remplace
		for _, v in ipairs(A.moduleValues) do
			if firstByName[v.name] ~= nil then
				add(
					A,
					"avertissement",
					v.id,
					"Nom déjà pris par une fonction.",
					quote(v.name)
						.. " est déjà le nom d'une fonction de ce module : « mettre la valeur "
						.. v.name
						.. " du module à … » remplacera la fonction, qu'on ne pourra plus appeler. Choisis un autre nom pour la valeur."
				)
			end
		end
		-- Module qui ne partage rien
		if
			A.hasHat
			and #A.moduleFunctions == 0
			and not A.moduleFunctionsWildcard
			and #A.moduleValues == 0
			and not A.moduleValuesWildcard
		then
			add(
				A,
				"conseil",
				nil,
				"Module sans fonction ni valeur.",
				"Ce module ne définit aucune fonction et ne met aucune valeur : les scripts qui le chargent n'y trouveront rien à utiliser. Ajoute « Définir la fonction … » ou « mettre la valeur … du module à … » (catégorie Modules)."
			)
		end
		-- Blocs réservés à un seul côté : ils dépendent du script qui charge le module
		if A.firstLocalInModule ~= nil then
			add(
				A,
				"conseil",
				A.firstLocalInModule,
				"Module à charger depuis un script local.",
				"« "
					.. nameOf(A, A.firstLocalInModule)
					.. " » (et les blocs du même genre) ne fonctionne que sur l'ordinateur d'un joueur : il ne marchera que si ce module est chargé par un script local. Si un script serveur l'utilise, ce bloc ne fera rien ou provoquera une erreur."
			)
		end
		if A.firstServerInModule ~= nil then
			add(
				A,
				"conseil",
				A.firstServerInModule,
				"Module à charger depuis un script serveur.",
				"« "
					.. nameOf(A, A.firstServerInModule)
					.. " » (et les blocs du même genre) ne fonctionne que côté serveur : il ne marchera que si ce module est chargé par un script serveur. Si un script local l'utilise, ce bloc ne fera rien pour les autres joueurs ou provoquera une erreur."
			)
		end
	end
	checkModuleCalls(A)
end

-- Le script pourra-t-il s'exécuter à cet endroit ?
local function checkLocation(A)
	local target = A.target
	if target == nil or target == game then
		return
	end
	local service = topService(target)
	if service == nil then
		return
	end
	local serviceClass = "?"
	pcall(function()
		serviceClass = service.ClassName
	end)
	local where = quote(fullName(target))
	local function inside(name)
		local ok, result = pcall(function()
			local child = service:FindFirstChild(name)
			return child ~= nil and (target == child or target:IsDescendantOf(child))
		end)
		return ok and result == true
	end
	if A.mode == "module" then
		-- Un module s'exécute là où un script le charge : il ne « tourne » jamais tout seul ici, et
		-- ServerScriptService / ServerStorage conviennent aux modules du serveur. Seul problème : un
		-- module qui a besoin d'un script local mais que les joueurs ne reçoivent jamais. (Un script
		-- local qui appelle un module rangé là est signalé dans le projet de ce script.)
		if (serviceClass == "ServerScriptService" or serviceClass == "ServerStorage") and A.firstLocalInModule ~= nil then
			add(
				A,
				"avertissement",
				nil,
				"Module rangé côté serveur.",
				"Ce module utilise des blocs réservés aux scripts locaux (« "
					.. nameOf(A, A.firstLocalInModule)
					.. " »…), mais il est rangé dans "
					.. serviceClass
					.. ", que les joueurs ne reçoivent jamais : aucun script local ne pourra le charger. Choisis une cible dans ReplicatedStorage."
			)
		end
		return
	end
	if A.mode == "local" then
		if serviceClass == "ServerScriptService" or serviceClass == "ServerStorage" then
			add(
				A,
				"erreur",
				nil,
				"Script local mal placé.",
				"Un script local ne peut pas s'exécuter dans "
					.. serviceClass
					.. " : ce dossier n'est jamais envoyé aux joueurs. Choisis une cible dans StarterPlayer → StarterPlayerScripts, StarterGui, StarterPack ou Workspace."
			)
		elseif target == service and serviceClass == "StarterPlayer" then
			add(
				A,
				"erreur",
				nil,
				"Script local mal placé.",
				"Un script local placé directement dans StarterPlayer ne s'exécute pas. Choisis StarterPlayerScripts ou StarterCharacterScripts (dans StarterPlayer)."
			)
		end
		return
	end
	-- Script serveur
	if serviceClass == "Workspace" or serviceClass == "ServerScriptService" then
		return
	end
	local message
	if serviceClass == "StarterPlayer" then
		if inside("StarterCharacterScripts") then
			message = "Un script serveur placé dans StarterCharacterScripts est copié dans le personnage de chaque joueur : il s'exécutera une fois par personnage. Si ce n'est pas voulu, choisis une cible dans Workspace ou ServerScriptService."
		else
			message = "Un script serveur placé ici ("
				.. where
				.. ") ne s'exécute jamais : StarterPlayer est réservé aux scripts locaux. Passe en « Script local », ou choisis une cible dans Workspace ou ServerScriptService."
		end
	elseif serviceClass == "StarterGui" or serviceClass == "StarterPack" then
		message = "Un script serveur placé dans "
			.. serviceClass
			.. " est copié chez chaque joueur : il s'exécutera une fois par joueur (et pas dans le monde). Pour agir sur le monde, choisis une cible dans Workspace ; pour l'interface ou le clavier, passe en « Script local »."
	else
		message = "Un script serveur placé dans "
			.. serviceClass
			.. " ne s'exécute jamais. Choisis une cible dans Workspace (une partie, un modèle) ou dans ServerScriptService."
	end
	add(A, "avertissement", nil, "Script serveur mal placé.", message)
end

local function checkCodeProblems(A, model, ctx, info)
	local code = ctx.code
	local generated = nil
	-- Résultat complet de CodeGen.generate déjà calculé par l'appelant : erreurs de génération,
	-- avertissements et table des lignes restent disponibles (ctx.code seul ne les a pas)
	if type(ctx.generated) == "table" and type(ctx.generated.code) == "string" then
		generated = ctx.generated
		code = generated.code
	end
	if type(code) ~= "string" and ctx.generate ~= false then
		local okRequire, CodeGen = pcall(require, script.Parent.CodeGen)
		if okRequire and type(CodeGen) == "table" then
			local okGen, result = pcall(CodeGen.generate, model, A.mode)
			if okGen and type(result) == "table" and type(result.code) == "string" then
				generated = result
				code = result.code
			end
		end
	end
	if type(code) ~= "string" then
		return
	end
	info.code = code
	if generated then
		info.lineMap = generated.lineMap
		for i, err in ipairs(generated.errors or {}) do
			add(
				A,
				"erreur",
				nil,
				"Erreur interne de Blocs FR.",
				"Un bloc n'a pas pu être transformé en code. Ce n'est pas de ta faute : essaie de supprimer puis de remettre le dernier bloc ajouté, et signale ce problème avec le détail ci-dessous.",
				{ source = "code", raw = oneLine(err, 300), key = "code|generation|" .. i }
			)
		end
		for _, warning in ipairs(generated.warnings or {}) do
			if string.find(tostring(warning), "variables locales", 1, true) then
				add(A, "avertissement", nil, "Script trop gros.", oneLine(warning, 300), { source = "code", key = "code|locales" })
			end
		end
	end
	local ok, errFR, line = Detecteur.checkCode(code)
	info.codeOk = ok
	info.codeErr = errFR
	info.codeLine = line
	if ok == false then
		local blockId = nil
		if generated and line then
			local entry = Detecteur.blockAtLine(generated.lineMap, line)
			if entry and A.blocks[entry.block] then
				blockId = entry.block
			end
		end
		add(
			A,
			"erreur",
			blockId,
			"Erreur interne de Blocs FR.",
			"Le code généré par Blocs FR ne se compile pas : ce n'est pas de ta faute. Essaie de retirer le dernier bloc ajouté, puis signale ce problème avec le détail ci-dessous.",
			{ source = "code", raw = errFR, line = line, key = "code|compilation" }
		)
	end
end

-- Lance un contrôle sans laisser une erreur interne arrêter toute l'analyse
local function safely(A, what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		A.internalErrors += 1
		if A.internalErrors <= 3 then
			warn("[Blocs FR] Détecteur d'erreurs (" .. what .. ") : " .. tostring(err))
		end
	end
end

local function analyzeImpl(model, ctx)
	ctx = type(ctx) == "table" and ctx or {}
	local info = {}
	if type(model) ~= "table" then
		return {}, info
	end
	local mode = ctx.mode
	if mode ~= "server" and mode ~= "local" and mode ~= "module" then
		mode = model.mode
	end
	if mode ~= "local" and mode ~= "module" then
		mode = "server"
	end
	local target = ctx.target
	if not isAlive(target) then
		target = nil
	end
	-- La cible est le script Blocs FR lui-même (Script, LocalScript ou ModuleScript) : on regarde son parent
	local ownScript = nil
	if target ~= nil and (isA(target, "BaseScript") or isA(target, "ModuleScript")) then
		local okParent, parent, isProject = pcall(function()
			return target.Parent, target:GetAttribute("BlocsFR") == true
		end)
		if okParent and isProject and isAlive(parent) then
			ownScript = target
			target = parent
		end
	end
	-- Module en cours d'édition (déjà enregistré) : pour un module qui s'appelle lui-même par son nom
	if ownScript == nil and target ~= nil and mode == "module" then
		pcall(function()
			local child = target:FindFirstChild(MODULE_SCRIPT_NAME)
			if child ~= nil and child:IsA("ModuleScript") then
				ownScript = child
			end
		end)
	end

	local variableSet = {}
	if type(model.variables) == "table" then
		for _, name in ipairs(model.variables) do
			if type(name) == "string" then
				variableSet[name] = true
			end
		end
	end
	local fallen = -500
	pcall(function()
		local value = workspace.FallenPartsDestroyHeight
		if isFiniteNumber(value) then
			fallen = value
		end
	end)

	local A = {
		model = model,
		blocks = type(model.blocks) == "table" and model.blocks or {},
		tops = type(model.tops) == "table" and model.tops or {},
		variableSet = variableSet,
		mode = mode,
		target = target,
		fallenHeight = fallen,
		problems = {},
		seen = {},
		order = {},
		orderCount = 0,
		rootOf = {},
		sortedTops = {},
		walked = {},
		compiled = {},
		reads = {},
		writes = {},
		senders = {},
		receivers = {},
		senderWildcard = false,
		stats = {},
		shared = {},
		hasCreator = false,
		createdNames = {},
		lastObjectUses = {},
		contextReported = {},
		firstWorldLocal = nil,
		internalErrors = 0,
		-- Scripts modules (SPEC §20)
		ownScript = ownScript, -- script du projet ouvert (s'il est déjà enregistré) ou nil
		hasHat = false,
		moduleFunctions = {}, -- { { name, id, returns } } dans l'ordre de lecture
		moduleFunctionsWildcard = false,
		moduleValues = {}, -- { { name, id } }
		moduleValuesWildcard = false,
		moduleCalls = {}, -- { { id, defId, label, module, name } }
		moduleLookups = {},
		firstLocalInModule = nil,
		firstServerInModule = nil,
		-- Version 2.1.0 (SPEC §21.9, §22.1)
		guiNames = ctx.guiNames, -- écran en cours d'édition dans le Studio d'interface (pas encore enregistré)
		guiUses = {}, -- { { id, label, filter, value } } : noms écrits dans les cases « gui »
		guiStats = {}, -- { { name, id } } : « afficher la statistique … dans … »
		statCreated = {}, -- { [nom] = true } : statistiques créées par ce projet
		saveStats = {}, -- { id } : « sauvegarder les statistiques des joueurs »
		ownProject = ownScript or (target and projectScriptIn(target)) or nil, -- (pas compté deux fois)
	}
	computeOrder(A)

	-- Un projet sans aucun événement : un seul conseil clair
	local hasHat = false
	for _, top in ipairs(A.sortedTops) do
		local def = getDef(A.blocks[top.id])
		if def and def.shape == "hat" then
			hasHat = true
			break
		end
	end
	A.hasHat = hasHat

	for _, top in ipairs(A.sortedTops) do
		local block = A.blocks[top.id]
		local def = getDef(block)
		if def ~= nil then
			if block.disabled == true then
				-- événement désactivé (toute sa pile est hors du code) ou pile isolée « rangée » en
				-- désactivant son premier bloc : seulement le conseil de checkDisabled (SPEC §32)
				A.walked[top.id] = true
			elseif def.shape == "hat" then
				safely(A, "événement", checkHat, A, top.id, block, def)
			else
				safely(A, "pile", checkLooseStack, A, top.id, block, def)
			end
		end
	end
	if not hasHat and #A.sortedTops > 0 then
		local message = "Ce projet n'a aucun bloc « Quand … » : rien ne s'exécutera. Commence par un bloc de la catégorie Événements, par exemple « Quand ce script démarre », et accroche tes blocs dessous."
		if mode == "module" then
			message = "Ce module n'a aucun bloc « Définir la fonction … » ni « Quand le module est chargé » : il ne fait rien et ne partage rien. Commence par un bloc de la catégorie Modules et accroche tes blocs dessous."
		end
		add(A, "conseil", nil, "Aucun événement.", message)
	end

	safely(A, "blocs inconnus", checkUnknownBlocks, A)
	safely(A, "projet", checkProject, A)
	safely(A, "modules", checkModules, A)
	safely(A, "interface", checkGuiNames, A)
	safely(A, "statistiques", checkPlaceStats, A)
	safely(A, "blocs désactivés", checkDisabled, A)
	safely(A, "emplacement", checkLocation, A)
	safely(A, "code", checkCodeProblems, A, model, ctx, info)

	Detecteur.sort(A.problems)
	return A.problems, info
end

-- Analyse complète du projet. Ne lève jamais d'erreur.
function Detecteur.analyze(model, ctx)
	local ok, problems, info = pcall(analyzeImpl, model, ctx)
	if ok and type(problems) == "table" then
		return problems, info or {}
	end
	warn("[Blocs FR] Détecteur d'erreurs : " .. tostring(problems))
	return {
		{
			severity = "avertissement",
			blockId = nil,
			title = "Détecteur indisponible.",
			message = "Le détecteur d'erreurs a rencontré un problème interne et n'a pas pu tout vérifier : " .. oneLine(problems, 200),
			source = "statique",
			key = "detecteur-interne",
			order = -1,
			index = 1,
		},
	},
		{}
end

return Detecteur
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">DetecteurPanel</string><ProtectedString name="Source"><![CDATA[-- DetecteurPanel : panneau latéral « Problèmes » du détecteur d'erreurs (SPEC §17, planche de
-- design « Détecteur d'erreurs »). Panneau de 430 px à droite : en-tête « Problèmes » avec le nombre
-- d'erreurs / avertissements / conseils et le bouton « Tout vérifier », liste de cartes (barre de
-- couleur, pastille, titre en gras, message, erreur Luau brute pour les erreurs du test, lien
-- « Voir le bloc »), bouton « Effacer les erreurs du test », et en bas l'état du code généré.
--
-- API :
--   DetecteurPanel.new(layerFrame, deps) -> panel
--       deps = { dialogs, onSelectProblem = fn(problem), onRecheck = fn(), onClearTest = fn(),
--                onVisibilityChanged = fn(visible) (facultatif),
--                topInset / bottomInset (facultatifs : marges haut / bas, par défaut la hauteur de la
--                barre du haut et de la barre d'état) }
--   panel:setProblems(list, codeOk, codeErr)   -- codeOk : true / false ; absent (nil) = déduit de
--                                              -- la liste (erreur de source « code » -> false)
--   panel:show() ; panel:hide() ; panel:toggle() ; panel:isVisible() ; panel:destroy()
--   panel.frame                                -- le panneau (TextButton : il arrête les clics)
--
-- Animations (SPEC §24, module Anim ; durées × vitesse des réglages ; désactivées : tout est posé
-- tout de suite) : le panneau glisse depuis la droite (0,25 s quintOut) et repart vers la droite
-- (0,18 s) ; à l'ouverture, les cartes visibles arrivent en cascade (70 ms d'écart, 8 px plus bas,
-- en fondu) ; survol des cartes et des boutons en fondu, appui des boutons ; une pastille de
-- comptage « saute » quand son nombre change ; le rond « ✓ » de la liste vide et l'icône du pied
-- sautent quand l'état change. isVisible() change tout de suite (pas à la fin de l'animation).

local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Anim = require(script.Parent.Anim)

local DetecteurPanel = {}
DetecteurPanel.__index = DetecteurPanel

local WIDTH = Theme.Layout.ProblemsPanelWidth or 430
local HEADER_H = 102
local PILLS_Y = 68
local FOOTER_H = 54
local TESTBAR_H = 46
local PAD = 14 -- marge gauche / droite de la liste
local SCROLLBAR = 6
local CARD_GAP = 8
local CARD_W = WIDTH - 2 * PAD - SCROLLBAR
local TEXT_X = 48 -- début du texte dans une carte
local TEXT_W = CARD_W - TEXT_X - 14
local WHITE = Color3.fromRGB(255, 255, 255)
local SLIDE_IN = 0.25 -- le panneau arrive (quintOut)
local SLIDE_OUT = 0.18 -- le panneau repart (quadIn)
local STAGGER_STEP = 0.07
local STAGGER_MAX = 14

-- Style de chaque gravité : couleurs du thème lues au moment du dessin (les réglages peuvent
-- changer le thème sans recharger les modules)
local SEVERITY_SPECS = {
	erreur = {
		color = "Danger",
		text = "DangerText",
		glyph = "!",
		singular = "erreur",
		plural = "erreurs",
	},
	avertissement = {
		color = "Warning",
		text = "WarningText",
		glyph = "!",
		darkGlyph = true,
		singular = "avertissement",
		plural = "avertissements",
	},
	conseil = {
		color = "Info",
		text = "InfoText",
		glyph = "i",
		singular = "conseil",
		plural = "conseils",
	},
}
local SEVERITY_ORDER = { "erreur", "avertissement", "conseil" }

local function styleOf(severity)
	local spec = SEVERITY_SPECS[severity] or SEVERITY_SPECS.conseil
	local glyphColor = WHITE
	if spec.darkGlyph then
		glyphColor = Theme.Colors.TextDark
	end
	return {
		color = Theme.Colors[spec.color],
		text = Theme.Colors[spec.text],
		glyph = spec.glyph,
		glyphColor = glyphColor,
		singular = spec.singular,
		plural = spec.plural,
	}
end

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local measureCache = {}
local measureCount = 0

-- Hauteur d'un texte qui passe à la ligne dans une largeur donnée (ne cède jamais la main)
local function measure(text, size, font, width)
	local key = font.Name .. "|" .. size .. "|" .. width .. "|" .. text
	local cached = measureCache[key]
	if cached then
		return cached
	end
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 100000))
	end)
	local h
	if ok and typeof(result) == "Vector2" then
		h = math.ceil(result.Y)
	else
		local w = Util.textSize(text, size, font).X
		h = math.max(1, math.ceil(w / math.max(1, width))) * (size + 3)
	end
	if measureCount > 600 then
		measureCache = {}
		measureCount = 0
	end
	measureCache[key] = h
	measureCount += 1
	return h
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

local function label(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = Theme.TextSize.UI,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

local function oneLine(value, maxLen)
	local s = string.gsub(tostring(value or ""), "[\r\n\t]+", " ")
	if #s > maxLen then
		local cut = maxLen
		while cut > 0 do
			local b = string.byte(s, cut + 1)
			if b == nil or b < 0x80 or b >= 0xC0 then
				break
			end
			cut -= 1
		end
		s = string.sub(s, 1, cut) .. "…"
	end
	return s
end

local function plural(n, style)
	if n == 1 then
		return "1 " .. style.singular
	end
	return n .. " " .. style.plural
end

-- Ligne d'information sous le titre (erreurs du test / du code), ou nil
local function metaText(problem)
	local parts = {}
	if problem.source == "test" then
		table.insert(parts, "PENDANT LE TEST")
		if problem.side == "local" then
			table.insert(parts, "script local")
		elseif problem.side == "serveur" then
			table.insert(parts, "serveur")
		end
	elseif problem.source == "code" then
		table.insert(parts, "CODE GÉNÉRÉ")
	else
		return nil
	end
	if tonumber(problem.line) then
		table.insert(parts, "ligne " .. tostring(problem.line))
	end
	local count = tonumber(problem.count)
	if count and count > 1 then
		table.insert(parts, "×" .. tostring(count))
	end
	return table.concat(parts, " · ")
end

local function problemKey(problem)
	if problem.key ~= nil then
		return tostring(problem.key)
	end
	return tostring(problem.severity) .. "|" .. tostring(problem.blockId) .. "|" .. tostring(problem.title)
end

-- État du code généré déduit de la liste, quand l'appelant ne le donne pas (SPEC §17 :
-- panel:setProblems(list)). Une erreur « code » (compilation, ou code impossible à fabriquer)
-- -> false + son détail ; détecteur en panne -> nil (pas vérifié) ; sinon true.
local function codeStateFromList(problems)
	local found = nil
	local unchecked = false
	for _, problem in ipairs(problems) do
		if problem.source == "code" and problem.severity == "erreur" then
			if found == nil or (problem.key == "code|compilation" and found.key ~= "code|compilation") then
				found = problem
			end
		elseif problem.key == "detecteur-interne" then
			unchecked = true
		end
	end
	if found ~= nil then
		local detail = found.raw
		if type(detail) ~= "string" or detail == "" then
			detail = found.message
		end
		if type(detail) ~= "string" or detail == "" then
			detail = nil
		end
		return false, detail
	end
	if unchecked then
		return nil, nil
	end
	return true, nil
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function DetecteurPanel.new(layerFrame, deps)
	local self = setmetatable({}, DetecteurPanel)
	self.layer = layerFrame
	self.deps = deps or {}
	self.connections = {}
	self.contentMaid = Util.Maid.new()
	self._visible = false
	self._problems = {}
	self._codeOk = nil
	self._codeErr = nil
	self._dirty = true
	self._selectedKey = nil
	self._busy = false
	self._slide = nil -- glissement du panneau en cours (poignée Anim)
	self._lastCounts = nil -- nombres affichés dans les pastilles (elles sautent quand ils changent)
	self._lastCodeOk = nil -- état du code affiché dans le pied
	self._cards = {}
	self._destroyed = false

	local top = tonumber(self.deps.topInset) or Theme.Layout.TopBarHeight
	local bottom = tonumber(self.deps.bottomInset) or Theme.Layout.StatusBarHeight
	self.shownPosition = UDim2.new(1, -WIDTH, 0, top)
	self.hiddenPosition = UDim2.new(1, 0, 0, top)

	-- Le panneau est un bouton : les clics ne traversent pas jusqu'au canvas
	self.panel = Util.create("TextButton", {
		Name = "DetecteurErreurs",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = self.hiddenPosition,
		Size = UDim2.new(0, WIDTH, 1, -(top + bottom)),
		Visible = false,
		Parent = layerFrame,
	})
	self.frame = self.panel
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 5,
		Parent = self.panel,
	})

	self:_buildHeader()

	self.list = Util.create("ScrollingFrame", {
		Name = "Liste",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 1, -(HEADER_H + FOOTER_H)),
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = SCROLLBAR,
		ScrollBarImageColor3 = Theme.Colors.ButtonActive,
		VerticalScrollBarInset = Enum.ScrollBarInset.None,
		Parent = self.panel,
	})

	self:_buildTestBar()
	self:_buildFooter()
	self:_updateHeader()
	self:_updateFooter()
	return self
end

-- Petit bouton de l'en-tête / des barres. Il est ancré en son centre (même place que demandée par
-- props.anchor / props.position) : l'appui le fait rétrécir sur lui-même.
function DetecteurPanel:_button(parent, text, props)
	local font = props.font or Theme.Fonts.UIBold
	local size = props.textSize or 12
	local width = props.width or (textWidth(text, size, font) + 24)
	local height = props.height or 28
	local anchor = props.anchor or Vector2.new(0, 0)
	local position = props.position or UDim2.new()
	local button = Util.create("TextButton", {
		Name = props.name or "Bouton",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = props.color or Theme.Colors.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position + UDim2.fromOffset((0.5 - anchor.X) * width, (0.5 - anchor.Y) * height),
		Size = UDim2.fromOffset(width, height),
		Parent = parent,
	})
	Util.corner(button, 6)
	local text_ = label({
		Name = "Texte",
		Text = text,
		Font = font,
		TextSize = size,
		TextColor3 = props.textColor or Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	local normal = props.color or Theme.Colors.Button
	local hover = props.hoverColor or Theme.Colors.ButtonHover
	-- survol en fondu (0,12 s) et appui (94 % puis petit rebond)
	table.insert(self.connections, { Disconnect = Anim.hover(button, normal, hover) })
	table.insert(self.connections, { Disconnect = Anim.press(button) })
	return button, text_
end

function DetecteurPanel:_buildHeader()
	local header = Util.create("Frame", {
		Name = "EnTete",
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, HEADER_H),
		Parent = self.panel,
	})
	self.header = header
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = header,
	})

	label({
		Name = "Titre",
		Text = "Problèmes",
		Font = Theme.Fonts.UIBold,
		TextSize = 17,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.fromOffset(200, 22),
		Parent = header,
	})
	self.subtitle = label({
		Name = "SousTitre",
		Text = "",
		TextSize = Theme.TextSize.Small + 1,
		TextColor3 = Theme.Colors.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 43),
		Size = UDim2.new(1, -36, 0, 16),
		Parent = header,
	})

	local closeButton = self:_button(header, "×", {
		name = "Fermer",
		width = 28,
		textSize = 13,
		textColor = Theme.Colors.TextSoft,
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, -12, 0, 12),
	})
	table.insert(self.connections, closeButton.MouseButton1Click:Connect(function()
		self:hide()
	end))

	local recheckWidth = math.max(
		textWidth("Tout vérifier", 12, Theme.Fonts.UIBold),
		textWidth("Vérification…", 12, Theme.Fonts.UIBold)
	) + 26
	local recheck, recheckText = self:_button(header, "Tout vérifier", {
		name = "ToutVerifier",
		width = recheckWidth,
		color = Theme.Colors.Accent,
		hoverColor = Theme.Colors.AccentHover,
		textColor = WHITE,
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, -48, 0, 12),
	})
	self.recheckButton = recheck
	self.recheckText = recheckText
	table.insert(self.connections, recheck.MouseButton1Click:Connect(function()
		self:_recheck()
	end))

	-- Pastilles de comptage (ancrées en leur centre : elles « sautent » sur place)
	self.pills = {}
	for _, severity in ipairs(SEVERITY_ORDER) do
		local pill = Util.create("Frame", {
			Name = "Compte_" .. severity,
			BackgroundColor3 = Theme.Colors.Button,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(18 + 40, PILLS_Y + 12),
			Size = UDim2.fromOffset(80, 24),
			Parent = header,
		})
		Util.corner(pill, 12)
		local stroke = Util.stroke(pill, Theme.Colors.PanelBorder, 1, 0)
		local dot = Util.create("Frame", {
			Name = "Point",
			BackgroundColor3 = Theme.Colors.TextDisabled,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.fromOffset(8, 8),
			Parent = pill,
		})
		Util.corner(dot, 4)
		local text = label({
			Name = "Texte",
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextColor3 = Theme.Colors.TextDim,
			Position = UDim2.fromOffset(24, 0),
			Size = UDim2.new(1, -30, 1, 0),
			Parent = pill,
		})
		self.pills[severity] = { frame = pill, stroke = stroke, dot = dot, text = text }
	end
end

function DetecteurPanel:_buildTestBar()
	local bar = Util.create("Frame", {
		Name = "BarreTest",
		BackgroundColor3 = Theme.Colors.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -(FOOTER_H + TESTBAR_H)),
		Size = UDim2.new(1, 0, 0, TESTBAR_H),
		Visible = false,
		Parent = self.panel,
	})
	self.testBar = bar
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Parent = bar,
	})
	local clearText = "Effacer les erreurs du test"
	local clearWidth = textWidth(clearText, 12, Theme.Fonts.UIBold) + 24
	self.testLabel = label({
		Name = "Texte",
		Text = "",
		TextSize = Theme.TextSize.Small + 1,
		TextColor3 = Theme.Colors.TextSoft,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 1),
		Size = UDim2.new(1, -(clearWidth + 44), 1, -1),
		Parent = bar,
	})
	local clear = self:_button(bar, clearText, {
		name = "EffacerTest",
		width = clearWidth,
		textColor = Theme.Colors.DangerText,
		anchor = Vector2.new(1, 0.5),
		position = UDim2.new(1, -14, 0.5, 0),
	})
	table.insert(self.connections, clear.MouseButton1Click:Connect(function()
		local fn = self.deps.onClearTest
		if type(fn) == "function" then
			task.spawn(function()
				local ok, err = pcall(fn)
				if not ok then
					warn("[Blocs FR] Effacer les erreurs du test : " .. tostring(err))
				end
			end)
		end
	end))
end

function DetecteurPanel:_buildFooter()
	local footer = Util.create("Frame", {
		Name = "Pied",
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -FOOTER_H),
		Size = UDim2.new(1, 0, 0, FOOTER_H),
		Parent = self.panel,
	})
	self.footer = footer
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Parent = footer,
	})
	-- (ancrée en son centre : elle saute sur place quand l'état du code change)
	local icon = Util.create("Frame", {
		Name = "Icone",
		BackgroundColor3 = Theme.Colors.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 28, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		Parent = footer,
	})
	Util.corner(icon, 10)
	self.footerIcon = icon
	self.footerGlyph = label({
		Name = "Signe",
		Font = Theme.Fonts.UIBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = icon,
	})
	self.footerText = label({
		Name = "Texte",
		TextSize = Theme.TextSize.Small + 1,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(48, 6),
		Size = UDim2.new(1, -62, 1, -12),
		Parent = footer,
	})
end

---------------------------------------------------------------------------
-- Mise à jour de l'en-tête, de la barre du test et du pied
---------------------------------------------------------------------------

function DetecteurPanel:_counts()
	local counts = { erreur = 0, avertissement = 0, conseil = 0 }
	local tests = 0
	for _, problem in ipairs(self._problems) do
		if counts[problem.severity] ~= nil then
			counts[problem.severity] += 1
		end
		if problem.source == "test" then
			tests += 1
		end
	end
	return counts, tests
end

function DetecteurPanel:_updateHeader()
	local counts = self:_counts()
	local previous = self._lastCounts
	self._lastCounts = counts
	local x = 18
	for _, severity in ipairs(SEVERITY_ORDER) do
		local pill = self.pills[severity]
		local style = styleOf(severity)
		local n = counts[severity]
		local text = plural(n, style)
		pill.text.Text = text
		local width = textWidth(text, 12, Theme.Fonts.UIBold) + 36
		pill.frame.Position = UDim2.fromOffset(x + width / 2, PILLS_Y + 12)
		pill.frame.Size = UDim2.fromOffset(width, 24)
		x += width + 6
		-- le nombre a changé pendant que le panneau est ouvert : la pastille saute
		if self._visible and previous ~= nil and previous[severity] ~= n then
			Anim.popIn(pill.frame, 0.85)
		end
		if n > 0 then
			pill.frame.BackgroundColor3 = Theme.darken(style.color, 0.72)
			pill.stroke.Color = Theme.darken(style.color, 0.35)
			pill.dot.BackgroundColor3 = style.color
			pill.text.TextColor3 = style.text
		else
			pill.frame.BackgroundColor3 = Theme.Colors.Button
			pill.stroke.Color = Theme.Colors.PanelBorder
			pill.dot.BackgroundColor3 = Theme.Colors.TextDisabled
			pill.text.TextColor3 = Theme.Colors.TextDim
		end
	end
	local total = counts.erreur + counts.avertissement + counts.conseil
	if total == 0 then
		self.subtitle.Text = "Tes blocs sont vérifiés à chaque modification."
	elseif total == 1 then
		self.subtitle.Text = "1 point à regarder · clique sur « Voir le bloc » pour le retrouver"
	else
		self.subtitle.Text = total .. " points à regarder · clique sur « Voir le bloc » pour les retrouver"
	end
end

function DetecteurPanel:_updateFooter()
	local ok = self._codeOk
	-- l'état du code change pendant que le panneau est ouvert : l'icône saute
	local changed = ok ~= self._lastCodeOk
	self._lastCodeOk = ok
	if changed and self._visible then
		Anim.popIn(self.footerIcon, 0.6)
	end
	if ok == true then
		self.footerIcon.BackgroundColor3 = Theme.Colors.Success
		self.footerGlyph.Text = "✓"
		self.footerGlyph.TextColor3 = WHITE
		self.footerText.Text = "Le code généré est valide (vérifié par Luau)"
		self.footerText.TextColor3 = Theme.Colors.SuccessText
	elseif ok == false then
		self.footerIcon.BackgroundColor3 = Theme.Colors.Danger
		self.footerGlyph.Text = "×"
		self.footerGlyph.TextColor3 = WHITE
		local detail = oneLine(self._codeErr or "erreur inconnue", 160)
		self.footerText.Text = "Le code généré ne compile pas : " .. detail
		self.footerText.TextColor3 = Theme.Colors.DangerText
	else
		self.footerIcon.BackgroundColor3 = Theme.Colors.Button
		self.footerGlyph.Text = "…"
		self.footerGlyph.TextColor3 = Theme.Colors.TextDim
		self.footerText.Text = "Code pas encore vérifié."
		self.footerText.TextColor3 = Theme.Colors.TextDim
	end
end

function DetecteurPanel:_updateTestBar(tests)
	local visible = tests > 0
	self.testBar.Visible = visible
	if visible then
		local word = "erreur"
		if tests > 1 then
			word = "erreurs"
		end
		self.testLabel.Text = "● " .. tests .. " " .. word .. " pendant le test"
		self.list.Size = UDim2.new(1, 0, 1, -(HEADER_H + FOOTER_H + TESTBAR_H))
	else
		self.list.Size = UDim2.new(1, 0, 1, -(HEADER_H + FOOTER_H))
	end
end

---------------------------------------------------------------------------
-- Liste des problèmes
---------------------------------------------------------------------------

function DetecteurPanel:_select(problem)
	self._selectedKey = problemKey(problem)
	for _, entry in ipairs(self._cards or {}) do
		local selected = entry.key == self._selectedKey
		if entry.stroke then
			if selected then
				entry.stroke.Color = Theme.Colors.Accent
				entry.stroke.Thickness = 2
			else
				entry.stroke.Color = Theme.Colors.PanelBorder
				entry.stroke.Thickness = 1
			end
		end
	end
	-- Sans bloc, App explique dans la barre d'état que le problème concerne tout le script.
	-- Une erreur du test sans bloc reste muette : App la prendrait pour un bloc supprimé.
	if problem.blockId == nil and problem.source == "test" then
		return
	end
	local fn = self.deps.onSelectProblem
	if type(fn) == "function" then
		task.spawn(function()
			local ok, err = pcall(fn, problem)
			if not ok then
				warn("[Blocs FR] Voir le bloc : " .. tostring(err))
			end
		end)
	end
end

function DetecteurPanel:_card(problem, y)
	local maid = self.contentMaid
	local style = styleOf(problem.severity)
	local title = oneLine(problem.title or "Problème", 300)
	local message = tostring(problem.message or "")
	local meta = metaText(problem)
	local raw = nil
	if (problem.source == "test" or problem.source == "code") and type(problem.raw) == "string" and problem.raw ~= "" then
		raw = oneLine(problem.raw, 500)
	end
	local hasLink = problem.blockId ~= nil and type(self.deps.onSelectProblem) == "function"
	local key = problemKey(problem)
	local selected = key == self._selectedKey

	local titleH = measure(title, 13, Theme.Fonts.UIBold, TEXT_W)
	local metaH = 0
	if meta then
		metaH = 14
	end
	local messageH = 0
	if message ~= "" then
		messageH = measure(message, 12, Theme.Fonts.UI, TEXT_W)
	end
	local rawH = 0
	if raw then
		rawH = measure(raw, 12, Theme.Fonts.Code, TEXT_W - 16) + 12
	end
	local linkH = 0
	if hasLink then
		linkH = 18
	end

	local h = 12 + titleH
	if metaH > 0 then
		h += 3 + metaH
	end
	if messageH > 0 then
		h += 5 + messageH
	end
	if rawH > 0 then
		h += 8 + rawH
	end
	if linkH > 0 then
		h += 8 + linkH
	end
	h += 12
	h = math.max(h, 46)

	local card = maid:give(Util.create("TextButton", {
		Name = "Probleme",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, y),
		Size = UDim2.fromOffset(CARD_W, h),
		Parent = self.list,
	}))
	Util.corner(card, 8)
	local stroke = Util.stroke(card, Theme.Colors.PanelBorder, 1, 0)
	if selected then
		stroke.Color = Theme.Colors.Accent
		stroke.Thickness = 2
	end

	-- Barre de couleur à gauche + pastille
	local bar = Util.create("Frame", {
		Name = "Barre",
		BackgroundColor3 = style.color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(9, 10),
		Size = UDim2.fromOffset(3, h - 20),
		Parent = card,
	})
	Util.corner(bar, 2)
	local badge = Util.create("Frame", {
		Name = "Pastille",
		BackgroundColor3 = style.color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(19, 10),
		Size = UDim2.fromOffset(20, 20),
		Parent = card,
	})
	Util.corner(badge, 10)
	label({
		Name = "Signe",
		Text = style.glyph,
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		TextColor3 = style.glyphColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = badge,
	})

	local cy = 12
	label({
		Name = "Titre",
		Text = title,
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(TEXT_X, cy),
		Size = UDim2.fromOffset(TEXT_W, titleH),
		Parent = card,
	})
	cy += titleH
	if meta then
		cy += 3
		label({
			Name = "Infos",
			Text = meta,
			Font = Theme.Fonts.UIBold,
			TextSize = 10,
			TextColor3 = style.text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(TEXT_X, cy),
			Size = UDim2.fromOffset(TEXT_W, metaH),
			Parent = card,
		})
		cy += metaH
	end
	if messageH > 0 then
		cy += 5
		label({
			Name = "Message",
			Text = message,
			TextSize = 12,
			TextColor3 = Theme.Colors.TextSoft,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(TEXT_X, cy),
			Size = UDim2.fromOffset(TEXT_W, messageH),
			Parent = card,
		})
		cy += messageH
	end
	if rawH > 0 then
		cy += 8
		local box = Util.create("Frame", {
			Name = "ErreurLuau",
			BackgroundColor3 = Theme.Colors.CodeBg,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(TEXT_X, cy),
			Size = UDim2.fromOffset(TEXT_W, rawH),
			Parent = card,
		})
		Util.corner(box, 5)
		label({
			Name = "Texte",
			Text = raw,
			Font = Theme.Fonts.Code,
			TextSize = 12,
			TextColor3 = Theme.Colors.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(TEXT_W - 16, rawH - 12),
			Parent = box,
		})
		cy += rawH
	end
	if hasLink then
		cy += 8
		local linkText = "Voir le bloc →"
		local link = Util.create("TextButton", {
			Name = "VoirLeBloc",
			Text = linkText,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Theme.Fonts.UIBold,
			TextSize = 12,
			TextColor3 = Theme.Colors.AccentText,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(TEXT_X, cy),
			Size = UDim2.fromOffset(textWidth(linkText, 12, Theme.Fonts.UIBold) + 6, linkH),
			Parent = card,
		})
		maid:give(link.MouseEnter:Connect(function()
			link.TextColor3 = Theme.Colors.Text
		end))
		maid:give(link.MouseLeave:Connect(function()
			link.TextColor3 = Theme.Colors.AccentText
		end))
		maid:give(link.MouseButton1Click:Connect(function()
			self:_select(problem)
		end))
	end

	-- survol en fondu (0,12 s)
	maid:give(Anim.hover(card, Theme.Colors.PanelAlt, Theme.Colors.ButtonHover))
	maid:give(card.MouseButton1Click:Connect(function()
		self:_select(problem)
	end))

	table.insert(self._cards, { key = key, stroke = stroke, frame = card, y = y, h = h })
	return h
end

function DetecteurPanel:_emptyState(viewportH)
	local maid = self.contentMaid
	local holder = maid:give(Util.create("Frame", {
		Name = "AucunProbleme",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, 0),
		Size = UDim2.fromOffset(CARD_W, math.max(220, viewportH)),
		Parent = self.list,
	}))
	local top = math.max(28, math.floor((math.max(220, viewportH) - 190) / 2))
	-- (ancré en son centre : il « saute » sur place quand la liste devient vide)
	local circle = Util.create("Frame", {
		Name = "Cercle",
		BackgroundColor3 = Theme.darken(Theme.Colors.Success, 0.7),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, top + 32),
		Size = UDim2.fromOffset(64, 64),
		Parent = holder,
	})
	self._emptyHolder = holder
	self._emptyCircle = circle
	Util.corner(circle, 32)
	Util.stroke(circle, Theme.Colors.Success, 2, 0.3)
	label({
		Name = "Signe",
		Text = "✓",
		Font = Theme.Fonts.UIBold,
		TextSize = 30,
		TextColor3 = Theme.Colors.SuccessText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = circle,
	})
	label({
		Name = "Titre",
		Text = "Aucun problème détecté ✓",
		Font = Theme.Fonts.UIBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, top + 80),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = holder,
	})
	local hint = "Tes blocs ont l'air prêts. Pendant un test (bouton « Jouer » de Studio), les erreurs du jeu s'afficheront aussi ici."
	local hintH = measure(hint, 12, Theme.Fonts.UI, CARD_W - 40)
	label({
		Name = "Aide",
		Text = hint,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(20, top + 108),
		Size = UDim2.fromOffset(CARD_W - 40, hintH),
		Parent = holder,
	})
	return math.max(220, viewportH)
end

-- Redessine la liste. opening = true : le panneau s'ouvre (les cartes visibles arrivent en cascade)
function DetecteurPanel:_render(opening)
	if self._destroyed or self.list == nil then
		return
	end
	self._dirty = false
	local previous = self.list.CanvasPosition
	self.contentMaid:clean()
	self._cards = {}
	self._emptyHolder = nil
	self._emptyCircle = nil
	local wasEmpty = self._emptyShown == true
	self._emptyShown = #self._problems == 0

	local viewportH = self.list.AbsoluteSize.Y
	if viewportH < 50 then
		viewportH = 400
	end

	local total
	if #self._problems == 0 then
		total = self:_emptyState(viewportH)
	else
		local y = 12
		for _, problem in ipairs(self._problems) do
			local ok, h = pcall(function()
				return self:_card(problem, y)
			end)
			if ok and type(h) == "number" then
				y += h + CARD_GAP
			else
				warn("[Blocs FR] Panneau des problèmes : " .. tostring(h))
			end
		end
		total = y + 4
	end
	self.list.CanvasSize = UDim2.fromOffset(0, total)
	local maxY = math.max(0, total - viewportH)
	self.list.CanvasPosition = Vector2.new(0, math.clamp(previous.Y, 0, maxY))

	if opening then
		self:_animateRows(viewportH)
	elseif self._emptyShown and not wasEmpty and self._visible then
		-- le dernier problème vient d'être réglé : le rond « ✓ » saute
		self:_popEmpty()
	end
end

-- Ouverture : les cartes visibles arrivent l'une après l'autre (70 ms d'écart, 8 px plus bas, en
-- fondu) ; liste vide : le rond « ✓ » saute
function DetecteurPanel:_animateRows(viewportH)
	if not Anim.enabled() then
		return
	end
	if self._emptyShown then
		self:_popEmpty()
		return
	end
	local top = self.list.CanvasPosition.Y
	local visible = {}
	for _, entry in ipairs(self._cards) do
		if entry.frame ~= nil and entry.y + entry.h >= top and entry.y <= top + viewportH then
			table.insert(visible, entry.frame)
			if #visible >= STAGGER_MAX then
				break
			end
		end
	end
	Anim.stagger(visible, STAGGER_STEP, Vector2.new(0, 8))
end

function DetecteurPanel:_popEmpty()
	if self._emptyCircle ~= nil then
		Anim.popIn(self._emptyCircle, 0.6)
	end
	if self._emptyHolder ~= nil then
		Anim.fadeIn(self._emptyHolder, 0.22)
	end
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

function DetecteurPanel:_setBusy(busy)
	self._busy = busy
	if self.recheckText then
		if busy then
			self.recheckText.Text = "Vérification…"
		else
			self.recheckText.Text = "Tout vérifier"
		end
	end
end

function DetecteurPanel:_recheck()
	local fn = self.deps.onRecheck
	if type(fn) ~= "function" or self._busy then
		return
	end
	self:_setBusy(true)
	task.spawn(function()
		local ok, err = pcall(fn)
		if not ok then
			warn("[Blocs FR] Tout vérifier : " .. tostring(err))
			if not self._destroyed then
				self:_setBusy(false)
			end
		end
	end)
	-- sécurité : le bouton redevient normal même si setProblems n'est pas rappelé
	task.delay(3, function()
		if not self._destroyed and self._busy then
			self:_setBusy(false)
		end
	end)
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

-- list = problèmes (Detecteur.analyze + erreurs du test) ; codeOk = true / false (nil : déduit de
-- la liste) ; codeErr = texte
function DetecteurPanel:setProblems(list, codeOk, codeErr)
	if self._destroyed then
		return
	end
	local problems = {}
	if type(list) == "table" then
		for _, problem in ipairs(list) do
			if type(problem) == "table" then
				table.insert(problems, problem)
			end
		end
	end
	self._problems = problems
	if codeOk == true or codeOk == false then
		self._codeOk = codeOk
		if codeErr ~= nil then
			self._codeErr = tostring(codeErr)
		else
			self._codeErr = nil
		end
	else
		-- Appel à un argument (celui d'App) : l'état du code se déduit des problèmes « code »
		local inferredOk, inferredErr = codeStateFromList(problems)
		self._codeOk = inferredOk
		if inferredErr == nil and codeErr ~= nil and inferredOk == false then
			inferredErr = tostring(codeErr)
		end
		self._codeErr = inferredErr
	end
	self:_setBusy(false)
	local _, tests = self:_counts()
	self:_updateHeader()
	self:_updateFooter()
	self:_updateTestBar(tests)
	if self._visible then
		self:_render()
	else
		self._dirty = true
	end
end

-- Fait glisser le panneau vers sa place (shown = true) ou hors de la fenêtre, puis le cache
function DetecteurPanel:_slideTo(shown)
	local handle = self._slide
	self._slide = nil
	if handle then
		handle:cancel()
	end
	local panel = self.panel
	if panel == nil then
		return
	end
	if shown then
		self._slide = Anim.tween(panel, { Position = self.shownPosition }, SLIDE_IN, "quintOut")
	else
		self._slide = Anim.tween(panel, { Position = self.hiddenPosition }, SLIDE_OUT, "quadIn", function()
			if not self._destroyed and not self._visible and self.panel == panel then
				panel.Visible = false
			end
		end)
	end
end

function DetecteurPanel:show()
	if self._destroyed or self.panel == nil then
		return
	end
	local wasVisible = self._visible
	self._visible = true
	-- (encore visible s'il était en train de repartir : il revient d'où il est)
	local onScreen = self.panel.Visible
	self.panel.Visible = true
	if wasVisible then
		if self._dirty then
			self:_render(false)
		end
		return
	end
	if not onScreen then
		self.panel.Position = self.hiddenPosition
	end
	self:_render(true)
	self:_slideTo(true)
	self:_notifyVisibility()
end

function DetecteurPanel:hide()
	if self._destroyed then
		return
	end
	local wasVisible = self._visible
	self._visible = false
	if self.panel then
		if wasVisible then
			self:_slideTo(false)
		elseif not (self._slide and self._slide:isPlaying()) then
			self.panel.Visible = false
			self.panel.Position = self.hiddenPosition
		end
	end
	if wasVisible then
		self:_notifyVisibility()
	end
end

function DetecteurPanel:toggle()
	if self._visible then
		self:hide()
	else
		self:show()
	end
end

function DetecteurPanel:isVisible()
	return self._visible
end

function DetecteurPanel:_notifyVisibility()
	local fn = self.deps.onVisibilityChanged
	if type(fn) == "function" then
		local visible = self._visible
		task.spawn(function()
			pcall(fn, visible)
		end)
	end
end

function DetecteurPanel:destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self._visible = false
	if self._slide then
		self._slide:cancel()
		self._slide = nil
	end
	self.contentMaid:clean()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.panel then
		self.panel:Destroy()
		self.panel = nil
		self.frame = nil
	end
	self.list = nil
end

return DetecteurPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">DevBridge</string><ProtectedString name="Source"><![CDATA[-- DevBridge : pont de test pour le développement (inclus seulement avec « py tools/build.py --dev »).
-- SPEC §14. Crée CoreGui.BlocsFR_Dev (BindableFunction). Exemple (barre de commande de Studio) :
--   game:GetService("CoreGui").BlocsFR_Dev:Invoke("checkAll")
-- Chaque appel renvoie toujours une table { ok = bool, result = ..., error = string? }.
--
-- Commandes :
--   "ping"                 -> "pong"
--   "registry"             -> { count, hidden, helpers, problems = {...}, ids = {...} }
--   "fuzz"                 -> { tested, failures = { { def, mode, variant, err, code } } }
--   "checkAll"             -> résumé compact du fuzz : { tested, failed, ok, failedDefs, registryProblems,
--                             failures = 20 premiers échecs avec un extrait du code }
--   "generate", json, mode -> { code, warnings, errors, hats, ignored, loadWarnings }
--   "check", code          -> { ok, err }
--   "open"                 -> { opened }
--   "state"                -> app:getDebugState()
--   "load", json           -> charge le projet dans l'éditeur : { loaded, blocks, warnings }
--   "export"               -> JSON du projet ouvert dans l'éditeur
--   "help"                 -> liste des commandes
-- Phase 2 :
--   "examples"             -> chaque exemple d'Examples.lua chargé (Model.fromData), généré dans les trois
--                             modes et vérifié : { count, tested, ok, failures = { { id, mode, err, code } },
--                             examples = { { id, title, mode, blocks, warnings, detecteurErreurs } } }
-- Scripts modules (SPEC §20) : le fuzz et « examples » génèrent aussi en mode "module" (le code doit
-- se terminer par « return Module ») ; les blocs « module » sont essayés sous « Définir la fonction ».
--   "analyze"              -> Detecteur.analyze sur le projet ouvert : { count, counts, problems, editor }
--   "wiki", pageId?, defId? -> ouvre la fenêtre du wiki : { opened }
--   "loadExample", id      -> app:loadExample(id) : { loaded, message, state }
--   "setTarget", chemin ; "save" ; "toggleProblems" ; "showCode"   (tests automatiques de l'éditeur)
-- Version 2.1.0 (SPEC §21.9, §25, §27-§32) :
--   "guiList"              -> GuiStorage.allNames() : { screens, elements }
--   "guiBuildAll"          -> chaque modèle d'interface construit (ScreenGui sans parent + applyScale 0,5) et
--                             ses blocs compilés en script local : { ok, built, total, errors, templates }
--   "guiTemplate", id, ouvrir? -> enregistre le modèle d'interface dans StarterGui (nom libre) avec le script
--                             de ses blocs : { screen, path, script, warnings } (ouvrir = true : l'ouvre aussi)
--   "workspace", "blocs"|"interface"|nil -> app:setWorkspace (nil : lit seulement) : { workspace }
--   "guiOpen", nomÉcran    -> ouvre cet écran dans le Studio d'interface : { opened, state }
--   "guiState"             -> état du Studio d'interface : { workspace, editor, screens }
--   "guiSelect", nomÉlément -> sélectionne l'élément dans l'écran ouvert : { id, selection, state }
--   "updateCheck"          -> MiseAJour.check(true) : { info, version, carteVisible }
--   "simulateUpdate", "9.9.9"|"apres" -> affiche la carte de mise à jour (rien n'est retenu) : { shown, visible }
--   "hitbox", blockId|"libre"|nil, options|nil -> prévisualiseur de hitbox : ouvert dans l'éditeur
--                             (options.ouvrir = true) ou sans affichage ; simulation lancée :
--                             { hit, resultat, params, prediction, bloc, state }. options = { largeur, hauteur,
--                             profondeur, degats, distance, bouge, ouvrir, json = projet }
--   "explain", json?, mode? -> Explication.explain (projet ouvert sinon) : { lignes, resultat }
--   "notes", texte?, blockId|"libre"?, json? -> ajoute une note à une COPIE du projet (ouvert, JSON ou
--                             démonstration) et renvoie le code : { code, lignes, placement, sansNotes, … }
--   "settings", action?, … -> réglages : "get" (défaut), "apply", réglages|texte ; "set", "zone.aimant", 20 ;
--                             "reset" (garde les favoris, comme « Tout réinitialiser ») ; "export" ;
--                             "import", texte. Après un changement : comme « Appliquer » des paramètres
--                             (app:_applySettings : thème appliqué, éditeur reconstruit par host.rebuildApp)
--   "share", json|code?    -> code de partage « BLOCSFR1: » : aller-retour export / import comparé
--                             (données et code généré) ; avec un code donné : seulement l'import
--   "draft", action?       -> brouillons automatiques (BlocsFR_Brouillon, format d'App { version = 2,
--                             entries }) : "lire" (défaut), "enregistrer" (app:saveDraft(true)),
--                             "effacer" (app:clearDraft("*")), "verifier" (app:checkDraft : la fenêtre
--                             « Brouillon retrouvé » s'ouvre si un brouillon diffère du projet enregistré)
--   "links", json?         -> lignes entre les blocs (SPEC §36) : lignes automatiques calculées (messages,
--                             fonctions de module, variables) du projet ouvert (ou du JSON), celles du
--                             canvas s'il les expose, et un essai complet des lignes manuelles du Model
--                             (addLink / setLink / linksOf / removeLink, sauvegarde, annuler, suppression
--                             avec le bloc, importData, commentaire « -- Lien vers ») quand il les a
-- Le fuzz essaie aussi chaque bloc avec des notes (texte piégeux), désactivé, et avec des noms d'écran /
-- d'élément piégeux dans les entrées « gui », dans les trois modes ; « examples » vérifie aussi les blocs
-- des modèles d'interface (GuiTemplates), la palette « Modèles » (Modeles.lua) et les références du wiki
-- (WikiContent : blocs, exemples et liens qui existent ; page « nouveautes »).

local HttpService = game:GetService("HttpService")
local LogService = game:GetService("LogService")

local Registry = require(script.Parent.Registry)
local CodeGen = require(script.Parent.CodeGen)

local DevBridge = {}

local BRIDGE_NAME = "BlocsFR_Dev"
local MAX_SUMMARY_FAILURES = 20
local EXCERPT_RADIUS = 4
local EXCERPT_MAX = 1500
local LOG_WAIT = 0.2 -- attente maximale des messages de LogService après un require raté (s)
local MODES = { "server", "local", "module" }
local VALID_MODES = { server = true, ["local"] = true, module = true }
local FUNCTION_HAT = "mod_fonction" -- chapeau « Définir la fonction » (blocs des scripts modules)
local COMMANDS = {
	"ping",
	"registry",
	"fuzz",
	"checkAll",
	"generate",
	"check",
	"open",
	"state",
	"load",
	"export",
	"help",
	"examples",
	"analyze",
	"wiki",
	"loadExample",
	"setTarget",
	"save",
	"toggleProblems",
	"showCode",
	"guiList",
	"guiBuildAll",
	"guiTemplate",
	"workspace",
	"guiOpen",
	"guiState",
	"guiSelect",
	"updateCheck",
	"simulateUpdate",
	"hitbox",
	"explain",
	"notes",
	"settings",
	"share",
	"draft",
	"links",
}

-- Textes piégeux (SPEC §29, §21.6) : une note ou un nom d'élément ne doit jamais casser le code généré
-- (fin de commentaire, crochets longs, guillemets, barre oblique inverse, sauts de ligne, contrôle)
local TRICKY_NOTE = 'à faire : ]] --[[ "guillemets" \'apostrophes\' \\ fin ]=]\nDeuxième ligne\r\n\t-- troisième '
	.. string.char(7)
	.. " é"
local TRICKY_GUI = 'Écran "1"/Bouton \\ ]] %s ]=]\nfin'
local SHARE_PREFIX = "BLOCSFR1:" -- code de partage (SPEC §32)
local DRAFT_SETTING = "BlocsFR_Brouillon" -- brouillons automatiques (SPEC §32, format d'App)
local DRAFT_MAX_ENTRIES = 4 -- (= App : brouillons gardés au plus)
-- Lignes automatiques entre les blocs (SPEC §36) : mêmes règles que Canvas (_collectAutoLinks)
local MESSAGE_SENDERS = {
	ctrl_envoyer_message = true,
	ctrl_envoyer_message_tous = true,
	ctrl_envoyer_message_joueur = true,
	ctrl_envoyer_message_serveur = true,
	tp_minuteur_ecran = true, -- (envoie son message à la fin du minuteur)
}
local MODULE_CALLERS = { mod_appeler = true, mod_resultat = true }
local CANVAS_LINK_MAX = 60 -- (= Canvas LINK_MAX : lignes automatiques + tracées dessinées au plus)
local HITBOX_KEYS = { "largeur", "hauteur", "profondeur", "degats", "distance" }
-- Modèles que la SPEC §22.2 demande au moins (ids de Modeles.lua)
local REQUIRED_MODELES = {
	"piece",
	"brique_mortelle",
	"obby_complet",
	"porte",
	"combat_epee",
	"pnj_ennemi",
	"cinematique",
	"sprint_double_saut",
	"bouton_achat_epee",
	"jour_nuit",
}

---------------------------------------------------------------------------
-- Utilitaires
---------------------------------------------------------------------------

local function truncateUtf8(s, maxBytes)
	if #s <= maxBytes then
		return s
	end
	local cut = maxBytes
	while cut > 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b < 0x80 or b >= 0xC0 then
			break
		end
		cut -= 1
	end
	return string.sub(s, 1, cut) .. "…"
end

local function toStringList(value)
	local out = {}
	if type(value) == "table" then
		for _, v in ipairs(value) do
			table.insert(out, tostring(v))
		end
	elseif value ~= nil then
		table.insert(out, tostring(value))
	end
	return out
end

-- Copie transmissible par une BindableFunction (pas de tables mixtes, pas de fonctions, pas de cycles)
local function sanitize(value, depth, seen)
	local t = typeof(value)
	if t == "nil" or t == "boolean" or t == "string" then
		return value
	elseif t == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return tostring(value)
		end
		return value
	elseif t == "Instance" then
		local ok, fullName = pcall(function()
			return value:GetFullName()
		end)
		if ok then
			return fullName
		end
		return tostring(value)
	elseif t == "table" then
		if depth > 16 or seen[value] then
			return "<…>"
		end
		seen[value] = true
		local count = 0
		for _ in pairs(value) do
			count += 1
		end
		local n = #value
		local out = {}
		if count == n then
			for i = 1, n do
				local clean = sanitize(value[i], depth + 1, seen)
				if clean == nil then
					clean = "nil"
				end
				out[i] = clean
			end
		else
			for k, v in pairs(value) do
				local clean = sanitize(v, depth + 1, seen)
				if clean ~= nil then
					out[tostring(k)] = clean
				end
			end
		end
		seen[value] = nil
		return out
	end
	return tostring(value)
end

local function decodeJson(json)
	if type(json) == "table" then
		return json
	end
	if type(json) ~= "string" or json == "" then
		error("JSON du projet manquant", 0)
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(data) ~= "table" then
		error("JSON invalide : " .. tostring(data), 0)
	end
	return data
end

-- Model est écrit par un autre module : chargé seulement quand on en a besoin
local function getModelModule()
	local moduleScript = script.Parent:FindFirstChild("Model")
	if moduleScript == nil then
		error("module Model introuvable", 0)
	end
	return require(moduleScript)
end

local function getApp(ctx, openIfNeeded)
	local app = nil
	if type(ctx.getApp) == "function" then
		app = ctx.getApp()
	end
	if app == nil and openIfNeeded and type(ctx.openEditor) == "function" then
		ctx.openEditor()
		if type(ctx.getApp) == "function" then
			app = ctx.getApp()
		end
	end
	return app
end

local function currentModel(app)
	local model = app.model
	if model == nil and type(app.getModel) == "function" then
		model = app:getModel()
	end
	return model
end

local function defaultTarget()
	local ok, selected = pcall(function()
		return game:GetService("Selection"):Get()[1]
	end)
	if ok and typeof(selected) == "Instance" then
		return selected
	end
	return workspace
end

---------------------------------------------------------------------------
-- Vérification de la syntaxe d'un code Luau
---------------------------------------------------------------------------

-- "Nom:12: message" -> "ligne 11 : message" (lineOffset = lignes ajoutées avant le code)
local function formatCompileError(message, lineOffset)
	local text = tostring(message)
	local line, rest = string.match(text, "^.-:(%d+):%s*(.*)$")
	if line then
		local n = (tonumber(line) or 0) - lineOffset
		if n < 1 then
			n = 1
		end
		return "ligne " .. n .. " : " .. rest
	end
	return text
end

-- 1re méthode : loadstring (compile sans exécuter). Renvoie nil si indisponible.
local function checkWithLoadstring(code)
	local ls = loadstring
	if type(ls) ~= "function" then
		return nil
	end
	local okCall, fn, err = pcall(ls, code, "=BlocsFR_Code")
	if not okCall then
		return nil -- loadstring() a levé une erreur : indisponible dans ce contexte
	end
	if type(fn) == "function" then
		return { ok = true, method = "loadstring" }
	end
	local text = tostring(err or "")
	local lower = string.lower(text)
	if text == "" or string.find(lower, "not available", 1, true) or string.find(lower, "loadstring", 1, true) then
		return nil
	end
	return { ok = false, err = formatCompileError(text, 0), method = "loadstring" }
end

local checkCounter = 0

local function findRelevant(messages, name)
	local fallback = nil
	for _, message in ipairs(messages) do
		if string.find(message, name, 1, true) then
			if string.find(message, name .. ":%d+:") then
				return message
			end
			if fallback == nil then
				fallback = message
			end
		end
	end
	return fallback
end

-- 2e méthode : ModuleScript sans parent contenant "return function(...) <code> end".
-- Le require compile le code sans l'exécuter ; le vrai message d'erreur arrive par LogService.
local function checkWithModule(code)
	checkCounter += 1
	-- suffixe "_V" : aucun nom n'est le préfixe d'un autre (BlocsFR_1_V / BlocsFR_12_V)
	local name = "BlocsFR_" .. checkCounter .. "_V"
	local moduleScript = Instance.new("ModuleScript")
	moduleScript.Name = name
	local okSource, sourceErr = pcall(function()
		moduleScript.Source = "return function(...)\n" .. code .. "\nend"
	end)
	if not okSource then
		moduleScript:Destroy()
		return { ok = false, err = "impossible d'écrire le code à vérifier : " .. tostring(sourceErr), method = "module" }
	end

	local messages = {}
	local connection = LogService.MessageOut:Connect(function(message)
		if type(message) == "string" and string.find(message, name, 1, true) then
			table.insert(messages, message)
		end
	end)

	local okRequire, requireErr = pcall(require, moduleScript)
	local result
	if okRequire then
		result = { ok = true, method = "module" }
	else
		local found = findRelevant(messages, name)
		local waited = 0
		while found == nil and waited < LOG_WAIT do
			waited += task.wait(0.03)
			found = findRelevant(messages, name)
		end
		local err
		if found then
			err = formatCompileError(found, 1)
		else
			err = formatCompileError(tostring(requireErr), 1)
		end
		result = { ok = false, err = err, method = "module" }
	end

	connection:Disconnect()
	moduleScript:Destroy()
	return result
end

local function syntaxCheck(code)
	if type(code) ~= "string" then
		return { ok = false, err = "aucun code à vérifier" }
	end
	local viaLoadstring = checkWithLoadstring(code)
	if viaLoadstring then
		return viaLoadstring
	end
	return checkWithModule(code)
end

-- Mode « module » : le code doit se terminer par « return Module » (SPEC §20). Renvoie un texte
-- d'erreur, ou nil si tout va bien (ou si le mode n'est pas « module »).
-- NOTE: la vérification de syntaxe accepte ce « return » final : loadstring compile le code comme
-- un bloc, et la méthode ModuleScript le place à la fin du corps de « return function(...) … end ».
local function checkModuleEnding(code, mode)
	if mode ~= "module" or type(code) ~= "string" then
		return nil
	end
	if string.find(code, "\nreturn Module%s*$") == nil then
		return "le script module ne se termine pas par « return Module »"
	end
	return nil
end

---------------------------------------------------------------------------
-- Construction de projets de test (uniquement par l'API de Model, SPEC §6)
---------------------------------------------------------------------------

local function newModel(Model)
	local model = Model.new()
	if model == nil then
		error("Model.new() a renvoyé nil", 0)
	end
	pcall(function()
		model:addVariable("score")
	end)
	return model
end

local function mustCreate(model, defId, x, y)
	local id = model:create(defId, x, y)
	if id == nil then
		error("model:create(« " .. tostring(defId) .. " ») a échoué", 0)
	end
	return id
end

local function mustAttachNext(model, targetId, id)
	if not model:attachNext(targetId, id) then
		error("model:attachNext(" .. tostring(targetId) .. ", " .. tostring(id) .. ") refusé", 0)
	end
end

local function mustAttachSub(model, targetId, slot, id)
	if not model:attachSub(targetId, slot, id) then
		error("model:attachSub(" .. tostring(targetId) .. ", " .. tostring(slot) .. ", " .. tostring(id) .. ") refusé", 0)
	end
end

local function mustAttachInput(model, targetId, inputName, id)
	if not model:attachInput(targetId, inputName, id) then
		error(
			"model:attachInput(" .. tostring(targetId) .. ", " .. tostring(inputName) .. ", " .. tostring(id) .. ") refusé",
			0
		)
	end
end

-- Branche un bloc valeur ; s'il est refusé, il est supprimé (pour ne pas laisser de pile isolée)
local function tryAttachInput(model, targetId, inputName, id)
	local attached = false
	pcall(function()
		if model:attachInput(targetId, inputName, id) then
			attached = true
		end
	end)
	if not attached then
		pcall(function()
			model:delete(id)
		end)
	end
	return attached
end

local function firstExisting(ids)
	for _, id in ipairs(ids) do
		if Registry.get(id) then
			return id
		end
	end
	return nil
end

local function optionCodes(spec)
	local codes = {}
	for _, opt in ipairs(spec.options or {}) do
		if type(opt) == "table" and type(opt[2]) == "string" then
			codes[opt[2]] = true
		end
	end
	return codes
end

-- Bloc valeur à brancher dans une entrée (variante « reporters » du fuzz), ou nil
local function reporterFor(spec)
	local kind = spec.kind
	if kind == "number" then
		return firstExisting({ "op_plus", "dbg_chrono", "val_nombre" })
	elseif kind == "text" or kind == "gui" then
		-- (entrée « gui » : un nom calculé par un bloc valeur, refusé sans dommage si interdit)
		return firstExisting({ "op_joindre", "val_texte" })
	elseif kind == "any" then
		return firstExisting({ "op_joindre", "val_texte", "val_nombre" })
	elseif kind == "boolean" then
		return firstExisting({ "op_non", "val_vrai" })
	elseif kind == "color" then
		return firstExisting({ "val_couleur", "app_couleur_rgb" })
	elseif kind == "dropdown" and spec.acceptReporter == true then
		local codes = optionCodes(spec)
		if codes["joueur"] then
			return firstExisting({ "val_joueur" })
		elseif codes["script.Parent"] then
			return firstExisting({ "val_cet_objet", "monde_objet_nomme" })
		end
		return firstExisting({ "val_texte" })
	end
	return nil
end

local function hasPluggableInputs(def)
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" and reporterFor(spec) ~= nil then
			return true
		end
	end
	return false
end

-- Remplit un corps de bloc C : « afficher » (+ « sortir de la boucle » si c'est une boucle)
local function fillBody(model, def, blockId, slot)
	local first = mustCreate(model, "dbg_afficher", 40, 40)
	mustAttachSub(model, blockId, slot, first)
	if def.loop and Registry.get("ctrl_sortir_boucle") then
		local exitId = mustCreate(model, "ctrl_sortir_boucle", 40, 40)
		mustAttachNext(model, first, exitId)
	end
end

local function plugReporters(model, def, subjectId)
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" then
			local reporterId = reporterFor(spec)
			if reporterId then
				local rid = model:create(reporterId, 600, 40)
				if rid ~= nil then
					tryAttachInput(model, subjectId, spec.name, rid)
				end
			end
		end
	end
end

-- Chapeau qui accueille un bloc non-chapeau : « Définir la fonction » pour les blocs réservés aux
-- scripts modules (« renvoyer » et « paramètre » n'ont de sens que là), sinon « Quand ce script démarre »
local function hostHatFor(def)
	if def.scriptType == "module" and Registry.get(FUNCTION_HAT) then
		return FUNCTION_HAT
	end
	return "evt_demarrage"
end

-- Projet minimal utilisant le bloc def (valeurs par défaut ; withReporters : entrées remplies de blocs valeur).
-- Renvoie model, id du bloc testé, id de l'événement qui le porte (le bloc lui-même pour un événement).
local function buildFor(Model, def, withReporters)
	local model = newModel(Model)
	local shape = def.shape
	local subject
	local hat
	if shape == "hat" then
		subject = mustCreate(model, def.id, 40, 40)
		hat = subject
		local body = mustCreate(model, "dbg_afficher", 40, 160)
		mustAttachNext(model, subject, body)
	elseif shape == "reporter" or shape == "boolean" then
		hat = mustCreate(model, hostHatFor(def), 40, 40)
		subject = mustCreate(model, def.id, 400, 40)
		if shape == "boolean" and Registry.get("ctrl_si") then
			local host = mustCreate(model, "ctrl_si", 40, 160)
			mustAttachNext(model, hat, host)
			mustAttachInput(model, host, "COND", subject)
			local inner = mustCreate(model, "dbg_afficher", 40, 300)
			mustAttachSub(model, host, "DO", inner)
		else
			local host = mustCreate(model, "dbg_afficher", 40, 160)
			mustAttachNext(model, hat, host)
			mustAttachInput(model, host, "VALEUR", subject)
		end
	else
		hat = mustCreate(model, hostHatFor(def), 40, 40)
		subject = mustCreate(model, def.id, 40, 160)
		mustAttachNext(model, hat, subject)
		if shape == "c" or shape == "c2" then
			fillBody(model, def, subject, "DO")
			if shape == "c2" then
				fillBody(model, def, subject, "ELSE")
			end
		end
	end
	if withReporters then
		plugReporters(model, def, subject)
	end
	return model, subject, hat
end

-- Variante « notes » (SPEC §29) : une note sur l'événement, une sur le bloc testé et une note libre,
-- toutes avec un texte piégeux
local function buildWithNotes(Model, def)
	local model, subject, hat = buildFor(Model, def, false)
	local function note(x, y, blockId, couleur)
		local id = model:addNote(x, y, blockId)
		if id == nil then
			error("model:addNote a échoué", 0)
		end
		if not model:setNote(id, { text = TRICKY_NOTE, couleur = couleur }) then
			error("model:setNote a refusé le texte de la note", 0)
		end
	end
	if hat ~= nil and hat ~= subject then
		note(700, 40, hat, "jaune")
	end
	note(700, 160, subject, "vert")
	note(700, 300, nil, "rose")
	return model
end

-- Variante « desactive » (SPEC §32) : le bloc testé est désactivé (un événement désactivé = toute sa pile)
local function buildDisabled(Model, def)
	local model, subject = buildFor(Model, def, false)
	if not model:setDisabled(subject, true) then
		error("model:setDisabled(" .. tostring(subject) .. ") refusé", 0)
	end
	return model
end

local function hasGuiInputs(def)
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" and spec.kind == "gui" then
			return true
		end
	end
	return false
end

-- Variante « noms » (SPEC §21.6) : chaque entrée « gui » reçoit un nom d'écran / d'élément piégeux
local function buildTrickyGuiNames(Model, def)
	local model, subject = buildFor(Model, def, false)
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" and spec.kind == "gui" then
			if not model:setInput(subject, spec.name, TRICKY_GUI) then
				error("model:setInput(« " .. tostring(spec.name) .. " ») refusé", 0)
			end
		end
	end
	return model
end

-- Chapeau seul, sans bloc dessous (chapeaux « emitEmpty », ex. une fonction de module vide)
local function buildEmptyHat(Model, def)
	local model = newModel(Model)
	mustCreate(model, def.id, 40, 40)
	return model
end

-- Fonction de module complète : un paramètre lu, « renvoyer » dans une boucle puis à la fin
local function addModuleFunction(model, x, y)
	if not (Registry.get(FUNCTION_HAT) and Registry.get("mod_renvoyer")) then
		return
	end
	local fnHat = mustCreate(model, FUNCTION_HAT, x, y)
	local last = fnHat
	if Registry.get("mod_parametre") then
		local show = mustCreate(model, "dbg_afficher", x, y + 100)
		mustAttachNext(model, last, show)
		last = show
		local param = mustCreate(model, "mod_parametre", x + 400, y + 100)
		tryAttachInput(model, show, "VALEUR", param)
	end
	if Registry.get("ctrl_repeter") then
		local loop = mustCreate(model, "ctrl_repeter", x, y + 200)
		mustAttachNext(model, last, loop)
		last = loop
		local early = mustCreate(model, "mod_renvoyer", x, y + 260)
		mustAttachSub(model, loop, "DO", early)
	end
	local final = mustCreate(model, "mod_renvoyer", x, y + 400)
	mustAttachNext(model, last, final)
end

-- Projet « tout » : toutes les instructions sous un seul « Quand ce script démarre »,
-- chaque bloc valeur dans un « afficher », et chaque autre événement avec un « afficher ».
local function buildEverything(Model)
	local model = newModel(Model)
	local defs = Registry.all()
	local mainHat = mustCreate(model, "evt_demarrage", 40, 40)
	local last = mainHat
	local function append(id)
		mustAttachNext(model, last, id)
		last = id
	end

	-- Les blocs qui terminent une pile (cap / noNext) vont chacun dans le corps d'une boucle
	local container = nil
	if Registry.get("ctrl_repeter") then
		container = "ctrl_repeter"
	elseif Registry.get("ctrl_si") then
		container = "ctrl_si"
	end

	local terminals = {}
	for _, def in ipairs(defs) do
		local shape = def.shape
		if shape == "stack" or shape == "c" or shape == "c2" or shape == "cap" then
			if shape == "cap" or def.noNext then
				table.insert(terminals, def)
			else
				local id = mustCreate(model, def.id, 40, 200)
				append(id)
				if shape == "c" or shape == "c2" then
					fillBody(model, def, id, "DO")
					if shape == "c2" then
						fillBody(model, def, id, "ELSE")
					end
				end
			end
		elseif shape == "reporter" or shape == "boolean" then
			local host = mustCreate(model, "dbg_afficher", 40, 200)
			append(host)
			local rid = mustCreate(model, def.id, 600, 200)
			tryAttachInput(model, host, "VALEUR", rid)
		end
	end

	local terminalPlaced = false
	for _, def in ipairs(terminals) do
		local id = mustCreate(model, def.id, 40, 200)
		if def.shape == "c" or def.shape == "c2" then
			fillBody(model, def, id, "DO")
			if def.shape == "c2" then
				fillBody(model, def, id, "ELSE")
			end
		end
		if container then
			local box = mustCreate(model, container, 40, 200)
			append(box)
			mustAttachSub(model, box, "DO", id)
		elseif not terminalPlaced then
			append(id) -- sans conteneur, un seul bloc final possible
			terminalPlaced = true
		else
			pcall(function()
				model:delete(id)
			end)
		end
	end

	local y = 400
	for _, def in ipairs(defs) do
		if def.shape == "hat" and def.id ~= "evt_demarrage" then
			local hat = mustCreate(model, def.id, 900, y)
			local body = mustCreate(model, "dbg_afficher", 900, y + 100)
			mustAttachNext(model, hat, body)
			y += 200
		end
	end
	addModuleFunction(model, 1400, 40)
	return model
end

-- Projet « tout » avec un bloc sur trois désactivé et des notes piégeuses (SPEC §29, §32)
local function buildEverythingMixed(Model)
	local model = buildEverything(Model)
	local ids = {}
	for id in pairs(model.blocks) do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return tostring(a) < tostring(b)
	end)
	for i, id in ipairs(ids) do
		if i % 3 == 0 then
			model:setDisabled(id, true)
		elseif i % 7 == 1 then
			local noteId = model:addNote(0, 0, id)
			if noteId ~= nil then
				model:setNote(noteId, { text = TRICKY_NOTE })
			end
		end
	end
	local freeId = model:addNote(0, 0, nil)
	if freeId ~= nil then
		model:setNote(freeId, { text = TRICKY_NOTE })
	end
	return model
end

---------------------------------------------------------------------------
-- Fuzz
---------------------------------------------------------------------------

local function runFuzz()
	local Model = getModelModule()
	local defs = Registry.all()
	local tested = 0
	local failures = {}

	local function record(defId, mode, variant, err, code)
		table.insert(failures, {
			def = defId,
			mode = mode,
			variant = variant,
			err = tostring(err),
			code = code or "",
		})
	end

	local function testModel(defId, variant, model)
		for _, mode in ipairs(MODES) do
			tested += 1
			local okGen, res = pcall(CodeGen.generate, model, mode)
			if not okGen or type(res) ~= "table" or type(res.code) ~= "string" then
				record(defId, mode, variant, "CodeGen.generate a échoué : " .. tostring(res), "")
			else
				local problems = {}
				if type(res.errors) == "table" and #res.errors > 0 then
					table.insert(problems, "erreurs de génération : " .. table.concat(toStringList(res.errors), " | "))
				end
				local check = syntaxCheck(res.code)
				if not check.ok then
					table.insert(problems, "syntaxe : " .. tostring(check.err))
				end
				local moduleProblem = checkModuleEnding(res.code, mode)
				if moduleProblem ~= nil then
					table.insert(problems, moduleProblem)
				end
				if #problems > 0 then
					record(defId, mode, variant, table.concat(problems, " ; "), res.code)
				end
			end
		end
	end

	local function tryBuild(defId, variant, builder, ...)
		local okBuild, modelOrErr = pcall(builder, Model, ...)
		if okBuild then
			testModel(defId, variant, modelOrErr)
		else
			record(defId, "-", variant, "construction du projet : " .. tostring(modelOrErr), "")
		end
	end

	for index, def in ipairs(defs) do
		tryBuild(def.id, "defauts", buildFor, def, false)
		if hasPluggableInputs(def) then
			tryBuild(def.id, "reporters", buildFor, def, true)
		end
		if def.shape == "hat" and def.emitEmpty == true then
			tryBuild(def.id, "vide", buildEmptyHat, def)
		end
		tryBuild(def.id, "notes", buildWithNotes, def)
		tryBuild(def.id, "desactive", buildDisabled, def)
		if hasGuiInputs(def) then
			tryBuild(def.id, "noms", buildTrickyGuiNames, def)
		end
		if index % 10 == 0 then
			task.wait() -- laisse respirer Studio
		end
	end
	tryBuild("*tout*", "tout", buildEverything)
	tryBuild("*tout*", "tout_notes_desactives", buildEverythingMixed)

	return { tested = tested, failures = failures }
end

-- Extrait du code autour de la ligne en erreur (ou du commentaire d'erreur du générateur)
local function excerpt(code, err)
	if type(code) ~= "string" or code == "" then
		return ""
	end
	local lines = string.split(code, "\n")
	local target = tonumber(string.match(tostring(err or ""), "ligne (%d+)"))
	if target == nil then
		for i, line in ipairs(lines) do
			if string.find(line, "[Blocs FR] erreur", 1, true) then
				target = i
				break
			end
		end
	end
	local out = {}
	if target ~= nil then
		local from = math.max(1, target - EXCERPT_RADIUS)
		local to = math.min(#lines, target + EXCERPT_RADIUS)
		for i = from, to do
			local mark = " "
			if i == target then
				mark = ">"
			end
			table.insert(out, mark .. i .. ": " .. lines[i])
		end
	else
		for i = 1, math.min(#lines, 12) do
			table.insert(out, " " .. i .. ": " .. lines[i])
		end
	end
	return truncateUtf8(table.concat(out, "\n"), EXCERPT_MAX)
end

local function summarize(fuzz)
	local failedDefs = {}
	local seen = {}
	for _, f in ipairs(fuzz.failures) do
		if not seen[f.def] then
			seen[f.def] = true
			table.insert(failedDefs, f.def)
		end
	end
	local list = {}
	for i = 1, math.min(#fuzz.failures, MAX_SUMMARY_FAILURES) do
		local f = fuzz.failures[i]
		table.insert(list, {
			def = f.def,
			mode = f.mode,
			variant = f.variant,
			err = truncateUtf8(f.err, 600),
			code = excerpt(f.code, f.err),
		})
	end
	return {
		tested = fuzz.tested,
		failed = #fuzz.failures,
		ok = #fuzz.failures == 0,
		failedDefs = failedDefs,
		registryProblems = #Registry.problems(),
		failures = list,
	}
end

---------------------------------------------------------------------------
-- Commandes
---------------------------------------------------------------------------

local function registryInfo()
	local all = Registry.all()
	local ids = {}
	local hidden = 0
	for _, def in ipairs(all) do
		table.insert(ids, def.id)
		if def.hidden then
			hidden += 1
		end
	end
	local helperCount = 0
	for _ in pairs(Registry.helpers()) do
		helperCount += 1
	end
	return {
		count = #all,
		hidden = hidden,
		helpers = helperCount,
		problems = toStringList(Registry.problems()),
		ids = ids,
	}
end

local function commandGenerate(json, mode)
	local Model = getModelModule()
	local data = decodeJson(json)
	local model, loadWarnings = Model.fromData(data)
	if model == nil then
		error("projet illisible : " .. table.concat(toStringList(loadWarnings), " ; "), 0)
	end
	local res = CodeGen.generate(model, mode or model.mode)
	return {
		code = res.code,
		warnings = res.warnings,
		errors = res.errors,
		hats = res.hats,
		ignored = res.ignored,
		loadWarnings = toStringList(loadWarnings),
	}
end

local function commandOpen(ctx)
	if type(ctx.openEditor) ~= "function" then
		error("ouverture de l'éditeur indisponible", 0)
	end
	local opened = ctx.openEditor()
	return { opened = opened == true }
end

local function commandState(ctx)
	local app = getApp(ctx, false)
	if app == nil then
		error("l'éditeur n'est pas ouvert (commande « open »)", 0)
	end
	if type(app.getDebugState) ~= "function" then
		error("app:getDebugState est indisponible", 0)
	end
	return app:getDebugState()
end

local function commandLoad(ctx, json)
	local Model = getModelModule()
	local data = decodeJson(json)
	local model, loadWarnings = Model.fromData(data)
	if model == nil then
		error("projet illisible : " .. table.concat(toStringList(loadWarnings), " ; "), 0)
	end
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	if type(app.loadModel) ~= "function" then
		error("app:loadModel est indisponible", 0)
	end
	-- Garde la cible (et son script) de l'éditeur si elle existe encore
	local target = app.target
	local scriptInstance = app.scriptInstance
	if typeof(target) ~= "Instance" or target.Parent == nil then
		target = defaultTarget()
		scriptInstance = nil
	end
	if typeof(scriptInstance) ~= "Instance" then
		scriptInstance = nil
	end
	app:loadModel(model, target, scriptInstance)
	local count = nil
	pcall(function()
		count = model:count()
	end)
	return { loaded = true, blocks = count, warnings = toStringList(loadWarnings) }
end

local function commandExport(ctx)
	local app = getApp(ctx, false)
	if app == nil then
		error("l'éditeur n'est pas ouvert (commande « open »)", 0)
	end
	local model = currentModel(app)
	if type(model) ~= "table" or type(model.serialize) ~= "function" then
		error("aucun projet ouvert dans l'éditeur", 0)
	end
	return HttpService:JSONEncode(model:serialize())
end

---------------------------------------------------------------------------
-- Commandes de la phase 2 : exemples, détecteur d'erreurs, wiki
---------------------------------------------------------------------------

-- Modules écrits par d'autres agents : chargés seulement quand on en a besoin
local function requireSibling(name)
	local moduleScript = script.Parent:FindFirstChild(name)
	if moduleScript == nil then
		error("module " .. name .. " introuvable", 0)
	end
	return require(moduleScript)
end

local function isAliveInstance(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, parent = pcall(function()
		return inst.Parent
	end)
	return ok and parent ~= nil
end

local function countSeverities(problems)
	local counts = { erreur = 0, avertissement = 0, conseil = 0 }
	for _, p in ipairs(problems) do
		if type(p) == "table" and counts[p.severity] ~= nil then
			counts[p.severity] += 1
		end
	end
	return counts
end

local function trim(s)
	return (string.gsub(tostring(s or ""), "^%s*(.-)%s*$", "%1"))
end

-- Noms d'un écran (données GuiDoc) au format de ctx.guiNames du détecteur, ou nil
local function guiNamesOf(screenName, docData)
	if type(screenName) ~= "string" or screenName == "" or type(docData) ~= "table" then
		return nil
	end
	local okModule, GuiDoc = pcall(requireSibling, "GuiDoc")
	if not okModule or type(GuiDoc) ~= "table" or type(GuiDoc.fromData) ~= "function" then
		return nil
	end
	local okDoc, doc = pcall(GuiDoc.fromData, docData)
	if not okDoc or type(doc) ~= "table" then
		return nil
	end
	local list = {}
	pcall(function()
		for _, item in ipairs(doc:names(nil)) do
			table.insert(list, { name = item.name, type = item.type })
		end
	end)
	pcall(function()
		doc:destroy()
	end)
	return { screens = { screenName }, elements = { [screenName] = list } }
end

-- Appelle la première méthode de obj qui existe parmi names : appelée (bool), résultat, nom
local function callMethod(obj, names, ...)
	if type(obj) ~= "table" then
		return false, nil, nil
	end
	for _, name in ipairs(names) do
		local fn = obj[name]
		if type(fn) == "function" then
			return true, fn(obj, ...), name
		end
	end
	return false, nil, nil
end

-- Réglages du plugin : ceux de l'éditeur (host d'App) s'il est ouvert, sinon ceux du plugin (ctx.plugin)
local function hostFor(ctx, app)
	if app ~= nil and type(app.host) == "table" and type(app.host.getSetting) == "function" then
		return app.host
	end
	local pluginObject = ctx.plugin
	return {
		getSetting = function(key)
			if pluginObject == nil then
				return nil
			end
			local ok, value = pcall(function()
				return pluginObject:GetSetting(key)
			end)
			if ok then
				return value
			end
			return nil
		end,
		setSetting = function(key, value)
			if pluginObject == nil then
				return
			end
			pcall(function()
				pluginObject:SetSetting(key, value)
			end)
		end,
		getMousePosition = function()
			return Vector2.zero
		end,
	}
end

-- Projet à utiliser : le JSON donné (modèle à soi), sinon le projet ouvert dans l'éditeur (copié si
-- copyOpen). Renvoie model, àSoi (bool : à détruire après usage), app|nil
local function modelFromArgs(ctx, json, copyOpen)
	local Model = getModelModule()
	local app = getApp(ctx, false)
	if json ~= nil then
		local model, warnings = Model.fromData(decodeJson(json))
		if model == nil then
			error("projet illisible : " .. table.concat(toStringList(warnings), " ; "), 0)
		end
		return model, true, app
	end
	if app == nil then
		error("l'éditeur n'est pas ouvert : passe un projet JSON, ou ouvre l'éditeur (commande « open »)", 0)
	end
	local model = currentModel(app)
	if type(model) ~= "table" or type(model.serialize) ~= "function" then
		error("aucun projet ouvert dans l'éditeur", 0)
	end
	if copyOpen then
		local copy, warnings = Model.fromData(model:serialize())
		if copy == nil then
			error("copie du projet impossible : " .. table.concat(toStringList(warnings), " ; "), 0)
		end
		return copy, true, app
	end
	return model, false, app
end

local function destroyModel(model)
	pcall(function()
		model:destroy()
	end)
end

-- Références du wiki (SPEC §26) : chaque bloc, exemple et lien de WikiContent doit exister. WikiContent
-- retire lui-même ce qui manque (liste « retires ») : tout ce qui est retiré ou manquant est un échec.
local function checkWiki(exampleIds)
	local okContent, WikiContent = pcall(requireSibling, "WikiContent")
	if not okContent or type(WikiContent) ~= "table" or type(WikiContent.sections) ~= "table" then
		return { ok = false, erreur = "WikiContent illisible : " .. tostring(WikiContent), manquants = {}, retires = {} }
	end
	local pageIds = {}
	local pages = {}
	for _, section in ipairs(WikiContent.sections) do
		if type(section) == "table" then
			for _, page in ipairs(section.pages or {}) do
				if type(page) == "table" and type(page.id) == "string" then
					if pageIds[page.id] then
						table.insert(pages, { id = page.id, double = true })
					end
					pageIds[page.id] = true
					table.insert(pages, page)
				end
			end
		end
	end
	for _, cat in ipairs(Registry.categories()) do
		pageIds["cat_" .. cat.id] = true
	end
	local missing = {}
	local function miss(pageId, text)
		table.insert(missing, tostring(pageId) .. " : " .. text)
	end
	local count = 0
	for _, page in ipairs(pages) do
		if page.double then
			miss(page.id, "page en double")
		else
			count += 1
			for _, element in ipairs(page.body or {}) do
				if type(element) == "table" then
					if element.kind == "block" and Registry.get(element.def) == nil then
						miss(page.id, "bloc inconnu " .. tostring(element.def))
					elseif element.kind == "example" and not exampleIds[element.id] then
						miss(page.id, "exemple inconnu " .. tostring(element.id))
					elseif element.kind == "link" then
						if element.def ~= nil and Registry.get(element.def) == nil then
							miss(page.id, "lien vers un bloc inconnu " .. tostring(element.def))
						elseif element.example ~= nil and not exampleIds[element.example] then
							miss(page.id, "lien vers un exemple inconnu " .. tostring(element.example))
						elseif element.page ~= nil and not pageIds[element.page] then
							miss(page.id, "lien vers une page inconnue " .. tostring(element.page))
						end
						local anchorExample = nil
						if type(element.anchor) == "string" then
							anchorExample = string.match(element.anchor, "^ex_(.+)$")
						end
						if anchorExample ~= nil and not exampleIds[anchorExample] then
							miss(page.id, "ancre vers un exemple inconnu " .. tostring(anchorExample))
						end
					end
				end
			end
		end
	end
	if not pageIds.nouveautes then
		miss("-", "page « nouveautes » absente (ouverte par la carte de mise à jour et le menu « ? »)")
	end
	if not pageIds[WikiContent.home or "accueil"] then
		miss("-", "page d'accueil absente")
	end
	local retires = toStringList(WikiContent.retires)
	return { ok = #missing == 0 and #retires == 0, pages = count, manquants = missing, retires = retires }
end

-- Chaque exemple : chargé dans un modèle neuf, généré dans les trois modes, syntaxe vérifiée
local function commandExamples()
	local Model = getModelModule()
	local Examples = requireSibling("Examples")
	if type(Examples) ~= "table" then
		error("Examples doit renvoyer une liste", 0)
	end
	local okDetecteur, Detecteur = pcall(requireSibling, "Detecteur")
	if not okDetecteur or type(Detecteur) ~= "table" or type(Detecteur.analyze) ~= "function" then
		Detecteur = nil
	end

	local tested = 0
	local failures = {}
	local summary = {}
	local seenIds = {}
	local function fail(id, mode, err, code)
		table.insert(failures, {
			id = id,
			mode = mode,
			err = truncateUtf8(tostring(err), 600),
			code = excerpt(code or "", err),
		})
	end

	-- Génère model dans les trois modes (syntaxe vérifiée) ; dans ownMode : avertissements du
	-- générateur et détecteur d'erreurs (guiNames = écran du modèle d'interface, facultatif)
	local function testModelModes(id, model, ownMode, guiNames)
		local info = { warnings = {} }
		for _, mode in ipairs(MODES) do
			tested += 1
			local okGen, res = pcall(CodeGen.generate, model, mode)
			if not okGen or type(res) ~= "table" or type(res.code) ~= "string" then
				fail(id, mode, "CodeGen.generate a échoué : " .. tostring(res))
			else
				local problems = {}
				if type(res.errors) == "table" and #res.errors > 0 then
					table.insert(problems, "erreurs de génération : " .. table.concat(toStringList(res.errors), " | "))
				end
				local check = syntaxCheck(res.code)
				if not check.ok then
					table.insert(problems, "syntaxe : " .. tostring(check.err))
				end
				local moduleProblem = checkModuleEnding(res.code, mode)
				if moduleProblem ~= nil then
					table.insert(problems, moduleProblem)
				end
				if #problems > 0 then
					fail(id, mode, table.concat(problems, " ; "), res.code)
				end
				if mode == ownMode then
					info.warnings = toStringList(res.warnings)
					info.hats = res.hats
					info.disabled = res.disabled
					if Detecteur ~= nil then
						local okAnalyze, found = pcall(Detecteur.analyze, model, {
							mode = mode,
							target = nil,
							code = res.code,
							guiNames = guiNames,
						})
						local errs = {}
						local warns = {}
						if okAnalyze and type(found) == "table" then
							for _, p in ipairs(found) do
								if type(p) == "table" and p.severity == "erreur" then
									table.insert(errs, tostring(p.title) .. " " .. tostring(p.message))
								elseif type(p) == "table" and p.severity == "avertissement" then
									table.insert(warns, tostring(p.title))
								end
							end
						else
							table.insert(errs, "Detecteur.analyze a échoué : " .. tostring(found))
						end
						info.detecteurErreurs = errs
						info.detecteurAvertissements = warns
					end
				end
			end
		end
		return info
	end

	for index, entry in ipairs(Examples) do
		local id = "#" .. index
		if type(entry) == "table" and type(entry.id) == "string" and entry.id ~= "" then
			id = entry.id
		end
		if type(entry) ~= "table" then
			fail(id, "-", "entrée invalide (table attendue)")
		elseif type(entry.data) ~= "table" then
			fail(id, "-", "champ « data » manquant")
		else
			if seenIds[id] then
				fail(id, "-", "id en double")
			end
			seenIds[id] = true
			for _, field in ipairs({ "id", "title", "description" }) do
				if type(entry[field]) ~= "string" or entry[field] == "" then
					fail(id, "-", "champ « " .. field .. " » manquant")
				end
			end
			if not VALID_MODES[entry.mode] then
				fail(id, "-", "mode invalide : " .. tostring(entry.mode))
			end
			local okLoad, model, loadWarnings = pcall(Model.fromData, entry.data)
			if not okLoad or type(model) ~= "table" then
				fail(id, "-", "Model.fromData : " .. tostring(model))
			else
				for _, w in ipairs(toStringList(loadWarnings)) do
					fail(id, "chargement", w)
				end
				local blocks = model:count()
				if blocks == 0 then
					fail(id, "-", "aucun bloc")
				end
				local ownMode = "server"
				if VALID_MODES[entry.mode] then
					ownMode = entry.mode
				end
				local info = testModelModes(id, model, ownMode, nil)
				info.id = id
				info.title = tostring(entry.title or "")
				info.mode = ownMode
				info.blocks = blocks
				pcall(function()
					info.notes = #model:noteIds()
					info.blocsDesactives = #model:disabledIds()
				end)
				table.insert(summary, info)
				pcall(function()
					model:destroy()
				end)
			end
		end
		if index % 4 == 0 then
			task.wait() -- laisse respirer Studio
		end
	end

	-- Blocs des modèles d'interface (SPEC §21.5) : script local, noms de l'écran du modèle connus
	local templates = {}
	local okTemplates, GuiTemplates = pcall(requireSibling, "GuiTemplates")
	if not okTemplates or type(GuiTemplates) ~= "table" or type(GuiTemplates.list) ~= "function" then
		fail("interface", "-", "GuiTemplates indisponible : " .. tostring(GuiTemplates))
	else
		local okList, list = pcall(GuiTemplates.list)
		if not okList or type(list) ~= "table" then
			fail("interface", "-", "GuiTemplates.list : " .. tostring(list))
			list = {}
		end
		for _, entry in ipairs(list) do
			local id = "interface:" .. tostring(entry.id)
			if type(entry.blocs) ~= "table" then
				table.insert(templates, { id = id, title = entry.title, screen = entry.screen, blocks = 0 })
			else
				if entry.blocs.mode ~= nil and entry.blocs.mode ~= "local" then
					fail(id, "-", "les blocs d'un écran doivent être en mode local (" .. tostring(entry.blocs.mode) .. ")")
				end
				local okLoad, model, loadWarnings = pcall(Model.fromData, entry.blocs)
				if not okLoad or type(model) ~= "table" then
					fail(id, "-", "Model.fromData : " .. tostring(model))
				else
					for _, w in ipairs(toStringList(loadWarnings)) do
						fail(id, "chargement", w)
					end
					local info = testModelModes(id, model, "local", guiNamesOf(entry.screen, entry.doc))
					info.id = id
					info.title = tostring(entry.title or "")
					info.screen = entry.screen
					info.blocks = model:count()
					table.insert(templates, info)
					pcall(function()
						model:destroy()
					end)
				end
			end
		end
	end
	task.wait()

	-- Palette « Modèles » (SPEC §22.2) : champs, nombre de blocs, code dans leur propre mode
	local modeles = {}
	local okModeles, Modeles = pcall(requireSibling, "Modeles")
	if not okModeles or type(Modeles) ~= "table" or type(Modeles.list) ~= "function" then
		fail("modeles", "-", "Modeles indisponible : " .. tostring(Modeles))
	else
		local okList, list = pcall(Modeles.list)
		if not okList or type(list) ~= "table" then
			fail("modeles", "-", "Modeles.list : " .. tostring(list))
			list = {}
		end
		local present = {}
		for _, entry in ipairs(list) do
			local id = "modele:" .. tostring(entry.id)
			present[entry.id] = true
			for _, field in ipairs({ "id", "title", "description" }) do
				if type(entry[field]) ~= "string" or entry[field] == "" then
					fail(id, "-", "champ « " .. field .. " » manquant")
				end
			end
			if not VALID_MODES[entry.mode] then
				fail(id, "-", "mode invalide : " .. tostring(entry.mode))
			end
			if type(entry.colors) ~= "table" or #entry.colors == 0 then
				fail(id, "-", "couleurs d'aperçu manquantes")
			end
			-- modèle d'écran : son modèle d'interface doit exister (App le pose avec insertTemplate)
			if entry.ecran ~= nil then
				local template = nil
				if okTemplates and type(GuiTemplates) == "table" and type(GuiTemplates.get) == "function" then
					local okGet, got = pcall(GuiTemplates.get, entry.ecran)
					if okGet then
						template = got
					end
				end
				if type(template) ~= "table" then
					fail(id, "-", "modèle d'interface introuvable : " .. tostring(entry.ecran))
				end
				if entry.mode ~= "local" then
					fail(id, "-", "un modèle d'écran doit être en mode local (" .. tostring(entry.mode) .. ")")
				end
			end
			local okLoad, model, loadWarnings = pcall(Model.fromData, entry.data)
			if not okLoad or type(model) ~= "table" then
				fail(id, "-", "Model.fromData : " .. tostring(model))
			else
				for _, w in ipairs(toStringList(loadWarnings)) do
					fail(id, "chargement", w)
				end
				local count = model:count()
				if count ~= entry.count then
					fail(id, "-", "count = " .. tostring(entry.count) .. " mais " .. tostring(count) .. " blocs chargés")
				end
				local mode = "server"
				if VALID_MODES[entry.mode] then
					mode = entry.mode
				end
				tested += 1
				local okGen, res = pcall(CodeGen.generate, model, mode)
				if not okGen or type(res) ~= "table" or type(res.code) ~= "string" then
					fail(id, mode, "CodeGen.generate a échoué : " .. tostring(res))
				else
					local check = syntaxCheck(res.code)
					if not check.ok then
						fail(id, mode, "syntaxe : " .. tostring(check.err), res.code)
					end
				end
				local notes = 0
				pcall(function()
					notes = #model:noteIds()
				end)
				table.insert(modeles, {
					id = entry.id,
					title = entry.title,
					mode = entry.mode,
					count = count,
					notes = notes,
					subtitle = entry.subtitle,
					ecran = entry.ecran,
				})
				pcall(function()
					model:destroy()
				end)
			end
		end
		for _, required in ipairs(REQUIRED_MODELES) do
			if not present[required] then
				fail("modeles", "-", "modèle demandé par la SPEC absent : " .. required)
			end
		end
		-- Modeles.get renvoie une copie neuve (la modifier ne change pas la suivante)
		if type(Modeles.get) == "function" and list[1] ~= nil then
			local okGet, a = pcall(Modeles.get, list[1].id)
			local okGet2, b = pcall(Modeles.get, list[1].id)
			if not okGet or not okGet2 or type(a) ~= "table" or type(b) ~= "table" then
				fail("modeles", "-", "Modeles.get(" .. tostring(list[1].id) .. ") a échoué")
			elseif a.data == b.data then
				fail("modeles", "-", "Modeles.get ne renvoie pas une copie neuve des données")
			end
		end
	end

	-- Wiki : références des pages (blocs, exemples, liens)
	local wiki = checkWiki(seenIds)
	for _, text in ipairs(wiki.manquants or {}) do
		fail("wiki", "-", text)
	end
	for _, text in ipairs(wiki.retires or {}) do
		fail("wiki", "-", "retiré par WikiContent : " .. text)
	end
	if wiki.erreur ~= nil then
		fail("wiki", "-", wiki.erreur)
	end

	return {
		count = #Examples,
		tested = tested,
		ok = #failures == 0,
		failures = failures,
		examples = summary,
		guiTemplates = templates,
		modeles = modeles,
		wiki = wiki,
	}
end

-- Detecteur.analyze sur le projet ouvert dans l'éditeur
local function commandAnalyze(ctx)
	local app = getApp(ctx, false)
	if app == nil then
		error("l'éditeur n'est pas ouvert (commande « open »)", 0)
	end
	local model = currentModel(app)
	if type(model) ~= "table" then
		error("aucun projet ouvert dans l'éditeur", 0)
	end
	local Detecteur = requireSibling("Detecteur")
	if type(Detecteur) ~= "table" or type(Detecteur.analyze) ~= "function" then
		error("Detecteur.analyze est indisponible", 0)
	end
	local mode = "server"
	if VALID_MODES[model.mode] then
		mode = model.mode
	end
	-- Résultat complet de CodeGen (comme l'éditeur) : erreurs de génération, « Script trop gros »
	-- et bloc d'une erreur de compilation sont aussi signalés
	local generated = nil
	local okGen, res = pcall(CodeGen.generate, model, mode)
	if okGen and type(res) == "table" and type(res.code) == "string" then
		generated = res
	end
	local target = nil
	if isAliveInstance(app.target) then
		target = app.target
	end
	local problems = Detecteur.analyze(model, { mode = mode, target = target, generated = generated })
	if type(problems) ~= "table" then
		problems = {}
	end
	local editor = nil
	if type(app.getProblems) == "function" then
		local okEditor, list = pcall(app.getProblems, app)
		if okEditor then
			editor = list
		end
	end
	return {
		count = #problems,
		counts = countSeverities(problems),
		problems = problems,
		editor = editor,
	}
end

local function commandWiki(ctx, pageId, defId)
	if type(ctx.openWiki) ~= "function" then
		error("ouverture du wiki indisponible", 0)
	end
	local opened = ctx.openWiki(pageId, defId)
	return { opened = opened ~= false }
end

local function commandLoadExample(ctx, exampleId)
	if type(exampleId) ~= "string" or exampleId == "" then
		error("id d'exemple manquant (ex. :Invoke(\"loadExample\", \"porte\"))", 0)
	end
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	if type(app.loadExample) ~= "function" then
		error("app:loadExample est indisponible", 0)
	end
	local loaded, message = app:loadExample(exampleId)
	local state = nil
	if type(app.getDebugState) == "function" then
		local okState, result = pcall(app.getDebugState, app)
		if okState then
			state = result
		end
	end
	return { loaded = loaded == true, message = message, state = state }
end

-- "setTarget", "Workspace.Brique" : change la cible de l'éditeur (tests automatiques)
local function commandSetTarget(ctx, path)
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	local inst = game
	for segment in string.gmatch(tostring(path or ""), "[^%.]+") do
		local child = inst:FindFirstChild(segment)
		if child == nil and inst == game then
			local okService, service = pcall(function()
				return game:GetService(segment)
			end)
			if okService then
				child = service
			end
		end
		if child == nil then
			error("objet introuvable : " .. tostring(path), 0)
		end
		inst = child
	end
	app.target = inst
	app.scriptInstance = nil
	pcall(function()
		app:_updateTopBar()
		app:_rebuildTestProblems()
		app:_scheduleAnalysis(0.05)
	end)
	return { target = inst:GetFullName() }
end

-- "save" : enregistre comme le bouton « Enregistrer »
local function commandSave(ctx)
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	local saved = app:save()
	local scriptPath = nil
	if typeof(app.scriptInstance) == "Instance" then
		scriptPath = app.scriptInstance:GetFullName()
	end
	local state = nil
	pcall(function()
		state = app:getDebugState()
	end)
	return { saved = saved == true, script = scriptPath, state = state }
end

---------------------------------------------------------------------------
-- Version 2.1.0 : Studio d'interface (SPEC §21.9)
---------------------------------------------------------------------------

-- Le Studio d'interface de l'éditeur (GuiEditor), ou nil
local function guiEditorOf(app)
	if type(app) ~= "table" then
		return nil
	end
	local called, editor = callMethod(app, { "getGuiEditor", "getInterfaceEditor" })
	if called and type(editor) == "table" then
		return editor
	end
	for _, key in ipairs({ "guiEditor", "guieditor", "interfaceEditor", "gui" }) do
		local value = app[key]
		if type(value) == "table" and (type(value.openScreen) == "function" or type(value.getDoc) == "function") then
			return value
		end
	end
	return nil
end

local function guiStateOf(app)
	local state = { editorOpen = app ~= nil }
	if app ~= nil then
		local called, workspaceName = callMethod(app, { "getWorkspace" })
		if called then
			state.workspace = workspaceName
		end
		local editor = guiEditorOf(app)
		state.studioDisponible = editor ~= nil
		if editor ~= nil and type(editor.getDebugState) == "function" then
			local ok, result = pcall(function()
				return editor:getDebugState()
			end)
			if ok then
				state.studio = result
			else
				state.studioErreur = tostring(result)
			end
		end
	end
	local okNames, names = pcall(function()
		return requireSibling("GuiStorage").allNames().screens
	end)
	if okNames then
		state.screens = names
	end
	return state
end

-- Chaque modèle d'interface : ScreenGui complet sans parent (+ applyScale 0,5), aperçu, blocs (local)
local function commandGuiBuildAll()
	local GuiTemplates = requireSibling("GuiTemplates")
	local GuiDoc = requireSibling("GuiDoc")
	local GuiBuild = requireSibling("GuiBuild")
	local Model = getModelModule()
	local built = 0
	local errors = {}
	local templates = {}
	local list = GuiTemplates.list()
	for index, entry in ipairs(list) do
		local id = tostring(entry.id)
		local info = { id = id, title = entry.title, screen = entry.screen }
		local function err(text)
			table.insert(errors, id .. " : " .. tostring(text))
		end
		local doc, docWarnings = GuiDoc.fromData(entry.doc)
		for _, w in ipairs(toStringList(docWarnings)) do
			err("document : " .. w)
		end
		if doc == nil then
			err("document illisible")
		else
			local names = doc:names(nil)
			info.elements = #names
			local okSg, sg = pcall(GuiBuild.buildScreenGui, doc)
			if not okSg or typeof(sg) ~= "Instance" then
				err("buildScreenGui : " .. tostring(sg))
			else
				local racine = sg:FindFirstChild(GuiBuild.ROOT_NAME)
				if racine == nil then
					err("Racine absente du ScreenGui")
				else
					local okScale, scaleErr = pcall(GuiBuild.applyScale, racine, 0.5)
					if not okScale then
						err("applyScale(0,5) : " .. tostring(scaleErr))
					end
					info.objets = #racine:GetDescendants()
				end
				sg:Destroy()
				built += 1
			end
			-- Aperçu de l'éditeur (k = 0,5) : chaque élément du document doit être construit
			local okBuild, result = pcall(GuiBuild.build, doc, nil, { scale = 0.5, editor = true })
			if not okBuild or type(result) ~= "table" then
				err("build (aperçu) : " .. tostring(result))
			else
				for _, e in ipairs(result.errors or {}) do
					err(e)
				end
				local missing = {}
				for _, item in ipairs(names) do
					if type(result.byName) ~= "table" or result.byName[item.name] == nil then
						table.insert(missing, tostring(item.name))
					end
				end
				if #missing > 0 then
					err("éléments non construits : " .. table.concat(missing, ", "))
				end
				if typeof(result.racine) == "Instance" then
					result.racine:Destroy()
				end
			end
			pcall(function()
				doc:destroy()
			end)
		end
		-- Blocs de l'écran : compilés en script local
		if type(entry.blocs) == "table" then
			local model, loadWarnings = Model.fromData(entry.blocs)
			for _, w in ipairs(toStringList(loadWarnings)) do
				err("blocs : " .. w)
			end
			info.blocs = model:count()
			local okGen, res = pcall(CodeGen.generate, model, "local")
			if not okGen or type(res) ~= "table" or type(res.code) ~= "string" then
				err("CodeGen.generate : " .. tostring(res))
			else
				if type(res.errors) == "table" and #res.errors > 0 then
					err("génération : " .. table.concat(toStringList(res.errors), " | "))
				end
				local check = syntaxCheck(res.code)
				info.codeOk = check.ok == true
				if not check.ok then
					err("syntaxe : " .. tostring(check.err))
				end
			end
			destroyModel(model)
		end
		table.insert(templates, info)
		if index % 2 == 0 then
			task.wait() -- laisse respirer Studio
		end
	end
	return { ok = #errors == 0, built = built, total = #list, errors = errors, templates = templates }
end

local commandGuiOpen

-- Enregistre un modèle d'interface dans StarterGui (nom libre, « Menu 2 »…) avec le script de ses blocs
local function commandGuiTemplate(ctx, templateId, openAfter)
	if type(templateId) ~= "string" or templateId == "" then
		error("id de modèle d'interface manquant (menu, hud, boutique, dialogue, annonces, chargement, parametres, victoire)", 0)
	end
	local GuiTemplates = requireSibling("GuiTemplates")
	local GuiStorage = requireSibling("GuiStorage")
	local GuiDoc = requireSibling("GuiDoc")
	local first = GuiTemplates.get(templateId)
	if first == nil then
		error("modèle d'interface inconnu : " .. templateId, 0)
	end
	local name = GuiStorage.freeName(first.screen)
	local entry = GuiTemplates.get(templateId, name)
	if entry == nil then
		error("modèle d'interface impossible à construire : " .. templateId, 0)
	end
	local doc, docWarnings = GuiDoc.fromData(entry.doc)
	if doc == nil then
		error("document illisible : " .. table.concat(toStringList(docWarnings), " ; "), 0)
	end
	local screenGui, saveErr = GuiStorage.save(doc, nil)
	pcall(function()
		doc:destroy()
	end)
	if screenGui == nil then
		error(tostring(saveErr), 0)
	end
	local scriptPath = nil
	local warnings = {}
	if type(entry.blocs) == "table" then
		local Model = getModelModule()
		local Storage = requireSibling("Storage")
		local model, loadWarnings = Model.fromData(entry.blocs)
		pcall(function()
			model:setMode("local")
		end)
		for _, w in ipairs(toStringList(loadWarnings)) do
			table.insert(warnings, w)
		end
		local scriptInst, scriptErr, scriptWarnings = Storage.save(model, screenGui, nil)
		destroyModel(model)
		if scriptInst == nil then
			error("écran « " .. screenGui.Name .. " » enregistré, mais pas ses blocs : " .. tostring(scriptErr), 0)
		end
		scriptPath = scriptInst:GetFullName()
		for _, w in ipairs(toStringList(scriptWarnings)) do
			table.insert(warnings, w)
		end
	end
	local result = {
		screen = screenGui.Name,
		path = screenGui:GetFullName(),
		script = scriptPath,
		warnings = warnings,
		docWarnings = toStringList(docWarnings),
	}
	if openAfter == true then
		local okOpen, opened = pcall(commandGuiOpen, ctx, screenGui.Name)
		if okOpen then
			result.opened = opened
		else
			result.openError = tostring(opened)
		end
	end
	return result
end

local function commandWorkspace(ctx, name)
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	if name ~= nil then
		if name ~= "blocs" and name ~= "interface" then
			error("espace de travail inconnu : " .. tostring(name) .. " (« blocs » ou « interface »)", 0)
		end
		local called = callMethod(app, { "setWorkspace" }, name)
		if not called then
			error("app:setWorkspace est indisponible", 0)
		end
	end
	local called, current = callMethod(app, { "getWorkspace" })
	if not called then
		current = nil
	end
	return { workspace = current }
end

commandGuiOpen = function(ctx, screenName)
	if type(screenName) ~= "string" or screenName == "" then
		error('nom d\'écran manquant (ex. :Invoke("guiOpen", "Menu"))', 0)
	end
	local GuiStorage = requireSibling("GuiStorage")
	local screenGui = GuiStorage.find(screenName)
	if screenGui == nil then
		local screens = {}
		pcall(function()
			screens = GuiStorage.allNames().screens
		end)
		error("écran introuvable dans StarterGui : « " .. screenName .. " » (écrans : " .. table.concat(screens, ", ") .. ")", 0)
	end
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	local opened = false
	local openErr = nil
	-- App:openGuiScreen(screenGui) : ouvre l'écran sans rien demander (fait pour cette commande) ; sinon
	-- App:openScreen(screenGui) : si l'écran ouvert a des changements non enregistrés, App demande d'abord
	-- (une fenêtre s'ouvre, rien n'est perdu) et renvoie false.
	local called, result = callMethod(app, { "openGuiScreen", "openScreen", "openInterfaceScreen" }, screenGui)
	if called then
		opened = result ~= false
		if not opened then
			openErr = "pas ouvert (l'écran en cours n'est peut-être pas enregistré : une fenêtre le demande)"
		end
	else
		callMethod(app, { "setWorkspace" }, "interface")
		local editor = guiEditorOf(app)
		if editor == nil or type(editor.openScreen) ~= "function" then
			error("le Studio d'interface est indisponible (app:openGuiScreen ou editor:openScreen)", 0)
		end
		local ok, err = editor:openScreen(screenGui)
		opened = ok ~= false
		openErr = err
	end
	return { opened = opened, error = openErr, state = guiStateOf(app) }
end

local function commandGuiSelect(ctx, elementName)
	if type(elementName) ~= "string" or elementName == "" then
		error('nom d\'élément manquant (ex. :Invoke("guiSelect", "Jouer"))', 0)
	end
	local app = getApp(ctx, false)
	if app == nil then
		error("l'éditeur n'est pas ouvert (commande « open »)", 0)
	end
	local editor = guiEditorOf(app)
	if editor == nil then
		error("le Studio d'interface est indisponible", 0)
	end
	local doc = nil
	if type(editor.getDoc) == "function" then
		doc = editor:getDoc()
	end
	if type(doc) ~= "table" or type(doc.findByName) ~= "function" then
		error("aucun écran ouvert dans le Studio d'interface (commande « guiOpen »)", 0)
	end
	local name = elementName
	local screenPart, elementPart = string.match(elementName, "^([^/]+)/(.+)$")
	if screenPart ~= nil and screenPart == doc.name then
		name = elementPart
	end
	local id = doc:findByName(name)
	if id == nil then
		error("élément introuvable dans l'écran « " .. tostring(doc.name) .. " » : « " .. elementName .. " »", 0)
	end
	if type(editor.selectElement) ~= "function" then
		error("editor:selectElement est indisponible", 0)
	end
	editor:selectElement(id)
	local selection = nil
	if type(editor.getSelection) == "function" then
		selection = editor:getSelection()
	end
	return { id = id, selection = selection, state = guiStateOf(app) }
end

---------------------------------------------------------------------------
-- Version 2.1.0 : mise à jour (SPEC §25)
---------------------------------------------------------------------------

local function commandUpdateCheck(ctx)
	local MiseAJour = requireSibling("MiseAJour")
	local app = getApp(ctx, false)
	local info = MiseAJour.check(true, hostFor(ctx, app))
	return { info = info, version = MiseAJour.VERSION, carteVisible = MiseAJour.isNoticeVisible() }
end

-- "simulateUpdate", "9.9.9" : carte « Mise à jour disponible » ; "apres" : carte « a été mis à jour ».
-- Rien n'est retenu (« Plus tard » n'écrit aucun réglage pour une version de test).
local function commandSimulateUpdate(ctx, version)
	local MiseAJour = requireSibling("MiseAJour")
	local app = getApp(ctx, true)
	if app == nil then
		error("impossible d'ouvrir l'éditeur", 0)
	end
	local realHost = hostFor(ctx, app)
	local testHost = {
		getSetting = realHost.getSetting,
		setSetting = function() end,
		sessionStart = realHost.sessionStart,
	}
	-- (pas de getLayer : MiseAJour prend celui qu'App lui a donné au démarrage, la vraie place de la carte)
	local deps = {
		host = testHost,
		openWiki = function(pageId)
			if type(ctx.openWiki) == "function" then
				ctx.openWiki(pageId, nil)
			end
		end,
	}
	local info
	if version == "apres" or version == "mis_a_jour" then
		info = { status = "mis_a_jour", current = MiseAJour.VERSION }
	else
		info = {
			status = "nouvelle",
			latest = tostring(version or "9.9.9"),
			notes = "Version de test (DevBridge) : rien n'est installé.",
			source = "url",
			current = MiseAJour.VERSION,
		}
	end
	local shown = MiseAJour.showNotice(info, deps)
	if not shown then
		-- MiseAJour n'a pas été démarré par App : calque sous les glissements, sinon celui des dialogues
		deps.getLayer = function()
			return app.problemsLayer or app.dialogLayer
		end
		shown = MiseAJour.showNotice(info, deps)
	end
	return { shown = shown == true, visible = MiseAJour.isNoticeVisible(), info = info }
end

---------------------------------------------------------------------------
-- Version 2.1.0 : hitbox, explication, notes (SPEC §27-§29)
---------------------------------------------------------------------------

-- Premier bloc de combat pris en charge par le prévisualiseur (ordre des ids), ou nil
local function firstHitboxBlock(HitboxPreview, model)
	if type(model) ~= "table" or type(model.blocks) ~= "table" then
		return nil
	end
	local ids = {}
	for id, block in pairs(model.blocks) do
		if type(block) == "table" and type(block.def) == "string" and block.def ~= "libre" and HitboxPreview.supports(block.def) then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		return tostring(a) < tostring(b)
	end)
	return ids[1]
end

local function commandHitbox(ctx, blockId, options)
	local HitboxPreview = requireSibling("HitboxPreview")
	if type(options) == "string" then
		options = decodeJson(options)
	end
	if type(options) ~= "table" then
		options = {}
	end
	local open = options.ouvrir == true
	local app = getApp(ctx, open)
	local model = nil
	local ownModel = false
	if options.json ~= nil then
		local Model = getModelModule()
		model = Model.fromData(decodeJson(options.json))
		ownModel = true
	elseif app ~= nil then
		model = currentModel(app)
	end
	if blockId == "libre" then
		blockId = nil
	elseif blockId == nil then
		blockId = firstHitboxBlock(HitboxPreview, model)
	elseif type(model) ~= "table" or type(model.get) ~= "function" or model:get(blockId) == nil then
		if ownModel then
			destroyModel(model)
		end
		error("bloc introuvable : " .. tostring(blockId), 0)
	end
	local params = HitboxPreview.readBlock(model, blockId)

	local layer = nil
	local preview
	if open then
		if app == nil or typeof(app.dialogLayer) ~= "Instance" then
			error("impossible d'ouvrir l'éditeur (calque des dialogues introuvable)", 0)
		end
		preview = HitboxPreview.open(app.dialogLayer, {
			host = app.host,
			dialogs = app.dialogs,
			model = model,
			blockId = blockId,
			onApply = function(values)
				if type(values) ~= "table" or blockId == nil then
					return
				end
				for name, value in pairs(values) do
					pcall(function()
						model:setInput(blockId, name, value)
					end)
				end
				pcall(function()
					model:commit("hitbox")
				end)
			end,
		})
	else
		-- Sans affichage : calque caché (dans l'éditeur s'il est ouvert, pour avoir une vraie taille)
		layer = Instance.new("Frame")
		layer.Name = "BlocsFR_TestHitbox"
		layer.BackgroundTransparency = 1
		layer.Size = UDim2.fromScale(1, 1)
		layer.Visible = false
		if app ~= nil and typeof(app.dialogLayer) == "Instance" then
			layer.Parent = app.dialogLayer
		end
		preview = HitboxPreview.open(layer, { host = hostFor(ctx, app), model = model, blockId = blockId })
	end
	local function cleanup()
		if not open then
			pcall(function()
				preview:close()
			end)
			pcall(function()
				layer:Destroy()
			end)
			if ownModel then
				destroyModel(model)
			end
		end
	end
	if type(preview) ~= "table" or (type(preview.isOpen) == "function" and not preview:isOpen()) then
		cleanup()
		error("le prévisualiseur de hitbox n'a pas pu s'ouvrir (voir la sortie)", 0)
	end

	local okRun, hitOrErr = pcall(function()
		for _, key in ipairs(HITBOX_KEYS) do
			local v = tonumber(options[key])
			if v ~= nil then
				preview:_setValue(key, v)
			end
		end
		-- Sans affichage, l'ennemi ne bouge pas (résultat reproductible) sauf si on le demande
		if options.bouge ~= nil or not open then
			preview.values.bouge = options.bouge == true
			pcall(function()
				preview:_updateToggle(false)
			end)
			pcall(function()
				preview:_updateResult()
			end)
		end
		return preview:simulate()
	end)
	local state = nil
	pcall(function()
		state = preview:getDebugState()
	end)
	cleanup()
	if not okRun then
		error("simulation : " .. tostring(hitOrErr), 0)
	end
	local hit = hitOrErr == true
	state = state or {}
	return {
		hit = hit,
		resultat = hit and "TOUCHÉ ! LET'S GO" or "RATÉ… BOF",
		blockId = blockId,
		kind = params.kind,
		params = state.params,
		prediction = { touche = state.predicted, chance = state.chance },
		distance = state.distance,
		bouge = state.bouge,
		opened = open,
		bloc = params,
		state = state,
	}
end

local function commandExplain(ctx, json, mode)
	local Explication = requireSibling("Explication")
	if mode ~= nil and not VALID_MODES[mode] then
		error("mode inconnu : " .. tostring(mode) .. " (server, local ou module)", 0)
	end
	local model, own, app = modelFromArgs(ctx, json, false)
	local target = nil
	if app ~= nil and json == nil and isAliveInstance(app.target) then
		target = app.target
	end
	local okExplain, result = pcall(Explication.explain, model, { mode = mode, target = target })
	if own then
		destroyModel(model)
	end
	if not okExplain or type(result) ~= "table" then
		error("Explication.explain : " .. tostring(result), 0)
	end
	local lines = {}
	for _, s in ipairs(result.scripts or {}) do
		table.insert(lines, tostring(s.title))
		for i, step in ipairs(s.steps or {}) do
			local depth = tonumber(step.depth) or 0
			table.insert(lines, string.rep("  ", depth + 1) .. i .. ". " .. tostring(step.text))
		end
	end
	for _, w in ipairs(result.warnings or {}) do
		table.insert(lines, tostring(w.text))
	end
	return { lignes = lines, resultat = result }
end

-- Petit projet de démonstration : « Quand ce script démarre » + « afficher … dans la sortie »
local function demoModel()
	local Model = getModelModule()
	local model = Model.new()
	local hat = mustCreate(model, "evt_demarrage", 40, 40)
	local show = mustCreate(model, "dbg_afficher", 40, 140)
	mustAttachNext(model, hat, show)
	return model
end

-- Premier bloc sous le premier événement (sinon le premier bloc de premier niveau), ou nil
local function firstStatement(model)
	local top = model.tops and model.tops[1]
	if top == nil then
		return nil
	end
	local block = model:get(top)
	if type(block) == "table" and block.next ~= nil then
		return block.next
	end
	return top
end

local function commandNotes(ctx, text, blockId, json)
	local model, app
	local okArgs, a, _, c = pcall(modelFromArgs, ctx, json, true)
	if okArgs then
		model, app = a, c
	elseif json == nil then
		model = demoModel() -- ni projet ouvert, ni JSON
	else
		error(a, 0)
	end
	local function fail(message)
		destroyModel(model)
		error(message, 0)
	end
	if text == nil then
		text = "Ici, le script dit bonjour.\nDeuxième ligne de la note."
	end
	local target = nil
	if blockId ~= nil and blockId ~= "libre" then
		if model:get(blockId) == nil then
			fail("bloc introuvable : " .. tostring(blockId))
		end
		target = blockId
	elseif blockId == nil then
		target = firstStatement(model)
	end
	local noteId = model:addNote(0, 0, target)
	if noteId == nil then
		fail("model:addNote a échoué")
	end
	local accepted = model:setNote(noteId, { text = tostring(text) })
	local mode = "server"
	if VALID_MODES[model.mode] then
		mode = model.mode
	end
	local res = CodeGen.generate(model, mode, { notes = true })
	local resOff = CodeGen.generate(model, mode, { notes = false })
	local code = tostring(res.code or "")
	local lines = string.split(code, "\n")
	local noteLines = {}
	local collecting = false
	for i, line in ipairs(lines) do
		local stripped = trim(line)
		if string.sub(stripped, 1, 7) == "-- Note" then
			collecting = true
			table.insert(noteLines, i .. ": " .. line)
		elseif collecting and string.match(line, "^%s*%-%-   ") ~= nil then
			table.insert(noteLines, i .. ": " .. line)
		else
			collecting = false
		end
	end
	-- La note attachée est dans la zone de son bloc (table des lignes) ?
	local placement = "note libre"
	if target ~= nil then
		placement = "introuvable dans la zone du bloc"
		for _, entry in ipairs(res.lineMap or {}) do
			if entry.block == target then
				for l = entry.line, entry.last do
					local line = lines[l]
					if line ~= nil and string.find(line, "-- Note :", 1, true) then
						placement = "dans la zone du bloc (ligne " .. l .. ")"
						break
					end
				end
				break
			end
		end
	end
	-- Aller-retour (sérialisation) : la note est gardée telle quelle
	local roundTrip = false
	pcall(function()
		local Model = getModelModule()
		local back = Model.fromData(model:serialize())
		local copy = back:getNote(noteId)
		roundTrip = copy ~= nil and copy.text == model:getNote(noteId).text and copy.blockId == model:getNote(noteId).blockId
		back:destroy()
	end)
	local check = syntaxCheck(code)
	local note = model:getNote(noteId)
	local result = {
		noteId = noteId,
		blockId = target,
		texteAccepte = accepted == true,
		note = note,
		mode = mode,
		code = code,
		lignes = noteLines,
		placement = placement,
		sansNotes = not string.find(tostring(resOff.code or ""), "-- Note", 1, true),
		syntaxe = check,
		allerRetour = roundTrip,
		projet = (app ~= nil and json == nil) and "copie du projet ouvert" or "projet donné ou démonstration",
	}
	destroyModel(model)
	return result
end

---------------------------------------------------------------------------
-- Version 2.1.0 : paramètres, partage, brouillon (SPEC §31, §32)
---------------------------------------------------------------------------

local function commandSettings(ctx, action, a, b)
	local Reglages = requireSibling("Reglages")
	local app = getApp(ctx, false)
	local host = hostFor(ctx, app)
	if type(Reglages.isLoaded) == "function" and not Reglages.isLoaded() then
		Reglages.load(host)
	end
	action = action or "get"
	local s
	local changed = false
	if action == "get" or action == "lire" then
		s = Reglages.current()
	elseif action == "apply" or action == "appliquer" then
		local data = a
		if type(data) == "string" then
			local imported, importErr = Reglages.import(data)
			if imported == nil then
				error(tostring(importErr), 0)
			end
			data = imported
		end
		if type(data) ~= "table" then
			error("réglages manquants (table, texte JSON ou texte exporté)", 0)
		end
		s = Reglages.save(host, data)
		changed = true
	elseif action == "set" then
		if type(a) ~= "string" or a == "" then
			error('chemin manquant (ex. :Invoke("settings", "set", "zone.aimant", 20))', 0)
		end
		s = Reglages.set(host, a, b)
		changed = true
	elseif action == "reset" or action == "reinitialiser" then
		-- comme « Tout réinitialiser » des paramètres : les favoris sont gardés
		local defaults = Reglages.defaults()
		local favoris = Reglages.get("palette.favoris")
		if type(favoris) == "table" and type(defaults.palette) == "table" then
			defaults.palette.favoris = favoris
		end
		s = Reglages.save(host, defaults)
		changed = true
	elseif action == "export" then
		return { texte = Reglages.export(Reglages.current()) }
	elseif action == "import" then
		local imported, importErr = Reglages.import(a)
		return { ok = imported ~= nil, erreur = importErr, reglages = imported }
	else
		error("action inconnue : " .. tostring(action) .. " (get, apply, set, reset, export, import)", 0)
	end
	local rebuilt = false
	local how = nil
	if changed then
		if app ~= nil and type(app._applySettings) == "function" then
			-- comme « Appliquer » dans les paramètres : enregistrés, appliqués au thème, puis l'éditeur
			-- est reconstruit (host.rebuildApp, juste après cette commande) en gardant les projets
			local okApply, applyErr = pcall(app._applySettings, app, s)
			if okApply then
				how = "app:_applySettings"
				rebuilt = type(app.host) == "table" and type(app.host.rebuildApp) == "function"
			else
				warn("[Blocs FR][dev] app:_applySettings : " .. tostring(applyErr))
			end
		end
		if how == nil then
			Reglages.applyToTheme(s)
			how = "Reglages.applyToTheme"
			if app ~= nil and type(app.host) == "table" and type(app.host.rebuildApp) == "function" then
				local okRebuild, rebuildErr = pcall(app.host.rebuildApp)
				rebuilt = okRebuild
				if not okRebuild then
					warn("[Blocs FR][dev] reconstruction de l'éditeur : " .. tostring(rebuildErr))
				end
			end
		end
	end
	return { reglages = s, applique = changed, methode = how, reconstruit = rebuilt, export = Reglages.export(s) }
end

-- Différences entre deux valeurs (au plus limit chemins)
local function diffValues(a, b, path, out, limit)
	if #out >= limit then
		return
	end
	if type(a) ~= type(b) then
		table.insert(out, path .. " : " .. type(a) .. " / " .. type(b))
		return
	end
	if type(a) ~= "table" then
		if a ~= b then
			table.insert(out, path .. " : " .. tostring(a) .. " / " .. tostring(b))
		end
		return
	end
	for k, v in pairs(a) do
		diffValues(v, b[k], path .. "." .. tostring(k), out, limit)
	end
	for k, v in pairs(b) do
		if a[k] == nil then
			diffValues(nil, v, path .. "." .. tostring(k), out, limit)
		end
	end
end

local function projectSummary(model)
	local summary = { mode = model.mode, blocks = 0, notes = 0, disabled = 0, tops = #(model.tops or {}) }
	pcall(function()
		summary.blocks = model:count()
		summary.notes = #model:noteIds()
		summary.disabled = #model:disabledIds()
	end)
	return summary
end

-- "share" : code « BLOCSFR1: » + JSON du projet (ouvert, ou JSON donné), relu comme « Importer un code… »
-- et comparé ; "share", "BLOCSFR1:…" : seulement l'import (validation)
local function commandShare(ctx, input)
	local Model = getModelModule()
	if type(input) == "string" and string.sub(trim(input), 1, #SHARE_PREFIX) == SHARE_PREFIX then
		local body = string.sub(trim(input), #SHARE_PREFIX + 1)
		local data = decodeJson(body)
		local model, warnings = Model.fromData(data)
		local summary = projectSummary(model)
		destroyModel(model)
		return { importe = true, projet = summary, warnings = toStringList(warnings) }
	end
	local model, own = modelFromArgs(ctx, input, false)
	local data = model:serialize()
	local code = SHARE_PREFIX .. HttpService:JSONEncode(data)
	-- Import (comme « Importer un code… ») : préfixe retiré, JSON relu, Model.fromData
	local back = HttpService:JSONDecode(string.sub(code, #SHARE_PREFIX + 1))
	local imported, warnings = Model.fromData(back)
	local differences = {}
	diffValues(data, imported:serialize(), "projet", differences, 10)
	local mode = "server"
	if VALID_MODES[model.mode] then
		mode = model.mode
	end
	local codeA = CodeGen.generate(model, mode).code
	local codeB = CodeGen.generate(imported, mode).code
	local result = {
		ok = #differences == 0 and codeA == codeB,
		longueur = #code,
		debut = truncateUtf8(code, 200),
		memesDonnees = #differences == 0,
		memeCode = codeA == codeB,
		differences = differences,
		warnings = toStringList(warnings),
		projet = projectSummary(model),
		code = code,
	}
	destroyModel(imported)
	if own then
		destroyModel(model)
	end
	return result
end

-- Un brouillon { json, targetPath, workspace, time, mode, screen, count } décrit sans son JSON
local function describeDraftEntry(draft)
	if type(draft) ~= "table" then
		return { illisible = true }
	end
	local out = {
		targetPath = draft.targetPath,
		workspace = draft.workspace,
		screen = draft.screen,
		time = draft.time,
		mode = draft.mode,
	}
	if type(draft.time) == "number" then
		out.age = os.time() - draft.time
	end
	if type(draft.json) == "string" then
		out.longueur = #draft.json
		pcall(function()
			local data = HttpService:JSONDecode(draft.json)
			local count = 0
			for _ in pairs(data.blocks or {}) do
				count += 1
			end
			out.blocks = count
			out.mode = out.mode or data.mode
		end)
	else
		out.illisible = true
	end
	return out
end

-- Brouillons du réglage : format d'App { version = 2, entries = { … } } (4 au plus, un par cible), ou
-- ancien format (un seul brouillon { json, targetPath, workspace, time })
local function draftEntries(raw)
	if type(raw) == "string" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not ok then
			return {}, 0
		end
		raw = decoded
	end
	if type(raw) ~= "table" then
		return {}, 0
	end
	if type(raw.entries) == "table" then
		return raw.entries, tonumber(raw.version) or 2
	end
	if type(raw.json) == "string" then
		return { raw }, 1
	end
	return {}, 0
end

local function describeDraft(raw)
	if raw == nil then
		return { existe = false, entrees = {} }
	end
	local entries, version = draftEntries(raw)
	local out = { existe = #entries > 0, format = version, entrees = {} }
	for _, entry in ipairs(entries) do
		table.insert(out.entrees, describeDraftEntry(entry))
	end
	return out
end

-- "draft", "lire" | "enregistrer" | "effacer" | "verifier" (SPEC §32, réglage BlocsFR_Brouillon)
local function commandDraft(ctx, action)
	action = action or "lire"
	local app = getApp(ctx, action == "enregistrer" or action == "verifier")
	local host = hostFor(ctx, app)
	local method = nil
	local note = nil
	local workspaceName = "blocs"
	if app ~= nil then
		local calledWs, ws = callMethod(app, { "getWorkspace" })
		if calledWs and ws == "interface" then
			workspaceName = "interface"
		end
	end
	if action == "enregistrer" then
		if app == nil then
			error("impossible d'ouvrir l'éditeur", 0)
		end
		-- comme le minuteur du brouillon, mais tout de suite (force) : seulement les projets modifiés
		local called, _, name = callMethod(app, { "saveDraft", "_writeDrafts" }, true)
		if called then
			method = "app:" .. name
			local model = currentModel(app)
			if type(model) == "table" and model.dirty ~= true then
				note = "le projet ouvert n'a pas de changement non enregistré : aucun brouillon n'est écrit pour lui"
			end
		else
			-- Sans méthode d'App : un brouillon au format d'App pour le projet ouvert
			local model = currentModel(app)
			local targetPath = "(aucune)"
			pcall(function()
				targetPath = app:_targetPath()
			end)
			local entries = draftEntries(host.getSetting(DRAFT_SETTING))
			local kept = {}
			for _, e in ipairs(entries) do
				if type(e) == "table" and not (e.workspace == workspaceName and e.targetPath == targetPath) then
					table.insert(kept, e)
				end
			end
			local count = 0
			pcall(function()
				count = model:count()
			end)
			table.insert(kept, 1, {
				json = HttpService:JSONEncode(model:serialize()),
				targetPath = targetPath,
				workspace = workspaceName,
				time = os.time(),
				mode = model.mode,
				count = count,
			})
			while #kept > DRAFT_MAX_ENTRIES do
				table.remove(kept)
			end
			host.setSetting(DRAFT_SETTING, { version = 2, entries = kept })
			method = "DevBridge"
		end
	elseif action == "effacer" then
		local entries = draftEntries(host.getSetting(DRAFT_SETTING))
		if app ~= nil and type(app.clearDraft) == "function" then
			app:clearDraft("*") -- (tous les brouillons)
			method = "app:clearDraft"
		elseif app ~= nil and type(app._clearDraft) == "function" then
			for _, e in ipairs(entries) do
				if type(e) == "table" then
					app:_clearDraft(e.workspace or "blocs", e.targetPath)
				end
			end
			method = "app:_clearDraft"
		end
		-- (un ancien brouillon illisible par App est effacé aussi)
		if #draftEntries(host.getSetting(DRAFT_SETTING)) > 0 or method == nil then
			host.setSetting(DRAFT_SETTING, nil)
			method = method or "DevBridge"
		end
	elseif action == "verifier" then
		if app == nil then
			error("impossible d'ouvrir l'éditeur", 0)
		end
		-- La fenêtre « Brouillon retrouvé » s'ouvre si un brouillon de cet onglet diffère de ce qui est
		-- enregistré (rien si le projet ouvert a des changements non enregistrés)
		local called, result, name = callMethod(app, { "checkDraft" })
		if not called then
			called, result, name = callMethod(app, { "_offerDraft" }, workspaceName, true)
		end
		if not called then
			error("app:checkDraft est indisponible", 0)
		end
		local dialogOpen = nil
		pcall(function()
			dialogOpen = app.dialogs:isOpen()
		end)
		return {
			methode = name,
			resultat = result,
			onglet = workspaceName,
			fenetreOuverte = dialogOpen,
			brouillon = describeDraft(host.getSetting(DRAFT_SETTING)),
		}
	elseif action ~= "lire" then
		error("action inconnue : " .. tostring(action) .. " (lire, enregistrer, effacer, verifier)", 0)
	end
	local interval = nil
	pcall(function()
		interval = requireSibling("Reglages").get("sauvegarde.brouillon")
	end)
	return {
		methode = method,
		note = note,
		intervalle = interval,
		brouillon = describeDraft(host.getSetting(DRAFT_SETTING)),
	}
end

---------------------------------------------------------------------------
-- Version 2.1.0 : lignes entre les blocs (SPEC §36)
---------------------------------------------------------------------------

-- Texte écrit dans une entrée d'un bloc (nil si un bloc valeur y est branché ou si la case est vide)
local function literalTextOf(block, name)
	local slot = type(block.inputs) == "table" and block.inputs[name] or nil
	if type(slot) ~= "table" or slot.block ~= nil then
		return nil
	end
	local value = slot.value
	if type(value) == "number" then
		value = tostring(value)
	end
	if type(value) ~= "string" or value == "" then
		return nil
	end
	return value
end

-- Variable d'un bloc (sa première entrée « variable ») : nom, et vrai si le bloc la lit (bloc valeur)
-- plutôt que de la modifier (comme Canvas)
local function variableOfBlock(block)
	local def = Registry.get(block.def)
	if type(def) ~= "table" or type(def.inputs) ~= "table" then
		return nil, false
	end
	for _, spec in ipairs(def.inputs) do
		if type(spec) == "table" and spec.kind == "variable" then
			return literalTextOf(block, spec.name), def.shape == "reporter" or def.shape == "boolean"
		end
	end
	return nil, false
end

-- "b2" < "b10" < "autre"
local function blockIdLess(a, b)
	local na = tonumber(string.match(tostring(a), "^%a*(%d+)$"))
	local nb = tonumber(string.match(tostring(b), "^%a*(%d+)$"))
	if na ~= nil and nb ~= nil and na ~= nb then
		return na < nb
	end
	return tostring(a) < tostring(b)
end

-- Lignes automatiques, calculées à partir du projet comme la SPEC §36 les décrit (rien n'est rangé) :
-- message envoyé -> reçu (même nom écrit), appel de fonction -> « Définir la fonction » du même nom dans
-- le même projet, variable modifiée -> lue (le canvas ne les montre que pour le bloc survolé ou choisi)
local function automaticLinks(model)
	local ids = {}
	for id in pairs(model.blocks or {}) do
		table.insert(ids, id)
	end
	table.sort(ids, blockIdLess)
	local senders, receivers = {}, {}
	local callers, functions = {}, {}
	local writers, readers = {}, {}
	local function push(map, key, id)
		map[key] = map[key] or {}
		table.insert(map[key], id)
	end
	for _, id in ipairs(ids) do
		local block = model.blocks[id]
		if type(block) == "table" then
			local def = block.def
			if def == "evt_message" then
				local name = literalTextOf(block, "MESSAGE")
				if name ~= nil then
					push(receivers, name, id)
				end
			elseif MESSAGE_SENDERS[def] then
				local name = literalTextOf(block, "MESSAGE")
				if name ~= nil then
					table.insert(senders, { id = id, name = name })
				end
			elseif def == "mod_fonction" then
				local name = literalTextOf(block, "NOM")
				if name ~= nil then
					push(functions, name, id)
				end
			elseif MODULE_CALLERS[def] then
				local name = literalTextOf(block, "NOM")
				if name ~= nil then
					table.insert(callers, { id = id, name = name })
				end
			else
				local name, isValue = variableOfBlock(block)
				if name ~= nil and isValue then
					push(readers, name, id)
				elseif name ~= nil then
					table.insert(writers, { id = id, name = name })
				end
			end
		end
	end
	local links = {}
	local counts = { message = 0, module = 0, variable = 0 }
	local function add(kind, from, to, text)
		if from == to then
			return
		end
		counts[kind] += 1
		local disabled = false
		pcall(function()
			disabled = model:isDisabled(from, true) or model:isDisabled(to, true)
		end)
		table.insert(links, { kind = kind, de = from, vers = to, texte = text, desactive = disabled })
	end
	for _, s in ipairs(senders) do
		for _, r in ipairs(receivers[s.name] or {}) do
			add("message", s.id, r, "message « " .. s.name .. " »")
		end
	end
	for _, c in ipairs(callers) do
		for _, f in ipairs(functions[c.name] or {}) do
			add("module", c.id, f, "fonction du module")
		end
	end
	for _, w in ipairs(writers) do
		for _, r in ipairs(readers[w.name] or {}) do
			add("variable", w.id, r, "variable « " .. w.name .. " »")
		end
	end
	return links, counts
end

-- Essai complet des lignes manuelles du Model (SPEC §36) sur un petit projet de démonstration
local function testManualLinks(Model)
	local report = { disponible = false, etapes = {}, ok = false }
	local probe = Model.new()
	local missing = {}
	for _, name in ipairs({ "addLink", "setLink", "removeLink", "linksOf" }) do
		if type(probe[name]) ~= "function" then
			table.insert(missing, name)
		end
	end
	destroyModel(probe)
	if #missing > 0 then
		report.raison = "Model n'a pas encore " .. table.concat(missing, ", ") .. " (SPEC §36 : à ajouter par l'intégration)"
		return report
	end
	report.disponible = true
	local allOk = true
	local function step(name, fn)
		local ok, result, detail = pcall(fn)
		local passed = ok and result == true
		if not passed then
			allOk = false
		end
		table.insert(report.etapes, { nom = name, ok = passed, detail = ok and detail or tostring(result) })
		return passed
	end
	local model = Model.new()
	local hatA = mustCreate(model, "evt_demarrage", 40, 40)
	local a = mustCreate(model, "dbg_afficher", 40, 140)
	mustAttachNext(model, hatA, a)
	local hatB = mustCreate(model, "evt_demarrage", 40, 400)
	local b = mustCreate(model, "dbg_afficher", 40, 500)
	mustAttachNext(model, hatB, b)
	local c = mustCreate(model, "dbg_avertir", 40, 600)
	mustAttachNext(model, b, c)
	pcall(function()
		model:commit("base")
	end)
	local linkId, linkId2 = nil, nil
	step("addLink (un bloc relié à deux blocs)", function()
		linkId = model:addLink(a, b, { texte = "puis", style = "fleche" })
		linkId2 = model:addLink(a, c, { texte = "", style = "points" })
		return linkId ~= nil and linkId2 ~= nil and linkId ~= linkId2, tostring(linkId) .. ", " .. tostring(linkId2)
	end)
	step("linksOf (départ et arrivée)", function()
		local fromA = model:linksOf(a) or {}
		local toB = model:linksOf(b) or {}
		return #fromA == 2 and #toB == 1, "#a = " .. #fromA .. ", #b = " .. #toB
	end)
	step("setLink (texte, style, couleur)", function()
		model:setLink(linkId, { texte = "ensuite", style = "plein", couleur = { 226, 87, 74 } })
		local link = model.liens and model.liens[linkId]
		return type(link) == "table" and link.texte == "ensuite" and link.style == "plein", link and link.texte
	end)
	pcall(function()
		model:commit("lien")
	end)
	step("serialize -> fromData (« liens » gardés)", function()
		local data = model:serialize()
		local count = 0
		for _ in pairs(data.liens or {}) do
			count += 1
		end
		local back = Model.fromData(data)
		local again = back and #(back:linksOf(a) or {}) or -1
		destroyModel(back)
		return count == 2 and again == 2, "liens = " .. count .. ", relus = " .. again
	end)
	step("commentaire « -- Lien vers » (notes dans le code) et rien sans les notes", function()
		local on = CodeGen.generate(model, "server", { notes = true }).code
		local off = CodeGen.generate(model, "server", { notes = false }).code
		local found = string.find(on, "-- Lien vers", 1, true) ~= nil
		local absent = string.find(off, "-- Lien vers", 1, true) == nil
		local check = syntaxCheck(on)
		return found and absent and check.ok == true, (found and "commentaire présent" or "commentaire absent") .. (check.ok and "" or (" ; syntaxe : " .. tostring(check.err)))
	end)
	step("annuler / refaire", function()
		model:undo()
		local afterUndo = #(model:linksOf(a) or {})
		model:redo()
		local afterRedo = #(model:linksOf(a) or {})
		return afterRedo == 2 and afterUndo <= afterRedo, "après annuler : " .. afterUndo .. ", après refaire : " .. afterRedo
	end)
	step("importData (ids des blocs et des lignes renouvelés)", function()
		local data = model:serialize()
		local other = Model.new()
		local tops = other:importData(data, 300, 0)
		local count = 0
		for _, link in pairs(other.liens or {}) do
			if type(link) == "table" and other:get(link.de) ~= nil and other:get(link.vers) ~= nil then
				count += 1
			end
		end
		destroyModel(other)
		return type(tops) == "table" and count == 2, "lignes importées valides : " .. count
	end)
	step("removeLink", function()
		model:removeLink(linkId2)
		return #(model:linksOf(a) or {}) == 1, "#a = " .. #(model:linksOf(a) or {})
	end)
	step("supprimer le bloc de départ supprime ses lignes", function()
		model:deleteSingle(a)
		local left = 0
		for _ in pairs(model.liens or {}) do
			left += 1
		end
		return left == 0 and #(model:linksOf(b) or {}) == 0, "lignes restantes : " .. left
	end)
	destroyModel(model)
	report.ok = allOk
	return report
end

local function commandLinks(ctx, json)
	local Model = getModelModule()
	local model, own, app
	local okArgs, a, b, c = pcall(modelFromArgs, ctx, json, false)
	if okArgs then
		model, own, app = a, b, c
	elseif json == nil then
		-- ni projet ouvert, ni JSON : l'exemple « Interrupteur » (messages et variable)
		local okEx, Examples = pcall(requireSibling, "Examples")
		local data = nil
		if okEx and type(Examples) == "table" then
			for _, entry in ipairs(Examples) do
				if type(entry) == "table" and entry.id == "interrupteur" then
					data = entry.data
				end
			end
		end
		if data == nil then
			error(a, 0)
		end
		model = Model.fromData(data)
		own = true
	else
		error(a, 0)
	end
	local links, counts = automaticLinks(model)
	local manual = {}
	for id, link in pairs(model.liens or {}) do
		if type(link) == "table" then
			table.insert(manual, { id = id, de = link.de, vers = link.vers, texte = link.texte, style = link.style })
		end
	end
	-- Réglage « zone.liens » (toujours / survol / jamais) : celui d'App s'il l'expose, sinon Reglages
	local setting = "toujours"
	local okMode, mode = pcall(function()
		local called, value = callMethod(app, { "getLinkMode" })
		if called then
			return value
		end
		return requireSibling("Reglages").get("zone.liens")
	end)
	if okMode and (mode == "toujours" or mode == "survol" or mode == "jamais") then
		setting = mode
	end
	-- Lignes dessinées par le canvas (projet ouvert) : comptées par sorte et comparées au calcul ci-dessus
	-- (message et module, aucune avec « jamais » ; les lignes « variable » n'apparaissent que pour le
	-- bloc survolé ou choisi ; les lignes tracées à la main restent toujours)
	local canvasInfo = nil
	if app ~= nil and json == nil and type(app.canvas) == "table" then
		local called, drawn, name = callMethod(app.canvas, { "getLinks", "getLinksDebug" })
		if called then
			local byKind = {}
			local visible = 0
			if type(drawn) == "table" then
				for _, line in ipairs(drawn) do
					if type(line) == "table" then
						local kind = tostring(line.kind)
						byKind[kind] = (byKind[kind] or 0) + 1
						if line.visible == true then
							visible += 1
						end
					end
				end
			end
			local wantMessage, wantModule = counts.message, counts.module
			if setting == "jamais" then
				wantMessage, wantModule = 0, 0
			end
			local expected = wantMessage + wantModule + #manual
			local same = (byKind.message or 0) == wantMessage
				and (byKind.module or 0) == wantModule
				and (byKind.manuel or 0) == #manual
			local capped = expected > CANVAS_LINK_MAX
			canvasInfo = {
				methode = name,
				parSorte = byKind,
				attendu = { message = wantMessage, module = wantModule, manuel = #manual },
				visibles = visible,
				memeCompte = same or capped,
				note = capped and ("plus de " .. CANVAS_LINK_MAX .. " lignes : le canvas n'en dessine que " .. CANVAS_LINK_MAX) or nil,
				lignes = drawn,
			}
		end
	end
	local result = {
		projet = (app ~= nil and json == nil) and "projet ouvert" or "projet donné ou exemple « Interrupteur »",
		automatiques = links,
		compte = counts,
		manuelles = manual,
		canvas = canvasInfo,
		reglage = setting,
		essaiManuel = testManualLinks(Model),
	}
	if own then
		destroyModel(model)
	end
	return result
end

local function dispatch(ctx, cmd, args)
	if cmd == "toggleProblems" or cmd == "showCode" then
		local app = getApp(ctx, true)
		if app == nil then
			error("impossible d'ouvrir l'éditeur", 0)
		end
		app[cmd](app)
		return { done = true }
	elseif cmd == "setTarget" then
		return commandSetTarget(ctx, args[1])
	elseif cmd == "save" then
		return commandSave(ctx)
	elseif cmd == "ping" then
		return "pong"
	elseif cmd == "registry" then
		return registryInfo()
	elseif cmd == "fuzz" then
		return runFuzz()
	elseif cmd == "checkAll" then
		return summarize(runFuzz())
	elseif cmd == "generate" then
		return commandGenerate(args[1], args[2])
	elseif cmd == "check" then
		return syntaxCheck(args[1])
	elseif cmd == "open" then
		return commandOpen(ctx)
	elseif cmd == "state" then
		return commandState(ctx)
	elseif cmd == "load" then
		return commandLoad(ctx, args[1])
	elseif cmd == "export" then
		return commandExport(ctx)
	elseif cmd == "help" or cmd == "aide" then
		return COMMANDS
	elseif cmd == "examples" then
		return commandExamples()
	elseif cmd == "analyze" then
		return commandAnalyze(ctx)
	elseif cmd == "wiki" then
		return commandWiki(ctx, args[1], args[2])
	elseif cmd == "loadExample" then
		return commandLoadExample(ctx, args[1])
	elseif cmd == "guiList" then
		return requireSibling("GuiStorage").allNames()
	elseif cmd == "guiBuildAll" then
		return commandGuiBuildAll()
	elseif cmd == "guiTemplate" then
		return commandGuiTemplate(ctx, args[1], args[2])
	elseif cmd == "workspace" then
		return commandWorkspace(ctx, args[1])
	elseif cmd == "guiOpen" then
		return commandGuiOpen(ctx, args[1])
	elseif cmd == "guiState" then
		return guiStateOf(getApp(ctx, false))
	elseif cmd == "guiSelect" then
		return commandGuiSelect(ctx, args[1])
	elseif cmd == "updateCheck" then
		return commandUpdateCheck(ctx)
	elseif cmd == "simulateUpdate" then
		return commandSimulateUpdate(ctx, args[1])
	elseif cmd == "hitbox" then
		return commandHitbox(ctx, args[1], args[2])
	elseif cmd == "explain" then
		return commandExplain(ctx, args[1], args[2])
	elseif cmd == "notes" then
		return commandNotes(ctx, args[1], args[2], args[3])
	elseif cmd == "settings" then
		return commandSettings(ctx, args[1], args[2], args[3])
	elseif cmd == "share" then
		return commandShare(ctx, args[1])
	elseif cmd == "draft" then
		return commandDraft(ctx, args[1])
	elseif cmd == "links" then
		return commandLinks(ctx, args[1])
	end
	error("commande inconnue : " .. tostring(cmd) .. " (essayez « help »)", 0)
end

local function handle(ctx, cmd, args)
	local ok, result = pcall(dispatch, ctx, cmd, args)
	if not ok then
		return { ok = false, error = tostring(result) }
	end
	local okClean, clean = pcall(sanitize, result, 0, {})
	if not okClean then
		return { ok = false, error = "résultat impossible à transmettre : " .. tostring(clean) }
	end
	return { ok = true, result = clean }
end

---------------------------------------------------------------------------
-- Démarrage
---------------------------------------------------------------------------

-- ctx = { getApp = fn, openEditor = fn, openWiki = fn(pageId, defId), getWiki = fn, plugin = plugin,
-- widget = DockWidgetPluginGui } ; renvoie une fonction d'arrêt
function DevBridge.start(ctx)
	ctx = ctx or {}
	local noop = function() end

	local okCore, CoreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if not okCore or CoreGui == nil then
		warn("[Blocs FR][dev] CoreGui inaccessible, pont de test désactivé : " .. tostring(CoreGui))
		return noop
	end

	-- Supprime un ancien pont (rechargement du plugin)
	pcall(function()
		for _ = 1, 20 do
			local old = CoreGui:FindFirstChild(BRIDGE_NAME)
			if old == nil then
				break
			end
			old:Destroy()
		end
	end)

	local bridge = Instance.new("BindableFunction")
	bridge.Name = BRIDGE_NAME
	bridge.OnInvoke = function(cmd, ...)
		return handle(ctx, cmd, table.pack(...))
	end

	local okParent, parentErr = pcall(function()
		bridge.Parent = CoreGui
	end)
	if not okParent then
		warn("[Blocs FR][dev] Impossible de créer CoreGui." .. BRIDGE_NAME .. " : " .. tostring(parentErr))
		pcall(function()
			bridge:Destroy()
		end)
		return noop
	end
	print("[Blocs FR][dev] Pont de test prêt : CoreGui." .. BRIDGE_NAME .. ' (essayez :Invoke("help"))')

	local stopped = false
	return function()
		if stopped then
			return
		end
		stopped = true
		pcall(function()
			bridge.OnInvoke = nil
		end)
		pcall(function()
			bridge:Destroy()
		end)
	end
end

return DevBridge
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">DevReload</string><ProtectedString name="Source"><![CDATA[-- DevReload (versions de développement uniquement) : recharge le code du plugin sans redémarrer Studio.
-- Les sources sont servies en local par `py tools/build.py --dev --http` + `py -m http.server 8765 -d dist/http`.
-- Commande (barre de commande ou MCP) : game:GetService("CoreGui").BlocsFR_DevReload:Invoke("reload")

local HttpService = game:GetService("HttpService")

local DevReload = {}
DevReload.BASE = "http://127.0.0.1:8765/"
DevReload.NAME = "BlocsFR_DevReload"

local function get(path)
	return HttpService:GetAsync(DevReload.BASE .. path, true)
end

-- Télécharge toutes les sources et construit un nouveau dossier de ModuleScripts (hors du DataModel)
function DevReload.fetchTree()
	local manifest = HttpService:JSONDecode(get("manifest.json"))
	local folder = Instance.new("Folder")
	folder.Name = "BlocsFR_" .. tostring(manifest.build)
	for _, name in ipairs(manifest.modules) do
		local source = get(name .. ".lua")
		local module = Instance.new("ModuleScript")
		module.Name = name
		module.Source = source
		module.Parent = folder
	end
	return folder, manifest
end

-- ctx.swap(folder) -> ok, err : remplace les modules utilisés par le plugin et relance l'éditeur
function DevReload.start(ctx)
	local CoreGui = game:GetService("CoreGui")
	local old = CoreGui:FindFirstChild(DevReload.NAME)
	if old then
		old:Destroy()
	end
	local bf = Instance.new("BindableFunction")
	bf.Name = DevReload.NAME
	bf.OnInvoke = function(cmd)
		if cmd ~= "reload" then
			return { ok = false, error = "commande inconnue (utilisez \"reload\")" }
		end
		local ok, folder, manifest = pcall(DevReload.fetchTree)
		if not ok then
			return { ok = false, error = "téléchargement impossible : " .. tostring(folder) }
		end
		local okSwap, errSwap = ctx.swap(folder)
		if not okSwap then
			return { ok = false, error = tostring(errSwap) }
		end
		return { ok = true, build = manifest.build, modules = #manifest.modules }
	end
	bf.Parent = CoreGui
	return function()
		if bf.Parent then
			bf:Destroy()
		end
	end
end

return DevReload
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Dialogs</string><ProtectedString name="Source"><![CDATA[-- Dialogs : menus contextuels, fenêtres modales (saisie, confirmation, message), sélecteur de couleur,
-- info-bulles et notifications (« toasts ») de Blocs FR.
-- Style du design « Blocs FR — interface et logo » : popups graphite (Theme.Colors.Popup), coins de 12 px,
-- contour de 1 px (PopupBorder), lignes de menu de 34 px, bouton principal bleu (Accent).
-- Tout est dessiné dans le calque le plus haut fourni par App (layerFrame), en coordonnées « écran »
-- (même espace que GuiObject.AbsolutePosition et host.getMousePosition()).
--
-- Animations (SPEC §24, module Anim ; état final immédiat quand elles sont désactivées) : menus et
-- sélecteur de couleur qui grandissent depuis leur coin d'ouverture (92 % -> 100 %) en apparaissant,
-- surlignage des menus qui suit la souris d'une ligne à l'autre, fenêtres modales qui « se posent »
-- avec un fond qui s'assombrit en fondu (et s'effacent en 0,1 s), notifications qui montent du bas
-- puis s'effacent (les autres glissent à leur place), info-bulles en fondu de 0,1 s.
--
-- Menus (SPEC §12 et §33, « comme le bureau de Windows ») :
--   dialogs:menu(screenPos, items, onChoose)
--   items = { item | "separator" } ; item = {
--     label = "Copier", value = n'importe quoi,
--     disabled = bool?  -- ligne grisée, visible mais inactive
--     danger = bool?    -- texte rouge (Supprimer…)
--     icon = "×"?       -- petit symbole à gauche (glyphes sûrs : ✓ × ⚠ ● ◆ − … ＋ ≡ ◎ ⌂ ← → ▼ 🔍)
--     hint = "Ctrl+C"?  -- texte gris aligné à droite (raccourci, « 4 blocs »…)
--     checked = bool?   -- coche ✓ à droite (option active)
--     submenu = { items }?  -- sous-menu en cascade (ouvert au survol ou au clic, gardé dans la
--                          fenêtre) ; { items = {…} } est aussi accepté
--     hidden = bool?    -- ligne ignorée (pratique pour construire un menu avec des conditions)
--     onChoose = fn(value, item)?  -- extension : appelé à la place du onChoose du menu
--   }
--   onChoose(value, item) est appelé (dans son propre thread) quand une ligne active est choisie, y
--   compris dans un sous-menu. Les séparateurs en double / au début / à la fin sont ignorés.
--   Les menus très longs prennent des lignes plus basses (34 -> 28 -> 24 px) avant de défiler.

local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Anim = require(script.Parent.Anim)

local Dialogs = {}
Dialogs.__index = Dialogs

-- Couleurs du thème lues à chaque usage (Reglages peut changer le thème, même en remplaçant la table)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})
local FONT = Theme.Fonts.UI
local FONT_BOLD = Theme.Fonts.UIBold
local TEXT_SIZE = 13
local WHITE = Color3.fromRGB(255, 255, 255)

-- Ordre d'affichage à l'intérieur du calque des dialogues
local Z_CATCHER = 10 -- zone invisible qui ferme le menu ouvert quand on clique ailleurs
local Z_POPUP = 11 -- menu / sélecteur de couleur
local Z_MODAL = 20 -- fenêtres modales
local Z_TOASTS = 30 -- notifications
local Z_TOOLTIP = 40 -- info-bulle

local POPUP_RADIUS = 12
local MENU_ROW = 34 -- hauteur d'une ligne de menu (design)
local MENU_ROW_COMPACT = 28 -- longues listes (matériaux, touches…)
local MENU_ROW_TIGHT = 24 -- très longs menus dans une fenêtre basse (avant de défiler)
local MENU_PAD = 6
local MENU_SEP = 9
local MENU_MIN_W = 180
local MENU_MAX_W = 460
local MENU_TEXT_X = 12 -- début du texte dans une ligne (sans icône)
local MENU_ICON_W = 26 -- colonne des icônes : 16 px + 10 px d'écart (design « Fenêtres et menus »)
local MENU_MARK_W = 18 -- flèche de sous-menu ou coche à droite
local MENU_HINT_SIZE = 11
local MENU_HINT_GAP = 14 -- écart minimal entre le texte et l'indication de droite
local MENU_MAX_DEPTH = 6 -- niveaux de sous-menus au plus
local SUBMENU_OPEN_DELAY = 0.15 -- survol d'une ligne à sous-menu avant qu'il s'ouvre
local SUBMENU_CLOSE_DELAY = 0.3 -- survol d'une autre ligne avant que le sous-menu se ferme

local MODAL_PAD = 20
local MODAL_TITLE_SIZE = 17
local MODAL_TITLE_H = 24
local MODAL_INPUT_H = 36
local MODAL_BUTTON_H = 32

local TOOLTIP_MAX_W = 280
local TOAST_MAX_TEXT_W = 300
local TOAST_MAX_COUNT = 4
local TOAST_GAP = 8 -- espace au-dessus de chaque notification (inclus dans sa place, qui s'anime)

local FADE_MAX = 60 -- Anim.fadeIn anime l'objet et 60 descendants au plus

-- Couleurs par genre de notification : noms des couleurs du thème, lues au moment de l'affichage
-- (les réglages peuvent changer le thème sans recharger les modules)
local KIND_COLORS = {
	info = "Info",
	success = "Success",
	warning = "Warning",
	error = "Danger",
}

local KIND_TEXT_COLORS = {
	info = "InfoText",
	success = "SuccessText",
	warning = "WarningText",
	error = "DangerText",
}

local KIND_ICONS = {
	info = "●",
	success = "✓",
	warning = "⚠",
	error = "×",
}

-- 32 couleurs prédéfinies (4 lignes de 8) : vives, claires, foncées, neutres
local PRESETS = {
	{ 255, 0, 0 }, { 255, 128, 0 }, { 255, 215, 0 }, { 0, 200, 0 },
	{ 0, 170, 255 }, { 0, 80, 255 }, { 140, 0, 255 }, { 255, 0, 200 },
	{ 255, 150, 150 }, { 255, 200, 150 }, { 255, 240, 160 }, { 160, 240, 160 },
	{ 160, 220, 255 }, { 160, 180, 255 }, { 200, 160, 255 }, { 255, 170, 230 },
	{ 150, 0, 0 }, { 150, 75, 0 }, { 150, 120, 0 }, { 0, 110, 0 },
	{ 0, 100, 150 }, { 0, 40, 140 }, { 80, 0, 140 }, { 140, 0, 100 },
	{ 255, 255, 255 }, { 200, 200, 200 }, { 150, 150, 150 }, { 100, 100, 100 },
	{ 50, 50, 50 }, { 0, 0, 0 }, { 120, 80, 40 }, { 245, 205, 160 },
}

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

-- Appelle un rappel dans son propre thread : une erreur dans le rappel ne casse pas l'interface.
local function safeCall(fn, ...)
	if type(fn) == "function" then
		task.spawn(fn, ...)
	end
end

-- Taille d'un texte avec retour à la ligne automatique (largeur max). Ne bloque jamais.
local function measureWrapped(text, size, font, maxWidth)
	maxWidth = math.max(10, maxWidth)
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(maxWidth, 100000))
	end)
	if ok and typeof(result) == "Vector2" then
		return Vector2.new(math.ceil(result.X), math.ceil(result.Y))
	end
	-- estimation de secours
	local lines = 0
	local widest = 0
	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
		local w = Util.textSize(line, size, font).X
		widest = math.max(widest, math.min(w, maxWidth))
		lines += math.max(1, math.ceil(w / maxWidth))
	end
	return Vector2.new(math.ceil(widest), math.max(1, lines) * (size + 3))
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

-- TextLabel transparent avec les réglages par défaut de l'interface
local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = TEXT_SIZE,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Bouton arrondi avec effet de survol. style : "normal" | "primary" | "danger"
local function makeButton(parent, text, style, position, size, maid)
	local base = C.Button
	local hover = C.ButtonHover
	local textColor = C.Text
	if style == "primary" then
		base = C.Accent
		hover = C.AccentHover
		textColor = WHITE
	elseif style == "danger" then
		base = C.Danger
		hover = Theme.lighten(C.Danger, 0.12)
		textColor = WHITE
	end
	local button = Util.create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		Parent = parent,
	})
	Util.corner(button, 8)
	if style == "normal" then
		Util.stroke(button, C.PopupBorder, 1)
	end
	makeLabel({
		Text = text,
		Font = FONT_BOLD,
		TextColor3 = textColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	maid:give(Anim.hover(button, base, hover))
	return button
end

local function sanitizeRgb(rgb)
	if type(rgb) ~= "table" then
		return { 255, 0, 0 }
	end
	local out = {}
	for i = 1, 3 do
		local n = tonumber(rgb[i]) or 0
		out[i] = math.floor(Util.clamp(n, 0, 255) + 0.5)
	end
	return out
end

-- Animation d'une ou plusieurs propriétés (moteur Anim : état final tout de suite si désactivé)
local function tween(instance, time, props)
	return Anim.tween(instance, props, time, "quadOut")
end

-- Vrai si le fondu d'Anim couvre tout l'objet (au plus FADE_MAX descendants animés)
local function fadeFits(obj)
	local count = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("GuiObject") or d:IsA("UIStroke") then
			count += 1
			if count > FADE_MAX then
				return false
			end
		end
	end
	return true
end

-- Apparition d'un popup / d'une fenêtre : il grandit (92 % -> 100 %) depuis son point d'ancrage et
-- apparaît en fondu (le fondu seulement s'il n'a pas trop de descendants : sinon une partie
-- apparaîtrait d'un coup). slide (facultatif, Vector2) : il glisse aussi de ce décalage vers sa place.
local function appear(frame, duration, slide)
	Anim.popIn(frame, 0.92)
	if typeof(slide) == "Vector2" and slide.Magnitude > 0 then
		Anim.slideIn(frame, slide, 0.14)
	end
	if fadeFits(frame) then
		Anim.fadeIn(frame, duration or 0.12)
	end
end

-- Pose un cadre w×h dont le coin haut-gauche est (x, y), avec le point d'ancrage (ax, ay) : le
-- cadre grandit depuis ce point quand il apparaît (Anim.popIn agit autour de l'ancrage)
local function anchorAt(frame, ax, ay, x, y, w, h)
	frame.AnchorPoint = Vector2.new(ax, ay)
	frame.Position = UDim2.fromOffset(x + math.floor(ax * w + 0.5), y + math.floor(ay * h + 0.5))
end

---------------------------------------------------------------------------
-- Menus : lecture des lignes et mise en page
---------------------------------------------------------------------------

-- Lignes d'un sous-menu (submenu = { items } ou { items = { … } }), ou nil s'il n'a aucune ligne
local function submenuItems(item)
	local sub = item.submenu
	if type(sub) ~= "table" then
		return nil
	end
	if type(sub.items) == "table" then
		sub = sub.items
	end
	for _, entry in ipairs(sub) do
		if type(entry) == "table" and entry.hidden ~= true then
			return sub
		end
	end
	return nil
end

local function textOf(value)
	if value == nil then
		return nil
	end
	local text = tostring(value)
	if text == "" then
		return nil
	end
	return text
end

-- Lignes utilisables : sans les lignes cachées ni les séparateurs en double, au début ou à la fin
local function cleanMenuItems(items)
	local out = {}
	if type(items) ~= "table" then
		return out
	end
	local pendingSeparator = false
	for _, item in ipairs(items) do
		if item == "separator" then
			pendingSeparator = #out > 0
		elseif type(item) == "table" and item.hidden ~= true then
			if pendingSeparator then
				table.insert(out, "separator")
				pendingSeparator = false
			end
			table.insert(out, item)
		end
	end
	return out
end

-- Mise en page d'un panneau de menu : { width, height, contentH, row, hasIcon, scrolls }
local function menuLayout(items, layerW, layerH)
	local count, separators, hasIcon = 0, 0, false
	for _, item in ipairs(items) do
		if item == "separator" then
			separators += 1
		else
			count += 1
			if textOf(item.icon) ~= nil then
				hasIcon = true
			end
		end
	end
	local maxH = math.max(80, layerH - 8)
	local row = MENU_ROW
	if count > 12 then
		row = MENU_ROW_COMPACT
	end
	local contentH = MENU_PAD * 2 + count * row + separators * MENU_SEP
	if contentH > maxH and row > MENU_ROW_TIGHT then
		row = MENU_ROW_TIGHT
		contentH = MENU_PAD * 2 + count * row + separators * MENU_SEP
	end
	local height = math.min(contentH, maxH)
	local scrolls = contentH > height

	local labelX = MENU_TEXT_X
	if hasIcon then
		labelX += MENU_ICON_W
	end
	local width = MENU_MIN_W
	for _, item in ipairs(items) do
		if item ~= "separator" then
			-- marge droite + indication + flèche / coche, puis les 6 px de part et d'autre de la ligne
			local right = 12
			local hint = textOf(item.hint)
			if hint ~= nil then
				right += textWidth(hint, MENU_HINT_SIZE, FONT_BOLD) + 2 + MENU_HINT_GAP
			end
			if item.checked == true or submenuItems(item) ~= nil then
				right += MENU_MARK_W
			end
			local w = labelX + textWidth(tostring(item.label or ""), TEXT_SIZE, FONT) + right + 12
			if w > width then
				width = w
			end
		end
	end
	if scrolls then
		width += 5
	end
	width = math.max(60, math.min(math.ceil(width), MENU_MAX_W, layerW - 8))
	return { width = width, height = height, contentH = contentH, row = row, hasIcon = hasIcon, scrolls = scrolls }
end

-- Découpe un message en paragraphes : titres « 1. TITRE », puces « • … », lignes vides, texte.
-- NOTE: « • » reste le marqueur lu dans les messages ; la puce dessinée est « ● » (petite taille), un
-- signe que la police de Studio affiche à coup sûr.
local BULLET = "•"
local BULLET_GLYPH = "●"

local function messageBlocks(message)
	local blocks = {}
	for line in string.gmatch(message .. "\n", "([^\n]*)\n") do
		local trimmed = Util.trim(line)
		if trimmed == "" then
			table.insert(blocks, { kind = "space" })
		elseif #trimmed <= 80 and string.match(trimmed, "^%d+[%.%)]%s") and not string.find(trimmed, "%l") then
			table.insert(blocks, { kind = "heading", text = trimmed })
		elseif string.sub(trimmed, 1, #BULLET) == BULLET then
			table.insert(blocks, { kind = "bullet", text = Util.trim(string.sub(trimmed, #BULLET + 1)) })
		else
			table.insert(blocks, { kind = "text", text = trimmed })
		end
	end
	-- pas d'espaces inutiles au début ni à la fin
	while #blocks > 0 and blocks[1].kind == "space" do
		table.remove(blocks, 1)
	end
	while #blocks > 0 and blocks[#blocks].kind == "space" do
		table.remove(blocks, #blocks)
	end
	return blocks
end

-- Construit les paragraphes d'un message dans parent (largeur width). Renvoie la hauteur totale.
local function buildMessage(parent, message, width)
	local y = 0
	local first = true
	for _, b in ipairs(messageBlocks(message)) do
		if b.kind == "space" then
			y += 8
		elseif b.kind == "heading" then
			if not first then
				y += 4
			end
			local m = measureWrapped(b.text, TEXT_SIZE, FONT_BOLD, width)
			makeLabel({
				Text = b.text,
				Font = FONT_BOLD,
				TextColor3 = C.AccentText,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Position = UDim2.fromOffset(0, y),
				Size = UDim2.fromOffset(width, m.Y + 2),
				Parent = parent,
			})
			y += m.Y + 6
		elseif b.kind == "bullet" then
			local m = measureWrapped(b.text, TEXT_SIZE, FONT, width - 16)
			makeLabel({
				Text = BULLET_GLYPH,
				Font = FONT_BOLD,
				TextSize = TEXT_SIZE - 5,
				TextColor3 = C.TextDim,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				Position = UDim2.fromOffset(2, y),
				Size = UDim2.fromOffset(10, TEXT_SIZE + 3),
				Parent = parent,
			})
			makeLabel({
				Text = b.text,
				TextColor3 = C.TextSoft,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Position = UDim2.fromOffset(16, y),
				Size = UDim2.fromOffset(width - 16, m.Y + 2),
				Parent = parent,
			})
			y += m.Y + 5
		else
			local m = measureWrapped(b.text, TEXT_SIZE, FONT, width)
			makeLabel({
				Text = b.text,
				TextColor3 = C.TextSoft,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Position = UDim2.fromOffset(0, y),
				Size = UDim2.fromOffset(width, m.Y + 2),
				Parent = parent,
			})
			y += m.Y + 5
		end
		first = false
	end
	return math.max(0, y)
end

-- Vrai si le libellé du bouton « oui » annonce une action destructrice (bouton rouge)
local function looksDangerous(label)
	local folded = Util.fold(tostring(label or ""))
	return string.find(folded, "supprimer", 1, true) ~= nil
		or string.find(folded, "effacer", 1, true) ~= nil
		or string.find(folded, "remplacer", 1, true) ~= nil
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function Dialogs.new(layerFrame, host)
	local self = setmetatable({}, Dialogs)
	self.layer = layerFrame
	self.host = host
	self.connections = {}
	self._popup = nil -- { maid, frame }
	self._modal = nil -- { maid, overlay, input }
	self._toasts = {}
	self._toastOrder = 0
	self._destroyed = false

	-- Zone des notifications : en bas à droite, au-dessus de la barre d'état
	self.toastArea = Util.create("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -(Theme.Layout.StatusBarHeight + 12)),
		Size = UDim2.new(0, 400, 1, -(Theme.Layout.TopBarHeight + Theme.Layout.StatusBarHeight + 40)),
		ZIndex = Z_TOASTS,
		Parent = layerFrame,
	})
	-- (pas d'espace entre les places : chaque place compte son propre espace, TOAST_GAP, pour que
	-- la pile se resserre en douceur quand une notification s'en va)
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 0),
		Parent = self.toastArea,
	})

	-- Info-bulle (une seule, réutilisée) : petite boîte sombre
	self.tip = Util.create("Frame", {
		Name = "InfoBulle",
		BackgroundColor3 = C.Tooltip,
		BorderSizePixel = 0,
		Active = false,
		Visible = false,
		Size = UDim2.fromOffset(100, 28),
		ZIndex = Z_TOOLTIP,
		Parent = layerFrame,
	})
	Util.corner(self.tip, 6)
	Util.stroke(self.tip, C.PopupBorder, 1, 0.2)
	self.tipLabel = makeLabel({
		TextSize = 12,
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(9, 6),
		Size = UDim2.fromOffset(80, 16),
		Parent = self.tip,
	})

	return self
end

---------------------------------------------------------------------------
-- Géométrie
---------------------------------------------------------------------------

-- Point écran -> point local au calque
function Dialogs:_localPoint(screenPos)
	local origin = self.layer.AbsolutePosition
	if typeof(screenPos) ~= "Vector2" then
		screenPos = origin
	end
	return Vector2.new(screenPos.X - origin.X, screenPos.Y - origin.Y)
end

function Dialogs:_layerSize()
	local size = self.layer.AbsoluteSize
	local w, h = size.X, size.Y
	if w < 50 then
		w = 800 -- calque pas encore mis en page
	end
	if h < 50 then
		h = 600
	end
	return w, h
end

-- Place une boîte w×h près du point local p en restant dans le calque.
-- Si elle dépasse en bas, elle s'ouvre vers le haut.
function Dialogs:_placeBox(p, w, h)
	local layerW, layerH = self:_layerSize()
	local x, y = p.X, p.Y
	if x + w > layerW - 4 then
		x = layerW - 4 - w
	end
	if y + h > layerH - 4 then
		if p.Y - h >= 4 then
			y = p.Y - h
		else
			y = layerH - 4 - h
		end
	end
	x = math.max(4, x)
	y = math.max(4, y)
	return math.floor(x), math.floor(y)
end

function Dialogs:_mousePosition()
	if self.host and type(self.host.getMousePosition) == "function" then
		local ok, pos = pcall(self.host.getMousePosition)
		if ok and typeof(pos) == "Vector2" then
			return pos
		end
	end
	return self.layer.AbsolutePosition
end

---------------------------------------------------------------------------
-- Menus et fenêtres non modales (popups)
---------------------------------------------------------------------------

function Dialogs:_closePopup()
	local popup = self._popup
	if not popup then
		return
	end
	self._popup = nil
	popup.maid:clean()
end

-- Ouvre un popup (fond cliquable invisible + cadre) ; renvoie le cadre et son « maid ».
function Dialogs:_openPopup(screenPos, w, h)
	self:_closePopup()
	self:hideTooltip()
	local maid = Util.Maid.new()

	local catcher = Util.create("TextButton", {
		Name = "FermerPopup",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_CATCHER,
		Parent = self.layer,
	})
	maid:give(catcher)
	local function close()
		self:_closePopup()
	end
	maid:give(catcher.MouseButton1Down:Connect(close))
	maid:give(catcher.MouseButton2Down:Connect(close))

	local x, y = self:_placeBox(self:_localPoint(screenPos), w, h)
	-- Le cadre est un bouton : un clic dans ses marges ne ferme pas le popup
	local frame = Util.create("TextButton", {
		Name = "Popup",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = Z_POPUP,
		Parent = self.layer,
	})
	Util.corner(frame, POPUP_RADIUS)
	Util.stroke(frame, C.PopupBorder, 1)
	maid:give(frame)

	self._popup = { maid = maid, frame = frame }
	return frame, maid
end

-- Menu contextuel ou liste déroulante (champs des lignes : voir l'en-tête du module) ; les sous-menus
-- s'ouvrent en cascade. onChoose(value, item) est appelé quand une ligne active est choisie.
function Dialogs:menu(screenPos, items, onChoose)
	if self._destroyed then
		return
	end
	items = cleanMenuItems(items)
	if #items == 0 then
		return
	end
	local layerW, layerH = self:_layerSize()
	local L = menuLayout(items, layerW, layerH)
	local pos = screenPos
	if typeof(pos) ~= "Vector2" then
		pos = self:_mousePosition()
	end
	local frame, maid = self:_openPopup(pos, L.width, L.height)
	local ctx = { onChoose = onChoose, rootMaid = maid, levels = {}, token = 0, closed = false }
	maid:give(function()
		ctx.closed = true
	end)
	if self._popup then
		self._popup.menu = ctx
	end

	-- le menu grandit depuis le coin le plus proche du point d'ouverture (ouvert au-dessus du point :
	-- depuis son coin bas)
	local p = self:_localPoint(pos)
	local x, y = frame.Position.X.Offset, frame.Position.Y.Offset
	local ax, ay = 0, 0
	if x < p.X and x + L.width <= p.X + 1 then
		ax = 1
	end
	if y < p.Y and y + L.height <= p.Y + 1 then
		ay = 1
	end
	anchorAt(frame, ax, ay, x, y, L.width, L.height)
	local panel = self:_fillMenuPanel(ctx, 1, frame, maid, items, L)
	panel.x, panel.y = x, y
	ctx.levels[1] = panel
	local slideY = -6
	if ay == 1 then
		slideY = 6
	end
	appear(frame, 0.12, Vector2.new(0, slideY))
end

-- Remplit un panneau de menu (racine ou sous-menu) : lignes, séparateurs et surlignage qui suit la
-- souris. Renvoie le panneau { depth, frame, maid, scroll, rows, openRow, hoveredRow, x, y }.
function Dialogs:_fillMenuPanel(ctx, depth, frame, maid, items, L)
	local panel = {
		depth = depth,
		frame = frame,
		maid = maid,
		rows = {},
		openRow = nil, -- ligne dont le sous-menu est ouvert
		hoveredRow = nil,
		closed = false,
	}
	local scroll = Util.create("ScrollingFrame", {
		Name = "Lignes",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.fromOffset(0, L.contentH),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = L.scrolls and 5 or 0,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = frame,
	})
	panel.scroll = scroll
	local rowInset = L.scrolls and 11 or 6

	-- Surlignage unique qui suit la souris d'une ligne à l'autre (sous les lignes, transparentes)
	local highlight = Util.create("Frame", {
		Name = "Surlignage",
		BackgroundColor3 = C.PopupHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.new(0, 6, 0, MENU_PAD),
		Size = UDim2.new(1, -(6 + rowInset), 0, L.row),
		ZIndex = 1,
		Parent = scroll,
	})
	Util.corner(highlight, 7)
	local shown = false
	function panel.showHighlight(r)
		if panel.closed or r == nil then
			return
		end
		if not shown then
			-- premier survol : le surlignage apparaît sur place
			shown = true
			highlight.BackgroundColor3 = r.hoverColor
			tween(highlight, 0, { Position = r.button.Position })
			tween(highlight, 0.08, { BackgroundTransparency = r.hoverTransparency })
		else
			tween(highlight, 0.1, {
				Position = r.button.Position,
				BackgroundColor3 = r.hoverColor,
				BackgroundTransparency = r.hoverTransparency,
			})
		end
	end
	function panel.hideHighlight()
		if panel.closed or not shown then
			return
		end
		shown = false
		tween(highlight, 0.08, { BackgroundTransparency = 1 })
	end

	-- un sous-menu ne suit pas le défilement de son menu : il se ferme
	maid:give(scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if panel.openRow ~= nil and not ctx.closed and not panel.closed then
			self:_closeMenuLevels(ctx, depth + 1)
		end
	end))

	local labelX = MENU_TEXT_X
	if L.hasIcon then
		labelX += MENU_ICON_W
	end
	local y = MENU_PAD
	for _, item in ipairs(items) do
		if item == "separator" then
			Util.create("Frame", {
				Name = "Separateur",
				BackgroundColor3 = C.PopupBorder,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 12, 0, y + math.floor(MENU_SEP / 2)),
				Size = UDim2.new(1, -24, 0, 1),
				ZIndex = 2,
				Parent = scroll,
			})
			y += MENU_SEP
		else
			table.insert(panel.rows, self:_menuRow(ctx, panel, item, y, L.row, rowInset, labelX))
			y += L.row
		end
	end
	return panel
end

-- Une ligne de menu : icône à gauche, texte, indication grise à droite, coche ou flèche de sous-menu
function Dialogs:_menuRow(ctx, panel, item, y, rowH, rowInset, labelX)
	local sub = submenuItems(item)
	local disabled = item.disabled == true
	local danger = item.danger == true
	local r = {
		item = item,
		sub = sub,
		enabled = not disabled,
		y = y,
		hoverColor = C.PopupHover,
		hoverTransparency = 0,
	}
	if danger then
		r.hoverColor = C.Danger
		r.hoverTransparency = 0.8
	end
	local button = Util.create("TextButton", {
		Name = "Ligne",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0, y),
		Size = UDim2.new(1, -(6 + rowInset), 0, rowH),
		ZIndex = 2,
		Parent = panel.scroll,
	})
	r.button = button

	-- indication grise (#8E8E96 dans le design), rouge foncé sur une ligne « danger »
	local textColor, iconColor, hintColor = C.Text, C.TextSoft, C.TextDim
	if disabled then
		textColor, iconColor, hintColor = C.TextDisabled, C.TextDisabled, C.TextDisabled
	elseif danger then
		textColor, iconColor, hintColor = C.DangerText, C.DangerText, Theme.darken(C.DangerText, 0.25)
	end

	local icon = textOf(item.icon)
	if icon ~= nil then
		makeLabel({
			Name = "Icone",
			Text = icon,
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = iconColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(MENU_TEXT_X - 2, 0),
			Size = UDim2.new(0, 18, 1, 0),
			Parent = button,
		})
	end

	-- à droite : flèche du sous-menu ou coche, puis l'indication (raccourci, nombre de blocs…)
	local right = 12
	local markX = -(10 + MENU_MARK_W / 2) + 4 -- centre de la flèche / coche, depuis le bord droit
	if sub ~= nil then
		makeLabel({
			Name = "Fleche",
			Text = "▼", -- tourné vers la droite (seuls quelques symboles s'affichent dans Studio)
			Font = FONT_BOLD,
			TextSize = 9,
			TextColor3 = (disabled and C.TextDisabled) or C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, markX, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			Rotation = -90,
			Parent = button,
		})
		right += MENU_MARK_W
	elseif item.checked == true then
		makeLabel({
			Name = "Coche",
			Text = "✓",
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = (disabled and C.TextDisabled) or C.AccentText,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, markX, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			Parent = button,
		})
		right += MENU_MARK_W
	end
	local hint = textOf(item.hint)
	if hint ~= nil then
		local hintW = textWidth(hint, MENU_HINT_SIZE, FONT_BOLD) + 2
		makeLabel({
			Name = "Indication",
			Text = hint,
			Font = FONT_BOLD,
			TextSize = MENU_HINT_SIZE,
			TextColor3 = hintColor,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -right, 0, 0),
			Size = UDim2.new(0, hintW, 1, 0),
			Parent = button,
		})
		right += hintW + MENU_HINT_GAP
	end
	makeLabel({
		Name = "Texte",
		Text = tostring(item.label or ""),
		TextColor3 = textColor,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(labelX, 0),
		Size = UDim2.new(1, -(labelX + right - 4), 1, 0),
		Parent = button,
	})

	local maid = panel.maid
	maid:give(button.MouseEnter:Connect(function()
		self:_menuEnterRow(ctx, panel, r)
	end))
	maid:give(button.MouseLeave:Connect(function()
		self:_menuLeaveRow(ctx, panel, r)
	end))
	maid:give(button.MouseButton1Click:Connect(function()
		self:_menuActivate(ctx, panel, r)
	end))
	return r
end

-- Survol d'une ligne : surlignage, puis ouverture (après un court instant) de son sous-menu, ou
-- fermeture (après un court instant) du sous-menu ouvert par une autre ligne de ce menu. Le délai
-- laisse le temps d'aller en diagonale jusqu'au sous-menu.
function Dialogs:_menuEnterRow(ctx, panel, r)
	if ctx.closed or panel.closed then
		return
	end
	ctx.token += 1
	local token = ctx.token
	if r.enabled then
		panel.hoveredRow = r
		panel.showHighlight(r)
	else
		-- ligne grisée : pas de surlignage
		panel.hoveredRow = nil
		if panel.openRow ~= nil then
			panel.showHighlight(panel.openRow)
		else
			panel.hideHighlight()
		end
	end
	if r.enabled and r.sub ~= nil then
		if panel.openRow ~= r then
			task.delay(SUBMENU_OPEN_DELAY, function()
				if ctx.closed or panel.closed or ctx.token ~= token or panel.hoveredRow ~= r then
					return
				end
				self:_openSubmenu(ctx, panel, r)
			end)
		end
	elseif panel.openRow ~= nil then
		task.delay(SUBMENU_CLOSE_DELAY, function()
			if ctx.closed or panel.closed or ctx.token ~= token then
				return
			end
			self:_closeMenuLevels(ctx, panel.depth + 1)
		end)
	end
end

function Dialogs:_menuLeaveRow(ctx, panel, r)
	if panel.hoveredRow ~= r then
		return
	end
	panel.hoveredRow = nil
	-- (en passant d'une ligne à l'autre, la suivante est survolée juste après : on attend)
	task.defer(function()
		if ctx.closed or panel.closed or panel.hoveredRow ~= nil then
			return
		end
		-- la ligne dont le sous-menu est ouvert reste surlignée
		if panel.openRow ~= nil then
			panel.showHighlight(panel.openRow)
		else
			panel.hideHighlight()
		end
	end)
end

-- Clic sur une ligne : ouvre son sous-menu, ou ferme tout le menu et appelle onChoose
function Dialogs:_menuActivate(ctx, panel, r)
	if ctx.closed or panel.closed or not r.enabled then
		return
	end
	if r.sub ~= nil then
		ctx.token += 1
		if panel.openRow ~= r then
			self:_openSubmenu(ctx, panel, r)
		end
		return
	end
	local item = r.item
	local handler = ctx.onChoose
	if type(item.onChoose) == "function" then
		handler = item.onChoose
	end
	self:_closePopup()
	safeCall(handler, item.value, item)
end

-- Ouvre le sous-menu de la ligne r : à droite du menu (à gauche s'il n'y a pas la place), la
-- première ligne à la hauteur de r, toujours dans la fenêtre
function Dialogs:_openSubmenu(ctx, panel, r)
	if ctx.closed or panel.closed or self._destroyed or r.sub == nil then
		return
	end
	local depth = panel.depth + 1
	if depth > MENU_MAX_DEPTH then
		return
	end
	self:_closeMenuLevels(ctx, depth)
	local items = cleanMenuItems(r.sub)
	if #items == 0 then
		return
	end
	local layerW, layerH = self:_layerSize()
	local L = menuLayout(items, layerW, layerH)
	-- place du menu parent et de la ligne (coordonnées du calque, sans l'effet d'apparition)
	local px, py = panel.x or 0, panel.y or 0
	local pw = panel.frame.Size.X.Offset
	local rowTop = py + r.y - panel.scroll.CanvasPosition.Y
	local x = px + pw - 4
	local ax = 0
	if x + L.width > layerW - 4 then
		local leftX = px - L.width + 4
		if leftX >= 4 then
			x = leftX
			ax = 1
		else
			x = math.max(4, layerW - 4 - L.width)
		end
	end
	local y = rowTop - MENU_PAD
	if y + L.height > layerH - 4 then
		y = layerH - 4 - L.height
	end
	y = math.max(4, y)

	local maid = Util.Maid.new()
	ctx.rootMaid:give(function()
		maid:clean()
	end)
	-- Le cadre est un bouton : un clic dans ses marges ne ferme pas le menu
	local frame = Util.create("TextButton", {
		Name = "SousMenu",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(L.width, L.height),
		ZIndex = Z_POPUP + depth - 1,
		Parent = self.layer,
	})
	Util.corner(frame, POPUP_RADIUS)
	Util.stroke(frame, C.PopupBorder, 1)
	maid:give(frame)
	anchorAt(frame, ax, 0, x, y, L.width, L.height)
	-- la souris arrive dans le sous-menu : une fermeture prévue (survol d'une autre ligne) est annulée
	maid:give(frame.MouseEnter:Connect(function()
		ctx.token += 1
	end))
	local sub = self:_fillMenuPanel(ctx, depth, frame, maid, items, L)
	sub.x, sub.y = x, y
	ctx.levels[depth] = sub
	panel.openRow = r
	panel.showHighlight(r)
	local slideX = -6
	if ax == 1 then
		slideX = 6
	end
	appear(frame, 0.1, Vector2.new(slideX, 0))
end

-- Ferme les sous-menus de profondeur fromDepth et plus ; le menu au-dessus garde son surlignage
-- seulement sur la ligne survolée
function Dialogs:_closeMenuLevels(ctx, fromDepth)
	for depth = #ctx.levels, fromDepth, -1 do
		local level = ctx.levels[depth]
		ctx.levels[depth] = nil
		if level ~= nil then
			level.closed = true
			level.maid:clean()
		end
	end
	local parent = ctx.levels[fromDepth - 1]
	if parent ~= nil and parent.openRow ~= nil then
		parent.openRow = nil
		if parent.hoveredRow ~= nil then
			parent.showHighlight(parent.hoveredRow)
		else
			parent.hideHighlight()
		end
	end
end

-- Sélecteur de couleur : 32 pastilles (8 colonnes de 26 px) + aperçu + champs R / V / B + OK.
-- rgb = {r, g, b} (0-255) ; onChoose({r, g, b}) n'est appelé que sur OK.
function Dialogs:colorPicker(screenPos, rgb, onChoose)
	if self._destroyed then
		return
	end
	local current = sanitizeRgb(rgb)
	local PAD, SW, GAP, COLS = 12, 26, 5, 8
	local gridW = COLS * SW + (COLS - 1) * GAP
	local rows = math.ceil(#PRESETS / COLS)
	local gridH = rows * SW + (rows - 1) * GAP
	local yTitle = PAD
	local yGrid = yTitle + 26
	local yPreview = yGrid + gridH + 12
	local yFields = yPreview + 30 + 10
	local yButtons = yFields + 28 + 12
	local w = gridW + PAD * 2
	local h = yButtons + MODAL_BUTTON_H + PAD

	local frame, maid = self:_openPopup(screenPos or self:_mousePosition(), w, h)

	makeLabel({
		Text = "Choisir une couleur",
		Font = FONT_BOLD,
		TextSize = 14,
		Position = UDim2.fromOffset(PAD, yTitle),
		Size = UDim2.fromOffset(gridW, 18),
		Parent = frame,
	})

	local swatchStrokes = {}
	local fields = {}

	local preview = Util.create("Frame", {
		Name = "Apercu",
		BackgroundColor3 = Color3.fromRGB(current[1], current[2], current[3]),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, yPreview),
		Size = UDim2.fromOffset(gridW, 30),
		Parent = frame,
	})
	Util.corner(preview, 7)
	Util.stroke(preview, C.PopupBorder, 1)
	local previewText = makeLabel({
		Font = Theme.Fonts.Code,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = preview,
	})

	local function refresh()
		preview.BackgroundColor3 = Color3.fromRGB(current[1], current[2], current[3])
		local luminance = 0.299 * current[1] + 0.587 * current[2] + 0.114 * current[3]
		if luminance > 150 then
			previewText.TextColor3 = C.TextDark
		else
			previewText.TextColor3 = WHITE
		end
		previewText.Text = string.format("R %d   V %d   B %d", current[1], current[2], current[3])
		for i, field in ipairs(fields) do
			local text = tostring(current[i])
			if field.Text ~= text then
				field.Text = text
			end
		end
		for i, stroke in pairs(swatchStrokes) do
			local p = PRESETS[i]
			local selected = p[1] == current[1] and p[2] == current[2] and p[3] == current[3]
			if selected then
				stroke.Color = WHITE
				stroke.Thickness = 2
				stroke.Transparency = 0
			else
				stroke.Color = C.PopupBorder
				stroke.Thickness = 1
				stroke.Transparency = 0.1
			end
		end
	end

	for i, p in ipairs(PRESETS) do
		local col = (i - 1) % COLS
		local row = math.floor((i - 1) / COLS)
		local swatch = Util.create("TextButton", {
			Name = "Pastille",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(p[1], p[2], p[3]),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(PAD + col * (SW + GAP), yGrid + row * (SW + GAP)),
			Size = UDim2.fromOffset(SW, SW),
			Parent = frame,
		})
		Util.corner(swatch, 6)
		swatchStrokes[i] = Util.stroke(swatch, C.PopupBorder, 1, 0.1)
		maid:give(swatch.MouseButton1Click:Connect(function()
			current = { p[1], p[2], p[3] }
			refresh()
		end))
	end

	local names = { "R", "V", "B" }
	local groupGap = 8
	local groupW = math.floor((gridW - 2 * groupGap) / 3)
	for i = 1, 3 do
		local gx = PAD + (i - 1) * (groupW + groupGap)
		makeLabel({
			Text = names[i],
			Font = FONT_BOLD,
			TextColor3 = C.TextDim,
			Position = UDim2.fromOffset(gx, yFields),
			Size = UDim2.fromOffset(14, 28),
			Parent = frame,
		})
		local box = Util.create("TextBox", {
			Name = "Champ" .. names[i],
			Text = tostring(current[i]),
			ClearTextOnFocus = false,
			BackgroundColor3 = C.FieldBg,
			BorderSizePixel = 0,
			TextColor3 = C.Text,
			Font = FONT,
			TextSize = TEXT_SIZE,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(gx + 17, yFields),
			Size = UDim2.fromOffset(groupW - 17, 28),
			Parent = frame,
		})
		Util.corner(box, 6)
		local boxStroke = Util.stroke(box, C.PopupBorder, 1)
		fields[i] = box
		maid:give(box.Focused:Connect(function()
			boxStroke.Color = C.Accent
			boxStroke.Thickness = 2
		end))
		maid:give(box.FocusLost:Connect(function()
			boxStroke.Color = C.PopupBorder
			boxStroke.Thickness = 1
			local n = Util.parseNumber(box.Text)
			if n then
				current[i] = math.floor(Util.clamp(n, 0, 255) + 0.5)
			end
			-- mise à jour différée : on ne touche pas au champ pendant son propre FocusLost
			task.defer(function()
				if box.Parent then
					refresh()
				end
			end)
		end))
	end

	local function readFields()
		for i = 1, 3 do
			local n = Util.parseNumber(fields[i].Text)
			if n then
				current[i] = math.floor(Util.clamp(n, 0, 255) + 0.5)
			end
		end
	end

	local buttonW = math.floor((gridW - 8) / 2)
	local cancelButton = makeButton(
		frame,
		"Annuler",
		"normal",
		UDim2.fromOffset(PAD, yButtons),
		UDim2.fromOffset(buttonW, MODAL_BUTTON_H),
		maid
	)
	local okButton = makeButton(
		frame,
		"OK",
		"primary",
		UDim2.fromOffset(PAD + buttonW + 8, yButtons),
		UDim2.fromOffset(gridW - buttonW - 8, MODAL_BUTTON_H),
		maid
	)
	maid:give(cancelButton.MouseButton1Click:Connect(function()
		self:_closePopup()
	end))
	maid:give(okButton.MouseButton1Click:Connect(function()
		readFields()
		local result = { current[1], current[2], current[3] }
		self:_closePopup()
		safeCall(onChoose, result)
	end))

	refresh()
	-- ouverture : le sélecteur grandit depuis son coin haut-gauche en apparaissant
	appear(frame, 0.12)
end

---------------------------------------------------------------------------
-- Fenêtres modales
---------------------------------------------------------------------------

-- Ferme la fenêtre modale tout de suite (plus aucun bouton ne répond) ; son dessin s'efface en
-- 0,1 s s'il n'a pas trop de descendants, sinon il disparaît d'un coup
function Dialogs:_closeModal()
	local modal = self._modal
	if not modal then
		return
	end
	self._modal = nil
	modal.maid:clean()
	local overlay = modal.overlay
	modal.overlay = nil
	if overlay == nil then
		return
	end
	local function destroy()
		pcall(function()
			overlay:Destroy()
		end)
	end
	if self._destroyed or not Anim.enabled() or overlay.Parent == nil or not fadeFits(overlay) then
		destroy()
		return
	end
	-- (le fond et la fenêtre ne captent plus les clics pendant le fondu)
	pcall(function()
		overlay.Active = false
		overlay.Interactable = false
	end)
	Anim.fadeOut(overlay, 0.1, destroy)
end

-- spec = { title, message, width, input = texte par défaut (ou nil), placeholder,
--          closable = bool (× + clic sur le fond ferme), buttons = { {text, style, action} } }
function Dialogs:_openModal(spec)
	self:_closePopup()
	self:_closeModal()
	self:hideTooltip()

	local maid = Util.Maid.new()
	local modal = { maid = maid }
	local layerW, layerH = self:_layerSize()

	-- Fond semi-transparent qui bloque les clics vers l'éditeur
	local overlay = Util.create("TextButton", {
		Name = "FondModal",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		BackgroundColor3 = C.Overlay,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_MODAL,
		Parent = self.layer,
	})
	-- (pas dans le maid : _closeModal le détruit après son fondu de fermeture)
	modal.overlay = overlay
	tween(overlay, 0.12, { BackgroundTransparency = 0.45 })

	local PAD = MODAL_PAD
	local boxW = math.min(spec.width or 420, layerW - 24)
	boxW = math.max(boxW, math.min(260, layerW - 8))
	local innerW = boxW - PAD * 2
	local title = tostring(spec.title or "")
	local message = tostring(spec.message or "")
	local hasInput = spec.input ~= nil
	local closable = spec.closable == true

	-- La fenêtre est un bouton : un clic à l'intérieur ne traverse pas jusqu'au fond
	local box = Util.create("TextButton", {
		Name = "Fenetre",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(boxW, 120),
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Parent = overlay,
	})
	Util.corner(box, POPUP_RADIUS)
	Util.stroke(box, C.PopupBorder, 1)

	local titleW = innerW
	if closable then
		titleW -= 34
	end
	makeLabel({
		Name = "Titre",
		Text = title,
		Font = FONT_BOLD,
		TextSize = MODAL_TITLE_SIZE,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(PAD, PAD),
		Size = UDim2.fromOffset(titleW, MODAL_TITLE_H),
		Parent = box,
	})

	local function closeThis()
		if self._modal == modal then
			self:_closeModal()
		end
	end

	if closable then
		local closeButton = Util.create("TextButton", {
			Name = "Fermer",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.PopupHover,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(PAD - 6), 0, PAD - 2),
			Size = UDim2.fromOffset(28, 28),
			Parent = box,
		})
		Util.corner(closeButton, 7)
		makeLabel({
			Text = "×",
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = closeButton,
		})
		maid:give(closeButton.MouseEnter:Connect(function()
			closeButton.BackgroundTransparency = 0
		end))
		maid:give(closeButton.MouseLeave:Connect(function()
			closeButton.BackgroundTransparency = 1
		end))
		maid:give(closeButton.MouseButton1Click:Connect(closeThis))
		maid:give(overlay.MouseButton1Click:Connect(closeThis))
	end

	local y = PAD + MODAL_TITLE_H + 12

	-- Message (plusieurs paragraphes possibles) dans une zone qui défile si besoin
	if message ~= "" then
		local scroll = Util.create("ScrollingFrame", {
			Name = "Message",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(PAD, y),
			Size = UDim2.fromOffset(innerW + 6, 40),
			CanvasSize = UDim2.new(),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 0,
			ScrollBarImageColor3 = C.ButtonActive,
			Parent = box,
		})
		local contentH = buildMessage(scroll, message, innerW - 8)
		local reserved = 2 * PAD + MODAL_TITLE_H + 12 + 16 + MODAL_BUTTON_H + 48
		if hasInput then
			reserved += MODAL_INPUT_H + 18
		end
		local maxMsgH = math.max(60, layerH - reserved)
		local msgH = math.min(contentH, maxMsgH)
		scroll.Size = UDim2.fromOffset(innerW + 6, msgH)
		scroll.CanvasSize = UDim2.fromOffset(0, contentH + 2)
		if contentH > msgH then
			scroll.ScrollBarThickness = 6
		end
		y += msgH + 16
	end

	local input = nil
	if hasInput then
		input = Util.create("TextBox", {
			Name = "Saisie",
			Text = tostring(spec.input),
			PlaceholderText = tostring(spec.placeholder or ""),
			PlaceholderColor3 = C.TextDisabled,
			ClearTextOnFocus = false,
			BackgroundColor3 = C.FieldBg,
			BorderSizePixel = 0,
			TextColor3 = C.Text,
			Font = FONT,
			TextSize = TEXT_SIZE + 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClipsDescendants = true,
			Position = UDim2.fromOffset(PAD, y),
			Size = UDim2.fromOffset(innerW, MODAL_INPUT_H),
			Parent = box,
		})
		Util.corner(input, 8)
		local inputStroke = Util.stroke(input, C.PopupBorder, 1)
		Util.create("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
			Parent = input,
		})
		-- Champ actif : contour bleu de 2 px
		maid:give(input.Focused:Connect(function()
			inputStroke.Color = C.Accent
			inputStroke.Thickness = 2
		end))
		maid:give(input.FocusLost:Connect(function()
			inputStroke.Color = C.PopupBorder
			inputStroke.Thickness = 1
		end))
		y += MODAL_INPUT_H + 18
	end
	modal.input = input

	-- Boutons alignés à droite (le dernier de la liste est le plus à droite)
	local buttons = spec.buttons or {}
	local right = boxW - PAD
	for i = #buttons, 1, -1 do
		local b = buttons[i]
		local text = tostring(b.text or "OK")
		local bw = math.max(88, textWidth(text, TEXT_SIZE, FONT_BOLD) + 32)
		right -= bw
		local button = makeButton(
			box,
			text,
			b.style or "normal",
			UDim2.fromOffset(right, y),
			UDim2.fromOffset(bw, MODAL_BUTTON_H),
			maid
		)
		right -= 8
		local action = b.action
		maid:give(button.MouseButton1Click:Connect(function()
			if type(action) == "function" then
				action()
			end
		end))
	end
	y += MODAL_BUTTON_H + PAD
	box.Size = UDim2.fromOffset(boxW, y)

	self._modal = modal
	-- la fenêtre « se pose » : elle grandit depuis son centre (92 % -> 100 %) en apparaissant
	appear(box, 0.14)

	if input then
		-- Focus différé : la fenêtre doit exister avant de capturer le clavier
		task.defer(function()
			if self._modal == modal and input.Parent then
				pcall(function()
					input:CaptureFocus()
					input.CursorPosition = #input.Text + 1
					input.SelectionStart = 1
				end)
			end
		end)
	end
	return modal
end

-- Demande un texte. onOk(texte) est appelé avec le texte saisi (OK ou touche Entrée).
function Dialogs:prompt(title, message, defaultText, onOk)
	if self._destroyed then
		return
	end
	local modal
	local function submit()
		if not modal or self._modal ~= modal then
			return
		end
		local text = ""
		if modal.input then
			text = modal.input.Text
		end
		self:_closeModal()
		safeCall(onOk, text)
	end
	local function cancel()
		if modal and self._modal == modal then
			self:_closeModal()
		end
	end
	modal = self:_openModal({
		title = title,
		message = message,
		input = tostring(defaultText or ""),
		buttons = {
			{ text = "Annuler", style = "normal", action = cancel },
			{ text = "OK", style = "primary", action = submit },
		},
	})
	if modal.input then
		modal.maid:give(modal.input.FocusLost:Connect(function(enterPressed, inputObject)
			if self._modal ~= modal then
				return
			end
			-- Jamais de destruction du champ pendant son propre FocusLost : on diffère.
			if enterPressed then
				task.defer(submit)
			elseif inputObject and inputObject.KeyCode == Enum.KeyCode.Escape then
				task.defer(cancel)
			end
		end))
	end
end

-- Demande une confirmation. onYes() est appelé seulement si l'utilisateur confirme.
-- danger (facultatif, extension) : bouton « oui » rouge ; deviné d'après le libellé sinon.
function Dialogs:confirm(title, message, onYes, yesLabel, noLabel, danger)
	if self._destroyed then
		return
	end
	local yesText = yesLabel or "Oui"
	local yesStyle = "primary"
	if danger == true or (danger == nil and looksDangerous(yesText)) then
		yesStyle = "danger"
	end
	local modal
	modal = self:_openModal({
		title = title,
		message = message,
		buttons = {
			{
				text = noLabel or "Annuler",
				style = "normal",
				action = function()
					if self._modal == modal then
						self:_closeModal()
					end
				end,
			},
			{
				text = yesText,
				style = yesStyle,
				action = function()
					if self._modal == modal then
						self:_closeModal()
						safeCall(onYes)
					end
				end,
			},
		},
	})
end

-- Message avec un bouton OK (utilisé par « Aide »). Plusieurs paragraphes possibles ; les longs
-- textes défilent. Lignes « 1. TITRE » en titres, lignes « • … » en puces.
function Dialogs:alert(title, message)
	if self._destroyed then
		return
	end
	local text = tostring(message or "")
	local width = 440
	if #text > 300 then
		width = 640
	end
	local modal
	modal = self:_openModal({
		title = title,
		message = text,
		width = width,
		closable = true,
		buttons = {
			{
				text = "OK",
				style = "primary",
				action = function()
					if self._modal == modal then
						self:_closeModal()
					end
				end,
			},
		},
	})
end

---------------------------------------------------------------------------
-- Info-bulle
---------------------------------------------------------------------------

-- Prépare le texte de l'info-bulle ; renvoie sa largeur et sa hauteur (ou nil si texte vide)
function Dialogs:_prepareTooltip(text)
	if self._destroyed or not self.tip then
		return nil
	end
	if type(text) ~= "string" or text == "" then
		self:hideTooltip()
		return nil
	end
	local m = measureWrapped(text, 12, FONT, TOOLTIP_MAX_W)
	local w = m.X + 4 + 18
	local h = m.Y + 2 + 12
	self.tipLabel.Text = text
	self.tipLabel.Size = UDim2.fromOffset(m.X + 4, m.Y + 2)
	self.tip.Size = UDim2.fromOffset(w, h)
	return w, h
end

function Dialogs:_showTooltipAt(x, y, w, h)
	local layerW, layerH = self:_layerSize()
	x = Util.clamp(x, 4, math.max(4, layerW - w - 4))
	y = Util.clamp(y, 4, math.max(4, layerH - h - 4))
	self.tip.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	local wasVisible = self.tip.Visible
	self.tip.Visible = true
	-- l'info-bulle apparaît en fondu (0,1 s) ; déjà affichée, elle se déplace simplement
	if not wasVisible then
		Anim.fadeIn(self.tip, 0.1)
	end
end

-- Info-bulle près d'un point écran (en général la souris)
function Dialogs:tooltip(text, screenPos)
	local w, h = self:_prepareTooltip(text)
	if not w then
		return
	end
	local p = self:_localPoint(screenPos or self:_mousePosition())
	local layerW, layerH = self:_layerSize()
	local x, y = p.X + 14, p.Y + 20
	if x + w > layerW - 4 then
		x = p.X - w - 10
	end
	if y + h > layerH - 4 then
		y = p.Y - h - 8
	end
	self:_showTooltipAt(x, y, w, h)
end

-- Extension : info-bulle juste sous un GuiObject (boutons de la barre d'outils)
function Dialogs:tooltipBelow(text, guiObject)
	if typeof(guiObject) ~= "Instance" or not guiObject:IsA("GuiObject") then
		self:tooltip(text)
		return
	end
	local w, h = self:_prepareTooltip(text)
	if not w then
		return
	end
	local p = self:_localPoint(guiObject.AbsolutePosition)
	local size = guiObject.AbsoluteSize
	local _, layerH = self:_layerSize()
	local x = p.X
	local y = p.Y + size.Y + 6
	if y + h > layerH - 4 then
		y = p.Y - h - 6
	end
	self:_showTooltipAt(x, y, w, h)
end

function Dialogs:hideTooltip()
	if self.tip then
		self.tip.Visible = false
	end
end

---------------------------------------------------------------------------
-- Notifications (toasts)
---------------------------------------------------------------------------

-- Retire une notification de la liste. animated = true : la carte s'efface et sa place se referme
-- (les notifications au-dessus glissent à leur place), puis elle est détruite.
function Dialogs:_removeToast(entry, animated)
	for i, e in ipairs(self._toasts) do
		if e == entry then
			table.remove(self._toasts, i)
			break
		end
	end
	local slot = entry.frame
	if slot == nil then
		return
	end
	entry.frame = nil
	if not animated or self._destroyed or not Anim.enabled() or slot.Parent == nil then
		slot:Destroy()
		return
	end
	for _, t in ipairs(entry.targets or {}) do
		local props = {}
		props[t[2]] = 1
		tween(t[1], 0.25, props)
	end
	Anim.tween(slot, { Size = UDim2.fromOffset(entry.w or 0, 0) }, 0.3, "quadIn", function()
		pcall(function()
			slot:Destroy()
		end)
	end)
end

-- kind : "info" | "success" | "warning" | "error" ; duration en secondes (facultatif)
-- La notification monte du bas en apparaissant (les autres lui font de la place en glissant vers le
-- haut), la coche d'une réussite « saute », puis elle s'efface après « duration » secondes.
function Dialogs:toast(text, kind, duration)
	if self._destroyed then
		return
	end
	text = tostring(text or "")
	if not KIND_COLORS[kind] then
		kind = "info"
	end
	local defaultDuration = 3.5
	if kind == "error" or kind == "warning" then
		defaultDuration = 5
	end
	duration = tonumber(duration) or defaultDuration
	local color = C[KIND_COLORS[kind]] or C.Info

	local m = measureWrapped(text, TEXT_SIZE, FONT, TOAST_MAX_TEXT_W)
	local textW = m.X + 4
	local w = 16 + 4 + 12 + 20 + 8 + textW + 16
	local h = math.max(44, m.Y + 24)
	local slotH = h + TOAST_GAP

	-- Place de la notification dans la pile (sa hauteur s'anime) ; la carte est posée en bas de sa place
	self._toastOrder += 1
	local slot = Util.create("Frame", {
		Name = "Notification",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromOffset(w, slotH),
		LayoutOrder = self._toastOrder,
		Parent = self.toastArea,
	})
	local frame = Util.create("Frame", {
		Name = "Carte",
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Active = false,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.fromOffset(w, h),
		Parent = slot,
	})
	Util.corner(frame, 10)
	local stroke = Util.stroke(frame, C.PopupBorder, 1, 0)
	-- Barre colorée de 4 px à gauche
	local bar = Util.create("Frame", {
		Name = "Barre",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 9),
		Size = UDim2.new(0, 4, 1, -18),
		Parent = frame,
	})
	Util.corner(bar, 2)
	local icon = makeLabel({
		Name = "Icone",
		Text = KIND_ICONS[kind],
		TextColor3 = C[KIND_TEXT_COLORS[kind]] or C.Text,
		Font = FONT_BOLD,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 34, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		Parent = frame,
	})
	local msg = makeLabel({
		Name = "Texte",
		Text = text,
		TextWrapped = true,
		Position = UDim2.fromOffset(52, 12),
		Size = UDim2.new(0, textW, 1, -24),
		Parent = frame,
	})

	local targets = {
		{ frame, "BackgroundTransparency", 0 },
		{ bar, "BackgroundTransparency", 0 },
		{ stroke, "Transparency", 0 },
		{ icon, "TextTransparency", 0 },
		{ msg, "TextTransparency", 0 },
	}
	local entry = { frame = slot, targets = targets, w = w }
	table.insert(self._toasts, entry)
	while #self._toasts > TOAST_MAX_COUNT do
		self:_removeToast(self._toasts[1], true)
	end

	-- Arrivée : la place s'ouvre, la carte monte du bas et apparaît en fondu
	if Anim.enabled() then
		slot.Size = UDim2.fromOffset(w, 0)
		Anim.tween(slot, { Size = UDim2.fromOffset(w, slotH) }, 0.25, "quintOut")
		frame.Position = UDim2.new(0, 0, 1, math.floor(h * 0.6))
		Anim.tween(frame, { Position = UDim2.new(0, 0, 1, 0) }, 0.3, "quintOut")
		for _, t in ipairs(targets) do
			local target = t[1]
			target[t[2]] = 1
		end
		for _, t in ipairs(targets) do
			local props = {}
			props[t[2]] = t[3]
			tween(t[1], 0.18, props)
		end
		if kind == "success" then
			Anim.popIn(icon, 0.4)
		end
	end

	-- Départ en douceur après « duration » secondes
	task.delay(duration, function()
		if self._destroyed or entry.frame == nil or slot.Parent == nil then
			return
		end
		self:_removeToast(entry, true)
	end)
end

---------------------------------------------------------------------------
-- Général
---------------------------------------------------------------------------

function Dialogs:closeAll()
	self:_closePopup()
	self:_closeModal()
	self:hideTooltip()
end

function Dialogs:isOpen()
	return self._popup ~= nil or self._modal ~= nil
end

function Dialogs:destroy()
	if self._destroyed then
		return
	end
	-- (marqué détruit d'abord : la fenêtre modale disparaît sans fondu)
	self._destroyed = true
	self:closeAll()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	for _, entry in ipairs(self._toasts) do
		if entry.frame then
			entry.frame:Destroy()
			entry.frame = nil
		end
	end
	self._toasts = {}
	if self.toastArea then
		self.toastArea:Destroy()
		self.toastArea = nil
	end
	if self.tip then
		self.tip:Destroy()
		self.tip = nil
	end
end

return Dialogs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">ErrorWatcher</string><ProtectedString name="Source"><![CDATA[-- ErrorWatcher : surveille les erreurs des scripts Blocs FR pendant un test (SPEC §17).
-- Il tourne dans les DataModels de jeu (Jouer / Lancer), côté serveur ET côté client : pour chaque
-- erreur d'un script qui porte l'attribut « BlocsFR », il retrouve le bloc fautif grâce à la table
-- des lignes « BlocsFR_Lignes » (écrite par Storage), explique l'erreur en français dans la sortie et
-- l'ajoute au réglage du plugin « BlocsFR_ErreursTest », que l'éditeur (DataModel d'édition) relit.
--
-- API :
--   ErrorWatcher.SETTING = "BlocsFR_ErreursTest"
--   ErrorWatcher.start(plugin) -> stop()   (ne fait rien hors d'un test : RunService:IsRunning())
--   ErrorWatcher.explain(message) -> explicationFR, titreFR   (= Detecteur.explain)
--   ErrorWatcher.read(source) -> records          source = plugin | host (host.getSetting) | function(key)
--   ErrorWatcher.clear(target)                    target = plugin | host (host.setSetting) | function(key, value)
--   ErrorWatcher.toProblems(records, scriptPath?) -> problèmes du détecteur (source = "test")
--
-- record = { id, time = os.time(), script = "Workspace.Porte.BlocsServeur", line, blockId, label,
--            message (erreur Luau d'origine), explication, side = "serveur"|"local",
--            count (NOTE: en plus de la SPEC : nombre de répétitions), def (NOTE: id de définition) }
-- NOTE: « script » est le chemin du projet : pour une copie faite pendant le test (clone d'un modèle
-- de ServerStorage…) ou un script déjà détruit, c'est l'attribut « BlocsFR_Chemin » écrit par Storage
-- (voir projectPath) ; le chemin pendant le test n'apparaît alors que dans la sortie (warn).
--
-- NOTE: la liste est vidée au démarrage du test par le DataModel SERVEUR seulement ; chaque écriture
-- relit la liste juste avant (lecture-modification-écriture) pour que le client et le serveur ne
-- s'écrasent pas. Les ids ne repartent jamais de 1 : le dernier id est gardé dans le réglage
-- « BlocsFR_ErreursTest_Compteur » (l'éditeur peut donc repérer les nouveaux enregistrements).
-- NOTE: une même erreur répétée (par exemple « À chaque image ») n'est enregistrée qu'une fois :
-- son compteur « count » augmente ; les écritures sont regroupées (au plus une toutes les 0,3 s).
--
-- Scripts modules (SPEC §20) : une erreur levée dans une fonction d'un module arrive avec le script
-- APPELANT comme « script » (ou un script qui n'est pas de Blocs FR). On lit donc chaque emplacement
-- « Chemin:12: » du message (le dernier préfixe est le plus profond) et chaque ligne de la pile
-- (« Chemin:12 function f » ou « Script 'Chemin', Line 12 »), on retrouve l'objet de chaque chemin,
-- et on garde le plus profond qui est un script Blocs FR (Script, LocalScript ou ModuleScript) et dont
-- la ligne correspond à un bloc. record.script est alors le chemin de ce script (le module).
-- NOTE: en plus de la SPEC, l'enregistrement garde aussi l'appelant Blocs FR le plus proche dans un
-- AUTRE script (s'il y en a un) : via (chemin du projet), viaBlockId, viaLabel, viaLine. Ainsi le
-- projet qui a appelé la fonction peut montrer l'erreur sur son bloc « appeler la fonction … ».

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Registry = require(script.Parent.Registry)
local Detecteur = require(script.Parent.Detecteur)

local ErrorWatcher = {}

ErrorWatcher.SETTING = "BlocsFR_ErreursTest"
ErrorWatcher.COUNTER_SETTING = "BlocsFR_ErreursTest_Compteur"
ErrorWatcher.LINES_NAME = "BlocsFR_Lignes"
ErrorWatcher.ATTR = "BlocsFR"
ErrorWatcher.ORIGIN_ATTR = "BlocsFR_Chemin" -- (= Storage.ORIGIN_ATTR) chemin du script à l'enregistrement
ErrorWatcher.MAX_RECORDS = 50
ErrorWatcher.FLUSH_DELAY = 0.3

local MAX_MESSAGE = 400
local MAX_PENDING = 50
local MAX_LOCATIONS = 30 -- emplacements « Chemin:ligne » lus au plus dans une erreur
local MAX_PATH_TRIES = 200 -- recherches FindFirstChild au plus pour retrouver un chemin
local MISS_TTL = 2 -- secondes pendant lesquelles un chemin introuvable n'est pas recherché à nouveau

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local function oneLine(value, maxLen)
	local s = string.gsub(tostring(value or ""), "%c+", " ")
	s = string.gsub(s, "^%s+", "")
	s = string.gsub(s, "%s+$", "")
	maxLen = maxLen or MAX_MESSAGE
	if #s > maxLen then
		local cut = maxLen
		while cut > 0 do
			local b = string.byte(s, cut + 1)
			if b == nil or b < 0x80 or b >= 0xC0 then
				break
			end
			cut -= 1
		end
		s = string.sub(s, 1, cut) .. "…"
	end
	return s
end

local function escapePattern(s)
	return (string.gsub(s, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0"))
end

local function fullName(inst)
	local ok, name = pcall(function()
		return inst:GetFullName()
	end)
	if ok and type(name) == "string" then
		return name
	end
	return "?"
end

local function plainLabel(defId)
	if type(defId) ~= "string" or defId == "" then
		return nil
	end
	local okDef, def = pcall(Registry.get, defId)
	if not okDef or type(def) ~= "table" then
		return nil
	end
	local ok, text = pcall(Registry.plainLabel, def)
	if ok and type(text) == "string" then
		return text
	end
	return defId
end

---------------------------------------------------------------------------
-- Réglages du plugin (plugin, host ou fonctions)
---------------------------------------------------------------------------

local function readSetting(source, key)
	local ok, value = pcall(function()
		if type(source) == "function" then
			return source(key)
		end
		if typeof(source) == "Instance" then
			return source:GetSetting(key)
		end
		if type(source) == "table" then
			if type(source.getSetting) == "function" then
				return source.getSetting(key)
			end
			if type(source.GetSetting) == "function" then
				return source:GetSetting(key)
			end
		end
		return nil
	end)
	if ok then
		return value
	end
	return nil
end

local function writeSetting(target, key, value)
	local ok, err = pcall(function()
		if type(target) == "function" then
			target(key, value)
		elseif typeof(target) == "Instance" then
			target:SetSetting(key, value)
		elseif type(target) == "table" then
			if type(target.setSetting) == "function" then
				target.setSetting(key, value)
			elseif type(target.SetSetting) == "function" then
				target:SetSetting(key, value)
			end
		end
	end)
	if not ok then
		warn("[Blocs FR] Impossible d'enregistrer les erreurs du test : " .. tostring(err))
	end
	return ok
end

-- Liste propre (triée par id) à partir de la valeur du réglage
local function sanitizeRecords(value)
	local list = {}
	if type(value) ~= "table" then
		return list
	end
	for _, r in ipairs(value) do
		if type(r) == "table" and tonumber(r.id) ~= nil then
			local blockId = nil
			if type(r.blockId) == "string" or type(r.blockId) == "number" then
				blockId = r.blockId
			end
			local side = "serveur"
			if r.side == "local" then
				side = "local"
			end
			local record = {
				id = tonumber(r.id),
				time = tonumber(r.time) or 0,
				script = tostring(r.script or "?"),
				line = tonumber(r.line),
				blockId = blockId,
				message = oneLine(r.message, MAX_MESSAGE),
				explication = tostring(r.explication or ""),
				side = side,
				count = math.max(1, math.floor(tonumber(r.count) or 1)),
			}
			if type(r.label) == "string" and r.label ~= "" then
				record.label = r.label
			end
			if type(r.def) == "string" and r.def ~= "" then
				record.def = r.def
			end
			-- appelant Blocs FR dans un autre script (erreur dans une fonction de module)
			if type(r.via) == "string" and r.via ~= "" then
				record.via = r.via
				if type(r.viaBlockId) == "string" or type(r.viaBlockId) == "number" then
					record.viaBlockId = r.viaBlockId
				end
				if type(r.viaLabel) == "string" and r.viaLabel ~= "" then
					record.viaLabel = r.viaLabel
				end
				record.viaLine = tonumber(r.viaLine)
			end
			table.insert(list, record)
		end
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

-- Copie compatible avec SetSetting (aucune valeur nil au milieu, que des textes et des nombres)
local function storable(record)
	local out = {
		id = record.id,
		time = record.time,
		script = record.script,
		message = record.message,
		explication = record.explication,
		side = record.side,
		count = record.count,
	}
	if record.line ~= nil then
		out.line = record.line
	end
	if record.blockId ~= nil then
		out.blockId = record.blockId
	end
	if record.label ~= nil then
		out.label = record.label
	end
	if record.def ~= nil then
		out.def = record.def
	end
	if record.via ~= nil then
		out.via = record.via
		if record.viaBlockId ~= nil then
			out.viaBlockId = record.viaBlockId
		end
		if record.viaLabel ~= nil then
			out.viaLabel = record.viaLabel
		end
		if record.viaLine ~= nil then
			out.viaLine = record.viaLine
		end
	end
	return out
end

function ErrorWatcher.read(source)
	return sanitizeRecords(readSetting(source, ErrorWatcher.SETTING))
end

function ErrorWatcher.clear(target)
	return writeSetting(target, ErrorWatcher.SETTING, {})
end

function ErrorWatcher.explain(message)
	return Detecteur.explain(message)
end

-- Enregistrements -> problèmes du détecteur (source "test"). scriptPath (facultatif) : chemin du
-- script ouvert dans l'éditeur ; les erreurs d'un autre script n'ont alors pas de blockId (leurs
-- ids de blocs appartiennent à un autre projet) et leur message indique le script concerné.
-- Erreur dans une fonction de module appelée par ce script (r.via == scriptPath) : elle est montrée
-- sur le bloc appelant (r.viaBlockId).
function ErrorWatcher.toProblems(records, scriptPath)
	local problems = {}
	if type(records) ~= "table" then
		return problems
	end
	for _, r in ipairs(records) do
		if type(r) == "table" then
			local sameScript = scriptPath == nil or r.script == scriptPath
			local viaHere = not sameScript and r.via ~= nil and r.via == scriptPath
			local title = "Erreur pendant le test."
			if type(r.label) == "string" and r.label ~= "" then
				title = "Erreur pendant le test : « " .. r.label .. " »."
			end
			local message = tostring(r.explication or "")
			local blockId = nil
			local line = tonumber(r.line)
			if sameScript then
				blockId = r.blockId
			elseif viaHere then
				blockId = r.viaBlockId
				line = tonumber(r.viaLine)
				title = "Erreur dans un module pendant le test."
				local inBlock = ""
				if type(r.label) == "string" and r.label ~= "" then
					inBlock = " (bloc « " .. r.label .. " »)"
				end
				message = "La fonction appelée par ce bloc s'est arrêtée sur une erreur dans le module « "
					.. tostring(r.script)
					.. " »"
					.. inBlock
					.. " : "
					.. message
					.. " Ouvre ce module pour voir le bloc en cause."
			else
				message = "Dans le script « " .. tostring(r.script) .. " » : " .. message
			end
			table.insert(problems, {
				severity = "erreur",
				source = "test",
				blockId = blockId,
				title = title,
				message = message,
				line = line,
				raw = oneLine(Detecteur.stripLocation(r.message), 300),
				side = r.side,
				script = r.script,
				count = tonumber(r.count) or 1,
				time = r.time,
				testId = r.id,
				key = "test|" .. tostring(r.id),
				order = -2,
				index = tonumber(r.id) or 0,
			})
		end
	end
	return problems
end

---------------------------------------------------------------------------
-- Table des lignes d'un script (mise en cache tant que son texte ne change pas)
---------------------------------------------------------------------------

local mapCache = setmetatable({}, { __mode = "k" })

local function normalizeEntry(e)
	if type(e) ~= "table" then
		return nil
	end
	if e.line ~= nil then
		local entry = { line = tonumber(e.line), last = tonumber(e.last) }
		if type(e.block) == "string" or type(e.block) == "number" then
			entry.block = e.block
		end
		if type(e.def) == "string" and e.def ~= "" then
			entry.def = e.def
		end
		if entry.line == nil then
			return nil
		end
		return entry
	end
	-- forme compacte [line, last, block, def]
	local line = tonumber(e[1])
	if line == nil then
		return nil
	end
	local entry = { line = line, last = tonumber(e[2]) }
	if (type(e[3]) == "string" and e[3] ~= "") or type(e[3]) == "number" then
		entry.block = e[3]
	end
	if type(e[4]) == "string" and e[4] ~= "" then
		entry.def = e[4]
	end
	return entry
end

-- Texte JSON de la table des lignes d'un script (nil si absente ou vide)
local function linesJsonOf(scriptInst)
	local okFind, holder = pcall(function()
		return scriptInst:FindFirstChild(ErrorWatcher.LINES_NAME)
	end)
	if not okFind or holder == nil then
		return nil
	end
	local okValue, json = pcall(function()
		if holder:IsA("StringValue") then
			return holder.Value
		end
		return nil
	end)
	if not okValue or type(json) ~= "string" or json == "" then
		return nil
	end
	return json
end

local function lineMapOf(scriptInst)
	local json = linesJsonOf(scriptInst)
	if json == nil then
		return nil
	end
	local cached = mapCache[scriptInst]
	if cached ~= nil and cached.json == json then
		return cached.map
	end
	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	local map = {}
	if okDecode and type(data) == "table" then
		for _, e in ipairs(data) do
			local entry = normalizeEntry(e)
			if entry ~= nil then
				table.insert(map, entry)
			end
		end
	end
	mapCache[scriptInst] = { json = json, map = map }
	return map
end

---------------------------------------------------------------------------
-- Analyse d'une erreur
---------------------------------------------------------------------------

-- Lignes candidates, de la plus profonde à la moins profonde : la ligne du message, puis la pile
local function candidateLines(message, trace, path)
	local lines = {}
	local seen = {}
	local function push(n)
		n = tonumber(n)
		if n ~= nil and not seen[n] then
			seen[n] = true
			table.insert(lines, n)
		end
	end
	local escaped = nil
	if type(path) == "string" and path ~= "" and path ~= "?" then
		escaped = escapePattern(path)
	end
	local first = nil
	if escaped then
		first = string.match(message, escaped .. ":(%d+):")
	end
	if first == nil then
		first = string.match(message, ":(%d+):")
	end
	push(first)

	local function scanTrace(onlyRelevant)
		local found = false
		for traceLine in string.gmatch(trace .. "\n", "([^\n]*)\n") do
			local relevant = true
			if onlyRelevant then
				relevant = path ~= nil and string.find(traceLine, path, 1, true) ~= nil
			end
			if relevant then
				local n = string.match(traceLine, "[Ll]ine (%d+)")
				if n == nil and escaped then
					n = string.match(traceLine, escaped .. ":(%d+)")
				end
				if n == nil then
					n = string.match(traceLine, ":(%d+)")
				end
				if n ~= nil then
					found = true
					push(n)
				end
			end
		end
		return found
	end
	if not scanTrace(true) then
		scanTrace(false)
	end
	return lines
end

-- Script Blocs FR : Script, LocalScript ou ModuleScript (SPEC §20) avec l'attribut « BlocsFR »
local function isBlocsScript(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, result = pcall(function()
		return inst:GetAttribute(ErrorWatcher.ATTR) == true
	end)
	return ok and result == true
end

-- Objet au chemin « Service.Modèle.Script » dans ce DataModel (nil si introuvable). Un nom d'objet
-- peut contenir des points : « A.B » est aussi essayé comme un seul nom (nombre d'essais limité).
local function findByPath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end
	local segments = {}
	for name in string.gmatch(path, "[^%.]+") do
		table.insert(segments, name)
	end
	if #segments == 0 then
		return nil
	end
	local budget = MAX_PATH_TRIES
	local function walk(current, index)
		if index > #segments then
			return current
		end
		local name = nil
		for last = index, #segments do
			if name == nil then
				name = segments[last]
			else
				name = name .. "." .. segments[last]
			end
			budget -= 1
			if budget < 0 then
				return nil
			end
			local childName = name
			local ok, child = pcall(function()
				return current:FindFirstChild(childName)
			end)
			if ok and child ~= nil then
				local found = walk(child, last + 1)
				if found ~= nil then
					return found
				end
			end
		end
		return nil
	end
	local found = walk(game, 1)
	if found == game then
		return nil
	end
	return found
end

-- Même chose avec un cache (les erreurs répétées, « À chaque image »…, ne refont pas la recherche)
local pathCache = setmetatable({}, { __mode = "v" })
local missCache = {}
local missCount = 0

local function resolvePath(path)
	local cached = pathCache[path]
	if cached ~= nil and fullName(cached) == path then
		return cached
	end
	local missed = missCache[path]
	if missed ~= nil and os.clock() - missed < MISS_TTL then
		return nil
	end
	local found = findByPath(path)
	if found ~= nil then
		pathCache[path] = found
		missCache[path] = nil
	else
		if missed == nil then
			missCount += 1
			if missCount > 500 then
				missCache = {}
				missCount = 1
			end
		end
		missCache[path] = os.clock()
	end
	return found
end

-- Lectures possibles de « Chemin:12 » au début de text, du chemin le plus court au plus long (un nom
-- d'objet peut contenir « :12 ») : { { path, line, stop = position du dernier chiffre }, … }.
-- messageStyle : le numéro doit être suivi de « : » (préfixe d'un message d'erreur) ; sinon (ligne
-- de la pile) d'une fin de ligne, d'un espace ou de « : ».
local function leadingLocations(text, messageStyle)
	local options = {}
	local init = 1
	for _ = 1, 6 do
		local s, e, digits = string.find(text, ":(%d+)", init)
		if s == nil then
			break
		end
		local nextChar = string.sub(text, e + 1, e + 1)
		local accepted
		if messageStyle then
			accepted = nextChar == ":"
		else
			accepted = nextChar == "" or nextChar == ":" or string.match(nextChar, "%s") ~= nil
		end
		if accepted and s > 1 then
			local path = string.match(string.sub(text, 1, s - 1), "^%s*(.-)%s*$")
			if path ~= nil and path ~= "" then
				table.insert(options, { path = path, line = tonumber(digits), stop = e })
			end
		end
		init = e + 1
	end
	return options
end

-- La lecture dont le chemin mène à un objet du jeu (sinon la plus courte), ou nil
local function bestLocation(options, resolve)
	for _, option in ipairs(options) do
		if resolve(option.path) ~= nil then
			return option
		end
	end
	return options[1]
end

-- Tous les emplacements d'une erreur, du plus profond au moins profond : { { path, line }, … }
--   * message « A:5: B:10: texte » (erreur relancée) : le DERNIER préfixe est le plus profond ;
--   * pile (« Chemin:12 function f », « Script 'Chemin', Line 12 ») : de haut en bas.
local function errorLocations(message, trace, resolve)
	local locations = {}
	local seen = {}
	local function push(path, line)
		if path == nil or line == nil or #locations >= MAX_LOCATIONS then
			return
		end
		local key = path .. ":" .. tostring(line)
		if not seen[key] then
			seen[key] = true
			table.insert(locations, { path = path, line = line })
		end
	end
	local prefixes = {}
	local rest = message
	for _ = 1, 8 do
		local option = bestLocation(leadingLocations(rest, true), resolve)
		if option == nil then
			break
		end
		table.insert(prefixes, option)
		rest = string.sub(rest, option.stop + 2)
		rest = string.gsub(rest, "^%s+", "")
	end
	for i = #prefixes, 1, -1 do
		push(prefixes[i].path, prefixes[i].line)
	end
	for traceLine in string.gmatch(trace .. "\n", "([^\n]*)\n") do
		local path, n = string.match(traceLine, "Script '(.-)', Line (%d+)")
		if path ~= nil then
			push(path, tonumber(n))
		else
			local option = bestLocation(leadingLocations(traceLine, false), resolve)
			if option ~= nil then
				push(option.path, option.line)
			end
		end
	end
	return locations
end

local copyCache = setmetatable({}, { __mode = "k" })

-- Chemin du projet d'où vient un script. L'attribut « BlocsFR_Chemin » (écrit par Storage : chemin du
-- script à l'enregistrement) remplace le chemin actuel seulement quand celui-ci ne mène pas au projet :
--   * le script n'a plus de parent (détruit avant que l'erreur soit traitée) ;
--   * c'est une copie faite pendant le test (clone d'un modèle de ServerStorage…) : l'original est
--     encore à ce chemin, avec la même table des lignes.
-- Sinon le chemin actuel est gardé (objet renommé ou déplacé sans réenregistrer : attribut périmé).
local function projectPath(scriptInst, runtimePath)
	local okAttr, origin = pcall(function()
		return scriptInst:GetAttribute(ErrorWatcher.ORIGIN_ATTR)
	end)
	if not okAttr or type(origin) ~= "string" or origin == "" or origin == runtimePath then
		return runtimePath
	end
	local okParent, parent = pcall(function()
		return scriptInst.Parent
	end)
	if okParent and parent == nil then
		return origin
	end
	local cached = copyCache[scriptInst]
	if cached == nil or cached.origin ~= origin then
		local isCopy = false
		local original = findByPath(origin)
		if original ~= nil and original ~= scriptInst and isBlocsScript(original) then
			local json = linesJsonOf(scriptInst)
			isCopy = json ~= nil and json == linesJsonOf(original)
		end
		cached = { origin = origin, isCopy = isCopy }
		copyCache[scriptInst] = cached
	end
	if cached.isCopy then
		return origin
	end
	return runtimePath
end

-- Trouve où l'erreur s'est produite : { inst, line, entry } pour l'emplacement Blocs FR le plus
-- profond (de préférence une ligne qui correspond à un bloc), puis via = l'appelant Blocs FR le plus
-- proche dans un AUTRE script (ou nil). nil si aucun script Blocs FR n'est concerné.
local function locateError(message, trace, scriptInst)
	local scriptIsBlocs = isBlocsScript(scriptInst)
	local scriptPath = nil
	if typeof(scriptInst) == "Instance" then
		scriptPath = fullName(scriptInst)
	end
	local resolved = {}
	local function resolve(path)
		if scriptPath ~= nil and path == scriptPath then
			return scriptInst
		end
		local found = resolved[path]
		if found == nil then
			found = resolvePath(path) or false
			resolved[path] = found
		end
		if found == false then
			return nil
		end
		return found
	end
	local locations = errorLocations(message, trace, resolve)

	local hit, via, firstBlocs = nil, nil, nil
	for _, loc in ipairs(locations) do
		local inst = resolve(loc.path)
		if inst ~= nil and isBlocsScript(inst) then
			if firstBlocs == nil then
				firstBlocs = { inst = inst, line = loc.line }
			end
			local entry = Detecteur.blockAtLine(lineMapOf(inst), loc.line)
			if entry ~= nil and entry.block ~= nil then
				if hit == nil then
					hit = { inst = inst, line = loc.line, entry = entry }
				elseif inst ~= hit.inst then
					via = { inst = inst, line = loc.line, entry = entry }
					break
				end
			end
		end
	end

	-- Aucun bloc trouvé par les chemins (chemin illisible, script déjà détruit…) : comme avant, les
	-- lignes qui peuvent appartenir au script de l'erreur
	if hit == nil and scriptIsBlocs then
		local lines = {}
		if #locations == 0 then
			lines = candidateLines(message, trace, scriptPath)
		else
			for _, loc in ipairs(locations) do
				local inst = resolve(loc.path)
				if inst == nil or inst == scriptInst then
					table.insert(lines, loc.line)
				end
			end
		end
		local entry = nil
		local line = lines[1]
		local lineMap = lineMapOf(scriptInst)
		if lineMap ~= nil then
			for _, n in ipairs(lines) do
				local found = Detecteur.blockAtLine(lineMap, n)
				if found ~= nil and found.block ~= nil then
					entry = found
					line = n
					break
				end
			end
		end
		-- (un module Blocs FR plus profond, même sans bloc, est préféré à une ligne sans bloc d'ici)
		if entry ~= nil or firstBlocs == nil or firstBlocs.inst == scriptInst then
			if line == nil and firstBlocs ~= nil then
				line = firstBlocs.line
			end
			hit = { inst = scriptInst, line = line, entry = entry }
		end
	end
	if hit == nil and firstBlocs ~= nil then
		hit = { inst = firstBlocs.inst, line = firstBlocs.line, entry = nil }
	end
	return hit, via, scriptPath
end

-- Construit l'enregistrement d'une erreur (sans id) ; nil si aucun script Blocs FR n'est concerné
local function describeError(message, trace, scriptInst, side)
	message = tostring(message or "")
	trace = tostring(trace or "")
	local hit, via, scriptPath = locateError(message, trace, scriptInst)
	if hit == nil then
		return nil
	end
	local inst = hit.inst
	local path = fullName(inst)
	local line = hit.line
	local defId = nil
	local blockId = nil
	if hit.entry ~= nil then
		defId = hit.entry.def
		blockId = hit.entry.block
	end
	local label = plainLabel(defId)
	local explication = Detecteur.explain(message)
	if defId == "dbg_erreur" then
		explication = "C'est le bloc « déclencher l'erreur » qui a arrêté cet événement (c'est voulu) : « "
			.. oneLine(Detecteur.stripLocation(message), 200)
			.. " ». Les blocs placés dessous n'ont pas été exécutés."
	end
	local project = projectPath(inst, path)
	local record = {
		time = os.time(),
		script = project,
		line = line,
		blockId = blockId,
		label = label,
		def = defId,
		message = oneLine(message, MAX_MESSAGE),
		explication = explication,
		side = side,
		count = 1,
	}
	if project ~= path then
		record.runtime = path -- chemin pendant le test (sortie seulement, pas enregistré)
	end
	if via ~= nil then
		-- erreur dans une fonction de module : le bloc Blocs FR qui l'a appelée (autre script)
		record.via = projectPath(via.inst, fullName(via.inst))
		record.viaBlockId = via.entry.block
		record.viaLabel = plainLabel(via.entry.def)
		record.viaLine = via.line
	elseif scriptPath ~= nil and inst ~= scriptInst then
		record.caller = scriptPath -- script appelant sans bloc connu (sortie seulement, pas enregistré)
	end
	return record
end

local function recordKey(record)
	local key = tostring(record.side) .. "|" .. tostring(record.script) .. "|" .. tostring(record.line) .. "|" .. tostring(record.message)
	if record.via ~= nil then
		-- même erreur de module, appelée depuis deux endroits : deux enregistrements
		key = key .. "|" .. tostring(record.via) .. "|" .. tostring(record.viaLine)
	end
	return key
end

---------------------------------------------------------------------------
-- Démarrage
---------------------------------------------------------------------------

-- Surveille les erreurs pendant un test. Renvoie une fonction d'arrêt (sans effet hors d'un test).
-- pluginObject = le Plugin (Main lui passe sa variable « plugin »).
function ErrorWatcher.start(pluginObject)
	local noop = function() end
	local okRunning, running = pcall(function()
		return RunService:IsRunning()
	end)
	if not okRunning or not running then
		return noop
	end
	local okServer, isServer = pcall(function()
		return RunService:IsServer()
	end)
	local side = "local"
	if okServer and isServer then
		side = "serveur"
	end

	local okContext, ScriptContext = pcall(function()
		return game:GetService("ScriptContext")
	end)
	if not okContext or ScriptContext == nil then
		return noop
	end

	-- Nouveau test : on repart d'une liste vide (seulement côté serveur, une seule fois)
	if side == "serveur" and pluginObject ~= nil then
		writeSetting(pluginObject, ErrorWatcher.SETTING, {})
	end

	local state = {
		pending = {},
		pendingByKey = {},
		warned = {},
		scheduled = false,
		stopped = false,
	}

	local function flush()
		state.scheduled = false
		if #state.pending == 0 or pluginObject == nil then
			state.pending = {}
			state.pendingByKey = {}
			return
		end
		local pending = state.pending
		state.pending = {}
		state.pendingByKey = {}
		-- lecture-modification-écriture : l'autre côté (client / serveur) a peut-être écrit entre-temps
		local list = sanitizeRecords(readSetting(pluginObject, ErrorWatcher.SETTING))
		local maxId = tonumber(readSetting(pluginObject, ErrorWatcher.COUNTER_SETTING)) or 0
		for _, r in ipairs(list) do
			if r.id > maxId then
				maxId = r.id
			end
		end
		for _, record in ipairs(pending) do
			local key = recordKey(record)
			local existing = nil
			for _, r in ipairs(list) do
				if recordKey(r) == key then
					existing = r
					break
				end
			end
			if existing ~= nil then
				existing.count = (existing.count or 1) + (record.count or 1)
				existing.time = record.time
			else
				maxId += 1
				record.id = maxId
				table.insert(list, record)
			end
		end
		while #list > ErrorWatcher.MAX_RECORDS do
			table.remove(list, 1)
		end
		local out = {}
		for i, r in ipairs(list) do
			out[i] = storable(r)
		end
		writeSetting(pluginObject, ErrorWatcher.SETTING, out)
		writeSetting(pluginObject, ErrorWatcher.COUNTER_SETTING, maxId)
	end

	local function schedule()
		if state.scheduled or state.stopped then
			return
		end
		state.scheduled = true
		task.delay(ErrorWatcher.FLUSH_DELAY, function()
			if not state.stopped then
				flush()
			end
		end)
	end

	local function onError(message, trace, scriptInst)
		if state.stopped then
			return
		end
		local record = describeError(message, trace, scriptInst, side)
		if record == nil then
			return
		end
		local key = recordKey(record)
		if not state.warned[key] then
			state.warned[key] = true
			local where = record.script
			if record.runtime ~= nil then
				where = record.runtime .. ", projet " .. record.script
			end
			where = where .. ", ligne " .. tostring(record.line or "?")
			if record.via ~= nil then
				if record.viaLabel ~= nil then
					where = where .. " ; appelé par le bloc « " .. record.viaLabel .. " » de " .. record.via .. ", ligne " .. tostring(record.viaLine or "?")
				else
					where = where .. " ; appelé depuis " .. record.via
				end
			elseif record.caller ~= nil then
				where = where .. " ; appelé depuis " .. record.caller
			end
			if record.label then
				warn("[Blocs FR] Erreur dans le bloc « " .. record.label .. " » (" .. where .. ") : " .. record.explication)
			else
				warn("[Blocs FR] Erreur dans le script (" .. where .. ") : " .. record.explication)
			end
		end
		local already = state.pendingByKey[key]
		if already ~= nil then
			already.count += 1
			already.time = record.time
		elseif #state.pending < MAX_PENDING then
			state.pendingByKey[key] = record
			table.insert(state.pending, record)
		end
		schedule()
	end

	local okConnect, connection = pcall(function()
		return ScriptContext.Error:Connect(function(message, trace, scriptInst)
			local ok, err = pcall(onError, message, trace, scriptInst)
			if not ok then
				warn("[Blocs FR] Surveillance des erreurs : " .. tostring(err))
			end
		end)
	end)
	if not okConnect then
		warn("[Blocs FR] Impossible de surveiller les erreurs du test : " .. tostring(connection))
		return noop
	end

	return function()
		if state.stopped then
			return
		end
		pcall(function()
			connection:Disconnect()
		end)
		pcall(flush)
		state.stopped = true
	end
end

return ErrorWatcher
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Examples</string><ProtectedString name="Source"><![CDATA[-- Examples : projets d'exemple prêts à charger dans l'éditeur de blocs (SPEC §16).
--
-- Le module renvoie un tableau (liste) d'exemples :
--   { id, title, description, mode, cible, data }
-- où `data` est un projet au format de sérialisation du Model (SPEC §6) :
--   { format = "BlocsFR", version = 1, mode, variables, tops, blocks = { bN = { def, x, y, next, sub, inputs } } }
--
-- Pour rester lisibles, les exemples sont écrits ci-dessous sous une forme compacte, puis convertis
-- au chargement du module :
--   * un bloc  = { "id_du_bloc", ENTREE = valeur, DO = { blocs… }, ELSE = { blocs… } }
--   * une valeur d'entrée est soit un littéral (nombre, texte, code d'option comme "script.Parent"
--     ou "true", couleur { r, v, b }), soit un bloc valeur branché : { "op_joindre", A = …, B = … } ;
--   * une pile = une liste de blocs (le premier est un événement).
-- Les piles sont placées l'une sous l'autre à x = 40, séparées d'environ 40 px (hauteurs estimées
-- avec les dimensions de Theme.Block).
--
-- Les ids de blocs, noms d'entrées et codes d'options sont ceux des fichiers Defs_*.lua / Shared.lua.
--
-- Ajouts de la version 2.1.0 :
--   * un bloc peut porter desactive = true (bloc désactivé, SPEC §32 : gardé dans le projet, absent du
--     code généré) ;
--   * un exemple peut avoir des notes (SPEC §29) : notes = { { pile = n, bloc = k, texte, couleur } }
--     (note collée au k-ième bloc de la pile n, 1 = l'événement) ou { libre = true, texte, x, y } ;
--   * requires = { "id_de_bloc", … } : l'exemple n'est proposé que si ces blocs existent (blocs écrits
--     en même temps par un autre fichier) ; blocOu(bloc, remplaçant) choisit un bloc de secours.

local Registry = require(script.Parent.Registry)

local MARGE = 40 -- position x des piles et y de la première pile
local ECART = 40 -- espace vertical entre deux piles
local NOTE_X = 480 -- position x des notes collées aux blocs (à droite des piles)
local NOTE_W = 230

-- Vrai si le bloc existe dans le Registry (et, si spec est donné, s'il a toutes ses entrées)
local function blocExiste(spec)
	local defId = spec
	if type(spec) == "table" then
		defId = spec[1]
	end
	local ok, def = pcall(Registry.get, defId)
	if not ok or type(def) ~= "table" then
		return false
	end
	if type(spec) == "table" then
		for cle in pairs(spec) do
			if type(cle) == "string" and cle ~= "DO" and cle ~= "ELSE" and cle ~= "desactive" then
				if Registry.inputByName(def, cle) == nil then
					return false
				end
			end
		end
	end
	return true
end

-- Le bloc s'il existe (avec ces entrées), sinon le remplaçant (blocs « Tout prêts » ajoutés en parallèle)
local function blocOu(spec, remplacant)
	if blocExiste(spec) then
		return spec
	end
	return remplacant
end

-- « brique mortelle » d'un parcours, visée par son nom : le bloc tout prêt s'il existe, sinon une zone
-- de dégâts qui retire 1000 points de vie par seconde (une vie de 100 disparaît tout de suite)
local function briqueMortelle(nom)
	return blocOu(
		{ "tp_mortel", OBJET = { "monde_objet_nomme", NOM = nom } },
		{ "tp_zone_degats", OBJ = { "monde_objet_nomme", NOM = nom }, DPS = 1000 }
	)
end

