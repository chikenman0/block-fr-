---------------------------------------------------------------------------
-- Conversion vers le format du Model
---------------------------------------------------------------------------

-- Forme d'un bloc d'après sa définition ("stack" si inconnue)
local function formeDe(defId)
	local ok, def = pcall(Registry.get, defId)
	if ok and type(def) == "table" and type(def.shape) == "string" then
		return def.shape
	end
	return "stack"
end

local function estBloc(valeur)
	return type(valeur) == "table" and type(valeur[1]) == "string"
end

-- Clés texte d'une description de bloc, triées (ordre déterministe des ids)
local function clesTriees(spec)
	local cles = {}
	for cle in pairs(spec) do
		if type(cle) == "string" then
			table.insert(cles, cle)
		end
	end
	table.sort(cles)
	return cles
end

-- Estimation des hauteurs (unités du canvas), d'après Theme.Block
local hauteurValeur
local hauteurPile

-- Hauteur du plus grand bloc valeur branché dans les entrées (0 s'il n'y en a pas)
local function hauteurInterieure(spec)
	local h = 0
	for _, cle in ipairs(clesTriees(spec)) do
		local valeur = spec[cle]
		if cle ~= "DO" and cle ~= "ELSE" and estBloc(valeur) then
			h = math.max(h, hauteurValeur(valeur))
		end
	end
	return h
end

function hauteurValeur(spec)
	local base = 26
	if formeDe(spec[1]) == "boolean" then
		base = 30
	end
	local interieur = hauteurInterieure(spec)
	if interieur > 0 then
		return math.max(base, interieur + 6)
	end
	return base
end

local function hauteurBloc(spec)
	local forme = formeDe(spec[1])
	local ligne = 36
	local interieur = hauteurInterieure(spec)
	if interieur > 0 then
		ligne = math.max(ligne, interieur + 10)
	end
	if forme == "hat" then
		return math.max(48, ligne + 12)
	elseif forme == "c" then
		return ligne + hauteurPile(spec.DO) + 16
	elseif forme == "c2" then
		return ligne + hauteurPile(spec.DO) + 30 + hauteurPile(spec.ELSE) + 16
	end
	return ligne
end

-- Hauteur d'une suite de blocs (24 = bouche vide d'un bloc C)
function hauteurPile(liste)
	if type(liste) ~= "table" or #liste == 0 then
		return 24
	end
	local h = 0
	for _, spec in ipairs(liste) do
		h += hauteurBloc(spec)
	end
	return h
end

-- Description compacte -> projet sérialisé (SPEC §6)
local function convertir(exemple)
	local blocks = {}
	local tops = {}
	local compteur = 0
	local construireSuite

	local function construireBloc(spec)
		compteur += 1
		local id = "b" .. compteur
		local entree = { def = spec[1], x = 0, y = 0 }
		blocks[id] = entree
		for _, cle in ipairs(clesTriees(spec)) do
			local valeur = spec[cle]
			if cle == "desactive" then
				-- bloc désactivé (SPEC §32)
				if valeur == true then
					entree.disabled = true
				end
			elseif cle == "DO" or cle == "ELSE" then
				local tete = construireSuite(valeur)
				if tete then
					entree.sub = entree.sub or {}
					entree.sub[cle] = tete
				end
			elseif estBloc(valeur) then
				entree.inputs = entree.inputs or {}
				entree.inputs[cle] = { block = construireBloc(valeur) }
			else
				local litteral = valeur
				if type(valeur) == "table" then
					litteral = { valeur[1], valeur[2], valeur[3] }
				end
				entree.inputs = entree.inputs or {}
				entree.inputs[cle] = { value = litteral }
			end
		end
		return id
	end

	function construireSuite(liste)
		local tete, precedent = nil, nil
		if type(liste) ~= "table" then
			return nil
		end
		for _, spec in ipairs(liste) do
			if estBloc(spec) then
				local id = construireBloc(spec)
				if precedent then
					blocks[precedent].next = id
				else
					tete = id
				end
				precedent = id
			end
		end
		return tete
	end

	local y = MARGE
	local tetes = {} -- [numéro de pile] = { id, y, pile }
	for numero, pile in ipairs(exemple.piles or {}) do
		local tete = construireSuite(pile)
		if tete then
			blocks[tete].x = MARGE
			blocks[tete].y = y
			table.insert(tops, tete)
			tetes[numero] = { id = tete, y = y, pile = pile }
			y += hauteurPile(pile) + ECART
		end
	end

	-- Notes (SPEC §29) : collées à un bloc d'une pile (à droite de la pile, à sa hauteur) ou libres
	local notes = nil
	local numeroNote = 0
	for _, spec in ipairs(exemple.notes or {}) do
		if type(spec) == "table" and type(spec.texte) == "string" then
			local note = {
				text = spec.texte,
				x = spec.x or (MARGE + NOTE_X),
				y = spec.y or MARGE,
				w = spec.w or NOTE_W,
				couleur = spec.couleur or "jaune",
			}
			local valide = true
			if spec.libre ~= true then
				local tete = tetes[spec.pile or 1]
				if tete == nil then
					valide = false
				else
					local id = tete.id
					local hauteur = tete.y
					for k = 2, spec.bloc or 1 do
						local suivant = blocks[id] and blocks[id].next
						if suivant == nil then
							break
						end
						hauteur += hauteurBloc(tete.pile[k - 1])
						id = suivant
					end
					note.blockId = id
					if spec.y == nil then
						note.y = hauteur
					end
				end
			end
			if valide then
				numeroNote += 1
				notes = notes or {}
				notes["n" .. numeroNote] = note
			end
		end
	end

	local data = {
		format = "BlocsFR",
		version = 1,
		mode = exemple.mode,
		variables = table.clone(exemple.variables or {}),
		tops = tops,
		blocks = blocks,
	}
	if notes ~= nil then
		data.notes = notes
	end
	return data
end

-- Vrai si tous les blocs demandés par l'exemple existent
local function blocsPresents(liste)
	for _, defId in ipairs(liste or {}) do
		if not blocExiste(defId) then
			return false
		end
	end
	return true
end

local Examples = {}
for _, exemple in ipairs(EXEMPLES) do
	if blocsPresents(exemple.requires) then
		local ok, data = pcall(convertir, exemple)
		if ok then
			table.insert(Examples, {
				id = exemple.id,
				title = exemple.title,
				description = exemple.description,
				mode = exemple.mode,
				cible = exemple.cible,
				data = data,
			})
		else
			warn("[Blocs FR] Exemple « " .. tostring(exemple.id) .. " » illisible : " .. tostring(data))
		end
	end
end

return Examples
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Explication</string><ProtectedString name="Source"><![CDATA[-- Explication : « Explique-moi ce script » (SPEC §28). Raconte en français ce que font les blocs, étape
-- par étape, à partir des libellés des blocs (aucune modification des fichiers Defs_*).
--
-- API :
--   Explication.explain(model, ctx) -> result
--       ctx = { mode = "server"|"local"|"module"|nil (défaut model.mode), target = Instance|nil,
--               problems = liste du détecteur|nil (NOTE: si App la donne, elle est réutilisée telle
--               quelle ; sinon Detecteur.analyze est appelé sans générer le code), guiNames = …|nil }
--       result = {
--         scripts = { { hatId, title, category, disabled = bool,
--                       steps = { { blockId, depth, text, category,
--                                   combat = true|nil, disabled = true|nil, hint = true|nil } } } },
--         warnings = { { blockId, text, severity, hatId } },  -- « Attention : … » / « Conseil : … »
--         combat = { blockId, … },        -- blocs de combat (pour « Voir la simulation 3D »)
--         stepCount = n, truncated = bool, ignored = n (piles hors d'un événement), mode = "…",
--       }
--   Explication.sentence(model, blockId) -> texte   -- la phrase d'un seul bloc (extension)
--
-- Règles : événements -> « Chaque fois que … : » (« Au démarrage : » pour « Quand ce script démarre »),
-- blocs C -> « Si … alors : », « Répète n fois : », « Pour toujours : »…, instructions -> le libellé avec
-- les vraies valeurs (libellés des menus, nombres « à la française », textes entre « », variables,
-- blocs valeur décrits à l'intérieur : « la vie du joueur »). Profondeur = imbrication dans les blocs C
-- (le corps d'un événement est au niveau 0, comme l'événement). Les blocs désactivés (block.disabled)
-- sont signalés et leur contenu n'est pas raconté. Ne lève jamais d'erreur.
-- Lignes automatiques (SPEC §36) : « envoyer le message « attaque » » ajoute « , reçu par le script
-- « Quand je reçois le message « attaque » » » (ou dit qu'aucun script de ce projet ne le reçoit ; vers
-- l'autre côté : « reçu dans les scripts locaux des joueurs par … ») ; un appel de fonction de module
-- dont « Définir la fonction » est dans ce projet le dit aussi.
-- NOTE: Detecteur.analyze peut parcourir le jeu (noms d'objets) : appeler explain hors d'un rendu,
-- ou lui passer ctx.problems (déjà calculés par App).

local Registry = require(script.Parent.Registry)
local Util = require(script.Parent.Util)

local Explication = {}

local MAX_DEPTH = 40 -- imbrication maximale des blocs C racontée
local MAX_REPORTER_DEPTH = 8 -- blocs valeur imbriqués
local MAX_STEPS_SCRIPT = 300
local MAX_STEPS_TOTAL = 1500
local MAX_WARNINGS = 60
local MAX_TEXT = 400
local MAX_CHAIN = 5000 -- garde-fou (piles circulaires dans des données abîmées)

-- Blocs de combat reconnus quand le module HitboxPreview n'est pas (encore) là
local COMBAT_FALLBACK = { tp_attaque_melee = true, tp_hitbox_degats = true, tp_hitbox = true }

-- Phrases des blocs C (mêmes %1, %2… que les libellés)
local C_TEMPLATES = {
	ctrl_repeter = "Répète %1 fois :",
	ctrl_toujours = "Pour toujours :",
	ctrl_tant_que = "Tant que %1 :",
	ctrl_repeter_jusqua = "Répète jusqu'à ce que %1 :",
	ctrl_pour = "Pour %1 allant de %2 à %3 :",
	ctrl_parallele = "En même temps que la suite :",
	ctrl_apres = "Après %1 secondes, sans bloquer la suite :",
	j_pour_chaque_joueur = "Pour chaque joueur :",
}

-- Lignes automatiques (SPEC §36), racontées dans la phrase du bloc qui envoie ou qui appelle. Mêmes
-- règles que les lignes de la zone de travail (Canvas) : nom écrit en toutes lettres, identique.
-- Message envoyé du même côté (scripts serveur entre eux, scripts locaux entre eux) : reçu par les
-- « Quand je reçois le message » de ce projet.
local SAME_SIDE_SENDERS = { ctrl_envoyer_message = true, tp_minuteur_ecran = true }
-- Message envoyé de l'autre côté (réseau) : jamais reçu par un script serveur (ou local) de ce projet ;
-- on dit donc où il arrive.
local NETWORK_SENDERS = {
	ctrl_envoyer_message_tous = "les scripts locaux des joueurs",
	ctrl_envoyer_message_joueur = "les scripts locaux de ce joueur",
	ctrl_envoyer_message_serveur = "les scripts serveur",
}
-- Appels d'une fonction de module -> « Définir la fonction » du même nom dans ce projet
local FUNCTION_CALLERS = { mod_appeler = true, mod_resultat = true }

-- Couleurs nommées (pour décrire une case couleur)
local COLOR_NAMES = {
	{ "rouge", 229, 56, 59 },
	{ "rouge", 255, 0, 0 },
	{ "rouge foncé", 140, 0, 0 },
	{ "orange", 255, 128, 0 },
	{ "jaune", 255, 215, 0 },
	{ "jaune clair", 255, 240, 160 },
	{ "vert clair", 132, 204, 22 },
	{ "vert", 0, 170, 0 },
	{ "vert foncé", 0, 100, 0 },
	{ "turquoise", 20, 184, 166 },
	{ "cyan", 0, 200, 230 },
	{ "bleu clair", 110, 175, 255 },
	{ "bleu", 0, 80, 255 },
	{ "bleu foncé", 0, 30, 140 },
	{ "violet", 140, 0, 255 },
	{ "violet clair", 200, 160, 255 },
	{ "rose", 255, 60, 190 },
	{ "rose clair", 255, 180, 220 },
	{ "marron", 120, 70, 30 },
	{ "beige", 245, 205, 160 },
	{ "blanc", 255, 255, 255 },
	{ "gris clair", 200, 200, 200 },
	{ "gris", 140, 140, 140 },
	{ "gris foncé", 70, 70, 70 },
	{ "noir", 0, 0, 0 },
}

local UPPER = {
	{ "é", "É" },
	{ "è", "È" },
	{ "ê", "Ê" },
	{ "à", "À" },
	{ "â", "Â" },
	{ "î", "Î" },
	{ "ô", "Ô" },
	{ "û", "Û" },
	{ "ç", "Ç" },
}

local VOWELS_UTF8 = { "é", "è", "ê", "à", "â", "î", "ô", "û" }

---------------------------------------------------------------------------
-- Petites fonctions de texte
---------------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Texte sur une ligne, coupé proprement (UTF-8) à maxLen octets
local function oneLine(value, maxLen)
	local s = string.gsub(tostring(value or ""), "%c+", " ")
	s = Util.trim(s)
	maxLen = maxLen or MAX_TEXT
	if #s > maxLen then
		local cut = maxLen
		while cut > 0 do
			local b = string.byte(s, cut + 1)
			if b == nil or b < 0x80 or b >= 0xC0 then
				break
			end
			cut -= 1
		end
		s = string.sub(s, 1, cut) .. "…"
	end
	return s
end

local function quote(text)
	local t = oneLine(text, 120)
	if t == "" then
		return "« »"
	end
	return "« " .. t .. " »"
end

-- Nombre écrit à la française : 0.6 -> « 0,6 »
local function frNumber(n)
	if not isFinite(n) then
		return "0"
	end
	local text
	if n == math.floor(n) and math.abs(n) < 1e15 then
		text = string.format("%d", n)
	else
		text = string.format("%.4g", n)
	end
	return (string.gsub(text, "%.", ","))
end

local function capitalize(text)
	if type(text) ~= "string" or text == "" then
		return ""
	end
	local first = string.sub(text, 1, 1)
	if string.match(first, "%l") then
		return string.upper(first) .. string.sub(text, 2)
	end
	for _, pair in ipairs(UPPER) do
		if string.sub(text, 1, #pair[1]) == pair[1] then
			return pair[2] .. string.sub(text, #pair[1] + 1)
		end
	end
	return text
end

local function lowerFirst(text)
	if type(text) ~= "string" or text == "" then
		return ""
	end
	local first = string.sub(text, 1, 1)
	local second = string.sub(text, 2, 2)
	-- (on garde les sigles en majuscules : « PNJ », « ID »…)
	if string.match(first, "%u") and not string.match(second, "%u") then
		return string.lower(first) .. string.sub(text, 2)
	end
	for _, pair in ipairs(UPPER) do
		if string.sub(text, 1, #pair[2]) == pair[2] then
			return pair[1] .. string.sub(text, #pair[2] + 1)
		end
	end
	return text
end

-- « que » + mot : « qu'un joueur », « que la touche »
local function que(rest)
	local first = string.lower(string.sub(rest, 1, 1))
	if first ~= "" and string.find("aeiouy", first, 1, true) then
		return "qu'" .. rest
	end
	for _, v in ipairs(VOWELS_UTF8) do
		if string.sub(rest, 1, #v) == v then
			return "qu'" .. rest
		end
	end
	return "que " .. rest
end

-- Petites corrections du français produit par les libellés : « de le » -> « du »…
local function cleanFrench(text)
	text = string.gsub(text, "(%s)de le ", "%1du ")
	text = string.gsub(text, "(%s)de les ", "%1des ")
	text = string.gsub(text, "(%s)à le ", "%1au ")
	text = string.gsub(text, "(%s)à les ", "%1aux ")
	text = string.gsub(text, "^de le ", "du ")
	text = string.gsub(text, "[Tt]outes les 1 secondes", "toutes les secondes")
	text = string.gsub(text, "(%s1) secondes", "%1 seconde")
	text = string.gsub(text, "(%s1) minutes", "%1 minute")
	text = string.gsub(text, "%s%s+", " ")
	return text
end

local function endsWithPunctuation(text)
	local last = string.sub(text, -1)
	if last == "." or last == "!" or last == "?" or last == ":" then
		return true
	end
	return string.sub(text, -#"…") == "…"
end

local function colorName(value)
	if type(value) ~= "table" then
		return "une couleur"
	end
	local r, g, b = tonumber(value[1]) or 0, tonumber(value[2]) or 0, tonumber(value[3]) or 0
	local best, bestDistance = "une couleur", math.huge
	for _, entry in ipairs(COLOR_NAMES) do
		local dr, dg, db = r - entry[2], g - entry[3], b - entry[4]
		local d = 2 * dr * dr + 4 * dg * dg + 3 * db * db
		if d < bestDistance then
			best, bestDistance = entry[1], d
		end
	end
	return best
end

---------------------------------------------------------------------------
-- Lecture des blocs
---------------------------------------------------------------------------

local function getDef(block)
	if type(block) ~= "table" or type(block.def) ~= "string" then
		return nil
	end
	local ok, def = pcall(Registry.get, block.def)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function inputSlot(block, name)
	if type(block) ~= "table" or type(block.inputs) ~= "table" then
		return nil
	end
	local slot = block.inputs[name]
	if type(slot) == "table" then
		return slot
	end
	return nil
end

local function literalText(block, name)
	local slot = inputSlot(block, name)
	if slot == nil then
		return nil
	end
	local value = slot.value
	if type(value) == "string" then
		return value
	end
	if isFinite(value) then
		return frNumber(value)
	end
	return nil
end

local function optionLabel(spec, code)
	for _, option in ipairs(spec.options or {}) do
		if type(option) == "table" and option[2] == code then
			return tostring(option[1])
		end
	end
	if code == nil or code == "" then
		return "(vide)"
	end
	return tostring(code)
end

local describeReporter -- (défini plus bas : récursif avec describeInput)

-- Texte d'une entrée d'un bloc : bloc valeur branché, sinon la valeur écrite
local function describeInput(E, block, spec, depth)
	local slot = inputSlot(block, spec.name)
	if slot ~= nil and slot.block ~= nil and type(E.blocks[slot.block]) == "table" then
		return describeReporter(E, slot.block, depth + 1)
	end
	local value = nil
	if slot ~= nil then
		value = slot.value
	end
	local kind = spec.kind
	if kind == "boolean" then
		return "(condition vide)"
	elseif kind == "number" then
		local n = Util.parseNumber(value)
		if n == nil then
			n = tonumber(value)
		end
		return frNumber(n or 0)
	elseif kind == "text" then
		return quote(value or "")
	elseif kind == "any" then
		if type(value) == "number" then
			return frNumber(value)
		end
		if type(value) == "string" and Util.trim(value) ~= "" then
			local n = Util.parseNumber(value)
			if n ~= nil then
				return frNumber(n)
			end
		end
		return quote(value or "")
	elseif kind == "dropdown" then
		return optionLabel(spec, value)
	elseif kind == "color" then
		return colorName(value)
	elseif kind == "variable" then
		return quote(value or "?")
	elseif kind == "gui" then
		if type(value) ~= "string" or Util.trim(value) == "" then
			return "(à choisir)"
		end
		return quote(value)
	end
	if value == nil then
		return "…"
	end
	return oneLine(value, 80)
end

-- Remplace %1…%9 d'un modèle de phrase par les entrées du bloc
local function fill(E, block, def, template, depth)
	local inputs = def.inputs or {}
	local result = string.gsub(template, "%%(%d)", function(digit)
		local spec = inputs[tonumber(digit)]
		if type(spec) ~= "table" then
			return "…"
		end
		local ok, text = pcall(describeInput, E, block, spec, depth)
		if ok and type(text) == "string" then
			return text
		end
		return "…"
	end)
	return result
end

describeReporter = function(E, id, depth)
	if depth > MAX_REPORTER_DEPTH then
		return "…"
	end
	local block = E.blocks[id]
	local def = getDef(block)
	if def == nil then
		return "(bloc inconnu)"
	end
	if def.id == "var_valeur" then
		return "la variable " .. quote(literalText(block, "VAR") or "?")
	end
	local text = fill(E, block, def, def.label, depth)
	-- opération dans une opération : entre parenthèses, « (2 + 3) × 4 »
	if depth >= 2 and string.sub(def.label, 1, 1) == "%" then
		text = "(" .. text .. ")"
	end
	return text
end

local function statementText(E, block, def)
	return capitalize(cleanFrench(fill(E, block, def, def.label, 0)))
end

local function cSentence(E, block, def)
	local template = C_TEMPLATES[def.id]
	if template then
		return cleanFrench(fill(E, block, def, template, 0))
	end
	return capitalize(cleanFrench(fill(E, block, def, def.label, 0))) .. " :"
end

-- Phrase d'un événement (étape 1) et titre de la carte du script
local function hatSentence(E, block, def)
	if def.id == "evt_demarrage" then
		return "Au démarrage :", "Quand ce script démarre"
	end
	if def.id == "mod_au_chargement" then
		return "Au chargement du module :", "Quand le module est chargé"
	end
	if def.id == "mod_fonction" then
		local nom = literalText(block, "NOM") or "?"
		local params = {}
		for _, key in ipairs({ "P1", "P2", "P3" }) do
			local p = literalText(block, key)
			if p ~= nil and Util.trim(p) ~= "" then
				table.insert(params, Util.trim(p))
			end
		end
		local text = "Quand un script appelle la fonction " .. quote(nom)
		if #params > 0 then
			text = text .. " (avec " .. table.concat(params, ", ") .. ")"
		end
		return text .. " :", "Fonction " .. quote(nom)
	end
	local filled = cleanFrench(fill(E, block, def, def.label, 0))
	local title = capitalize(filled)
	if string.sub(filled, 1, 6) == "Quand " then
		return "Chaque fois " .. que(string.sub(filled, 7)) .. " :", title
	end
	return title .. " :", title
end

---------------------------------------------------------------------------
-- Lignes automatiques (SPEC §36) : message envoyé -> reçu, appel -> fonction
---------------------------------------------------------------------------

-- Nom écrit dans une entrée, comme Canvas : nil si un bloc y est branché ou si elle est vide
local function linkName(block, name)
	local slot = inputSlot(block, name)
	if slot == nil or slot.block ~= nil then
		return nil
	end
	local value = slot.value
	if type(value) == "number" then
		value = tostring(value)
	end
	if type(value) ~= "string" or value == "" then
		return nil
	end
	return value
end

-- Arrivées des lignes dans ce projet : E.receivers[nom] = nombre de « Quand je reçois le message »,
-- E.functions[nom] = true pour « Définir la fonction » (un événement désactivé ne reçoit rien)
local function collectLinkTargets(E)
	for _, block in pairs(E.blocks) do
		if type(block) == "table" and block.disabled ~= true then
			if block.def == "evt_message" then
				local name = linkName(block, "MESSAGE")
				if name ~= nil then
					E.receivers[name] = (E.receivers[name] or 0) + 1
				end
			elseif block.def == "mod_fonction" then
				local name = linkName(block, "NOM")
				if name ~= nil then
					E.functions[name] = true
				end
			end
		end
	end
end

-- Fonctions appelées par ce bloc et par les blocs valeur branchés dedans, sans doublon, dans l'ordre
local function calledFunctions(E, block, def, depth, names, seen)
	if FUNCTION_CALLERS[def.id] then
		local name = linkName(block, "NOM")
		if name ~= nil and not seen[name] then
			seen[name] = true
			table.insert(names, name)
		end
	end
	if depth >= MAX_REPORTER_DEPTH then
		return
	end
	for _, spec in ipairs(def.inputs or {}) do
		if type(spec) == "table" then
			local slot = inputSlot(block, spec.name)
			local child = slot and slot.block and E.blocks[slot.block] or nil
			local childDef = getDef(child)
			if childDef ~= nil then
				calledFunctions(E, child, childDef, depth + 1, names, seen)
			end
		end
	end
end

-- Ce que disent les lignes automatiques qui partent de ce bloc ("" s'il n'y en a pas)
local function linkNotes(E, block, def)
	local receivers = E.receivers or {}
	local functions = E.functions or {}
	local text = ""
	if SAME_SIDE_SENDERS[def.id] or NETWORK_SENDERS[def.id] then
		local name = linkName(block, "MESSAGE")
		if name ~= nil then
			local receiver = "« Quand je reçois le message " .. quote(name) .. " »"
			local side = NETWORK_SENDERS[def.id]
			local count = receivers[name] or 0
			if side ~= nil then
				text = ", reçu dans " .. side .. " par " .. receiver
			elseif count == 1 then
				text = ", reçu par le script " .. receiver
			elseif count > 1 then
				text = ", reçu par les " .. count .. " scripts " .. receiver
			else
				text = " (aucun script " .. receiver .. " ici : seul un autre script peut le recevoir)"
			end
		end
	end
	local names = {}
	calledFunctions(E, block, def, 0, names, {})
	for _, name in ipairs(names) do
		if functions[name] then
			text = text
				.. " (la fonction "
				.. quote(name)
				.. " est définie ici : voir le script « Fonction "
				.. quote(name)
				.. " »)"
		end
	end
	return text
end

-- Phrase d'un bloc + ses lignes automatiques (avant les « : » de fin d'un bloc C)
local function withLinks(E, block, def, text)
	local ok, notes = pcall(linkNotes, E, block, def)
	if not ok or type(notes) ~= "string" or notes == "" then
		return text
	end
	local body = string.match(text, "^(.-)%s*:$")
	if body ~= nil and body ~= "" then
		return body .. notes .. " :"
	end
	return text .. notes
end

---------------------------------------------------------------------------
-- Parcours des scripts
---------------------------------------------------------------------------

local function addStep(E, steps, blockId, depth, text, category, extra)
	if E.total >= MAX_STEPS_TOTAL or #steps >= MAX_STEPS_SCRIPT then
		E.truncated = true
		return false
	end
	E.total += 1
	local step = { blockId = blockId, depth = depth, text = oneLine(text, MAX_TEXT), category = category }
	if type(extra) == "table" then
		for key, value in pairs(extra) do
			step[key] = value
		end
	end
	table.insert(steps, step)
	return true
end

local function noteCombat(E, id)
	if not E.combatSeen[id] then
		E.combatSeen[id] = true
		table.insert(E.combat, id)
	end
end

local walk -- (récursif)

local function walkBody(E, bodyId, depth, steps, ownerId, category)
	if bodyId == nil then
		addStep(E, steps, ownerId, depth, "(rien à l'intérieur)", category, { hint = true })
		return
	end
	walk(E, bodyId, depth, steps)
end

walk = function(E, headId, depth, steps)
	local current = headId
	local guard = 0
	while current ~= nil and guard < MAX_CHAIN do
		guard += 1
		if E.visited[current] then
			break
		end
		E.visited[current] = true
		local block = E.blocks[current]
		if type(block) ~= "table" then
			break
		end
		local def = getDef(block)
		if def == nil then
			addStep(E, steps, current, depth, "Bloc inconnu (« " .. tostring(block.def) .. " ») : il est ignoré.", nil, { hint = true })
		elseif block.disabled == true then
			addStep(E, steps, current, depth, statementText(E, block, def) .. " — bloc désactivé : il est ignoré.", def.category, { disabled = true })
		else
			local combat = E.isCombat(def.id)
			local extra = nil
			if combat then
				extra = { combat = true }
				noteCombat(E, current)
			end
			if def.shape == "c" or def.shape == "c2" then
				addStep(E, steps, current, depth, withLinks(E, block, def, cSentence(E, block, def)), def.category, extra)
				if depth < MAX_DEPTH then
					local sub = {}
					if type(block.sub) == "table" then
						sub = block.sub
					end
					walkBody(E, sub.DO, depth + 1, steps, current, def.category)
					if def.shape == "c2" then
						addStep(E, steps, current, depth, capitalize(def.label2 or "sinon") .. " :", def.category)
						walkBody(E, sub.ELSE, depth + 1, steps, current, def.category)
					end
				end
			else
				addStep(E, steps, current, depth, withLinks(E, block, def, statementText(E, block, def)), def.category, extra)
			end
		end
		if def ~= nil and (def.noNext or def.shape == "cap") then
			break
		end
		current = block.next
	end
end

-- Événement de premier niveau qui contient blockId (ou nil)
local function hatOf(E, blockId)
	local current = blockId
	local guard = 0
	while current ~= nil and guard < MAX_CHAIN do
		guard += 1
		local block = E.blocks[current]
		if type(block) ~= "table" then
			return nil
		end
		if block.parent == nil then
			local def = getDef(block)
			if def ~= nil and def.shape == "hat" then
				return current
			end
			return nil
		end
		current = block.parent
	end
	return nil
end

local function finite0(x)
	local n = tonumber(x)
	if isFinite(n) then
		return n
	end
	return 0
end

-- Piles de premier niveau dans l'ordre de lecture (de haut en bas, puis de gauche à droite)
local function sortedTops(E)
	local list = {}
	for index, id in ipairs(E.tops) do
		local block = E.blocks[id]
		if type(block) == "table" then
			table.insert(list, { id = id, x = finite0(block.x), y = finite0(block.y), index = index })
		end
	end
	table.sort(list, function(p, q)
		if p.y ~= q.y then
			return p.y < q.y
		end
		if p.x ~= q.x then
			return p.x < q.x
		end
		return p.index < q.index
	end)
	return list
end

local function combatChecker()
	local folder = script.Parent
	local moduleScript = folder and folder:FindFirstChild("HitboxPreview")
	if moduleScript ~= nil then
		local ok, HitboxPreview = pcall(require, moduleScript)
		if ok and type(HitboxPreview) == "table" and type(HitboxPreview.supports) == "function" then
			return function(defId)
				if defId == "libre" then
					return false
				end
				local okSupports, result = pcall(HitboxPreview.supports, defId)
				if okSupports then
					return result == true
				end
				return COMBAT_FALLBACK[defId] == true
			end
		end
	end
	return function(defId)
		return COMBAT_FALLBACK[defId] == true
	end
end

local function collectWarnings(E, model, ctx)
	local problems = ctx.problems
	if type(problems) ~= "table" then
		problems = nil
		local folder = script.Parent
		local moduleScript = folder and folder:FindFirstChild("Detecteur")
		if moduleScript ~= nil then
			local ok, Detecteur = pcall(require, moduleScript)
			if ok and type(Detecteur) == "table" and type(Detecteur.analyze) == "function" then
				local okAnalyze, list = pcall(Detecteur.analyze, model, {
					mode = E.mode,
					target = ctx.target,
					guiNames = ctx.guiNames,
					generate = false,
				})
				if okAnalyze and type(list) == "table" then
					problems = list
				end
			end
		end
	end
	local warnings = {}
	if problems == nil then
		return warnings
	end
	local seen = {}
	for _, problem in ipairs(problems) do
		if #warnings >= MAX_WARNINGS then
			break
		end
		if type(problem) == "table" then
			local prefix = "Attention : "
			if problem.source == "test" then
				prefix = "Pendant le test : "
			elseif problem.severity == "conseil" then
				prefix = "Conseil : "
			end
			local title = oneLine(problem.title, 200)
			local message = oneLine(problem.message, 500)
			local text = prefix
			if title ~= "" then
				text = text .. lowerFirst(title)
				if not endsWithPunctuation(title) then
					text = text .. "."
				end
				if message ~= "" then
					text = text .. " " .. message
				end
			else
				text = text .. lowerFirst(message)
			end
			local blockId = problem.blockId
			if blockId ~= nil and type(E.blocks[blockId]) ~= "table" then
				blockId = nil
			end
			local key = tostring(blockId) .. "|" .. text
			if not seen[key] then
				seen[key] = true
				table.insert(warnings, {
					blockId = blockId,
					text = oneLine(text, 700),
					severity = problem.severity,
					hatId = blockId and hatOf(E, blockId) or nil,
				})
			end
		end
	end
	return warnings
end

local function explainImpl(model, ctx)
	ctx = type(ctx) == "table" and ctx or {}
	local result = {
		scripts = {},
		warnings = {},
		combat = {},
		stepCount = 0,
		truncated = false,
		ignored = 0,
		mode = "server",
	}
	if type(model) ~= "table" then
		return result
	end
	local mode = ctx.mode
	if mode ~= "server" and mode ~= "local" and mode ~= "module" then
		mode = model.mode
	end
	if mode ~= "local" and mode ~= "module" then
		mode = "server"
	end
	result.mode = mode

	local E = {
		blocks = type(model.blocks) == "table" and model.blocks or {},
		tops = type(model.tops) == "table" and model.tops or {},
		mode = mode,
		visited = {},
		total = 0,
		truncated = false,
		combat = result.combat,
		combatSeen = {},
		isCombat = combatChecker(),
		receivers = {},
		functions = {},
	}
	pcall(collectLinkTargets, E)

	for _, top in ipairs(sortedTops(E)) do
		local block = E.blocks[top.id]
		local def = getDef(block)
		if def ~= nil and def.shape == "hat" then
			local okHat, text, title = pcall(hatSentence, E, block, def)
			if not okHat then
				text, title = Registry.plainLabel(def) .. " :", Registry.plainLabel(def)
			end
			local steps = {}
			local entry = {
				hatId = top.id,
				title = oneLine(title, 160),
				category = def.category,
				disabled = block.disabled == true,
				steps = steps,
			}
			if block.disabled == true then
				entry.title = oneLine(title, 140) .. " (désactivé)"
				addStep(E, steps, top.id, 0, "Ce script est désactivé : il ne fera rien tant que tu ne le réactives pas.", def.category, { disabled = true })
			else
				E.visited[top.id] = true
				addStep(E, steps, top.id, 0, text, def.category)
				if block.next == nil then
					addStep(E, steps, top.id, 0, "(aucun bloc dessous : il ne se passe rien)", def.category, { hint = true })
				else
					local okWalk, err = pcall(walk, E, block.next, 0, steps)
					if not okWalk then
						addStep(E, steps, top.id, 0, "(la suite n'a pas pu être expliquée : " .. oneLine(err, 120) .. ")", def.category, { hint = true })
					end
				end
			end
			table.insert(result.scripts, entry)
		elseif type(block) == "table" then
			result.ignored += 1
		end
	end

	result.warnings = collectWarnings(E, model, ctx)
	result.stepCount = E.total
	result.truncated = E.truncated
	return result
end

-- Explication complète du projet. Ne lève jamais d'erreur.
function Explication.explain(model, ctx)
	local ok, result = pcall(explainImpl, model, ctx)
	if ok and type(result) == "table" then
		return result
	end
	warn("[Blocs FR] Explication : " .. tostring(result))
	return {
		scripts = {},
		warnings = {
			{
				blockId = nil,
				text = "Attention : l'explication n'a pas pu être faite (" .. oneLine(result, 160) .. ").",
				severity = "avertissement",
				hatId = nil,
			},
		},
		combat = {},
		stepCount = 0,
		truncated = false,
		ignored = 0,
		mode = "server",
	}
end

-- Phrase d'un seul bloc (événement, bloc C, instruction ou bloc valeur), ou "" s'il n'existe pas
function Explication.sentence(model, blockId)
	local ok, text = pcall(function()
		if type(model) ~= "table" or type(model.blocks) ~= "table" then
			return ""
		end
		local block = model.blocks[blockId]
		local def = getDef(block)
		if def == nil then
			return ""
		end
		local E = { blocks = model.blocks, tops = model.tops or {}, visited = {} }
		if def.shape == "hat" then
			local sentence = hatSentence(E, block, def)
			return sentence
		elseif def.shape == "c" or def.shape == "c2" then
			return cSentence(E, block, def)
		elseif def.shape == "reporter" or def.shape == "boolean" then
			return capitalize(cleanFrench(describeReporter(E, blockId, 1)))
		end
		return statementText(E, block, def)
	end)
	if ok and type(text) == "string" then
		return text
	end
	return ""
end

return Explication
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">ExplicationPanel</string><ProtectedString name="Source"><![CDATA[-- ExplicationPanel : panneau « Ce que fait ce script » (SPEC §28, planche « Notes, effets visuels et
-- outils malins » › Explique-moi ce script). Panneau de 430 px à droite, comme « Problèmes » : une carte
-- par script, étapes numérotées avec une pastille de la couleur de la catégorie (clic -> voir le bloc),
-- remarques du détecteur (« Attention : … »), bouton « Lecture pas à pas » (chaque étape et son bloc
-- s'allument l'une après l'autre, 0,9 s chacune, bouton « Stop ») et « Voir la simulation 3D » quand le
-- script contient un bloc de combat.
--
-- API :
--   ExplicationPanel.new(layerFrame, deps) -> panel
--       deps = { dialogs, onSelectBlock = fn(blockId), onSimulate = fn(blockId), onPlayStep = fn(blockId|nil),
--                onVisibilityChanged = fn(visible) (facultatif), topInset / bottomInset (facultatifs : marges
--                haut / bas, par défaut la barre du haut et la barre d'état) }
--   panel:setContent(result)          -- résultat d'Explication.explain
--   panel:show() ; panel:hide() ; panel:toggle() ; panel:isVisible() ; panel:destroy()
-- Extensions : panel:play() ; panel:stop() ; panel:isPlaying() ; panel:highlightBlock(blockId) ;
--   panel:getDebugState() ; panel.frame (le panneau, un TextButton qui arrête les clics).
-- onPlayStep(nil) est appelé quand la lecture s'arrête (fin, « Stop », panneau fermé, contenu changé).

local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)

local Anim = nil
do
	local moduleScript = script.Parent:FindFirstChild("Anim")
	if moduleScript ~= nil then
		local ok, result = pcall(require, moduleScript)
		if ok and type(result) == "table" then
			Anim = result
		end
	end
end

local ExplicationPanel = {}
ExplicationPanel.__index = ExplicationPanel

local HEADER_H = 74
local FOOTER_H = 52
local PAD = 14
local SCROLLBAR = 6
local CARD_GAP = 10
local CARD_HEADER_H = 40
local INDENT = 16
local STEP_TIME = 0.9 -- secondes par étape pendant la lecture
local MAX_ROWS = 600 -- au-delà, les étapes ne sont plus dessinées (projets énormes)
local WHITE = Color3.fromRGB(255, 255, 255)
local NEUTRAL = Color3.fromRGB(110, 110, 120)

local SEVERITY_COLORS = {
	erreur = { "Danger", "DangerText" },
	avertissement = { "Warning", "WarningText" },
	conseil = { "Info", "InfoText" },
}

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local measureCache = {}
local measureCount = 0

-- Hauteur d'un texte qui passe à la ligne dans une largeur donnée (ne cède jamais la main)
local function measure(text, size, font, width)
	local key = font.Name .. "|" .. size .. "|" .. width .. "|" .. text
	local cached = measureCache[key]
	if cached then
		return cached
	end
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 100000))
	end)
	local h
	if ok and typeof(result) == "Vector2" then
		h = math.ceil(result.Y)
	else
		local w = Util.textSize(text, size, font).X
		h = math.max(1, math.ceil(w / math.max(1, width))) * (size + 3)
	end
	if measureCount > 800 then
		measureCache = {}
		measureCount = 0
	end
	measureCache[key] = h
	measureCount += 1
	return h
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

local function label(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = 13,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

local function plural(n, singular, pluralWord)
	if n == 1 then
		return "1 " .. singular
	end
	return tostring(n) .. " " .. pluralWord
end

local function categoryColor(categoryId, cache)
	if categoryId == nil then
		return NEUTRAL
	end
	local cached = cache[categoryId]
	if cached then
		return cached
	end
	local color = NEUTRAL
	local ok, cat = pcall(Registry.category, categoryId)
	if ok and type(cat) == "table" and typeof(cat.color) == "Color3" then
		color = cat.color
	end
	cache[categoryId] = color
	return color
end

-- Copie sûre d'un résultat d'Explication.explain
local function normalize(result)
	local out = { scripts = {}, warnings = {}, combat = {}, truncated = false }
	if type(result) ~= "table" then
		return out
	end
	for _, script in ipairs(type(result.scripts) == "table" and result.scripts or {}) do
		if type(script) == "table" then
			local steps = {}
			for _, step in ipairs(type(script.steps) == "table" and script.steps or {}) do
				if type(step) == "table" then
					table.insert(steps, step)
				end
			end
			table.insert(out.scripts, {
				hatId = script.hatId,
				title = tostring(script.title or "Script"),
				category = script.category,
				disabled = script.disabled == true,
				steps = steps,
			})
		end
	end
	for _, warning in ipairs(type(result.warnings) == "table" and result.warnings or {}) do
		if type(warning) == "table" and type(warning.text) == "string" then
			table.insert(out.warnings, warning)
		end
	end
	for _, id in ipairs(type(result.combat) == "table" and result.combat or {}) do
		table.insert(out.combat, id)
	end
	out.truncated = result.truncated == true
	return out
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function ExplicationPanel.new(layerFrame, deps)
	local self = setmetatable({}, ExplicationPanel)
	self.layer = layerFrame
	self.deps = type(deps) == "table" and deps or {}
	self.connections = {}
	self.contentMaid = Util.Maid.new()
	self._visible = false
	self._result = normalize(nil)
	self._dirty = true
	self._rows = {}
	self._selected = nil
	self._playing = false
	self._playToken = 0
	self._destroyed = false

	self.width = (Theme.Layout and Theme.Layout.ProblemsPanelWidth) or 430
	self.cardWidth = self.width - 2 * PAD - SCROLLBAR

	local top = tonumber(self.deps.topInset) or Theme.Layout.TopBarHeight
	local bottom = tonumber(self.deps.bottomInset) or Theme.Layout.StatusBarHeight
	self.shownPosition = UDim2.new(1, -self.width, 0, top)

	-- Le panneau est un bouton : les clics ne traversent pas jusqu'à la zone de travail
	self.panel = Util.create("TextButton", {
		Name = "Explication",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = self.shownPosition,
		Size = UDim2.new(0, self.width, 1, -(top + bottom)),
		Visible = false,
		Parent = layerFrame,
	})
	self.frame = self.panel
	Util.create("Frame", {
		Name = "Bordure",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 5,
		Parent = self.panel,
	})

	self:_buildHeader()
	self.list = Util.create("ScrollingFrame", {
		Name = "Etapes",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 1, -(HEADER_H + FOOTER_H)),
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = SCROLLBAR,
		ScrollBarImageColor3 = Theme.Colors.ButtonActive,
		VerticalScrollBarInset = Enum.ScrollBarInset.None,
		Parent = self.panel,
	})
	self:_buildFooter()
	self:_updateHeader()
	self:_updateFooter()
	return self
end

function ExplicationPanel:_connect(signal, fn)
	local connection = signal:Connect(fn)
	table.insert(self.connections, connection)
	return connection
end

-- Appelle un rappel de deps dans son propre thread (une erreur ne casse pas le panneau)
function ExplicationPanel:_call(name, ...)
	local fn = self.deps[name]
	if type(fn) ~= "function" then
		return false
	end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args, 1, args.n))
		if not ok then
			warn("[Blocs FR] Explication (" .. name .. ") : " .. tostring(err))
		end
	end)
	return true
end

-- Petit bouton (en-tête / pied)
function ExplicationPanel:_button(parent, text, props)
	local font = props.font or Theme.Fonts.UIBold
	local size = props.textSize or 12
	local width = props.width or (textWidth(text, size, font) + 24)
	local normal = props.color or Theme.Colors.Button
	local hover = props.hoverColor or Theme.Colors.ButtonHover
	local button = Util.create("TextButton", {
		Name = props.name or "Bouton",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = normal,
		BorderSizePixel = 0,
		AnchorPoint = props.anchor or Vector2.new(0, 0),
		Position = props.position or UDim2.new(),
		Size = UDim2.fromOffset(width, props.height or 28),
		Parent = parent,
	})
	Util.corner(button, 7)
	local textLabel = label({
		Name = "Texte",
		Text = text,
		Font = font,
		TextSize = size,
		TextColor3 = props.textColor or Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	local entry = { button = button, text = textLabel, normal = normal, hover = hover }
	self:_connect(button.MouseEnter, function()
		button.BackgroundColor3 = entry.hover
	end)
	self:_connect(button.MouseLeave, function()
		button.BackgroundColor3 = entry.normal
	end)
	if Anim and type(Anim.press) == "function" then
		local ok, disconnect = pcall(Anim.press, button)
		if ok and type(disconnect) == "function" then
			table.insert(self.connections, { Disconnect = disconnect })
		end
	end
	return entry
end

function ExplicationPanel:_buildHeader()
	local header = Util.create("Frame", {
		Name = "EnTete",
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, HEADER_H),
		Parent = self.panel,
	})
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = header,
	})

	local playWidth = math.max(
		textWidth("Lecture pas à pas", 12, Theme.Fonts.UIBold),
		textWidth("Stop", 12, Theme.Fonts.UIBold)
	) + 26
	label({
		Name = "Titre",
		Text = "Ce que fait ce script",
		Font = Theme.Fonts.UIBold,
		TextSize = 17,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -(18 + 12 + 28 + 8 + playWidth + 10), 0, 24),
		Parent = header,
	})
	self.subtitle = label({
		Name = "SousTitre",
		TextSize = 12,
		TextColor3 = Theme.Colors.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -36, 0, 18),
		Parent = header,
	})

	local close = self:_button(header, "×", {
		name = "Fermer",
		width = 28,
		textSize = 14,
		textColor = Theme.Colors.TextSoft,
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, -12, 0, 12),
	})
	self:_connect(close.button.MouseButton1Click, function()
		self:hide()
	end)

	self.playButton = self:_button(header, "Lecture pas à pas", {
		name = "LecturePasAPas",
		width = playWidth,
		color = Theme.Colors.Accent,
		hoverColor = Theme.Colors.AccentHover,
		textColor = WHITE,
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, -48, 0, 12),
	})
	self:_connect(self.playButton.button.MouseButton1Click, function()
		if self._playing then
			self:stop()
		else
			self:play()
		end
	end)
end

function ExplicationPanel:_buildFooter()
	local footer = Util.create("Frame", {
		Name = "Pied",
		BackgroundColor3 = Theme.Colors.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -FOOTER_H),
		Size = UDim2.new(1, 0, 0, FOOTER_H),
		Parent = self.panel,
	})
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Parent = footer,
	})
	self.footerHint = label({
		Name = "Aide",
		Text = "Clique sur une étape pour voir son bloc dans la zone de travail.",
		TextSize = 12,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 6),
		Size = UDim2.new(1, -36, 1, -12),
		Parent = footer,
	})
	local simulateText = "Voir la simulation 3D"
	self.simulateWidth = textWidth(simulateText, 12, Theme.Fonts.UIBold) + 28
	self.simulateButton = self:_button(footer, simulateText, {
		name = "Simulation",
		width = self.simulateWidth,
		height = 30,
		textColor = Theme.Colors.AccentText,
		anchor = Vector2.new(1, 0.5),
		position = UDim2.new(1, -14, 0.5, 0),
	})
	Util.stroke(self.simulateButton.button, Theme.Colors.Accent, 1, 0.2)
	self.simulateButton.button.Visible = false
	self:_connect(self.simulateButton.button.MouseButton1Click, function()
		self:_simulate()
	end)
end

---------------------------------------------------------------------------
-- En-tête et pied
---------------------------------------------------------------------------

function ExplicationPanel:_counts()
	local steps = 0
	for _, script in ipairs(self._result.scripts) do
		for _, step in ipairs(script.steps) do
			if not step.hint then
				steps += 1
			end
		end
	end
	return #self._result.scripts, steps, #self._result.warnings
end

function ExplicationPanel:_updateHeader()
	if self.subtitle == nil then
		return
	end
	local scripts, steps, warnings = self:_counts()
	local text
	if scripts == 0 then
		text = "Aucun script à expliquer pour l'instant."
	else
		text = plural(scripts, "script", "scripts") .. " · " .. plural(steps, "étape", "étapes")
		if warnings > 0 then
			text = text .. " · " .. plural(warnings, "point à vérifier", "points à vérifier")
		end
	end
	self.subtitle.Text = text
	self:_updatePlayButton()
end

function ExplicationPanel:_updatePlayButton()
	local entry = self.playButton
	if entry == nil then
		return
	end
	local _, steps = self:_counts()
	if self._playing then
		entry.text.Text = "Stop"
		entry.normal = Theme.Colors.Danger
		entry.hover = Theme.lighten(Theme.Colors.Danger, 0.12)
		entry.text.TextColor3 = WHITE
	elseif steps == 0 then
		entry.text.Text = "Lecture pas à pas"
		entry.normal = Theme.Colors.Button
		entry.hover = Theme.Colors.Button
		entry.text.TextColor3 = Theme.Colors.TextDisabled
	else
		entry.text.Text = "Lecture pas à pas"
		entry.normal = Theme.Colors.Accent
		entry.hover = Theme.Colors.AccentHover
		entry.text.TextColor3 = WHITE
	end
	entry.button.BackgroundColor3 = entry.normal
end

function ExplicationPanel:_updateFooter()
	if self.simulateButton == nil then
		return
	end
	local hasCombat = #self._result.combat > 0
	self.simulateButton.button.Visible = hasCombat
	if hasCombat then
		self.footerHint.Size = UDim2.new(1, -(18 + 14 + self.simulateWidth + 10), 1, -12)
	else
		self.footerHint.Size = UDim2.new(1, -36, 1, -12)
	end
end

---------------------------------------------------------------------------
-- Liste des étapes
---------------------------------------------------------------------------

function ExplicationPanel:_paintRow(row)
	local active = self._selected ~= nil and self._rows[self._selected] == row
	if active then
		row.frame.BackgroundColor3 = Theme.Colors.ButtonActive
		row.frame.BackgroundTransparency = 0
		row.stroke.Transparency = 0
	elseif row.hover then
		row.frame.BackgroundColor3 = Theme.Colors.ButtonHover
		row.frame.BackgroundTransparency = 0
		row.stroke.Transparency = 1
	else
		row.frame.BackgroundTransparency = 1
		row.stroke.Transparency = 1
	end
end

function ExplicationPanel:_selectRow(index, notify)
	local previous = self._rows[self._selected or 0]
	self._selected = index
	if previous then
		self:_paintRow(previous)
	end
	local row = self._rows[index or 0]
	if row then
		self:_paintRow(row)
		if notify and row.blockId ~= nil then
			self:_call("onSelectBlock", row.blockId)
		end
	end
end

-- Fait défiler la liste pour que la ligne soit visible
function ExplicationPanel:_scrollTo(row)
	local list = self.list
	if list == nil or row == nil or row.frame.Parent == nil then
		return
	end
	local viewH = list.AbsoluteSize.Y
	if viewH < 20 then
		return
	end
	local top = row.frame.AbsolutePosition.Y - list.AbsolutePosition.Y + list.CanvasPosition.Y
	local h = row.frame.AbsoluteSize.Y
	local current = list.CanvasPosition.Y
	if top >= current + 8 and top + h <= current + viewH - 8 then
		return
	end
	local maxY = math.max(0, list.CanvasSize.Y.Offset - viewH)
	local target = Vector2.new(0, math.clamp(top - viewH / 3, 0, maxY))
	if Anim and type(Anim.tween) == "function" then
		Anim.tween(list, { CanvasPosition = target }, 0.2, "quadOut")
	else
		list.CanvasPosition = target
	end
end

-- Encadré d'une remarque du détecteur ; renvoie sa hauteur
function ExplicationPanel:_warningBox(parent, warning, x, y, w)
	local maid = self.contentMaid
	local style = SEVERITY_COLORS[warning.severity] or SEVERITY_COLORS.avertissement
	local color = Theme.Colors[style[1]] or Theme.Colors.Warning
	local textColor = Theme.Colors[style[2]] or Theme.Colors.WarningText
	local text = tostring(warning.text or "")
	local textW = w - 24
	local textH = measure(text, 12, Theme.Fonts.UI, textW)
	local h = textH + 16
	local box = Util.create("TextButton", {
		Name = "Remarque",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Parent = parent,
	})
	Util.corner(box, 8)
	Util.create("Frame", {
		Name = "Barre",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0, 3, 1, 0),
		Parent = box,
	})
	label({
		Name = "Texte",
		Text = text,
		TextSize = 12,
		TextColor3 = textColor,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(13, 8),
		Size = UDim2.fromOffset(textW, textH),
		Parent = box,
	})
	if warning.blockId ~= nil then
		maid:give(box.MouseEnter:Connect(function()
			box.BackgroundTransparency = 0.78
		end))
		maid:give(box.MouseLeave:Connect(function()
			box.BackgroundTransparency = 0.86
		end))
		maid:give(box.MouseButton1Click:Connect(function()
			self:_call("onSelectBlock", warning.blockId)
		end))
	end
	return h
end

-- Carte des remarques qui ne concernent pas un script précis ; renvoie sa hauteur
function ExplicationPanel:_globalCard(warnings, y)
	local w = self.cardWidth
	local card = self.contentMaid:give(Util.create("Frame", {
		Name = "AVerifier",
		BackgroundColor3 = Theme.Colors.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, y),
		Size = UDim2.fromOffset(w, 40),
		Parent = self.list,
	}))
	Util.corner(card, 10)
	Util.stroke(card, Theme.Colors.PanelBorder, 1, 0)
	label({
		Name = "Titre",
		Text = "À vérifier",
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -28, 0, 36),
		Parent = card,
	})
	local cy = 36
	for _, warning in ipairs(warnings) do
		cy += self:_warningBox(card, warning, 12, cy, w - 24) + 6
	end
	cy += 6
	card.Size = UDim2.fromOffset(w, cy)
	return cy
end

-- Carte d'un script ; renvoie sa hauteur
function ExplicationPanel:_scriptCard(script, warnings, y, colors)
	local maid = self.contentMaid
	local w = self.cardWidth
	local catColor = categoryColor(script.category, colors)

	local card = maid:give(Util.create("Frame", {
		Name = "Script",
		BackgroundColor3 = Theme.Colors.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, y),
		Size = UDim2.fromOffset(w, 60),
		Parent = self.list,
	}))
	Util.corner(card, 10)
	Util.stroke(card, Theme.Colors.PanelBorder, 1, 0)

	-- En-tête : pastille de l'événement + titre + nombre d'étapes
	local dot = Util.create("Frame", {
		Name = "Pastille",
		BackgroundColor3 = catColor,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(14, 15),
		Size = UDim2.fromOffset(10, 10),
		Parent = card,
	})
	Util.corner(dot, 5)
	local realSteps = 0
	for _, step in ipairs(script.steps) do
		if not step.hint then
			realSteps += 1
		end
	end
	local countText = plural(realSteps, "étape", "étapes")
	local countW = textWidth(countText, 11, Theme.Fonts.UI) + 4
	local titleColor = Theme.Colors.Text
	if script.disabled then
		titleColor = Theme.Colors.TextDim
	end
	label({
		Name = "Titre",
		Text = script.title,
		Font = Theme.Fonts.UIBold,
		TextSize = 13,
		TextColor3 = titleColor,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -(32 + 14 + countW + 6), 0, CARD_HEADER_H),
		Parent = card,
	})
	label({
		Name = "Nombre",
		Text = countText,
		TextSize = 11,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.fromOffset(countW, CARD_HEADER_H),
		Parent = card,
	})
	Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = Theme.Colors.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, CARD_HEADER_H - 1),
		Size = UDim2.new(1, -24, 0, 1),
		Parent = card,
	})

	local cy = CARD_HEADER_H + 6
	local number = 0
	for _, step in ipairs(script.steps) do
		if #self._rows >= MAX_ROWS then
			self._clipped = true
			break
		end
		local depth = math.clamp(math.floor(tonumber(step.depth) or 0), 0, 8)
		local indent = 8 + depth * INDENT
		local textX = indent + 30
		local rowW = w - 12
		local textW = math.max(60, rowW - textX - 8)
		local text = tostring(step.text or "")
		local textH = measure(text, 13, Theme.Fonts.UI, textW)
		local rowH = math.max(26, textH + 8)
		local isHint = step.hint == true or step.disabled == true

		local frame = Util.create("TextButton", {
			Name = "Etape",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Colors.ButtonHover,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(6, cy),
			Size = UDim2.fromOffset(rowW, rowH),
			Parent = card,
		})
		Util.corner(frame, 7)
		local stroke = Util.stroke(frame, Theme.Colors.Accent, 1.5, 1)

		local circleColor = categoryColor(step.category, colors)
		local circle = Util.create("Frame", {
			Name = "Numero",
			BackgroundColor3 = circleColor,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(indent, 2),
			Size = UDim2.fromOffset(22, 22),
			Parent = frame,
		})
		Util.corner(circle, 11)
		local glyph
		if isHint then
			glyph = "−"
			circle.BackgroundTransparency = 0.55
		else
			number += 1
			glyph = tostring(number)
		end
		label({
			Name = "Chiffre",
			Text = glyph,
			Font = Theme.Fonts.UIBold,
			TextSize = 11,
			TextColor3 = WHITE,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = circle,
		})
		local textColor = Theme.Colors.Text
		if step.disabled then
			textColor = Theme.Colors.TextDisabled
		elseif step.hint then
			textColor = Theme.Colors.TextDim
		end
		label({
			Name = "Texte",
			Text = text,
			TextSize = 13,
			TextColor3 = textColor,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(textX, 4),
			Size = UDim2.fromOffset(textW, textH),
			Parent = frame,
		})

		local row = {
			frame = frame,
			stroke = stroke,
			blockId = step.blockId,
			hint = isHint,
			combat = step.combat == true,
			hover = false,
		}
		table.insert(self._rows, row)
		local index = #self._rows
		maid:give(frame.MouseEnter:Connect(function()
			row.hover = true
			self:_paintRow(row)
		end))
		maid:give(frame.MouseLeave:Connect(function()
			row.hover = false
			self:_paintRow(row)
		end))
		maid:give(frame.MouseButton1Click:Connect(function()
			if self._playing then
				self:stop()
			end
			self:_selectRow(index, true)
		end))
		cy += rowH + 2
	end

	if #warnings > 0 then
		cy += 4
		for _, warning in ipairs(warnings) do
			cy += self:_warningBox(card, warning, 12, cy, w - 24) + 6
		end
	end
	cy += 8
	card.Size = UDim2.fromOffset(w, cy)
	return cy
end

function ExplicationPanel:_emptyState(y, viewportH)
	local w = self.cardWidth
	local h = math.max(200, viewportH - y - 12)
	local holder = self.contentMaid:give(Util.create("Frame", {
		Name = "Vide",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(PAD, y),
		Size = UDim2.fromOffset(w, h),
		Parent = self.list,
	}))
	local top = math.max(16, math.floor((h - 150) / 2))
	local circle = Util.create("Frame", {
		Name = "Cercle",
		BackgroundColor3 = Theme.Colors.Button,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top),
		Size = UDim2.fromOffset(56, 56),
		Parent = holder,
	})
	Util.corner(circle, 28)
	Util.stroke(circle, Theme.Colors.PanelBorder, 1, 0)
	label({
		Name = "Signe",
		Text = "…",
		Font = Theme.Fonts.UIBold,
		TextSize = 24,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = circle,
	})
	label({
		Name = "Titre",
		Text = "Aucun script à expliquer",
		Font = Theme.Fonts.UIBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, top + 70),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = holder,
	})
	local hint = "Pose un bloc « Quand … » (catégorie Événements), accroche des blocs dessous, puis reviens ici : je te raconterai ce qu'ils font, étape par étape."
	local hintH = measure(hint, 12, Theme.Fonts.UI, w - 40)
	label({
		Name = "Aide",
		Text = hint,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(20, top + 98),
		Size = UDim2.fromOffset(w - 40, hintH),
		Parent = holder,
	})
	return h
end

function ExplicationPanel:_note(text, y)
	local w = self.cardWidth
	local h = measure(text, 11, Theme.Fonts.UI, w - 8) + 4
	self.contentMaid:give(label({
		Name = "Remarque",
		Text = text,
		TextSize = 11,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(PAD + 4, y),
		Size = UDim2.fromOffset(w - 8, h),
		Parent = self.list,
	}))
	return h
end

-- animate : les cartes arrivent l'une après l'autre (à l'ouverture du panneau seulement)
function ExplicationPanel:_render(animate)
	if self._destroyed or self.list == nil then
		return
	end
	self:stop()
	self._dirty = false
	local previous = self.list.CanvasPosition
	self.contentMaid:clean()
	self._rows = {}
	self._selected = nil
	self._clipped = false

	local viewportH = self.list.AbsoluteSize.Y
	if viewportH < 50 then
		viewportH = 400
	end
	local result = self._result
	local colors = {}

	-- Remarques rangées sous leur script ; les autres en haut, dans « À vérifier »
	local hats = {}
	for _, script in ipairs(result.scripts) do
		if script.hatId ~= nil then
			hats[script.hatId] = true
		end
	end
	local global = {}
	local byHat = {}
	for _, warning in ipairs(result.warnings) do
		local hatId = warning.hatId
		if hatId ~= nil and hats[hatId] then
			local list = byHat[hatId]
			if list == nil then
				list = {}
				byHat[hatId] = list
			end
			table.insert(list, warning)
		else
			table.insert(global, warning)
		end
	end

	local y = 12
	if #global > 0 then
		local ok, h = pcall(self._globalCard, self, global, y)
		if ok and type(h) == "number" then
			y += h + CARD_GAP
		end
	end
	if #result.scripts == 0 then
		y += self:_emptyState(y, viewportH)
	else
		for _, script in ipairs(result.scripts) do
			local ok, h = pcall(self._scriptCard, self, script, byHat[script.hatId] or {}, y, colors)
			if ok and type(h) == "number" then
				y += h + CARD_GAP
			else
				warn("[Blocs FR] Panneau d'explication : " .. tostring(h))
			end
			if self._clipped then
				break
			end
		end
	end
	if result.truncated or self._clipped then
		y += self:_note("Le projet est très grand : seules les premières étapes sont racontées ici.", y) + 6
	end
	local total = y + 6
	self.list.CanvasSize = UDim2.fromOffset(0, total)
	local maxY = math.max(0, total - viewportH)
	self.list.CanvasPosition = Vector2.new(0, math.clamp(previous.Y, 0, maxY))

	if animate and Anim and type(Anim.stagger) == "function" then
		local cards = {}
		for _, child in ipairs(self.list:GetChildren()) do
			if child:IsA("GuiObject") then
				table.insert(cards, child)
			end
		end
		table.sort(cards, function(a, b)
			return a.Position.Y.Offset < b.Position.Y.Offset
		end)
		pcall(Anim.stagger, cards, 0.05, 12)
	end
end

---------------------------------------------------------------------------
-- Lecture pas à pas et simulation
---------------------------------------------------------------------------

function ExplicationPanel:play()
	if self._destroyed then
		return
	end
	if self._dirty and self._visible then
		self:_render()
	end
	local order = {}
	for index, row in ipairs(self._rows) do
		if not row.hint and row.blockId ~= nil then
			table.insert(order, index)
		end
	end
	if #order == 0 then
		return
	end
	if self._playing then
		self._playing = false
		self._playToken += 1
	end
	self._playing = true
	self._playToken += 1
	local token = self._playToken
	self:_updatePlayButton()
	local position = 0
	local function nextStep()
		if self._destroyed or not self._playing or token ~= self._playToken then
			return
		end
		position += 1
		local index = order[position]
		local row = self._rows[index or 0]
		if row == nil then
			self:stop()
			return
		end
		self:_selectRow(index, false)
		self:_scrollTo(row)
		self:_call("onPlayStep", row.blockId)
		task.delay(STEP_TIME, nextStep)
	end
	nextStep()
end

function ExplicationPanel:stop()
	if not self._playing then
		return
	end
	self._playing = false
	self._playToken += 1
	if not self._destroyed then
		self:_updatePlayButton()
	end
	self:_call("onPlayStep", nil)
end

function ExplicationPanel:isPlaying()
	return self._playing
end

function ExplicationPanel:_simulate()
	local combat = self._result.combat
	if #combat == 0 then
		return
	end
	local blockId = combat[1]
	local row = self._rows[self._selected or 0]
	if row ~= nil and row.combat and row.blockId ~= nil then
		blockId = row.blockId
	end
	if self._playing then
		self:stop()
	end
	self:_call("onSimulate", blockId)
end

-- Allume la première étape qui concerne ce bloc (sans rappeler onSelectBlock) ; renvoie true si trouvée
function ExplicationPanel:highlightBlock(blockId)
	if self._destroyed or blockId == nil then
		return false
	end
	if self._visible and self._dirty then
		self:_render()
	end
	for index, row in ipairs(self._rows) do
		if row.blockId == blockId and not row.hint then
			self:_selectRow(index, false)
			self:_scrollTo(row)
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

function ExplicationPanel:setContent(result)
	if self._destroyed then
		return
	end
	self._result = normalize(result)
	if self._visible then
		self:_render()
	else
		self:stop()
		self._dirty = true
	end
	self:_updateHeader()
	self:_updateFooter()
end

function ExplicationPanel:show()
	if self._destroyed or self.panel == nil then
		return
	end
	local wasVisible = self._visible
	self._visible = true
	self.panel.Visible = true
	if self._dirty or not wasVisible then
		self:_render(not wasVisible)
	end
	if wasVisible then
		return
	end
	self.panel.Position = self.shownPosition
	if Anim and type(Anim.slideIn) == "function" then
		Anim.slideIn(self.panel, Vector2.new(self.width + 10, 0), 0.25)
	end
	self:_notifyVisibility()
end

function ExplicationPanel:hide()
	if self._destroyed then
		return
	end
	local wasVisible = self._visible
	self._visible = false
	self:stop()
	if self.panel == nil then
		return
	end
	if not wasVisible then
		self.panel.Visible = false
		return
	end
	local animated = false
	if Anim and type(Anim.slideOut) == "function" and type(Anim.enabled) == "function" then
		local okEnabled, enabled = pcall(Anim.enabled)
		if okEnabled and enabled then
			animated = true
			Anim.slideOut(self.panel, Vector2.new(self.width + 10, 0), 0.18)
		end
	end
	if not animated then
		self.panel.Visible = false
		self.panel.Position = self.shownPosition
	end
	self:_notifyVisibility()
end

function ExplicationPanel:toggle()
	if self._visible then
		self:hide()
	else
		self:show()
	end
end

function ExplicationPanel:isVisible()
	return self._visible
end

function ExplicationPanel:_notifyVisibility()
	local fn = self.deps.onVisibilityChanged
	if type(fn) == "function" then
		local visible = self._visible
		task.spawn(function()
			pcall(fn, visible)
		end)
	end
end

function ExplicationPanel:getDebugState()
	local scripts, steps, warnings = self:_counts()
	return {
		visible = self._visible,
		scripts = scripts,
		steps = steps,
		warnings = warnings,
		combat = #self._result.combat,
		playing = self._playing,
		selected = self._selected,
		rows = #self._rows,
	}
end

function ExplicationPanel:destroy()
	if self._destroyed then
		return
	end
	if self._playing then
		self:stop()
	end
	self._destroyed = true
	self._visible = false
	self.contentMaid:clean()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.panel then
		self.panel:Destroy()
		self.panel = nil
		self.frame = nil
	end
	self.list = nil
	self._rows = {}
end

return ExplicationPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">GuiBuild</string><ProtectedString name="Source"><![CDATA[-- GuiBuild : construit les objets Roblox d'un écran du Studio d'interface à partir d'un GuiDoc
-- (SPEC §21.3). Sert à l'aperçu du plugin (cadre dans un DockWidgetPluginGui, mode édition) et au
-- ScreenGui enregistré dans StarterGui. Ne cède jamais la main (aucune attente) pendant la construction.
--
-- Arbre produit : (ScreenGui) > CanvasGroup « Racine » (attribut BlocsFR_Racine) > éléments, dans
-- l'ordre de doc.tops / children (ZIndex croissant entre frères). Chaque élément porte les attributs
-- BlocsFR_Id, BlocsFR_Type, BlocsFR_Effet et ses valeurs en px de référence (BlocsFR_Arrondi,
-- BlocsFR_Contour, BlocsFR_Relief, BlocsFR_TailleTexte, BlocsFR_TexteContour, BlocsFR_Marge…) :
-- applyScale (aperçu) et le LocalScript « BlocsFR_Effets » (jeu) les remultiplient par k.
--
-- NOTE: choix de construction (en plus de la SPEC) :
--   * la Racine est centrée (AnchorPoint 0.5, Position 0.5) pour que l'effet « zoom » des écrans
--     grandisse depuis le centre ;
--   * les morceaux visuels (Face, Texte, Remplissage) portent l'attribut BlocsFR_Partie et les
--     décorations ont des noms fixes : UICorner « BlocsFR_Arrondi », UIStroke « BlocsFR_Contour »
--     (bord) et « BlocsFR_ContourTexte » (texte), UIGradient « BlocsFR_Degrade »,
--     UITextSizeConstraint « BlocsFR_TailleMax », UIPadding « BlocsFR_Marges », disposition
--     « BlocsFR_Disposition » ;
--   * les enfants d'une liste / grille ont une taille en pixels (attributs BlocsFR_L / BlocsFR_H,
--     px de référence × k) : les cases restent carrées sur tous les écrans ;
--   * un texte plus grand que 100 px (limite de Roblox) est agrandi avec le UIScale
--     « BlocsFR_Echelle » (attribut BlocsFR_EchelleTexte) : _guiAnimer et l'effet « rebond » en
--     tiennent compte (attribut BlocsFR_EchelleBase = échelle choisie par les blocs) ;
--   * opts.editor = true : rien n'est interactif (Active, AutoButtonColor, Selectable,
--     TextEditable, Interactable à false, défilement des listes coupé) ;
--   * en jeu, un élément plein écran avec un fond visible (voile derrière une fenêtre, fond d'un
--     écran de chargement) a Active = true : il arrête les clics (monde 3D, outil tenu,
--     ClickDetector, écrans placés dessous), même sur la fenêtre posée par-dessus. Les autres
--     éléments laissent passer les clics comme dans Roblox (Active = false par défaut) : un panneau
--     du HUD ne bloque pas le joystick des téléphones. La Racine reste Active = false.

local HttpService = game:GetService("HttpService")

local Util = require(script.Parent.Util)
local GuiDoc = require(script.Parent.GuiDoc)

local GuiBuild = {}

GuiBuild.DATA_NAME = "BlocsFR_Interface" -- StringValue(s) du JSON (_2, _3… au-delà de CHUNK_SIZE)
GuiBuild.EFFECTS_NAME = "BlocsFR_Effets"
GuiBuild.ROOT_NAME = "Racine"
GuiBuild.ATTR = "BlocsFR_GUI"
GuiBuild.CHUNK_SIZE = 150000

local K_MIN, K_MAX = 0.05, 20
local MAX_TEXT_SIZE = 100 -- taille maximale d'un texte Roblox

-- Marges intérieures du texte (px de référence, gauche / droite ; haut / bas = 40 %)
local MARGES = { bouton = 12, champ = 14, texteFond = 8, barre = 4 }

local ALIGN = {
	gauche = Enum.TextXAlignment.Left,
	centre = Enum.TextXAlignment.Center,
	droite = Enum.TextXAlignment.Right,
}

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function rgb(value, fallback)
	if type(value) == "table" then
		return Util.rgbToColor3(value)
	end
	return fallback
end

-- Couleur assombrie (amount entre 0 et 1)
local function darken(color, amount)
	local k = 1 - amount
	return Color3.new(color.R * k, color.G * k, color.B * k)
end

local function attr(inst, name, default)
	local value = inst:GetAttribute(name)
	if type(value) == "number" and value == value then
		return value
	end
	return default
end

-- Enfant direct « nom » qui n'est pas un élément (morceau visuel : Face, Texte, Remplissage)
local function partie(parent, nom)
	for _, enfant in ipairs(parent:GetChildren()) do
		if enfant.Name == nom and enfant:GetAttribute("BlocsFR_Type") == nil then
			return enfant
		end
	end
	return nil
end

local function asDoc(doc)
	if type(doc) == "table" and getmetatable(doc) == GuiDoc then
		return doc
	end
	local converted = nil
	if type(doc) == "table" then
		converted = GuiDoc.fromData(doc)
	end
	return converted or GuiDoc.new(GuiDoc.DEFAULT_NAME)
end

-- Police Roblox d'après son nom (GothamBold si inconnue)
function GuiBuild.fontOf(name)
	local ok, font = pcall(function()
		return (Enum.Font :: any)[name]
	end)
	if ok and typeof(font) == "EnumItem" then
		return font
	end
	return Enum.Font.GothamBold
end

---------------------------------------------------------------------------
-- Valeurs en pixels (même logique que appliquer() dans EFFECTS_SOURCE : à garder identiques)
---------------------------------------------------------------------------

local function appliquer(inst, k)
	local genre = inst:GetAttribute("BlocsFR_Type")
	local arrondi = attr(inst, "BlocsFR_Arrondi", 0) * k
	local contour = attr(inst, "BlocsFR_Contour", 0) * k
	local relief = attr(inst, "BlocsFR_Relief", 0) * k
	local taille = attr(inst, "BlocsFR_TailleTexte", 32) * k
	local trait = attr(inst, "BlocsFR_TexteContour", 0) * k
	local marge = attr(inst, "BlocsFR_Marge", 0) * k

	-- Texte plus grand que 100 px : l'objet est rétréci puis agrandi par un UIScale
	local s = 1
	if genre == "texte" and taille > MAX_TEXT_SIZE then
		s = taille / MAX_TEXT_SIZE
	end
	local l = inst:GetAttribute("BlocsFR_L")
	local h = inst:GetAttribute("BlocsFR_H")
	if type(l) == "number" and type(h) == "number" then
		inst.Size = UDim2.fromOffset(l * k / s, h * k / s)
	elseif genre == "texte" then
		local largeur = attr(inst, "BlocsFR_Largeur", nil)
		local hauteur = attr(inst, "BlocsFR_Hauteur", nil)
		if largeur ~= nil and hauteur ~= nil then
			inst.Size = UDim2.fromScale(largeur / s, hauteur / s)
		end
	end
	if genre == "texte" then
		inst:SetAttribute("BlocsFR_EchelleTexte", s)
		local echelle = inst:FindFirstChild("BlocsFR_Echelle")
		if echelle == nil and s ~= 1 then
			echelle = Instance.new("UIScale")
			echelle.Name = "BlocsFR_Echelle"
			echelle.Parent = inst
		end
		if echelle ~= nil and echelle:IsA("UIScale") then
			echelle.Scale = s * attr(inst, "BlocsFR_EchelleBase", 1)
		end
	end

	local function arrondir(objet)
		local coin = objet:FindFirstChild("BlocsFR_Arrondi")
		if coin ~= nil and coin:IsA("UICorner") then
			coin.CornerRadius = UDim.new(0, arrondi / s)
		end
	end
	arrondir(inst)
	local face = partie(inst, "Face")
	if face ~= nil and face:IsA("GuiObject") then
		arrondir(face)
		face.Size = UDim2.new(1, 0, 1, -relief)
	end
	local rempli = partie(inst, "Remplissage")
	if rempli ~= nil then
		arrondir(rempli)
	end
	local bord = inst:FindFirstChild("BlocsFR_Contour")
	if bord ~= nil and bord:IsA("UIStroke") then
		bord.Thickness = contour / s
	end

	-- Zone de texte : l'élément lui-même (texte, champ), Face > Texte (bouton) ou Texte (barre)
	local zone = nil
	if genre == "texte" or genre == "champ" then
		zone = inst
	elseif face ~= nil then
		zone = partie(face, "Texte")
	else
		zone = partie(inst, "Texte")
	end
	if zone ~= nil then
		local maximum = zone:FindFirstChild("BlocsFR_TailleMax")
		if maximum ~= nil and maximum:IsA("UITextSizeConstraint") then
			maximum.MaxTextSize = math.clamp(math.floor(taille / s + 0.5), 1, MAX_TEXT_SIZE)
		end
		local trace = zone:FindFirstChild("BlocsFR_ContourTexte")
		if trace ~= nil and trace:IsA("UIStroke") then
			trace.Thickness = trait / s
		end
		local marges = zone:FindFirstChild("BlocsFR_Marges")
		if marges ~= nil and marges:IsA("UIPadding") then
			local m = marge / s
			marges.PaddingLeft = UDim.new(0, m)
			marges.PaddingRight = UDim.new(0, m)
			marges.PaddingTop = UDim.new(0, m * 0.4)
			marges.PaddingBottom = UDim.new(0, m * 0.4)
		end
	end

	-- Listes et grilles
	if genre == "liste" or genre == "grille" then
		local ecart = attr(inst, "BlocsFR_Espacement", 0) * k
		if inst:IsA("ScrollingFrame") then
			inst.ScrollBarThickness = math.max(2, math.floor(6 * k + 0.5))
		end
		local disposition = inst:FindFirstChild("BlocsFR_Disposition")
		if disposition ~= nil and disposition:IsA("UIListLayout") then
			disposition.Padding = UDim.new(0, ecart)
		elseif disposition ~= nil and disposition:IsA("UIGridLayout") then
			disposition.CellPadding = UDim2.fromOffset(ecart, ecart)
			disposition.CellSize = UDim2.fromOffset(attr(inst, "BlocsFR_CelluleL", 100) * k, attr(inst, "BlocsFR_CelluleH", 100) * k)
		end
		local marges = inst:FindFirstChild("BlocsFR_Marges")
		if marges ~= nil and marges:IsA("UIPadding") then
			local m = GuiDoc.LIST_PAD * k
			marges.PaddingLeft = UDim.new(0, m)
			marges.PaddingRight = UDim.new(0, m)
			marges.PaddingTop = UDim.new(0, m)
			marges.PaddingBottom = UDim.new(0, m)
		end
	end
end

-- Réapplique les valeurs en pixels de tous les éléments (aperçu redimensionné). Peu coûteux.
-- racine : la Racine construite (ou le ScreenGui, ou un élément : lui et ses descendants).
function GuiBuild.applyScale(racine, k)
	if typeof(racine) ~= "Instance" then
		return
	end
	k = tonumber(k)
	if not isFinite(k) or k <= 0 then
		k = 1
	end
	k = math.clamp(k, K_MIN, K_MAX)
	pcall(function()
		racine:SetAttribute("BlocsFR_K", k)
	end)
	local ok, list = pcall(function()
		return racine:GetDescendants()
	end)
	if not ok then
		return
	end
	table.insert(list, 1, racine)
	for _, d in ipairs(list) do
		if d:GetAttribute("BlocsFR_Type") ~= nil then
			pcall(appliquer, d, k)
		end
	end
end

---------------------------------------------------------------------------
-- Construction des éléments
---------------------------------------------------------------------------

local function newChild(className, name, parent)
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local function addCorner(parent)
	return newChild("UICorner", "BlocsFR_Arrondi", parent)
end

local function addGradient(parent, c1, c2)
	local degrade = Instance.new("UIGradient")
	degrade.Name = "BlocsFR_Degrade"
	degrade.Color = ColorSequence.new(c1, c2)
	degrade.Rotation = 90 -- haut -> bas
	degrade.Parent = parent
	return degrade
end

local function addBorder(parent, el)
	if el.contour <= 0 then
		return nil
	end
	local bord = Instance.new("UIStroke")
	bord.Name = "BlocsFR_Contour"
	bord.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bord.Color = rgb(el.contourCouleur, Color3.fromRGB(14, 22, 48))
	bord.LineJoinMode = Enum.LineJoinMode.Round
	bord.Parent = parent
	return bord
end

-- Fond uni ou dégradé (fond -> fond2). Sans fond : transparent. Un UIGradient teinte aussi le
-- texte ou l'image de l'objet qui le porte : allowGradient = false pour texte, champ et image (fond uni).
-- (nil = dégradé permis : cadre, Face des boutons, barre, liste, grille)
local function paint(objet, el, transparence, allowGradient)
	local fond = rgb(el.fond, nil)
	if fond == nil then
		objet.BackgroundColor3 = Color3.new(1, 1, 1)
		objet.BackgroundTransparency = 1
		return
	end
	objet.BackgroundTransparency = transparence
	local fond2 = rgb(el.fond2, nil)
	if fond2 ~= nil and allowGradient ~= false then
		objet.BackgroundColor3 = Color3.new(1, 1, 1)
		addGradient(objet, fond, fond2)
	else
		objet.BackgroundColor3 = fond
	end
end

-- Couleur du relief (reliefCouleur, sinon fond assombri de 35 %)
local function reliefColor(el)
	local couleur = rgb(el.reliefCouleur, nil)
	if couleur ~= nil then
		return couleur
	end
	return darken(rgb(el.fond, Color3.fromRGB(14, 22, 48)), 0.35)
end

-- Réglages communs d'une zone de texte (taille, contour, marges : posés par appliquer)
local function setupText(zone, el, texte)
	zone.Text = texte
	zone.Font = GuiBuild.fontOf(el.police)
	zone.TextColor3 = rgb(el.texteCouleur, Color3.new(1, 1, 1))
	zone.TextScaled = true
	zone.TextWrapped = true
	zone.TextXAlignment = ALIGN[el.alignement] or Enum.TextXAlignment.Center
	zone.TextYAlignment = Enum.TextYAlignment.Center
	local maximum = Instance.new("UITextSizeConstraint")
	maximum.Name = "BlocsFR_TailleMax"
	maximum.MinTextSize = 1
	maximum.MaxTextSize = MAX_TEXT_SIZE
	maximum.Parent = zone
	if el.texteContour > 0 then
		local trace = Instance.new("UIStroke")
		trace.Name = "BlocsFR_ContourTexte"
		trace.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		trace.Color = rgb(el.texteContourCouleur, Color3.fromRGB(14, 22, 48))
		trace.LineJoinMode = Enum.LineJoinMode.Round
		trace.Parent = zone
	end
	newChild("UIPadding", "BlocsFR_Marges", zone)
end

-- GuiObject.Interactable (récent) : ignoré sans erreur s'il n'existe pas
local function setNotInteractable(inst)
	pcall(function()
		local objet: any = inst
		objet.Interactable = false
	end)
end

local function noInput(inst)
	inst.Active = false
	if inst:IsA("GuiButton") then
		inst.AutoButtonColor = false
		inst.Selectable = false
	end
	if inst:IsA("TextBox") then
		inst.TextEditable = false
		inst.Selectable = false
	end
	if inst:IsA("ScrollingFrame") then
		inst.ScrollingEnabled = false
	end
	setNotInteractable(inst)
end

-- Vrai si l'élément couvre tout l'écran (à 2 % près), d'après ses fractions : vrai sur tous les formats
local function coversScreen(doc, el)
	local W, H = GuiDoc.REF_W, GuiDoc.REF_H
	local x, y, w, h = doc:absRect(el.id, W, H)
	local mw, mh = W * 0.02, H * 0.02
	return x <= mw and y <= mh and x + w >= W - mw and y + h >= H - mh
end

-- Crée l'objet d'un élément (sans ses enfants). layout = { refW, refH } pour un enfant de liste / grille.
local function createElement(doc, el, index, layout, editor)
	local t = el.type
	local inst
	if t == "texte" then
		inst = Instance.new("TextLabel")
	elseif t == "bouton" then
		inst = Instance.new("TextButton")
	elseif t == "image" then
		inst = Instance.new("ImageLabel")
	elseif t == "champ" then
		inst = Instance.new("TextBox")
	elseif t == "liste" or t == "grille" then
		inst = Instance.new("ScrollingFrame")
	else
		inst = Instance.new("Frame") -- cadre, barre
	end
	inst.Name = el.name
	inst.BorderSizePixel = 0
	inst.ZIndex = index
	inst.Visible = el.visible ~= false
	inst.Rotation = el.rotation

	if layout ~= nil then
		-- placé par la disposition de la liste : taille en pixels (× k), position ignorée
		inst.AnchorPoint = Vector2.new(0, 0)
		inst.Position = UDim2.new(0, 0, 0, 0)
		inst.LayoutOrder = index
		inst:SetAttribute("BlocsFR_L", el.w * layout.refW)
		inst:SetAttribute("BlocsFR_H", el.h * layout.refH)
		inst.Size = UDim2.fromOffset(el.w * layout.refW, el.h * layout.refH)
	else
		inst.AnchorPoint = Vector2.new(el.ax, el.ay)
		inst.Position = UDim2.fromScale(el.x, el.y)
		inst.Size = UDim2.fromScale(el.w, el.h)
	end

	inst:SetAttribute("BlocsFR_Id", el.id)
	inst:SetAttribute("BlocsFR_Type", t)
	inst:SetAttribute("BlocsFR_Effet", el.effet)
	inst:SetAttribute("BlocsFR_Arrondi", el.arrondi)
	inst:SetAttribute("BlocsFR_Contour", el.contour)
	inst:SetAttribute("BlocsFR_TailleTexte", el.tailleTexte)
	inst:SetAttribute("BlocsFR_TexteContour", el.texteContour)
	local relief = 0
	if t == "bouton" or t == "cadre" then
		relief = el.relief
	end
	inst:SetAttribute("BlocsFR_Relief", relief)

	addCorner(inst)
	addBorder(inst, el)

	if t == "texte" then
		inst:SetAttribute("BlocsFR_Largeur", el.w)
		inst:SetAttribute("BlocsFR_Hauteur", el.h)
		paint(inst, el, el.transparence, false)
		local marge = 0
		if inst.BackgroundTransparency < 1 then
			marge = MARGES.texteFond
		end
		inst:SetAttribute("BlocsFR_Marge", marge)
		setupText(inst, el, el.texte)
	elseif t == "bouton" then
		inst.Text = ""
		inst.AutoButtonColor = false
		inst.BackgroundColor3 = reliefColor(el)
		inst.BackgroundTransparency = el.transparence
		if el.fond == nil then
			inst.BackgroundTransparency = 1
		end
		inst:SetAttribute("BlocsFR_ReliefAuto", el.reliefCouleur == nil)
		inst:SetAttribute("BlocsFR_Marge", MARGES.bouton)
		local face = Instance.new("Frame")
		face.Name = "Face"
		face:SetAttribute("BlocsFR_Partie", "Face")
		face.BorderSizePixel = 0
		face.ZIndex = 1
		face.Position = UDim2.new(0, 0, 0, 0)
		face.Size = UDim2.new(1, 0, 1, 0)
		paint(face, el, el.transparence)
		addCorner(face)
		local zone = Instance.new("TextLabel")
		zone.Name = "Texte"
		zone:SetAttribute("BlocsFR_Partie", "Texte")
		zone.BackgroundTransparency = 1
		zone.BorderSizePixel = 0
		zone.Size = UDim2.fromScale(1, 1)
		zone.ZIndex = 2
		setupText(zone, el, el.texte)
		zone.Parent = face
		face.Parent = inst
	elseif t == "cadre" then
		if el.relief > 0 then
			inst.BackgroundColor3 = reliefColor(el)
			inst.BackgroundTransparency = el.transparence
			if el.fond == nil then
				inst.BackgroundTransparency = 1
			end
			local face = Instance.new("Frame")
			face.Name = "Face"
			face:SetAttribute("BlocsFR_Partie", "Face")
			face.BorderSizePixel = 0
			face.ZIndex = 0 -- sous les éléments enfants (ZIndex 1, 2…)
			face.Position = UDim2.new(0, 0, 0, 0)
			face.Size = UDim2.new(1, 0, 1, 0)
			paint(face, el, el.transparence)
			addCorner(face)
			face.Parent = inst
		else
			paint(inst, el, el.transparence)
		end
	elseif t == "image" then
		local ok = pcall(function()
			inst.Image = el.image
		end)
		if not ok then
			inst.Image = ""
		end
		inst.ImageColor3 = rgb(el.imageCouleur, Color3.new(1, 1, 1))
		inst.ScaleType = Enum.ScaleType.Fit
		paint(inst, el, el.transparence, false)
	elseif t == "barre" then
		paint(inst, el, el.transparence)
		inst:SetAttribute("BlocsFR_Marge", MARGES.barre)
		local rempli = Instance.new("Frame")
		rempli.Name = "Remplissage"
		rempli:SetAttribute("BlocsFR_Partie", "Remplissage")
		rempli.BorderSizePixel = 0
		rempli.ZIndex = 1
		rempli.Size = UDim2.fromScale(el.valeur, 1)
		rempli.BackgroundColor3 = rgb(el.barreCouleur, Color3.fromRGB(47, 191, 90))
		addCorner(rempli)
		rempli.Parent = inst
		if el.texte ~= "" then
			local zone = Instance.new("TextLabel")
			zone.Name = "Texte"
			zone:SetAttribute("BlocsFR_Partie", "Texte")
			zone.BackgroundTransparency = 1
			zone.BorderSizePixel = 0
			zone.Size = UDim2.fromScale(1, 1)
			zone.ZIndex = 2
			setupText(zone, el, el.texte)
			zone.Parent = inst
		end
	elseif t == "champ" then
		paint(inst, el, el.transparence, false)
		inst:SetAttribute("BlocsFR_Marge", MARGES.champ)
		inst.ClearTextOnFocus = false
		inst.MultiLine = false
		inst.PlaceholderText = el.indice
		local couleur = rgb(el.texteCouleur, Color3.fromRGB(31, 31, 35))
		inst.PlaceholderColor3 = couleur:Lerp(Color3.new(0.6, 0.6, 0.6), 0.6)
		setupText(inst, el, el.texte)
	elseif t == "liste" or t == "grille" then
		paint(inst, el, el.transparence)
		inst:SetAttribute("BlocsFR_Espacement", el.espacement)
		inst.CanvasSize = UDim2.new(0, 0, 0, 0)
		inst.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
		inst.ScrollBarImageTransparency = 0.4
		inst.ScrollBarThickness = 6
		local horizontal = t == "liste" and el.direction == "horizontale"
		if horizontal then
			inst.AutomaticCanvasSize = Enum.AutomaticSize.X
			inst.ScrollingDirection = Enum.ScrollingDirection.X
		else
			inst.AutomaticCanvasSize = Enum.AutomaticSize.Y
			inst.ScrollingDirection = Enum.ScrollingDirection.Y
		end
		newChild("UIPadding", "BlocsFR_Marges", inst)
		if t == "grille" then
			local cw, ch = doc:cellSize(el.id)
			inst:SetAttribute("BlocsFR_CelluleL", cw)
			inst:SetAttribute("BlocsFR_CelluleH", ch)
			local grille = Instance.new("UIGridLayout")
			grille.Name = "BlocsFR_Disposition"
			grille.SortOrder = Enum.SortOrder.LayoutOrder
			grille.FillDirection = Enum.FillDirection.Horizontal
			grille.FillDirectionMaxCells = math.max(el.colonnes, 1)
			grille.HorizontalAlignment = Enum.HorizontalAlignment.Center
			grille.VerticalAlignment = Enum.VerticalAlignment.Top
			grille.Parent = inst
		else
			local liste = Instance.new("UIListLayout")
			liste.Name = "BlocsFR_Disposition"
			liste.SortOrder = Enum.SortOrder.LayoutOrder
			if horizontal then
				liste.FillDirection = Enum.FillDirection.Horizontal
				liste.HorizontalAlignment = Enum.HorizontalAlignment.Left
				liste.VerticalAlignment = Enum.VerticalAlignment.Center
			else
				liste.FillDirection = Enum.FillDirection.Vertical
				liste.HorizontalAlignment = Enum.HorizontalAlignment.Center
				liste.VerticalAlignment = Enum.VerticalAlignment.Top
			end
			liste.Parent = inst
		end
	end

	if editor then
		noInput(inst)
	elseif layout == nil and inst.BackgroundTransparency < 1 and coversScreen(doc, el) then
		-- voile / fond plein écran : les clics s'arrêtent là (fenêtre modale, écran de chargement)
		inst.Active = true
	end
	return inst
end

-- Construit doc dans parent. opts.scale = k (aperçu : hauteur / 720 ; jeu : 1), opts.editor = true :
-- rien d'interactif. Renvoie { racine = CanvasGroup, byId = { [id] = objet }, byName = { [nom] = objet },
-- errors = { textes FR } }. Un élément qui échoue est ignoré (avec ses enfants) sans arrêter le reste.
function GuiBuild.build(doc, parent, opts)
	opts = type(opts) == "table" and opts or {}
	local k = tonumber(opts.scale)
	if not isFinite(k) or k <= 0 then
		k = 1
	end
	k = math.clamp(k, K_MIN, K_MAX)
	local editor = opts.editor == true
	doc = asDoc(doc)

	-- NOTE: opts.rootClass = "Frame" (en plus de la SPEC) : Racine en simple Frame, au cas où un
	-- CanvasGroup s'afficherait mal dans l'aperçu du plugin. Par défaut (et en jeu) : CanvasGroup.
	local rootClass = "CanvasGroup"
	if opts.rootClass == "Frame" then
		rootClass = "Frame"
	end
	local racine = Instance.new(rootClass)
	racine.Name = GuiBuild.ROOT_NAME
	racine.AnchorPoint = Vector2.new(0.5, 0.5)
	racine.Position = UDim2.fromScale(0.5, 0.5)
	racine.Size = UDim2.fromScale(1, 1)
	racine.BackgroundTransparency = 1
	racine.BorderSizePixel = 0
	if racine:IsA("CanvasGroup") then
		racine.GroupTransparency = 0
	end
	racine.ZIndex = 1
	racine:SetAttribute("BlocsFR_Racine", true)
	racine:SetAttribute("BlocsFR_K", k)
	if editor then
		racine.Active = false
		pcall(function()
			(racine :: any).Interactable = false
		end)
	end

	local result = { racine = racine, byId = {}, byName = {}, errors = {} }
	local built = {}

	local function buildOne(id, parentInst, index, layout, depth)
		local el = doc.elements[id]
		if el == nil or depth > 64 then
			return
		end
		local ok, inst = pcall(createElement, doc, el, index, layout, editor)
		if not ok then
			table.insert(result.errors, "Élément « " .. tostring(el.name) .. " » non construit : " .. tostring(inst))
			return
		end
		inst.Parent = parentInst
		table.insert(built, inst)
		result.byId[id] = inst
		if result.byName[el.name] == nil then
			result.byName[el.name] = inst
		end
		local childLayout = nil
		if el.type == "liste" or el.type == "grille" then
			local _, _, refW, refH = doc:absRect(id, GuiDoc.REF_W, GuiDoc.REF_H)
			childLayout = { refW = refW, refH = refH }
		end
		for i, childId in ipairs(el.children) do
			buildOne(childId, inst, i, childLayout, depth + 1)
		end
	end

	for i, id in ipairs(doc.tops) do
		buildOne(id, racine, i, nil, 0)
	end
	for _, inst in ipairs(built) do
		local ok, err = pcall(appliquer, inst, k)
		if not ok then
			table.insert(result.errors, "Élément « " .. inst.Name .. " » : " .. tostring(err))
		end
	end
	if typeof(parent) == "Instance" then
		racine.Parent = parent
	end
	return result
end

---------------------------------------------------------------------------
-- Données JSON (StringValue « BlocsFR_Interface », puis _2, _3… si le texte est long)
---------------------------------------------------------------------------

local function chunkName(index)
	if index == 1 then
		return GuiBuild.DATA_NAME
	end
	return GuiBuild.DATA_NAME .. "_" .. tostring(index)
end

function GuiBuild.isDataName(name)
	return name == GuiBuild.DATA_NAME or string.match(tostring(name), "^" .. GuiBuild.DATA_NAME .. "_%d+$") ~= nil
end

-- Découpe sans casser un caractère UTF-8
local function splitChunks(text, size)
	local chunks = {}
	local length = #text
	local start = 1
	while start <= length do
		local stop = math.min(start + size - 1, length)
		if stop < length then
			while stop > start do
				local nextByte = string.byte(text, stop + 1)
				if nextByte >= 0x80 and nextByte < 0xC0 then
					stop -= 1
				else
					break
				end
			end
		end
		table.insert(chunks, string.sub(text, start, stop))
		start = stop + 1
	end
	if #chunks == 0 then
		table.insert(chunks, "")
	end
	return chunks
end

-- Écrit le JSON dans container (StringValue réutilisées, morceaux en trop retirés)
function GuiBuild.writeData(container, json)
	local chunks = splitChunks(json, GuiBuild.CHUNK_SIZE)
	for index, chunk in ipairs(chunks) do
		local name = chunkName(index)
		local holder = container:FindFirstChild(name)
		if holder ~= nil and not holder:IsA("StringValue") then
			holder.Parent = nil
			holder = nil
		end
		if holder == nil then
			holder = Instance.new("StringValue")
			holder.Name = name
			holder.Value = chunk
			holder.Parent = container
		else
			holder.Value = chunk
		end
	end
	local index = #chunks + 1
	while true do
		local stale = container:FindFirstChild(chunkName(index))
		if stale == nil then
			break
		end
		stale.Parent = nil
		index += 1
	end
end

-- JSON recollé, ou nil
function GuiBuild.readData(container)
	if typeof(container) ~= "Instance" then
		return nil
	end
	local ok, json = pcall(function()
		local parts = {}
		local index = 1
		while true do
			local holder = container:FindFirstChild(chunkName(index))
			if holder == nil or not holder:IsA("StringValue") then
				break
			end
			table.insert(parts, holder.Value)
			index += 1
		end
		if #parts == 0 then
			return nil
		end
		return table.concat(parts)
	end)
	if ok then
		return json
	end
	return nil
end

---------------------------------------------------------------------------
-- Effets en jeu : LocalScript « BlocsFR_Effets » (autonome : aucun require, jamais d'erreur)
---------------------------------------------------------------------------

GuiBuild.EFFECTS_SOURCE = [==[
-- BlocsFR_Effets : effets de l'interface créée avec le Studio d'interface de Blocs FR.
-- 1) adapte les tailles en pixels (arrondis, contours, relief, textes) à la taille de l'écran ;
-- 2) fait « rebondir » les boutons (survol : un peu plus grand, clic : enfoncé).
-- Ce script est recréé à chaque enregistrement de l'écran : ne le modifie pas.

local TweenService = game:GetService("TweenService")

local ecran = script.Parent
local HAUTEUR_REFERENCE = 720
local MARGE_LISTE = 8
local TAILLE_TEXTE_MAX = 100
local k = 1
local branches = setmetatable({}, { __mode = "k" })

local function nombre(objet, attribut, defaut)
	local valeur = objet:GetAttribute(attribut)
	if type(valeur) == "number" and valeur == valeur then
		return valeur
	end
	return defaut
end

local function partie(parent, nom)
	for _, enfant in ipairs(parent:GetChildren()) do
		if enfant.Name == nom and enfant:GetAttribute("BlocsFR_Type") == nil then
			return enfant
		end
	end
	return nil
end

local function appliquer(objet)
	local genre = objet:GetAttribute("BlocsFR_Type")
	local arrondi = nombre(objet, "BlocsFR_Arrondi", 0) * k
	local contour = nombre(objet, "BlocsFR_Contour", 0) * k
	local relief = nombre(objet, "BlocsFR_Relief", 0) * k
	local taille = nombre(objet, "BlocsFR_TailleTexte", 32) * k
	local trait = nombre(objet, "BlocsFR_TexteContour", 0) * k
	local marge = nombre(objet, "BlocsFR_Marge", 0) * k

	local s = 1
	if genre == "texte" and taille > TAILLE_TEXTE_MAX then
		s = taille / TAILLE_TEXTE_MAX
	end
	local l = objet:GetAttribute("BlocsFR_L")
	local h = objet:GetAttribute("BlocsFR_H")
	if type(l) == "number" and type(h) == "number" then
		objet.Size = UDim2.fromOffset(l * k / s, h * k / s)
	elseif genre == "texte" then
		local largeur = nombre(objet, "BlocsFR_Largeur", nil)
		local hauteur = nombre(objet, "BlocsFR_Hauteur", nil)
		if largeur ~= nil and hauteur ~= nil then
			objet.Size = UDim2.fromScale(largeur / s, hauteur / s)
		end
	end
	if genre == "texte" then
		objet:SetAttribute("BlocsFR_EchelleTexte", s)
		local echelle = objet:FindFirstChild("BlocsFR_Echelle")
		if echelle == nil and s ~= 1 then
			echelle = Instance.new("UIScale")
			echelle.Name = "BlocsFR_Echelle"
			echelle.Parent = objet
		end
		if echelle ~= nil and echelle:IsA("UIScale") then
			echelle.Scale = s * nombre(objet, "BlocsFR_EchelleBase", 1)
		end
	end

	local function arrondir(cible)
		local coin = cible:FindFirstChild("BlocsFR_Arrondi")
		if coin ~= nil and coin:IsA("UICorner") then
			coin.CornerRadius = UDim.new(0, arrondi / s)
		end
	end
	arrondir(objet)
	local face = partie(objet, "Face")
	if face ~= nil and face:IsA("GuiObject") then
		arrondir(face)
		face.Size = UDim2.new(1, 0, 1, -relief)
	end
	local rempli = partie(objet, "Remplissage")
	if rempli ~= nil then
		arrondir(rempli)
	end
	local bord = objet:FindFirstChild("BlocsFR_Contour")
	if bord ~= nil and bord:IsA("UIStroke") then
		bord.Thickness = contour / s
	end

	local zone = nil
	if genre == "texte" or genre == "champ" then
		zone = objet
	elseif face ~= nil then
		zone = partie(face, "Texte")
	else
		zone = partie(objet, "Texte")
	end
	if zone ~= nil then
		local maximum = zone:FindFirstChild("BlocsFR_TailleMax")
		if maximum ~= nil and maximum:IsA("UITextSizeConstraint") then
			maximum.MaxTextSize = math.clamp(math.floor(taille / s + 0.5), 1, TAILLE_TEXTE_MAX)
		end
		local trace = zone:FindFirstChild("BlocsFR_ContourTexte")
		if trace ~= nil and trace:IsA("UIStroke") then
			trace.Thickness = trait / s
		end
		local marges = zone:FindFirstChild("BlocsFR_Marges")
		if marges ~= nil and marges:IsA("UIPadding") then
			local m = marge / s
			marges.PaddingLeft = UDim.new(0, m)
			marges.PaddingRight = UDim.new(0, m)
			marges.PaddingTop = UDim.new(0, m * 0.4)
			marges.PaddingBottom = UDim.new(0, m * 0.4)
		end
	end

	if genre == "liste" or genre == "grille" then
		local ecart = nombre(objet, "BlocsFR_Espacement", 0) * k
		if objet:IsA("ScrollingFrame") then
			objet.ScrollBarThickness = math.max(2, math.floor(6 * k + 0.5))
		end
		local disposition = objet:FindFirstChild("BlocsFR_Disposition")
		if disposition ~= nil and disposition:IsA("UIListLayout") then
			disposition.Padding = UDim.new(0, ecart)
		elseif disposition ~= nil and disposition:IsA("UIGridLayout") then
			disposition.CellPadding = UDim2.fromOffset(ecart, ecart)
			disposition.CellSize = UDim2.fromOffset(nombre(objet, "BlocsFR_CelluleL", 100) * k, nombre(objet, "BlocsFR_CelluleH", 100) * k)
		end
		local marges = objet:FindFirstChild("BlocsFR_Marges")
		if marges ~= nil and marges:IsA("UIPadding") then
			local m = MARGE_LISTE * k
			marges.PaddingLeft = UDim.new(0, m)
			marges.PaddingRight = UDim.new(0, m)
			marges.PaddingTop = UDim.new(0, m)
			marges.PaddingBottom = UDim.new(0, m)
		end
	end
end

local function animer(objet, duree, proprietes)
	pcall(function()
		local tween = TweenService:Create(objet, TweenInfo.new(duree, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), proprietes)
		tween:Play()
	end)
end

local function echelleDe(objet)
	local echelle = objet:FindFirstChild("BlocsFR_Echelle")
	if echelle == nil or not echelle:IsA("UIScale") then
		echelle = Instance.new("UIScale")
		echelle.Name = "BlocsFR_Echelle"
		echelle.Scale = nombre(objet, "BlocsFR_EchelleTexte", 1) * nombre(objet, "BlocsFR_EchelleBase", 1)
		echelle.Parent = objet
	end
	return echelle
end

local function brancherRebond(bouton)
	if branches[bouton] then
		return
	end
	branches[bouton] = true
	local survol = false
	local appui = false
	local function mettreAJour(duree)
		local base = nombre(bouton, "BlocsFR_EchelleTexte", 1) * nombre(bouton, "BlocsFR_EchelleBase", 1)
		local cible = base
		if appui then
			cible = base * 0.95
		elseif survol then
			cible = base * 1.05
		end
		animer(echelleDe(bouton), duree, { Scale = cible })
		local face = partie(bouton, "Face")
		if face ~= nil and face:IsA("GuiObject") then
			local decalage = 0
			if appui then
				decalage = nombre(bouton, "BlocsFR_Relief", 0) * k * 0.6
			end
			animer(face, duree, { Position = UDim2.fromOffset(0, decalage) })
		end
	end
	bouton.MouseEnter:Connect(function()
		survol = true
		mettreAJour(0.12)
	end)
	bouton.MouseLeave:Connect(function()
		survol = false
		appui = false
		mettreAJour(0.12)
	end)
	bouton.MouseButton1Down:Connect(function()
		appui = true
		mettreAJour(0.08)
	end)
	bouton.MouseButton1Up:Connect(function()
		appui = false
		mettreAJour(0.1)
	end)
end

local function preparer(objet)
	if objet:GetAttribute("BlocsFR_Type") == nil then
		return
	end
	pcall(appliquer, objet)
	if objet:IsA("GuiButton") and objet:GetAttribute("BlocsFR_Effet") == "rebond" then
		pcall(brancherRebond, objet)
	end
end

local function calculerK()
	local hauteur = HAUTEUR_REFERENCE
	local camera = workspace.CurrentCamera
	if camera ~= nil and camera.ViewportSize.Y > 1 then
		hauteur = camera.ViewportSize.Y
	end
	k = math.clamp(hauteur / HAUTEUR_REFERENCE, 0.5, 2)
end

local function toutAppliquer()
	calculerK()
	for _, objet in ipairs(ecran:GetDescendants()) do
		preparer(objet)
	end
end

local connexionCamera = nil
local function suivreCamera()
	if connexionCamera ~= nil then
		connexionCamera:Disconnect()
		connexionCamera = nil
	end
	local camera = workspace.CurrentCamera
	if camera ~= nil then
		connexionCamera = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			pcall(toutAppliquer)
		end)
	end
	pcall(toutAppliquer)
end

ecran.DescendantAdded:Connect(function(objet)
	task.defer(function()
		pcall(function()
			calculerK()
			preparer(objet)
		end)
	end)
end)
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	pcall(suivreCamera)
end)
pcall(suivreCamera)
]==]

---------------------------------------------------------------------------
-- ScreenGui complet
---------------------------------------------------------------------------

-- Applique les propriétés de l'écran (doc.props) à un ScreenGui
function GuiBuild.applyScreenProps(screenGui, doc)
	doc = asDoc(doc)
	screenGui.Name = GuiDoc.cleanName(doc.name) or GuiDoc.DEFAULT_NAME
	screenGui.IgnoreGuiInset = true
	screenGui.ResetOnSpawn = not doc.props.garderApresMort
	screenGui.DisplayOrder = doc.props.ordre
	screenGui.Enabled = doc.props.visibleAuDemarrage
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui:SetAttribute(GuiBuild.ATTR, true)
end

-- ScreenGui non parenté : Racine + JSON + LocalScript des effets
function GuiBuild.buildScreenGui(doc)
	doc = asDoc(doc)
	local screenGui = Instance.new("ScreenGui")
	GuiBuild.applyScreenProps(screenGui, doc)
	GuiBuild.build(doc, screenGui, { scale = 1 })
	local ok, json = pcall(function()
		return HttpService:JSONEncode(doc:serialize())
	end)
	if ok and type(json) == "string" then
		GuiBuild.writeData(screenGui, json)
	end
	local effets = Instance.new("LocalScript")
	effets.Name = GuiBuild.EFFECTS_NAME
	pcall(function()
		effets.Source = GuiBuild.EFFECTS_SOURCE
	end)
	effets.Parent = screenGui
	return screenGui
end

return GuiBuild
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">GuiDoc</string><ProtectedString name="Source"><![CDATA[-- GuiDoc : données d'un écran du Studio d'interface (SPEC §21.2).
--
-- Un écran = une liste d'éléments (cadre, texte, bouton…) rangés en arbre. Les positions et les
-- tailles sont des fractions du PARENT (x, y = position du point d'ancrage ax, ay) ; les valeurs en
-- pixels (arrondi, contour, relief, tailles de texte, espacement) sont données pour un écran de
-- référence de 1280 × 720 et multipliées par k à la construction (GuiBuild).
--
-- Comme Model : les méthodes qui modifient le document ne déclenchent PAS Changed ; l'appelant
-- regroupe une action de l'utilisateur puis appelle doc:commit(raison) une seule fois.
--
-- NOTE: ajouts à la SPEC (facultatifs pour les autres modules) :
--   * doc:set(id, "ax" | "ay", v) garde l'élément à la même place à l'écran (x / y sont corrigés) ;
--   * doc:set(id, "name", v) passe par doc:rename ;
--   * doc:setName(nom) -> ok, erreurFR (nom de l'écran) et doc:setProp(cle, valeur) -> ok ;
--   * doc:cellSize(idGrille) -> largeur, hauteur des cases d'une grille (px de référence) ;
--   * doc:descendants(id) -> ids ; doc:isAncestor(a, b) -> bool ; doc:destroy() ;
--   * doc.uid : identifiant de l'écran (GuiStorage refuse d'écraser un AUTRE écran du même nom) ;
--   * les enfants d'une liste / grille sont placés par la disposition : absRect / hitTest imitent
--     UIListLayout / UIGridLayout (marge GuiDoc.LIST_PAD, espacement, colonnes) ; leur taille vaut
--     w × largeur de la liste (px de référence) × k, pour que les cases restent carrées.
--   * en données sérialisées, une couleur facultative absente (fond, fond2, reliefCouleur) est
--     écrite false (JSON n'a pas nil) ; fromData accepte aussi nil (= valeur par défaut du type).

local HttpService = game:GetService("HttpService")

local Util = require(script.Parent.Util)

local GuiDoc = {}
GuiDoc.__index = GuiDoc

GuiDoc.FORMAT = "BlocsFR_GUI"
GuiDoc.VERSION = 1
GuiDoc.TYPES = { "cadre", "texte", "bouton", "image", "barre", "champ", "liste", "grille" }
GuiDoc.REF_W, GuiDoc.REF_H = 1280, 720
GuiDoc.MAX_HISTORY = 60
GuiDoc.MAX_NAME = 40
GuiDoc.MAX_TEXT = 2000
GuiDoc.LIST_PAD = 8 -- marge intérieure des listes et grilles (px de référence), aussi utilisée par GuiBuild
GuiDoc.DEFAULT_NAME = "Écran"

-- Polices proposées (noms de Enum.Font)
GuiDoc.FONTS = {
	"FredokaOne",
	"LuckiestGuy",
	"GothamBold",
	"GothamBlack",
	"BuilderSansExtraBold",
	"Bangers",
	"Cartoon",
	"Arcade",
	"Creepster",
	"PermanentMarker",
	"Oswald",
	"Michroma",
	"SpecialElite",
	"IndieFlower",
	"SourceSansBold",
}

-- Nom affiché (et nom de base des nouveaux éléments)
GuiDoc.TYPE_LABELS = {
	cadre = "Cadre",
	texte = "Texte",
	bouton = "Bouton",
	image = "Image",
	barre = "Barre",
	champ = "Champ",
	liste = "Liste",
	grille = "Grille",
}

-- Types qui peuvent contenir d'autres éléments
GuiDoc.PARENT_TYPES = { cadre = true, liste = true, grille = true }

-- Taille par défaut (px à 1280 × 720)
GuiDoc.DEFAULT_SIZE = {
	bouton = { 240, 56 },
	texte = { 320, 64 },
	cadre = { 420, 280 },
	image = { 120, 120 },
	barre = { 300, 28 },
	champ = { 320, 52 },
	liste = { 320, 320 },
	grille = { 420, 320 },
}

-- Filtres des entrées « gui » des blocs (SPEC §21.6) : types acceptés (nil = tous ; "ecran" à part)
GuiDoc.FILTERS = {
	element = nil,
	bouton = { bouton = true },
	texte = { texte = true, bouton = true, champ = true, barre = true },
	barre = { barre = true },
	champ = { champ = true },
	image = { image = true },
}

local TYPE_SET = {}
for _, t in ipairs(GuiDoc.TYPES) do
	TYPE_SET[t] = true
end

local DARK = { 14, 22, 48 } -- #0E1630, contour « jeu »

-- Valeurs par défaut communes (SPEC §21.2)
local COMMON = {
	x = 0.5,
	y = 0.5,
	w = 0.2,
	h = 0.1,
	ax = 0.5,
	ay = 0.5,
	rotation = 0,
	visible = true,
	transparence = 0,
	arrondi = 12,
	contour = 3,
	contourCouleur = DARK,
	relief = 0,
	texte = "",
	police = "FredokaOne",
	tailleTexte = 32,
	texteCouleur = { 255, 255, 255 },
	texteContour = 2,
	texteContourCouleur = DARK,
	alignement = "centre",
	image = "",
	imageCouleur = { 255, 255, 255 },
	valeur = 0.7,
	barreCouleur = { 47, 191, 90 },
	indice = "Écris ici…",
	direction = "verticale",
	espacement = 8,
	colonnes = 3,
	effet = "aucun",
}

-- Valeurs propres à chaque type
local PER_TYPE = {
	cadre = { fond = { 43, 58, 103 }, fond2 = { 30, 42, 74 }, arrondi = 18, contour = 4 },
	texte = { fond = { 30, 42, 74 }, transparence = 1, texte = "Texte", contour = 0 },
	bouton = { fond = { 111, 240, 143 }, fond2 = { 47, 191, 90 }, texte = "BOUTON", relief = 6, effet = "rebond" },
	image = { contour = 0 },
	barre = { fond = { 14, 22, 48 } },
	champ = {
		fond = { 255, 255, 255 },
		texteCouleur = { 31, 31, 35 },
		arrondi = 10,
		texteContour = 0,
		tailleTexte = 24,
		alignement = "gauche",
	},
	liste = { fond = { 30, 42, 74 }, transparence = 0.3 },
	grille = { fond = { 30, 42, 74 }, transparence = 0.3 },
}

-- Champs modifiables d'un élément et leurs règles (lecture seule pour les autres modules)
local FIELD = {
	x = { kind = "num", min = -10, max = 10 },
	y = { kind = "num", min = -10, max = 10 },
	w = { kind = "num", min = 0.001, max = 10 },
	h = { kind = "num", min = 0.001, max = 10 },
	ax = { kind = "num", min = 0, max = 1 },
	ay = { kind = "num", min = 0, max = 1 },
	rotation = { kind = "num", min = -3600, max = 3600 },
	visible = { kind = "bool" },
	fond = { kind = "color", optional = true },
	fond2 = { kind = "color", optional = true },
	transparence = { kind = "num", min = 0, max = 1 },
	arrondi = { kind = "num", min = 0, max = 1000 },
	contour = { kind = "num", min = 0, max = 60 },
	contourCouleur = { kind = "color" },
	relief = { kind = "num", min = 0, max = 100 },
	reliefCouleur = { kind = "color", optional = true },
	texte = { kind = "text" },
	police = { kind = "font" },
	tailleTexte = { kind = "num", min = 1, max = 400 },
	texteCouleur = { kind = "color" },
	texteContour = { kind = "num", min = 0, max = 40 },
	texteContourCouleur = { kind = "color" },
	alignement = { kind = "enum", values = { gauche = true, centre = true, droite = true } },
	image = { kind = "image" },
	imageCouleur = { kind = "color" },
	valeur = { kind = "num", min = 0, max = 1 },
	barreCouleur = { kind = "color" },
	indice = { kind = "text" },
	direction = { kind = "enum", values = { verticale = true, horizontale = true } },
	espacement = { kind = "num", min = 0, max = 500 },
	colonnes = { kind = "int", min = 1, max = 20 },
	effet = { kind = "enum", values = { rebond = true, aucun = true } },
}
GuiDoc.FIELDS = FIELD

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Nombre (ou texte "3,5") fini, sinon nil
local function toNumber(value)
	if type(value) == "number" then
		if isFinite(value) then
			return value
		end
		return nil
	end
	local n = Util.parseNumber(value)
	if isFinite(n) then
		return n
	end
	return nil
end

local function indexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

local function removeValue(list, value)
	local i = indexOf(list, value)
	if i ~= nil then
		table.remove(list, i)
	end
	return i
end

-- {r, g, b} entiers 0-255 (copie) à partir d'une table ou d'une Color3 ; nil si invalide
local function copyColor(value)
	if typeof(value) == "Color3" then
		return Util.color3ToRgb(value)
	end
	if type(value) ~= "table" then
		return nil
	end
	local out = {}
	for i = 1, 3 do
		local n = tonumber(value[i])
		if not isFinite(n) then
			return nil
		end
		out[i] = math.floor(Util.clamp(n, 0, 255) + 0.5)
	end
	return out
end

-- Coupe une chaîne à maxBytes octets sans casser un caractère UTF-8
local function truncateUtf8(s, maxBytes)
	if #s <= maxBytes then
		return s
	end
	local cut = maxBytes
	while cut > 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b < 0x80 or b >= 0xC0 then
			break
		end
		cut -= 1
	end
	return string.sub(s, 1, cut)
end

-- Les nChars premiers caractères (UTF-8) de s
local function utf8Prefix(s, nChars)
	local ok, offset = pcall(utf8.offset, s, nChars + 1)
	if ok and type(offset) == "number" then
		return string.sub(s, 1, offset - 1)
	end
	return s
end

-- "e2" < "e10" < "autre"
local function idNumber(id)
	if type(id) ~= "string" then
		return nil
	end
	local digits = string.match(id, "^e(%d+)$")
	if digits == nil or #digits > 9 then
		return nil
	end
	return tonumber(digits)
end

local function idLess(a, b)
	local na, nb = idNumber(a), idNumber(b)
	if na ~= nil and nb ~= nil then
		if na ~= nb then
			return na < nb
		end
		return a < b
	end
	if na ~= nil then
		return true
	end
	if nb ~= nil then
		return false
	end
	return tostring(a) < tostring(b)
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in pairs(a) do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function newUid()
	local ok, guid = pcall(function()
		return HttpService:GenerateGUID(false)
	end)
	if ok and type(guid) == "string" then
		return guid
	end
	return tostring(math.random(1, 2 ^ 30)) .. "-" .. tostring(os.clock())
end

---------------------------------------------------------------------------
-- Validation des valeurs
---------------------------------------------------------------------------

local fontCache = {}

-- Vrai si name est un nom de police Roblox (Enum.Font)
function GuiDoc.isFont(name)
	if type(name) ~= "string" or name == "" then
		return false
	end
	local cached = fontCache[name]
	if cached ~= nil then
		return cached
	end
	local ok, font = pcall(function()
		return (Enum.Font :: any)[name]
	end)
	local valid = ok and typeof(font) == "EnumItem"
	fontCache[name] = valid
	return valid
end

-- Image : un nombre (ou des chiffres) devient "rbxassetid://n" ; "" = pas d'image
function GuiDoc.normalizeImage(value)
	if type(value) == "number" then
		if not isFinite(value) or value < 0 then
			return nil
		end
		return "rbxassetid://" .. string.format("%d", math.floor(value))
	end
	if type(value) ~= "string" then
		return nil
	end
	local s = Util.trim(value)
	if string.match(s, "^%d+$") then
		return "rbxassetid://" .. s
	end
	return truncateUtf8(s, 500)
end

-- Renvoie ok, valeurConvertie pour le champ `key`
local function coerceField(key, value)
	local spec = FIELD[key]
	if spec == nil then
		return false, nil
	end
	local kind = spec.kind
	if value == nil or (value == false and spec.optional) then
		if spec.optional then
			return true, nil
		end
		return false, nil
	end
	if kind == "num" then
		local n = toNumber(value)
		if n == nil then
			return false, nil
		end
		return true, Util.clamp(n, spec.min, spec.max)
	elseif kind == "int" then
		local n = toNumber(value)
		if n == nil then
			return false, nil
		end
		return true, math.floor(Util.clamp(n, spec.min, spec.max) + 0.5)
	elseif kind == "bool" then
		if type(value) == "boolean" then
			return true, value
		end
		return false, nil
	elseif kind == "color" then
		local rgb = copyColor(value)
		if rgb == nil then
			return false, nil
		end
		return true, rgb
	elseif kind == "text" then
		if type(value) == "number" and isFinite(value) then
			value = tostring(value)
		end
		if type(value) ~= "string" then
			return false, nil
		end
		return true, truncateUtf8(value, GuiDoc.MAX_TEXT)
	elseif kind == "font" then
		if GuiDoc.isFont(value) then
			return true, value
		end
		return false, nil
	elseif kind == "enum" then
		if type(value) == "string" and spec.values[value] then
			return true, value
		end
		return false, nil
	elseif kind == "image" then
		local image = GuiDoc.normalizeImage(value)
		if image == nil then
			return false, nil
		end
		return true, image
	end
	return false, nil
end

-- Vérifie un champ sans rien modifier : renvoie ok, valeurConvertie
function GuiDoc.validate(key, value)
	return coerceField(key, value)
end

-- Nom d'écran ou d'élément : sans espaces aux extrémités, 1 à 40 caractères, sans « / ».
-- Renvoie nomNettoyé ou nil, erreurFR
function GuiDoc.cleanName(name)
	if type(name) == "number" and isFinite(name) then
		name = tostring(name)
	end
	if type(name) ~= "string" then
		return nil, "Nom invalide."
	end
	local clean = Util.trim((string.gsub(name, "%c", " ")))
	if clean == "" then
		return nil, "Le nom ne peut pas être vide."
	end
	if string.find(clean, "/", 1, true) then
		return nil, "Le nom ne peut pas contenir « / »."
	end
	local length = utf8.len(clean)
	if length == nil then
		return nil, "Le nom contient des caractères invalides."
	end
	if length > GuiDoc.MAX_NAME then
		return nil, "Le nom est trop long (" .. GuiDoc.MAX_NAME .. " caractères maximum)."
	end
	return clean, nil
end

local function defaultsFor(t)
	local el = {}
	for key, value in pairs(COMMON) do
		el[key] = Util.deepCopy(value)
	end
	for key, value in pairs(PER_TYPE[t] or {}) do
		el[key] = Util.deepCopy(value)
	end
	return el
end

local function normalizeProps(raw)
	local props = { visibleAuDemarrage = true, garderApresMort = true, ordre = 0 }
	if type(raw) ~= "table" then
		return props
	end
	if type(raw.visibleAuDemarrage) == "boolean" then
		props.visibleAuDemarrage = raw.visibleAuDemarrage
	end
	if type(raw.garderApresMort) == "boolean" then
		props.garderApresMort = raw.garderApresMort
	end
	local ordre = toNumber(raw.ordre)
	if ordre ~= nil then
		props.ordre = math.floor(Util.clamp(ordre, -1000, 1000) + 0.5)
	end
	return props
end

---------------------------------------------------------------------------
-- Création
---------------------------------------------------------------------------

local function blank()
	local self = setmetatable({}, GuiDoc)
	self.name = GuiDoc.DEFAULT_NAME
	self.uid = newUid()
	self.props = normalizeProps(nil)
	self.elements = {}
	self.tops = {}
	self.Changed = Util.Signal.new()
	self.dirty = false
	self._counter = 0
	self._history = {}
	self._historyIndex = 0
	self._savedIndex = nil
	return self
end

function GuiDoc.new(name)
	local self = blank()
	self.name = GuiDoc.cleanName(name) or GuiDoc.DEFAULT_NAME
	self:_resetHistory()
	return self
end

function GuiDoc:destroy()
	self.Changed:Destroy()
end

function GuiDoc:_newId()
	local id
	repeat
		self._counter += 1
		id = "e" .. tostring(self._counter)
	until self.elements[id] == nil
	return id
end

-- Liste des frères (tops ou enfants du parent) — la vraie table, à ne pas exposer
function GuiDoc:_siblings(parentId)
	if parentId == nil then
		return self.tops
	end
	local parent = self.elements[parentId]
	if parent == nil then
		return self.tops
	end
	return parent.children
end

-- Parcourt les éléments dans l'ordre de l'arbre (ordre d'affichage, parent avant ses enfants)
function GuiDoc:_walk(fn)
	local seen = {}
	local function visit(ids, depth)
		if depth > 64 then
			return
		end
		for _, id in ipairs(ids) do
			local el = self.elements[id]
			if el ~= nil and not seen[id] then
				seen[id] = true
				fn(el, depth)
				visit(el.children, depth + 1)
			end
		end
	end
	visit(self.tops, 0)
end

function GuiDoc:_nameTaken(name, exceptId)
	for id, el in pairs(self.elements) do
		if id ~= exceptId and el.name == name then
			return true
		end
	end
	return false
end

-- Nom libre à partir de base : "Bouton", "Bouton 2", "Bouton 3"…
function GuiDoc:_uniqueName(base, exceptId)
	local clean = GuiDoc.cleanName(base) or "Élément"
	if not self:_nameTaken(clean, exceptId) then
		return clean
	end
	local root, digits = string.match(clean, "^(.-) (%d+)$")
	local start = 2
	if root ~= nil and root ~= "" and #digits <= 6 then
		clean = root
		start = (tonumber(digits) or 1) + 1
	end
	for n = start, start + 100000 do
		local suffix = " " .. tostring(n)
		local stem = clean
		local length = utf8.len(stem) or #stem
		if length + #suffix > GuiDoc.MAX_NAME then
			stem = utf8Prefix(stem, math.max(GuiDoc.MAX_NAME - #suffix, 1))
		end
		local candidate = stem .. suffix
		if not self:_nameTaken(candidate, exceptId) then
			return candidate
		end
	end
	return clean
end

-- Taille du parent en px de référence (1280 × 720)
function GuiDoc:_parentRefSize(parentId)
	if parentId == nil or self.elements[parentId] == nil then
		return GuiDoc.REF_W, GuiDoc.REF_H
	end
	local _, _, w, h = self:absRect(parentId, GuiDoc.REF_W, GuiDoc.REF_H)
	return math.max(w, 1e-6), math.max(h, 1e-6)
end

-- Nouvel élément. x, y, w, h : fractions du parent (nil = centré / taille par défaut du type).
-- props : champs de départ (name compris). Renvoie l'id, ou nil (type ou parent invalide).
function GuiDoc:add(elementType, parentId, x, y, w, h, props)
	if not TYPE_SET[elementType] then
		return nil
	end
	if parentId ~= nil then
		local parent = self.elements[parentId]
		if parent == nil or not GuiDoc.PARENT_TYPES[parent.type] then
			return nil
		end
	end
	local el = defaultsFor(elementType)
	el.id = self:_newId()
	el.type = elementType
	el.parent = parentId
	el.children = {}
	local sizeGiven = { w = false, h = false }
	if type(props) == "table" then
		for key, value in pairs(props) do
			if type(key) == "string" and FIELD[key] ~= nil then
				local ok, v = coerceField(key, value)
				if ok then
					el[key] = v
					if key == "w" or key == "h" then
						sizeGiven[key] = true
					end
				end
			end
		end
	end
	local nx, ny, nw, nh = toNumber(x), toNumber(y), toNumber(w), toNumber(h)
	if nx ~= nil then
		el.x = Util.clamp(nx, FIELD.x.min, FIELD.x.max)
	end
	if ny ~= nil then
		el.y = Util.clamp(ny, FIELD.y.min, FIELD.y.max)
	end
	local pw, ph = self:_parentRefSize(parentId)
	local size = GuiDoc.DEFAULT_SIZE[elementType]
	if nw ~= nil then
		el.w = Util.clamp(nw, FIELD.w.min, FIELD.w.max)
	elseif not sizeGiven.w then
		el.w = Util.clamp(size[1] / pw, FIELD.w.min, FIELD.w.max)
	end
	if nh ~= nil then
		el.h = Util.clamp(nh, FIELD.h.min, FIELD.h.max)
	elseif not sizeGiven.h then
		el.h = Util.clamp(size[2] / ph, FIELD.h.min, FIELD.h.max)
	end
	local base = GuiDoc.TYPE_LABELS[elementType]
	if type(props) == "table" and props.name ~= nil and GuiDoc.cleanName(props.name) ~= nil then
		base = props.name
	end
	el.name = self:_uniqueName(base, nil)
	self.elements[el.id] = el
	table.insert(self:_siblings(parentId), el.id)
	return el.id
end

---------------------------------------------------------------------------
-- Lecture
---------------------------------------------------------------------------

function GuiDoc:get(id)
	if id == nil then
		return nil
	end
	return self.elements[id]
end

-- Copie de la liste des enfants (nil = éléments de premier niveau), dans l'ordre d'affichage
function GuiDoc:children(id)
	if id == nil then
		return table.clone(self.tops)
	end
	local el = self.elements[id]
	if el == nil then
		return {}
	end
	return table.clone(el.children)
end

function GuiDoc:parentOf(id)
	local el = self.elements[id]
	if el == nil then
		return nil
	end
	return el.parent
end

-- Vrai si ancestorId est un ancêtre (strict) de id
function GuiDoc:isAncestor(ancestorId, id)
	local el = self.elements[id]
	local steps = 0
	while el ~= nil and el.parent ~= nil and steps < 100 do
		if el.parent == ancestorId then
			return true
		end
		el = self.elements[el.parent]
		steps += 1
	end
	return false
end

-- Tous les descendants de id (ordre de l'arbre, sans id)
function GuiDoc:descendants(id)
	local out = {}
	local el = self.elements[id]
	if el == nil then
		return out
	end
	local seen = { [id] = true }
	local function visit(ids, depth)
		if depth > 64 then
			return
		end
		for _, cid in ipairs(ids) do
			local child = self.elements[cid]
			if child ~= nil and not seen[cid] then
				seen[cid] = true
				table.insert(out, cid)
				visit(child.children, depth + 1)
			end
		end
	end
	visit(el.children, 1)
	return out
end

function GuiDoc:findByName(name)
	if type(name) ~= "string" then
		return nil
	end
	for id, el in pairs(self.elements) do
		if el.name == name then
			return id
		end
	end
	return nil
end

-- Noms des éléments (ordre de l'arbre) : { { name =, type = } }.
-- filter : nil / "element" (tous), "bouton", "texte" (texte, bouton, champ, barre), "barre",
-- "champ", "image", ou "ecran" (le nom de cet écran).
function GuiDoc:names(filter)
	if filter == "ecran" then
		return { { name = self.name, type = "ecran" } }
	end
	local allowed = nil
	if filter ~= nil and filter ~= "element" then
		allowed = GuiDoc.FILTERS[filter]
	end
	local out = {}
	self:_walk(function(el)
		if allowed == nil or allowed[el.type] then
			table.insert(out, { name = el.name, type = el.type })
		end
	end)
	return out
end

---------------------------------------------------------------------------
-- Géométrie (px à l'intérieur d'un cadre de frameW × frameH ; k = frameH / 720)
---------------------------------------------------------------------------

-- Largeur et hauteur des cases d'une grille, en px de référence
function GuiDoc:cellSize(id)
	local el = self.elements[id]
	if el == nil or el.type ~= "grille" then
		return 0, 0
	end
	local _, _, gw, gh = self:absRect(id, GuiDoc.REF_W, GuiDoc.REF_H)
	local cols = math.max(el.colonnes, 1)
	local cw = (gw - 2 * GuiDoc.LIST_PAD - (cols - 1) * el.espacement) / cols
	if not isFinite(cw) or cw < 4 then
		cw = 4
	end
	local ch = cw
	local first = el.children[1] and self.elements[el.children[1]]
	if first ~= nil then
		local fw, fh = first.w * gw, first.h * gh
		if fw > 0 and fh > 0 then
			ch = cw * fh / fw
		end
	end
	if not isFinite(ch) then
		ch = cw
	end
	return cw, Util.clamp(ch, 4, 4000)
end

-- Place les enfants d'une liste / grille (imite UIListLayout / UIGridLayout de GuiBuild)
function GuiDoc:_layout(list, listRect, frameW, frameH, memo)
	local k = frameH / GuiDoc.REF_H
	local _, _, refW, refH = self:absRect(list.id, GuiDoc.REF_W, GuiDoc.REF_H)
	local pad = GuiDoc.LIST_PAD * k
	local gap = list.espacement * k
	local x0, y0, lw, lh = listRect[1], listRect[2], listRect[3], listRect[4]
	if list.type == "grille" then
		local cw, ch = self:cellSize(list.id)
		cw *= k
		ch *= k
		local cols = math.max(list.colonnes, 1)
		local rowW = cols * cw + (cols - 1) * gap
		local startX = x0 + (lw - rowW) / 2
		local i = 0
		for _, cid in ipairs(list.children) do
			local child = self.elements[cid]
			if child ~= nil then
				if child.visible then
					local col = i % cols
					local row = math.floor(i / cols)
					memo[cid] = { startX + col * (cw + gap), y0 + pad + row * (ch + gap), cw, ch }
					i += 1
				else
					memo[cid] = { startX, y0 + pad, cw, ch }
				end
			end
		end
		return
	end
	local vertical = list.direction ~= "horizontale"
	local cursor = vertical and (y0 + pad) or (x0 + pad)
	for _, cid in ipairs(list.children) do
		local child = self.elements[cid]
		if child ~= nil then
			local w = child.w * refW * k
			local h = child.h * refH * k
			if vertical then
				memo[cid] = { x0 + (lw - w) / 2, cursor, w, h }
				if child.visible then
					cursor += h + gap
				end
			else
				memo[cid] = { cursor, y0 + (lh - h) / 2, w, h }
				if child.visible then
					cursor += w + gap
				end
			end
		end
	end
end

function GuiDoc:_rect(id, frameW, frameH, memo, depth)
	local cached = memo[id]
	if cached ~= nil then
		return cached
	end
	local el = self.elements[id]
	if el == nil or depth > 64 then
		return nil
	end
	local px, py, pw, ph = 0, 0, frameW, frameH
	local parent = el.parent and self.elements[el.parent]
	if parent ~= nil then
		local pr = self:_rect(parent.id, frameW, frameH, memo, depth + 1)
		if pr ~= nil then
			px, py, pw, ph = pr[1], pr[2], pr[3], pr[4]
			if parent.type == "liste" or parent.type == "grille" then
				self:_layout(parent, pr, frameW, frameH, memo)
				if memo[id] ~= nil then
					return memo[id]
				end
			end
		end
	end
	local w = el.w * pw
	local h = el.h * ph
	local rect = { px + el.x * pw - el.ax * w, py + el.y * ph - el.ay * h, w, h }
	memo[id] = rect
	return rect
end

-- Rectangle (x, y, largeur, hauteur) de l'élément, en px, dans un cadre de frameW × frameH
-- (rotation ignorée). Élément inconnu : 0, 0, 0, 0.
function GuiDoc:absRect(id, frameW, frameH)
	frameW = toNumber(frameW) or GuiDoc.REF_W
	frameH = toNumber(frameH) or GuiDoc.REF_H
	if frameW <= 0 then
		frameW = GuiDoc.REF_W
	end
	if frameH <= 0 then
		frameH = GuiDoc.REF_H
	end
	local rect = self:_rect(id, frameW, frameH, {}, 0)
	if rect == nil then
		return 0, 0, 0, 0
	end
	return rect[1], rect[2], rect[3], rect[4]
end

-- Élément visible le plus en avant qui contient le point (px, py), ou nil
function GuiDoc:hitTest(px, py, frameW, frameH)
	px, py = toNumber(px), toNumber(py)
	if px == nil or py == nil then
		return nil
	end
	frameW = toNumber(frameW) or GuiDoc.REF_W
	frameH = toNumber(frameH) or GuiDoc.REF_H
	if frameW <= 0 or frameH <= 0 then
		return nil
	end
	local memo = {}
	local function test(ids, depth)
		if depth > 64 then
			return nil
		end
		for i = #ids, 1, -1 do
			local el = self.elements[ids[i]]
			if el ~= nil and el.visible then
				local hit = test(el.children, depth + 1)
				if hit ~= nil then
					return hit
				end
				local r = self:_rect(el.id, frameW, frameH, memo, 0)
				if r ~= nil and px >= r[1] and px <= r[1] + r[3] and py >= r[2] and py <= r[2] + r[4] then
					return el.id
				end
			end
		end
		return nil
	end
	return test(self.tops, 0)
end

---------------------------------------------------------------------------
-- Modifications
---------------------------------------------------------------------------

-- Supprime l'élément et tous ses descendants
function GuiDoc:remove(id)
	local el = self.elements[id]
	if el == nil then
		return false
	end
	local ids = self:descendants(id)
	removeValue(self:_siblings(el.parent), id)
	for _, cid in ipairs(ids) do
		self.elements[cid] = nil
	end
	self.elements[id] = nil
	return true
end

-- Copie profonde (avec les descendants), décalée de +0.02 / +0.02, placée juste devant l'original
function GuiDoc:duplicate(id)
	local src = self.elements[id]
	if src == nil then
		return nil
	end
	local function copy(sourceId, parentId, depth)
		local s = self.elements[sourceId]
		if s == nil or depth > 64 then
			return nil
		end
		local c = Util.deepCopy(s)
		c.id = self:_newId()
		c.parent = parentId
		c.children = {}
		c.name = self:_uniqueName(s.name, nil)
		self.elements[c.id] = c
		for _, childId in ipairs(s.children) do
			local newChild = copy(childId, c.id, depth + 1)
			if newChild ~= nil then
				table.insert(c.children, newChild)
			end
		end
		return c.id
	end
	local newId = copy(id, src.parent, 0)
	if newId == nil then
		return nil
	end
	local c = self.elements[newId]
	c.x = Util.clamp(c.x + 0.02, FIELD.x.min, FIELD.x.max)
	c.y = Util.clamp(c.y + 0.02, FIELD.y.min, FIELD.y.max)
	local list = self:_siblings(src.parent)
	local index = indexOf(list, id) or #list
	table.insert(list, index + 1, newId)
	return newId
end

-- Change le parent (nil = premier niveau) en gardant le rectangle à l'écran. index = place parmi
-- les nouveaux frères (nil = devant tout). Seuls cadre / liste / grille peuvent être parents.
function GuiDoc:setParent(id, parentId, index)
	local el = self.elements[id]
	if el == nil then
		return false
	end
	if parentId ~= nil then
		local parent = self.elements[parentId]
		if parent == nil or not GuiDoc.PARENT_TYPES[parent.type] then
			return false
		end
		if parentId == id or self:isAncestor(id, parentId) then
			return false
		end
	end
	local function insertAt(list)
		local n = toNumber(index)
		if n == nil then
			table.insert(list, id)
		else
			table.insert(list, math.floor(Util.clamp(n, 1, #list + 1)), id)
		end
	end
	if el.parent == parentId then
		local list = self:_siblings(parentId)
		removeValue(list, id)
		insertAt(list)
		return true
	end
	local x, y, w, h = self:absRect(id, GuiDoc.REF_W, GuiDoc.REF_H)
	local px, py, pw, ph = 0, 0, GuiDoc.REF_W, GuiDoc.REF_H
	if parentId ~= nil then
		px, py, pw, ph = self:absRect(parentId, GuiDoc.REF_W, GuiDoc.REF_H)
	end
	pw = math.max(pw, 1e-6)
	ph = math.max(ph, 1e-6)
	el.w = Util.clamp(w / pw, FIELD.w.min, FIELD.w.max)
	el.h = Util.clamp(h / ph, FIELD.h.min, FIELD.h.max)
	el.x = Util.clamp((x + el.ax * w - px) / pw, FIELD.x.min, FIELD.x.max)
	el.y = Util.clamp((y + el.ay * h - py) / ph, FIELD.y.min, FIELD.y.max)
	removeValue(self:_siblings(el.parent), id)
	el.parent = parentId
	insertAt(self:_siblings(parentId))
	return true
end

-- Déplace parmi les frères : +1 = vers l'avant (dessiné par-dessus), -1 = vers l'arrière
function GuiDoc:reorder(id, delta)
	local el = self.elements[id]
	if el == nil then
		return false
	end
	local list = self:_siblings(el.parent)
	local i = indexOf(list, id)
	if i == nil then
		return false
	end
	local target = math.floor(Util.clamp(i + (toNumber(delta) or 0), 1, #list))
	if target == i then
		return false
	end
	table.remove(list, i)
	table.insert(list, target, id)
	return true
end

-- Modifie un champ (valeur vérifiée et convertie). Renvoie ok.
function GuiDoc:set(id, key, value)
	local el = self.elements[id]
	if el == nil then
		return false
	end
	if key == "name" then
		local ok = self:rename(id, value)
		return ok
	end
	if FIELD[key] == nil then
		return false
	end
	local ok, v = coerceField(key, value)
	if not ok then
		return false
	end
	if key == "ax" then
		-- l'élément reste à la même place : la position suit le nouveau point d'ancrage
		el.x = Util.clamp(el.x + (v - el.ax) * el.w, FIELD.x.min, FIELD.x.max)
	elseif key == "ay" then
		el.y = Util.clamp(el.y + (v - el.ay) * el.h, FIELD.y.min, FIELD.y.max)
	end
	el[key] = v
	return true
end

-- Position et taille en fractions du parent (nil = inchangé)
function GuiDoc:setRect(id, x, y, w, h)
	local el = self.elements[id]
	if el == nil then
		return false
	end
	local values = { x = x, y = y, w = w, h = h }
	for key, value in pairs(values) do
		local n = toNumber(value)
		if n ~= nil then
			el[key] = Util.clamp(n, FIELD[key].min, FIELD[key].max)
		end
	end
	return true
end

-- Renomme un élément (nom unique dans l'écran). Renvoie ok, erreurFR.
function GuiDoc:rename(id, newName)
	local el = self.elements[id]
	if el == nil then
		return false, "Élément introuvable."
	end
	local clean, err = GuiDoc.cleanName(newName)
	if clean == nil then
		return false, err
	end
	if clean == el.name then
		return true, nil
	end
	if self:_nameTaken(clean, id) then
		return false, "Le nom « " .. clean .. " » est déjà utilisé dans cet écran."
	end
	el.name = clean
	return true, nil
end

-- Nom de l'écran (nom du ScreenGui). Renvoie ok, erreurFR.
function GuiDoc:setName(newName)
	local clean, err = GuiDoc.cleanName(newName)
	if clean == nil then
		return false, err
	end
	self.name = clean
	return true, nil
end

-- Propriétés de l'écran : visibleAuDemarrage (bool), garderApresMort (bool), ordre (entier)
function GuiDoc:setProp(key, value)
	if key == "visibleAuDemarrage" or key == "garderApresMort" then
		if type(value) ~= "boolean" then
			return false
		end
		self.props[key] = value
		return true
	elseif key == "ordre" then
		local n = toNumber(value)
		if n == nil then
			return false
		end
		self.props.ordre = math.floor(Util.clamp(n, -1000, 1000) + 0.5)
		return true
	end
	return false
end

---------------------------------------------------------------------------
-- Sérialisation
---------------------------------------------------------------------------

-- Table JSON-compatible (copie profonde)
function GuiDoc:serialize()
	local elements = {}
	for id, el in pairs(self.elements) do
		local out = {
			id = id,
			type = el.type,
			name = el.name,
			children = table.clone(el.children),
		}
		if el.parent ~= nil then
			out.parent = el.parent
		end
		for key, spec in pairs(FIELD) do
			local value = el[key]
			if value == nil then
				if spec.optional then
					out[key] = false
				end
			elseif type(value) == "table" then
				out[key] = { value[1], value[2], value[3] }
			else
				out[key] = value
			end
		end
		elements[id] = out
	end
	return {
		format = GuiDoc.FORMAT,
		version = GuiDoc.VERSION,
		name = self.name,
		uid = self.uid,
		props = {
			visibleAuDemarrage = self.props.visibleAuDemarrage,
			garderApresMort = self.props.garderApresMort,
			ordre = self.props.ordre,
		},
		tops = table.clone(self.tops),
		elements = elements,
	}
end

-- Remplit le document à partir de données sérialisées (en réparant ce qui doit l'être)
local function populate(self, data, warnings)
	table.clear(self.elements)
	table.clear(self.tops)

	local name = GuiDoc.cleanName(data.name)
	if name == nil then
		name = GuiDoc.DEFAULT_NAME
		if data.name ~= nil then
			table.insert(warnings, "Nom d'écran invalide : « " .. GuiDoc.DEFAULT_NAME .. " » est utilisé.")
		end
	end
	self.name = name
	if type(data.uid) == "string" and data.uid ~= "" and #data.uid <= 100 then
		self.uid = data.uid
	end
	self.props = normalizeProps(data.props)

	local raw = data.elements
	if type(raw) ~= "table" then
		raw = {}
	end

	-- 1) Éléments valides (types inconnus ignorés), champs vérifiés
	local ids = {}
	local unknown = 0
	local badValues = 0
	for id, r in pairs(raw) do
		if type(id) == "string" and id ~= "" and #id <= 60 and type(r) == "table" and TYPE_SET[r.type] then
			table.insert(ids, id)
		else
			unknown += 1
		end
	end
	table.sort(ids, idLess)
	for _, id in ipairs(ids) do
		local r = raw[id]
		local el = defaultsFor(r.type)
		el.id = id
		el.type = r.type
		el.parent = nil
		el.children = {}
		for key in pairs(FIELD) do
			local value = r[key]
			if value ~= nil then
				local ok, v = coerceField(key, value)
				if ok then
					el[key] = v
				else
					badValues += 1
				end
			end
		end
		el.name = r.name
		self.elements[id] = el
	end

	-- 2) Arbre : listes d'enfants (source de vérité), puis parents, puis premier niveau
	local attached = {}
	local repaired = 0
	local function attach(id, parentId, depth)
		local el = self.elements[id]
		if el == nil or attached[id] or depth > 64 then
			return
		end
		attached[id] = true
		el.parent = parentId
		table.insert(self:_siblings(parentId), id)
		local r = raw[id]
		if GuiDoc.PARENT_TYPES[el.type] and type(r.children) == "table" then
			for _, childId in ipairs(r.children) do
				if type(childId) == "string" then
					attach(childId, id, depth + 1)
				end
			end
		end
	end
	if type(data.tops) == "table" then
		for _, id in ipairs(data.tops) do
			if type(id) == "string" then
				attach(id, nil, 0)
			end
		end
	end
	local progress = true
	while progress do
		progress = false
		for _, id in ipairs(ids) do
			if not attached[id] then
				local parentId = raw[id].parent
				local parent = type(parentId) == "string" and self.elements[parentId] or nil
				if parent ~= nil and attached[parentId] and GuiDoc.PARENT_TYPES[parent.type] then
					attach(id, parentId, 1)
					repaired += 1
					progress = true
				end
			end
		end
	end
	for _, id in ipairs(ids) do
		if not attached[id] then
			attach(id, nil, 0)
			repaired += 1
		end
	end

	-- 3) Noms valides et uniques
	local used = {}
	local renamed = 0
	self:_walk(function(el)
		local base = GuiDoc.cleanName(el.name)
		if base == nil then
			base = GuiDoc.TYPE_LABELS[el.type]
			renamed += 1
		end
		local candidate = base
		if used[candidate] then
			renamed += 1
			local n = 2
			repeat
				local suffix = " " .. tostring(n)
				local stem = base
				if (utf8.len(stem) or #stem) + #suffix > GuiDoc.MAX_NAME then
					stem = utf8Prefix(stem, math.max(GuiDoc.MAX_NAME - #suffix, 1))
				end
				candidate = stem .. suffix
				n += 1
			until not used[candidate] or n > 100000
		end
		used[candidate] = true
		el.name = candidate
	end)

	-- 4) Compteur d'ids
	self._counter = 0
	for _, id in ipairs(ids) do
		local n = idNumber(id)
		if n ~= nil and n > self._counter then
			self._counter = n
		end
	end

	-- 5) Avertissements
	if unknown > 0 then
		table.insert(warnings, unknown .. " élément(s) illisible(s) ou de type inconnu ignoré(s).")
	end
	if badValues > 0 then
		table.insert(warnings, badValues .. " valeur(s) invalide(s) remplacée(s) par la valeur par défaut.")
	end
	if repaired > 0 then
		table.insert(warnings, repaired .. " élément(s) mal rangé(s) remis en place.")
	end
	if renamed > 0 then
		table.insert(warnings, renamed .. " nom(s) d'élément vide(s) ou en double renommé(s).")
	end
end

-- Nouveau document à partir de données sérialisées. Renvoie doc ou nil, warnings (textes FR).
function GuiDoc.fromData(data)
	if type(data) ~= "table" then
		return nil, { "Données d'interface invalides." }
	end
	local self = blank()
	local warnings = {}
	if data.format ~= nil and data.format ~= GuiDoc.FORMAT then
		table.insert(warnings, "Format de données inattendu (" .. tostring(data.format) .. ") : chargement tenté quand même.")
	end
	local ok, err = pcall(populate, self, data, warnings)
	if not ok then
		self.Changed:Destroy()
		return nil, { "Données d'interface illisibles : " .. tostring(err) }
	end
	self:_resetHistory()
	return self, warnings
end

---------------------------------------------------------------------------
-- Historique (annuler / rétablir)
---------------------------------------------------------------------------

function GuiDoc:_resetHistory()
	self._history = { self:serialize() }
	self._historyIndex = 1
	self._savedIndex = 1
	self.dirty = false
end

function GuiDoc:_restore(snapshot)
	local ok = pcall(populate, self, snapshot, {})
	if not ok then
		table.clear(self.elements)
		table.clear(self.tops)
	end
end

-- Enregistre l'état actuel dans l'historique (60 au plus), dirty = true, déclenche Changed(raison).
-- Si rien n'a changé, aucun instantané n'est ajouté (Changed est quand même déclenché).
function GuiDoc:commit(reason)
	reason = reason or "modifier"
	local snapshot = self:serialize()
	local current = self._history[self._historyIndex]
	if current ~= nil and deepEqual(current, snapshot) then
		self.Changed:Fire(reason)
		return false
	end
	for i = #self._history, self._historyIndex + 1, -1 do
		self._history[i] = nil
	end
	if self._savedIndex ~= nil and self._savedIndex > self._historyIndex then
		self._savedIndex = nil
	end
	table.insert(self._history, snapshot)
	self._historyIndex = #self._history
	while #self._history > GuiDoc.MAX_HISTORY do
		table.remove(self._history, 1)
		self._historyIndex -= 1
		if self._savedIndex ~= nil then
			self._savedIndex -= 1
			if self._savedIndex < 1 then
				self._savedIndex = nil
			end
		end
	end
	self.dirty = true
	self.Changed:Fire(reason)
	return true
end

function GuiDoc:canUndo()
	return self._historyIndex > 1
end

function GuiDoc:canRedo()
	return self._historyIndex < #self._history
end

function GuiDoc:undo()
	if not self:canUndo() then
		return false
	end
	self._historyIndex -= 1
	self:_restore(self._history[self._historyIndex])
	self.dirty = self._historyIndex ~= self._savedIndex
	self.Changed:Fire("undo")
	return true
end

function GuiDoc:redo()
	if not self:canRedo() then
		return false
	end
	self._historyIndex += 1
	self:_restore(self._history[self._historyIndex])
	self.dirty = self._historyIndex ~= self._savedIndex
	self.Changed:Fire("redo")
	return true
end

-- L'état actuel est celui enregistré (dirty = false, sans Changed)
function GuiDoc:markSaved()
	local current = self:serialize()
	local entry = self._history[self._historyIndex]
	if entry ~= nil and deepEqual(entry, current) then
		self._savedIndex = self._historyIndex
	else
		-- modifications non validées par commit : elles deviennent l'état enregistré
		for i = #self._history, self._historyIndex + 1, -1 do
			self._history[i] = nil
		end
		table.insert(self._history, current)
		self._historyIndex = #self._history
		self._savedIndex = self._historyIndex
	end
	self.dirty = false
end

return GuiDoc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">GuiEditor</string><ProtectedString name="Source"><![CDATA[-- GuiEditor : le Studio d'interface de Blocs FR (SPEC §21.8 et §33, planche Studio.dc.html).
--
-- App fournit trois panneaux (hosts) et le Studio d'interface les remplit :
--   * left    : « Éléments » (8 tuiles : glisser sur l'écran, ou cliquer), « Modèles d'interface »
--               (8 modèles), « Calques » (arbre repliable ; point cyan = les blocs de l'écran
--               utilisent cet élément) ;
--   * preview : l'aperçu (Ordinateur 16:9 | Tablette 4:3 | Téléphone, zoom en %, astuce ; cadre de
--               l'appareil avec l'écran construit par GuiBuild ; sélection, 8 poignées, repères roses,
--               taille « L × H » en px de référence, pastille « ◆ n script(s) ») ; sans écran : carte
--               « Crée ton premier écran » ;
--   * right   : « Propriétés » (de l'écran, d'un élément par sections, ou de plusieurs éléments).
--
-- API (SPEC §21.8) :
--   GuiEditor.new(hosts, deps) -> editor   hosts = { left = Frame, preview = Frame, right = Frame }
--                                          deps = { app, dialogs, host } (+ facultatifs, plus bas)
--   editor:openScreen(screenGui|nil) -> ok, erreurFR  (nil : plus d'écran ouvert ; un descendant
--                                          d'un écran Blocs FR ouvre cet écran)
--   editor:newScreen(nom|nil) -> doc ; editor:insertTemplate(templateId) -> ok, entrée
--   editor:save() -> true, screenGui | false, erreurFR    (GuiStorage.save ; App enregistre ensuite
--                                          le script de l'écran)
--   editor:getDoc() ; editor:isDirty() ; editor:getScreenGui()
--   editor:selectElement(id|nil) ; editor:highlightByName(nom|nil)  (lueur cyan dans l'aperçu ;
--                                          « Écran/Élément » accepté)
--   editor:setDevice("16:9" | "4:3" | "telephone") ; editor:togglePreview() -> bool (aperçu actif)
--   editor:undo() ; editor:redo() ; editor:canUndo() ; editor:canRedo()
--   editor.SelectionChanged (Signal(id|nil)) ; editor.DocChanged (Signal(raison, info))
--   editor:getDebugState() ; editor:destroy()
--
-- DocChanged(raison, info) : raison = celle du commit du document (« ajouter », « deplacer »,
-- « redimensionner », « propriété », « renommer », « supprimer », « coller », « undo », « redo »…),
-- ou un changement d'écran :
--   « nouveau »     nouvel écran vide (App : blocs de l'écran = projet local vide) ;
--   « ouvrir »      info.screenGui ouvert (App : charge GuiStorage.screenScript(info.screenGui)) ;
--   « modele »      écran créé depuis un modèle : info.blocs = blocs du modèle (données Model, mode
--                   local, déjà renommés pour le nom libre de l'écran) ou nil ;
--   « fermer »      plus d'écran ouvert ; « enregistrer » après editor:save() réussi ;
--   « restaurer »   après editor:importState().
-- Ces changements d'écran arrivent aussi quand l'utilisateur clique dans le Studio lui-même (carte de
-- départ, modèles, écrans enregistrés) : le Studio les confie alors à deps.requestScreen, sinon à
-- app:newScreen() / app:insertTemplate(id) / app:openScreen(screenGui) (App propose d'enregistrer
-- l'écran ouvert puis charge les blocs du nouveau), sinon il les fait lui-même après confirmation.
-- Quand le Studio change d'écran (openScreen, newScreen, insertTemplate, même appelés par un autre
-- module), deps.onScreenChanged({ screenGui?, templateId?, reason }) est appelé AVANT DocChanged.
--
-- deps facultatifs (tous vérifiés avant usage) :
--   deps.getModel() ou deps.getInterfaceModel() -> le Model des blocs de l'écran (sinon
--                               app:getInterfaceModel(), puis app.model dans l'onglet « interface ») ;
--   deps.focusBlock(blockId) -> montre un bloc (sinon app:focusBlock, puis app.canvas:focusBlock) ;
--   deps.addClickScript(nom) -> blockId : « Ajouter un script au clic » (sinon app:addClickScript,
--                               sinon le Studio pose lui-même le bloc dans le Model des blocs) ;
--   deps.onScreenChanged(info) : voir plus haut ;
--   deps.dragLayer           -> calque plein écran des glissements (sinon app.dragLayer, puis host.root) ;
--   deps.setStatus(texte, genre) (sinon app:setStatus) ;
--   deps.requestScreen(genre, arg) -> false pour laisser faire : « nouveau », « modele » (id),
--                               « ouvrir » (ScreenGui) demandés depuis le Studio ;
--   deps.saveScreen() -> ok    : « Enregistrer l'écran » (sinon app:saveScreen) pour le bouton
--                               « Enregistrer » de la fenêtre « changements non enregistrés ».
--
-- NOTE: ajouts à la SPEC : editor.PreviewChanged (Signal(bool)), editor:isPreviewing(),
-- editor:getDevice(), editor:getSelection() -> { ids }, editor:addClickScript(id) -> blockId,
-- editor:renameScreen(nom) -> ok, erreurFR, editor:refreshLinks() (à appeler quand App remplace le
-- Model des blocs de l'écran ; le Studio le vérifie aussi seul : changement d'écran, survol d'un bloc,
-- souris dans ses panneaux), editor:exportState() / editor:importState(state) (reconstruction de
-- l'App après les paramètres).
-- NOTE: écarts au board : plusieurs éléments peuvent être sélectionnés (Maj + clic, rectangle sur le
-- fond, menus « Tout sélectionner » / « Sélectionner son contenu ») pour copier, dupliquer, aligner ou
-- supprimer ensemble ; lâcher un élément déplacé sur un cadre / une liste / une grille l'y range
-- (comme un nouvel élément) ; renommer un élément ou l'écran met à jour les blocs de l'écran qui le
-- nomment ; « › » et « ▶ » (absents des polices de Studio) sont remplacés par « → » et « ▼ » tourné.
-- Les raccourcis clavier ne sont pas fiables dans une fenêtre de plugin : seules les flèches (déplacer
-- de 1 px de référence, Maj : 10) sont essayées ; tout le reste passe par les menus du clic droit.

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local GuiDoc = require(script.Parent.GuiDoc)
local GuiBuild = require(script.Parent.GuiBuild)
local GuiStorage = require(script.Parent.GuiStorage)

-- Modules facultatifs : le Studio d'interface marche (en plus simple) s'ils manquent
local optionalCache = {}
local function optional(name)
	local cached = optionalCache[name]
	if cached ~= nil then
		if cached == false then
			return nil
		end
		return cached
	end
	optionalCache[name] = false
	local moduleScript = script.Parent:FindFirstChild(name)
	if moduleScript == nil or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" then
		optionalCache[name] = result
		return result
	end
	warn("[Blocs FR] Studio d'interface : module « " .. name .. " » indisponible : " .. tostring(result))
	return nil
end

local Anim = optional("Anim")
local GuiTemplates = optional("GuiTemplates")
local Registry = optional("Registry")
local Storage = optional("Storage")

local GuiEditor = {}
GuiEditor.__index = GuiEditor

---------------------------------------------------------------------------
-- Constantes
---------------------------------------------------------------------------

-- Couleurs du thème lues à chaque usage (les paramètres peuvent changer le thème)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})
local WHITE = Color3.fromRGB(255, 255, 255)
local LINK_CARD = Color3.fromRGB(16, 48, 59) -- #10303B
local LINK_CARD_HOVER = Color3.fromRGB(21, 64, 78)
local LINK_CARD_STROKE = Color3.fromRGB(21, 94, 117) -- #155E75
local LINK_CARD_TEXT = Color3.fromRGB(165, 243, 252) -- #A5F3FC
local SKY_TOP = Color3.fromRGB(91, 184, 255) -- #5BB8FF
local SKY_LOW = Color3.fromRGB(143, 227, 255) -- #8FE3FF
local GRASS_TOP = Color3.fromRGB(126, 217, 87) -- #7ED957
local GRASS_LOW = Color3.fromRGB(92, 191, 58) -- #5CBF3A
local PLAIN_TOP = Color3.fromRGB(46, 46, 54)
local PLAIN_LOW = Color3.fromRGB(26, 26, 31)

local REF_W, REF_H = GuiDoc.REF_W, GuiDoc.REF_H

-- Appareils de l'aperçu : taille de l'écran en pixels
local DEVICES = {
	["16:9"] = { w = 1280, h = 720, label = "Ordinateur 16:9", short = "16:9" },
	["4:3"] = { w = 1024, h = 768, label = "Tablette 4:3", short = "4:3" },
	telephone = { w = 844, h = 390, label = "Téléphone", short = "Tél." },
}
local DEVICE_ORDER = { "16:9", "4:3", "telephone" }

local SNAP_PX = 6 -- aimantation (pixels de l'aperçu)
local DRAG_THRESHOLD = 3 -- distance avant qu'un appui devienne un glissement
local DOUBLE_CLICK = 0.4
local REBUILD_DELAY = 0.05 -- reconstruction de l'aperçu après un commit
local PANELS_DELAY = 0.03
local LINKS_DELAY = 0.15
local HANDLE_SIZE = 9
local HANDLE_HIT = 7 -- distance (px) au centre d'une poignée pour la saisir
local MIN_SIZE_PX = 6 -- taille minimale pendant un redimensionnement (pixels de l'aperçu)
local TOOLBAR_TOP = 12
local TOOLBAR_H = 28
local DEVICE_PAD = 7
local DOT_STEP = 22
local MAX_DOTS = 900
local MAX_LAYER_ROWS = 400
local MAX_LINK_CARDS = 6
local Z_TRACK = 1000
local CLIPBOARD_KEY = "BlocsFR_PressePapiersInterface"
local CLIPBOARD_FORMAT = "BlocsFR_GUI_Copie"
local HINT_TEXT = "· poignées pour redimensionner · ligne rose = aligné"

-- Poignées : position relative dans le rectangle (0 = gauche / haut, 1 = droite / bas)
local HANDLES = {
	{ id = "nw", ax = 0, ay = 0 },
	{ id = "ne", ax = 1, ay = 0 },
	{ id = "sw", ax = 0, ay = 1 },
	{ id = "se", ax = 1, ay = 1 },
	{ id = "n", ax = 0.5, ay = 0 },
	{ id = "s", ax = 0.5, ay = 1 },
	{ id = "w", ax = 0, ay = 0.5 },
	{ id = "e", ax = 1, ay = 0.5 },
}

local TYPE_SET = {}
for _, t in ipairs(GuiDoc.TYPES) do
	TYPE_SET[t] = true
end

local TEXT_TYPES = { texte = true, bouton = true, barre = true, champ = true }
local RELIEF_TYPES = { bouton = true, cadre = true }
local GRADIENT_TYPES = { cadre = true, bouton = true, barre = true, liste = true, grille = true }
local LAYOUT_TYPES = { liste = true, grille = true }

-- Bloc du wiki qui sert de fiche pour chaque type d'élément
local WIKI_BLOCKS = {
	bouton = "gui_quand_clic",
	texte = "gui_texte",
	barre = "gui_barre",
	champ = "gui_quand_valide",
	image = "gui_image",
	cadre = "gui_montrer",
	liste = "gui_montrer",
	grille = "gui_montrer",
}

local TILE_TIPS = {
	cadre = "Cadre : un panneau ou une fenêtre qui peut contenir d'autres éléments.",
	texte = "Texte : un titre, un score, une phrase…",
	bouton = "Bouton : le joueur clique dessus (bloc « Quand le bouton … est cliqué »).",
	image = "Image : une image Roblox (colle son numéro dans les propriétés).",
	barre = "Barre : une barre de vie, d'expérience ou de chargement.",
	champ = "Champ : une case où le joueur écrit (pseudo, code secret…).",
	liste = "Liste : range ses éléments les uns sous les autres (ou côte à côte).",
	grille = "Grille : range ses éléments en cases (inventaire, boutique).",
}

-- Couleur de départ quand on rallume un fond
local DEFAULT_FOND = { 43, 58, 103 }

local SHIFT_KEYS = {
	[Enum.KeyCode.LeftShift] = "shift",
	[Enum.KeyCode.RightShift] = "shift",
	[Enum.KeyCode.LeftControl] = "ctrl",
	[Enum.KeyCode.RightControl] = "ctrl",
}

local ARROWS = {
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
	[Enum.KeyCode.Up] = Vector2.new(0, -1),
	[Enum.KeyCode.Down] = Vector2.new(0, 1),
}

-- Presse-papiers de secours (quand les réglages du plugin ne sont pas disponibles)
local memoryClipboard = nil
local clipboardCache = { json = nil, data = nil }

-- Métadonnées des modèles (calculées une fois)
local templateMeta = nil
-- Page « Studio d'interface » du wiki (false = introuvable)
local wikiPageCache = nil

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

-- Taille de texte qui suit le réglage « taille de l'interface »
local function ts(n)
	local base = 13
	if type(Theme.TextSize) == "table" and type(Theme.TextSize.UI) == "number" then
		base = Theme.TextSize.UI
	end
	return math.max(8, math.floor(n * base / 13 + 0.5))
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = ts(12),
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

local function makeFrame(props)
	local all = { BackgroundTransparency = 1, BorderSizePixel = 0 }
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("Frame", all)
end

local function makeButton(props)
	local all = { Text = "", AutoButtonColor = false, BorderSizePixel = 0 }
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextButton", all)
end

local function indexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function round(x)
	return math.floor(x + 0.5)
end

-- Nombre à la française : 12, 3,5 (une décimale au plus)
local function fmt(n)
	n = tonumber(n)
	if not isFinite(n) then
		return "0"
	end
	local r = math.floor(n * 10 + 0.5) / 10
	if math.abs(r - round(r)) < 1e-6 then
		return string.format("%d", round(r))
	end
	return (string.gsub(string.format("%.1f", r), "%.", ","))
end

-- "FredokaOne" -> "Fredoka One"
local function prettyFont(name)
	local text = string.gsub(tostring(name or ""), "(%l)(%u)", "%1 %2")
	return text
end

local function isModel(m)
	return type(m) == "table" and type(m.blocks) == "table" and type(m.tops) == "table" and type(m.commit) == "function"
end

-- Animation sûre (Anim absent ou en erreur : état final tout de suite)
local function animTween(inst, props, duration, easing, onDone)
	if Anim ~= nil and type(Anim.tween) == "function" then
		local ok = pcall(Anim.tween, inst, props, duration, easing, onDone)
		if ok then
			return
		end
	end
	for key, value in pairs(props) do
		pcall(function()
			inst[key] = value
		end)
	end
	if type(onDone) == "function" then
		task.spawn(onDone)
	end
end

local function anim(name, ...)
	if Anim ~= nil and type(Anim[name]) == "function" then
		local ok, result = pcall(Anim[name], ...)
		if ok then
			return result
		end
	end
	return nil
end

-- Petite icône d'un type d'élément (cadre de 22 × 16), dessinée avec des cadres (aucune image)
local function drawTypeIcon(parent, elementType)
	local color = C.TextSoft
	local function outline(x, y, w, h, radius)
		local f = makeFrame({ Active = false, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), Parent = parent })
		Util.corner(f, radius)
		Util.stroke(f, color, 2)
		return f
	end
	local function fill(x, y, w, h, radius, c)
		local f = makeFrame({
			Active = false,
			BackgroundTransparency = 0,
			BackgroundColor3 = c or color,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			Parent = parent,
		})
		if radius > 0 then
			Util.corner(f, radius)
		end
		return f
	end
	if elementType == "cadre" then
		outline(3, 2, 16, 12, 3)
	elseif elementType == "texte" then
		makeLabel({
			Text = "T",
			Font = Theme.Fonts.UIBold,
			TextSize = 17,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = parent,
		})
	elseif elementType == "bouton" then
		fill(0, 2, 22, 12, 6, C.Accent)
	elseif elementType == "image" then
		outline(3, 2, 16, 12, 3)
		fill(12, 4, 4, 4, 2)
		fill(6, 10, 10, 2, 1)
	elseif elementType == "barre" then
		outline(1, 4, 20, 8, 4)
		fill(3, 6, 10, 4, 2, C.Success)
	elseif elementType == "champ" then
		outline(1, 2, 20, 12, 3)
		fill(5, 5, 2, 6, 0)
	elseif elementType == "liste" then
		fill(3, 2, 16, 2, 0)
		fill(3, 7, 16, 2, 0)
		fill(3, 12, 16, 2, 0)
	elseif elementType == "grille" then
		fill(2, 0, 8, 7, 2)
		fill(12, 0, 8, 7, 2)
		fill(2, 9, 8, 7, 2)
		fill(12, 9, 8, 7, 2)
	elseif elementType == "ecran" then
		outline(1, 2, 20, 12, 3)
		fill(8, 15, 6, 1, 0)
	end
end

-- Les 8 modèles (id, titre, description, nom d'écran, couleurs de la vignette)
local function templateList()
	if templateMeta ~= nil then
		return templateMeta
	end
	templateMeta = {}
	if GuiTemplates ~= nil and type(GuiTemplates.list) == "function" then
		local ok, list = pcall(GuiTemplates.list)
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.id ~= nil then
					table.insert(templateMeta, {
						id = entry.id,
						title = tostring(entry.title or entry.id),
						description = tostring(entry.description or ""),
						screen = entry.screen,
						thumb = entry.thumb,
					})
				end
			end
		end
	end
	return templateMeta
end

local function thumbGradient(parent, thumb)
	local c1 = Color3.fromRGB(43, 58, 103)
	local c2 = Color3.fromRGB(30, 42, 74)
	if type(thumb) == "table" then
		if type(thumb[1]) == "table" then
			c1 = Util.rgbToColor3(thumb[1])
		end
		if type(thumb[2]) == "table" then
			c2 = Util.rgbToColor3(thumb[2])
		end
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = 90
	g.Parent = parent
	return g
end

-- Texte d'un bloc avec ses vraies valeurs : « Quand le bouton Jouer est cliqué »
local function blockText(model, blockId)
	if not isModel(model) or Registry == nil then
		return "?"
	end
	local block = model.blocks[blockId]
	if block == nil then
		return "?"
	end
	local okDef, def = pcall(Registry.get, block.def)
	if not okDef or type(def) ~= "table" or type(def.label) ~= "string" then
		return tostring(block.def)
	end
	local text = string.gsub(def.label, "%%(%d)", function(n)
		local spec = def.inputs and def.inputs[tonumber(n)]
		if spec == nil then
			return "…"
		end
		local input = block.inputs and block.inputs[spec.name]
		if input == nil then
			return "…"
		end
		if input.block ~= nil then
			return "(…)"
		end
		local value = input.value
		if spec.kind == "dropdown" and type(spec.options) == "table" then
			for _, option in ipairs(spec.options) do
				if option[2] == value then
					return tostring(option[1])
				end
			end
		elseif spec.kind == "color" or spec.kind == "boolean" then
			return "…"
		end
		if value == nil or value == "" then
			return "…"
		end
		if type(value) == "number" then
			return fmt(value)
		end
		return tostring(value)
	end)
	return text
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

local function hostFrame(value, name)
	if typeof(value) == "Instance" and value:IsA("GuiObject") then
		return value, nil
	end
	-- panneau absent : un cadre hors de l'écran pour que rien ne plante
	local dummy = Instance.new("Frame")
	dummy.Name = name
	dummy.Size = UDim2.fromOffset(300, 300)
	return dummy, dummy
end

function GuiEditor.new(hosts, deps)
	local self = setmetatable({}, GuiEditor)
	if type(hosts) ~= "table" then
		hosts = {}
	end
	if type(deps) ~= "table" then
		deps = {}
	end
	self.deps = deps
	self.app = deps.app
	local app = deps.app
	self.dialogs = deps.dialogs
	if self.dialogs == nil and type(app) == "table" then
		self.dialogs = app.dialogs
	end
	self.host = deps.host
	if type(self.host) ~= "table" and type(app) == "table" then
		self.host = app.host
	end
	if type(self.host) ~= "table" then
		self.host = {}
	end

	self._dummies = {}
	local left, d1 = hostFrame(hosts.left, "StudioGaucheAbsent")
	local preview, d2 = hostFrame(hosts.preview, "StudioApercuAbsent")
	local right, d3 = hostFrame(hosts.right, "StudioDroiteAbsent")
	for _, d in ipairs({ d1, d2, d3 }) do
		if d ~= nil then
			table.insert(self._dummies, d)
		end
	end
	self.hosts = { left = left, preview = preview, right = right }

	self.SelectionChanged = Util.Signal.new()
	self.DocChanged = Util.Signal.new()
	self.PreviewChanged = Util.Signal.new()

	self.connections = {}
	self._cleanups = {}
	self._propConns = {}
	self._layerConns = {}
	self._emptyConns = {}
	self._previewConns = {}
	self._propUpdaters = {}
	self._propFlush = {}
	self._layerRows = {}
	self._pending = {}
	self._dots = {}
	self._extraBoxes = {}

	self.doc = nil
	self._docConn = nil
	self._screenGui = nil
	self._savedName = nil
	self._sel = {}
	self._device = "16:9"
	self._previewing = false
	self._decor = true
	self._built = nil
	self._k = 0.5
	self._zoom = 0.5
	self._screen = { x = 0, y = 0, w = 0, h = 0 } -- écran dans l'aperçu (px, relatif à l'aperçu)
	self._collapsed = {}
	self._sections = { elements = true, modeles = true, calques = true }
	self._links = {}
	self._linkedModel = nil
	self._linkedConn = nil
	self._tracking = nil
	self._hoverId = nil
	self._highlightName = nil
	self._glowStop = nil
	self._keys = {}
	self._lastClick = nil
	self._lastLayerClick = nil
	self._pasteCount = 0
	self._pasteSource = nil
	self._propsKey = nil
	self._popAfterBuild = nil
	self._staggerAfterBuild = false
	self._rebuildAfterTracking = false
	self._lastMouse = Vector2.new(0, 0)
	self._lastPrimary = nil
	self._destroyed = false

	self:_buildLeft()
	self:_buildPreview()
	self:_buildRight()
	self:_refreshAll()
	return self
end

-- Connexion gardée jusqu'à destroy (bucket = liste à vider plus tôt, facultatif)
function GuiEditor:_conn(signal, fn, bucket)
	local connection = signal:Connect(fn)
	table.insert(bucket or self.connections, connection)
	return connection
end

local function disconnectAll(list)
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(list)
end

function GuiEditor:_mouse()
	local host = self.host
	if type(host) == "table" and type(host.getMousePosition) == "function" then
		local ok, p = pcall(host.getMousePosition)
		if ok and typeof(p) == "Vector2" then
			self._lastMouse = p
			return p
		end
	end
	return self._lastMouse
end

function GuiEditor:_toast(text, kind, duration)
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.toast) == "function" then
		pcall(dialogs.toast, dialogs, text, kind, duration)
	end
end

function GuiEditor:_status(text, kind)
	local fn = self.deps.setStatus
	if type(fn) == "function" then
		pcall(fn, text, kind)
		return
	end
	local app = self.app
	if type(app) == "table" and type(app.setStatus) == "function" then
		pcall(app.setStatus, app, text, kind)
	end
end

function GuiEditor:_tooltip(text)
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.tooltip) == "function" then
		pcall(dialogs.tooltip, dialogs, text, self:_mouse())
	end
end

function GuiEditor:_hideTooltip()
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.hideTooltip) == "function" then
		pcall(dialogs.hideTooltip, dialogs)
	end
end

function GuiEditor:_menu(items, onChoose, position)
	local dialogs = self.dialogs
	if type(dialogs) ~= "table" or type(dialogs.menu) ~= "function" then
		return
	end
	self:_hideTooltip()
	pcall(dialogs.menu, dialogs, position or self:_mouse(), items, function(value, item)
		if self._destroyed then
			return
		end
		local ok, err = pcall(onChoose, value, item)
		if not ok then
			warn("[Blocs FR] Studio d'interface : " .. tostring(err))
		end
	end)
end

function GuiEditor:_getSetting(key)
	local fn = self.host.getSetting
	if type(fn) == "function" then
		local ok, value = pcall(fn, key)
		if ok then
			return value
		end
	end
	return nil
end

function GuiEditor:_setSetting(key, value)
	local fn = self.host.setSetting
	if type(fn) == "function" then
		pcall(fn, key, value)
	end
end

-- Calque plein écran des glissements
function GuiEditor:_dragLayer()
	local layer = self.deps.dragLayer
	if typeof(layer) ~= "Instance" and type(self.app) == "table" then
		layer = self.app.dragLayer
	end
	if typeof(layer) ~= "Instance" then
		layer = self.host.root
	end
	if typeof(layer) ~= "Instance" then
		layer = self.previewRoot
	end
	return layer
end

-- Plusieurs appels rapprochés ne font qu'une seule exécution
function GuiEditor:_schedule(key, delay, fn)
	if self._pending[key] then
		return
	end
	self._pending[key] = true
	task.delay(delay, function()
		self._pending[key] = nil
		if self._destroyed then
			return
		end
		local ok, err = pcall(fn)
		if not ok then
			warn("[Blocs FR] Studio d'interface : " .. tostring(err))
		end
	end)
end

-- Touches Maj / Ctrl : suivies sur les panneaux (une fenêtre de plugin ne voit pas toujours le clavier).
-- modifiersOnly : sans les flèches (qui déplacent la sélection)
function GuiEditor:_watchKeys(gui, modifiersOnly)
	self:_conn(gui.InputBegan, function(input)
		local key = SHIFT_KEYS[input.KeyCode]
		if key ~= nil then
			self._keys[key] = true
		end
		if not modifiersOnly then
			self:_onKey(input)
		end
	end)
	self:_conn(gui.InputEnded, function(input)
		local key = SHIFT_KEYS[input.KeyCode]
		if key ~= nil then
			self._keys[key] = nil
		end
	end)
end

function GuiEditor:_modifier(name)
	if self._keys[name] then
		return true
	end
	local codes = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift }
	if name == "ctrl" then
		codes = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl }
	end
	for _, code in ipairs(codes) do
		local ok, down = pcall(function()
			return UserInputService:IsKeyDown(code)
		end)
		if ok and down then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Panneau de gauche : éléments, modèles, calques
---------------------------------------------------------------------------

function GuiEditor:_sectionHeader(parent, order, title, key)
	local header = makeButton({
		Name = "Titre_" .. key,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = order,
		Parent = parent,
	})
	makeLabel({
		Text = title,
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		Size = UDim2.new(1, -18, 1, 0),
		Parent = header,
	})
	local arrow = makeLabel({
		Name = "Fleche",
		Text = "▼",
		TextSize = ts(9),
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		Parent = header,
	})
	self:_conn(header.MouseButton1Click, function()
		self:_setSectionOpen(key, not self._sections[key])
	end)
	return header, arrow
end

function GuiEditor:_setSectionOpen(key, open)
	self._sections[key] = open == true
	local content, arrow = nil, nil
	if key == "elements" then
		content, arrow = self.tilesFrame, self.elementsArrow
	elseif key == "modeles" then
		content, arrow = self.templatesFrame, self.modelesArrow
	elseif key == "calques" then
		content, arrow = self.layersFrame, self.calquesArrow
	end
	if content ~= nil then
		content.Visible = open == true
	end
	if arrow ~= nil then
		local rotation = -90
		if open then
			rotation = 0
		end
		animTween(arrow, { Rotation = rotation }, 0.12, "quadOut")
	end
	if key == "calques" and self.layersNote ~= nil then
		self.layersNote.Visible = open == true
	end
end

function GuiEditor:_buildLeft()
	local scroll = Util.create("ScrollingFrame", {
		Name = "StudioGauche",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = self.hosts.left,
	})
	self.leftRoot = scroll
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 14),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		Parent = scroll,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = scroll,
	})

	-- Éléments : 4 × 2 tuiles
	local _, elementsArrow = self:_sectionHeader(scroll, 1, "ÉLÉMENTS", "elements")
	self.elementsArrow = elementsArrow
	local grid = makeFrame({ Name = "Tuiles", Size = UDim2.new(1, 0, 0, 130), LayoutOrder = 2, Parent = scroll })
	Util.create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -5, 0, 62),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	self.tilesFrame = grid
	for i, elementType in ipairs(GuiDoc.TYPES) do
		self:_buildTile(grid, elementType, i)
	end

	-- Modèles d'interface
	local _, modelesArrow = self:_sectionHeader(scroll, 3, "MODÈLES D'INTERFACE", "modeles")
	self.modelesArrow = modelesArrow
	local list = makeFrame({
		Name = "Modeles",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 4,
		Parent = scroll,
	})
	Util.create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	self.templatesFrame = list
	self:_buildTemplateRows(list)

	-- Calques
	local _, calquesArrow = self:_sectionHeader(scroll, 5, "CALQUES", "calques")
	self.calquesArrow = calquesArrow
	local layers = makeFrame({
		Name = "Calques",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 6,
		Parent = scroll,
	})
	Util.create("UIListLayout", { Padding = UDim.new(0, 1), SortOrder = Enum.SortOrder.LayoutOrder, Parent = layers })
	self.layersFrame = layers
	self.layersNote = makeLabel({
		Name = "Legende",
		Text = "Point bleu : l'élément a des blocs. Double-clic : renommer. Clic droit : plus d'options.",
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 7,
		Parent = scroll,
	})

	self:_conn(scroll.MouseEnter, function()
		self:_syncModel()
	end)
	-- Maj / Ctrl + clic dans les calques : ajouter / retirer de la sélection
	self:_watchKeys(scroll, true)
	self:_conn(scroll.MouseLeave, function()
		table.clear(self._keys)
	end)
end

function GuiEditor:_buildTile(parent, elementType, order)
	local tile = makeButton({
		Name = "Tuile_" .. elementType,
		BackgroundColor3 = C.Button,
		LayoutOrder = order,
		Parent = parent,
	})
	Util.corner(tile, 9)
	local icon = makeFrame({
		Name = "Icone",
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 13),
		Size = UDim2.fromOffset(22, 16),
		Parent = tile,
	})
	drawTypeIcon(icon, elementType)
	-- (colonne étroite : le nom rétrécit au lieu de déborder sur la tuile voisine)
	local tileLabel = makeLabel({
		Text = GuiDoc.TYPE_LABELS[elementType] or elementType,
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextScaled = true,
		TextColor3 = C.TextSoft,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 2, 0, 36),
		Size = UDim2.new(1, -4, 0, 16),
		Parent = tile,
	})
	Util.create("UITextSizeConstraint", { MaxTextSize = ts(11), MinTextSize = 7, Parent = tileLabel })
	local disconnectHover = anim("hover", tile, C.Button, C.ButtonHover)
	if type(disconnectHover) == "function" then
		table.insert(self._cleanups, disconnectHover)
	end
	self:_conn(tile.MouseEnter, function()
		if self._tracking == nil then
			self:_tooltip((TILE_TIPS[elementType] or "") .. "\nGlisse-le sur l'écran, ou clique pour l'ajouter au milieu.")
		end
	end)
	self:_conn(tile.MouseLeave, function()
		self:_hideTooltip()
	end)
	self:_conn(tile.MouseButton1Down, function()
		self:_hideTooltip()
		self:_beginTileDrag(elementType)
	end)
	self:_conn(tile.MouseButton2Click, function()
		self:_tileMenu(elementType)
	end)
end

function GuiEditor:_buildTemplateRows(list)
	local entries = templateList()
	if #entries == 0 then
		makeLabel({
			Text = "Les modèles ne sont pas disponibles.",
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 20),
			Parent = list,
		})
		return
	end
	for i, entry in ipairs(entries) do
		local row = makeButton({
			Name = "Modele_" .. tostring(entry.id),
			BackgroundColor3 = C.Button,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 38),
			LayoutOrder = i,
			Parent = list,
		})
		Util.corner(row, 8)
		local thumb = makeFrame({
			Name = "Vignette",
			Active = false,
			BackgroundTransparency = 0,
			BackgroundColor3 = WHITE,
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(44, 26),
			Parent = row,
		})
		Util.corner(thumb, 5)
		Util.stroke(thumb, WHITE, 1, 0.85)
		thumbGradient(thumb, entry.thumb)
		makeLabel({
			Text = entry.title,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(12),
			TextColor3 = C.TextSoft,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(62, 0),
			Size = UDim2.new(1, -66, 1, 0),
			Parent = row,
		})
		self:_conn(row.MouseEnter, function()
			animTween(row, { BackgroundTransparency = 0 }, 0.12, "quadOut")
			if entry.description ~= "" then
				self:_tooltip(entry.description)
			end
		end)
		self:_conn(row.MouseLeave, function()
			animTween(row, { BackgroundTransparency = 1 }, 0.12, "quadOut")
			self:_hideTooltip()
		end)
		self:_conn(row.MouseButton1Click, function()
			self:_hideTooltip()
			self:_onTemplateClick(entry)
		end)
		self:_conn(row.MouseButton2Click, function()
			self:_templateMenu(entry)
		end)
	end
end

---------------------------------------------------------------------------
-- Aperçu : appareil, écran, calque de sélection, barre, carte de départ
---------------------------------------------------------------------------

function GuiEditor:_buildPreview()
	local root = makeFrame({
		Name = "StudioApercu",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Background,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Parent = self.hosts.preview,
	})
	self.previewRoot = root
	self.dotsFrame = makeFrame({ Name = "Points", Active = false, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = root })

	-- Cadre de l'appareil et écran
	local device = makeFrame({
		Name = "Appareil",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.DeviceFrame,
		Visible = false,
		ZIndex = 2,
		Parent = root,
	})
	Util.corner(device, 13)
	Util.stroke(device, C.PopupBorder, 1)
	self.deviceFrame = device
	local screen = makeFrame({
		Name = "Ecran",
		Active = false,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(DEVICE_PAD, DEVICE_PAD),
		Size = UDim2.new(1, -2 * DEVICE_PAD, 1, -2 * DEVICE_PAD),
		Parent = device,
	})
	self.screenFrame = screen
	local decor = makeFrame({
		Name = "Decor",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = screen,
	})
	Util.corner(decor, 8)
	self.decorGradient = Instance.new("UIGradient")
	self.decorGradient.Rotation = 90
	self.decorGradient.Parent = decor
	self.decorClouds = {}
	for _, spec in ipairs({ { 0.09, 0.18, 0.19, 0.095 }, { 0.72, 0.13, 0.14, 0.07 } }) do
		local cloud = makeFrame({
			Name = "Nuage",
			Active = false,
			BackgroundTransparency = 0.3,
			BackgroundColor3 = WHITE,
			Position = UDim2.fromScale(spec[1], spec[2]),
			Size = UDim2.fromScale(spec[3], spec[4]),
			ZIndex = 2,
			Parent = decor,
		})
		Util.corner(cloud, 40)
		table.insert(self.decorClouds, cloud)
	end
	self.decorFrame = decor
	self.buildHost = makeFrame({ Name = "Construit", Active = false, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = screen })
	self:_applyDecor()

	-- Zone qui reçoit la souris (au-dessus de l'écran construit, qui n'est pas interactif)
	local catcher = makeButton({
		Name = "Capteur",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = root,
	})
	self.catcher = catcher

	-- Calque : sélection, poignées, repères, taille, pastille, survol, lueur, cible, rectangle
	local overlay = makeFrame({ Name = "Calque", Active = false, Size = UDim2.fromOffset(0, 0), ZIndex = 4, Parent = root })
	self.overlay = overlay
	self:_buildOverlay(overlay)

	self:_buildPreviewBar(root)
	self:_buildEmptyState(root)
	self:_buildBanner(root)

	self:_conn(catcher.MouseButton1Down, function()
		self:_onPreviewDown()
	end)
	self:_conn(catcher.MouseButton2Click, function()
		self:_onPreviewContext()
	end)
	self:_conn(catcher.MouseMoved, function()
		self:_onPreviewHover()
	end)
	self:_conn(catcher.MouseLeave, function()
		self:_setHover(nil)
		table.clear(self._keys)
	end)
	self:_conn(catcher.MouseEnter, function()
		self:_syncModel()
	end)
	self:_watchKeys(catcher)
	self:_conn(root:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_layoutPreview()
	end)
end

-- Décor derrière l'écran : un petit paysage de jeu (ciel et herbe), ou un fond neutre
function GuiEditor:_applyDecor()
	if self.decorGradient == nil then
		return
	end
	if self._decor then
		self.decorGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, SKY_TOP),
			ColorSequenceKeypoint.new(0.62, SKY_LOW),
			ColorSequenceKeypoint.new(0.6205, GRASS_TOP),
			ColorSequenceKeypoint.new(1, GRASS_LOW),
		})
	else
		self.decorGradient.Color = ColorSequence.new(PLAIN_TOP, PLAIN_LOW)
	end
	for _, cloud in ipairs(self.decorClouds or {}) do
		cloud.Visible = self._decor
	end
end

function GuiEditor:_buildOverlay(overlay)
	-- survol
	self.hoverBox = makeFrame({ Name = "Survol", Active = false, Visible = false, ZIndex = 1, Parent = overlay })
	Util.stroke(self.hoverBox, C.Accent, 1, 0.35)

	-- sélection principale (cadre bleu, halo cyan, poignées, taille, pastille)
	local sel = makeFrame({ Name = "Selection", Active = false, Visible = false, ZIndex = 3, Parent = overlay })
	Util.stroke(sel, C.Accent, 2)
	local halo = makeFrame({
		Name = "Halo",
		Active = false,
		Position = UDim2.fromOffset(-3, -3),
		Size = UDim2.new(1, 6, 1, 6),
		ZIndex = 1,
		Parent = sel,
	})
	Util.corner(halo, 6)
	Util.stroke(halo, C.LinkHighlight, 3, 0.65)
	self.selFrame = sel
	self.handles = {}
	for _, h in ipairs(HANDLES) do
		local handle = makeFrame({
			Name = "Poignee_" .. h.id,
			Active = false,
			BackgroundTransparency = 0,
			BackgroundColor3 = WHITE,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(h.ax, h.ay),
			Size = UDim2.fromOffset(HANDLE_SIZE, HANDLE_SIZE),
			ZIndex = 3,
			Parent = sel,
		})
		Util.corner(handle, 2)
		Util.stroke(handle, C.Accent, 2)
		self.handles[h.id] = handle
	end
	local sizePill = makeFrame({
		Name = "Taille",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Accent,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 8),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		ZIndex = 4,
		Parent = sel,
	})
	Util.corner(sizePill, 5)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7), Parent = sizePill })
	self.sizeLabel = makeLabel({
		Text = "",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(10),
		TextColor3 = WHITE,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 5,
		Parent = sizePill,
	})
	self.sizePill = sizePill
	local badge = makeButton({
		Name = "Scripts",
		BackgroundColor3 = C.LinkBadge,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 10, 0.5, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextColor3 = WHITE,
		Visible = false,
		ZIndex = 5,
		Parent = sel,
	})
	Util.corner(badge, 11)
	Util.stroke(badge, C.DeviceFrame, 2)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9), Parent = badge })
	self.badge = badge
	self:_conn(badge.MouseButton1Click, function()
		local id = self:_primary()
		local el = id and self.doc and self.doc:get(id)
		if el ~= nil then
			local entries = self:_linksOf(el.name)
			if entries[1] ~= nil then
				self:_focusBlock(entries[1].rootId)
			end
		end
	end)
	self:_conn(badge.MouseEnter, function()
		self:_tooltip("Clique pour voir ses blocs dans « Blocs de l'écran ».")
	end)
	self:_conn(badge.MouseLeave, function()
		self:_hideTooltip()
	end)

	-- repères roses (aimantation)
	self.guideV = makeFrame({
		Name = "RepereV",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Guide,
		Size = UDim2.new(0, 1, 1, 0),
		Visible = false,
		ZIndex = 6,
		Parent = overlay,
	})
	self.guideH = makeFrame({
		Name = "RepereH",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Guide,
		Size = UDim2.new(1, 0, 0, 1),
		Visible = false,
		ZIndex = 6,
		Parent = overlay,
	})

	-- conteneur visé (glisser un élément dedans)
	local drop = makeFrame({
		Name = "Cible",
		Active = false,
		BackgroundTransparency = 0.88,
		BackgroundColor3 = C.LinkHighlight,
		Visible = false,
		ZIndex = 7,
		Parent = overlay,
	})
	Util.corner(drop, 4)
	Util.stroke(drop, C.LinkHighlight, 2)
	local dropPill = makeFrame({
		Name = "Etiquette",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.LinkBadge,
		Position = UDim2.fromOffset(4, 4),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		ZIndex = 8,
		Parent = drop,
	})
	Util.corner(dropPill, 5)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = dropPill })
	self.dropLabel = makeLabel({
		Font = Theme.Fonts.UIBold,
		TextSize = ts(10),
		TextColor3 = WHITE,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 9,
		Parent = dropPill,
	})
	self.dropBox = drop

	-- lueur cyan (bloc survolé dans « Blocs de l'écran »)
	local glow = makeFrame({ Name = "Lueur", Active = false, Visible = false, ZIndex = 9, Parent = overlay })
	Util.corner(glow, 4)
	Util.stroke(glow, C.LinkHighlight, 3)
	local glowHalo = makeFrame({
		Name = "Halo",
		Active = false,
		Position = UDim2.fromOffset(-4, -4),
		Size = UDim2.new(1, 8, 1, 8),
		Parent = glow,
	})
	Util.corner(glowHalo, 8)
	self.glowStroke = Util.stroke(glowHalo, C.LinkHighlight, 4, 0.55)
	self.glow = glow

	-- rectangle de sélection
	local band = makeFrame({
		Name = "Rectangle",
		Active = false,
		BackgroundTransparency = 0.85,
		BackgroundColor3 = C.Accent,
		Visible = false,
		ZIndex = 10,
		Parent = overlay,
	})
	Util.stroke(band, C.Accent, 1)
	self.band = band

	-- fantôme d'un nouvel élément (tuile glissée)
	local ghost = makeFrame({
		Name = "Fantome",
		Active = false,
		BackgroundTransparency = 0.7,
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 11,
		Parent = overlay,
	})
	Util.corner(ghost, 6)
	Util.stroke(ghost, WHITE, 2, 0.1)
	self.ghostLabel = makeLabel({
		Font = Theme.Fonts.UIBold,
		TextSize = ts(12),
		TextColor3 = C.TextDark,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 12,
		Parent = ghost,
	})
	self.ghost = ghost
end

function GuiEditor:_buildPreviewBar(root)
	local bar = makeFrame({
		Name = "Barre",
		Position = UDim2.fromOffset(0, TOOLBAR_TOP),
		Size = UDim2.new(1, 0, 0, TOOLBAR_H),
		ZIndex = 5,
		Parent = root,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	local seg = makeFrame({
		Name = "Appareils",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Panel,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, TOOLBAR_H),
		LayoutOrder = 1,
		ZIndex = 5,
		Parent = bar,
	})
	Util.corner(seg, 9)
	Util.stroke(seg, C.PanelBorder, 1)
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, 3),
		PaddingBottom = UDim.new(0, 3),
		PaddingLeft = UDim.new(0, 3),
		PaddingRight = UDim.new(0, 3),
		Parent = seg,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = seg,
	})
	self.deviceButtons = {}
	for i, key in ipairs(DEVICE_ORDER) do
		local b = makeButton({
			Name = "Appareil_" .. key,
			Text = DEVICES[key].label,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			BackgroundColor3 = C.ButtonActive,
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, TOOLBAR_H - 6),
			LayoutOrder = i,
			ZIndex = 6,
			Parent = seg,
		})
		Util.corner(b, 6)
		Util.create("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11), Parent = b })
		self.deviceButtons[key] = b
		self:_conn(b.MouseButton1Click, function()
			self:setDevice(key)
		end)
	end
	self.zoomLabel = makeLabel({
		Name = "Zoom",
		Text = "100 %",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 2,
		ZIndex = 5,
		Parent = bar,
	})
	self.hintLabel = makeLabel({
		Name = "Astuce",
		Text = HINT_TEXT,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 3,
		ZIndex = 5,
		Parent = bar,
	})
	self.previewBar = bar
end

-- Bandeau en bas pendant l'aperçu interactif
function GuiEditor:_buildBanner(root)
	local banner = makeFrame({
		Name = "BandeauApercu",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Popup,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		Visible = false,
		ZIndex = 8,
		Parent = root,
	})
	Util.corner(banner, 10)
	Util.stroke(banner, C.PopupBorder, 1)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 5), Parent = banner })
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = banner,
	})
	makeLabel({
		Text = "●",
		TextSize = ts(11),
		TextColor3 = C.SuccessText,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 1,
		ZIndex = 9,
		Parent = banner,
	})
	self.bannerText = makeLabel({
		Text = "Aperçu : essaie les boutons. Les scripts ne tournent pas ici (teste le jeu pour les voir).",
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 2,
		ZIndex = 9,
		Parent = banner,
	})
	local quit = makeButton({
		Name = "Quitter",
		Text = "Quitter l'aperçu",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(12),
		TextColor3 = C.Text,
		BackgroundColor3 = C.Button,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 28),
		LayoutOrder = 3,
		ZIndex = 9,
		Parent = banner,
	})
	Util.corner(quit, 7)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = quit })
	local disconnectHover = anim("hover", quit, C.Button, C.ButtonHover)
	if type(disconnectHover) == "function" then
		table.insert(self._cleanups, disconnectHover)
	end
	self:_conn(quit.MouseButton1Click, function()
		self:_setPreviewing(false)
	end)
	self.banner = banner
end

-- Carte « Crée ton premier écran » (aucun écran ouvert)
function GuiEditor:_buildEmptyState(root)
	local holder = Util.create("ScrollingFrame", {
		Name = "Vide",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ButtonActive,
		Visible = false,
		ZIndex = 7,
		Parent = root,
	})
	self.emptyHolder = holder
	local card = makeFrame({
		Name = "Carte",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Panel,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromOffset(520, 0),
		ZIndex = 7,
		Parent = holder,
	})
	Util.corner(card, 14)
	Util.stroke(card, C.PanelBorder, 1)
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, 20),
		PaddingBottom = UDim.new(0, 20),
		PaddingLeft = UDim.new(0, 20),
		PaddingRight = UDim.new(0, 20),
		Parent = card,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = card,
	})
	self.emptyCard = card
	makeLabel({
		Text = "Crée ton premier écran",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(18),
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 1,
		ZIndex = 8,
		Parent = card,
	})
	makeLabel({
		Text = "Un écran, c'est un menu, un HUD, une boutique… Pars d'un écran vide ou d'un modèle tout prêt, puis ajoute des blocs dessous pour le faire marcher.",
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = 2,
		ZIndex = 8,
		Parent = card,
	})
	local newButton = makeButton({
		Name = "NouvelEcran",
		Text = "＋  Nouvel écran vide",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(13),
		TextColor3 = WHITE,
		BackgroundColor3 = C.Accent,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		LayoutOrder = 3,
		ZIndex = 8,
		Parent = card,
	})
	Util.corner(newButton, 9)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = newButton })
	local disconnectHover = anim("hover", newButton, C.Accent, C.AccentHover)
	if type(disconnectHover) == "function" then
		table.insert(self._cleanups, disconnectHover)
	end
	self:_conn(newButton.MouseButton1Click, function()
		self:_request("nouveau", nil)
	end)

	makeLabel({
		Text = "MODÈLES",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 4,
		ZIndex = 8,
		Parent = card,
	})
	local grid = makeFrame({
		Name = "Modeles",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 5,
		ZIndex = 8,
		Parent = card,
	})
	self.emptyGridLayout = Util.create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -6, 0, 76),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for i, entry in ipairs(templateList()) do
		local cell = makeButton({
			Name = "Modele_" .. tostring(entry.id),
			BackgroundColor3 = C.Button,
			LayoutOrder = i,
			ZIndex = 8,
			Parent = grid,
		})
		Util.corner(cell, 10)
		local thumb = makeFrame({
			Name = "Vignette",
			Active = false,
			BackgroundTransparency = 0,
			BackgroundColor3 = WHITE,
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 40),
			ZIndex = 9,
			Parent = cell,
		})
		Util.corner(thumb, 7)
		Util.stroke(thumb, WHITE, 1, 0.85)
		thumbGradient(thumb, entry.thumb)
		makeLabel({
			Text = entry.title,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(11),
			TextColor3 = C.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, 4, 0, 50),
			Size = UDim2.new(1, -8, 0, 20),
			ZIndex = 9,
			Parent = cell,
		})
		local hover = anim("hover", cell, C.Button, C.ButtonHover)
		if type(hover) == "function" then
			table.insert(self._cleanups, hover)
		end
		self:_conn(cell.MouseEnter, function()
			if entry.description ~= "" then
				self:_tooltip(entry.description)
			end
		end)
		self:_conn(cell.MouseLeave, function()
			self:_hideTooltip()
		end)
		self:_conn(cell.MouseButton1Click, function()
			self:_hideTooltip()
			self:_request("modele", entry.id)
		end)
	end

	-- écrans déjà enregistrés (remplis à chaque affichage)
	self.emptySavedTitle = makeLabel({
		Text = "OU OUVRE UN ÉCRAN ENREGISTRÉ",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 6,
		Visible = false,
		ZIndex = 8,
		Parent = card,
	})
	local saved = makeFrame({
		Name = "Enregistres",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 7,
		Visible = false,
		ZIndex = 8,
		Parent = card,
	})
	Util.create("UIGridLayout", {
		CellSize = UDim2.new(0.333, -6, 0, 30),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = saved,
	})
	self.emptySaved = saved
	self:_conn(card:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_layoutEmpty()
	end)
end

---------------------------------------------------------------------------
-- Panneau de droite : propriétés
---------------------------------------------------------------------------

function GuiEditor:_buildRight()
	local root = makeFrame({
		Name = "StudioProprietes",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Panel,
		Size = UDim2.fromScale(1, 1),
		Parent = self.hosts.right,
	})
	self.rightRoot = root
	local head = makeFrame({ Name = "Entete", Size = UDim2.new(1, 0, 0, 62), Parent = root })
	makeLabel({
		Text = "PROPRIÉTÉS",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 14),
		Parent = head,
	})
	self.propsIcon = makeFrame({
		Name = "Icone",
		Active = false,
		Position = UDim2.fromOffset(16, 34),
		Size = UDim2.fromOffset(22, 16),
		Parent = head,
	})
	self.propsTitle = makeLabel({
		Text = "",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(15),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(46, 31),
		Size = UDim2.new(1, -62, 0, 22),
		Parent = head,
	})
	makeFrame({
		Name = "Bordure",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.PanelBorder,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = head,
	})
	local scroll = Util.create("ScrollingFrame", {
		Name = "Liste",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ButtonActive,
		Parent = root,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 0),
		Parent = scroll,
	})
	self.propsScroll = scroll
	self:_conn(root.MouseEnter, function()
		self:_syncModel()
	end)
	-- fenêtre étroite (App réduit la colonne jusqu'à 220 px) : libellés plus courts, panneau refait
	local startWidth = root.AbsoluteSize.X
	self._propsNarrow = startWidth > 0 and startWidth < 270
	self:_conn(root:GetPropertyChangedSignal("AbsoluteSize"), function()
		local width = root.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local narrow = width < 270
		if narrow ~= self._propsNarrow then
			self._propsNarrow = narrow
			self:_schedule("propsWidth", PANELS_DELAY, function()
				self:_refreshProps(true)
			end)
		end
	end)
end

---------------------------------------------------------------------------
-- Mise en page de l'aperçu (jamais de reconstruction ici : applyScale suffit)
---------------------------------------------------------------------------

function GuiEditor:_layoutPreview()
	if self._destroyed then
		return
	end
	local size = self.previewRoot.AbsoluteSize
	local W, H = size.X, size.Y
	local hasDoc = self.doc ~= nil
	self:_layoutBar(W)
	self:_updateDots(W, H)
	self.emptyHolder.Visible = not hasDoc
	self.previewBar.Visible = hasDoc
	if not hasDoc then
		self.deviceFrame.Visible = false
		self.overlay.Visible = false
		self._screen = { x = 0, y = 0, w = 0, h = 0 }
		self:_layoutEmpty()
		return
	end
	local dev = DEVICES[self._device] or DEVICES["16:9"]
	local top = TOOLBAR_TOP + TOOLBAR_H + 10
	local bottom = 14
	if self._previewing then
		bottom = 60 -- place du bandeau
	end
	local availW = W - 32
	local availH = H - top - bottom
	if availW < 40 or availH < 30 then
		self.deviceFrame.Visible = false
		self.overlay.Visible = false
		self._screen = { x = 0, y = 0, w = 0, h = 0 }
		return
	end
	local z = math.min((availW - 2 * DEVICE_PAD) / dev.w, (availH - 2 * DEVICE_PAD) / dev.h)
	z = math.max(z, 0.01)
	local sw = math.max(1, round(dev.w * z))
	local sh = math.max(1, round(dev.h * z))
	local fw, fh = sw + 2 * DEVICE_PAD, sh + 2 * DEVICE_PAD
	local fx = math.floor((W - fw) / 2)
	local fy = top + math.max(0, math.floor((availH - fh) / 2))
	self.deviceFrame.Position = UDim2.fromOffset(fx, fy)
	self.deviceFrame.Size = UDim2.fromOffset(fw, fh)
	self.deviceFrame.Visible = true
	self._screen = { x = fx + DEVICE_PAD, y = fy + DEVICE_PAD, w = sw, h = sh }
	self.overlay.Position = UDim2.fromOffset(self._screen.x, self._screen.y)
	self.overlay.Size = UDim2.fromOffset(sw, sh)
	self.overlay.Visible = not self._previewing
	self._zoom = sw / dev.w
	self.zoomLabel.Text = tostring(round(self._zoom * 100)) .. " %"
	-- k = hauteur affichée / 720 (comme dans le jeu : hauteur de l'écran / 720)
	local k = sh / REF_H
	if math.abs(k - self._k) > 1e-4 then
		self._k = k
		local built = self._built
		if built ~= nil and typeof(built.racine) == "Instance" then
			pcall(GuiBuild.applyScale, built.racine, k)
		end
	end
	self:_updateOverlay()
end

-- Libellés courts quand l'aperçu est étroit ; astuce cachée faute de place
function GuiEditor:_layoutBar(W)
	local short = W < 440
	for key, b in pairs(self.deviceButtons) do
		local dev = DEVICES[key]
		local text = dev.label
		if short then
			text = dev.short
		end
		if b.Text ~= text then
			b.Text = text
		end
		local on = key == self._device
		b.BackgroundTransparency = on and 0 or 1
		b.TextColor3 = on and C.Text or C.TextDim
		b.Font = on and Theme.Fonts.UIBold or Theme.Fonts.UI
	end
	self.zoomLabel.Visible = W >= 300
	self.hintLabel.Visible = W >= 700 and not self._previewing
end

-- Grille de points du fond (cadres réutilisés)
function GuiEditor:_updateDots(W, H)
	if W <= 0 or H <= 0 then
		return
	end
	local step = DOT_STEP
	local cols = math.ceil(W / step)
	local rows = math.ceil(H / step)
	while cols * rows > MAX_DOTS do
		step += 6
		cols = math.ceil(W / step)
		rows = math.ceil(H / step)
	end
	local key = cols .. "x" .. rows .. "@" .. step
	if key == self._dotsKey then
		return
	end
	self._dotsKey = key
	local n = 0
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			n += 1
			local dot = self._dots[n]
			if dot == nil then
				dot = makeFrame({
					Name = "Point",
					Active = false,
					BackgroundTransparency = 0,
					BackgroundColor3 = C.GridDot,
					Size = UDim2.fromOffset(2, 2),
					Parent = self.dotsFrame,
				})
				self._dots[n] = dot
			end
			dot.Position = UDim2.fromOffset(c * step + math.floor(step / 2) - 1, r * step + math.floor(step / 2) - 1)
			dot.Visible = true
		end
	end
	for i = n + 1, #self._dots do
		self._dots[i].Visible = false
	end
end

-- Carte de départ : centrée, 4 modèles par ligne (2 quand c'est étroit)
function GuiEditor:_layoutEmpty()
	if self._destroyed or self.emptyCard == nil or self.emptyGridLayout == nil then
		return
	end
	local size = self.previewRoot.AbsoluteSize
	local W, H = size.X, size.Y
	if W <= 0 then
		return
	end
	local cardW = math.max(220, math.min(560, W - 32))
	if self.emptyCard.Size.X.Offset ~= cardW then
		self.emptyCard.Size = UDim2.fromOffset(cardW, 0)
	end
	local cols = 4
	if cardW < 420 then
		cols = 2
	end
	local cell = UDim2.new(1 / cols, -math.ceil(8 * (cols - 1) / cols), 0, 76)
	if self.emptyGridLayout.CellSize ~= cell then
		self.emptyGridLayout.CellSize = cell
	end
	local cardH = self.emptyCard.AbsoluteSize.Y
	local top = math.max(16, math.floor((H - cardH) / 2))
	self.emptyCard.Position = UDim2.new(0.5, 0, 0, top)
	self.emptyHolder.CanvasSize = UDim2.fromOffset(0, cardH + top + 16)
end

-- Écrans déjà enregistrés sur la carte de départ
function GuiEditor:_refreshEmpty()
	if self._destroyed or self.emptySaved == nil then
		return
	end
	disconnectAll(self._emptyConns)
	for _, child in ipairs(self.emptySaved:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local screens = {}
	if self.doc == nil then
		local ok, list = pcall(GuiStorage.list)
		if ok and type(list) == "table" then
			screens = list
		end
	end
	local any = #screens > 0
	self.emptySavedTitle.Visible = any
	self.emptySaved.Visible = any
	for i, entry in ipairs(screens) do
		if i > 12 then
			break
		end
		local chip = makeButton({
			Name = "Ecran",
			Text = tostring(entry.name),
			Font = Theme.Fonts.UIBold,
			TextSize = ts(12),
			TextColor3 = C.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundColor3 = C.Button,
			LayoutOrder = i,
			ZIndex = 8,
			Parent = self.emptySaved,
		})
		Util.corner(chip, 8)
		self:_conn(chip.MouseEnter, function()
			chip.BackgroundColor3 = C.ButtonHover
		end, self._emptyConns)
		self:_conn(chip.MouseLeave, function()
			chip.BackgroundColor3 = C.Button
		end, self._emptyConns)
		self:_conn(chip.MouseButton1Click, function()
			self:_request("ouvrir", entry.instance)
		end, self._emptyConns)
	end
	self:_layoutEmpty()
end

---------------------------------------------------------------------------
-- Construction de l'écran dans l'aperçu (après chaque commit, avec un court délai)
---------------------------------------------------------------------------

function GuiEditor:_rebuildPreview()
	if self._destroyed then
		return
	end
	if self._tracking ~= nil then
		-- pendant un glissement, seule l'instance glissée bouge : on reconstruit à la fin
		self._rebuildAfterTracking = true
		return
	end
	disconnectAll(self._previewConns)
	local old = self._built
	self._built = nil
	local doc = self.doc
	if doc ~= nil then
		local ok, result = pcall(GuiBuild.build, doc, nil, {
			scale = self._k,
			editor = not self._previewing,
			rootClass = "Frame",
		})
		if ok and type(result) == "table" and typeof(result.racine) == "Instance" then
			result.racine.Parent = self.buildHost
			self._built = result
			if type(result.errors) == "table" and result.errors[1] ~= nil then
				self:_status(tostring(result.errors[1]), "warning")
			end
			if self._previewing then
				self:_wireInteractive(result)
			end
		else
			self:_status("L'aperçu de l'écran n'a pas pu être construit : " .. tostring(result), "error")
		end
	end
	-- (l'ancien écran disparaît seulement quand le nouveau est en place : aucun clignotement)
	if old ~= nil and typeof(old.racine) == "Instance" then
		pcall(function()
			old.racine:Destroy()
		end)
	end
	self:_playBuildAnimations()
	self:_updateOverlay()
end

-- Élément posé : il « saute » ; modèle : ses éléments arrivent l'un après l'autre
function GuiEditor:_playBuildAnimations()
	local built = self._built
	local popId = self._popAfterBuild
	self._popAfterBuild = nil
	local stagger = self._staggerAfterBuild
	self._staggerAfterBuild = false
	if built == nil or self._previewing or self.doc == nil then
		return
	end
	if popId ~= nil then
		local inst = built.byId[popId]
		if inst ~= nil then
			anim("popIn", inst, 0.8)
		end
	end
	if stagger then
		local ids = self.doc.tops
		if type(stagger) == "table" then
			ids = stagger
		end
		local n = 0
		for _, id in ipairs(ids) do
			local inst = built.byId[id]
			if inst ~= nil and inst.Visible then
				n += 1
				if n > 14 then
					break
				end
				anim("slideIn", inst, Vector2.new(0, 18), 0.3, (n - 1) * 0.05)
			end
		end
	end
end

-- Aperçu interactif : les boutons « rebondissent » comme dans le jeu (sans script)
function GuiEditor:_wireInteractive(result)
	for id, inst in pairs(result.byId) do
		if inst:IsA("GuiButton") then
			if inst:GetAttribute("BlocsFR_Effet") == "rebond" then
				self:_wireRebond(inst)
			end
			self:_conn(inst.Activated, function()
				self:_onPreviewButton(id)
			end, self._previewConns)
		end
	end
end

function GuiEditor:_wireRebond(button)
	local scale = button:FindFirstChild("BlocsFR_Echelle")
	if scale == nil or not scale:IsA("UIScale") then
		scale = Instance.new("UIScale")
		scale.Name = "BlocsFR_Echelle"
		scale.Parent = button
	end
	local face = nil
	for _, child in ipairs(button:GetChildren()) do
		if child.Name == "Face" and child:IsA("GuiObject") and child:GetAttribute("BlocsFR_Type") == nil then
			face = child
			break
		end
	end
	local hover, down = false, false
	local function update(duration)
		local target = 1
		if down then
			target = 0.95
		elseif hover then
			target = 1.05
		end
		animTween(scale, { Scale = target }, duration, "quadOut")
		if face ~= nil then
			local offset = 0
			if down then
				local relief = button:GetAttribute("BlocsFR_Relief")
				if type(relief) == "number" then
					offset = relief * self._k * 0.6
				end
			end
			animTween(face, { Position = UDim2.fromOffset(0, offset) }, duration, "quadOut")
		end
	end
	local conns = self._previewConns
	self:_conn(button.MouseEnter, function()
		hover = true
		update(0.12)
	end, conns)
	self:_conn(button.MouseLeave, function()
		hover = false
		down = false
		update(0.12)
	end, conns)
	self:_conn(button.MouseButton1Down, function()
		down = true
		update(0.08)
	end, conns)
	self:_conn(button.MouseButton1Up, function()
		down = false
		update(0.1)
	end, conns)
end

function GuiEditor:_onPreviewButton(id)
	local el = self.doc and self.doc:get(id)
	if el == nil then
		return
	end
	local entries = self:_linksOf(el.name)
	if entries[1] ~= nil then
		self:_status("Bouton « " .. el.name .. " » cliqué : dans le jeu, « " .. entries[1].text .. " » se lancerait.", "info")
	else
		self:_status(
			"Bouton « " .. el.name .. " » cliqué. Il n'a pas encore de script : clic droit → « Ajouter un script au clic ».",
			"info"
		)
	end
end

---------------------------------------------------------------------------
-- Géométrie : coordonnées de l'écran, tests de position
---------------------------------------------------------------------------

-- Coin haut-gauche de l'écran, en coordonnées « écran » du plugin
function GuiEditor:_screenOrigin()
	local origin = self.previewRoot.AbsolutePosition
	return Vector2.new(origin.X + self._screen.x, origin.Y + self._screen.y)
end

-- Point de la souris -> pixels relatifs au coin de l'écran affiché
function GuiEditor:_toScreenLocal(p)
	local o = self:_screenOrigin()
	return Vector2.new(p.X - o.X, p.Y - o.Y)
end

function GuiEditor:_insideScreen(loc, margin)
	local S = self._screen
	local m = margin or 0
	return S.w > 0 and loc.X >= -m and loc.Y >= -m and loc.X <= S.w + m and loc.Y <= S.h + m
end

-- Élément visible le plus en avant sous le point (pixels relatifs à l'écran)
function GuiEditor:_hitTest(loc)
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		return nil
	end
	local ok, id = pcall(doc.hitTest, doc, loc.X, loc.Y, S.w, S.h)
	if ok then
		return id
	end
	return nil
end

-- Rectangle du parent de id en px de référence (l'écran : 0, 0, 1280, 720)
function GuiEditor:_parentRef(id)
	local doc = self.doc
	local parentId = doc and doc:parentOf(id)
	if parentId ~= nil and doc:get(parentId) ~= nil then
		local x, y, w, h = doc:absRect(parentId, REF_W, REF_H)
		return x, y, math.max(w, 1e-6), math.max(h, 1e-6)
	end
	return 0, 0, REF_W, REF_H
end

-- Liste / grille qui range id (sa position ne compte pas), ou nil
function GuiEditor:_layoutParentOf(id)
	local doc = self.doc
	if doc == nil then
		return nil
	end
	local parentId = doc:parentOf(id)
	local parent = parentId and doc:get(parentId)
	if parent ~= nil and LAYOUT_TYPES[parent.type] then
		return parent
	end
	return nil
end

function GuiEditor:_canMove(id)
	return self.doc ~= nil and self.doc:get(id) ~= nil and self:_layoutParentOf(id) == nil
end

function GuiEditor:_canResize(id)
	if self.doc == nil or self.doc:get(id) == nil then
		return false
	end
	local parent = self:_layoutParentOf(id)
	return parent == nil or parent.type ~= "grille"
end

-- Cadre / liste / grille visible le plus profond sous le point (excludeId et ses enfants ignorés)
function GuiEditor:_containerAt(x, y, excludeId)
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		return nil
	end
	local function test(ids, depth)
		if depth > 64 then
			return nil
		end
		for i = #ids, 1, -1 do
			local el = doc:get(ids[i])
			if el ~= nil and el.visible and el.id ~= excludeId then
				local hit = test(el.children, depth + 1)
				if hit ~= nil then
					return hit
				end
				if GuiDoc.PARENT_TYPES[el.type] then
					local ex, ey, ew, eh = doc:absRect(el.id, S.w, S.h)
					if x >= ex and x <= ex + ew and y >= ey and y <= ey + eh then
						return el.id
					end
				end
			end
		end
		return nil
	end
	return test(doc.tops, 0)
end

-- Éléments entièrement dans le rectangle { x1, y1, x2, y2 } (un parent pris entier : pas ses enfants)
function GuiEditor:_idsInRect(r)
	local out = {}
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		return out
	end
	local function visit(ids, depth)
		if depth > 64 then
			return
		end
		for _, id in ipairs(ids) do
			local el = doc:get(id)
			if el ~= nil and el.visible then
				local x, y, w, h = doc:absRect(id, S.w, S.h)
				if x >= r[1] and y >= r[2] and x + w <= r[3] and y + h <= r[4] then
					table.insert(out, id)
				else
					visit(el.children, depth + 1)
				end
			end
		end
	end
	visit(doc.tops, 0)
	return out
end

-- Poignée sous le point (une seule sélection redimensionnable), ou nil
function GuiEditor:_handleAt(loc)
	if #self._sel ~= 1 or self.doc == nil then
		return nil
	end
	local id = self._sel[1]
	if not self:_canResize(id) then
		return nil
	end
	local S = self._screen
	local x, y, w, h = self.doc:absRect(id, S.w, S.h)
	for _, hd in ipairs(HANDLES) do
		local hx, hy = x + hd.ax * w, y + hd.ay * h
		if math.abs(loc.X - hx) <= HANDLE_HIT and math.abs(loc.Y - hy) <= HANDLE_HIT then
			return hd
		end
	end
	return nil
end

-- Nom d'élément de cet écran pour une valeur d'entrée « gui » (« Écran/Élément » accepté), ou nil
function GuiEditor:_localName(value)
	if type(value) ~= "string" or value == "" then
		return nil
	end
	local screen, name = string.match(value, "^(.-)/(.+)$")
	if screen ~= nil then
		if self.doc ~= nil and screen == self.doc.name then
			return name
		end
		return nil
	end
	return value
end

---------------------------------------------------------------------------
-- Calque de l'aperçu : sélection, poignées, survol, lueur, repères, cible
---------------------------------------------------------------------------

local function placeBox(frame, x, y, w, h)
	frame.Position = UDim2.fromOffset(round(x), round(y))
	frame.Size = UDim2.fromOffset(math.max(1, round(w)), math.max(1, round(h)))
end

function GuiEditor:_hideOverlay()
	self.selFrame.Visible = false
	for _, box in ipairs(self._extraBoxes) do
		box.Visible = false
	end
	self.hoverBox.Visible = false
	self.guideV.Visible = false
	self.guideH.Visible = false
	self.dropBox.Visible = false
	self.band.Visible = false
	self.ghost.Visible = false
	self:_updateHighlight()
end

function GuiEditor:_extraBox(i)
	local box = self._extraBoxes[i]
	if box == nil then
		box = makeFrame({ Name = "SelectionAutre", Active = false, Visible = false, ZIndex = 2, Parent = self.overlay })
		Util.stroke(box, C.Accent, 2)
		self._extraBoxes[i] = box
	end
	return box
end

function GuiEditor:_updateOverlay()
	if self._destroyed then
		return
	end
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 or self._previewing then
		self:_hideOverlay()
		return
	end
	-- les autres éléments sélectionnés : un simple cadre bleu
	local primary = self:_primary()
	local extra = 0
	for _, id in ipairs(self._sel) do
		if id ~= primary and doc:get(id) ~= nil then
			extra += 1
			local box = self:_extraBox(extra)
			placeBox(box, doc:absRect(id, S.w, S.h))
			box.Visible = true
		end
	end
	for i = extra + 1, #self._extraBoxes do
		self._extraBoxes[i].Visible = false
	end
	local sel = self.selFrame
	local el = primary and doc:get(primary)
	if el ~= nil then
		local x, y, w, h = doc:absRect(primary, S.w, S.h)
		placeBox(sel, x, y, w, h)
		sel.Visible = true
		local single = #self._sel == 1
		local resizable = single and self:_canResize(primary)
		for _, hd in ipairs(HANDLES) do
			self.handles[hd.id].Visible = resizable
		end
		-- taille en px de référence (« L × H »)
		local _, _, rw, rh = doc:absRect(primary, REF_W, REF_H)
		self.sizeLabel.Text = tostring(round(rw)) .. " × " .. tostring(round(rh))
		self.sizePill.Visible = single
		if y + h + 30 > S.h and y > 30 then
			self.sizePill.AnchorPoint = Vector2.new(0.5, 1)
			self.sizePill.Position = UDim2.new(0.5, 0, 0, -8)
		else
			self.sizePill.AnchorPoint = Vector2.new(0.5, 0)
			self.sizePill.Position = UDim2.new(0.5, 0, 1, 8)
		end
		-- pastille « ◆ n script(s) » quand les blocs de l'écran utilisent l'élément
		local count = self:_scriptCount(el.name)
		if single and count > 0 then
			local word = "script"
			if count > 1 then
				word = "scripts"
			end
			self.badge.Text = "◆ " .. tostring(count) .. " " .. word
			self.badge.Visible = true
			if x + w + 110 > S.w and x > 110 then
				self.badge.AnchorPoint = Vector2.new(1, 0.5)
				self.badge.Position = UDim2.new(0, -10, 0.5, 0)
			else
				self.badge.AnchorPoint = Vector2.new(0, 0.5)
				self.badge.Position = UDim2.new(1, 10, 0.5, 0)
			end
		else
			self.badge.Visible = false
		end
	else
		sel.Visible = false
	end
	self:_updateHover()
	self:_updateHighlight()
end

function GuiEditor:_setHover(id)
	if self._hoverId == id then
		return
	end
	self._hoverId = id
	self:_updateHover()
end

function GuiEditor:_updateHover()
	local id = self._hoverId
	local doc, S = self.doc, self._screen
	if id == nil or doc == nil or doc:get(id) == nil or S.w <= 0 or self._previewing or self._tracking ~= nil or self:_isSelected(id) then
		self.hoverBox.Visible = false
		return
	end
	placeBox(self.hoverBox, doc:absRect(id, S.w, S.h))
	self.hoverBox.Visible = true
end

function GuiEditor:_onPreviewHover()
	if self._tracking ~= nil or self._previewing or self.doc == nil then
		return
	end
	self:_setHover(self:_hitTest(self:_toScreenLocal(self:_mouse())))
end

-- Lueur cyan sur l'élément nommé par editor:highlightByName (bloc survolé)
function GuiEditor:_updateHighlight()
	local glow = self.glow
	local doc, S = self.doc, self._screen
	local id = nil
	local name = self._highlightName
	if name ~= nil and doc ~= nil and S.w > 0 and not self._previewing then
		local localName = self:_localName(name)
		if localName ~= nil then
			id = doc:findByName(localName)
		end
	end
	if id == nil then
		glow.Visible = false
		if self._glowStop ~= nil then
			local stop = self._glowStop
			self._glowStop = nil
			pcall(stop)
		end
		return
	end
	placeBox(glow, doc:absRect(id, S.w, S.h))
	if not glow.Visible then
		glow.Visible = true
	end
	if self._glowStop == nil then
		local stop = anim("pulse", self.glowStroke, 0.15, 0.8, 1.2)
		if type(stop) == "function" then
			self._glowStop = stop
		end
	end
end

function GuiEditor:_showGuides(gx, gy)
	if gx ~= nil then
		self.guideV.Position = UDim2.fromOffset(round(gx), 0)
		self.guideV.Visible = true
	else
		self.guideV.Visible = false
	end
	if gy ~= nil then
		self.guideH.Position = UDim2.fromOffset(0, round(gy))
		self.guideH.Visible = true
	else
		self.guideH.Visible = false
	end
end

-- Conteneur visé pendant un glissement (id), ou tout l'écran quand l'élément sort de outsideOf
function GuiEditor:_showDropTarget(id, outsideOf)
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		self.dropBox.Visible = false
		return
	end
	local el = id and doc:get(id)
	if el ~= nil then
		placeBox(self.dropBox, doc:absRect(id, S.w, S.h))
		self.dropLabel.Text = "Dans « " .. el.name .. " »"
		self.dropBox.Visible = true
	elseif outsideOf ~= nil then
		placeBox(self.dropBox, 0, 0, S.w, S.h)
		self.dropLabel.Text = "Hors de « " .. outsideOf .. " »"
		self.dropBox.Visible = true
	else
		self.dropBox.Visible = false
	end
end

---------------------------------------------------------------------------
-- Suivi de la souris pendant un glissement (comme Canvas : un bouton transparent plein écran
-- dans le calque des glissements + Heartbeat + host.getMousePosition())
---------------------------------------------------------------------------

-- spec = { onMove = fn(p), onEnd = fn(p, how), onCancel = fn()|nil } ; how = "relache" | "clic" |
-- "annule" (clic droit) | "focus" (fenêtre quittée) | "erreur"
function GuiEditor:_startTracking(spec)
	self:_cancelTracking()
	local layer = self:_dragLayer()
	if typeof(layer) ~= "Instance" then
		return nil
	end
	local overlay = makeButton({
		Name = "SuiviSourisInterface",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_TRACK,
		Parent = layer,
	})
	local t = { overlay = overlay, connections = {}, spec = spec, started = os.clock(), last = nil }
	self._tracking = t
	self:_updateHover()
	self:_hideTooltip()

	local function move()
		if self._tracking ~= t then
			return
		end
		local p = self:_mouse()
		if t.last == nil or p ~= t.last then
			t.last = p
			local ok, err = pcall(spec.onMove, p)
			if not ok then
				warn("[Blocs FR] Studio d'interface : " .. tostring(err))
				self:_endTracking(t, "erreur")
			end
		end
	end
	local function finish(how)
		self:_endTracking(t, how)
	end

	local conns = t.connections
	table.insert(conns, overlay.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			move()
		end
	end))
	table.insert(conns, overlay.InputBegan:Connect(function(input)
		local key = SHIFT_KEYS[input.KeyCode]
		if key ~= nil then
			self._keys[key] = true
			t.last = nil -- Maj enfoncée : on recalcule tout de suite (proportions)
			move()
		end
	end))
	table.insert(conns, overlay.InputEnded:Connect(function(input)
		local key = SHIFT_KEYS[input.KeyCode]
		if key ~= nil then
			self._keys[key] = nil
			t.last = nil
			move()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish("relache")
		end
	end))
	table.insert(conns, overlay.MouseButton1Up:Connect(function()
		finish("relache")
	end))
	-- un appui pendant le suivi (relâchement manqué) termine aussi
	table.insert(conns, overlay.MouseButton1Down:Connect(function()
		if os.clock() - t.started > 0.15 then
			finish("clic")
		end
	end))
	table.insert(conns, overlay.MouseButton2Down:Connect(function()
		finish("annule")
	end))
	table.insert(conns, RunService.Heartbeat:Connect(move))
	local widget = self.host.widget
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(conns, widget.WindowFocusReleased:Connect(function()
				finish("focus")
			end))
		end)
	end
	return t
end

function GuiEditor:_endTracking(t, how)
	if self._tracking ~= t then
		return
	end
	self._tracking = nil
	disconnectAll(t.connections)
	if t.overlay ~= nil then
		pcall(function()
			t.overlay:Destroy()
		end)
		t.overlay = nil
	end
	local ok, err = pcall(t.spec.onEnd, self:_mouse(), how)
	if not ok then
		warn("[Blocs FR] Studio d'interface : " .. tostring(err))
		self:_status("Erreur pendant le glissement : " .. tostring(err), "error")
	end
	if self._rebuildAfterTracking then
		self._rebuildAfterTracking = false
		self:_rebuildPreview()
	end
	self:_updateOverlay()
end

-- Arrête le suivi sans onEnd (onCancel remet les choses en place)
function GuiEditor:_cancelTracking()
	local t = self._tracking
	if t == nil then
		return
	end
	self._tracking = nil
	disconnectAll(t.connections)
	if t.overlay ~= nil then
		pcall(function()
			t.overlay:Destroy()
		end)
		t.overlay = nil
	end
	if type(t.spec.onCancel) == "function" then
		pcall(t.spec.onCancel)
	end
	if self._rebuildAfterTracking then
		self._rebuildAfterTracking = false
		self:_rebuildPreview()
	end
end

---------------------------------------------------------------------------
-- Clic dans l'aperçu : poignée, élément (sélection, double-clic, déplacement) ou fond (rectangle)
---------------------------------------------------------------------------

function GuiEditor:_onPreviewDown()
	if self._destroyed or self._tracking ~= nil or self._previewing then
		return
	end
	self:_hideTooltip()
	local doc = self.doc
	if doc == nil then
		return
	end
	local p = self:_mouse()
	local loc = self:_toScreenLocal(p)
	local handle = self:_handleAt(loc)
	if handle ~= nil then
		self:_beginResize(self._sel[1], handle, p)
		return
	end
	local id = self:_hitTest(loc)
	local additive = self:_modifier("shift") or self:_modifier("ctrl")
	local now = os.clock()
	local last = self._lastClick
	self._lastClick = { id = id, time = now }
	if id ~= nil and not additive and last ~= nil and last.id == id and now - last.time <= DOUBLE_CLICK then
		-- double-clic : modifier le texte (ou l'image, ou le nom)
		self._lastClick = nil
		self:_setSelection({ id })
		self:_editElement(id)
		return
	end
	if id == nil then
		if not additive then
			self:_setSelection({})
		end
		self:_beginRubberBand(p, additive)
		return
	end
	if additive then
		self:_toggleSelected(id)
		return
	end
	if not self:_isSelected(id) then
		self:_setSelection({ id })
	else
		self:_makePrimary(id)
	end
	self:_beginMove(id, p)
end

-- Aimantation : décalage (et valeur) de la cible la plus proche à SNAP_PX près, ou nil
local function snapAxis(candidates, targets)
	local bestDelta, bestValue = nil, nil
	for _, c in ipairs(candidates) do
		for _, t in ipairs(targets) do
			local d = t - c
			if math.abs(d) <= SNAP_PX and (bestDelta == nil or math.abs(d) < math.abs(bestDelta)) then
				bestDelta = d
				bestValue = t
			end
		end
	end
	return bestDelta, bestValue
end

-- Lignes d'aimantation : bords et centres de l'écran, du parent et des frères visibles
function GuiEditor:_snapTargets(id)
	local doc, S = self.doc, self._screen
	local el = doc:get(id)
	local xs, ys = {}, {}
	local function add(x, y, w, h)
		table.insert(xs, x)
		table.insert(xs, x + w / 2)
		table.insert(xs, x + w)
		table.insert(ys, y)
		table.insert(ys, y + h / 2)
		table.insert(ys, y + h)
	end
	add(0, 0, S.w, S.h)
	if el.parent ~= nil and doc:get(el.parent) ~= nil then
		add(doc:absRect(el.parent, S.w, S.h))
	end
	for _, sid in ipairs(doc:children(el.parent)) do
		local sibling = doc:get(sid)
		if sid ~= id and sibling ~= nil and sibling.visible then
			add(doc:absRect(sid, S.w, S.h))
		end
	end
	return { xs = xs, ys = ys }
end

---------------------------------------------------------------------------
-- Déplacer (seule l'instance glissée bouge ; le document est validé au relâchement)
---------------------------------------------------------------------------

function GuiEditor:_beginMove(clickedId, p0)
	local doc = self.doc
	local ids = {}
	for _, id in ipairs(self:_topSelection()) do
		if self:_canMove(id) then
			table.insert(ids, id)
		end
	end
	local state = { started = false, ids = ids, origin = {}, multi = #self._sel > 1 }
	self:_startTracking({
		onMove = function(p)
			if not state.started then
				if (p - p0).Magnitude < DRAG_THRESHOLD then
					return
				end
				if #ids == 0 then
					if not state.warned then
						state.warned = true
						local parent = self:_layoutParentOf(clickedId)
						if parent ~= nil then
							self:_status(
								"« "
									.. parent.name
									.. " » range ses éléments toute seule : pour changer l'ordre, clic droit → « Mettre devant » ou « Mettre derrière ».",
								"info"
							)
						end
					end
					return
				end
				state.started = true
				self:_prepareMove(state)
			end
			self:_updateMove(state, p - p0)
		end,
		onEnd = function(_, how)
			if state.started then
				self:_finishMove(state, how)
			elseif state.multi and self.doc == doc and doc:get(clickedId) ~= nil and how ~= "annule" then
				-- simple clic dans une sélection multiple : on ne garde que cet élément
				self:_setSelection({ clickedId })
			end
		end,
		onCancel = function()
			if state.started then
				self:_revertMove(state)
			end
		end,
	})
end

function GuiEditor:_prepareMove(state)
	local doc, S = self.doc, self._screen
	for _, id in ipairs(state.ids) do
		local el = doc:get(id)
		local _, _, pw, ph = 0, 0, S.w, S.h
		if el.parent ~= nil and doc:get(el.parent) ~= nil then
			_, _, pw, ph = doc:absRect(el.parent, S.w, S.h)
		end
		local inst = self._built and self._built.byId[id]
		if inst ~= nil then
			-- arrête une éventuelle animation d'apparition sur la position
			animTween(inst, { Position = UDim2.fromScale(el.x, el.y) }, 0)
		end
		state.origin[id] = {
			x = el.x,
			y = el.y,
			pw = math.max(pw, 1e-6),
			ph = math.max(ph, 1e-6),
			rect = { doc:absRect(id, S.w, S.h) },
			inst = inst,
			parent = el.parent,
		}
	end
	if #state.ids == 1 then
		state.targets = self:_snapTargets(state.ids[1])
	end
end

function GuiEditor:_updateMove(state, d)
	local doc = self.doc
	local dx, dy = d.X, d.Y
	local gx, gy = nil, nil
	if state.targets ~= nil then
		local r = state.origin[state.ids[1]].rect
		local ddx, vx = snapAxis({ r[1] + dx, r[1] + dx + r[3] / 2, r[1] + dx + r[3] }, state.targets.xs)
		if ddx ~= nil then
			dx += ddx
			gx = vx
		end
		local ddy, vy = snapAxis({ r[2] + dy, r[2] + dy + r[4] / 2, r[2] + dy + r[4] }, state.targets.ys)
		if ddy ~= nil then
			dy += ddy
			gy = vy
		end
	end
	for _, id in ipairs(state.ids) do
		local o = state.origin[id]
		local el = doc:get(id)
		if el ~= nil then
			doc:setRect(id, o.x + dx / o.pw, o.y + dy / o.ph, nil, nil)
			local inst = o.inst
			if inst ~= nil and inst.Parent ~= nil then
				inst.Position = UDim2.fromScale(el.x, el.y)
			end
		end
	end
	-- un seul élément : le cadre / la liste sous la souris l'accueillera au relâchement
	if #state.ids == 1 then
		local id = state.ids[1]
		local loc = self:_toScreenLocal(self:_mouse())
		local target = self:_containerAt(loc.X, loc.Y, id)
		local current = state.origin[id].parent
		state.dropParent = target
		state.dropKnown = true
		if target ~= current then
			local outside = nil
			if target == nil and current ~= nil and doc:get(current) ~= nil then
				outside = doc:get(current).name
			end
			self:_showDropTarget(target, outside)
		else
			self:_showDropTarget(nil)
		end
	end
	self:_showGuides(gx, gy)
	self:_updateOverlay()
end

function GuiEditor:_finishMove(state, how)
	self:_showGuides(nil, nil)
	self:_showDropTarget(nil)
	local doc = self.doc
	if how == "annule" or how == "erreur" then
		self:_revertMove(state)
		return
	end
	local reason = "deplacer"
	local message = nil
	if #state.ids == 1 and state.dropKnown then
		local id = state.ids[1]
		local el = doc:get(id)
		local target = state.dropParent
		if el ~= nil and target ~= el.parent and doc:setParent(id, target, nil) then
			reason = "ranger"
			if target ~= nil then
				message = "« " .. el.name .. " » est maintenant dans « " .. doc:get(target).name .. " »."
			else
				message = "« " .. el.name .. " » est maintenant directement sur l'écran."
			end
		end
	end
	doc:commit(reason)
	if message ~= nil then
		self:_status(message, "info")
	end
end

function GuiEditor:_revertMove(state)
	local doc = self.doc
	self:_showGuides(nil, nil)
	self:_showDropTarget(nil)
	if doc == nil then
		return
	end
	for _, id in ipairs(state.ids) do
		local o = state.origin[id]
		if o ~= nil and doc:get(id) ~= nil then
			doc:setRect(id, o.x, o.y, nil, nil)
			if o.inst ~= nil and o.inst.Parent ~= nil then
				o.inst.Position = UDim2.fromScale(o.x, o.y)
			end
		end
	end
	self:_updateOverlay()
end

---------------------------------------------------------------------------
-- Redimensionner avec les 8 poignées (Maj sur un coin : mêmes proportions)
---------------------------------------------------------------------------

function GuiEditor:_beginResize(id, handle, p0)
	local doc, S = self.doc, self._screen
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	local layoutParent = self:_layoutParentOf(id)
	local px, py, pw, ph = 0, 0, S.w, S.h
	if el.parent ~= nil and doc:get(el.parent) ~= nil then
		px, py, pw, ph = doc:absRect(el.parent, S.w, S.h)
	end
	local x, y, w, h = doc:absRect(id, S.w, S.h)
	local state = {
		id = id,
		handle = handle,
		started = false,
		orig = { x = el.x, y = el.y, w = el.w, h = el.h },
		rect = { x - px, y - py, w, h }, -- relatif au parent (pixels de l'aperçu)
		prect = { px, py, math.max(pw, 1e-6), math.max(ph, 1e-6) },
		inst = self._built and self._built.byId[id],
		layoutParent = layoutParent,
	}
	if layoutParent ~= nil then
		-- enfant d'une liste : sa taille est une fraction de la taille de référence de la liste
		local _, _, lw, lh = doc:absRect(layoutParent.id, REF_W, REF_H)
		state.listRef = { math.max(lw, 1e-6), math.max(lh, 1e-6) }
	else
		state.targets = self:_snapTargets(id)
	end
	self:_startTracking({
		onMove = function(p)
			if not state.started then
				if (p - p0).Magnitude < 1 then
					return
				end
				state.started = true
			end
			self:_updateResize(state, p - p0)
		end,
		onEnd = function(_, how)
			self:_showGuides(nil, nil)
			if not state.started then
				return
			end
			if how == "annule" or how == "erreur" then
				self:_revertResize(state)
				return
			end
			if self.doc ~= nil and self.doc:get(id) ~= nil then
				self.doc:commit("redimensionner")
			end
		end,
		onCancel = function()
			if state.started then
				self:_revertResize(state)
			end
		end,
	})
end

function GuiEditor:_updateResize(state, d)
	local doc = self.doc
	local el = doc and doc:get(state.id)
	if el == nil then
		return
	end
	local hd = state.handle
	local L, T, W, H = state.rect[1], state.rect[2], state.rect[3], state.rect[4]
	local left, top, right, bottom = L, T, L + W, T + H
	if hd.ax == 0 then
		left = L + d.X
	elseif hd.ax == 1 then
		right = L + W + d.X
	end
	if hd.ay == 0 then
		top = T + d.Y
	elseif hd.ay == 1 then
		bottom = T + H + d.Y
	end
	-- aimantation des bords qui bougent (les cibles sont relatives à l'écran)
	local gx, gy = nil, nil
	if state.targets ~= nil then
		local ox, oy = state.prect[1], state.prect[2]
		if hd.ax == 0 then
			local dd, v = snapAxis({ left + ox }, state.targets.xs)
			if dd ~= nil then
				left += dd
				gx = v
			end
		elseif hd.ax == 1 then
			local dd, v = snapAxis({ right + ox }, state.targets.xs)
			if dd ~= nil then
				right += dd
				gx = v
			end
		end
		if hd.ay == 0 then
			local dd, v = snapAxis({ top + oy }, state.targets.ys)
			if dd ~= nil then
				top += dd
				gy = v
			end
		elseif hd.ay == 1 then
			local dd, v = snapAxis({ bottom + oy }, state.targets.ys)
			if dd ~= nil then
				bottom += dd
				gy = v
			end
		end
	end
	-- taille minimale : le bord opposé ne bouge pas
	if right - left < MIN_SIZE_PX then
		if hd.ax == 0 then
			left = right - MIN_SIZE_PX
		else
			right = left + MIN_SIZE_PX
		end
		gx = nil
	end
	if bottom - top < MIN_SIZE_PX then
		if hd.ay == 0 then
			top = bottom - MIN_SIZE_PX
		else
			bottom = top + MIN_SIZE_PX
		end
		gy = nil
	end
	-- Maj sur un coin : les proportions de départ sont gardées
	if hd.ax ~= 0.5 and hd.ay ~= 0.5 and W > 0 and H > 0 and self:_modifier("shift") then
		local nw, nh = right - left, bottom - top
		if nw / W >= nh / H then
			nh = nw * H / W
		else
			nw = nh * W / H
		end
		if hd.ax == 0 then
			left = right - nw
		else
			right = left + nw
		end
		if hd.ay == 0 then
			top = bottom - nh
		else
			bottom = top + nh
		end
		gx, gy = nil, nil
	end
	local nw, nh = right - left, bottom - top
	local inst = state.inst
	local s = 1
	if inst ~= nil then
		local attr = inst:GetAttribute("BlocsFR_EchelleTexte")
		if type(attr) == "number" and attr > 0 then
			s = attr
		end
	end
	if state.layoutParent ~= nil then
		local k = math.max(self._k, 1e-6)
		local lw, lh = state.listRef[1], state.listRef[2]
		doc:setRect(state.id, nil, nil, nw / (lw * k), nh / (lh * k))
		if inst ~= nil and inst.Parent ~= nil then
			inst:SetAttribute("BlocsFR_L", el.w * lw)
			inst:SetAttribute("BlocsFR_H", el.h * lh)
			inst.Size = UDim2.fromOffset(el.w * lw * k / s, el.h * lh * k / s)
		end
	else
		local pw, ph = state.prect[3], state.prect[4]
		doc:setRect(state.id, (left + el.ax * nw) / pw, (top + el.ay * nh) / ph, nw / pw, nh / ph)
		if inst ~= nil and inst.Parent ~= nil then
			inst.Position = UDim2.fromScale(el.x, el.y)
			inst.Size = UDim2.fromScale(el.w / s, el.h / s)
			if el.type == "texte" then
				inst:SetAttribute("BlocsFR_Largeur", el.w)
				inst:SetAttribute("BlocsFR_Hauteur", el.h)
			end
		end
	end
	self:_showGuides(gx, gy)
	self:_updateOverlay()
end

function GuiEditor:_revertResize(state)
	self:_showGuides(nil, nil)
	local doc = self.doc
	if doc == nil or doc:get(state.id) == nil then
		return
	end
	local o = state.orig
	doc:setRect(state.id, o.x, o.y, o.w, o.h)
	self:_rebuildPreview()
end

---------------------------------------------------------------------------
-- Rectangle de sélection (glisser sur le fond de l'écran)
---------------------------------------------------------------------------

function GuiEditor:_beginRubberBand(p0, additive)
	local base = {}
	if additive then
		base = table.clone(self._sel)
	end
	local origin = self:_toScreenLocal(p0)
	local state = { started = false, rect = nil }
	self:_startTracking({
		onMove = function(p)
			if not state.started then
				if (p - p0).Magnitude < DRAG_THRESHOLD then
					return
				end
				state.started = true
			end
			local loc = self:_toScreenLocal(p)
			local x1, y1 = math.min(origin.X, loc.X), math.min(origin.Y, loc.Y)
			local x2, y2 = math.max(origin.X, loc.X), math.max(origin.Y, loc.Y)
			state.rect = { x1, y1, x2, y2 }
			placeBox(self.band, x1, y1, x2 - x1, y2 - y1)
			self.band.Visible = true
		end,
		onEnd = function(_, how)
			self.band.Visible = false
			if not state.started or state.rect == nil or how == "annule" then
				return
			end
			local ids = base
			for _, id in ipairs(self:_idsInRect(state.rect)) do
				if indexOf(ids, id) == nil then
					table.insert(ids, id)
				end
			end
			self:_setSelection(ids)
			if #ids > 1 then
				self:_status(tostring(#ids) .. " éléments sélectionnés : clic droit pour les copier, les aligner ou les supprimer.", "info")
			end
		end,
		onCancel = function()
			self.band.Visible = false
		end,
	})
end

---------------------------------------------------------------------------
-- Ajouter un élément : glisser une tuile sur l'écran, ou cliquer dessus
---------------------------------------------------------------------------

local FEMININE = { image = true, barre = true, liste = true, grille = true }

function GuiEditor:_beginTileDrag(elementType)
	if self._destroyed or self._tracking ~= nil then
		return
	end
	if self._previewing then
		self:_setPreviewing(false)
	end
	local p0 = self:_mouse()
	local state = { started = false, type = elementType }
	self:_startTracking({
		onMove = function(p)
			if not state.started then
				if (p - p0).Magnitude < DRAG_THRESHOLD then
					return
				end
				state.started = true
				self:_createTileChip(state)
			end
			self:_updateTileDrag(state, p)
		end,
		onEnd = function(p, how)
			self:_endTileDrag(state)
			if how == "annule" or how == "erreur" or how == "focus" then
				return
			end
			if not state.started then
				self:_addElementCenter(elementType, nil)
				return
			end
			self:_dropTile(state, p)
		end,
		onCancel = function()
			self:_endTileDrag(state)
		end,
	})
end

-- Petite étiquette « ＋ Bouton » qui suit la souris
function GuiEditor:_createTileChip(state)
	local layer = self:_dragLayer()
	if typeof(layer) ~= "Instance" then
		return
	end
	local chip = makeFrame({
		Name = "ElementGlisse",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Popup,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		ZIndex = Z_TRACK + 1,
		Parent = layer,
	})
	Util.corner(chip, 8)
	Util.stroke(chip, C.PopupBorder, 1)
	Util.create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), Parent = chip })
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chip,
	})
	local icon = makeFrame({ Name = "Icone", Active = false, Size = UDim2.fromOffset(22, 16), LayoutOrder = 1, Parent = chip })
	drawTypeIcon(icon, state.type)
	makeLabel({
		Text = "＋ " .. (GuiDoc.TYPE_LABELS[state.type] or state.type),
		Font = Theme.Fonts.UIBold,
		TextSize = ts(12),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 2,
		Parent = chip,
	})
	state.chip = chip
	anim("popIn", chip, 0.85)
end

function GuiEditor:_updateTileDrag(state, p)
	local chip = state.chip
	if chip ~= nil and chip.Parent ~= nil then
		local origin = chip.Parent.AbsolutePosition
		chip.Position = UDim2.fromOffset(p.X - origin.X + 14, p.Y - origin.Y + 12)
	end
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		return
	end
	local loc = self:_toScreenLocal(p)
	if not self:_insideScreen(loc, 0) then
		self.ghost.Visible = false
		self:_showDropTarget(nil)
		return
	end
	self:_showDropTarget(self:_containerAt(loc.X, loc.Y, nil))
	local size = GuiDoc.DEFAULT_SIZE[state.type] or { 200, 60 }
	local w = size[1] * S.w / REF_W
	local h = size[2] * S.h / REF_H
	placeBox(self.ghost, loc.X - w / 2, loc.Y - h / 2, w, h)
	self.ghostLabel.Text = GuiDoc.TYPE_LABELS[state.type] or state.type
	self.ghost.Visible = true
end

function GuiEditor:_endTileDrag(state)
	if state.chip ~= nil then
		pcall(function()
			state.chip:Destroy()
		end)
		state.chip = nil
	end
	self.ghost.Visible = false
	self:_showDropTarget(nil)
end

function GuiEditor:_dropTile(state, p)
	if self.doc == nil then
		-- pas encore d'écran : on en crée un, l'élément va au milieu
		if Util.pointInGui(p, self.previewRoot) then
			self:newScreen()
			self:_addElementCenter(state.type, false)
		end
		return
	end
	local loc = self:_toScreenLocal(p)
	if not self:_insideScreen(loc, 4) then
		if Util.pointInGui(p, self.previewRoot) then
			self:_status("Lâche l'élément sur l'écran pour l'ajouter.", "info")
		end
		return
	end
	self:_addElementAt(state.type, self:_containerAt(loc.X, loc.Y, nil), loc)
end

-- Nouvel élément centré sur loc (pixels relatifs à l'écran), dans parentId (nil = l'écran)
function GuiEditor:_addElementAt(elementType, parentId, loc)
	local doc, S = self.doc, self._screen
	if doc == nil or S.w <= 0 then
		return self:_addElementCenter(elementType, parentId or false)
	end
	local px, py, pw, ph = 0, 0, S.w, S.h
	if parentId ~= nil and doc:get(parentId) ~= nil then
		px, py, pw, ph = doc:absRect(parentId, S.w, S.h)
	else
		parentId = nil
	end
	local x = (loc.X - px) / math.max(pw, 1e-6)
	local y = (loc.Y - py) / math.max(ph, 1e-6)
	return self:_finishAdd(elementType, parentId, x, y)
end

-- Nouvel élément au milieu. parentId : nil = dans le cadre sélectionné s'il y en a un,
-- false = directement sur l'écran
function GuiEditor:_addElementCenter(elementType, parentId)
	if self.doc == nil then
		self:newScreen()
	end
	local doc = self.doc
	if doc == nil then
		return nil
	end
	if parentId == false then
		parentId = nil
	elseif parentId == nil and #self._sel == 1 then
		local el = doc:get(self._sel[1])
		if el ~= nil and GuiDoc.PARENT_TYPES[el.type] then
			parentId = el.id
		end
	end
	if parentId ~= nil and doc:get(parentId) == nil then
		parentId = nil
	end
	-- au milieu, un peu décalé si un élément du même type y est déjà
	local x, y = 0.5, 0.5
	for _ = 1, 12 do
		local taken = false
		for _, sid in ipairs(doc:children(parentId)) do
			local s = doc:get(sid)
			if s ~= nil and s.type == elementType and math.abs(s.x - x) < 0.005 and math.abs(s.y - y) < 0.005 then
				taken = true
				break
			end
		end
		if not taken then
			break
		end
		x += 0.03
		y += 0.03
	end
	return self:_finishAdd(elementType, parentId, x, y)
end

function GuiEditor:_finishAdd(elementType, parentId, x, y)
	local doc = self.doc
	local id = doc:add(elementType, parentId, x, y, nil, nil, nil)
	if id == nil then
		self:_toast("Impossible d'ajouter cet élément ici.", "error")
		return nil
	end
	self._popAfterBuild = id
	doc:commit("ajouter")
	self:_setSelection({ id })
	local el = doc:get(id)
	local done = "ajouté"
	if FEMININE[elementType] then
		done = "ajoutée"
	end
	local text = (GuiDoc.TYPE_LABELS[elementType] or "Élément") .. " « " .. el.name .. " » " .. done
	if parentId ~= nil and doc:get(parentId) ~= nil then
		text = text .. " dans « " .. doc:get(parentId).name .. " »"
	end
	self:_status(text .. ". Ses réglages sont à droite ; clic droit pour plus d'options.", "success")
	return id
end

---------------------------------------------------------------------------
-- Clavier (si la fenêtre du plugin le reçoit) : flèches = déplacer de 1 px (Maj : 10)
---------------------------------------------------------------------------

function GuiEditor:_onKey(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local dir = ARROWS[input.KeyCode]
	if dir == nil or self._tracking ~= nil or self._previewing or self.doc == nil or #self._sel == 0 then
		return
	end
	local focused = nil
	pcall(function()
		focused = UserInputService:GetFocusedTextBox()
	end)
	if focused ~= nil then
		return
	end
	local step = 1
	if self:_modifier("shift") then
		step = 10
	end
	self:_nudge(dir * step)
end

-- Déplace la sélection de delta (px de référence)
function GuiEditor:_nudge(delta)
	local doc = self.doc
	local moved = 0
	for _, id in ipairs(self:_topSelection()) do
		if self:_canMove(id) then
			local el = doc:get(id)
			local _, _, pw, ph = self:_parentRef(id)
			doc:setRect(id, el.x + delta.X / pw, el.y + delta.Y / ph, nil, nil)
			moved += 1
		end
	end
	if moved > 0 then
		doc:commit("deplacer")
	end
end

---------------------------------------------------------------------------
-- Sélection (le dernier élément de la liste est le principal : propriétés, poignées)
---------------------------------------------------------------------------

function GuiEditor:_primary()
	return self._sel[#self._sel]
end

function GuiEditor:_isSelected(id)
	return id ~= nil and indexOf(self._sel, id) ~= nil
end

-- Remplace la sélection (ids inconnus ignorés). force : tout redessiner et prévenir quand même.
function GuiEditor:_setSelection(ids, force)
	local doc = self.doc
	local clean, seen = {}, {}
	if doc ~= nil and type(ids) == "table" then
		for _, id in ipairs(ids) do
			if type(id) == "string" and not seen[id] and doc:get(id) ~= nil then
				seen[id] = true
				table.insert(clean, id)
			end
		end
	end
	local same = #clean == #self._sel
	if same then
		for i, id in ipairs(clean) do
			if self._sel[i] ~= id then
				same = false
				break
			end
		end
	end
	self._sel = clean
	if same and not force then
		return
	end
	local oldPrimary = self._lastPrimary
	local primary = self:_primary()
	self._lastPrimary = primary
	self:_styleLayerRows()
	self:_refreshProps(false)
	self:_updateOverlay()
	if primary ~= oldPrimary then
		if primary ~= nil and self._tracking == nil then
			anim("fadeIn", self.selFrame, 0.12)
		end
		self:_revealLayer(primary)
	end
	if primary ~= oldPrimary or force then
		self.SelectionChanged:Fire(primary)
	end
end

function GuiEditor:_toggleSelected(id)
	local list = table.clone(self._sel)
	local i = indexOf(list, id)
	if i ~= nil then
		table.remove(list, i)
	else
		table.insert(list, id)
	end
	self:_setSelection(list)
end

function GuiEditor:_makePrimary(id)
	local list = table.clone(self._sel)
	local i = indexOf(list, id)
	if i == nil or i == #list then
		return
	end
	table.remove(list, i)
	table.insert(list, id)
	self:_setSelection(list)
end

-- Sélection sans les éléments dont un ancêtre est aussi sélectionné
function GuiEditor:_topSelection()
	local out = {}
	local doc = self.doc
	if doc == nil then
		return out
	end
	for _, id in ipairs(self._sel) do
		local covered = false
		for _, other in ipairs(self._sel) do
			if other ~= id and doc:isAncestor(other, id) then
				covered = true
				break
			end
		end
		if not covered and doc:get(id) ~= nil then
			table.insert(out, id)
		end
	end
	return out
end

-- Les éléments visés par une action : toute la sélection si id en fait partie, sinon id seul
function GuiEditor:_actionIds(id)
	if #self._sel > 1 and self:_isSelected(id) then
		return self:_topSelection()
	end
	return { id }
end

function GuiEditor:_selectAll()
	if self.doc ~= nil then
		self:_setSelection(self.doc:children(nil))
	end
end

---------------------------------------------------------------------------
-- Calques (arbre des éléments)
---------------------------------------------------------------------------

function GuiEditor:_renderLayers()
	if self._destroyed then
		return
	end
	disconnectAll(self._layerConns)
	self._layerRows = {}
	for _, child in ipairs(self.layersFrame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local doc = self.doc
	if doc == nil then
		makeLabel({
			Text = "Aucun écran ouvert.",
			TextSize = ts(12),
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 24),
			Parent = self.layersFrame,
		})
		return
	end
	local count = 0
	local function nextOrder()
		count += 1
		return count
	end
	self:_layerRow({ key = "__ecran", depth = 0, name = doc.name, hasChildren = #doc.tops > 0, order = nextOrder() })
	if not self._collapsed.__ecran then
		local function walk(ids, depth)
			for _, id in ipairs(ids) do
				if count >= MAX_LAYER_ROWS then
					return
				end
				local el = doc:get(id)
				if el ~= nil then
					self:_layerRow({
						key = id,
						id = id,
						el = el,
						depth = depth,
						name = el.name,
						hasChildren = #el.children > 0,
						order = nextOrder(),
					})
					if #el.children > 0 and not self._collapsed[id] then
						walk(el.children, depth + 1)
					end
				end
			end
		end
		walk(doc.tops, 1)
		if #doc.tops == 0 then
			makeLabel({
				Text = "Glisse un élément sur l'écran pour commencer.",
				TextSize = ts(11),
				TextColor3 = C.TextDim,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = nextOrder(),
				Parent = self.layersFrame,
			})
		end
	end
	self:_styleLayerRows()
	if self._revealPending then
		self._revealPending = false
		self:_revealLayer(self:_primary())
	end
end

function GuiEditor:_layerRow(r)
	local conns = self._layerConns
	local row = makeButton({
		Name = "Calque",
		BackgroundColor3 = C.ButtonHover,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = r.order,
		Parent = self.layersFrame,
	})
	Util.corner(row, 6)
	local bar = makeFrame({
		Name = "Marque",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Accent,
		Size = UDim2.new(0, 3, 1, 0),
		Visible = false,
		Parent = row,
	})
	local indent = 6 + r.depth * 16
	if r.hasChildren then
		local rotation = 0
		if self._collapsed[r.key] then
			rotation = -90
		end
		local arrow = makeButton({
			Name = "Replier",
			Text = "▼",
			Font = Theme.Fonts.UI,
			TextSize = ts(9),
			TextColor3 = C.TextDim,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(indent - 1, 0),
			Size = UDim2.fromOffset(16, 26),
			Rotation = rotation,
			Parent = row,
		})
		self:_conn(arrow.MouseButton1Click, function()
			if self._collapsed[r.key] then
				self._collapsed[r.key] = nil
			else
				self._collapsed[r.key] = true
			end
			self:_renderLayers()
		end, conns)
	end
	local label = makeLabel({
		Name = "Nom",
		Text = r.name,
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(indent + 17, 0),
		Size = UDim2.new(1, -(indent + 17 + 22), 1, 0),
		Parent = row,
	})
	local dot = makeFrame({
		Name = "Lien",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.LinkHighlight,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(7, 7),
		Visible = false,
		Parent = row,
	})
	Util.corner(dot, 4)
	local entry = {
		row = row,
		bar = bar,
		label = label,
		dot = dot,
		key = r.key,
		id = r.id,
		name = r.name,
		hidden = r.el ~= nil and not r.el.visible,
		hover = false,
	}
	if entry.hidden then
		label.Text = r.name .. "  (caché)"
	end
	self._layerRows[r.key] = entry
	self:_conn(row.MouseEnter, function()
		entry.hover = true
		self:_styleLayerRow(entry)
		if r.id ~= nil then
			self:_setHover(r.id)
		end
	end, conns)
	self:_conn(row.MouseLeave, function()
		entry.hover = false
		self:_styleLayerRow(entry)
		if r.id ~= nil and self._hoverId == r.id then
			self:_setHover(nil)
		end
	end, conns)
	self:_conn(row.MouseButton1Click, function()
		self:_onLayerClick(entry)
	end, conns)
	self:_conn(row.MouseButton2Click, function()
		self:_onLayerContext(entry)
	end, conns)
end

function GuiEditor:_styleLayerRow(entry)
	if entry.row.Parent == nil then
		return
	end
	local selected
	if entry.key == "__ecran" then
		selected = #self._sel == 0
	else
		selected = self:_isSelected(entry.id)
	end
	entry.bar.Visible = selected
	if selected then
		entry.row.BackgroundTransparency = 0
		entry.row.BackgroundColor3 = C.ButtonHover
		entry.label.TextColor3 = C.Text
		entry.label.Font = Theme.Fonts.UIBold
	else
		if entry.hover then
			entry.row.BackgroundTransparency = 0
			entry.row.BackgroundColor3 = C.Button
		else
			entry.row.BackgroundTransparency = 1
		end
		if entry.hidden then
			entry.label.TextColor3 = C.TextDisabled
		else
			entry.label.TextColor3 = C.TextSoft
		end
		entry.label.Font = Theme.Fonts.UI
	end
	entry.dot.Visible = entry.key ~= "__ecran" and self._links[entry.name] ~= nil
end

function GuiEditor:_styleLayerRows()
	for _, entry in pairs(self._layerRows) do
		self:_styleLayerRow(entry)
	end
end

-- Fait défiler les calques jusqu'à la ligne de id (nil = la ligne de l'écran)
function GuiEditor:_revealLayer(id)
	local entry = self._layerRows[id or "__ecran"]
	if entry == nil or entry.row.Parent == nil then
		self._revealPending = true
		return
	end
	task.defer(function()
		local row = entry.row
		local scroll = self.leftRoot
		if self._destroyed or row.Parent == nil or scroll == nil then
			return
		end
		local top = row.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y
		local viewH = scroll.AbsoluteWindowSize.Y
		local y = scroll.CanvasPosition.Y
		if top < y + 4 then
			y = top - 8
		elseif top + 26 > y + viewH - 4 then
			y = top + 26 - viewH + 8
		else
			return
		end
		scroll.CanvasPosition = Vector2.new(0, math.max(0, y))
	end)
end

function GuiEditor:_onLayerClick(entry)
	if self._destroyed or self._tracking ~= nil then
		return
	end
	local now = os.clock()
	local last = self._lastLayerClick
	self._lastLayerClick = { key = entry.key, time = now }
	local double = last ~= nil and last.key == entry.key and now - last.time <= DOUBLE_CLICK
	if entry.key == "__ecran" then
		self:_setSelection({})
		if double then
			self._lastLayerClick = nil
			self:_renameScreenPrompt()
		end
		return
	end
	if double then
		self._lastLayerClick = nil
		self:_setSelection({ entry.id })
		self:_renamePrompt(entry.id)
		return
	end
	if self:_modifier("shift") or self:_modifier("ctrl") then
		self:_toggleSelected(entry.id)
		return
	end
	self:_setSelection({ entry.id })
end

function GuiEditor:_onLayerContext(entry)
	if self._destroyed or self._tracking ~= nil or self.doc == nil then
		return
	end
	if entry.key == "__ecran" then
		self:_openScreenMenu(nil, nil)
		return
	end
	if not self:_isSelected(entry.id) then
		self:_setSelection({ entry.id })
	end
	if #self._sel > 1 then
		self:_openSelectionMenu(entry.id)
	else
		self:_openElementMenu(entry.id)
	end
end

---------------------------------------------------------------------------
-- Menus du clic droit (« comme sur le bureau de Windows », SPEC §33)
---------------------------------------------------------------------------

-- Texte du menu « modifier » selon le type (nil : pas de ligne)
local function editLabelOf(elementType)
	if elementType == "texte" or elementType == "bouton" or elementType == "barre" then
		return "Modifier le texte…"
	elseif elementType == "champ" then
		return "Modifier le texte d'aide…"
	elseif elementType == "image" then
		return "Changer l'image…"
	end
	return nil
end

function GuiEditor:_onPreviewContext()
	if self._destroyed or self._tracking ~= nil or self._previewing or self.doc == nil then
		return
	end
	local loc = self:_toScreenLocal(self:_mouse())
	local id = self:_hitTest(loc)
	if id ~= nil then
		-- comme Windows : le clic droit sélectionne d'abord ce qui est sous la souris
		if not self:_isSelected(id) then
			self:_setSelection({ id })
		end
		if #self._sel > 1 then
			self:_openSelectionMenu(id)
		else
			self:_openElementMenu(id)
		end
		return
	end
	if self:_insideScreen(loc, 0) then
		self:_openScreenMenu(loc, Vector2.new(loc.X * REF_W / self._screen.w, loc.Y * REF_H / self._screen.h))
	else
		self:_openScreenMenu(nil, nil)
	end
end

-- Menu d'un élément (§21.8 + §33)
function GuiEditor:_openElementMenu(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	local parent = el.parent and doc:get(el.parent)
	local siblings = doc:children(el.parent)
	local index = indexOf(siblings, id) or 1
	local layoutParent = self:_layoutParentOf(id)
	local descendants = #doc:descendants(id)
	local clip = self:_clipboardData()
	local links = self:_linksOf(el.name)
	local clickHat = nil
	if el.type == "bouton" then
		clickHat = self:_findClickHat(el.name)
	end
	local linkItems = {}
	for i, entry in ipairs(links) do
		if i > 8 then
			break
		end
		table.insert(linkItems, {
			label = entry.text,
			icon = "◆",
			onChoose = function()
				self:_focusBlock(entry.rootId)
			end,
		})
	end
	local parentName = parent and parent.name or ""
	local editLabel = editLabelOf(el.type)
	local deleteHint = nil
	if descendants > 0 then
		deleteHint = "+ " .. tostring(descendants) .. " dedans"
	end
	local items = {
		{ label = "Couper", value = "couper" },
		{ label = "Copier", value = "copier" },
		{ label = "Coller", value = "coller", disabled = clip == nil, hint = self:_clipHint(clip) },
		{ label = "Dupliquer", value = "dupliquer", icon = "＋" },
		"separator",
		{ label = "Sélectionner uniquement cet élément", value = "seul", icon = "◎" },
		{ label = "Sélectionner « " .. parentName .. " »", value = "parent", hidden = parent == nil },
		{
			label = "Sélectionner ce qu'il contient",
			value = "contenu",
			hidden = #el.children == 0,
			hint = tostring(#el.children),
		},
		"separator",
		{ label = "Renommer…", value = "renommer" },
		{ label = editLabel or "", value = "modifier", hint = "double-clic", hidden = editLabel == nil },
		"separator",
		{ label = "Mettre devant", value = "devant", disabled = index >= #siblings },
		{ label = "Mettre derrière", value = "derriere", disabled = index <= 1 },
		{
			label = "Disposition",
			submenu = {
				{ label = "Tout devant", value = "toutdevant", disabled = index >= #siblings },
				{ label = "Tout derrière", value = "toutderriere", disabled = index <= 1 },
				"separator",
				{ label = "Centrer horizontalement", value = "centreh", disabled = layoutParent ~= nil },
				{ label = "Centrer verticalement", value = "centrev", disabled = layoutParent ~= nil },
				{ label = "Centrer au milieu", value = "centre", disabled = layoutParent ~= nil },
				"separator",
				{ label = "Sortir de « " .. parentName .. " »", value = "sortir", hidden = parent == nil },
			},
		},
		{ label = "Visible au démarrage", value = "visible", checked = el.visible == true },
		"separator",
		{
			label = (clickHat ~= nil and "Voir le script au clic") or "Ajouter un script au clic",
			value = "script",
			icon = "◆",
			hidden = el.type ~= "bouton",
		},
		{
			label = "Blocs de cet élément",
			submenu = linkItems,
			hidden = #linkItems == 0,
			hint = tostring(#links),
		},
		self:_wikiMenuItem(el.type),
		"separator",
		{ label = "Supprimer", value = "supprimer", icon = "×", danger = true, hint = deleteHint },
	}
	self:_menu(items, function(value)
		self:_runElementAction(value, id)
	end)
end

function GuiEditor:_runElementAction(value, id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	if value == "couper" then
		self:_cut(self:_actionIds(id))
	elseif value == "copier" then
		self:_copy(self:_actionIds(id))
	elseif value == "coller" then
		self:_pasteNear(id)
	elseif value == "dupliquer" then
		self:_duplicate(self:_actionIds(id))
	elseif value == "seul" then
		self:_setSelection({ id })
	elseif value == "parent" then
		if el.parent ~= nil then
			self:_setSelection({ el.parent })
		end
	elseif value == "contenu" then
		self:_setSelection(doc:children(id))
	elseif value == "renommer" then
		self:_renamePrompt(id)
	elseif value == "modifier" then
		self:_editElement(id)
	elseif value == "devant" then
		self:_reorder(id, 1)
	elseif value == "derriere" then
		self:_reorder(id, -1)
	elseif value == "toutdevant" then
		self:_reorder(id, 100000)
	elseif value == "toutderriere" then
		self:_reorder(id, -100000)
	elseif value == "centreh" then
		self:_centerElements({ id }, true, false)
	elseif value == "centrev" then
		self:_centerElements({ id }, false, true)
	elseif value == "centre" then
		self:_centerElements({ id }, true, true)
	elseif value == "sortir" then
		self:_moveOut(id)
	elseif value == "visible" then
		self:_toggleVisible({ id })
	elseif value == "script" then
		self:addClickScript(id)
	elseif value == "wiki_page" then
		self:_openWiki(nil)
	elseif value == "wiki_bloc" then
		self:_openWiki(WIKI_BLOCKS[el.type])
	elseif value == "supprimer" then
		self:_deleteWithConfirm(self:_actionIds(id))
	end
end

-- Menu de plusieurs éléments sélectionnés
function GuiEditor:_openSelectionMenu(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	local ids = self:_topSelection()
	local n = #ids
	local movable = 0
	local allVisible = true
	for _, sid in ipairs(ids) do
		if self:_canMove(sid) then
			movable += 1
		end
		local e = doc:get(sid)
		if e ~= nil and not e.visible then
			allVisible = false
		end
	end
	local countHint = tostring(n) .. " éléments"
	local items = {
		{ label = "Couper la sélection", value = "couper" },
		{ label = "Copier la sélection", value = "copier", hint = countHint },
		{ label = "Dupliquer la sélection", value = "dupliquer", icon = "＋" },
		"separator",
		{ label = "Sélectionner uniquement « " .. el.name .. " »", value = "seul", icon = "◎" },
		{ label = "Tout sélectionner", value = "tout" },
		"separator",
		{
			label = "Aligner",
			disabled = movable < 2,
			submenu = {
				{ label = "À gauche", value = "align:gauche" },
				{ label = "Au centre", value = "align:centre" },
				{ label = "À droite", value = "align:droite" },
				"separator",
				{ label = "En haut", value = "align:haut" },
				{ label = "Au milieu", value = "align:milieu" },
				{ label = "En bas", value = "align:bas" },
			},
		},
		{ label = "Visible au démarrage", value = "visible", checked = allVisible },
		"separator",
		{ label = "Supprimer la sélection", value = "supprimer", icon = "×", danger = true, hint = countHint },
	}
	self:_menu(items, function(value)
		if self.doc ~= doc then
			return
		end
		local current = self:_topSelection()
		if value == "couper" then
			self:_cut(current)
		elseif value == "copier" then
			self:_copy(current)
		elseif value == "dupliquer" then
			self:_duplicate(current)
		elseif value == "seul" then
			self:_setSelection({ id })
		elseif value == "tout" then
			self:_selectAll()
		elseif value == "visible" then
			self:_toggleVisible(current)
		elseif value == "supprimer" then
			self:_deleteWithConfirm(current)
		elseif type(value) == "string" and string.sub(value, 1, 6) == "align:" then
			self:_align(current, string.sub(value, 7))
		end
	end)
end

-- Menu du fond de l'écran (loc = pixels relatifs à l'écran, refPoint = px de référence ; nil :
-- menu ouvert depuis les calques)
function GuiEditor:_openScreenMenu(loc, refPoint)
	local doc = self.doc
	if doc == nil then
		return
	end
	local count = 0
	for _ in pairs(doc.elements) do
		count += 1
	end
	local clip = self:_clipboardData()
	local addItems = {}
	for _, t in ipairs(GuiDoc.TYPES) do
		table.insert(addItems, { label = GuiDoc.TYPE_LABELS[t] or t, value = "ajouter:" .. t })
	end
	local deviceItems = {}
	for _, key in ipairs(DEVICE_ORDER) do
		table.insert(deviceItems, { label = DEVICES[key].label, value = "appareil:" .. key, checked = self._device == key })
	end
	local here = loc ~= nil
	local countHint = nil
	if count > 0 then
		countHint = tostring(count)
	end
	local items = {
		{ label = (here and "Coller ici") or "Coller", value = "coller", disabled = clip == nil, hint = self:_clipHint(clip) },
		{ label = (here and "Ajouter ici") or "Ajouter un élément", icon = "＋", submenu = addItems },
		"separator",
		{ label = "Tout sélectionner", value = "tout", disabled = count == 0, hint = countHint },
		{ label = "Désélectionner", value = "aucun", hidden = #self._sel == 0 },
		"separator",
		{ label = "Appareil", submenu = deviceItems },
		{ label = "Décor de jeu derrière l'écran", value = "decor", checked = self._decor },
		{ label = "Aperçu (essayer les boutons)", value = "apercu" },
		"separator",
		{ label = "Annuler", value = "annuler", disabled = not doc:canUndo() },
		{ label = "Refaire", value = "refaire", disabled = not doc:canRedo() },
		"separator",
		{ label = "Propriétés de l'écran", value = "proprietes" },
		{ label = "Renommer l'écran…", value = "renommer" },
		{ label = "Ouvrir dans le wiki", value = "wiki", icon = "≡" },
		"separator",
		{ label = "Tout effacer", value = "effacer", danger = true, disabled = count == 0 },
	}
	self:_menu(items, function(value)
		if self.doc ~= doc then
			return
		end
		if value == "coller" then
			local parentId = nil
			if loc ~= nil then
				parentId = self:_containerAt(loc.X, loc.Y, nil)
			end
			self:_paste(parentId, refPoint)
		elseif type(value) == "string" and string.sub(value, 1, 8) == "ajouter:" then
			local elementType = string.sub(value, 9)
			if loc ~= nil and self:_insideScreen(loc, 0) then
				self:_addElementAt(elementType, self:_containerAt(loc.X, loc.Y, nil), loc)
			else
				self:_addElementCenter(elementType, false)
			end
		elseif value == "tout" then
			self:_selectAll()
		elseif value == "aucun" then
			self:_setSelection({})
		elseif type(value) == "string" and string.sub(value, 1, 9) == "appareil:" then
			self:setDevice(string.sub(value, 10))
		elseif value == "decor" then
			self._decor = not self._decor
			self:_applyDecor()
		elseif value == "apercu" then
			self:_setPreviewing(true)
		elseif value == "annuler" then
			self:undo()
		elseif value == "refaire" then
			self:redo()
		elseif value == "proprietes" then
			self:_setSelection({})
		elseif value == "renommer" then
			self:_renameScreenPrompt()
		elseif value == "wiki" then
			self:_openWiki(nil)
		elseif value == "effacer" then
			self:_clearAll()
		end
	end)
end

-- Clic sur un modèle (panneau de gauche) : écran vide -> directement ; sinon on demande
function GuiEditor:_onTemplateClick(entry)
	local doc = self.doc
	if doc == nil or (#doc.tops == 0 and not self:isDirty()) then
		self:_request("modele", entry.id)
		return
	end
	self:_templateMenu(entry)
end

function GuiEditor:_templateMenu(entry)
	local doc = self.doc
	local screenHint = nil
	if entry.screen ~= nil then
		screenHint = "« " .. tostring(entry.screen) .. " »"
	end
	local addLabel = "Ajouter ses éléments à l'écran"
	if doc ~= nil then
		addLabel = "Ajouter ses éléments à « " .. doc.name .. " »"
	end
	local items = {
		{ label = "Nouvel écran avec ce modèle", value = "nouveau", icon = "＋", hint = screenHint },
		{ label = addLabel, value = "ajouter", disabled = doc == nil, hint = "sans ses blocs" },
		"separator",
		{ label = "Ouvrir dans le wiki", value = "wiki", icon = "≡" },
	}
	self:_menu(items, function(value)
		if value == "nouveau" then
			self:_request("modele", entry.id)
		elseif value == "ajouter" then
			self:_mergeTemplate(entry)
		elseif value == "wiki" then
			self:_openWiki(nil)
		end
	end)
end

-- Clic droit sur une tuile « Éléments »
function GuiEditor:_tileMenu(elementType)
	local container = nil
	if self.doc ~= nil and #self._sel == 1 then
		local el = self.doc:get(self._sel[1])
		if el ~= nil and GuiDoc.PARENT_TYPES[el.type] then
			container = el
		end
	end
	local defId = WIKI_BLOCKS[elementType]
	local items = {
		{ label = "Ajouter au milieu de l'écran", value = "milieu", icon = "＋" },
		{
			label = "Ajouter dans « " .. ((container and container.name) or "") .. " »",
			value = "dans",
			hidden = container == nil,
		},
		"separator",
		{ label = "Ouvrir dans le wiki", value = "wiki", icon = "≡" },
	}
	self:_menu(items, function(value)
		if value == "milieu" then
			self:_addElementCenter(elementType, false)
		elseif value == "dans" then
			if container ~= nil and self.doc ~= nil and self.doc:get(container.id) ~= nil then
				self:_addElementCenter(elementType, container.id)
			end
		elseif value == "wiki" then
			self:_openWiki(defId)
		end
	end)
end

-- « Ouvrir dans le wiki » : la page du Studio d'interface et la fiche du bloc de ce type d'élément
function GuiEditor:_wikiMenuItem(elementType)
	local page = self:_wikiPageId()
	local defId = WIKI_BLOCKS[elementType]
	local blockItem = nil
	if defId ~= nil and Registry ~= nil then
		local ok, def = pcall(Registry.get, defId)
		if ok and type(def) == "table" then
			local label = def.id
			pcall(function()
				label = Registry.plainLabel(def)
			end)
			blockItem = { label = "Le bloc « " .. tostring(label) .. " »", value = "wiki_bloc" }
		end
	end
	if page ~= nil and blockItem ~= nil then
		return {
			label = "Ouvrir dans le wiki",
			icon = "≡",
			submenu = { { label = "Le Studio d'interface", value = "wiki_page" }, blockItem },
		}
	elseif page ~= nil then
		return { label = "Ouvrir dans le wiki", icon = "≡", value = "wiki_page" }
	end
	return { label = "Ouvrir dans le wiki", icon = "≡", value = "wiki_bloc" }
end

-- Page « Studio d'interface » du wiki (cherchée une fois dans WikiContent), ou nil
function GuiEditor:_wikiPageId()
	if wikiPageCache ~= nil then
		if wikiPageCache == false then
			return nil
		end
		return wikiPageCache
	end
	wikiPageCache = false
	local content = optional("WikiContent")
	if type(content) ~= "table" or type(content.sections) ~= "table" then
		return nil
	end
	for _, section in ipairs(content.sections) do
		if type(section) == "table" and type(section.pages) == "table" then
			for _, page in ipairs(section.pages) do
				if type(page) == "table" and type(page.id) == "string" then
					local title = Util.fold(tostring(page.title or ""))
					if
						page.id == "studio_interface"
						or string.find(title, "studio d'interface", 1, true) ~= nil
						or string.find(title, "studio d interface", 1, true) ~= nil
					then
						wikiPageCache = page.id
						return page.id
					end
				end
			end
		end
	end
	return nil
end

-- Ouvre le wiki : la fiche du bloc defId, sinon la page du Studio d'interface (ou l'accueil)
function GuiEditor:_openWiki(defId)
	local fn = self.host.openWiki
	if type(fn) ~= "function" then
		self:_toast("Le wiki n'est pas disponible pour le moment.", "warning")
		return
	end
	local ok, result
	if defId ~= nil then
		ok, result = pcall(fn, nil, defId)
	else
		ok, result = pcall(fn, self:_wikiPageId(), nil)
	end
	if not ok or result == false then
		self:_toast("Le wiki n'a pas pu s'ouvrir.", "warning")
	end
end

---------------------------------------------------------------------------
-- Actions sur les éléments
---------------------------------------------------------------------------

-- Copie (en données) des éléments ids et de tout ce qu'ils contiennent, avec leur rectangle en px
-- de référence : { type, name, fields = { champs GuiDoc }, rect = { x, y, l, h }, children = { … } }
function GuiEditor:_exportItems(doc, ids)
	local items = {}
	local function export(id, depth)
		local el = doc:get(id)
		if el == nil or depth > 64 then
			return nil
		end
		local fields = {}
		for key, spec in pairs(GuiDoc.FIELDS) do
			local value = el[key]
			if value == nil then
				if spec.optional then
					fields[key] = false
				end
			elseif type(value) == "table" then
				fields[key] = { value[1], value[2], value[3] }
			else
				fields[key] = value
			end
		end
		local node = {
			type = el.type,
			name = el.name,
			fields = fields,
			rect = { doc:absRect(id, REF_W, REF_H) },
			children = {},
		}
		for _, childId in ipairs(el.children) do
			local child = export(childId, depth + 1)
			if child ~= nil then
				table.insert(node.children, child)
			end
		end
		return node
	end
	for _, id in ipairs(ids) do
		local node = export(id, 0)
		if node ~= nil then
			table.insert(items, node)
		end
	end
	return items
end

-- Ajoute un élément copié (et ses enfants). absRect = rectangle voulu en px de référence (nil :
-- garder les fractions copiées, pour les enfants). Renvoie l'id ou nil.
function GuiEditor:_addTree(doc, item, parentId, absRect, depth)
	if depth > 64 or type(item) ~= "table" or not TYPE_SET[item.type] then
		return nil
	end
	local fields = {}
	if type(item.fields) == "table" then
		for key, value in pairs(item.fields) do
			if type(key) == "string" and GuiDoc.FIELDS[key] ~= nil then
				fields[key] = value
			end
		end
	end
	fields.name = item.name
	local x, y, w, h = fields.x, fields.y, fields.w, fields.h
	if absRect ~= nil then
		local px, py, pw, ph = 0, 0, REF_W, REF_H
		if parentId ~= nil and doc:get(parentId) ~= nil then
			px, py, pw, ph = doc:absRect(parentId, REF_W, REF_H)
		end
		pw = math.max(pw, 1e-6)
		ph = math.max(ph, 1e-6)
		local ax = math.clamp(tonumber(fields.ax) or 0.5, 0, 1)
		local ay = math.clamp(tonumber(fields.ay) or 0.5, 0, 1)
		x = (absRect[1] + ax * absRect[3] - px) / pw
		y = (absRect[2] + ay * absRect[4] - py) / ph
		w = absRect[3] / pw
		h = absRect[4] / ph
	end
	local id = doc:add(item.type, parentId, x, y, w, h, fields)
	if id == nil then
		return nil
	end
	if GuiDoc.PARENT_TYPES[item.type] and type(item.children) == "table" then
		for _, child in ipairs(item.children) do
			self:_addTree(doc, child, id, nil, depth + 1)
		end
	end
	return id
end

-- Le presse-papiers des éléments (partagé entre les écrans et les sessions), ou nil
function GuiEditor:_clipboardData()
	local json = self:_getSetting(CLIPBOARD_KEY)
	if type(json) ~= "string" or json == "" then
		json = memoryClipboard
	end
	if type(json) ~= "string" or json == "" then
		return nil, nil
	end
	if clipboardCache.json == json then
		return clipboardCache.data, json
	end
	local data = nil
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if ok and type(decoded) == "table" and decoded.format == CLIPBOARD_FORMAT and type(decoded.items) == "table" and decoded.items[1] ~= nil then
		data = decoded
	end
	clipboardCache.json = json
	clipboardCache.data = data
	return data, json
end

function GuiEditor:_clipHint(data)
	if data == nil then
		return nil
	end
	local n = #data.items
	if n == 1 and type(data.items[1]) == "table" then
		return "« " .. tostring(data.items[1].name) .. " »"
	end
	return tostring(n) .. " éléments"
end

function GuiEditor:_copy(ids)
	local doc = self.doc
	if doc == nil or #ids == 0 then
		return false
	end
	local items = self:_exportItems(doc, ids)
	if #items == 0 then
		return false
	end
	local ok, json = pcall(function()
		return HttpService:JSONEncode({ format = CLIPBOARD_FORMAT, version = 1, screen = doc.name, items = items })
	end)
	if not ok or type(json) ~= "string" then
		self:_toast("Impossible de copier : " .. tostring(json), "error")
		return false
	end
	memoryClipboard = json
	self:_setSetting(CLIPBOARD_KEY, json)
	self._pasteSource = json
	self._pasteCount = 0
	if #items == 1 then
		self:_status("« " .. tostring(items[1].name) .. " » copié : clic droit → « Coller » (marche aussi dans un autre écran).", "info")
	else
		self:_status(tostring(#items) .. " éléments copiés.", "info")
	end
	return true
end

function GuiEditor:_cut(ids)
	if self:_copy(ids) then
		self:_delete(ids, "couper")
	end
end

local function validRect(r)
	if type(r) ~= "table" then
		return nil
	end
	local x, y, w, h = tonumber(r[1]), tonumber(r[2]), tonumber(r[3]), tonumber(r[4])
	if isFinite(x) and isFinite(y) and isFinite(w) and isFinite(h) and w > 0 and h > 0 then
		return { x, y, w, h }
	end
	return nil
end

-- Colle dans parentId (nil = sur l'écran). refPoint (px de référence) : centre voulu ; sinon le
-- centre du parent ; sinon la place d'origine, décalée un peu plus à chaque collage.
function GuiEditor:_paste(parentId, refPoint)
	local doc = self.doc
	if doc == nil then
		return
	end
	local data, json = self:_clipboardData()
	if data == nil then
		self:_status("Rien à coller : copie d'abord un élément (clic droit → « Copier »).", "info")
		return
	end
	if parentId ~= nil then
		local parent = doc:get(parentId)
		if parent == nil or not GuiDoc.PARENT_TYPES[parent.type] then
			parentId = nil
		end
	end
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, item in ipairs(data.items) do
		local r = type(item) == "table" and validRect(item.rect) or nil
		if r ~= nil then
			minX = math.min(minX, r[1])
			minY = math.min(minY, r[2])
			maxX = math.max(maxX, r[1] + r[3])
			maxY = math.max(maxY, r[2] + r[4])
		end
	end
	if minX == math.huge then
		self:_toast("Le presse-papiers est illisible.", "error")
		return
	end
	local cx, cy = (minX + maxX) / 2, (minY + maxY) / 2
	local dx, dy
	if refPoint ~= nil then
		dx, dy = refPoint.X - cx, refPoint.Y - cy
	elseif parentId ~= nil then
		local px, py, pw, ph = doc:absRect(parentId, REF_W, REF_H)
		dx, dy = px + pw / 2 - cx, py + ph / 2 - cy
	else
		if self._pasteSource ~= json then
			self._pasteSource = json
			self._pasteCount = 0
		end
		self._pasteCount += 1
		dx, dy = 24 * self._pasteCount, 24 * self._pasteCount
	end
	local newIds = {}
	for _, item in ipairs(data.items) do
		local r = type(item) == "table" and validRect(item.rect) or nil
		if r ~= nil then
			local id = self:_addTree(doc, item, parentId, { r[1] + dx, r[2] + dy, r[3], r[4] }, 0)
			if id ~= nil then
				table.insert(newIds, id)
			end
		end
	end
	if #newIds == 0 then
		self:_toast("Impossible de coller ces éléments ici.", "error")
		return
	end
	doc:commit("coller")
	self:_setSelection(newIds)
	if #newIds == 1 then
		self:_status("« " .. doc:get(newIds[1]).name .. " » collé.", "success")
	else
		self:_status(tostring(#newIds) .. " éléments collés.", "success")
	end
end

-- « Coller » du menu d'un élément : dans le cadre cliqué, sinon juste à côté de l'élément
function GuiEditor:_pasteNear(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	if GuiDoc.PARENT_TYPES[el.type] then
		self:_paste(id, nil)
		return
	end
	local x, y, w, h = doc:absRect(id, REF_W, REF_H)
	self:_paste(el.parent, Vector2.new(x + w / 2 + 24, y + h / 2 + 24))
end

function GuiEditor:_duplicate(ids)
	local doc = self.doc
	if doc == nil then
		return
	end
	local newIds = {}
	for _, id in ipairs(ids) do
		local newId = doc:duplicate(id)
		if newId ~= nil then
			table.insert(newIds, newId)
		end
	end
	if #newIds == 0 then
		return
	end
	doc:commit("dupliquer")
	self:_setSelection(newIds)
	if #newIds == 1 then
		self:_status("Copie « " .. doc:get(newIds[1]).name .. " » ajoutée juste à côté.", "success")
	else
		self:_status(tostring(#newIds) .. " éléments dupliqués.", "success")
	end
end

function GuiEditor:_delete(ids, reason)
	local doc = self.doc
	if doc == nil then
		return
	end
	local names = {}
	for _, id in ipairs(ids) do
		local el = doc:get(id)
		if el ~= nil then
			table.insert(names, el.name)
			doc:remove(id)
		end
	end
	if #names == 0 then
		return
	end
	doc:commit(reason or "supprimer")
	self:_setSelection({})
	if #names == 1 then
		self:_status("Élément « " .. names[1] .. " » supprimé (« Annuler » pour le récupérer).", "info")
	else
		self:_status(tostring(#names) .. " éléments supprimés (« Annuler » pour les récupérer).", "info")
	end
end

-- Supprime ; demande d'abord quand les blocs de l'écran utilisent ces éléments
function GuiEditor:_deleteWithConfirm(ids)
	local doc = self.doc
	if doc == nil or #ids == 0 then
		return
	end
	local used = 0
	local names = {}
	for _, id in ipairs(ids) do
		local all = doc:descendants(id)
		table.insert(all, 1, id)
		for _, eid in ipairs(all) do
			local e = doc:get(eid)
			local entry = e and self._links[e.name]
			if entry ~= nil then
				used += #entry.roots
				if #names < 3 then
					table.insert(names, e.name)
				end
			end
		end
	end
	local dialogs = self.dialogs
	if used == 0 or type(dialogs) ~= "table" or type(dialogs.confirm) ~= "function" then
		self:_delete(ids, "supprimer")
		return
	end
	local scripts = "1 script"
	if used > 1 then
		scripts = tostring(used) .. " scripts"
	end
	local message = "Les blocs de l'écran utilisent « "
		.. table.concat(names, " », « ")
		.. " » ("
		.. scripts
		.. "). Après la suppression, ils ne trouveront plus cet élément. Supprimer quand même ?"
	dialogs:confirm("Supprimer ?", message, function()
		if self.doc == doc then
			self:_delete(ids, "supprimer")
		end
	end, "Supprimer", "Annuler", true)
end

function GuiEditor:_reorder(id, delta)
	local doc = self.doc
	if doc ~= nil and doc:reorder(id, delta) then
		doc:commit("ordre")
	end
end

function GuiEditor:_centerElements(ids, horizontal, vertical)
	local doc = self.doc
	if doc == nil then
		return
	end
	local moved = 0
	for _, id in ipairs(ids) do
		local el = doc:get(id)
		if el ~= nil and self:_canMove(id) then
			local x, y = nil, nil
			if horizontal then
				x = 0.5 + (el.ax - 0.5) * el.w
			end
			if vertical then
				y = 0.5 + (el.ay - 0.5) * el.h
			end
			doc:setRect(id, x, y, nil, nil)
			moved += 1
		end
	end
	if moved > 0 then
		doc:commit("centrer")
	end
end

-- Sort l'élément de son cadre (il garde sa place à l'écran)
function GuiEditor:_moveOut(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil or el.parent == nil then
		return
	end
	local parentId = el.parent
	local parentName = doc:get(parentId) and doc:get(parentId).name or "?"
	local grand = doc:parentOf(parentId)
	local index = indexOf(doc:children(grand), parentId)
	local position = nil
	if index ~= nil then
		position = index + 1
	end
	if doc:setParent(id, grand, position) then
		doc:commit("ranger")
		self:_status("« " .. el.name .. " » est sorti de « " .. parentName .. " ».", "info")
	end
end

function GuiEditor:_toggleVisible(ids)
	local doc = self.doc
	if doc == nil or #ids == 0 then
		return
	end
	local allVisible = true
	for _, id in ipairs(ids) do
		local el = doc:get(id)
		if el ~= nil and not el.visible then
			allVisible = false
		end
	end
	for _, id in ipairs(ids) do
		doc:set(id, "visible", not allVisible)
	end
	doc:commit("visibilité")
	if allVisible then
		self:_status("Caché au démarrage : un bloc « montrer » le fera apparaître dans le jeu.", "info")
	end
end

-- Aligne les éléments sur le bord / le centre de leur ensemble
function GuiEditor:_align(ids, mode)
	local doc = self.doc
	if doc == nil then
		return
	end
	local rects = {}
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, id in ipairs(ids) do
		if self:_canMove(id) then
			local x, y, w, h = doc:absRect(id, REF_W, REF_H)
			rects[id] = { x, y, w, h }
			minX = math.min(minX, x)
			minY = math.min(minY, y)
			maxX = math.max(maxX, x + w)
			maxY = math.max(maxY, y + h)
		end
	end
	if minX == math.huge then
		return
	end
	local moved = 0
	for id, r in pairs(rects) do
		local nx, ny = r[1], r[2]
		if mode == "gauche" then
			nx = minX
		elseif mode == "droite" then
			nx = maxX - r[3]
		elseif mode == "centre" then
			nx = (minX + maxX) / 2 - r[3] / 2
		elseif mode == "haut" then
			ny = minY
		elseif mode == "bas" then
			ny = maxY - r[4]
		elseif mode == "milieu" then
			ny = (minY + maxY) / 2 - r[4] / 2
		end
		local el = doc:get(id)
		local px, py, pw, ph = self:_parentRef(id)
		doc:setRect(id, (nx + el.ax * r[3] - px) / pw, (ny + el.ay * r[4] - py) / ph, nil, nil)
		moved += 1
	end
	if moved > 0 then
		doc:commit("aligner")
	end
end

function GuiEditor:_clearAll()
	local doc = self.doc
	if doc == nil or #doc.tops == 0 then
		return
	end
	local function run()
		if self.doc ~= doc then
			return
		end
		for _, id in ipairs(doc:children(nil)) do
			doc:remove(id)
		end
		doc:commit("effacer")
		self:_setSelection({})
		self:_status("Écran vidé (« Annuler » pour tout récupérer).", "info")
	end
	local dialogs = self.dialogs
	if type(dialogs) == "table" and type(dialogs.confirm) == "function" then
		dialogs:confirm(
			"Tout effacer",
			"Supprimer tous les éléments de l'écran « " .. doc.name .. " » ? Tu pourras annuler.",
			run,
			"Tout effacer",
			"Annuler",
			true
		)
	else
		run()
	end
end

-- Ajoute les éléments d'un modèle à l'écran ouvert (sans ses blocs : ils visent un autre écran)
function GuiEditor:_mergeTemplate(meta)
	local doc = self.doc
	if doc == nil or GuiTemplates == nil or type(GuiTemplates.get) ~= "function" then
		return
	end
	local ok, entry = pcall(GuiTemplates.get, meta.id)
	if not ok or type(entry) ~= "table" or type(entry.doc) ~= "table" then
		self:_toast("Ce modèle est introuvable.", "error")
		return
	end
	local tdoc = GuiDoc.fromData(entry.doc)
	if tdoc == nil then
		self:_toast("Ce modèle n'a pas pu être lu.", "error")
		return
	end
	local items = self:_exportItems(tdoc, tdoc:children(nil))
	pcall(tdoc.destroy, tdoc)
	local newIds = {}
	for _, item in ipairs(items) do
		local r = validRect(item.rect)
		if r ~= nil then
			local id = self:_addTree(doc, item, nil, r, 0)
			if id ~= nil then
				table.insert(newIds, id)
			end
		end
	end
	if #newIds == 0 then
		self:_toast("Aucun élément n'a pu être ajouté.", "error")
		return
	end
	self._staggerAfterBuild = newIds
	doc:commit("modele")
	self:_setSelection(newIds)
	self:_toast("Éléments du modèle « " .. tostring(meta.title) .. " » ajoutés à « " .. doc.name .. " » (sans ses blocs).", "success")
end

---------------------------------------------------------------------------
-- Renommer, modifier le texte
---------------------------------------------------------------------------

function GuiEditor:_renamePrompt(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	local dialogs = self.dialogs
	if el == nil or type(dialogs) ~= "table" or type(dialogs.prompt) ~= "function" then
		return
	end
	dialogs:prompt(
		"Renommer l'élément",
		"Nouveau nom de « " .. el.name .. " ». Les blocs l'utilisent pour trouver l'élément : ceux de cet écran suivront.",
		el.name,
		function(text)
			if self.doc ~= doc then
				return
			end
			local ok, err = self:_renameElement(id, text)
			if not ok and err ~= nil then
				self:_toast(err, "warning")
			end
		end
	)
end

-- Renomme un élément et met à jour les blocs de l'écran qui le nomment. Renvoie ok, erreurFR.
function GuiEditor:_renameElement(id, text)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return false, "Élément introuvable."
	end
	local old = el.name
	local ok, err = doc:rename(id, text)
	if not ok then
		return false, err
	end
	if el.name == old then
		return true
	end
	doc:commit("renommer")
	local n = self:_renameReferences(old, el.name, false)
	if n > 0 then
		local blocs = "1 bloc mis à jour"
		if n > 1 then
			blocs = tostring(n) .. " blocs mis à jour"
		end
		self:_toast("« " .. old .. " » s'appelle maintenant « " .. el.name .. " » : " .. blocs .. ".", "success")
	end
	-- même élément, nouveau nom : App recalcule le contour cyan des blocs qui le nomment
	if self:_isSelected(id) then
		self.SelectionChanged:Fire(self:_primary())
	end
	return true
end

function GuiEditor:_renameScreenPrompt()
	local doc = self.doc
	local dialogs = self.dialogs
	if doc == nil or type(dialogs) ~= "table" or type(dialogs.prompt) ~= "function" then
		return
	end
	dialogs:prompt("Renommer l'écran", "Nouveau nom de l'écran « " .. doc.name .. " » :", doc.name, function(text)
		if self.doc ~= doc then
			return
		end
		local ok, err = self:_renameScreen(text)
		if not ok and err ~= nil then
			self:_toast(err, "warning")
		end
	end)
end

-- Renomme l'écran (le ScreenGui suit à l'enregistrement). Renvoie ok, erreurFR.
function GuiEditor:_renameScreen(text)
	local doc = self.doc
	if doc == nil then
		return false, "Aucun écran ouvert."
	end
	local clean, err = GuiDoc.cleanName(text)
	if clean == nil then
		return false, err
	end
	if clean == doc.name then
		return true
	end
	local existing = nil
	pcall(function()
		existing = game:GetService("StarterGui"):FindFirstChild(clean)
	end)
	if existing ~= nil and existing ~= self:getScreenGui() then
		return false, "« " .. clean .. " » existe déjà dans StarterGui : choisis un autre nom."
	end
	local old = doc.name
	local ok, setErr = doc:setName(clean)
	if not ok then
		return false, setErr
	end
	doc:commit("renommer l'écran")
	local n = self:_renameReferences(old, clean, true)
	if n > 0 then
		self:_toast("L'écran s'appelle maintenant « " .. clean .. " » : " .. tostring(n) .. " bloc(s) mis à jour.", "success")
	end
	return true
end

-- Met à jour les entrées « gui » des blocs de l'écran qui nomment old. Renvoie le nombre changé.
function GuiEditor:_renameReferences(old, new, isScreen)
	local model = self:_model()
	if model == nil or Registry == nil or old == new then
		return 0
	end
	local docName = self.doc and self.doc.name
	local prefix = old .. "/"
	local count = 0
	for blockId, block in pairs(model.blocks) do
		local okDef, def = pcall(Registry.get, block.def)
		if okDef and type(def) == "table" and type(def.inputs) == "table" then
			for _, spec in ipairs(def.inputs) do
				local input = spec.kind == "gui" and block.inputs and block.inputs[spec.name]
				local value = input and input.value
				if type(value) == "string" and input.block == nil then
					local newValue = nil
					if isScreen then
						if spec.filter == "ecran" and value == old then
							newValue = new
						elseif string.sub(value, 1, #prefix) == prefix then
							newValue = new .. "/" .. string.sub(value, #prefix + 1)
						end
					elseif spec.filter ~= "ecran" then
						if value == old then
							newValue = new
						elseif docName ~= nil and value == docName .. "/" .. old then
							newValue = docName .. "/" .. new
						end
					end
					if newValue ~= nil then
						pcall(model.setInput, model, blockId, spec.name, newValue)
						count += 1
					end
				end
			end
		end
	end
	if count > 0 then
		pcall(model.commit, model, "renommer")
	end
	return count
end

-- Double-clic : le texte (texte, bouton, barre), le texte d'aide (champ), l'image, sinon le nom
function GuiEditor:_editElement(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	local dialogs = self.dialogs
	if el == nil or type(dialogs) ~= "table" or type(dialogs.prompt) ~= "function" then
		return
	end
	local t = el.type
	local function apply(key, value, reason)
		if self.doc ~= doc or doc:get(id) == nil then
			return
		end
		if doc:set(id, key, value) then
			doc:commit(reason)
		else
			self:_toast("Valeur refusée.", "warning")
		end
	end
	if t == "texte" or t == "bouton" or t == "barre" then
		dialogs:prompt("Modifier le texte", "Texte de « " .. el.name .. " » :", el.texte, function(text)
			apply("texte", text, "texte")
		end)
	elseif t == "champ" then
		dialogs:prompt("Texte d'aide", "Texte gris affiché quand le champ « " .. el.name .. " » est vide :", el.indice, function(text)
			apply("indice", text, "texte")
		end)
	elseif t == "image" then
		dialogs:prompt("Changer l'image", "Numéro de l'image Roblox (par exemple 1234567890) :", el.image, function(text)
			local image = GuiDoc.normalizeImage(text)
			if image == nil then
				self:_toast("Colle seulement le numéro de l'image.", "warning")
				return
			end
			apply("image", image, "image")
		end)
	else
		self:_renamePrompt(id)
	end
end

---------------------------------------------------------------------------
-- Lien avec les blocs de l'écran
---------------------------------------------------------------------------

-- Le Model des blocs de l'écran (voir l'en-tête), ou nil
function GuiEditor:_model()
	local fn = self.deps.getModel
	if type(fn) ~= "function" then
		fn = self.deps.getInterfaceModel
	end
	if type(fn) == "function" then
		local ok, m = pcall(fn)
		if ok and isModel(m) then
			return m
		end
		return nil
	end
	local app = self.app
	if type(app) ~= "table" then
		return nil
	end
	if type(app.getInterfaceModel) == "function" then
		local ok, m = pcall(app.getInterfaceModel, app)
		if ok then
			if isModel(m) then
				return m
			end
			return nil
		end
	end
	if type(app.getWorkspace) == "function" then
		local ok, workspaceName = pcall(app.getWorkspace, app)
		if ok and workspaceName == "interface" and isModel(app.model) then
			return app.model
		end
	end
	for _, key in ipairs({ "sessions", "_sessions" }) do
		local sessions = rawget(app, key)
		if type(sessions) == "table" and type(sessions.interface) == "table" and isModel(sessions.interface.model) then
			return sessions.interface.model
		end
	end
	return nil
end

-- Suit le Model des blocs de l'écran (App peut le remplacer) ; force : recalcule les liens
function GuiEditor:_syncModel(force)
	if self._destroyed then
		return
	end
	local model = self:_model()
	if model ~= self._linkedModel then
		if self._linkedConn ~= nil then
			pcall(function()
				self._linkedConn:Disconnect()
			end)
			self._linkedConn = nil
		end
		self._linkedModel = model
		if model ~= nil and type(model.Changed) == "table" and type(model.Changed.Connect) == "function" then
			local ok, connection = pcall(function()
				return model.Changed:Connect(function()
					self:_schedule("links", LINKS_DELAY, function()
						self:_refreshLinks()
					end)
				end)
			end)
			if ok then
				self._linkedConn = connection
			end
		end
		self:_refreshLinks()
	elseif force then
		self:_refreshLinks()
	end
end

-- { [nomDElement] = { roots = { idPile… } (haut -> bas), rootBlock = { [idPile] = idBloc } } }
function GuiEditor:_computeLinks()
	local links = {}
	local model = self._linkedModel
	if model == nil or self.doc == nil or Registry == nil then
		return links
	end
	for blockId, block in pairs(model.blocks) do
		local okDef, def = pcall(Registry.get, block.def)
		if okDef and type(def) == "table" and type(def.inputs) == "table" then
			for _, spec in ipairs(def.inputs) do
				if spec.kind == "gui" and spec.filter ~= "ecran" then
					local input = block.inputs and block.inputs[spec.name]
					local name = nil
					if input ~= nil and input.block == nil then
						name = self:_localName(input.value)
					end
					if name ~= nil then
						local entry = links[name]
						if entry == nil then
							entry = { roots = {}, rootBlock = {} }
							links[name] = entry
						end
						local rootId = model:root(blockId) or blockId
						if entry.rootBlock[rootId] == nil then
							entry.rootBlock[rootId] = blockId
							table.insert(entry.roots, rootId)
						end
					end
				end
			end
		end
	end
	for _, entry in pairs(links) do
		table.sort(entry.roots, function(a, b)
			local ba, bb = model.blocks[a], model.blocks[b]
			local ya = (ba and tonumber(ba.y)) or 0
			local yb = (bb and tonumber(bb.y)) or 0
			if ya ~= yb then
				return ya < yb
			end
			return tostring(a) < tostring(b)
		end)
	end
	return links
end

function GuiEditor:_refreshLinks()
	if self._destroyed then
		return
	end
	local ok, links = pcall(self._computeLinks, self)
	if ok and type(links) == "table" then
		self._links = links
	else
		self._links = {}
	end
	self:_styleLayerRows()
	self:_updateOverlay()
	self:_renderLinkList()
	self:_updateProps()
end

-- Piles de blocs qui utilisent l'élément : { { rootId, blockId, text } }
function GuiEditor:_linksOf(name)
	local out = {}
	local entry = name and self._links[name]
	if entry == nil then
		return out
	end
	local model = self._linkedModel
	for _, rootId in ipairs(entry.roots) do
		table.insert(out, { rootId = rootId, blockId = entry.rootBlock[rootId], text = blockText(model, rootId) })
	end
	return out
end

function GuiEditor:_scriptCount(name)
	local entry = name and self._links[name]
	if entry == nil then
		return 0
	end
	return #entry.roots
end

-- Bloc « Quand le bouton <nom> est cliqué » des blocs de l'écran (le plus haut), ou nil
function GuiEditor:_findClickHat(name, model)
	model = model or self._linkedModel or self:_model()
	if not isModel(model) or type(name) ~= "string" then
		return nil
	end
	local best, bestY = nil, math.huge
	for _, topId in ipairs(model.tops) do
		local block = model.blocks[topId]
		if block ~= nil and block.def == "gui_quand_clic" then
			local input = block.inputs and block.inputs.BOUTON
			if input ~= nil and self:_localName(input.value) == name then
				local y = tonumber(block.y) or 0
				if y < bestY then
					best, bestY = topId, y
				end
			end
		end
	end
	return best
end

-- Montre un bloc dans « Blocs de l'écran »
function GuiEditor:_focusBlock(blockId)
	if blockId == nil then
		return
	end
	local fn = self.deps.focusBlock
	if type(fn) == "function" then
		pcall(fn, blockId)
		return
	end
	local app = self.app
	if type(app) ~= "table" then
		return
	end
	if type(app.focusBlock) == "function" then
		pcall(app.focusBlock, app, blockId)
		return
	end
	local canvas = app.canvas
	if type(canvas) == "table" and type(canvas.focusBlock) == "function" then
		pcall(canvas.focusBlock, canvas, blockId)
	end
end

-- Hauteur d'une pile (Renderer.measure, sinon une estimation)
function GuiEditor:_stackHeight(model, topId)
	local Renderer = optional("Renderer")
	if Renderer ~= nil and type(Renderer.measure) == "function" then
		local ok, _, h = pcall(Renderer.measure, model, topId)
		if ok and isFinite(h) then
			return h
		end
	end
	return 20 + #model:chain(topId) * 44
end

-- Place libre sous les piles existantes des blocs de l'écran (unités du canvas)
function GuiEditor:_freeSpot(model)
	local minX, maxBottom = nil, nil
	for _, topId in ipairs(model.tops) do
		local block = model.blocks[topId]
		if block ~= nil then
			local x = tonumber(block.x) or 0
			local y = tonumber(block.y) or 0
			local bottom = y + self:_stackHeight(model, topId)
			if minX == nil or x < minX then
				minX = x
			end
			if maxBottom == nil or bottom > maxBottom then
				maxBottom = bottom
			end
		end
	end
	if maxBottom == nil then
		return 40, 40
	end
	return round(minX), round(maxBottom + 40)
end

-- « Ajouter un script au clic » : crée « Quand le bouton … est cliqué » sous les blocs de l'écran
-- (ou montre celui qui existe déjà). Renvoie l'id du bloc, ou nil.
function GuiEditor:addClickScript(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil or el.type ~= "bouton" then
		return nil
	end
	-- App le fait quand elle sait (elle rouvre aussi la zone des blocs si elle est repliée) ; une
	-- erreur chez elle : le Studio le fait lui-même
	local name = el.name
	local delegate = nil
	if type(self.deps.addClickScript) == "function" then
		delegate = function()
			return self.deps.addClickScript(name)
		end
	elseif type(self.app) == "table" and type(self.app.addClickScript) == "function" then
		delegate = function()
			return self.app:addClickScript(name)
		end
	end
	if delegate ~= nil then
		local ok, result = pcall(delegate)
		if ok then
			self:_syncModel(true)
			return result
		end
		warn("[Blocs FR] Studio d'interface (script au clic) : " .. tostring(result))
	end
	local model = self:_model()
	if model == nil then
		self:_toast("Les blocs de l'écran ne sont pas disponibles : ouvre l'onglet Interface pour les voir.", "warning")
		return nil
	end
	local existing = self:_findClickHat(el.name, model)
	if existing ~= nil then
		self:_focusBlock(existing)
		self:_status("Le bouton « " .. el.name .. " » a déjà son script : le voici dans les blocs de l'écran.", "info")
		return existing
	end
	local x, y = self:_freeSpot(model)
	local okCreate, blockId = pcall(model.create, model, "gui_quand_clic", x, y, { BOUTON = el.name })
	if not okCreate or blockId == nil then
		self:_toast("Le bloc « Quand le bouton … est cliqué » est introuvable.", "error")
		return nil
	end
	pcall(model.commit, model, "ajouter")
	self:_syncModel(true)
	task.delay(0.1, function()
		if not self._destroyed then
			self:_focusBlock(blockId)
		end
	end)
	self:_toast("Script ajouté : « Quand le bouton " .. el.name .. " est cliqué ». Glisse des blocs dessous !", "success")
	return blockId
end

---------------------------------------------------------------------------
-- Changer d'écran depuis le Studio (carte de départ, modèles, écrans enregistrés)
---------------------------------------------------------------------------

-- Méthodes d'App qui changent d'écran : elles proposent d'enregistrer l'écran ouvert (et ses blocs),
-- puis chargent les blocs du nouvel écran dans la zone du bas
local APP_SCREEN_METHODS = { nouveau = "newScreen", modele = "insertTemplate", ouvrir = "openScreen" }

function GuiEditor:_request(kind, arg)
	if self._destroyed then
		return
	end
	local fn = self.deps.requestScreen
	if type(fn) == "function" then
		local ok, handled = pcall(fn, kind, arg)
		if ok and handled ~= false then
			return
		end
	end
	local app = self.app
	local method = APP_SCREEN_METHODS[kind]
	if type(app) == "table" and method ~= nil and type(app[method]) == "function" then
		local ok, err
		if kind == "nouveau" then
			ok, err = pcall(app[method], app)
		else
			ok, err = pcall(app[method], app, arg)
		end
		if not ok then
			warn("[Blocs FR] Studio d'interface : " .. tostring(err))
			self:_toast("Impossible de changer d'écran : " .. tostring(err), "error")
		end
		return
	end
	-- sans App : le Studio demande lui-même avant d'abandonner les changements
	self:_confirmDiscard(function()
		if self._destroyed then
			return
		end
		if kind == "nouveau" then
			self:newScreen()
		elseif kind == "modele" then
			self:insertTemplate(arg)
		elseif kind == "ouvrir" then
			self:openScreen(arg)
		end
	end)
end

-- onContinue tout de suite si rien n'est à enregistrer ; sinon on demande d'abord
function GuiEditor:_confirmDiscard(onContinue)
	local model = self._linkedModel or self:_model()
	local dirty = self:isDirty() or (model ~= nil and model.dirty == true)
	local dialogs = self.dialogs
	if not dirty or type(dialogs) ~= "table" then
		onContinue()
		return
	end
	local name = (self.doc and self.doc.name) or "?"
	local message = "L'écran « " .. name .. " » (ou ses blocs) a des changements qui ne sont pas enregistrés."
	local saveFn = self.deps.saveScreen
	local app = self.app
	if type(saveFn) ~= "function" and type(app) == "table" and type(app.saveScreen) == "function" then
		saveFn = function()
			return app:saveScreen()
		end
	end
	if type(saveFn) == "function" and type(dialogs._openModal) == "function" and type(dialogs._closeModal) == "function" then
		-- trois choix : Enregistrer / Ne pas enregistrer / Annuler (comme Windows)
		local modal = nil
		local function close()
			if modal ~= nil and dialogs._modal == modal then
				dialogs:_closeModal()
			end
		end
		local ok = pcall(function()
			modal = dialogs:_openModal({
				title = "Changements non enregistrés",
				message = message .. " Que veux-tu faire ?",
				buttons = {
					{ text = "Annuler", style = "normal", action = close },
					{
						text = "Ne pas enregistrer",
						style = "danger",
						action = function()
							close()
							task.spawn(onContinue)
						end,
					},
					{
						text = "Enregistrer",
						style = "primary",
						action = function()
							close()
							task.spawn(function()
								local okSave, saved = pcall(saveFn)
								if okSave and saved ~= false then
									onContinue()
								end
							end)
						end,
					},
				},
			})
		end)
		if ok and modal ~= nil then
			return
		end
	end
	if type(dialogs.confirm) == "function" then
		dialogs:confirm(
			"Changements non enregistrés",
			message .. " Les abandonner ?\n\nPour les garder, clique d'abord sur « Enregistrer l'écran ».",
			onContinue,
			"Abandonner les changements",
			"Annuler",
			true
		)
	else
		onContinue()
	end
end

---------------------------------------------------------------------------
-- Propriétés : petits contrôles (chacun ajoute sa fonction de mise à jour à _propUpdaters)
---------------------------------------------------------------------------

local NUMBER_ERROR = "Écris un nombre (par exemple 12 ou 3,5)."

function GuiEditor:_clearProps()
	-- un champ encore en cours de saisie est validé avant de disparaître (voir _field)
	local flush = self._propFlush
	self._propFlush = {}
	for _, fn in ipairs(flush) do
		local ok, err = pcall(fn)
		if not ok then
			warn("[Blocs FR] Studio d'interface (propriétés) : " .. tostring(err))
		end
	end
	disconnectAll(self._propConns)
	disconnectAll(self._linkConns or {})
	self._propUpdaters = {}
	self._linkListFrame = nil
	self._linkListId = nil
	for _, child in ipairs(self.propsScroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Section : titre en majuscules, lignes, trait en dessous. Renvoie S = { frame, n }.
function GuiEditor:_section(title, order)
	local frame = makeFrame({
		Name = "Section",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order * 2,
		Parent = self.propsScroll,
	})
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 14),
		PaddingLeft = UDim.new(0, 16),
		PaddingRight = UDim.new(0, 16),
		Parent = frame,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 9),
		Parent = frame,
	})
	makeFrame({
		Name = "Trait",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.PanelBorder,
		Size = UDim2.new(1, 0, 0, 1),
		LayoutOrder = order * 2 + 1,
		Parent = self.propsScroll,
	})
	local S = { frame = frame, n = 0 }
	if title ~= nil then
		S.n += 1
		makeLabel({
			Name = "Titre",
			Text = title,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = S.n,
			Parent = frame,
		})
	end
	return S
end

-- Ligne « libellé (86 px, 68 quand le panneau est étroit) | contrôles » ; renvoie la ligne et la zone
-- des contrôles (en ligne)
function GuiEditor:_row(S, labelText, height)
	S.n += 1
	local row = makeFrame({
		Name = "Ligne",
		Size = UDim2.new(1, 0, 0, height or 30),
		LayoutOrder = S.n,
		Parent = S.frame,
	})
	local x = 0
	if labelText ~= nil then
		local labelW = 86
		if self._propsNarrow then
			labelW = 68
		end
		makeLabel({
			Name = "Libelle",
			Text = labelText,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(12),
			TextColor3 = C.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(0, labelW, 0, 30),
			Parent = row,
		})
		x = labelW + 8
	end
	local area = makeFrame({
		Name = "Controles",
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x, 1, 0),
		Parent = row,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = area,
	})
	return row, area
end

-- Petit texte après les contrôles d'une ligne : il prend la place qui reste (coupé par « … » si
-- le panneau est étroit) au lieu de sortir du panneau
function GuiEditor:_rowText(area, text, order)
	local used = 0
	for _, child in ipairs(area:GetChildren()) do
		if child:IsA("GuiObject") and child.Size.X.Scale == 0 then
			used += child.Size.X.Offset + 8
		end
	end
	local label = makeLabel({
		Text = text,
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -used, 1, 0),
		LayoutOrder = order or 50,
		Parent = area,
	})
	Util.create("UISizeConstraint", { MinSize = Vector2.new(0, 0), Parent = label })
	return label
end

function GuiEditor:_note(S, text)
	S.n += 1
	return makeLabel({
		Name = "Note",
		Text = text,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = S.n,
		Parent = S.frame,
	})
end

-- Champ texte : validé à la perte du focus ou avec Entrée (Échap : annule).
-- opts = { get = fn -> valeur, set = fn(texte) -> ok, erreurFR, width, size, position, order,
--          placeholder, suffix, disabled = fn -> bool, disabledText, visible = fn -> bool }
function GuiEditor:_field(parent, opts)
	local size = opts.size
	if size == nil then
		if opts.width ~= nil then
			size = UDim2.new(0, opts.width, 0, 30)
		else
			size = UDim2.new(1, 0, 0, 30)
		end
	end
	local holder = makeFrame({
		Name = "Champ",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.FieldBg,
		Position = opts.position or UDim2.new(),
		Size = size,
		LayoutOrder = opts.order or 1,
		Parent = parent,
	})
	Util.corner(holder, 7)
	local stroke = Util.stroke(holder, C.PopupBorder, 1)
	local suffixW = 0
	if opts.suffix ~= nil then
		suffixW = math.ceil(Util.textSize(opts.suffix, ts(11), Theme.Fonts.UI).X) + 6
		makeLabel({
			Text = opts.suffix,
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 0),
			Size = UDim2.new(0, suffixW, 1, 0),
			Parent = holder,
		})
	end
	local box = Util.create("TextBox", {
		Name = "Saisie",
		Text = "",
		PlaceholderText = opts.placeholder or "",
		PlaceholderColor3 = C.TextDisabled,
		ClearTextOnFocus = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = ts(12),
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -(18 + suffixW), 1, 0),
		Parent = holder,
	})
	local function current()
		local ok, value = pcall(opts.get)
		if ok and value ~= nil then
			return tostring(value)
		end
		return ""
	end
	local function disabled()
		if opts.disabled == nil then
			return false
		end
		local ok, value = pcall(opts.disabled)
		return ok and value == true
	end
	-- texte affiché quand on ne tape pas
	local function shown()
		if disabled() then
			return opts.disabledText or "—"
		end
		return current()
	end
	box.Text = current()
	-- Valide le texte tapé. Toujours différé (jamais pendant un FocusLost ni pendant que le panneau se
	-- reconstruit) et valable même si le panneau a déjà été refait entre-temps (clic sur un autre
	-- élément pendant la saisie) : le texte va à l'élément de ce champ, dans le même écran.
	local docAtBuild = self.doc
	local editing = false
	local function apply(text, escape)
		task.defer(function()
			if self._destroyed or self.doc ~= docAtBuild then
				return
			end
			local alive = box.Parent ~= nil
			if escape or disabled() or text == current() then
				if alive then
					box.Text = shown()
				end
				return
			end
			local ok, result, err = pcall(opts.set, text)
			if not ok then
				warn("[Blocs FR] Studio d'interface : " .. tostring(result))
			elseif result == false and err ~= nil then
				self:_toast(tostring(err), "warning")
			end
			if (not ok or result == false) and box.Parent ~= nil then
				box.Text = shown()
			end
		end)
	end
	self:_conn(box.Focused, function()
		editing = true
		stroke.Color = C.Accent
		stroke.Thickness = 2
	end, self._propConns)
	self:_conn(box.FocusLost, function(_, input)
		stroke.Color = C.PopupBorder
		stroke.Thickness = 1
		if not editing then
			return
		end
		editing = false
		apply(box.Text, input ~= nil and input.KeyCode == Enum.KeyCode.Escape)
	end, self._propConns)
	-- panneau refait pendant la saisie (avant le FocusLost) : le texte est validé quand même
	table.insert(self._propFlush, function()
		if editing then
			editing = false
			apply(box.Text, false)
		end
	end)
	table.insert(self._propUpdaters, function()
		if holder.Parent == nil then
			return
		end
		if opts.visible ~= nil then
			local ok, visible = pcall(opts.visible)
			holder.Visible = ok and visible == true
		end
		if box:IsFocused() then
			return
		end
		local off = disabled()
		box.TextEditable = not off
		box.TextColor3 = (off and C.TextDisabled) or C.Text
		local text = shown()
		if box.Text ~= text then
			box.Text = text
		end
	end)
	return box, holder
end

-- Pastille de couleur -> sélecteur de couleur. opts = { get = fn -> {r,g,b}|nil, set = fn(rgb),
-- order, visible = fn -> bool }
function GuiEditor:_swatch(parent, opts)
	local b = makeButton({
		Name = "Couleur",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromOffset(26, 22),
		LayoutOrder = opts.order or 2,
		Parent = parent,
	})
	Util.corner(b, 6)
	Util.stroke(b, WHITE, 2, 0.15)
	local none = makeLabel({
		Text = "—",
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = b,
	})
	self:_conn(b.MouseButton1Click, function()
		local dialogs = self.dialogs
		if type(dialogs) ~= "table" or type(dialogs.colorPicker) ~= "function" then
			return
		end
		local ok, rgb = pcall(opts.get)
		if not ok or type(rgb) ~= "table" then
			rgb = { 255, 255, 255 }
		end
		local pos = b.AbsolutePosition + Vector2.new(0, b.AbsoluteSize.Y + 4)
		dialogs:colorPicker(pos, rgb, function(newRgb)
			if not self._destroyed then
				local okSet, err = pcall(opts.set, newRgb)
				if not okSet then
					warn("[Blocs FR] Studio d'interface : " .. tostring(err))
				end
			end
		end)
	end, self._propConns)
	table.insert(self._propUpdaters, function()
		if b.Parent == nil then
			return
		end
		if opts.visible ~= nil then
			local okV, visible = pcall(opts.visible)
			b.Visible = okV and visible == true
		end
		local ok, rgb = pcall(opts.get)
		if ok and type(rgb) == "table" then
			b.BackgroundColor3 = Util.rgbToColor3(rgb)
			none.Visible = false
		else
			b.BackgroundColor3 = C.FieldBg
			none.Visible = true
		end
	end)
	return b
end

-- Interrupteur. opts = { get = fn -> bool, set = fn(bool), order }
function GuiEditor:_toggle(parent, opts)
	local track = makeButton({
		Name = "Interrupteur",
		BackgroundColor3 = C.ButtonActive,
		Size = UDim2.fromOffset(34, 20),
		LayoutOrder = opts.order or 1,
		Parent = parent,
	})
	Util.corner(track, 10)
	local knob = makeFrame({
		Name = "Bouton",
		Active = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(14, 14),
		Parent = track,
	})
	Util.corner(knob, 7)
	local last = nil
	local function value()
		local ok, v = pcall(opts.get)
		return ok and v == true
	end
	self:_conn(track.MouseButton1Click, function()
		local ok, err = pcall(opts.set, not value())
		if not ok then
			warn("[Blocs FR] Studio d'interface : " .. tostring(err))
		end
	end, self._propConns)
	table.insert(self._propUpdaters, function()
		if track.Parent == nil then
			return
		end
		local on = value()
		if on == last then
			return
		end
		local color = (on and C.Accent) or C.ButtonActive
		local position = UDim2.fromOffset(3, 3)
		if on then
			position = UDim2.fromOffset(17, 3)
		end
		if last == nil then
			track.BackgroundColor3 = color
			knob.Position = position
		else
			animTween(track, { BackgroundColor3 = color }, 0.12, "quadOut")
			animTween(knob, { Position = position }, 0.12, "quadOut")
		end
		last = on
	end)
	return track
end

-- Choix segmenté. opts = { options = { { libellé, valeur } }, get, set, order, size }
function GuiEditor:_segmented(parent, opts)
	local n = math.max(#opts.options, 1)
	local container = makeFrame({
		Name = "Choix",
		BackgroundTransparency = 0,
		BackgroundColor3 = C.FieldBg,
		Size = opts.size or UDim2.new(1, 0, 0, 28),
		LayoutOrder = opts.order or 1,
		Parent = parent,
	})
	Util.corner(container, 8)
	Util.stroke(container, C.PopupBorder, 1)
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, 3),
		PaddingBottom = UDim.new(0, 3),
		PaddingLeft = UDim.new(0, 3),
		PaddingRight = UDim.new(0, 3),
		Parent = container,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = container,
	})
	local segments = {}
	for i, option in ipairs(opts.options) do
		local seg = makeButton({
			Name = "Option",
			Text = option[1],
			Font = Theme.Fonts.UIBold,
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundColor3 = C.ButtonActive,
			BackgroundTransparency = 1,
			Size = UDim2.new(1 / n, -2, 1, 0),
			LayoutOrder = i,
			Parent = container,
		})
		Util.corner(seg, 6)
		segments[i] = { button = seg, value = option[2] }
		self:_conn(seg.MouseButton1Click, function()
			local ok, err = pcall(opts.set, option[2])
			if not ok then
				warn("[Blocs FR] Studio d'interface : " .. tostring(err))
			end
		end, self._propConns)
	end
	table.insert(self._propUpdaters, function()
		if container.Parent == nil then
			return
		end
		local ok, value = pcall(opts.get)
		for _, s in ipairs(segments) do
			local on = ok and value == s.value
			s.button.BackgroundTransparency = (on and 0) or 1
			s.button.TextColor3 = (on and C.Text) or C.TextDim
		end
	end)
	return container
end

-- Bouton qui ouvre une liste (polices). opts = { getLabel, getFont|nil, items = fn -> items, onChoose }
function GuiEditor:_dropdown(parent, opts)
	local b = makeButton({
		Name = "Liste",
		BackgroundColor3 = C.FieldBg,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = opts.order or 1,
		Parent = parent,
	})
	Util.corner(b, 7)
	Util.stroke(b, C.PopupBorder, 1)
	local text = makeLabel({
		Text = "",
		TextSize = ts(13),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Parent = b,
	})
	makeLabel({
		Text = "▼",
		TextSize = ts(9),
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		Size = UDim2.new(0, 12, 1, 0),
		Parent = b,
	})
	self:_conn(b.MouseButton1Click, function()
		local ok, items = pcall(opts.items)
		if ok and type(items) == "table" then
			self:_menu(items, function(value)
				opts.onChoose(value)
			end, b.AbsolutePosition + Vector2.new(0, b.AbsoluteSize.Y + 2))
		end
	end, self._propConns)
	table.insert(self._propUpdaters, function()
		if b.Parent == nil then
			return
		end
		local ok, label = pcall(opts.getLabel)
		if ok then
			text.Text = tostring(label or "")
		end
		if opts.getFont ~= nil then
			local okFont, font = pcall(opts.getFont)
			if okFont and typeof(font) == "EnumItem" then
				text.Font = font
			end
		end
	end)
	return b
end

-- Grille 3 × 3 du point d'ancrage. opts = { get = fn -> ax, ay ; set = fn(ax, ay) }
function GuiEditor:_anchorGrid(parent, opts)
	local grid = makeFrame({
		Name = "Ancre",
		Size = UDim2.fromOffset(50, 50),
		LayoutOrder = opts.order or 1,
		Parent = parent,
	})
	Util.create("UIGridLayout", {
		CellSize = UDim2.fromOffset(14, 14),
		CellPadding = UDim2.fromOffset(4, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local values = { 0, 0.5, 1 }
	local cells = {}
	local n = 0
	for row = 1, 3 do
		for col = 1, 3 do
			n += 1
			local ax, ay = values[col], values[row]
			local cell = makeButton({
				Name = "Point",
				BackgroundColor3 = C.PopupBorder,
				LayoutOrder = n,
				Parent = grid,
			})
			Util.corner(cell, 3)
			table.insert(cells, { button = cell, ax = ax, ay = ay })
			self:_conn(cell.MouseButton1Click, function()
				local ok, err = pcall(opts.set, ax, ay)
				if not ok then
					warn("[Blocs FR] Studio d'interface : " .. tostring(err))
				end
			end, self._propConns)
		end
	end
	table.insert(self._propUpdaters, function()
		if grid.Parent == nil then
			return
		end
		local ok, ax, ay = pcall(opts.get)
		for _, c in ipairs(cells) do
			local on = ok and type(ax) == "number" and type(ay) == "number" and math.abs(ax - c.ax) < 0.01 and math.abs(ay - c.ay) < 0.01
			c.button.BackgroundColor3 = (on and C.Accent) or C.PopupBorder
		end
	end)
	return grid
end

-- Deux champs côte à côte (« X » et « Y », « L » et « H »)
function GuiEditor:_pairFields(area, labelA, labelB, optsA, optsB)
	for i, spec in ipairs({ { labelA, optsA }, { labelB, optsB } }) do
		local cell = makeFrame({ Name = "Case", Size = UDim2.new(0.5, -4, 1, 0), LayoutOrder = i, Parent = area })
		makeLabel({
			Text = spec[1],
			Font = Theme.Fonts.UIBold,
			TextSize = ts(12),
			TextColor3 = C.TextDim,
			Size = UDim2.new(0, 18, 1, 0),
			Parent = cell,
		})
		local opts = spec[2]
		opts.size = UDim2.new(1, -22, 0, 30)
		opts.position = UDim2.fromOffset(22, 0)
		self:_field(cell, opts)
	end
end

---------------------------------------------------------------------------
-- Propriétés : contenu du panneau selon la sélection
---------------------------------------------------------------------------

function GuiEditor:_propsKeyNow()
	local doc = self.doc
	if doc == nil then
		return "aucun"
	end
	if #self._sel == 0 then
		return "ecran"
	end
	if #self._sel > 1 then
		return "multi:" .. table.concat(self._sel, ",")
	end
	local el = doc:get(self._sel[1])
	if el == nil then
		return "ecran"
	end
	return "el:" .. el.id .. ":" .. el.type
end

-- Reconstruit le panneau quand la sélection change, sinon met seulement les valeurs à jour
function GuiEditor:_refreshProps(force)
	if self._destroyed then
		return
	end
	local key = self:_propsKeyNow()
	if key == self._propsKey and not force then
		self:_updateProps()
		return
	end
	self._propsKey = key
	self:_clearProps()
	local ok, err = pcall(function()
		if key == "aucun" then
			self:_buildNoScreenProps()
		elseif key == "ecran" then
			self:_buildScreenProps()
		elseif string.sub(key, 1, 6) == "multi:" then
			self:_buildMultiProps()
		else
			self:_buildElementProps(self._sel[1])
		end
	end)
	if not ok then
		warn("[Blocs FR] Studio d'interface (propriétés) : " .. tostring(err))
	end
	self.propsScroll.CanvasPosition = Vector2.new(0, 0)
	self:_updateProps()
end

function GuiEditor:_updateProps()
	if self._destroyed then
		return
	end
	self:_updatePropsHeader()
	for _, fn in ipairs(self._propUpdaters) do
		local ok, err = pcall(fn)
		if not ok then
			warn("[Blocs FR] Studio d'interface (propriétés) : " .. tostring(err))
		end
	end
end

function GuiEditor:_updatePropsHeader()
	local doc = self.doc
	local title = "Aucun écran"
	local iconType = nil
	if doc ~= nil then
		if #self._sel == 0 then
			title = "Écran « " .. doc.name .. " »"
			iconType = "ecran"
		elseif #self._sel > 1 then
			title = tostring(#self._sel) .. " éléments sélectionnés"
		else
			local el = doc:get(self._sel[1])
			if el ~= nil then
				title = (GuiDoc.TYPE_LABELS[el.type] or "Élément") .. " « " .. el.name .. " »"
				iconType = el.type
			end
		end
	end
	self.propsTitle.Text = title
	if iconType ~= self._propsIconType then
		self._propsIconType = iconType
		for _, child in ipairs(self.propsIcon:GetChildren()) do
			child:Destroy()
		end
		if iconType ~= nil then
			drawTypeIcon(self.propsIcon, iconType)
		end
	end
	if iconType ~= nil then
		self.propsTitle.Position = UDim2.fromOffset(46, 31)
		self.propsTitle.Size = UDim2.new(1, -62, 0, 22)
	else
		self.propsTitle.Position = UDim2.fromOffset(16, 31)
		self.propsTitle.Size = UDim2.new(1, -32, 0, 22)
	end
end

function GuiEditor:_buildNoScreenProps()
	local S = self:_section(nil, 1)
	self:_note(S, "Aucun écran n'est ouvert. Crée un écran vide ou choisis un modèle (à gauche ou au milieu).")
	self:_note(S, "Un écran, c'est une interface du jeu : menu, HUD, boutique… Il est enregistré dans StarterGui.")
end

function GuiEditor:_setScreenProp(key, value)
	local doc = self.doc
	if doc == nil then
		return false
	end
	if not doc:setProp(key, value) then
		return false, "Valeur refusée."
	end
	doc:commit("écran")
	return true
end

function GuiEditor:_buildScreenProps()
	local S = self:_section("ÉCRAN", 1)
	local _, aName = self:_row(S, "Nom")
	self:_field(aName, {
		get = function()
			return self.doc and self.doc.name or ""
		end,
		set = function(text)
			return self:_renameScreen(text)
		end,
	})
	local _, aVisible = self:_row(S, "Visible")
	self:_toggle(aVisible, {
		get = function()
			return self.doc ~= nil and self.doc.props.visibleAuDemarrage == true
		end,
		set = function(v)
			self:_setScreenProp("visibleAuDemarrage", v)
		end,
	})
	self:_rowText(aVisible, "au démarrage")
	local _, aKeep = self:_row(S, "Garder")
	self:_toggle(aKeep, {
		get = function()
			return self.doc ~= nil and self.doc.props.garderApresMort == true
		end,
		set = function(v)
			self:_setScreenProp("garderApresMort", v)
		end,
	})
	self:_rowText(aKeep, "après la mort")
	local _, aOrder = self:_row(S, "Ordre")
	self:_field(aOrder, {
		width = 64,
		get = function()
			return self.doc and fmt(self.doc.props.ordre) or "0"
		end,
		set = function(text)
			local n = Util.parseNumber(text)
			if n == nil then
				return false, "Écris un nombre entier (par exemple 5)."
			end
			return self:_setScreenProp("ordre", n)
		end,
	})
	self:_note(
		S,
		"Visible : l'écran est affiché dès le début du jeu. Garder : il reste après la mort du joueur. Ordre : le plus grand passe par-dessus les autres écrans."
	)

	local S2 = self:_section("INFOS", 2)
	local info = self:_note(S2, "")
	table.insert(self._propUpdaters, function()
		local doc = self.doc
		if info.Parent == nil or doc == nil then
			return
		end
		local count = 0
		for _ in pairs(doc.elements) do
			count += 1
		end
		local text = tostring(count) .. " élément"
		if count > 1 then
			text ..= "s"
		end
		local sg = self:getScreenGui()
		if sg ~= nil then
			text ..= ". Enregistré dans StarterGui → " .. sg.Name .. "."
			if self:isDirty() then
				text ..= " Il y a des changements à enregistrer."
			end
		else
			text ..= ". Pas encore enregistré : clique sur « Enregistrer l'écran » en haut."
		end
		info.Text = text
	end)
	self:_note(S2, "Clique sur un élément de l'aperçu ou des calques pour le modifier. Clic droit : plus d'options.")
end

function GuiEditor:_buildMultiProps()
	local doc = self.doc
	local ids = table.clone(self._sel)
	local S = self:_section("SÉLECTION", 1)
	for i, id in ipairs(ids) do
		if i > 12 then
			self:_note(S, "… et " .. tostring(#ids - 12) .. " autre(s)")
			break
		end
		local el = doc:get(id)
		if el ~= nil then
			S.n += 1
			local row = makeButton({
				Name = "Element",
				BackgroundColor3 = C.Button,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 26),
				LayoutOrder = S.n,
				Parent = S.frame,
			})
			Util.corner(row, 6)
			local icon = makeFrame({ Active = false, Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(22, 16), Parent = row })
			drawTypeIcon(icon, el.type)
			makeLabel({
				Text = el.name,
				TextSize = ts(12),
				TextColor3 = C.TextSoft,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.fromOffset(36, 0),
				Size = UDim2.new(1, -40, 1, 0),
				Parent = row,
			})
			self:_conn(row.MouseEnter, function()
				row.BackgroundTransparency = 0
			end, self._propConns)
			self:_conn(row.MouseLeave, function()
				row.BackgroundTransparency = 1
			end, self._propConns)
			self:_conn(row.MouseButton1Click, function()
				self:_setSelection({ id })
			end, self._propConns)
		end
	end

	local S2 = self:_section("ALIGNER", 2)
	for _, line in ipairs({
		{ { "Gauche", "gauche" }, { "Centre", "centre" }, { "Droite", "droite" } },
		{ { "Haut", "haut" }, { "Milieu", "milieu" }, { "Bas", "bas" } },
	}) do
		local _, area = self:_row(S2, nil, 28)
		for i, spec in ipairs(line) do
			local b = makeButton({
				Name = "Aligner",
				Text = spec[1],
				Font = Theme.Fonts.UIBold,
				TextSize = ts(11),
				TextColor3 = C.Text,
				BackgroundColor3 = C.Button,
				Size = UDim2.new(1 / 3, -6, 1, 0),
				LayoutOrder = i,
				Parent = area,
			})
			Util.corner(b, 7)
			local disconnectHover = anim("hover", b, C.Button, C.ButtonHover)
			if type(disconnectHover) == "function" then
				table.insert(self._propConns, { Disconnect = disconnectHover })
			end
			self:_conn(b.MouseButton1Click, function()
				self:_align(self:_topSelection(), spec[2])
			end, self._propConns)
		end
	end

	local S3 = self:_section(nil, 3)
	local _, aVisible = self:_row(S3, "Visible")
	self:_toggle(aVisible, {
		get = function()
			local d = self.doc
			if d == nil then
				return false
			end
			for _, id in ipairs(self._sel) do
				local e = d:get(id)
				if e ~= nil and not e.visible then
					return false
				end
			end
			return true
		end,
		set = function(v)
			local d = self.doc
			if d == nil then
				return
			end
			for _, id in ipairs(self._sel) do
				d:set(id, "visible", v)
			end
			d:commit("visibilité")
		end,
	})
	self:_rowText(aVisible, "au démarrage")
	S3.n += 1
	local delete = makeButton({
		Name = "Supprimer",
		Text = "Supprimer la sélection",
		Font = Theme.Fonts.UIBold,
		TextSize = ts(12),
		TextColor3 = WHITE,
		BackgroundColor3 = C.Danger,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = S3.n,
		Parent = S3.frame,
	})
	Util.corner(delete, 8)
	self:_conn(delete.MouseButton1Click, function()
		self:_deleteWithConfirm(self:_topSelection())
	end, self._propConns)
	self:_note(S3, "Astuce : Maj + clic ajoute ou retire un élément ; glisse sur le fond de l'écran pour en entourer plusieurs.")
end

function GuiEditor:_buildElementProps(id)
	local doc = self.doc
	local el = doc and doc:get(id)
	if el == nil then
		return
	end
	local t = el.type
	local order = 0
	local function section(title)
		order += 1
		return self:_section(title, order)
	end
	local function getEl()
		local d = self.doc
		return d and d:get(id)
	end
	local function setField(key, value, reason)
		local d = self.doc
		if d == nil or d:get(id) == nil then
			return false
		end
		if not d:set(id, key, value) then
			return false, "Valeur refusée."
		end
		d:commit(reason or "propriété")
		return true
	end
	-- champ nombre -> valeur (convert), avec une vérification facultative
	local function numberSetter(key, convert, reason, minimum)
		return function(text)
			local n = Util.parseNumber(text)
			if n == nil then
				return false, NUMBER_ERROR
			end
			if minimum ~= nil and n < minimum then
				return false, "Le nombre doit être au moins " .. fmt(minimum) .. "."
			end
			return setField(key, convert(n), reason)
		end
	end
	local function same(n)
		return n
	end
	local function percent(n)
		return n / 100
	end
	local function getter(key, format)
		return function()
			local e = getEl()
			if e == nil then
				return ""
			end
			return format(e[key])
		end
	end
	local function colorOf(key)
		return function()
			local e = getEl()
			return e and e[key]
		end
	end
	local function colorSetter(key)
		return function(rgb)
			setField(key, rgb, "couleur")
		end
	end

	-- NOM
	local S = section("NOM")
	local _, aName = self:_row(S, "Nom")
	self:_field(aName, {
		get = function()
			local e = getEl()
			return e and e.name or ""
		end,
		set = function(text)
			return self:_renameElement(id, text)
		end,
	})
	local _, aVisible = self:_row(S, "Visible")
	self:_toggle(aVisible, {
		get = function()
			local e = getEl()
			return e ~= nil and e.visible == true
		end,
		set = function(v)
			setField("visible", v, "visibilité")
		end,
	})
	self:_rowText(aVisible, "au démarrage")

	-- TEXTE
	if TEXT_TYPES[t] then
		local S2 = section("TEXTE")
		local _, aText = self:_row(S2, "Texte")
		local placeholder = ""
		if t == "barre" then
			placeholder = "(aucun texte)"
		end
		self:_field(aText, {
			placeholder = placeholder,
			get = getter("texte", tostring),
			set = function(text)
				return setField("texte", text, "texte")
			end,
		})
		if t == "champ" then
			local _, aHint = self:_row(S2, "Texte d'aide")
			self:_field(aHint, {
				get = getter("indice", tostring),
				set = function(text)
					return setField("indice", text, "texte")
				end,
			})
		end
		local _, aFont = self:_row(S2, "Police")
		self:_dropdown(aFont, {
			getLabel = function()
				local e = getEl()
				return e and prettyFont(e.police) or ""
			end,
			getFont = function()
				local e = getEl()
				return GuiBuild.fontOf(e and e.police)
			end,
			items = function()
				local e = getEl()
				local list = {}
				for _, name in ipairs(GuiDoc.FONTS) do
					table.insert(list, { label = prettyFont(name), value = name, checked = e ~= nil and e.police == name })
				end
				return list
			end,
			onChoose = function(value)
				setField("police", value, "police")
			end,
		})
		local _, aSize = self:_row(S2, "Taille")
		self:_field(aSize, {
			width = 64,
			suffix = "px",
			get = getter("tailleTexte", fmt),
			set = numberSetter("tailleTexte", same, "texte", 1),
		})
		self:_swatch(aSize, { get = colorOf("texteCouleur"), set = colorSetter("texteCouleur") })
		self:_rowText(aSize, "couleur", 3)
		local _, aStroke = self:_row(S2, "Contour")
		local function hasTextStroke()
			local e = getEl()
			return e ~= nil and e.texteContour > 0
		end
		self:_toggle(aStroke, {
			get = hasTextStroke,
			set = function(v)
				local value = 0
				if v then
					value = 2
				end
				setField("texteContour", value, "texte")
			end,
		})
		self:_swatch(aStroke, { get = colorOf("texteContourCouleur"), set = colorSetter("texteContourCouleur"), visible = hasTextStroke })
		local _, aAlign = self:_row(S2, "Alignement")
		self:_segmented(aAlign, {
			options = { { "Gauche", "gauche" }, { "Centre", "centre" }, { "Droite", "droite" } },
			get = function()
				local e = getEl()
				return e and e.alignement
			end,
			set = function(v)
				setField("alignement", v, "texte")
			end,
		})
	end

	-- STYLE
	local S3 = section("STYLE")
	local function hasFond()
		local e = getEl()
		return e ~= nil and e.fond ~= nil and e.transparence < 1
	end
	local _, aFond = self:_row(S3, "Fond")
	self:_toggle(aFond, {
		get = hasFond,
		set = function(on)
			local d = self.doc
			local e = getEl()
			if d == nil or e == nil then
				return
			end
			if on then
				if e.fond == nil then
					d:set(id, "fond", DEFAULT_FOND)
				end
				if e.transparence >= 1 then
					d:set(id, "transparence", 0)
				end
			else
				d:set(id, "transparence", 1)
			end
			d:commit("style")
		end,
	})
	self:_swatch(aFond, { get = colorOf("fond"), set = colorSetter("fond"), visible = hasFond })
	if GRADIENT_TYPES[t] then
		local rowGradient, aGradient = self:_row(S3, "Dégradé")
		local function hasGradient()
			local e = getEl()
			return e ~= nil and e.fond2 ~= nil
		end
		self:_toggle(aGradient, {
			get = hasGradient,
			set = function(on)
				local e = getEl()
				if e == nil then
					return
				end
				if on then
					local base = e.fond or DEFAULT_FOND
					setField("fond2", { math.floor(base[1] * 0.7), math.floor(base[2] * 0.7), math.floor(base[3] * 0.7) }, "style")
				else
					setField("fond2", nil, "style")
				end
			end,
		})
		self:_swatch(aGradient, { get = colorOf("fond2"), set = colorSetter("fond2"), visible = hasGradient })
		self:_rowText(aGradient, "vers le bas", 3)
		table.insert(self._propUpdaters, function()
			if rowGradient.Parent ~= nil then
				rowGradient.Visible = hasFond()
			end
		end)
	end
	local _, aAlpha = self:_row(S3, "Transparence")
	self:_field(aAlpha, {
		width = 64,
		suffix = "%",
		get = function()
			local e = getEl()
			return e and fmt(e.transparence * 100) or ""
		end,
		set = numberSetter("transparence", percent, "style", 0),
	})
	local _, aRound = self:_row(S3, "Arrondi")
	self:_field(aRound, { width = 64, suffix = "px", get = getter("arrondi", fmt), set = numberSetter("arrondi", same, "style", 0) })
	local _, aBorder = self:_row(S3, "Contour")
	self:_field(aBorder, { width = 64, suffix = "px", get = getter("contour", fmt), set = numberSetter("contour", same, "style", 0) })
	self:_swatch(aBorder, { get = colorOf("contourCouleur"), set = colorSetter("contourCouleur") })
	if RELIEF_TYPES[t] then
		local _, aRelief = self:_row(S3, "Relief 3D")
		local function hasRelief()
			local e = getEl()
			return e ~= nil and e.relief > 0
		end
		self:_toggle(aRelief, {
			get = hasRelief,
			set = function(on)
				local value = 0
				if on then
					value = 6
				end
				setField("relief", value, "style")
			end,
		})
		self:_field(aRelief, {
			width = 64,
			suffix = "px",
			order = 2,
			get = getter("relief", fmt),
			set = numberSetter("relief", same, "style", 0),
			visible = hasRelief,
		})
	end

	-- POSITION ET TAILLE (px de référence 1280 × 720, relatifs au parent)
	local S4 = section("POSITION ET TAILLE")
	local function inLayout()
		return self:_layoutParentOf(id) ~= nil
	end
	local function parentSize()
		local _, _, pw, ph = self:_parentRef(id)
		return pw, ph
	end
	local function positionSetter(axis)
		return function(text)
			local n = Util.parseNumber(text)
			if n == nil then
				return false, NUMBER_ERROR
			end
			local d = self.doc
			if d == nil or d:get(id) == nil then
				return false
			end
			local pw, ph = parentSize()
			if axis == "x" then
				d:setRect(id, n / pw, nil, nil, nil)
			elseif axis == "y" then
				d:setRect(id, nil, n / ph, nil, nil)
			elseif axis == "w" then
				if n <= 0 then
					return false, "La largeur doit être plus grande que 0."
				end
				d:setRect(id, nil, nil, n / pw, nil)
			else
				if n <= 0 then
					return false, "La hauteur doit être plus grande que 0."
				end
				d:setRect(id, nil, nil, nil, n / ph)
			end
			d:commit("position")
			return true
		end
	end
	local function positionGetter(axis)
		return function()
			local e = getEl()
			if e == nil then
				return ""
			end
			local pw, ph = parentSize()
			if axis == "x" then
				return fmt(e.x * pw)
			elseif axis == "y" then
				return fmt(e.y * ph)
			elseif axis == "w" then
				return fmt(e.w * pw)
			end
			return fmt(e.h * ph)
		end
	end
	local _, aXY = self:_row(S4, nil)
	self:_pairFields(
		aXY,
		"X",
		"Y",
		{ get = positionGetter("x"), set = positionSetter("x"), disabled = inLayout },
		{ get = positionGetter("y"), set = positionSetter("y"), disabled = inLayout }
	)
	local _, aWH = self:_row(S4, nil)
	self:_pairFields(aWH, "L", "H", { get = positionGetter("w"), set = positionSetter("w") }, { get = positionGetter("h"), set = positionSetter("h") })
	local _, aRot = self:_row(S4, "Rotation")
	self:_field(aRot, { width = 64, suffix = "°", get = getter("rotation", fmt), set = numberSetter("rotation", same, "position") })
	local _, aAnchor = self:_row(S4, "Ancre", 50)
	self:_anchorGrid(aAnchor, {
		get = function()
			local e = getEl()
			if e == nil then
				return 0.5, 0.5
			end
			return e.ax, e.ay
		end,
		set = function(ax, ay)
			local d = self.doc
			if d == nil or d:get(id) == nil then
				return
			end
			d:set(id, "ax", ax)
			d:set(id, "ay", ay)
			d:commit("ancre")
		end,
	})
	local layoutNote = self:_note(S4, "")
	table.insert(self._propUpdaters, function()
		if layoutNote.Parent == nil then
			return
		end
		local parent = self:_layoutParentOf(id)
		if parent ~= nil then
			layoutNote.Text = "« " .. parent.name .. " » place cet élément toute seule : seule sa taille compte ici."
			layoutNote.Visible = true
		else
			layoutNote.Text = "X, Y : position du point d'ancrage (en pixels pour un écran de 1280 × 720)."
			layoutNote.Visible = true
		end
	end)

	-- Réglages propres au type
	if t == "barre" then
		local S5 = section("BARRE")
		local _, aValue = self:_row(S5, "Remplie à")
		self:_field(aValue, {
			width = 64,
			suffix = "%",
			get = function()
				local e = getEl()
				return e and fmt(e.valeur * 100) or ""
			end,
			set = numberSetter("valeur", percent, "barre", 0),
		})
		local _, aBarColor = self:_row(S5, "Couleur")
		self:_swatch(aBarColor, { get = colorOf("barreCouleur"), set = colorSetter("barreCouleur") })
		self:_note(S5, "Le bloc « remplir la barre … » la fait bouger dans le jeu.")
	elseif t == "image" then
		local S5 = section("IMAGE")
		local _, aImage = self:_row(S5, "Image")
		self:_field(aImage, {
			placeholder = "1234567890",
			get = getter("image", tostring),
			set = function(text)
				local image = GuiDoc.normalizeImage(text)
				if image == nil then
					return false, "Colle seulement le numéro de l'image (par exemple 1234567890)."
				end
				return setField("image", image, "image")
			end,
		})
		local _, aTint = self:_row(S5, "Teinte")
		self:_swatch(aTint, { get = colorOf("imageCouleur"), set = colorSetter("imageCouleur") })
		self:_note(S5, "Colle le numéro d'une image Roblox (Creator Store, Boîte à outils) : le numéro seul suffit.")
	elseif t == "liste" then
		local S5 = section("LISTE")
		local _, aDir = self:_row(S5, "Sens")
		self:_segmented(aDir, {
			options = { { "Vers le bas", "verticale" }, { "Côte à côte", "horizontale" } },
			get = function()
				local e = getEl()
				return e and e.direction
			end,
			set = function(v)
				setField("direction", v, "liste")
			end,
		})
		local _, aGap = self:_row(S5, "Espacement")
		self:_field(aGap, { width = 64, suffix = "px", get = getter("espacement", fmt), set = numberSetter("espacement", same, "liste", 0) })
	elseif t == "grille" then
		local S5 = section("GRILLE")
		local _, aCols = self:_row(S5, "Colonnes")
		self:_field(aCols, { width = 64, get = getter("colonnes", fmt), set = numberSetter("colonnes", same, "grille", 1) })
		local _, aGap = self:_row(S5, "Espacement")
		self:_field(aGap, { width = 64, suffix = "px", get = getter("espacement", fmt), set = numberSetter("espacement", same, "grille", 0) })
	end
	if t == "bouton" then
		local S6 = section("EFFET")
		local _, aEffect = self:_row(S6, "Au survol")
		self:_segmented(aEffect, {
			options = { { "Rebond", "rebond" }, { "Aucun", "aucun" } },
			get = function()
				local e = getEl()
				return e and e.effet
			end,
			set = function(v)
				setField("effet", v, "effet")
			end,
		})
		self:_note(S6, "Rebond : dans le jeu, le bouton grossit au survol et s'enfonce au clic (essaie avec « Aperçu »).")
	end

	-- BLOCS DE CET ÉLÉMENT
	local S7 = section("BLOCS DE CET ÉLÉMENT")
	S7.n += 1
	local list = makeFrame({
		Name = "Blocs",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = S7.n,
		Parent = S7.frame,
	})
	Util.create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	self._linkListFrame = list
	self._linkListId = id
	self:_renderLinkList()

	-- Bouton : « Ajouter un script au clic »
	if t == "bouton" then
		order += 1
		local holder = makeFrame({
			Name = "ScriptAuClic",
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = order * 2,
			Parent = self.propsScroll,
		})
		Util.create("UIPadding", {
			PaddingTop = UDim.new(0, 16),
			PaddingBottom = UDim.new(0, 16),
			PaddingLeft = UDim.new(0, 16),
			PaddingRight = UDim.new(0, 16),
			Parent = holder,
		})
		Util.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })
		local button = makeButton({
			Name = "AjouterScript",
			Text = "Ajouter un script au clic",
			Font = Theme.Fonts.UIBold,
			TextSize = ts(13),
			TextColor3 = WHITE,
			BackgroundColor3 = C.Accent,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = 1,
			Parent = holder,
		})
		Util.corner(button, 9)
		local disconnectHover = anim("hover", button, C.Accent, C.AccentHover)
		if type(disconnectHover) == "function" then
			table.insert(self._propConns, { Disconnect = disconnectHover })
		end
		local disconnectPress = anim("press", button)
		if type(disconnectPress) == "function" then
			table.insert(self._propConns, { Disconnect = disconnectPress })
		end
		local explain = makeLabel({
			Text = "",
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = 2,
			Parent = holder,
		})
		self:_conn(button.MouseButton1Click, function()
			self:addClickScript(id)
		end, self._propConns)
		table.insert(self._propUpdaters, function()
			local e = getEl()
			if e == nil or button.Parent == nil then
				return
			end
			if self:_findClickHat(e.name) ~= nil then
				button.Text = "Voir le script au clic"
				explain.Text = "« Quand le bouton " .. e.name .. " est cliqué » existe déjà : clique pour le retrouver dans les blocs de l'écran."
			else
				button.Text = "Ajouter un script au clic"
				explain.Text = "Pose « Quand le bouton " .. e.name .. " est cliqué » dans les blocs de l'écran, juste en dessous."
			end
		end)
	end
end

-- « Blocs de cet élément » : une carte par pile de blocs qui le nomme (clic : la montrer)
function GuiEditor:_renderLinkList()
	local list = self._linkListFrame
	if list == nil or list.Parent == nil then
		return
	end
	self._linkConns = self._linkConns or {}
	disconnectAll(self._linkConns)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local el = self.doc and self.doc:get(self._linkListId)
	if el == nil then
		return
	end
	local function info(text)
		makeLabel({
			Text = text,
			TextSize = ts(11),
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = 100,
			Parent = list,
		})
	end
	if self._linkedModel == nil then
		info("Les blocs de l'écran ne sont pas disponibles pour le moment.")
		return
	end
	local entries = self:_linksOf(el.name)
	if #entries == 0 then
		info("Aucun bloc n'utilise encore « " .. el.name .. " ». Dans les blocs de l'écran, choisis son nom dans un bloc Interface.")
		return
	end
	for i, entry in ipairs(entries) do
		if i > MAX_LINK_CARDS then
			info("… et " .. tostring(#entries - MAX_LINK_CARDS) .. " autre(s)")
			break
		end
		local card = makeButton({
			Name = "Bloc",
			BackgroundColor3 = LINK_CARD,
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = i,
			Parent = list,
		})
		Util.corner(card, 8)
		Util.stroke(card, LINK_CARD_STROKE, 1)
		makeLabel({
			Text = "◆  " .. entry.text,
			Font = Theme.Fonts.UIBold,
			TextSize = ts(12),
			TextColor3 = LINK_CARD_TEXT,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, 0),
			Parent = card,
		})
		self:_conn(card.MouseEnter, function()
			card.BackgroundColor3 = LINK_CARD_HOVER
			self:_tooltip("Clique pour voir ce bloc dans « Blocs de l'écran ».")
		end, self._linkConns)
		self:_conn(card.MouseLeave, function()
			card.BackgroundColor3 = LINK_CARD
			self:_hideTooltip()
		end, self._linkConns)
		self:_conn(card.MouseButton1Click, function()
			self:_hideTooltip()
			self:_focusBlock(entry.rootId)
		end, self._linkConns)
	end
end

---------------------------------------------------------------------------
-- Document ouvert
---------------------------------------------------------------------------

function GuiEditor:_setDoc(doc, screenGui, savedName)
	self:_cancelTracking()
	if self._docConn ~= nil then
		pcall(function()
			self._docConn:Disconnect()
		end)
		self._docConn = nil
	end
	local old = self.doc
	self.doc = doc
	self._screenGui = screenGui
	self._savedName = savedName
	self._collapsed = {}
	self._hoverId = nil
	self._lastClick = nil
	self._pasteCount = 0
	self._popAfterBuild = nil
	if old ~= nil and old ~= doc and type(old.destroy) == "function" then
		pcall(old.destroy, old)
	end
	if doc ~= nil then
		self._docConn = doc.Changed:Connect(function(reason)
			self:_onDocChanged(doc, reason)
		end)
	end
	if doc == nil and self._previewing then
		self._previewing = false
		self.catcher.Visible = true
		self.banner.Visible = false
		self.PreviewChanged:Fire(false)
	end
	-- les modèles se replient quand l'écran a déjà des éléments (les calques restent visibles)
	if doc == nil then
		self:_setSectionOpen("modeles", true)
	elseif #doc.tops > 0 then
		self:_setSectionOpen("modeles", false)
	end
	self._propsKey = nil
	self:_setSelection({}, true)
	self:_refreshAll()
	-- App remplace le Model des blocs de l'écran juste après (nouvel écran) : les liens suivent
	self:_schedule("syncModel", LINKS_DELAY, function()
		self:_syncModel(true)
	end)
end

function GuiEditor:_onDocChanged(doc, reason)
	if self._destroyed or doc ~= self.doc then
		return
	end
	self:_setSelection(self._sel) -- les éléments disparus (annuler, supprimer) quittent la sélection
	self:_schedule("rebuild", REBUILD_DELAY, function()
		self:_rebuildPreview()
	end)
	self:_schedule("panels", PANELS_DELAY, function()
		self:_renderLayers()
		self:_refreshProps(false)
		self:_syncModel(true) -- (liens recalculés, avec le Model actuel des blocs de l'écran)
	end)
	self:_updateOverlay()
	self.DocChanged:Fire(reason, {})
end

function GuiEditor:_refreshAll()
	if self._destroyed then
		return
	end
	self:_layoutPreview()
	self:_rebuildPreview()
	self:_renderLayers()
	self:_refreshProps(false)
	self:_refreshEmpty()
	self:_syncModel(true)
	self:_updateOverlay()
end

-- Un autre écran est ouvert : App est prévenue AVANT DocChanged (deps.onScreenChanged, elle ignore
-- l'appel quand c'est elle qui a demandé ce changement) pour charger les blocs de cet écran.
-- info = { screenGui = ScreenGui|nil, templateId = id|nil, reason = texte }
function GuiEditor:_notifyScreen(info)
	local fn = self.deps.onScreenChanged
	if type(fn) == "function" then
		local ok, err = pcall(fn, info)
		if not ok then
			warn("[Blocs FR] Studio d'interface : " .. tostring(err))
		end
	end
end

---------------------------------------------------------------------------
-- API (SPEC §21.8)
---------------------------------------------------------------------------

-- Ouvre un écran enregistré (ou l'écran Blocs FR qui contient screenGui). nil : plus d'écran.
function GuiEditor:openScreen(screenGui)
	if self._destroyed then
		return false
	end
	if screenGui == nil then
		self:_setDoc(nil, nil, nil)
		self:_notifyScreen({ reason = "fermer" })
		self.DocChanged:Fire("fermer", {})
		return true
	end
	local target = GuiStorage.screenOf(screenGui) or screenGui
	local ok, doc, err, warnings = pcall(GuiStorage.load, target)
	if not ok then
		err = tostring(doc)
		doc = nil
	end
	if doc == nil then
		local message = err or "Impossible d'ouvrir cet écran."
		self:_toast(message, "error")
		return false, message
	end
	local name = nil
	if typeof(target) == "Instance" then
		name = target.Name
	end
	self:_setDoc(doc, target, name)
	self:_notifyScreen({ screenGui = target, reason = "ouvrir" })
	if type(warnings) == "table" and warnings[1] ~= nil then
		self:_status("Écran « " .. doc.name .. " » ouvert : " .. tostring(warnings[1]), "warning")
	else
		self:_status("Écran « " .. doc.name .. " » ouvert.", "info")
	end
	self.DocChanged:Fire("ouvrir", { screenGui = target, warnings = warnings })
	return true
end

-- Nouvel écran vide (nom libre dans StarterGui : « Écran », « Écran 2 »…). Renvoie le document.
function GuiEditor:newScreen(name)
	if self._destroyed then
		return nil
	end
	local base = GuiDoc.cleanName(name) or GuiDoc.DEFAULT_NAME
	local okName, free = pcall(GuiStorage.freeName, base)
	if not okName or type(free) ~= "string" then
		free = base
	end
	local doc = GuiDoc.new(free)
	self:_setDoc(doc, nil, nil)
	self:_notifyScreen({ reason = "nouveau" })
	self:_status("Nouvel écran « " .. doc.name .. " » : glisse des éléments dessus (Bouton, Texte…).", "info")
	self.DocChanged:Fire("nouveau", {})
	return doc
end

-- Nouvel écran à partir d'un modèle (renommé s'il le faut : « Menu 2 »). Renvoie ok, entrée
-- (entrée.blocs = blocs du modèle pour le script de l'écran, déjà renommés).
function GuiEditor:insertTemplate(templateId)
	if self._destroyed then
		return false
	end
	if GuiTemplates == nil or type(GuiTemplates.get) ~= "function" then
		self:_toast("Les modèles d'interface ne sont pas disponibles.", "error")
		return false
	end
	local ok, entry = pcall(GuiTemplates.get, templateId)
	if not ok or type(entry) ~= "table" or type(entry.doc) ~= "table" then
		self:_toast("Modèle d'interface introuvable : " .. tostring(templateId), "error")
		return false
	end
	local base = entry.screen or entry.doc.name or GuiDoc.DEFAULT_NAME
	local okName, free = pcall(GuiStorage.freeName, base)
	if okName and type(free) == "string" and free ~= entry.doc.name and type(GuiTemplates.renameScreen) == "function" then
		pcall(GuiTemplates.renameScreen, entry, free)
	end
	local doc = GuiDoc.fromData(entry.doc)
	if doc == nil then
		self:_toast("Ce modèle n'a pas pu être lu.", "error")
		return false
	end
	self._staggerAfterBuild = true
	self:_setDoc(doc, nil, nil)
	self:_notifyScreen({ templateId = templateId, reason = "modele" })
	self.DocChanged:Fire("modele", { template = entry, templateId = templateId, blocs = entry.blocs })
	self:_toast(
		"Modèle « " .. tostring(entry.title or templateId) .. " » prêt : l'écran « " .. doc.name .. " » n'est pas encore enregistré.",
		"success"
	)
	return true, entry
end

-- Enregistre l'écran dans StarterGui. Renvoie true, screenGui ou false, erreurFR.
function GuiEditor:save()
	if self._destroyed then
		return false, "Le Studio d'interface est fermé."
	end
	local doc = self.doc
	if doc == nil then
		return false, "Aucun écran à enregistrer."
	end
	if self._tracking ~= nil then
		self:_cancelTracking()
	end
	local ok, screenGui, err = pcall(GuiStorage.save, doc, self._savedName)
	if not ok then
		return false, "Erreur pendant l'enregistrement de l'écran : " .. tostring(screenGui)
	end
	if screenGui == nil then
		return false, err or "L'écran n'a pas pu être enregistré."
	end
	self._screenGui = screenGui
	self._savedName = doc.name
	self:_updateProps()
	self.DocChanged:Fire("enregistrer", { screenGui = screenGui })
	return true, screenGui
end

-- Renomme l'écran ouvert (son ScreenGui suit au prochain enregistrement) ; les blocs de l'écran qui
-- le nomment suivent. Renvoie true ou false, erreurFR. (Ajout : « Renommer l'écran… » d'App.)
function GuiEditor:renameScreen(text)
	if self._destroyed then
		return false, "Le Studio d'interface est fermé."
	end
	return self:_renameScreen(text)
end

function GuiEditor:getDoc()
	return self.doc
end

-- Vrai si l'écran a des changements à enregistrer (un écran jamais enregistré qui a des éléments aussi)
function GuiEditor:isDirty()
	local doc = self.doc
	if doc == nil then
		return false
	end
	if doc.dirty then
		return true
	end
	return self:getScreenGui() == nil and #doc.tops > 0
end

-- Le ScreenGui enregistré de l'écran ouvert (nil s'il n'est pas, ou plus, dans le jeu)
function GuiEditor:getScreenGui()
	local screenGui = self._screenGui
	if typeof(screenGui) == "Instance" and screenGui.Parent ~= nil then
		return screenGui
	end
	return nil
end

function GuiEditor:selectElement(id)
	if id == nil then
		self:_setSelection({})
	else
		self:_setSelection({ id })
	end
end

function GuiEditor:getSelection()
	return table.clone(self._sel)
end

function GuiEditor:highlightByName(name)
	if type(name) ~= "string" or name == "" then
		name = nil
	end
	-- (appelé au survol des blocs de l'écran : bon moment pour voir si App a changé leur Model)
	self:_syncModel(false)
	if name == self._highlightName then
		return
	end
	self._highlightName = name
	self:_updateHighlight()
end

function GuiEditor:setDevice(device)
	if DEVICES[device] == nil then
		return false
	end
	if device ~= self._device then
		self._device = device
		self:_layoutPreview()
	end
	return true
end

function GuiEditor:getDevice()
	return self._device
end

function GuiEditor:_setPreviewing(on)
	on = on == true
	if on and self.doc == nil then
		return
	end
	if on == self._previewing then
		return
	end
	self:_cancelTracking()
	self._previewing = on
	self.catcher.Visible = not on
	self.banner.Visible = on
	self:_setHover(nil)
	self:_layoutPreview()
	self:_rebuildPreview()
	self:_updateOverlay()
	if on then
		anim("popIn", self.banner, 0.9)
		self:_status("Aperçu : essaie les boutons comme dans le jeu. « Quitter l'aperçu » pour revenir à l'édition.", "info")
	else
		self:_status("Retour à l'édition de l'écran.", "info")
	end
	self.PreviewChanged:Fire(on)
end

-- Aperçu interactif (les boutons réagissent ; rien ne se modifie ; les scripts ne tournent pas)
function GuiEditor:togglePreview()
	self:_setPreviewing(not self._previewing)
	return self._previewing
end

function GuiEditor:isPreviewing()
	return self._previewing
end

function GuiEditor:undo()
	local doc = self.doc
	if doc == nil or self._tracking ~= nil then
		return false
	end
	return doc:undo()
end

function GuiEditor:redo()
	local doc = self.doc
	if doc == nil or self._tracking ~= nil then
		return false
	end
	return doc:redo()
end

function GuiEditor:canUndo()
	return self.doc ~= nil and self.doc:canUndo()
end

function GuiEditor:canRedo()
	return self.doc ~= nil and self.doc:canRedo()
end

-- À appeler quand App remplace le Model des blocs de l'écran (le Studio le vérifie aussi seul)
function GuiEditor:refreshLinks()
	self:_syncModel(true)
end

function GuiEditor:getDebugState()
	local doc = self.doc
	local count = 0
	if doc ~= nil then
		for _ in pairs(doc.elements) do
			count += 1
		end
	end
	local primary = self:_primary()
	local el = primary and doc and doc:get(primary)
	local links = {}
	for name, entry in pairs(self._links) do
		links[name] = #entry.roots
	end
	local screenGui = self:getScreenGui()
	local path = nil
	if screenGui ~= nil and Storage ~= nil and type(Storage.pathOf) == "function" then
		pcall(function()
			path = Storage.pathOf(screenGui)
		end)
	end
	local buildErrors = 0
	if self._built ~= nil and type(self._built.errors) == "table" then
		buildErrors = #self._built.errors
	end
	return {
		screen = doc and doc.name or nil,
		uid = doc and doc.uid or nil,
		saved = screenGui ~= nil,
		screenPath = path,
		dirty = self:isDirty(),
		elementCount = count,
		selected = primary,
		selectedName = el and el.name or nil,
		selection = table.clone(self._sel),
		device = self._device,
		previewing = self._previewing,
		zoom = self._zoom,
		k = self._k,
		screenSize = { self._screen.w, self._screen.h },
		canUndo = self:canUndo(),
		canRedo = self:canRedo(),
		built = self._built ~= nil,
		buildErrors = buildErrors,
		links = links,
		hasModel = self._linkedModel ~= nil,
		highlight = self._highlightName,
		tracking = self._tracking ~= nil,
	}
end

-- État à garder quand App est reconstruite (paramètres) : écran non enregistré compris
function GuiEditor:exportState()
	local doc = self.doc
	local data = nil
	if doc ~= nil then
		local ok, serialized = pcall(doc.serialize, doc)
		if ok then
			data = serialized
		end
	end
	return {
		doc = data,
		dirty = self:isDirty(),
		savedName = self._savedName,
		device = self._device,
		decor = self._decor,
		selection = table.clone(self._sel),
	}
end

function GuiEditor:importState(state)
	if self._destroyed or type(state) ~= "table" then
		return false
	end
	if DEVICES[state.device] ~= nil then
		self._device = state.device
	end
	if type(state.decor) == "boolean" then
		self._decor = state.decor
		self:_applyDecor()
	end
	if type(state.doc) ~= "table" then
		self:_layoutPreview()
		return false
	end
	local doc = GuiDoc.fromData(state.doc)
	if doc == nil then
		return false
	end
	local screenGui = nil
	if type(state.savedName) == "string" then
		local ok, found = pcall(GuiStorage.find, state.savedName)
		if ok then
			screenGui = found
		end
	end
	local savedName = nil
	if screenGui ~= nil then
		savedName = state.savedName
	end
	self:_setDoc(doc, screenGui, savedName)
	if state.dirty == true and screenGui ~= nil then
		-- NOTE: les changements non enregistrés restent signalés (le document n'a qu'un instantané)
		doc.dirty = true
		doc._savedIndex = nil
	end
	if type(state.selection) == "table" then
		self:_setSelection(state.selection)
	end
	self.DocChanged:Fire("restaurer", { screenGui = screenGui })
	return true
end

function GuiEditor:destroy()
	if self._destroyed then
		return
	end
	self:_cancelTracking()
	self:_hideTooltip()
	self._destroyed = true
	if self._glowStop ~= nil then
		pcall(self._glowStop)
		self._glowStop = nil
	end
	disconnectAll(self.connections)
	disconnectAll(self._propConns)
	disconnectAll(self._layerConns)
	disconnectAll(self._emptyConns)
	disconnectAll(self._previewConns)
	disconnectAll(self._linkConns or {})
	for _, fn in ipairs(self._cleanups) do
		pcall(fn)
	end
	self._cleanups = {}
	if self._docConn ~= nil then
		pcall(function()
			self._docConn:Disconnect()
		end)
		self._docConn = nil
	end
	if self._linkedConn ~= nil then
		pcall(function()
			self._linkedConn:Disconnect()
		end)
		self._linkedConn = nil
	end
	if self.doc ~= nil and type(self.doc.destroy) == "function" then
		pcall(self.doc.destroy, self.doc)
	end
	self.doc = nil
	self._built = nil
	for _, frame in ipairs({ self.leftRoot, self.previewRoot, self.rightRoot }) do
		if typeof(frame) == "Instance" then
			pcall(function()
				frame:Destroy()
			end)
		end
	end
	for _, dummy in ipairs(self._dummies) do
		pcall(function()
			dummy:Destroy()
		end)
	end
	self.SelectionChanged:Destroy()
	self.DocChanged:Destroy()
	self.PreviewChanged:Destroy()
end

return GuiEditor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">GuiStorage</string><ProtectedString name="Source"><![CDATA[-- GuiStorage : enregistre les écrans du Studio d'interface dans StarterGui et les relit (SPEC §21.4).
--
-- Un écran = un ScreenGui enfant de StarterGui avec l'attribut « BlocsFR_GUI » (true). Il contient :
--   * « Racine » : le CanvasGroup construit par GuiBuild (k = 1) à partir du GuiDoc ;
--   * « BlocsFR_Interface » (+ _2, _3… au-delà de 150 000 caractères) : le GuiDoc en JSON ;
--   * « BlocsFR_Effets » : le LocalScript des effets (GuiBuild.EFFECTS_SOURCE) ;
--   * tout le reste est à l'utilisateur et n'est jamais touché : le script de l'écran (« BlocsLocal »,
--     enregistré par Storage), ses propres scripts et objets.
--
-- NOTE: ajouts à la SPEC :
--   * save(doc, nil) (écran jamais enregistré) refuse aussi d'écraser un AUTRE écran Blocs FR du même
--     nom : on compare doc.uid à celui du JSON enregistré (même uid = même écran, il est mis à jour) ;
--   * load renvoie aussi les avertissements de GuiDoc.fromData (3e valeur) ; le nom et les
--     propriétés de l'écran sont relus sur le ScreenGui (l'utilisateur a pu les changer dans Studio) ;
--   * GuiStorage.freeName(base) -> nom d'écran libre dans StarterGui (« Menu », « Menu 2 »…) ;
--   * GuiStorage.screenOf(inst) -> l'écran Blocs FR qui contient inst (ou inst lui-même), ou nil ;
--   * GuiStorage.isScreen(inst) -> bool.
-- Les fonctions qui modifient le jeu (save, remove) sont enregistrées dans l'historique de Studio
-- (Annuler / Rétablir) ; les autres ne modifient rien et ne cèdent jamais la main.

local HttpService = game:GetService("HttpService")

local Util = require(script.Parent.Util)
local GuiDoc = require(script.Parent.GuiDoc)
local GuiBuild = require(script.Parent.GuiBuild)
local Storage = require(script.Parent.Storage)

local GuiStorage = {}

GuiStorage.ATTR = "BlocsFR_GUI"
GuiStorage.DATA_NAME = "BlocsFR_Interface"
GuiStorage.RECORDING_SAVE = "Blocs FR : enregistrer l'écran"
GuiStorage.RECORDING_REMOVE = "Blocs FR : supprimer l'écran"

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function getService(name)
	local ok, service = pcall(function()
		return game:GetService(name)
	end)
	if ok then
		return service
	end
	return nil
end

local function starterGui()
	return getService("StarterGui")
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in pairs(a) do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

-- Ordre alphabétique sans tenir compte des accents ni des majuscules
local function nameLess(a, b)
	local fa, fb = Util.fold(a.name), Util.fold(b.name)
	if fa ~= fb then
		return fa < fb
	end
	return a.name < b.name
end

local function decodeJson(json)
	if type(json) ~= "string" or json == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

-- Vrai si inst est un écran créé par Blocs FR (ScreenGui avec l'attribut BlocsFR_GUI)
function GuiStorage.isScreen(inst)
	if typeof(inst) ~= "Instance" then
		return false
	end
	local ok, result = pcall(function()
		return inst:IsA("ScreenGui") and inst:GetAttribute(GuiStorage.ATTR) == true
	end)
	return ok and result == true
end

-- Tous les écrans (LayerCollector) enfants de StarterGui qui portent ce nom
local function screensNamed(name)
	local out = {}
	local sg = starterGui()
	if sg == nil then
		return out
	end
	for _, child in ipairs(sg:GetChildren()) do
		if child.Name == name and child:IsA("LayerCollector") then
			table.insert(out, child)
		end
	end
	return out
end

-- uid du GuiDoc enregistré dans un écran (ou nil)
local function savedUid(screenGui)
	local data = decodeJson(GuiBuild.readData(screenGui))
	if data ~= nil and type(data.uid) == "string" then
		return data.uid
	end
	return nil
end

---------------------------------------------------------------------------
-- Historique de Studio
---------------------------------------------------------------------------

local function beginRecording(history, name)
	if history == nil then
		return nil
	end
	local ok, recording = pcall(function()
		return history:TryBeginRecording(name, name)
	end)
	if ok and recording ~= nil then
		return recording
	end
	pcall(function()
		history:SetWaypoint("Blocs FR : avant « " .. name .. " »")
	end)
	return nil
end

local function finishRecording(history, recording, success, name)
	if history == nil then
		return
	end
	if recording ~= nil then
		local operation = Enum.FinishRecordingOperation.Commit
		if not success then
			-- en cas d'échec, on annule les modifications partielles
			operation = Enum.FinishRecordingOperation.Cancel
		end
		local ok = pcall(function()
			history:FinishRecording(recording, operation)
		end)
		if ok then
			return
		end
	end
	pcall(function()
		history:SetWaypoint(name)
	end)
end

-- Code d'un script : ScriptEditorService:UpdateSourceAsync (script ouvert dans un onglet), sinon .Source
local function setSource(scriptInst, code)
	local editor = getService("ScriptEditorService")
	if editor ~= nil and scriptInst.Parent ~= nil then
		local ok = pcall(function()
			editor:UpdateSourceAsync(scriptInst, function()
				return code
			end)
		end)
		if ok then
			return
		end
	end
	scriptInst.Source = code
end

---------------------------------------------------------------------------
-- Lecture
---------------------------------------------------------------------------

-- { { name = "Menu", instance = ScreenGui } } : les écrans Blocs FR de StarterGui, triés par nom
function GuiStorage.list()
	local out = {}
	local sg = starterGui()
	if sg == nil then
		return out
	end
	for _, child in ipairs(sg:GetChildren()) do
		if GuiStorage.isScreen(child) then
			table.insert(out, { name = child.Name, instance = child })
		end
	end
	table.sort(out, nameLess)
	return out
end

-- L'écran Blocs FR de StarterGui qui porte ce nom, ou nil
function GuiStorage.find(name)
	if type(name) ~= "string" or name == "" then
		return nil
	end
	for _, screen in ipairs(screensNamed(name)) do
		if GuiStorage.isScreen(screen) then
			return screen
		end
	end
	return nil
end

-- L'écran Blocs FR qui contient inst (inst lui-même s'il en est un), ou nil
function GuiStorage.screenOf(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if GuiStorage.isScreen(inst) then
		return inst
	end
	local ok, ancestor = pcall(function()
		return inst:FindFirstAncestorOfClass("ScreenGui")
	end)
	while ok and ancestor ~= nil do
		if GuiStorage.isScreen(ancestor) then
			return ancestor
		end
		ok, ancestor = pcall(function()
			return ancestor:FindFirstAncestorOfClass("ScreenGui")
		end)
	end
	return nil
end

-- Relit le GuiDoc d'un écran. Renvoie doc ou nil, erreurFR, warnings (textes FR).
function GuiStorage.load(screenGui)
	if typeof(screenGui) ~= "Instance" then
		return nil, "Aucun écran à ouvrir.", {}
	end
	local json = GuiBuild.readData(screenGui)
	if json == nil or json == "" then
		return nil,
			"L'écran « "
				.. screenGui.Name
				.. " » n'a pas de données du Studio d'interface (« "
				.. GuiStorage.DATA_NAME
				.. " » manquant) : il ne peut pas être ouvert.",
			{}
	end
	local data = decodeJson(json)
	if data == nil then
		return nil, "Les données de l'écran « " .. screenGui.Name .. " » sont illisibles (JSON invalide).", {}
	end
	-- Le ScreenGui fait foi pour le nom et les propriétés de l'écran (modifiables dans Studio)
	local clean = GuiDoc.cleanName(screenGui.Name)
	if clean ~= nil then
		data.name = clean
	end
	if screenGui:IsA("ScreenGui") then
		local props = {}
		if type(data.props) == "table" then
			props = data.props
		end
		props.visibleAuDemarrage = screenGui.Enabled
		props.garderApresMort = not screenGui.ResetOnSpawn
		props.ordre = screenGui.DisplayOrder
		data.props = props
	end
	local ok, doc, warnings = pcall(GuiDoc.fromData, data)
	if not ok then
		return nil, "Impossible de reconstruire l'écran « " .. screenGui.Name .. " » : " .. tostring(doc), {}
	end
	if doc == nil then
		local reason = "données invalides"
		if type(warnings) == "table" and warnings[1] ~= nil then
			reason = tostring(warnings[1])
		end
		return nil, "Impossible de reconstruire l'écran « " .. screenGui.Name .. " » : " .. reason, {}
	end
	return doc, nil, warnings or {}
end

-- Le script Blocs FR de l'écran (son LocalScript « BlocsLocal »), ou nil
function GuiStorage.screenScript(screenGui)
	if typeof(screenGui) ~= "Instance" then
		return nil
	end
	local found = Storage.findProjectScript(screenGui)
	if found == screenGui then
		return nil
	end
	return found
end

-- Noms des éléments d'un écran, mis en cache tant que son JSON ne change pas
local namesCache = setmetatable({}, { __mode = "k" })

local function screenElementNames(screenGui)
	local json = GuiBuild.readData(screenGui)
	local cached = namesCache[screenGui]
	if cached ~= nil and cached.json == json then
		return cached.names
	end
	local names = {}
	local data = decodeJson(json)
	if data ~= nil then
		local ok, doc = pcall(GuiDoc.fromData, data)
		if ok and doc ~= nil then
			for _, entry in ipairs(doc:names(nil)) do
				table.insert(names, { name = entry.name, type = entry.type })
			end
			doc:destroy()
		end
	end
	namesCache[screenGui] = { json = json, names = names }
	return names
end

-- { screens = { "Menu", … }, elements = { Menu = { { name = "Jouer", type = "bouton" }, … } } }
function GuiStorage.allNames()
	local screens = {}
	local elements = {}
	for _, entry in ipairs(GuiStorage.list()) do
		if elements[entry.name] == nil then
			table.insert(screens, entry.name)
			local list = {}
			local ok, names = pcall(screenElementNames, entry.instance)
			if ok and type(names) == "table" then
				for _, item in ipairs(names) do
					table.insert(list, { name = item.name, type = item.type })
				end
			end
			elements[entry.name] = list
		end
	end
	return { screens = screens, elements = elements }
end

-- Nom d'écran libre dans StarterGui à partir de base : « Menu », sinon « Menu 2 », « Menu 3 »…
function GuiStorage.freeName(base)
	local clean = GuiDoc.cleanName(base) or GuiDoc.DEFAULT_NAME
	if #screensNamed(clean) == 0 then
		return clean
	end
	local root, digits = string.match(clean, "^(.-) (%d+)$")
	local start = 2
	if root ~= nil and root ~= "" and #digits <= 6 then
		clean = root
		start = (tonumber(digits) or 1) + 1
	end
	for n = start, start + 10000 do
		local suffix = " " .. tostring(n)
		local stem = clean
		local length = utf8.len(stem) or #stem
		if length + #suffix > GuiDoc.MAX_NAME then
			local ok, offset = pcall(utf8.offset, stem, math.max(GuiDoc.MAX_NAME - #suffix, 1) + 1)
			if ok and type(offset) == "number" then
				stem = string.sub(stem, 1, offset - 1)
			end
		end
		local candidate = stem .. suffix
		if #screensNamed(candidate) == 0 then
			return candidate
		end
	end
	return clean
end

---------------------------------------------------------------------------
-- Écriture
---------------------------------------------------------------------------

-- Crée / met à jour le ScreenGui (appelé dans un pcall, dans l'enregistrement de l'historique)
local function writeScreen(sg, target, doc, json)
	local screenGui = target
	if screenGui == nil then
		screenGui = Instance.new("ScreenGui")
	end
	GuiBuild.applyScreenProps(screenGui, doc)

	-- Nouvelle Racine construite avant de retirer l'ancienne (aucune attente pendant la construction)
	local built = GuiBuild.build(doc, nil, { scale = 1 })
	for _, child in ipairs(screenGui:GetChildren()) do
		if child.Name == GuiBuild.ROOT_NAME then
			child.Parent = nil -- (Parent = nil plutôt que Destroy : « Annuler » de Studio fonctionne)
		end
	end
	built.racine.Parent = screenGui

	-- JSON (StringValue réutilisées, morceaux en trop retirés)
	GuiBuild.writeData(screenGui, json)

	-- LocalScript des effets : un seul, jamais marqué comme projet Blocs FR
	local effets = nil
	for _, child in ipairs(screenGui:GetChildren()) do
		if child.Name == GuiBuild.EFFECTS_NAME then
			if effets == nil and child:IsA("LocalScript") then
				effets = child
			else
				child.Parent = nil
			end
		end
	end
	if effets == nil then
		effets = Instance.new("LocalScript")
		effets.Name = GuiBuild.EFFECTS_NAME
		effets.Source = GuiBuild.EFFECTS_SOURCE
		effets.Parent = screenGui
	else
		local okRead, current = pcall(function()
			return effets.Source
		end)
		if not okRead or current ~= GuiBuild.EFFECTS_SOURCE then
			setSource(effets, GuiBuild.EFFECTS_SOURCE)
		end
	end
	if effets:GetAttribute(Storage.ATTR) ~= nil then
		effets:SetAttribute(Storage.ATTR, nil)
	end

	if screenGui.Parent ~= sg then
		screenGui.Parent = sg
	end

	-- Le script de l'écran garde le bon chemin d'origine après un renommage (ErrorWatcher s'en sert)
	local projectScript = GuiStorage.screenScript(screenGui)
	if projectScript ~= nil then
		pcall(function()
			projectScript:SetAttribute(Storage.ORIGIN_ATTR, Storage.pathOf(projectScript))
		end)
	end
	return screenGui
end

-- Enregistre l'écran dans StarterGui. previousName = nom de l'écran à son dernier enregistrement
-- (nil s'il n'a jamais été enregistré). Renvoie screenGui ou nil, erreurFR.
function GuiStorage.save(doc, previousName)
	if type(doc) ~= "table" or type(doc.serialize) ~= "function" then
		return nil, "Aucun écran à enregistrer."
	end
	local sg = starterGui()
	if sg == nil then
		return nil, "StarterGui est introuvable : impossible d'enregistrer l'écran."
	end
	local name = GuiDoc.cleanName(doc.name)
	if name == nil then
		return nil, "Le nom de l'écran est invalide."
	end
	if type(previousName) ~= "string" or previousName == "" then
		previousName = nil
	end

	local okData, data = pcall(function()
		return doc:serialize()
	end)
	if not okData or type(data) ~= "table" then
		return nil, "Impossible de préparer les données de l'écran : " .. tostring(data)
	end
	local okJson, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not okJson or type(json) ~= "string" then
		return nil, "Impossible d'encoder l'écran en JSON : " .. tostring(json)
	end

	-- Quel ScreenGui mettre à jour ?
	local target = nil
	local sameName = screensNamed(name)
	for _, screen in ipairs(sameName) do
		if not GuiStorage.isScreen(screen) then
			return nil, "« " .. name .. " » existe déjà dans StarterGui mais n'a pas été créé avec Blocs FR : choisis un autre nom."
		end
	end
	if previousName ~= nil and previousName ~= name then
		-- Renommage : le nouveau nom doit être libre
		if #sameName > 0 then
			return nil, "Un écran « " .. name .. " » existe déjà."
		end
		target = GuiStorage.find(previousName) -- nil : l'ancien écran a disparu, on le recrée
	elseif #sameName > 0 then
		target = sameName[1]
		if previousName == nil and savedUid(target) ~= doc.uid then
			-- écran jamais enregistré : ne pas écraser un AUTRE écran du même nom
			return nil, "Un écran « " .. name .. " » existe déjà."
		end
	end

	local history = getService("ChangeHistoryService")
	local recording = beginRecording(history, GuiStorage.RECORDING_SAVE)
	local okWrite, result = pcall(writeScreen, sg, target, doc, json)
	finishRecording(history, recording, okWrite, GuiStorage.RECORDING_SAVE)
	if not okWrite then
		return nil, "Impossible d'enregistrer l'écran « " .. name .. " » : " .. tostring(result)
	end

	-- Enregistré : seulement si rien n'a changé pendant l'écriture (UpdateSourceAsync peut céder la main)
	pcall(function()
		if deepEqual(doc:serialize(), data) and type(doc.markSaved) == "function" then
			doc:markSaved()
		end
	end)
	return result, nil
end

-- Supprime l'écran (Parent = nil, dans l'historique : « Annuler » de Studio le fait revenir).
-- L'interface demande confirmation avant. Renvoie ok, erreurFR.
function GuiStorage.remove(screenGui)
	if typeof(screenGui) ~= "Instance" then
		return false, "Aucun écran à supprimer."
	end
	local history = getService("ChangeHistoryService")
	local recording = beginRecording(history, GuiStorage.RECORDING_REMOVE)
	local ok, err = pcall(function()
		screenGui.Parent = nil
	end)
	finishRecording(history, recording, ok, GuiStorage.RECORDING_REMOVE)
	if not ok then
		return false, "Impossible de supprimer l'écran « " .. tostring(screenGui.Name) .. " » : " .. tostring(err)
	end
	namesCache[screenGui] = nil
	return true, nil
end

return GuiStorage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">GuiTemplates</string><ProtectedString name="Source"><![CDATA[-- GuiTemplates : les 8 modèles d'écran du Studio d'interface (SPEC §21.5, board ModelesGUI.dc.html).
--
-- GuiTemplates.list() -> { entrée, … } (ordre de la liste « Modèles d'interface »)
-- GuiTemplates.get(id, screenName|nil) -> entrée | nil
-- entrée = { id, title, description, screen, thumb = { {r,g,b}, {r,g,b} },
--            doc = <données GuiDoc (doc:serialize())>, blocs = <données Model, mode "local"> | nil }
--
-- Chaque appel construit des données neuves (tables à soi, nouvel uid d'écran) : l'appelant peut les
-- modifier. Les documents sont construits avec GuiDoc (chaque valeur est vérifiée comme si l'élément
-- avait été posé à la main) ; les blocs utilisent les ids et noms d'entrées exacts des Defs_*.lua et
-- les noms d'éléments exacts de la SPEC (ce sont eux que les enfants choisissent dans les blocs).
--
-- Mesures : le board dessine chaque écran en 640 × 360 ; les positions et tailles ci-dessous sont en
-- px de référence 1280 × 720 (× 2), relatives au coin haut-gauche du parent. Contours 3-4 px et
-- relief 5-8 px bleu nuit #0E1630 (SPEC §21.5), titres LuckiestGuy, textes FredokaOne.
-- NOTE: ajouts à la SPEC : champs « description » et « screen » (nom de l'écran) dans chaque entrée ;
-- get(id, screenName) et GuiTemplates.renameScreen(entrée, nom) renomment l'écran (nom déjà pris
-- dans StarterGui, par exemple « Menu 2 ») en mettant à jour les entrées « écran » des blocs qui le
-- visaient. Écarts au board : le décor du jeu derrière l'interface (ciel, herbe, nuages, maison,
-- confettis) n'est pas un élément ; les étoiles de « Victoire » sont des médailles rondes ; les
-- interrupteurs de « Paramètres » sont des boutons « OUI » / « NON » (SPEC) ; la barre d'objets du
-- HUD est décalée à droite du panneau de quête (sur le board, la case 1 le chevauche).

local GuiDoc = require(script.Parent.GuiDoc)

local okRegistry, Registry = pcall(function()
	return require(script.Parent.Registry)
end)
if not okRegistry then
	Registry = nil
end

local GuiTemplates = {}

local REF_W, REF_H = GuiDoc.REF_W, GuiDoc.REF_H

---------------------------------------------------------------------------
-- Couleurs et polices du « game kit » (board ModelesGUI)
---------------------------------------------------------------------------

local NUIT = { 14, 22, 48 } -- #0E1630 : contours, reliefs, fond des barres
local BLANC = { 255, 255, 255 }
local JAUNE = { 255, 211, 77 } -- #FFD34D : titres
local PASTILLE = { 30, 42, 74 } -- #1E2A4A : compteurs
local PANNEAU_HAUT, PANNEAU_BAS = { 43, 58, 103 }, { 30, 42, 74 } -- #2B3A67 -> #1E2A4A
local VERT_HAUT, VERT_BAS = { 111, 240, 143 }, { 47, 191, 90 } -- #6FF08F -> #2FBF5A
local JAUNE_HAUT, JAUNE_BAS = { 255, 224, 102 }, { 255, 183, 3 } -- #FFE066 -> #FFB703
local BLEU_HAUT, BLEU_BAS = { 124, 180, 255 }, { 59, 130, 246 } -- #7CB4FF -> #3B82F6
local ROUGE_HAUT, ROUGE_BAS = { 255, 138, 148 }, { 229, 56, 59 } -- #FF8A94 -> #E5383B
local GRIS_HAUT, GRIS_BAS = { 148, 163, 184 }, { 100, 116, 139 } -- #94A3B8 -> #64748B
local OR_HAUT, OR_BAS = { 255, 224, 102 }, { 245, 158, 11 } -- médailles d'or
local VERT = { 47, 191, 90 } -- #2FBF5A
local GRIS = { 100, 116, 139 } -- #64748B
local BLEU = { 59, 130, 246 } -- #3B82F6
local VOILE = { 5, 8, 18 } -- voile sombre derrière les fenêtres
local CLAIR = { 201, 212, 245 } -- #C9D4F5 : textes secondaires

local POLICE_TITRE = "LuckiestGuy"
local POLICE_TEXTE = "FredokaOne"

-- Positions des piles de blocs (unités du canvas)
local MARGE = 40
local ECART = 40

---------------------------------------------------------------------------
-- Styles (tables de champs GuiDoc, SPEC §21.2)
---------------------------------------------------------------------------

-- Copie de base complétée / remplacée par extra (copie superficielle)
local function fusion(base, extra)
	local out = {}
	if type(base) == "table" then
		for key, value in pairs(base) do
			out[key] = value
		end
	end
	if type(extra) == "table" then
		for key, value in pairs(extra) do
			out[key] = value
		end
	end
	return out
end

-- Texte sans fond (extra peut lui donner un fond : transparence = 0, fond, arrondi, contour)
local function texte(contenu, police, taille, couleur, trait, extra)
	return fusion({
		texte = contenu,
		police = police,
		tailleTexte = taille,
		texteCouleur = couleur,
		texteContour = trait,
		texteContourCouleur = NUIT,
		transparence = 1,
		contour = 0,
		alignement = "centre",
	}, extra)
end

-- Bouton façon jeu : dégradé haut -> bas (bas = nil : couleur unie), contour et relief bleu nuit
local function bouton(contenu, haut, bas, taille, extra)
	return fusion({
		texte = contenu,
		police = POLICE_TEXTE,
		tailleTexte = taille,
		texteCouleur = BLANC,
		texteContour = 3,
		texteContourCouleur = NUIT,
		fond = haut,
		fond2 = bas or false,
		transparence = 0,
		arrondi = 24,
		contour = 4,
		contourCouleur = NUIT,
		relief = 8,
		reliefCouleur = NUIT,
		effet = "rebond",
	}, extra)
end

-- Petit bouton (onglets, prix, interrupteurs) : contour 3, relief 6
local function petitBouton(contenu, haut, bas, taille, extra)
	return bouton(contenu, haut, bas, taille, fusion({ arrondi = 20, contour = 3, relief = 6 }, extra))
end

-- Cadre plat (sans relief ni contour par défaut)
local function cadre(haut, bas, extra)
	return fusion({
		fond = haut,
		fond2 = bas or false,
		transparence = 0,
		arrondi = 0,
		contour = 0,
		contourCouleur = NUIT,
		relief = 0,
	}, extra)
end

-- Panneau / fenêtre : dégradé, contour 4 et relief 8 bleu nuit
local function panneau(haut, bas, extra)
	return cadre(haut, bas, fusion({ arrondi = 36, contour = 4, relief = 8, reliefCouleur = NUIT }, extra))
end

-- Pastille arrondie bleu nuit (compteurs)
local function pastille(extra)
	return cadre(PASTILLE, nil, fusion({ arrondi = 30, contour = 3 }, extra))
end

-- Pièce d'or ronde
local function piece()
	return cadre({ 255, 236, 140 }, { 224, 155, 18 }, { arrondi = 22, contour = 3, contourCouleur = { 184, 119, 10 } })
end

-- Barre (fond bleu nuit, remplissage coloré, texte facultatif)
local function barre(valeur, couleur, extra)
	return fusion({
		valeur = valeur,
		barreCouleur = couleur,
		fond = NUIT,
		fond2 = false,
		transparence = 0,
		arrondi = 18,
		contour = 3,
		contourCouleur = NUIT,
		relief = 0,
		texte = "",
		police = POLICE_TEXTE,
		tailleTexte = 24,
		texteCouleur = BLANC,
		texteContour = 2,
		texteContourCouleur = NUIT,
	}, extra)
end

-- Voile plein écran derrière une fenêtre
local function voile(haut, bas, transparence)
	return cadre(haut, bas, { transparence = transparence })
end

-- Élément : rect = { gauche, haut, largeur, hauteur } en px de référence, relatif au parent
local function E(typeElement, nom, rect, props, enfants)
	return { type = typeElement, name = nom, rect = rect, props = props, enfants = enfants }
end

---------------------------------------------------------------------------
-- Les 8 modèles (ordre du board). piles = blocs de l'écran (forme compacte, voir convertirPiles).
---------------------------------------------------------------------------

