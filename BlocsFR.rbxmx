local function modeleParametres()
	local function ligne(nom, contenu, haut)
		return E("texte", nom, { 60, haut, 400, 44 }, texte(contenu, POLICE_TEXTE, 34, BLANC, 0, { alignement = "gauche" }))
	end
	local function interrupteur(nom, contenu, couleur, haut)
		return E("bouton", nom, { 596, haut, 120, 62 }, petitBouton(contenu, couleur, nil, 26, { arrondi = 28, texteContour = 2 }))
	end
	return {
		id = "parametres",
		title = "Paramètres",
		description = "Musique, effets sonores et ombres (boutons OUI / NON), barre de volume.",
		thumb = { { 51, 65, 85 }, { 30, 41, 59 } },
		ecran = { nom = "Paramètres", visible = false, ordre = 10 },
		elements = {
			E("cadre", "Voile", { 0, 0, 1280, 720 }, voile(VOILE, nil, 0.45)),
			E("cadre", "Fenêtre", { 260, 40, 760, 640 }, panneau({ 51, 65, 85 }, { 30, 41, 59 }), {
				E("texte", "Titre", { 0, 30, 760, 76 }, texte("PARAMÈTRES", POLICE_TITRE, 60, BLANC, 3)),
				ligne("Musique", "Musique", 148),
				interrupteur("MusiqueBouton", "OUI", VERT, 140),
				ligne("Sons", "Effets sonores", 236),
				interrupteur("SonsBouton", "OUI", VERT, 228),
				ligne("Ombres", "Ombres", 324),
				interrupteur("OmbresBouton", "NON", GRIS, 316),
				E("texte", "Volume", { 60, 412, 200, 44 }, texte("Volume", POLICE_TEXTE, 34, BLANC, 0, { alignement = "gauche" })),
				E("barre", "VolumeBarre", { 320, 424, 380, 24 }, barre(0.7, BLEU, { arrondi = 12 })),
				E("bouton", "Fermer", { 240, 500, 280, 88 }, bouton("FERMER", ROUGE_HAUT, ROUGE_BAS, 36)),
			}),
		},
		piles = {
			{
				{ "gui_quand_clic", BOUTON = "Fermer" },
				{ "gui_cacher_ecran", ECRAN = "Paramètres", EFFET = '"zoom"' },
			},
			{
				{ "gui_quand_clic", BOUTON = "MusiqueBouton" },
				{
					"ctrl_si_sinon",
					COND = { "op_egal", A = { "gui_texte_de", ELEMENT = "MusiqueBouton" }, B = "OUI" },
					DO = {
						{ "gui_texte", ELEMENT = "MusiqueBouton", TEXTE = "NON" },
						{ "gui_couleur", ELEMENT = "MusiqueBouton", COULEUR = GRIS },
					},
					ELSE = {
						{ "gui_texte", ELEMENT = "MusiqueBouton", TEXTE = "OUI" },
						{ "gui_couleur", ELEMENT = "MusiqueBouton", COULEUR = VERT },
					},
				},
			},
		},
	}
end

local function modeleVictoire()
	local function medaille(n, rect, haut, bas)
		return E("cadre", "Médaille " .. n, rect, cadre(haut, bas, { arrondi = math.floor(rect[3] / 2), contour = 4 }))
	end
	return {
		id = "victoire",
		title = "Victoire",
		description = "Médailles, récompenses, boutons Rejouer et Menu.",
		thumb = { { 255, 211, 77 }, { 255, 159, 28 } },
		ecran = { nom = "Victoire", visible = false, ordre = 20 },
		elements = {
			E("cadre", "Voile", { 0, 0, 1280, 720 }, voile({ 255, 200, 90 }, { 249, 115, 22 }, 0.15)),
			E("cadre", "Fenêtre", { 300, 92, 680, 548 }, panneau(PANNEAU_HAUT, PANNEAU_BAS), {
				E("texte", "Titre", { 0, -58, 680, 116 }, texte("VICTOIRE !", POLICE_TITRE, 96, JAUNE, 5)),
				medaille(1, { 160, 100, 96, 96 }, OR_HAUT, OR_BAS),
				medaille(2, { 282, 86, 116, 116 }, OR_HAUT, OR_BAS),
				medaille(3, { 424, 100, 96, 96 }, GRIS_HAUT, { 71, 85, 105 }),
				E("cadre", "Récompense", { 92, 264, 240, 60 }, pastille(), {
					E("texte", "RécompenseTexte", { 12, 6, 216, 48 }, texte("+120 pièces", POLICE_TEXTE, 30, BLANC, 0)),
				}),
				E(
					"texte",
					"XPGagné",
					{ 368, 264, 220, 60 },
					texte("+40 XP", POLICE_TEXTE, 30, { 233, 213, 255 }, 0, {
						fond = PASTILLE,
						transparence = 0,
						arrondi = 30,
						contour = 3,
						contourCouleur = NUIT,
					})
				),
				E("bouton", "Rejouer", { 52, 388, 272, 96 }, bouton("REJOUER", VERT_HAUT, VERT_BAS, 38)),
				E("bouton", "RetourMenu", { 356, 388, 272, 96 }, bouton("MENU", BLEU_HAUT, BLEU_BAS, 38)),
			}),
		},
		piles = {
			{
				{ "gui_quand_clic", BOUTON = "Rejouer" },
				{ "gui_cacher_ecran", ECRAN = "Victoire", EFFET = '"fondu"' },
			},
			{
				{ "gui_quand_clic", BOUTON = "RetourMenu" },
				{ "gui_cacher_ecran", ECRAN = "Victoire", EFFET = '"fondu"' },
				{ "gui_afficher_ecran", ECRAN = "Menu", EFFET = '"haut"' },
			},
		},
	}
end

local MODELES = {
	{ id = "menu", fabrique = modeleMenu },
	{ id = "hud", fabrique = modeleHud },
	{ id = "boutique", fabrique = modeleBoutique },
	{ id = "dialogue", fabrique = modeleDialogue },
	{ id = "annonces", fabrique = modeleAnnonces },
	{ id = "chargement", fabrique = modeleChargement },
	{ id = "parametres", fabrique = modeleParametres },
	{ id = "victoire", fabrique = modeleVictoire },
}

---------------------------------------------------------------------------
-- Construction du document (GuiDoc)
---------------------------------------------------------------------------

-- Données GuiDoc d'un modèle. Chaque élément est ancré en son centre (0,5 ; 0,5) ; x, y, w, h sont
-- convertis en fractions du parent. Erreur (attrapée par list / get) si un élément est refusé.
local function construireDoc(modele)
	local ecran = modele.ecran
	local doc = GuiDoc.new(ecran.nom)
	doc:setProp("visibleAuDemarrage", ecran.visible == true)
	doc:setProp("garderApresMort", ecran.garder ~= false)
	doc:setProp("ordre", ecran.ordre or 0)
	local function ajouter(spec, parentId, pw, ph)
		local rect = spec.rect
		local w, h = rect[3], rect[4]
		local props = fusion(spec.props, { name = spec.name, ax = 0.5, ay = 0.5 })
		local id = doc:add(spec.type, parentId, (rect[1] + w / 2) / pw, (rect[2] + h / 2) / ph, w / pw, h / ph, props)
		if id == nil then
			error("élément « " .. tostring(spec.name) .. " » refusé", 0)
		end
		if doc:get(id).name ~= spec.name then
			error("nom « " .. tostring(spec.name) .. " » refusé ou en double", 0)
		end
		for _, enfant in ipairs(spec.enfants or {}) do
			ajouter(enfant, id, w, h)
		end
	end
	local ok, err = pcall(function()
		for _, spec in ipairs(modele.elements) do
			ajouter(spec, nil, REF_W, REF_H)
		end
	end)
	local data = nil
	if ok then
		data = doc:serialize()
	end
	doc:destroy()
	if not ok then
		error(err, 0)
	end
	return data
end

---------------------------------------------------------------------------
-- Blocs de l'écran : forme compacte -> données du Model (SPEC §6)
--   pile = liste de blocs (le premier est un événement) ;
--   bloc = { "id_du_bloc", ENTREE = valeur | { "id_bloc_valeur", … }, DO = { … }, ELSE = { … } }
---------------------------------------------------------------------------

local function estBloc(valeur)
	return type(valeur) == "table" and type(valeur[1]) == "string"
end

local function clesTriees(spec)
	local cles = {}
	for cle in pairs(spec) do
		if type(cle) == "string" then
			table.insert(cles, cle)
		end
	end
	table.sort(cles)
	return cles
end

local function definition(defId)
	if Registry == nil then
		return nil
	end
	local ok, def = pcall(Registry.get, defId)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

-- Hauteurs estimées (unités du canvas, un peu larges) pour placer les piles l'une sous l'autre
local hauteurSuite

local function hauteurBloc(spec)
	local def = definition(spec[1])
	local forme = def and def.shape or "stack"
	if forme == "hat" then
		return 60
	elseif forme == "c" then
		return 44 + hauteurSuite(spec.DO) + 18
	elseif forme == "c2" then
		return 44 + hauteurSuite(spec.DO) + 32 + hauteurSuite(spec.ELSE) + 18
	end
	return 44
end

function hauteurSuite(liste)
	if type(liste) ~= "table" or #liste == 0 then
		return 24
	end
	local h = 0
	for _, spec in ipairs(liste) do
		h += hauteurBloc(spec)
	end
	return h
end

local function convertirPiles(piles)
	local blocks = {}
	local tops = {}
	local compteur = 0
	local construireSuite

	local function construireBloc(spec)
		compteur += 1
		local id = "b" .. compteur
		local entree = { def = spec[1], x = 0, y = 0 }
		blocks[id] = entree
		for _, cle in ipairs(clesTriees(spec)) do
			local valeur = spec[cle]
			if cle == "DO" or cle == "ELSE" then
				local tete = construireSuite(valeur)
				if tete ~= nil then
					entree.sub = entree.sub or {}
					entree.sub[cle] = tete
				end
			elseif estBloc(valeur) then
				entree.inputs = entree.inputs or {}
				entree.inputs[cle] = { block = construireBloc(valeur) }
			else
				local litteral = valeur
				if type(valeur) == "table" then
					litteral = { valeur[1], valeur[2], valeur[3] }
				end
				entree.inputs = entree.inputs or {}
				entree.inputs[cle] = { value = litteral }
			end
		end
		return id
	end

	function construireSuite(liste)
		local tete, precedent = nil, nil
		if type(liste) ~= "table" then
			return nil
		end
		for _, spec in ipairs(liste) do
			if estBloc(spec) then
				local id = construireBloc(spec)
				if precedent ~= nil then
					blocks[precedent].next = id
				else
					tete = id
				end
				precedent = id
			end
		end
		return tete
	end

	local y = MARGE
	for _, pile in ipairs(piles) do
		local tete = construireSuite(pile)
		if tete ~= nil then
			blocks[tete].x = MARGE
			blocks[tete].y = y
			table.insert(tops, tete)
			y += hauteurSuite(pile) + ECART
		end
	end
	return {
		format = "BlocsFR",
		version = 1,
		mode = "local",
		variables = {},
		tops = tops,
		blocks = blocks,
	}
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------

local function construireEntree(fabrique)
	local modele = fabrique()
	local entree = {
		id = modele.id,
		title = modele.title,
		description = modele.description,
		screen = modele.ecran.nom,
		thumb = {
			{ modele.thumb[1][1], modele.thumb[1][2], modele.thumb[1][3] },
			{ modele.thumb[2][1], modele.thumb[2][2], modele.thumb[2][3] },
		},
		doc = construireDoc(modele),
		blocs = nil,
	}
	if type(modele.piles) == "table" and #modele.piles > 0 then
		entree.blocs = convertirPiles(modele.piles)
	end
	return entree
end

-- Les 8 modèles, dans l'ordre du board (données neuves à chaque appel)
function GuiTemplates.list()
	local out = {}
	for _, item in ipairs(MODELES) do
		local ok, entree = pcall(construireEntree, item.fabrique)
		if ok then
			table.insert(out, entree)
		else
			warn("[Blocs FR] Modèle d'interface « " .. item.id .. " » ignoré : " .. tostring(entree))
		end
	end
	return out
end

-- Renomme l'écran d'une entrée (par exemple « Menu 2 » quand « Menu » existe déjà dans StarterGui) :
-- le nom du document et les entrées « écran » des blocs qui visaient l'ancien nom suivent (ainsi
-- que les chemins « Écran/Élément »). Nom invalide : rien ne change. Renvoie l'entrée.
function GuiTemplates.renameScreen(entree, nouveauNom)
	if type(entree) ~= "table" or type(entree.doc) ~= "table" then
		return entree
	end
	local propre = GuiDoc.cleanName(nouveauNom)
	if propre == nil then
		return entree
	end
	local ancien = entree.doc.name
	entree.doc.name = propre
	entree.screen = propre
	if ancien == propre or type(ancien) ~= "string" then
		return entree
	end
	local blocs = entree.blocs
	if type(blocs) ~= "table" or type(blocs.blocks) ~= "table" then
		return entree
	end
	local prefixe = ancien .. "/"
	for _, bloc in pairs(blocs.blocks) do
		local def = definition(bloc.def)
		if def ~= nil and type(bloc.inputs) == "table" then
			for _, spec in ipairs(def.inputs or {}) do
				local input = bloc.inputs[spec.name]
				if spec.kind == "gui" and type(input) == "table" and type(input.value) == "string" then
					if spec.filter == "ecran" and input.value == ancien then
						input.value = propre
					elseif string.sub(input.value, 1, #prefixe) == prefixe then
						input.value = propre .. "/" .. string.sub(input.value, #prefixe + 1)
					end
				end
			end
		end
	end
	return entree
end

-- Un modèle par son id (données neuves), renommé en screenName si celui-ci est donné ; nil si l'id
-- est inconnu (ou si le modèle ne se construit pas : avertissement dans la sortie)
function GuiTemplates.get(id, screenName)
	for _, item in ipairs(MODELES) do
		if item.id == id then
			local ok, entree = pcall(construireEntree, item.fabrique)
			if not ok then
				warn("[Blocs FR] Modèle d'interface « " .. item.id .. " » impossible à construire : " .. tostring(entree))
				return nil
			end
			if screenName ~= nil then
				GuiTemplates.renameScreen(entree, screenName)
			end
			return entree
		end
	end
	return nil
end

return GuiTemplates
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">HitboxPreview</string><ProtectedString name="Source"><![CDATA[-- HitboxPreview : prévisualiseur de hitbox en 3D et simulation « Voir ce qui va se passer »
-- (SPEC §27, planche « Hitbox.dc.html »). Demande : « un prévisualisateur de hitbox avec une hitbox et
-- un R6 ou un rig 3D… et un visualisateur de ce qui devrait se passer (animation, hitbox, si ça réussit
-- let's go, si raté bof) ».
--
-- API (SPEC §27) :
--   HitboxPreview.supports(defId) -> bool
--       tp_attaque_melee, tp_hitbox_degats, tp_hitbox, et "libre" (ouvert depuis un menu, sans bloc)
--   HitboxPreview.readBlock(model, blockId) -> params
--       { kind = defId | "libre", largeur, hauteur, profondeur, degats, portee, recharge,
--         impact = s (0,25 pour l'attaque toute prête, sinon 0), recul = force | nil,
--         calcule = { [ENTREE] = true } (entrées remplies par un bloc valeur : on prend la valeur par défaut) }
--   HitboxPreview.open(layer, deps) -> preview      (layer = calque des dialogues d'App)
--       deps = { host, dialogs, model = Model|nil, blockId = id|nil, onApply = fn(values) }
--       facultatifs : onClose = fn() (après la fermeture), targetPath = "Workspace.Épée",
--       mode = "server" | "local" | "module" (sinon model.mode), openSettings = fn("previsualisation")
--       values (onApply) = { LARGEUR = n, HAUTEUR = n, PROFONDEUR = n, DEGATS = n } ou { PORTEE = n, DEGATS = n } :
--       seulement les entrées du bloc sans bloc valeur branché. App fait setInput + commit("hitbox").
--   preview:close() ; preview:simulate() -> touché (bool) ; preview:getDebugState() -> { hit = bool|nil, params, … }
--   Extensions : HitboxPreview.box(params) -> CFrame (relatif à la racine), Vector3 (taille) ;
--                HitboxPreview.obbOverlap(cfA, demiA, cfB, demiB) -> bool ; preview:isOpen() -> bool
--
-- Géométrie = celle du jeu (Defs_ToutPrets, _tpCiblesDevant) : boîte largeur × hauteur × profondeur
-- (chaque côté entre 0,2 et 200 studs) placée à racine.CFrame * CFrame.new(0, 0, -(profondeur / 2 + 1)) :
-- elle commence 1 stud devant le centre du personnage. L'attaque toute prête (_tpAttaqueMelee) utilise
-- 5 × 5 × portée, 0,25 s après le début de l'attaque, puis un recul de force 35. Touché ou raté : test
-- exact boîte orientée contre boîte orientée (axes séparateurs) sur chaque partie de l'ennemi, comme
-- GetPartBoundsInBox (les yeux, simple décor, ne comptent pas).
--
-- Fenêtre modale dans le calque des dialogues (sous les menus de Dialogs : ZIndex 5 < 10), au moins
-- 760 × 520 quand la fenêtre le permet. À gauche : en-tête (pastille, bloc, type de script, cible ; vue
-- 3D | Dessus | Côté ; « Mannequin : R6 ▼ »), la ViewportFrame (sol rond quadrillé, toi en bleu avec une
-- épée, la hitbox rouge et ses 12 arêtes, l'ennemi de test en rouge, légende, aide), les commandes de
-- simulation et la frise du temps. À droite : réglages (curseurs + champs), ennemi de test, résultat
-- prévu, « Fermer » et « Appliquer au bloc ».
-- Règles : RunService.Heartbeat seulement pendant un glissement ou une simulation ; souris lue avec
-- host.getMousePosition() ; jamais d'attente dans les fonctions d'affichage ; tout est détruit à la
-- fermeture (aussi si le calque disparaît).
-- NOTE: le choix du mannequin (menu « Mannequin ») est enregistré dans Reglages (« previsualisation »,
--   Reglages.set) ; sans le module Reglages, il est seulement gardé pour la session.
-- NOTE: « Il bouge » : l'ennemi va et vient de gauche à droite (± 3,5 studs, 2,4 s). Chaque simulation
--   part d'un moment au hasard ; le résultat prévu donne la proportion de coups qui touchent.
-- NOTE: les bannières utilisent la police LuckiestGuy (style « game-kit »), avec « ... » au lieu de « … ».
-- NOTE: clic droit sans glisser sur la vue 3D (demande « clic droit… plusieurs options ») : menu Lancer /
--   Pas à pas / Recommencer, vues 3D / dessus / côté, « L'ennemi bouge », « Changer de mannequin… ».
--   Glisser avec le bouton droit (ou gauche) fait toujours tourner la caméra.

local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)

-- Modules facultatifs (ou écrits en parallèle) : leur absence n'empêche jamais l'ouverture
local function safeRequire(name)
	local inst = script.Parent:FindFirstChild(name)
	if inst == nil then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[Blocs FR] Prévisualiseur de hitbox : module " .. name .. " indisponible (" .. tostring(result) .. ")")
	return nil
end

local Anim = safeRequire("Anim")
local Registry = safeRequire("Registry")
local Mannequin = safeRequire("Mannequin")

local reglagesModule = nil
local reglagesTried = false
local function getReglages()
	if not reglagesTried then
		reglagesTried = true
		local inst = script.Parent:FindFirstChild("Reglages")
		if inst ~= nil then
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				reglagesModule = result
			end
		end
	end
	return reglagesModule
end

local HitboxPreview = {}
HitboxPreview.__index = HitboxPreview

---------------------------------------------------------------------------
-- Constantes
---------------------------------------------------------------------------

local SUPPORTED = { tp_attaque_melee = true, tp_hitbox_degats = true, tp_hitbox = true }
