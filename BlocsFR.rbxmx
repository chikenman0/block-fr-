-- Mémoire de la session : retrouvée à la prochaine ouverture tant que le plugin tourne
local memo = { distance = 6, bouge = false, vitesse = 1, couleur = nil, config = nil }
local rng = Random.new()
local activePreview = nil -- une seule fenêtre ouverte à la fois

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local function fonts()
	local F = Theme.Fonts or {}
	return F.UI or Enum.Font.GothamMedium, F.UIBold or Enum.Font.GothamBold
end

-- Taille de texte qui suit « Taille de l'interface » (Theme.TextSize.UI vaut 13 par défaut)
local function ts(n)
	local base = 13
	if type(Theme.TextSize) == "table" and tonumber(Theme.TextSize.UI) ~= nil then
		base = tonumber(Theme.TextSize.UI)
	end
	return math.max(8, math.floor(n * base / 13 + 0.5))
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

-- 3.5 -> "3,5" ; 6 -> "6" (deux décimales au plus, virgule française)
local function fmt(n)
	n = tonumber(n) or 0
	local r = math.floor(n * 100 + 0.5) / 100
	local s
	if r == math.floor(r) then
		s = string.format("%d", r)
	else
		s = string.format("%.2f", r)
		s = string.gsub(s, "0+$", "")
	end
	s = string.gsub(s, "%.", ",")
	return s
end

local function round2(n)
	return math.floor(n * 100 + 0.5) / 100
end

local function niceCeil(v)
	return math.ceil(v / 5) * 5
end

local function easeOutQuad(k)
	return 1 - (1 - k) * (1 - k)
end

local function easeInQuad(k)
	return k * k
end

local function easeOutCubic(k)
	local q = 1 - k
	return 1 - q * q * q
end

local function easeInOutSine(k)
	return 0.5 - 0.5 * math.cos(math.pi * k)
end

local function makeCorner(parent, radius)
	local c = Instance.new("UICorner")
	if typeof(radius) == "UDim" then
		c.CornerRadius = radius
	else
		c.CornerRadius = UDim.new(0, radius or 8)
	end
	c.Parent = parent
	return c
end

local function newStroke(parent, color, thickness, mode)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- TextLabel transparent avec les réglages de l'interface
local function label(props)
	local fontUI = fonts()
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = fontUI,
		TextSize = ts(12),
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Partie de la scène : ancrée, sans collision ni requête (ViewportFrame : aucune physique)
local function newPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape ~= nil then
		part.Shape = props.Shape
	end
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		elseif key ~= "Shape" then
			part[key] = value
		end
	end
	if parent ~= nil then
		part.Parent = parent
	end
	return part
end

-- Test exact entre deux boîtes orientées (théorème des axes séparateurs). demi = demi-tailles (Vector3).
local function obbOverlap(cfA, halfA, cfB, halfB)
	local a = { cfA.XVector, cfA.YVector, cfA.ZVector }
	local b = { cfB.XVector, cfB.YVector, cfB.ZVector }
	local ea = { halfA.X, halfA.Y, halfA.Z }
	local eb = { halfB.X, halfB.Y, halfB.Z }
	local t = cfB.Position - cfA.Position
	local function separated(axis)
		local m = axis.Magnitude
		if m < 1e-6 then
			return false -- arêtes parallèles : cet axe ne décide rien
		end
		local L = axis / m
		local ra = ea[1] * math.abs(a[1]:Dot(L)) + ea[2] * math.abs(a[2]:Dot(L)) + ea[3] * math.abs(a[3]:Dot(L))
		local rb = eb[1] * math.abs(b[1]:Dot(L)) + eb[2] * math.abs(b[2]:Dot(L)) + eb[3] * math.abs(b[3]:Dot(L))
		return math.abs(t:Dot(L)) > ra + rb
	end
	for i = 1, 3 do
		if separated(a[i]) or separated(b[i]) then
			return false
		end
	end
	for i = 1, 3 do
		for j = 1, 3 do
			if separated(a[i]:Cross(b[j])) then
				return false
			end
		end
	end
	return true
end
HitboxPreview.obbOverlap = obbOverlap

-- Angle du bras droit (rotation autour de l'épaule, axe X ; positif = vers l'avant) à l'instant t.
-- Élan : le bras se lève (60 % du temps) puis s'abat, l'épée arrive devant toi pile à l'impact ;
-- coup : fin du geste pendant que la hitbox est active ; retour : le bras redescend.
local function armAngle(t, tl)
	if t <= 0 then
		return 0
	end
	local E, C, R = tl.elan, tl.coup, tl.retour
	local lever = E * 0.6
	if t < lever then
		return ANGLE_HAUT * easeOutQuad(t / lever)
	end
	if t < E then
		return ANGLE_HAUT + (ANGLE_IMPACT - ANGLE_HAUT) * easeInQuad((t - lever) / (E - lever))
	end
	if t < E + C then
		return ANGLE_IMPACT + (ANGLE_FIN - ANGLE_IMPACT) * easeOutCubic((t - E) / C)
	end
	if t < E + C + R then
		return ANGLE_FIN * (1 - easeInOutSine((t - E - C) / R))
	end
	return 0
end

local function boundsOf(tl)
	return { 0, tl.elan, tl.elan + tl.coup, tl.elan + tl.coup + tl.retour, tl.total }
end

-- Bannière « game-kit » : dégradé, contour foncé, relief en bas, texte blanc contouré
local function makeBanner(parent, fontSize, strokeWidth, radius, relief, zIndex)
	local holder = Util.create("Frame", {
		Name = "Banniere",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(200, fontSize + 20),
		ZIndex = zIndex,
		Parent = parent,
	})
	local scale = Util.create("UIScale", { Scale = 1, Parent = holder })
	local back = Util.create("Frame", {
		Name = "Relief",
		BackgroundColor3 = COUL.encre,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, relief),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = holder,
	})
	makeCorner(back, radius)
	newStroke(back, COUL.encre, strokeWidth)
	local body = Util.create("Frame", {
		Name = "Corps",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = holder,
	})
	makeCorner(body, radius)
	newStroke(body, COUL.encre, strokeWidth)
	local gradient = Util.create("UIGradient", { Rotation = 90, Parent = body })
	local text = Util.create("TextLabel", {
		Name = "Texte",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = GAME_FONT,
		TextSize = fontSize,
		TextColor3 = COUL.blanc,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = body,
	})
	newStroke(text, COUL.encre, math.max(1.5, strokeWidth * 0.6), Enum.ApplyStrokeMode.Contextual)
	local obj = { frame = holder, scale = scale, kind = nil }
	function obj.set(kind)
		if obj.kind == kind then
			return
		end
		local style = BANNIERES[kind] or BANNIERES.rate
		obj.kind = kind
		gradient.Color = ColorSequence.new(style[1], style[2])
		text.Text = style[3]
		local w = textWidth(style[3], fontSize, GAME_FONT) + fontSize * 1.3
		holder.Size = UDim2.fromOffset(math.ceil(w), math.ceil(fontSize * 1.55))
	end
	return obj
end

---------------------------------------------------------------------------
-- Lecture du bloc
---------------------------------------------------------------------------

-- Valeur littérale numérique d'une entrée ; 2e résultat = vrai si un bloc valeur y est branché
local function literalNumber(block, name)
	local inputs = block.inputs
	local input = nil
	if type(inputs) == "table" then
		input = inputs[name]
	end
	if type(input) ~= "table" then
		return nil, false
	end
	if input.block ~= nil then
		return nil, true
	end
	local v = input.value
	if type(v) == "number" then
		return v, false
	end
	return Util.parseNumber(v), false
end

-- Dans le corps de « pour chaque ennemi dans une hitbox » : dégâts du premier « infliger … dégâts » et
-- force du premier « repousser » (pour l'aperçu seulement)
local function scanBody(model, firstId)
	local degats, recul = nil, nil
	local seen = {}
	local stack = { firstId }
	local visited = 0
	while #stack > 0 and visited < 300 do
		local id = table.remove(stack)
		local block = nil
		if id ~= nil then
			block = model:get(id)
		end
		if block ~= nil and not seen[id] then
			seen[id] = true
			visited += 1
			if block.def == "j_degats" and degats == nil then
				degats = literalNumber(block, "DEGATS")
			elseif block.def == "tp_recul" and recul == nil then
				recul = literalNumber(block, "FORCE") or 50
			end
			if block.next ~= nil then
				table.insert(stack, block.next)
			end
			if type(block.sub) == "table" then
				for _, childId in pairs(block.sub) do
					table.insert(stack, childId)
				end
			end
		end
	end
	return degats, recul
end

-- SECONDES du « avec un temps de recharge » le plus proche qui contient le bloc (nil sinon)
local function findRecharge(model, blockId)
	local current = blockId
	local steps = 0
	while current ~= nil and steps < 500 do
		local block = model:get(current)
		if block == nil or block.parent == nil then
			return nil
		end
		local slot = block.slot
		if type(slot) == "table" and slot.kind == "sub" then
			local parent = model:get(block.parent)
			if parent ~= nil and parent.def == "tp_temps_recharge" then
				local v, fromBlock = literalNumber(parent, "SECONDES")
				if v ~= nil then
					return v
				end
				if fromBlock then
					return nil
				end
				return 1
			end
		end
		current = block.parent
		steps += 1
	end
	return nil
end

---------------------------------------------------------------------------
-- Réglages du mannequin (Reglages.current().previsualisation)
---------------------------------------------------------------------------

local function sanitizeConfig(raw)
	local cfg = Util.deepCopy(CONFIG_DEFAUT)
	if type(raw) ~= "table" then
		return cfg
	end
	if TYPES_VALIDES[raw.type] then
		cfg.type = raw.type
	end
	if raw.modeleId ~= nil then
		cfg.modeleId = tostring(raw.modeleId)
	end
	if type(raw.pieces) == "table" then
		for key in pairs(cfg.pieces) do
			local v = raw.pieces[key]
			if v ~= nil then
				cfg.pieces[key] = tostring(v)
			end
		end
	end
	if raw.ombres == false then
		cfg.ombres = false
	end
	return cfg
end

local function currentConfig()
	local R = getReglages()
	if R ~= nil and type(R.current) == "function" then
		local ok, s = pcall(R.current)
		if ok and type(s) == "table" and type(s.previsualisation) == "table" then
			return sanitizeConfig(s.previsualisation)
		end
	end
	return sanitizeConfig(memo.config)
end

local function saveConfig(host, cfg)
	memo.config = Util.deepCopy(cfg)
	local R = getReglages()
	if R == nil then
		return
	end
	local ok, err = pcall(function()
		if type(R.set) == "function" then
			R.set(host, "previsualisation", Util.deepCopy(cfg))
		elseif type(R.current) == "function" and type(R.save) == "function" then
			local copy = Util.deepCopy(R.current())
			if type(copy) == "table" then
				copy.previsualisation = Util.deepCopy(cfg)
				R.save(host, copy)
			end
		end
	end)
	if not ok then
		warn("[Blocs FR] Prévisualiseur de hitbox : réglage non enregistré (" .. tostring(err) .. ")")
	end
end

---------------------------------------------------------------------------
-- API statique
---------------------------------------------------------------------------

function HitboxPreview.supports(defId)
	return defId == "libre" or SUPPORTED[defId] == true
end

function HitboxPreview.readBlock(model, blockId)
	local params = {
		kind = "libre",
		largeur = 5,
		hauteur = 5,
		profondeur = 6,
		degats = 10,
		portee = nil,
		recharge = nil,
		impact = 0,
		recul = nil,
		calcule = {},
	}
	if type(model) ~= "table" or type(model.get) ~= "function" or blockId == nil then
		return params
	end
	local okGet, block = pcall(model.get, model, blockId)
	if not okGet or type(block) ~= "table" or not SUPPORTED[block.def] then
		return params
	end
	local calcule = params.calcule
	local function read(name, default)
		local v, fromBlock = literalNumber(block, name)
		if fromBlock then
			calcule[name] = true
		end
		if v == nil then
			return default
		end
		return v
	end
	params.kind = block.def
	if block.def == "tp_attaque_melee" then
		params.portee = read("PORTEE", 6)
		params.largeur = MELEE_TAILLE
		params.hauteur = MELEE_TAILLE
		params.profondeur = params.portee
		params.degats = read("DEGATS", 20)
		params.impact = MELEE_IMPACT
		params.recul = MELEE_RECUL
	elseif block.def == "tp_hitbox_degats" then
		params.largeur = read("LARGEUR", 5)
		params.hauteur = read("HAUTEUR", 5)
		params.profondeur = read("PROFONDEUR", 6)
		params.degats = read("DEGATS", 10)
	else
		params.largeur = read("LARGEUR", 5)
		params.hauteur = read("HAUTEUR", 5)
		params.profondeur = read("PROFONDEUR", 6)
		local firstId = nil
		if type(block.sub) == "table" then
			firstId = block.sub.DO
		end
		local okScan, degats, recul = pcall(scanBody, model, firstId)
		params.degats = nil
		if okScan then
			params.degats = degats
			params.recul = recul
		end
	end
	local okRecharge, recharge = pcall(findRecharge, model, blockId)
	if okRecharge then
		params.recharge = recharge
	end
	return params
end

-- Boîte de la hitbox par rapport à la racine (HumanoidRootPart) : CFrame de décalage, taille
function HitboxPreview.box(params)
	params = params or {}
	local function valid(v, default)
		local n = tonumber(v)
		if n == nil or n ~= n then
			n = default
		end
		return Util.clamp(n, TAILLE_MIN, TAILLE_MAX)
	end
	local L, H, P
	if params.kind == "tp_attaque_melee" then
		L, H = MELEE_TAILLE, MELEE_TAILLE
		P = valid(params.portee or params.profondeur, 6)
	else
		L = valid(params.largeur, 5)
		H = valid(params.hauteur, 5)
		P = valid(params.profondeur, 6)
	end
	return CFrame.new(0, 0, -(P / 2 + DECALAGE)), Vector3.new(L, H, P)
end

---------------------------------------------------------------------------
-- Ouverture
---------------------------------------------------------------------------

function HitboxPreview.open(layer, deps)
	if activePreview ~= nil and not activePreview._closed then
		pcall(function()
			activePreview:close()
		end)
	end
	local self = setmetatable({}, HitboxPreview)
	activePreview = self
	self.layer = layer
	self.deps = type(deps) == "table" and deps or {}
	self.connections = {}
	self.cleanups = {}
	self._closed = false
	self._buildGen = 0
	self._warnings = {}
	self._lastHit = nil
	self.C = Theme.Colors
	self.params = HitboxPreview.readBlock(self.deps.model, self.deps.blockId)
	self.libre = self.params.kind == "libre"
	self.melee = self.params.kind == "tp_attaque_melee"
	local p = self.params
	self.values = {
		largeur = tonumber(p.largeur) or 5,
		hauteur = tonumber(p.hauteur) or 5,
		profondeur = tonumber(p.profondeur) or 6,
		degats = tonumber(p.degats) or 10,
		distance = memo.distance,
		bouge = memo.bouge == true,
	}
	self._sim = {
		t = 0,
		playing = false,
		started = false,
		finished = false,
		speed = memo.vitesse,
		stopAt = nil,
		phase = 0,
		outcome = false,
	}
	local preset = VUE_PRESETS["3d"]
	self._camState = { yaw = preset.yaw, pitch = preset.pitch, zoom = 1, view = "3d" }
	self._config = currentConfig()
	self._hitboxColor = memo.couleur or COUL.hitbox

	if typeof(layer) ~= "Instance" or not layer:IsA("GuiBase2d") then
		warn("[Blocs FR] Prévisualiseur de hitbox : calque invalide.")
		self._closed = true
		return self
	end
	local ok, err = pcall(function()
		self:_build()
	end)
	if not ok then
		warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
		self:close()
		self:_toast("Le prévisualiseur de hitbox n'a pas pu s'ouvrir : " .. tostring(err), "error")
	end
	return self
end

function HitboxPreview:_build()
	local C = self.C
	local root = Util.create("Frame", {
		Name = "PrevisualisationHitbox",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		Parent = self.layer,
	})
	self.root = root
	-- Fond qui bloque les clics vers l'éditeur (fenêtre modale)
	self.backdrop = Util.create("TextButton", {
		Name = "Fond",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		BackgroundColor3 = C.Overlay,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = root,
	})
	-- Le panneau est un bouton : un clic dans ses marges ne traverse pas
	local panel = Util.create("TextButton", {
		Name = "Panneau",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(900, 600),
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = root,
	})
	Util.corner(panel, 14)
	Util.stroke(panel, C.PopupBorder, 1)
	self.panel = panel

	self:_buildLeft()
	self:_buildRight()
	self:_buildScene()

	if not self.libre and self:_mode() == "local" then
		self:_setWarning("script", "⚠ Ce bloc ne marche que dans un script serveur : ici, c'est un script local.")
	end

	table.insert(self.connections, self.layer:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_layout()
	end))
	table.insert(self.connections, root.AncestryChanged:Connect(function()
		if not self._closed and root.Parent == nil then
			self:close()
		end
	end))

	self:_layout()
	self:_applyConfig(self._config)
	self:_setView("3d", true)
	self:_refreshAll()

	if Anim ~= nil then
		self.backdrop.BackgroundTransparency = 1
		pcall(Anim.tween, self.backdrop, { BackgroundTransparency = 0.45 }, 0.15, "quadOut")
		pcall(Anim.popIn, panel, 0.96)
	end
end

---------------------------------------------------------------------------
-- Construction : colonne de gauche (en-tête, vue 3D, commandes, frise)
---------------------------------------------------------------------------

function HitboxPreview:_buildLeft()
	local C = self.C
	local _, bold = fonts()
	local left = Util.create("Frame", {
		Name = "Scene3D",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(500, 500),
		Parent = self.panel,
	})
	Util.corner(left, 14)
	Util.stroke(left, C.PanelBorder, 1)
	self.left = left

	local dot = Util.create("Frame", {
		Name = "Pastille",
		BackgroundColor3 = self:_dotColor(),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(14, 19),
		Size = UDim2.fromOffset(10, 10),
		Parent = left,
	})
	makeCorner(dot, UDim.new(0.5, 0))
	self.titleLabel = label({
		Name = "Titre",
		Text = self:_title(),
		Font = bold,
		TextSize = ts(14),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.fromOffset(200, 48),
		Parent = left,
	})
	self.metaLabel = label({
		Name = "Infos",
		Text = self:_metaText(),
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(240, 0),
		Size = UDim2.fromOffset(200, 48),
		Parent = left,
	})
	self.viewSeg = self:_segmented(left, VUES, "3d", function(value)
		self:_setView(value, false)
	end)
	self.manBtn = self:_button(left, self:_mannequinLabel(), "normal", 30)
	table.insert(self.connections, self.manBtn.MouseButton1Click:Connect(function()
		self:_openMannequinMenu()
	end))
	Util.create("Frame", {
		Name = "Ligne",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = left,
	})

	local holder = Util.create("Frame", {
		Name = "Vue",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(12, 60),
		Size = UDim2.fromOffset(400, 300),
		Parent = left,
	})
	makeCorner(holder, 12)
	Util.stroke(holder, C.PopupBorder, 1)
	Util.create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, COUL.vpHaut),
			ColorSequenceKeypoint.new(0.55, COUL.vpMilieu),
			ColorSequenceKeypoint.new(1, COUL.vpBas),
		}),
		Rotation = 90,
		Parent = holder,
	})
	self.vpHolder = holder

	self:_buildOverlays()
	self:_buildControls()
	self:_buildTimeline()
end

-- Tout ce qui est dessiné par-dessus la vue 3D (légende, aide, bannière, dégâts…)
function HitboxPreview:_buildOverlays()
	local C = self.C
	local holder = self.vpHolder

	local legend = Util.create("Frame", {
		Name = "Legende",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(260, 90),
		ZIndex = 3,
		Parent = holder,
	})
	Util.create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = legend,
	})
	self.chipHitbox = self:_chip(legend, self._hitboxColor, "Hitbox", 1)
	self.chipToi = self:_chip(legend, COUL.toi, "Toi", 2)
	self.chipEnnemi = self:_chip(legend, COUL.ennemi, "Ennemi", 3)

	local warnBox = Util.create("Frame", {
		Name = "Avertissements",
		BackgroundColor3 = COUL.avertFond,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(270, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 3,
		Parent = holder,
	})
	makeCorner(warnBox, 7)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 7),
		PaddingBottom = UDim.new(0, 7),
		Parent = warnBox,
	})
	self.warnLabel = label({
		Name = "Texte",
		TextSize = ts(11),
		TextColor3 = C.WarningText,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromScale(1, 0),
		ZIndex = 3,
		Parent = warnBox,
	})
	self.warnBox = warnBox

	local hint = label({
		Name = "Aide",
		Text = "Glisse pour tourner · molette : zoom · clic droit : options",
		TextSize = ts(11),
		TextColor3 = C.TextSoft,
		BackgroundColor3 = COUL.chip,
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 24),
		ZIndex = 3,
		Parent = holder,
	})
	makeCorner(hint, 7)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = hint,
	})

	-- Éclat jaune à l'impact
	self.burst = Util.create("Frame", {
		Name = "Eclat",
		BackgroundColor3 = COUL.eclat,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(110, 110),
		Visible = false,
		ZIndex = 4,
		Parent = holder,
	})
	makeCorner(self.burst, UDim.new(0.5, 0))
	self.burstScale = Util.create("UIScale", { Scale = 1, Parent = self.burst })

	-- « -20 » qui monte au-dessus de l'ennemi
	self.dmgLabel = Util.create("TextLabel", {
		Name = "Degats",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = GAME_FONT,
		TextSize = ts(30),
		TextColor3 = COUL.degats,
		Text = "-20",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(160, 40),
		Visible = false,
		ZIndex = 5,
		Parent = holder,
	})
	self.dmgStroke = newStroke(self.dmgLabel, COUL.degatsBord, 2, Enum.ApplyStrokeMode.Contextual)

	-- Bannière « TOUCHÉ ! LET'S GO » / « RATÉ... BOF »
	self.banner = makeBanner(holder, ts(30), 4, 16, 6, 6)
	self.banner.frame.Position = UDim2.fromScale(0.5, 0.22)
	self.banner.frame.Visible = false

	-- Conseil sous la bannière quand c'est raté
	self.missTip = label({
		Name = "Conseil",
		TextSize = ts(12),
		TextColor3 = COUL.blanc,
		BackgroundColor3 = COUL.chip,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.22, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		Visible = false,
		ZIndex = 6,
		Parent = holder,
	})
	makeCorner(self.missTip, 7)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = self.missTip,
	})

	-- Zone transparente qui reçoit la souris : glisser (gauche ou droite) = tourner, molette = zoom
	local catcher = Util.create("TextButton", {
		Name = "Orbite",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = holder,
	})
	table.insert(self.connections, catcher.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 then
			self:_beginOrbit(false)
		elseif kind == Enum.UserInputType.MouseButton2 then
			self:_beginOrbit(true)
		end
	end))
	table.insert(self.connections, catcher.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self:_onWheel(input)
		end
	end))
end

function HitboxPreview:_buildControls()
	local C = self.C
	local controls = Util.create("Frame", {
		Name = "Commandes",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(400, 32),
		Parent = self.left,
	})
	self.controls = controls
	self.playBtn = self:_button(controls, "Lancer la simulation", "primary", 32)
	self.stepBtn = self:_button(controls, "Pas à pas", "normal", 32)
	self.restartBtn = self:_button(controls, "Recommencer", "normal", 32)
	self.speedLabel = label({
		Name = "Vitesse",
		Text = "Vitesse",
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		Size = UDim2.fromOffset(60, 32),
		Parent = controls,
	})
	self.speedSeg = self:_segmented(controls, VITESSES, self._sim.speed, function(value)
		self._sim.speed = value
		memo.vitesse = value
	end)
	table.insert(self.connections, self.playBtn.MouseButton1Click:Connect(function()
		self:_onPlay()
	end))
	table.insert(self.connections, self.stepBtn.MouseButton1Click:Connect(function()
		self:_onStep()
	end))
	table.insert(self.connections, self.restartBtn.MouseButton1Click:Connect(function()
		self:_onRestart()
	end))
end

-- Frise : Élan · Coup (hitbox active) · Retour · Temps de recharge, avec la tête de lecture
function HitboxPreview:_buildTimeline()
	local _, bold = fonts()
	local timeline = Util.create("Frame", {
		Name = "Chronologie",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(400, 34),
		Parent = self.left,
	})
	self.timeline = timeline
	local styles = {
		{ COUL.segElan, COUL.segElanTexte },
		{ COUL.segCoup, COUL.segCoupTexte },
		{ COUL.segElan, COUL.segElanTexte },
		{ COUL.segRecharge, COUL.segRechargeTexte },
	}
	self.segs = {}
	for i = 1, 4 do
		local seg = Util.create("Frame", {
			Name = "Etape" .. i,
			BackgroundColor3 = styles[i][1],
			BorderSizePixel = 0,
			Size = UDim2.new(0, 60, 1, 0),
			Parent = timeline,
		})
		makeCorner(seg, 5)
		if i == 2 then
			newStroke(seg, COUL.segCoupBord, 1)
		end
		local lab = label({
			Name = "Texte",
			Font = bold,
			TextSize = ts(11),
			TextColor3 = styles[i][2],
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -14, 1, 0),
			Parent = seg,
		})
		self.segs[i] = { frame = seg, label = lab, color = styles[i][2] }
	end
	self.playhead = Util.create("Frame", {
		Name = "TeteLecture",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, -4),
		Size = UDim2.new(0, 2, 1, 8),
		ZIndex = 3,
		Parent = timeline,
	})
	local halo = newStroke(self.playhead, COUL.blanc, 2)
	halo.Transparency = 0.7
	-- Cliquer / glisser sur la frise : aller à cet instant
	local scrub = Util.create("TextButton", {
		Name = "Glisser",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = timeline,
	})
	table.insert(self.connections, scrub.MouseButton1Down:Connect(function()
		self:_beginScrub()
	end))
end

---------------------------------------------------------------------------
-- Construction : colonne de droite (réglages, ennemi, résultat, boutons)
---------------------------------------------------------------------------

function HitboxPreview:_buildRight()
	local C = self.C
	local right = Util.create("Frame", {
		Name = "Reglages",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(340, 500),
		Parent = self.panel,
	})
	self.right = right
	local scroll = Util.create("ScrollingFrame", {
		Name = "Cartes",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -46),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ButtonActive,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = right,
	})
	Util.create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 12),
		Parent = scroll,
	})
	self.cards = scroll

	-- HITBOX
	local hb = self:_card(scroll, "HITBOX", 1)
	self.sliders = {}
	self.sliders.largeur = self:_sliderRow(hb, 1, {
		key = "largeur",
		label = "Largeur",
		min = 1,
		max = 20,
		step = 0.5,
		color = COUL.piste,
		locked = self.melee,
	})
	self.sliders.hauteur = self:_sliderRow(hb, 2, {
		key = "hauteur",
		label = "Hauteur",
		min = 1,
		max = 20,
		step = 0.5,
		color = COUL.piste,
		locked = self.melee,
	})
	local depthLabel = "Profondeur"
	if self.melee then
		depthLabel = "Portée"
	end
	self.sliders.profondeur = self:_sliderRow(hb, 3, {
		key = "profondeur",
		label = depthLabel,
		min = 1,
		max = 30,
		step = 0.5,
		color = COUL.piste,
	})
	self.sliders.degats = self:_sliderRow(hb, 4, {
		key = "degats",
		label = "Dégâts",
		min = 0,
		max = 100,
		step = 1,
		color = COUL.piste,
	})
	local note = self:_noteText()
	if note ~= nil then
		self:_note(hb, 5, note)
	end

	-- ENNEMI DE TEST
	local en = self:_card(scroll, "ENNEMI DE TEST", 2)
	self.sliders.distance = self:_sliderRow(en, 1, {
		key = "distance",
		label = "Distance",
		min = 2,
		max = 30,
		step = 0.5,
		color = COUL.bleu,
	})
	self:_toggleRow(en, 2)

	-- RÉSULTAT
	local res = self:_card(scroll, "RÉSULTAT", 3)
	self:_buildResult(res)

	-- Boutons
	local actions = Util.create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 32),
		Parent = right,
	})
	local closeBtn = self:_button(actions, "Fermer", "normal", 32)
	if self.libre or type(self.deps.onApply) ~= "function" then
		closeBtn.Size = UDim2.fromScale(1, 1)
	else
		closeBtn.Size = UDim2.new(0.4, -4, 1, 0)
		local applyBtn = self:_button(actions, "Appliquer au bloc", "primary", 32)
		applyBtn.Position = UDim2.new(0.4, 4, 0, 0)
		applyBtn.Size = UDim2.new(0.6, -4, 1, 0)
		self.applyBtn = applyBtn
		table.insert(self.connections, applyBtn.MouseButton1Click:Connect(function()
			self:_apply()
		end))
	end
	table.insert(self.connections, closeBtn.MouseButton1Click:Connect(function()
		self:close()
	end))
end

function HitboxPreview:_buildResult(card)
	local C = self.C
	local box = Util.create("Frame", {
		Name = "Apercu",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, 92),
		LayoutOrder = 1,
		Parent = card,
	})
	makeCorner(box, 12)
	Util.stroke(box, C.PopupBorder, 1)
	Util.create("UIGradient", {
		Color = ColorSequence.new(COUL.carteHaut, COUL.carteBas),
		Rotation = 90,
		Parent = box,
	})
	self.resultBanner = makeBanner(box, ts(18), 3, 12, 4, 2)
	self.resultBanner.frame.Position = UDim2.new(0.5, 0, 0, 38)
	self.resultInfo = label({
		Name = "Infos",
		TextSize = ts(11),
		TextColor3 = COUL.info,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.new(0, 12, 1, -24),
		Size = UDim2.new(1, -24, 0, 18),
		ZIndex = 3,
		Parent = box,
	})
	self.resultTip = label({
		Name = "Conseil",
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromScale(1, 0),
		LayoutOrder = 2,
		Parent = card,
	})
end

---------------------------------------------------------------------------
-- Petits composants
---------------------------------------------------------------------------

-- Bouton arrondi (style "normal" ou "primary"), largeur selon le texte
function HitboxPreview:_button(parent, text, style, height)
	local C = self.C
	local _, bold = fonts()
	local fs = ts(12)
	local base, hover, textColor = C.Button, C.ButtonHover, C.Text
	if style == "primary" then
		base, hover, textColor = C.Accent, C.AccentHover, COUL.blanc
	end
	local b = Util.create("TextButton", {
		Name = "Bouton",
		Text = text,
		Font = bold,
		TextSize = fs,
		TextColor3 = textColor,
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(textWidth(text, fs, bold) + 26, height or 32),
		Parent = parent,
	})
	Util.corner(b, 8)
	if Anim ~= nil then
		local okHover, stopHover = pcall(Anim.hover, b, base, hover)
		if okHover and type(stopHover) == "function" then
			table.insert(self.cleanups, stopHover)
		end
		local okPress, stopPress = pcall(Anim.press, b)
		if okPress and type(stopPress) == "function" then
			table.insert(self.cleanups, stopPress)
		end
	else
		table.insert(self.connections, b.MouseEnter:Connect(function()
			b.BackgroundColor3 = hover
		end))
		table.insert(self.connections, b.MouseLeave:Connect(function()
			b.BackgroundColor3 = base
		end))
	end
	return b
end

-- Choix segmenté (items = { { valeur, texte } }) ; obj.set(valeur|nil) ; obj.width
function HitboxPreview:_segmented(parent, items, selected, onSelect)
	local C = self.C
	local _, bold = fonts()
	local fs = ts(12)
	local frame = Util.create("Frame", {
		Name = "Choix",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(100, 30),
		Parent = parent,
	})
	Util.corner(frame, 8)
	Util.stroke(frame, C.PanelBorder, 1)
	local obj = { frame = frame, buttons = {}, value = selected, width = 0 }
	function obj.set(value)
		obj.value = value
		for _, entry in ipairs(obj.buttons) do
			local on = entry.value == value
			entry.button.BackgroundTransparency = on and 0 or 1
			entry.button.TextColor3 = on and C.Text or C.TextDim
		end
	end
	local x = 3
	for _, item in ipairs(items) do
		local value, text = item[1], item[2]
		local bw = textWidth(text, fs, bold) + 20
		local b = Util.create("TextButton", {
			Name = "Option",
			Text = text,
			Font = bold,
			TextSize = fs,
			TextColor3 = C.TextDim,
			AutoButtonColor = false,
			BackgroundColor3 = C.ButtonActive,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, 3),
			Size = UDim2.fromOffset(bw, 24),
			Parent = frame,
		})
		Util.corner(b, 6)
		table.insert(obj.buttons, { button = b, value = value })
		table.insert(self.connections, b.MouseButton1Click:Connect(function()
			if self._closed then
				return
			end
			obj.set(value)
			onSelect(value)
		end))
		x += bw + 2
	end
	obj.width = x + 1
	frame.Size = UDim2.fromOffset(obj.width, 30)
	obj.set(selected)
	return obj
end

function HitboxPreview:_card(parent, title, order)
	local C = self.C
	local _, bold = fonts()
	local card = Util.create("Frame", {
		Name = "Carte" .. order,
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	Util.corner(card, 14)
	Util.stroke(card, C.PanelBorder, 1)
	Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 14),
		Parent = card,
	})
	Util.create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = card,
	})
	label({
		Name = "Titre",
		Text = title,
		Font = bold,
		TextSize = ts(11),
		TextColor3 = C.TextDim,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 0,
		Parent = card,
	})
	return card
end

function HitboxPreview:_note(parent, order, text)
	return label({
		Name = "Note",
		Text = text,
		TextSize = ts(11),
		TextColor3 = self.C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromScale(1, 0),
		LayoutOrder = order,
		Parent = parent,
	})
end

-- Pastille de légende (carré de couleur + texte) ; obj.setText(texte)
function HitboxPreview:_chip(parent, swatchColor, text, order)
	local _, bold = fonts()
	local fs = ts(11)
	local chip = Util.create("Frame", {
		Name = "Pastille",
		BackgroundColor3 = COUL.chip,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(100, 26),
		LayoutOrder = order,
		ZIndex = 3,
		Parent = parent,
	})
	makeCorner(chip, 7)
	local swatch = Util.create("Frame", {
		Name = "Couleur",
		BackgroundColor3 = swatchColor,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(10, 10),
		ZIndex = 3,
		Parent = chip,
	})
	makeCorner(swatch, 2)
	local lab = label({
		Name = "Texte",
		Font = bold,
		TextSize = fs,
		Position = UDim2.fromOffset(27, 0),
		Size = UDim2.new(1, -33, 1, 0),
		ZIndex = 3,
		Parent = chip,
	})
	local obj = { frame = chip, swatch = swatch, label = lab }
	function obj.setText(value)
		lab.Text = value
		chip.Size = UDim2.fromOffset(textWidth(value, fs, bold) + 39, 26)
	end
	obj.setText(text)
	return obj
end

-- Ligne « nom | curseur | champ » ; spec = { key, label, min, max, step, color, locked }
function HitboxPreview:_sliderRow(parent, order, spec)
	local C = self.C
	local _, bold = fonts()
	local LAB_W, VAL_W = 88, 50
	local value = tonumber(self.values[spec.key]) or spec.min
	if value > spec.max then
		spec.max = niceCeil(value)
	end
	local row = Util.create("Frame", {
		Name = "Ligne_" .. spec.key,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = order,
		Parent = parent,
	})
	local lab = label({
		Name = "Nom",
		Text = spec.label,
		Font = bold,
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(0, LAB_W, 1, 0),
		Parent = row,
	})
	local area = Util.create("TextButton", {
		Name = "Zone",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(LAB_W + 8, 0),
		Size = UDim2.new(1, -(LAB_W + 16 + VAL_W), 1, 0),
		Parent = row,
	})
	local track = Util.create("Frame", {
		Name = "Piste",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		Parent = area,
	})
	makeCorner(track, 3)
	local fill = Util.create("Frame", {
		Name = "Rempli",
		BackgroundColor3 = spec.color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	makeCorner(fill, 3)
	local knob = Util.create("Frame", {
		Name = "Curseur",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		ZIndex = 2,
		Parent = area,
	})
	makeCorner(knob, UDim.new(0.5, 0))
	local ring = newStroke(knob, spec.color, 3)
	ring.Transparency = 0.62
	local box = Util.create("TextBox", {
		Name = "Valeur",
		Text = fmt(value),
		ClearTextOnFocus = false,
		BackgroundColor3 = C.FieldBg,
		BorderSizePixel = 0,
		Font = bold,
		TextSize = ts(12),
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, VAL_W, 1, 0),
		Parent = row,
	})
	makeCorner(box, 6)
	local boxStroke = Util.stroke(box, C.PopupBorder, 1)
	local obj = { spec = spec, row = row, label = lab, area = area, track = track, fill = fill, knob = knob, box = box }
	if spec.locked then
		-- valeur fixe (attaque toute prête : 5 × 5)
		lab.TextColor3 = C.TextDisabled
		fill.BackgroundColor3 = C.TextDisabled
		ring.Color = C.TextDisabled
		box.TextEditable = false
		box.TextColor3 = C.TextDim
	else
		table.insert(self.connections, area.MouseButton1Down:Connect(function()
			self:_beginSlider(obj)
		end))
		table.insert(self.connections, box.Focused:Connect(function()
			boxStroke.Color = C.Accent
		end))
		table.insert(self.connections, box.FocusLost:Connect(function()
			boxStroke.Color = C.PopupBorder
			local n = Util.parseNumber(box.Text)
			-- jamais de changement du champ pendant son propre FocusLost : on diffère
			task.defer(function()
				if self._closed then
					return
				end
				if n ~= nil then
					self:_setValue(spec.key, n)
				end
				self:_updateSliders()
			end)
		end))
	end
	self:_sliderVisual(obj, value)
	return obj
end

function HitboxPreview:_sliderVisual(obj, v)
	local spec = obj.spec
	local span = spec.max - spec.min
	local frac = 0
	if span > 0 then
		frac = Util.clamp((v - spec.min) / span, 0, 1)
	end
	obj.fill.Size = UDim2.fromScale(frac, 1)
	obj.knob.Position = UDim2.fromScale(frac, 0.5)
	if not obj.box:IsFocused() then
		obj.box.Text = fmt(v)
	end
end

function HitboxPreview:_beginSlider(obj)
	if self._closed then
		return
	end
	local spec = obj.spec
	local function apply(p)
		local pos = obj.track.AbsolutePosition
		local size = obj.track.AbsoluteSize
		if size.X < 2 then
			return
		end
		local frac = Util.clamp((p.X - pos.X) / size.X, 0, 1)
		local v = spec.min + frac * (spec.max - spec.min)
		v = math.floor(v / spec.step + 0.5) * spec.step
		self:_setValue(spec.key, v)
	end
	apply(self:_mouse())
	self:_track(apply, nil)
end

-- Ligne « Il bouge » (interrupteur)
function HitboxPreview:_toggleRow(parent, order)
	local C = self.C
	local _, bold = fonts()
	local row = Util.create("Frame", {
		Name = "LigneBouge",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = order,
		Parent = parent,
	})
	label({
		Name = "Nom",
		Text = "Il bouge",
		Font = bold,
		TextSize = ts(12),
		TextColor3 = C.TextSoft,
		Size = UDim2.new(0, 88, 1, 0),
		Parent = row,
	})
	local toggle = Util.create("TextButton", {
		Name = "Interrupteur",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.PopupBorder,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 96, 0.5, -10),
		Size = UDim2.fromOffset(34, 20),
		Parent = row,
	})
	makeCorner(toggle, 10)
	local knob = Util.create("Frame", {
		Name = "Rond",
		BackgroundColor3 = COUL.blanc,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(14, 14),
		Parent = toggle,
	})
	makeCorner(knob, 7)
	label({
		Name = "Aide",
		Text = "de gauche à droite",
		TextSize = ts(12),
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(140, 0),
		Size = UDim2.new(1, -140, 1, 0),
		Parent = row,
	})
	self.toggle = { button = toggle, knob = knob }
	table.insert(self.connections, toggle.MouseButton1Click:Connect(function()
		if self._closed then
			return
		end
		self.values.bouge = not self.values.bouge
		memo.bouge = self.values.bouge
		self:_updateToggle(true)
		self:_onValuesChanged("bouge")
	end))
	self:_updateToggle(false)
end

function HitboxPreview:_updateToggle(animated)
	local t = self.toggle
	if t == nil then
		return
	end
	local on = self.values.bouge
	local color = self.C.PopupBorder
	local pos = UDim2.fromOffset(3, 3)
	if on then
		color = self.C.Accent
		pos = UDim2.fromOffset(17, 3)
	end
	if animated and Anim ~= nil then
		pcall(Anim.tween, t.button, { BackgroundColor3 = color }, 0.12, "quadOut")
		pcall(Anim.tween, t.knob, { Position = pos }, 0.12, "quadOut")
	else
		t.button.BackgroundColor3 = color
		t.knob.Position = pos
	end
end

---------------------------------------------------------------------------
-- Scène 3D
---------------------------------------------------------------------------

function HitboxPreview:_buildScene()
	local vp = Util.create("ViewportFrame", {
		Name = "Vue3D",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 156, 172),
		LightColor = Color3.fromRGB(255, 250, 242),
		LightDirection = Vector3.new(-0.55, -1, -0.35),
		ZIndex = 1,
		Parent = self.vpHolder,
	})
	makeCorner(vp, 12)
	local cam = Instance.new("Camera")
	cam.Name = "CameraApercu"
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	self.vp = vp
	self.cam = cam
	local world = Instance.new("Folder")
	world.Name = "Scene"
	world.Parent = vp
	self.world = world

	-- Hitbox rouge translucide, ses 12 arêtes et son empreinte au sol
	local color = self._hitboxColor
	self.hbPart = newPart({
		Name = "Hitbox",
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.78,
		Size = Vector3.new(5, 5, 6),
		Parent = world,
	})
	self.hbEdges = {}
	for i = 1, 12 do
		self.hbEdges[i] = newPart({
			Name = "Arete",
			Material = Enum.Material.Neon,
			Color = Theme.lighten(color, 0.35),
			Transparency = 0.3,
			Size = Vector3.new(0.1, 0.1, 0.1),
			Parent = world,
		})
	end
	self.hbFoot = newPart({
		Name = "Empreinte",
		Color = color,
		Transparency = 0.8,
		Size = Vector3.new(5, 0.02, 6),
		Parent = world,
	})
	self._lit = false
	self:_buildFloor()
end

-- Sol rond quadrillé (lignes fines tous les 2 studs), centré entre toi et l'ennemi
function HitboxPreview:_buildFloor()
	if self.world == nil then
		return
	end
	local D = self.values.distance
	local zc = -2 * math.floor(D / 4 + 0.5)
	local R = math.floor(D / 2 + 11)
	local key = zc .. "|" .. R
	if self._floorKey == key and self.floor ~= nil then
		return
	end
	self._floorKey = key
	if self.floor ~= nil then
		self.floor:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Sol"
	newPart({
		Name = "Disque",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2 * R, 2 * R),
		CFrame = CFrame.new(0, -0.1, zc) * CFrame.Angles(0, 0, math.pi / 2),
		Color = COUL.sol,
		Parent = folder,
	})
	local n = math.floor((R - 0.5) / 2)
	for i = -n, n do
		local off = i * 2
		local half = math.sqrt(math.max(0, R * R - off * off)) - 0.3
		if half > 0.5 then
			newPart({
				Name = "Ligne",
				Size = Vector3.new(0.08, 0.02, 2 * half),
				CFrame = CFrame.new(off, 0.02, zc),
				Color = COUL.blanc,
				Transparency = 0.9,
				Parent = folder,
			})
			newPart({
				Name = "Ligne",
				Size = Vector3.new(2 * half, 0.02, 0.08),
				CFrame = CFrame.new(0, 0.02, zc + off),
				Color = COUL.blanc,
				Transparency = 0.9,
				Parent = folder,
			})
		end
	end
	folder.Parent = self.world
	self.floor = folder
end

-- Ombres rondes sous les personnages (réglage « ombres »)
function HitboxPreview:_buildShadows()
	if self.shadowA ~= nil then
		self.shadowA:Destroy()
		self.shadowA = nil
	end
	if self.shadowE ~= nil then
		self.shadowE:Destroy()
		self.shadowE = nil
	end
	if self.world == nil or self._config == nil or self._config.ombres == false then
		return
	end
	local function disc(name)
		return newPart({
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.02, 3.4, 3.4),
			Color = COUL.noir,
			Transparency = 0.55,
			Parent = self.world,
		})
	end
	local p = (self.rootA or CFrame.new(0, 3, 0)).Position
	self.shadowA = disc("OmbreToi")
	self.shadowA.CFrame = CFrame.new(p.X, 0.05, p.Z) * CFrame.Angles(0, 0, math.pi / 2)
	self.shadowE = disc("OmbreEnnemi")
	if self._enemyPivotNow ~= nil then
		local q = self._enemyPivotNow.Position
		self.shadowE.CFrame = CFrame.new(q.X, 0.05, q.Z) * CFrame.Angles(0, 0, math.pi / 2)
	end
end

-- Épée dans la main droite (pointée vers l'avant et le bas au repos), pivotée avec le bras
function HitboxPreview:_buildWeapon()
	if self.weaponParts ~= nil then
		for _, e in ipairs(self.weaponParts) do
			e.part:Destroy()
		end
	end
	self.weaponParts = {}
	self._armAngle = nil
	if self.world == nil then
		return
	end
	local grip = self.grip or Vector3.new(1.5, -0.85, 0)
	local dir = Vector3.new(0, -1, -1).Unit
	local function add(name, size, color, along)
		local center = grip + dir * along
		local rel = CFrame.lookAt(center, center + dir)
		local part = newPart({ Name = name, Size = size, Color = color, Parent = self.world })
		part.CFrame = self.rootA * rel
		table.insert(self.weaponParts, { part = part, rel = rel })
	end
	add("Poignee", Vector3.new(0.2, 0.2, 0.6), COUL.poignee, -0.05)
	add("Garde", Vector3.new(0.95, 0.16, 0.16), COUL.garde, 0.28)
	add("Lame", Vector3.new(0.12, 0.42, 2.6), COUL.lame, 1.65)
end

---------------------------------------------------------------------------
-- Mannequins
---------------------------------------------------------------------------

-- Construit un mannequin sans jamais échouer (R6 en dernier recours) : model|nil, avertissement|nil
function HitboxPreview:_safeBuild(cfg)
	if Mannequin == nil then
		return nil, "Le module Mannequin est introuvable : pas de personnage 3D."
	end
	local ok, model, warnFR = pcall(Mannequin.build, cfg)
	if ok and typeof(model) == "Instance" then
		return model, warnFR
	end
	local ok2, model2 = pcall(Mannequin.build, nil)
	if ok2 and typeof(model2) == "Instance" then
		return model2, "Le mannequin n'a pas pu être construit : mannequin R6 utilisé."
	end
	return nil, "Le mannequin n'a pas pu être construit."
end

-- Applique un réglage de mannequin ; « modele » se charge en arrière-plan (le R6 reste en attendant)
function HitboxPreview:_applyConfig(cfg)
	if self._closed then
		return
	end
	self._config = cfg
	self._buildGen += 1
	local gen = self._buildGen
	if self.manBtn ~= nil then
		self.manBtn.Text = self:_mannequinLabel()
	end
	if cfg.type == "modele" then
		if self.attacker == nil then
			local a, warnA = self:_safeBuild(nil)
			local b = self:_safeBuild(nil)
			self:_setMannequins(a, b)
			self:_setWarning("mannequin", warnA)
		end
		self:_buildShadows()
		self:_setWarning("chargement", "Chargement du modèle " .. tostring(cfg.modeleId) .. "…")
		task.spawn(function()
			local a, warnA = self:_safeBuild(cfg)
			if self._closed or gen ~= self._buildGen then
				if a ~= nil then
					a:Destroy()
				end
				return
			end
			local b = self:_safeBuild(cfg)
			if self._closed or gen ~= self._buildGen then
				if a ~= nil then
					a:Destroy()
				end
				if b ~= nil then
					b:Destroy()
				end
				return
			end
			self:_setWarning("chargement", nil)
			local ok, err = pcall(function()
				self:_setMannequins(a, b)
			end)
			if not ok then
				warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
			end
			self:_setWarning("mannequin", warnA)
		end)
	else
		local a, warnA = self:_safeBuild(cfg)
		local b = self:_safeBuild(cfg)
		self:_setMannequins(a, b)
		self:_setWarning("chargement", nil)
		self:_setWarning("mannequin", warnA)
	end
	if self.panel ~= nil then
		self:_layout()
	end
end

function HitboxPreview:_setMannequins(attacker, enemy)
	if self._closed or attacker == nil or enemy == nil or Mannequin == nil then
		if attacker ~= nil then
			attacker:Destroy()
		end
		if enemy ~= nil then
			enemy:Destroy()
		end
		return
	end
	if self.attacker ~= nil then
		self.attacker:Destroy()
	end
	if self.enemy ~= nil then
		self.enemy:Destroy()
	end
	self.attacker = attacker
	self.enemy = enemy
	pcall(Mannequin.setColors, attacker, "allie")
	pcall(Mannequin.setColors, enemy, "ennemi")
	attacker.Name = "Toi"
	enemy.Name = "Ennemi"

	-- Toi : immobile au centre, regard vers -Z (vers l'ennemi)
	local rootA = attacker.PrimaryPart
	if rootA == nil then
		rootA = attacker:FindFirstChild("HumanoidRootPart", true)
	end
	if rootA ~= nil and rootA:IsA("BasePart") then
		self.rootA = rootA.CFrame
	else
		self.rootA = CFrame.new(0, 3, 0)
	end
	self.armRel = {}
	for _, part in ipairs(Mannequin.armParts(attacker)) do
		table.insert(self.armRel, { part = part, rel = self.rootA:ToObjectSpace(part.CFrame) })
	end
	self.shoulder = Mannequin.shoulder(attacker)
	self.grip = Mannequin.grip(attacker)
	attacker.Parent = self.world
	self:_buildWeapon()

	-- L'ennemi : chaque partie est replacée par rapport à sa racine
	local rootE = enemy.PrimaryPart
	if rootE == nil then
		rootE = enemy:FindFirstChild("HumanoidRootPart", true)
	end
	local baseE = CFrame.new(0, 3, 0)
	if rootE ~= nil and rootE:IsA("BasePart") then
		baseE = rootE.CFrame
	end
	self.enemyHeight = baseE.Position.Y
	self.enemyBaseRot = baseE.Rotation
	self.enemyParts = {}
	for _, d in ipairs(enemy:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(self.enemyParts, {
				part = d,
				rel = baseE:ToObjectSpace(d.CFrame),
				half = d.Size / 2,
				decor = d:GetAttribute("BlocsFR_Decor") == true,
				color = d.Color,
			})
		end
	end
	enemy.Parent = self.world
	self._flashK = nil
	self._enemyKey = nil
	self:_buildShadows()
	self:_resetSim(false)
	self:_updateResult()
end

---------------------------------------------------------------------------
-- Géométrie
---------------------------------------------------------------------------

-- Largeur, hauteur, profondeur réellement utilisées (bornes du jeu ; 5 × 5 pour l'attaque toute prête)
function HitboxPreview:_dims()
	local v = self.values
	local P = Util.clamp(tonumber(v.profondeur) or 6, TAILLE_MIN, TAILLE_MAX)
	if self.melee then
		return MELEE_TAILLE, MELEE_TAILLE, P
	end
	local L = Util.clamp(tonumber(v.largeur) or 5, TAILLE_MIN, TAILLE_MAX)
	local H = Util.clamp(tonumber(v.hauteur) or 5, TAILLE_MIN, TAILLE_MAX)
	return L, H, P
end

-- Boîte dans la scène : CFrame et taille (comme _tpCiblesDevant, racine de l'attaquant)
function HitboxPreview:_boxWorld()
	local L, H, P = self:_dims()
	local root = self.rootA or CFrame.new(0, 3, 0)
	return root * CFrame.new(0, 0, -(P / 2 + DECALAGE)), Vector3.new(L, H, P)
end

function HitboxPreview:_updateHitbox()
	if self.hbPart == nil then
		return
	end
	local cf, size = self:_boxWorld()
	self.hbPart.Size = size
	self.hbPart.CFrame = cf
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local t = 0.09
	local i = 0
	local function edge(px, py, pz, sx, sy, sz)
		i += 1
		local part = self.hbEdges[i]
		part.Size = Vector3.new(sx, sy, sz)
		part.CFrame = cf * CFrame.new(px, py, pz)
	end
	for _, a in ipairs({ -1, 1 }) do
		for _, b in ipairs({ -1, 1 }) do
			edge(0, a * hy, b * hz, size.X + t, t, t)
			edge(a * hx, 0, b * hz, t, size.Y + t, t)
			edge(a * hx, b * hy, 0, t, t, size.Z + t)
		end
	end
	local pos = cf.Position
	self.hbFoot.Size = Vector3.new(size.X, 0.02, size.Z)
	self.hbFoot.CFrame = CFrame.new(pos.X, 0.08, pos.Z) * cf.Rotation
end

function HitboxPreview:_setHitboxLit(on)
	if self._lit == on or self.hbPart == nil then
		return
	end
	self._lit = on
	if on then
		self.hbPart.Transparency = 0.6
		self.hbFoot.Transparency = 0.6
	else
		self.hbPart.Transparency = 0.78
		self.hbFoot.Transparency = 0.8
	end
	for _, part in ipairs(self.hbEdges) do
		part.Transparency = on and 0 or 0.3
	end
end

function HitboxPreview:_recolorHitbox()
	local color = self._hitboxColor
	if self.hbPart == nil then
		return
	end
	self.hbPart.Color = color
	self.hbFoot.Color = color
	for _, part in ipairs(self.hbEdges) do
		part.Color = Theme.lighten(color, 0.35)
	end
	if self.chipHitbox ~= nil then
		self.chipHitbox.swatch.BackgroundColor3 = color
	end
end

---------------------------------------------------------------------------
-- Ennemi de test
---------------------------------------------------------------------------

-- Décalage de côté (« Il bouge ») à l'instant t de la simulation
function HitboxPreview:_lateralAt(t, phase)
	if not self.values.bouge then
		return 0
	end
	return BOUGE_AMPLITUDE * math.sin(phase + 2 * math.pi * t / BOUGE_PERIODE)
end

-- CFrame de la racine de l'ennemi : face à toi, à « distance » studs devant, décalé de côté, repoussé
-- (back), soulevé (hop) et penché en arrière (tilt, autour de ses pieds)
function HitboxPreview:_enemyPivot(lat, back, hop, tilt)
	local h = self.enemyHeight or 3
	return CFrame.new(lat, hop, -(self.values.distance + back))
		* CFrame.Angles(0, math.pi, 0)
		* CFrame.Angles(tilt, 0, 0)
		* CFrame.new(0, h, 0)
		* (self.enemyBaseRot or CFrame.new())
end

function HitboxPreview:_placeEnemy(lat, back, hop, tilt)
	if self.enemyParts == nil then
		return
	end
	local key = string.format("%.4f|%.4f|%.4f|%.4f|%.3f", lat, back, hop, tilt, self.values.distance)
	if self._enemyKey == key then
		return
	end
	self._enemyKey = key
	local pivot = self:_enemyPivot(lat, back, hop, tilt)
	self._enemyPivotNow = pivot
	for _, e in ipairs(self.enemyParts) do
		e.part.CFrame = pivot * e.rel
	end
	if self.shadowE ~= nil then
		local pos = pivot.Position
		self.shadowE.CFrame = CFrame.new(pos.X, 0.05, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
	end
end

-- Flash rouge de l'ennemi touché (k = 1 : tout rouge, 0 : couleurs normales)
function HitboxPreview:_flashEnemy(k)
	if self._flashK == k or self.enemyParts == nil then
		return
	end
	self._flashK = k
	for _, e in ipairs(self.enemyParts) do
		if not e.decor and e.part.Transparency < 1 then
			if k > 0 then
				e.part.Color = e.color:Lerp(COUL.flash, 0.85 * k)
			else
				e.part.Color = e.color
			end
		end
	end
end

---------------------------------------------------------------------------
-- Touché ou raté ?
---------------------------------------------------------------------------

-- Test exact : la hitbox touche-t-elle une partie de l'ennemi décalé de côté de « lat » ?
function HitboxPreview:_hitWithLateral(lat, cf, half)
	if self.enemyParts == nil then
		return false
	end
	if cf == nil then
		local size
		cf, size = self:_boxWorld()
		half = size / 2
	end
	local pivot = self:_enemyPivot(lat, 0, 0, 0)
	for _, e in ipairs(self.enemyParts) do
		if not e.decor and obbOverlap(cf, half, pivot * e.rel, e.half) then
			return true
		end
	end
	return false
end

-- Résultat prévu : { hit = bool, chance = 0..1 } (un ennemi qui bouge est testé à 16 instants)
function HitboxPreview:_predict()
	local impact = self:_timeline().impact
	local cf, size = self:_boxWorld()
	local half = size / 2
	if not self.values.bouge then
		local hit = self:_hitWithLateral(0, cf, half)
		local chance = 0
		if hit then
			chance = 1
		end
		return { hit = hit, chance = chance }
	end
	local hits = 0
	for k = 0, ECHANTILLONS - 1 do
		local phase = 2 * math.pi * k / ECHANTILLONS
		if self:_hitWithLateral(self:_lateralAt(impact, phase), cf, half) then
			hits += 1
		end
	end
	return { hit = hits * 2 >= ECHANTILLONS, chance = hits / ECHANTILLONS }
end

-- Pourquoi c'est raté : "loin" | "proche" | "cote" | "hauteur" | "autre" (boîtes alignées sur toi)
function HitboxPreview:_missReason(lat)
	if self.enemyParts == nil or #self.enemyParts == 0 then
		return "autre"
	end
	local pivot = self:_enemyPivot(lat, 0, 0, 0)
	local inv = (self.rootA or CFrame.new(0, 3, 0)):Inverse()
	local x0, y0, z0 = math.huge, math.huge, math.huge
	local x1, y1, z1 = -math.huge, -math.huge, -math.huge
	for _, e in ipairs(self.enemyParts) do
		if not e.decor then
			local cf = inv * pivot * e.rel
			local h = e.half
			local xv, yv, zv = cf.XVector, cf.YVector, cf.ZVector
			local ex = math.abs(xv.X) * h.X + math.abs(yv.X) * h.Y + math.abs(zv.X) * h.Z
			local ey = math.abs(xv.Y) * h.X + math.abs(yv.Y) * h.Y + math.abs(zv.Y) * h.Z
			local ez = math.abs(xv.Z) * h.X + math.abs(yv.Z) * h.Y + math.abs(zv.Z) * h.Z
			local p = cf.Position
			x0 = math.min(x0, p.X - ex)
			x1 = math.max(x1, p.X + ex)
			y0 = math.min(y0, p.Y - ey)
			y1 = math.max(y1, p.Y + ey)
			z0 = math.min(z0, p.Z - ez)
			z1 = math.max(z1, p.Z + ez)
		end
	end
	local L, H, P = self:_dims()
	-- devant toi = -Z : distance du point de l'ennemi le plus proche et du plus lointain
	local nearest = -z1
	local farthest = -z0
	if nearest > P + DECALAGE then
		return "loin"
	end
	if farthest < DECALAGE then
		return "proche"
	end
	if x1 < -L / 2 or x0 > L / 2 then
		return "cote"
	end
	if y1 < -H / 2 or y0 > H / 2 then
		return "hauteur"
	end
	return "autre"
end

-- Conseil court (sous la bannière, dans la vue 3D)
function HitboxPreview:_shortTip(reason)
	if reason == "loin" then
		if self.melee then
			return "Conseil : augmente la portée ou rapproche l'ennemi."
		end
		return "Conseil : augmente la profondeur ou rapproche l'ennemi."
	elseif reason == "cote" then
		if self.melee then
			return "Conseil : l'ennemi passe à côté de la hitbox (5 × 5)."
		end
		return "Conseil : élargis la hitbox (largeur)."
	elseif reason == "hauteur" then
		if self.melee then
			return "Conseil : l'ennemi est trop haut ou trop bas."
		end
		return "Conseil : augmente la hauteur."
	elseif reason == "proche" then
		return "Conseil : l'ennemi est trop collé à toi."
	end
	return "Conseil : rapproche l'ennemi ou agrandis la hitbox."
end

-- Conseil détaillé (carte « Résultat »)
function HitboxPreview:_longTip(reason)
	local _, _, P = self:_dims()
	local D = self.values.distance
	if reason == "loin" then
		local what = "augmente la profondeur"
		if self.melee then
			what = "augmente la portée"
		end
		return "Conseil : "
			.. what
			.. " ou rapproche l'ennemi : il est à "
			.. fmt(D)
			.. " studs et la hitbox s'arrête à "
			.. fmt(P + DECALAGE)
			.. "."
	elseif reason == "cote" then
		if self.melee then
			return "Conseil : l'attaque toute prête a une hitbox fixe de 5 × 5 : pour une hitbox plus large, utilise le bloc « hitbox devant … »."
		end
		return "Conseil : l'ennemi passe à côté : augmente la largeur."
	elseif reason == "hauteur" then
		if self.melee then
			return "Conseil : l'attaque toute prête a une hitbox fixe de 5 × 5 : pour une hitbox plus haute, utilise le bloc « hitbox devant … »."
		end
		return "Conseil : l'ennemi est trop haut ou trop bas : augmente la hauteur."
	elseif reason == "proche" then
		return "Conseil : l'ennemi est collé à toi. La hitbox commence 1 stud devant toi : recule-le un peu."
	end
	return "Conseil : rapproche l'ennemi ou agrandis la hitbox."
end

function HitboxPreview:_hitText()
	if self.params.kind == "tp_hitbox" then
		return "Bien vu : l'ennemi est dans la hitbox, les blocs à l'intérieur vont s'exécuter pour lui."
	end
	local d = tonumber(self.values.degats) or 0
	local text
	if d < 0 then
		text = "Bien vu : l'ennemi regagne " .. fmt(-d) .. " points de vie"
	else
		text = "Bien vu : l'ennemi perd " .. fmt(d) .. " points de vie"
	end
	if tonumber(self.params.recul) ~= nil then
		return text .. " et il est repoussé."
	end
	return text .. "."
end

function HitboxPreview:_updateResult()
	if self.resultBanner == nil or self.enemyParts == nil then
		return
	end
	local pred = self:_predict()
	self._prediction = pred
	local _, _, P = self:_dims()
	self.resultInfo.Text = "Ennemi à "
		.. fmt(self.values.distance)
		.. " studs · la hitbox va jusqu'à "
		.. fmt(P + DECALAGE)
	local tip
	if self.values.bouge and pred.chance > 0 and pred.chance < 1 then
		self.resultBanner.set("parfois")
		local n = Util.clamp(math.floor(pred.chance * 10 + 0.5), 1, 9)
		local advice = "Élargis la hitbox (largeur) pour le toucher à chaque fois."
		if self.melee then
			advice = "Avec la hitbox fixe de 5 × 5, il t'échappe parfois quand il est sur le côté."
		end
		tip = "Il bouge : touché environ " .. n .. " fois sur 10. " .. advice
	elseif pred.chance >= 1 then
		self.resultBanner.set("touche")
		tip = self:_hitText()
		if self.values.bouge then
			tip = "Il bouge, mais ta hitbox est assez grande : touché à chaque fois ! " .. tip
		end
	else
		self.resultBanner.set("rate")
		tip = self:_longTip(self:_missReason(0))
	end
	self.resultTip.Text = tip
end

---------------------------------------------------------------------------
-- Valeurs (curseurs, champs, interrupteur)
---------------------------------------------------------------------------

function HitboxPreview:_setValue(key, v)
	if self._closed then
		return
	end
	local n = tonumber(v)
	if n == nil or n ~= n then
		return
	end
	if key == "degats" then
		n = Util.clamp(n, -100000, 100000)
	elseif key == "distance" then
		n = Util.clamp(n, 1, 60)
	else
		n = Util.clamp(n, TAILLE_MIN, TAILLE_MAX)
	end
	n = round2(n)
	local slider = self.sliders and self.sliders[key]
	if slider ~= nil and n > slider.spec.max then
		slider.spec.max = niceCeil(n)
	end
	if self.values[key] == n then
		return
	end
	self.values[key] = n
	if key == "distance" then
		memo.distance = n
	end
	self:_onValuesChanged(key)
end

-- Tout ce qui dépend des valeurs : hitbox, ennemi, sol, caméra, légende, résultat, simulation remise à zéro
function HitboxPreview:_onValuesChanged(key)
	self:_updateSliders()
	if key == "distance" then
		self:_buildFloor()
		self:_updateCamera()
	end
	self:_updateHitbox()
	self:_updateLegend()
	self:_resetSim(false)
	self:_updateResult()
end

function HitboxPreview:_updateSliders()
	if self.sliders == nil then
		return
	end
	for key, obj in pairs(self.sliders) do
		local v = tonumber(self.values[key]) or obj.spec.min
		if self.melee and (key == "largeur" or key == "hauteur") then
			v = MELEE_TAILLE
		end
		self:_sliderVisual(obj, v)
	end
end

function HitboxPreview:_updateLegend()
	if self.chipHitbox == nil then
		return
	end
	local L, H, P = self:_dims()
	self.chipHitbox.setText("Hitbox " .. fmt(L) .. " × " .. fmt(H) .. " × " .. fmt(P))
	self.chipEnnemi.setText("Ennemi à " .. fmt(self.values.distance) .. " studs")
end

---------------------------------------------------------------------------
-- Frise du temps
---------------------------------------------------------------------------

-- Durées (s) : élan (impact à sa fin), coup (hitbox allumée), retour, recharge jouée
function HitboxPreview:_timeline()
	local elan, retour = 0.15, 0.2
	if self.melee then
		elan, retour = MELEE_IMPACT, 0.25
	end
	local coup = 0.2
	local rech = tonumber(self.params.recharge)
	if rech ~= nil and rech <= 0 then
		rech = nil
	end
	local recharge = 0.4
	if rech ~= nil then
		recharge = math.min(rech, RECHARGE_MAX_VISIBLE)
	end
	return {
		elan = elan,
		coup = coup,
		retour = retour,
		recharge = recharge,
		rechargeReel = rech,
		impact = elan,
		total = elan + coup + retour + recharge,
	}
end

function HitboxPreview:_segLabels(tl)
	local last
	if tl.rechargeReel ~= nil then
		last = {
			"Temps de recharge " .. fmt(tl.rechargeReel) .. " s",
			"Recharge " .. fmt(tl.rechargeReel) .. " s",
		}
	else
		last = { "Pas de temps de recharge", "Sans recharge" }
	end
	return {
		{ "Élan " .. fmt(tl.elan) .. " s", "Élan" },
		{ "Coup : hitbox active", "Coup" },
		{ "Retour " .. fmt(tl.retour) .. " s", "Retour" },
		last,
	}
end

function HitboxPreview:_layoutTimeline(width)
	if self.segs == nil then
		return
	end
	self._timelineWidth = width
	local _, bold = fonts()
	local fs = ts(11)
	local gap = 3
	local usable = math.max(40, width - gap * 3)
	local tl = self:_timeline()
	local labels = self:_segLabels(tl)
	local x = 0
	self._segRects = {}
	for i = 1, 4 do
		local w = math.floor(usable * POIDS[i] + 0.5)
		if i == 4 then
			w = math.max(10, width - x)
		end
		local seg = self.segs[i]
		seg.frame.Position = UDim2.fromOffset(x, 0)
		seg.frame.Size = UDim2.new(0, w, 1, 0)
		local full, short = labels[i][1], labels[i][2]
		if textWidth(full, fs, bold) + 16 <= w then
			seg.label.Text = full
		else
			seg.label.Text = short
		end
		self._segRects[i] = { x = x, w = w }
		x += w + gap
	end
	local last = self.segs[4]
	if tl.rechargeReel ~= nil then
		last.frame.BackgroundColor3 = COUL.segRecharge
		last.color = COUL.segRechargeTexte
	else
		last.frame.BackgroundColor3 = self.C.Button
		last.color = self.C.TextDim
	end
	self._shownPhase = -1
end

function HitboxPreview:_timeToX(t)
	local rects = self._segRects
	if rects == nil then
		return 0
	end
	local b = boundsOf(self:_timeline())
	for i = 1, 4 do
		if t <= b[i + 1] or i == 4 then
			local span = b[i + 1] - b[i]
			local k = 0
			if span > 0 then
				k = Util.clamp((t - b[i]) / span, 0, 1)
			end
			return rects[i].x + rects[i].w * k
		end
	end
	return 0
end

function HitboxPreview:_xToTime(x)
	local rects = self._segRects
	local tl = self:_timeline()
	if rects == nil then
		return 0
	end
	local b = boundsOf(tl)
	for i = 1, 4 do
		local r = rects[i]
		if x <= r.x + r.w or i == 4 then
			local k = 0
			if r.w > 0 then
				k = Util.clamp((x - r.x) / r.w, 0, 1)
			end
			return b[i] + (b[i + 1] - b[i]) * k
		end
	end
	return tl.total
end

-- Étape en cours : 1 élan, 2 coup, 3 retour, 4 recharge
function HitboxPreview:_phaseIndex(t)
	local b = boundsOf(self:_timeline())
	for i = 1, 3 do
		if t < b[i + 1] then
			return i
		end
	end
	return 4
end

function HitboxPreview:_renderTimeline()
	if self.playhead == nil or self._segRects == nil then
		return
	end
	local sim = self._sim
	local x = self:_timeToX(sim.t)
	self.playhead.Position = UDim2.fromOffset(math.floor(x) - 1, -4)
	local phase = 0
	if sim.started then
		phase = self:_phaseIndex(sim.t)
	end
	if phase ~= self._shownPhase then
		self._shownPhase = phase
		for i, seg in ipairs(self.segs) do
			seg.label.TextColor3 = (i == phase) and COUL.blanc or seg.color
		end
	end
end

---------------------------------------------------------------------------
-- Simulation
---------------------------------------------------------------------------

-- Remet la simulation au début. start = true : une simulation commence (moment au hasard si
-- l'ennemi bouge, résultat calculé tout de suite) ; sinon : pose de repos, rien d'affiché.
function HitboxPreview:_resetSim(start)
	local sim = self._sim
	sim.t = 0
	sim.playing = false
	sim.finished = false
	sim.stopAt = nil
	sim.started = start == true
	sim.phase = 0
	if sim.started and self.values.bouge then
		sim.phase = rng:NextNumber(0, 2 * math.pi)
	end
	if self.enemyParts ~= nil then
		local lat = self:_lateralAt(self:_timeline().impact, sim.phase)
		sim.outcome = self:_hitWithLateral(lat)
		if sim.started then
			self._lastHit = sim.outcome
			if sim.outcome then
				self.missTip.Text = ""
			else
				self.missTip.Text = self:_shortTip(self:_missReason(lat))
			end
		end
	end
	self:_render()
	self:_updateControls()
	self:_updateHeartbeat()
end

function HitboxPreview:_poseArm(angle)
	if self._armAngle == angle or self.rootA == nil then
		return
	end
	self._armAngle = angle
	local pivot = CFrame.new(self.shoulder or Vector3.new(1.5, 0.5, 0))
	local swing = self.rootA * pivot * CFrame.Angles(angle, 0, 0) * pivot:Inverse()
	for _, e in ipairs(self.armRel or {}) do
		e.part.CFrame = swing * e.rel
	end
	for _, e in ipairs(self.weaponParts or {}) do
		e.part.CFrame = swing * e.rel
	end
end

-- Dessine l'instant sim.t : bras, hitbox, ennemi (recul, flash), bannière, dégâts, frise
function HitboxPreview:_render()
	if self._closed or self.attacker == nil then
		return
	end
	local sim = self._sim
	local tl = self:_timeline()
	local t = sim.t
	local started = sim.started
	local angle = 0
	if started then
		angle = armAngle(t, tl)
	end
	self:_poseArm(angle)
	self:_setHitboxLit(started and t >= tl.impact and t <= tl.impact + tl.coup)

	local lat = 0
	if started then
		lat = self:_lateralAt(t, sim.phase)
	else
		lat = self:_lateralAt(0, sim.phase)
	end
	local back, hop, tilt, flash = 0, 0, 0, 0
	local u = t - tl.impact
	if started and sim.outcome and u >= 0 then
		local recul = tonumber(self.params.recul)
		if recul ~= nil and recul > 0 then
			-- recul (comme _tpRepousser) : environ 4,5 studs pour une force de 35, petit saut
			local dist = math.min(recul * 0.13, 10)
			local k = Util.clamp(u / 0.4, 0, 1)
			back = dist * easeOutQuad(k)
			hop = 4 * math.min(1.2, dist * 0.2) * k * (1 - k)
			tilt = math.rad(16) * math.sin(math.pi * Util.clamp(u / 0.45, 0, 1))
		else
			back = 0.35 * math.sin(math.pi * Util.clamp(u / 0.3, 0, 1))
			tilt = math.rad(11) * math.sin(math.pi * Util.clamp(u / 0.35, 0, 1))
		end
		flash = 1 - Util.clamp(u / 0.3, 0, 1)
	end
	self:_placeEnemy(lat, back, hop, tilt)
	self:_flashEnemy(flash)
	self:_renderOverlays()
	self:_renderTimeline()
end

-- Point 3D -> pixel dans la vue (nil s'il est derrière la caméra)
function HitboxPreview:_project(worldPos)
	local cam, vp = self.cam, self.vp
	if cam == nil or vp == nil then
		return nil
	end
	local size = vp.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		return nil
	end
	local rel = cam.CFrame:PointToObjectSpace(worldPos)
	if rel.Z > -0.05 then
		return nil
	end
	local tanHalf = math.tan(math.rad(cam.FieldOfView) / 2)
	local aspect = size.X / size.Y
	local nx = rel.X / (-rel.Z * tanHalf * aspect)
	local ny = rel.Y / (-rel.Z * tanHalf)
	return Vector2.new((nx + 1) / 2 * size.X, (1 - ny) / 2 * size.Y)
end

function HitboxPreview:_renderOverlays()
	if self.banner == nil then
		return
	end
	local sim = self._sim
	local tl = self:_timeline()
	local u = sim.t - tl.impact
	local active = sim.started and u >= 0

	-- Bannière : apparaît en grossissant (0,2 -> 1,12 -> 1) à l'impact, puis reste. En pause (pas à pas,
	-- frise), elle est montrée en entier.
	if active then
		self.banner.set(sim.outcome and "touche" or "rate")
		local s = 1
		if sim.playing then
			if u < 0.08 then
				s = 0.2 + 0.92 * (u / 0.08)
			elseif u < 0.16 then
				s = 1.12 - 0.12 * ((u - 0.08) / 0.08)
			end
		end
		self.banner.scale.Scale = s
		self.banner.frame.Visible = true
		self.missTip.Visible = (not sim.outcome) and self.missTip.Text ~= "" and (u >= 0.16 or not sim.playing)
	else
		self.banner.frame.Visible = false
		self.missTip.Visible = false
	end

	local pivot = self._enemyPivotNow
	-- « -20 » qui monte et s'efface (0,9 s)
	local showDmg = false
	if active and sim.outcome and u <= 0.9 and pivot ~= nil then
		local head = self:_project(pivot * Vector3.new(0, 2.4, 0))
		if head ~= nil then
			local d = tonumber(self.values.degats) or 0
			if d < 0 then
				self.dmgLabel.Text = "+" .. fmt(-d)
			else
				self.dmgLabel.Text = "-" .. fmt(d)
			end
			local rise = 46 * easeOutQuad(Util.clamp(u / 0.75, 0, 1))
			local fade = Util.clamp((u - 0.6) / 0.3, 0, 1)
			self.dmgLabel.Position = UDim2.fromOffset(head.X, head.Y - rise)
			self.dmgLabel.TextTransparency = fade
			self.dmgStroke.Transparency = fade
			showDmg = true
		end
	end
	self.dmgLabel.Visible = showDmg

	-- Éclat jaune sur la poitrine de l'ennemi (0,35 s)
	local showBurst = false
	if active and sim.outcome and u <= 0.35 and pivot ~= nil then
		local chest = self:_project(pivot * Vector3.new(0, 0.4, -0.7))
		if chest ~= nil then
			local k = u / 0.35
			self.burst.Position = UDim2.fromOffset(chest.X, chest.Y)
			self.burstScale.Scale = 0.3 + 1.3 * k
			self.burst.BackgroundTransparency = 0.15 + 0.85 * k
			showBurst = true
		end
	end
	self.burst.Visible = showBurst
end

function HitboxPreview:_updateControls()
	if self.playBtn == nil then
		return
	end
	local sim = self._sim
	local text
	if sim.playing then
		text = "Pause"
	elseif sim.started and not sim.finished and sim.t > 0 then
		text = "Reprendre"
	elseif self._shortPlay then
		text = "Lancer"
	else
		text = "Lancer la simulation"
	end
	self.playBtn.Text = text
end

function HitboxPreview:_onPlay()
	if self._closed then
		return
	end
	local sim = self._sim
	if sim.playing then
		sim.playing = false
		sim.stopAt = nil
	elseif not sim.started or sim.finished then
		self:_resetSim(true)
		sim.playing = true
	else
		sim.playing = true
	end
	self:_updateControls()
	self:_updateHeartbeat()
end

-- Pas à pas : joue jusqu'à la prochaine étape (impact, fin du coup, fin du retour, fin)
function HitboxPreview:_onStep()
	if self._closed then
		return
	end
	local sim = self._sim
	if not sim.started or sim.finished then
		self:_resetSim(true)
	end
	local tl = self:_timeline()
	local b = boundsOf(tl)
	local target = tl.total
	for i = 2, 5 do
		if b[i] > sim.t + 1e-4 then
			target = b[i]
			break
		end
	end
	sim.stopAt = target
	sim.playing = true
	self:_updateControls()
	self:_updateHeartbeat()
end

function HitboxPreview:_onRestart()
	if self._closed then
		return
	end
	self:_resetSim(true)
	self._sim.playing = true
	self:_updateControls()
	self:_updateHeartbeat()
end

-- Cliquer / glisser sur la frise : met la simulation à cet instant (en pause)
function HitboxPreview:_beginScrub()
	if self._closed then
		return
	end
	local sim = self._sim
	if not sim.started then
		self:_resetSim(true)
	end
	sim.playing = false
	sim.stopAt = nil
	local function apply(p)
		local tl = self:_timeline()
		local rel = p.X - self.timeline.AbsolutePosition.X
		sim.t = Util.clamp(self:_xToTime(rel), 0, tl.total)
		sim.finished = sim.t >= tl.total
		self:_render()
		self:_updateControls()
	end
	apply(self:_mouse())
	self:_track(apply, nil)
end

---------------------------------------------------------------------------
-- Caméra (orbite autour du milieu de la scène)
---------------------------------------------------------------------------

function HitboxPreview:_updateCamera()
	if self.cam == nil then
		return
	end
	local cs = self._camState
	local D = self.values.distance
	local target = Vector3.new(0, 2.6, -D / 2)
	local dist = math.max(11, 0.95 * (D + 8)) * cs.zoom
	self.cam.CFrame = CFrame.new(target)
		* CFrame.Angles(0, cs.yaw, 0)
		* CFrame.Angles(-cs.pitch, 0, 0)
		* CFrame.new(0, 0, dist)
	if self._sim.started then
		self:_renderOverlays()
	end
end

-- Vue prédéfinie (3D, Dessus, Côté), avec une petite transition si les animations sont actives
function HitboxPreview:_setView(view, instant)
	local preset = VUE_PRESETS[view]
	if preset == nil or self._closed then
		return
	end
	local cs = self._camState
	cs.view = view
	if self.viewSeg ~= nil then
		self.viewSeg.set(view)
	end
	if self._camHandle ~= nil then
		pcall(function()
			self._camHandle:cancel()
		end)
		self._camHandle = nil
	end
	local y0, p0, z0 = cs.yaw, cs.pitch, cs.zoom
	local dy = (preset.yaw - y0) % (2 * math.pi)
	if dy > math.pi then
		dy -= 2 * math.pi
	end
	local function apply(k)
		if self._closed then
			return
		end
		cs.yaw = y0 + dy * k
		cs.pitch = p0 + (preset.pitch - p0) * k
		cs.zoom = z0 + (1 - z0) * k
		self:_updateCamera()
	end
	if not instant and Anim ~= nil and type(Anim.step) == "function" then
		local ok, handle = pcall(Anim.step, apply, 0.35, "quintOut", nil, "BlocsFR_HitboxCamera")
		if ok then
			self._camHandle = handle
			return
		end
	end
	apply(1)
end

-- Glisser sur la vue (bouton gauche ou droit) : tourner autour de la scène. Un clic droit sans glisser
-- ouvre le menu de la vue 3D.
function HitboxPreview:_beginOrbit(rightButton)
	if self._closed then
		return
	end
	local cs = self._camState
	local p0 = self:_mouse()
	local yaw0, pitch0 = cs.yaw, cs.pitch
	local moved = false
	self:_track(function(p)
		local d = p - p0
		if not moved and d.Magnitude < 4 then
			return
		end
		if not moved then
			moved = true
			if self._camHandle ~= nil then
				pcall(function()
					self._camHandle:cancel()
				end)
				self._camHandle = nil
			end
			yaw0, pitch0 = cs.yaw, cs.pitch
		end
		cs.yaw = yaw0 - d.X * 0.01
		cs.pitch = Util.clamp(pitch0 + d.Y * 0.008, PITCH_MIN, PITCH_MAX)
		if cs.view ~= nil then
			cs.view = nil
			self.viewSeg.set(nil)
		end
		self:_updateCamera()
	end, function(how)
		if rightButton and not moved and how == "relache" then
			self:_viewMenu(p0)
		end
	end)
end

-- Menu du clic droit sur la vue 3D
function HitboxPreview:_viewMenu(screenPos)
	local dialogs = self.deps.dialogs
	if self._closed or type(dialogs) ~= "table" or type(dialogs.menu) ~= "function" then
		return
	end
	local sim = self._sim
	local playLabel = "Lancer la simulation"
	if sim.playing then
		playLabel = "Pause"
	elseif sim.started and not sim.finished and sim.t > 0 then
		playLabel = "Reprendre"
	end
	local view = self._camState.view
	local items = {
		{ label = playLabel, value = "jouer" },
		{ label = "Pas à pas", value = "pas" },
		{ label = "Recommencer", value = "recommencer" },
		"separator",
		{ label = "Vue 3D", value = "vue:3d", checked = view == "3d" },
		{ label = "Vue de dessus", value = "vue:dessus", checked = view == "dessus" },
		{ label = "Vue de côté", value = "vue:cote", checked = view == "cote" },
		"separator",
		{ label = "L'ennemi bouge", value = "bouge", checked = self.values.bouge == true },
		{ label = "Changer de mannequin…", value = "mannequin" },
	}
	pcall(function()
		dialogs:menu(screenPos, items, function(value)
			if self._closed then
				return
			end
			if value == "jouer" then
				self:_onPlay()
			elseif value == "pas" then
				self:_onStep()
			elseif value == "recommencer" then
				self:_onRestart()
			elseif value == "bouge" then
				self.values.bouge = not self.values.bouge
				memo.bouge = self.values.bouge
				self:_updateToggle(true)
				self:_onValuesChanged("bouge")
			elseif value == "mannequin" then
				self:_openMannequinMenu()
			elseif type(value) == "string" and string.sub(value, 1, 4) == "vue:" then
				self:_setView(string.sub(value, 5), false)
			end
		end)
	end)
end

function HitboxPreview:_onWheel(input)
	if self._closed or self._trackState ~= nil then
		return
	end
	local dz = input.Position.Z
	if dz == 0 then
		return
	end
	if self._camHandle ~= nil then
		pcall(function()
			self._camHandle:cancel()
		end)
		self._camHandle = nil
	end
	local cs = self._camState
	if dz > 0 then
		cs.zoom = Util.clamp(cs.zoom * 0.88, ZOOM_MIN, ZOOM_MAX)
	else
		cs.zoom = Util.clamp(cs.zoom / 0.88, ZOOM_MIN, ZOOM_MAX)
	end
	self:_updateCamera()
end

---------------------------------------------------------------------------
-- Suivi de la souris (curseurs, orbite, frise) et boucle Heartbeat
---------------------------------------------------------------------------

function HitboxPreview:_mouse()
	local host = self.deps.host
	if type(host) == "table" and type(host.getMousePosition) == "function" then
		local ok, p = pcall(host.getMousePosition)
		if ok and typeof(p) == "Vector2" then
			return p
		end
	end
	return Vector2.new(0, 0)
end

-- Suit la souris jusqu'au relâchement : un bouton transparent couvre la fenêtre (InputChanged /
-- InputEnded) et Heartbeat relit host.getMousePosition() à chaque image.
function HitboxPreview:_track(onMove, onEnd)
	self:_cancelTrack()
	if self.root == nil or self._closed then
		return
	end
	local overlay = Util.create("TextButton", {
		Name = "SuiviSouris",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z_SUIVI,
		Parent = self.root,
	})
	local state = { overlay = overlay, conns = {}, onMove = onMove, onEnd = onEnd, last = nil, started = os.clock() }
	self._trackState = state
	-- how : "relache" (bouton relâché), "clic" (nouvel appui), "focus" (la fenêtre perd le focus)
	local function finish(how)
		self:_endTrack(state, true, how)
	end
	local function released()
		finish("relache")
	end
	local conns = state.conns
	table.insert(conns, overlay.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			self:_trackMove()
		end
	end))
	table.insert(conns, overlay.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.MouseButton2 then
			released()
		end
	end))
	table.insert(conns, overlay.MouseButton1Up:Connect(released))
	table.insert(conns, overlay.MouseButton2Up:Connect(released))
	-- un appui pendant le suivi (relâchement manqué hors de la fenêtre) termine aussi
	table.insert(conns, overlay.MouseButton1Down:Connect(function()
		if os.clock() - state.started > 0.15 then
			finish("clic")
		end
	end))
	table.insert(conns, overlay.MouseButton2Down:Connect(function()
		if os.clock() - state.started > 0.15 then
			finish("clic")
		end
	end))
	local host = self.deps.host
	local widget = nil
	if type(host) == "table" then
		widget = host.widget
	end
	if typeof(widget) == "Instance" then
		pcall(function()
			table.insert(conns, widget.WindowFocusReleased:Connect(function()
				finish("focus")
			end))
		end)
	end
	self:_updateHeartbeat()
end

function HitboxPreview:_trackMove()
	local state = self._trackState
	if state == nil then
		return
	end
	local p = self:_mouse()
	if state.last ~= nil and state.last == p then
		return
	end
	state.last = p
	local ok, err = pcall(state.onMove, p)
	if not ok then
		warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
		self:_endTrack(state, false)
	end
end

function HitboxPreview:_endTrack(state, callEnd, how)
	if self._trackState ~= state then
		return
	end
	self._trackState = nil
	for _, c in ipairs(state.conns) do
		c:Disconnect()
	end
	state.conns = {}
	if state.overlay ~= nil then
		state.overlay:Destroy()
		state.overlay = nil
	end
	if callEnd and type(state.onEnd) == "function" then
		local ok, err = pcall(state.onEnd, how)
		if not ok then
			warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
		end
	end
	self:_updateHeartbeat()
end

function HitboxPreview:_cancelTrack()
	local state = self._trackState
	if state ~= nil then
		self:_endTrack(state, false)
	end
end

-- Heartbeat seulement pendant un glissement ou une simulation
function HitboxPreview:_updateHeartbeat()
	local need = not self._closed and (self._trackState ~= nil or self._sim.playing)
	if need and self._hb == nil then
		self._hb = RunService.Heartbeat:Connect(function(dt)
			self:_onHeartbeat(dt)
		end)
	elseif not need and self._hb ~= nil then
		self._hb:Disconnect()
		self._hb = nil
	end
end

function HitboxPreview:_onHeartbeat(dt)
	if self._closed then
		return
	end
	if self.root == nil or self.root.Parent == nil then
		self:close()
		return
	end
	local ok, err = pcall(function()
		if self._trackState ~= nil then
			self:_trackMove()
		end
		local sim = self._sim
		if sim.playing then
			local tl = self:_timeline()
			sim.t += math.min(dt, 0.1) * sim.speed
			local stopped = false
			if sim.stopAt ~= nil and sim.t >= sim.stopAt then
				sim.t = sim.stopAt
				sim.stopAt = nil
				sim.playing = false
				stopped = true
			end
			if sim.t >= tl.total then
				sim.t = tl.total
				sim.stopAt = nil
				sim.playing = false
				sim.finished = true
				stopped = true
			end
			self:_render()
			if stopped then
				self:_updateControls()
			end
		end
	end)
	if not ok then
		warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
		self._sim.playing = false
		self:_cancelTrack()
		self:_updateControls()
	end
	self:_updateHeartbeat()
end

---------------------------------------------------------------------------
-- Mise en page
---------------------------------------------------------------------------

function HitboxPreview:_layout()
	if self._closed or self.panel == nil then
		return
	end
	local size = self.layer.AbsoluteSize
	local lw, lh = size.X, size.Y
	if lw < 50 then
		lw = 1000
	end
	if lh < 50 then
		lh = 640
	end
	local W = math.floor(Util.clamp(lw - 48, math.min(760, lw - 8), 1180))
	local H = math.floor(Util.clamp(lh - 48, math.min(520, lh - 8), 860))
	local pad = 12
	local rightW = math.floor(Util.clamp(W * 0.32, 250, 360))
	local leftW = W - rightW - pad * 3
	local leftH = H - pad * 2
	self.panel.Size = UDim2.fromOffset(W, H)
	self.left.Position = UDim2.fromOffset(pad, pad)
	self.left.Size = UDim2.fromOffset(leftW, leftH)
	self.right.Position = UDim2.fromOffset(W - pad - rightW, pad)
	self.right.Size = UDim2.fromOffset(rightW, leftH)
	self:_layoutHeader(leftW)
	local vpH = math.max(80, leftH - 162)
	self.vpHolder.Position = UDim2.fromOffset(12, 60)
	self.vpHolder.Size = UDim2.fromOffset(leftW - 24, vpH)
	local rowY = 60 + vpH + 12
	self.controls.Position = UDim2.fromOffset(14, rowY)
	self.controls.Size = UDim2.fromOffset(leftW - 28, 32)
	self:_layoutControls(leftW - 28)
	self.timeline.Position = UDim2.fromOffset(14, rowY + 42)
	self.timeline.Size = UDim2.fromOffset(leftW - 28, 34)
	self:_layoutTimeline(leftW - 28)
	self:_renderTimeline()
	self:_renderOverlays()
end

function HitboxPreview:_layoutHeader(leftW)
	local _, bold = fonts()
	local manW = textWidth(self.manBtn.Text, ts(12), bold) + 26
	local manX = leftW - 14 - manW
	self.manBtn.Position = UDim2.fromOffset(manX, 9)
	self.manBtn.Size = UDim2.fromOffset(manW, 30)
	local segX = manX - 10 - self.viewSeg.width
	self.viewSeg.frame.Position = UDim2.fromOffset(segX, 9)
	local avail = segX - 12 - 32
	local titleW = math.min(textWidth(self.titleLabel.Text, ts(14), bold) + 2, math.max(40, avail))
	self.titleLabel.Size = UDim2.fromOffset(titleW, 48)
	local metaW = avail - titleW - 6
	self.metaLabel.Position = UDim2.fromOffset(32 + titleW + 6, 0)
	self.metaLabel.Size = UDim2.fromOffset(math.max(0, metaW), 48)
	self.metaLabel.Visible = metaW >= 50
end

function HitboxPreview:_layoutControls(width)
	local fontUI, bold = fonts()
	local fs = ts(12)
	local function w(text)
		return textWidth(text, fs, bold) + 26
	end
	local playFull = math.max(w("Lancer la simulation"), w("Reprendre"))
	local playShort = math.max(w("Lancer"), w("Reprendre"))
	local stepW = w("Pas à pas")
	local restartW = w("Recommencer")
	local segW = self.speedSeg.width
	local labelW = textWidth("Vitesse", fs, fontUI) + 10
	local need = playFull + stepW + restartW + 20 + 16 + segW + labelW
	local showLabel = true
	if need > width then
		showLabel = false
		need -= labelW
	end
	self._shortPlay = need > width
	local playW = playFull
	if self._shortPlay then
		playW = playShort
	end
	local x = 0
	self.playBtn.Position = UDim2.fromOffset(x, 0)
	self.playBtn.Size = UDim2.fromOffset(playW, 32)
	x += playW + 10
	self.stepBtn.Position = UDim2.fromOffset(x, 0)
	self.stepBtn.Size = UDim2.fromOffset(stepW, 32)
	x += stepW + 10
	self.restartBtn.Position = UDim2.fromOffset(x, 0)
	self.restartBtn.Size = UDim2.fromOffset(restartW, 32)
	self.speedSeg.frame.Position = UDim2.fromOffset(width - segW, 1)
	self.speedLabel.Visible = showLabel
	self.speedLabel.Position = UDim2.fromOffset(width - segW - labelW, 0)
	self.speedLabel.Size = UDim2.fromOffset(labelW, 32)
	self:_updateControls()
end

function HitboxPreview:_refreshAll()
	self:_updateSliders()
	self:_updateHitbox()
	self:_updateLegend()
	self:_layoutTimeline(self._timelineWidth or 400)
	self:_updateCamera()
	self:_resetSim(false)
	self:_updateResult()
end

---------------------------------------------------------------------------
-- Textes
---------------------------------------------------------------------------

function HitboxPreview:_mode()
	local mode = self.deps.mode
	if mode == nil and type(self.deps.model) == "table" then
		mode = self.deps.model.mode
	end
	return mode
end

function HitboxPreview:_title()
	local kind = self.params.kind
	if TITRES[kind] ~= nil then
		return TITRES[kind]
	end
	if Registry ~= nil then
		local ok, text = pcall(function()
			local def = Registry.get(kind)
			if def == nil then
				return nil
			end
			return Registry.plainLabel(def)
		end)
		if ok and type(text) == "string" then
			return text
		end
	end
	return "Prévisualiseur de hitbox"
end

function HitboxPreview:_metaText()
	if self.libre then
		return "· essaie une hitbox sans bloc"
	end
	local parts = {}
	local mode = self:_mode()
	if mode ~= nil and MODES[mode] ~= nil then
		table.insert(parts, MODES[mode])
	end
	local path = self.deps.targetPath
	if type(path) == "string" and path ~= "" then
		table.insert(parts, path)
	end
	if #parts == 0 then
		return ""
	end
	return "· " .. table.concat(parts, " · ")
end

function HitboxPreview:_dotColor()
	if not self.libre and Registry ~= nil then
		local ok, color = pcall(function()
			local def = Registry.get(self.params.kind)
			local cat = def and Registry.category(def.category)
			if cat == nil then
				return nil
			end
			return cat.dot or cat.color
		end)
		if ok and typeof(color) == "Color3" then
			return color
		end
	end
	return Color3.fromRGB(236, 72, 153)
end

function HitboxPreview:_mannequinLabel()
	local kind = "R6"
	if self._config ~= nil and NOMS_TYPES[self._config.type] ~= nil then
		kind = self._config.type
	end
	return "Mannequin : " .. NOMS_TYPES[kind] .. " ▼"
end

function HitboxPreview:_noteText()
	local lines = {}
	if self.melee then
		table.insert(lines, "L'attaque toute prête a toujours une hitbox de 5 × 5 : seule la portée change.")
	elseif self.params.kind == "tp_hitbox" then
		if self.params.degats ~= nil then
			table.insert(
				lines,
				"Dégâts lus dans « infliger … dégâts » à l'intérieur du bloc (ici, seulement pour l'aperçu)."
			)
		else
			table.insert(lines, "Les dégâts se règlent avec les blocs à l'intérieur (ici, seulement pour l'aperçu).")
		end
	end
	if next(self.params.calcule or {}) ~= nil then
		table.insert(lines, "Une valeur vient d'un autre bloc : l'aperçu utilise sa valeur par défaut.")
	end
	if #lines == 0 then
		return nil
	end
	return table.concat(lines, "\n")
end

-- Avertissements en haut à droite de la vue (clés : script, chargement, mannequin)
function HitboxPreview:_setWarning(key, text)
	self._warnings[key] = text
	local lines = {}
	for _, k in ipairs({ "script", "chargement", "mannequin" }) do
		local value = self._warnings[k]
		if type(value) == "string" and value ~= "" then
			table.insert(lines, value)
		end
	end
	if self.warnLabel ~= nil and self.warnBox ~= nil then
		self.warnLabel.Text = table.concat(lines, "\n")
		self.warnBox.Visible = #lines > 0
	end
end

function HitboxPreview:_toast(text, kind)
	local dialogs = self.deps.dialogs
	if type(dialogs) == "table" and type(dialogs.toast) == "function" then
		pcall(function()
			dialogs:toast(text, kind)
		end)
	end
end

---------------------------------------------------------------------------
-- Menu « Mannequin : R6 ▼ »
---------------------------------------------------------------------------

function HitboxPreview:_openMannequinMenu()
	local dialogs = self.deps.dialogs
	if self._closed or type(dialogs) ~= "table" or type(dialogs.menu) ~= "function" then
		return
	end
	local cfg = self._config or CONFIG_DEFAUT
	local items = {
		{ label = "R6 (blocs)", value = "R6", checked = cfg.type == "R6" },
		{ label = "R15 (blocs)", value = "R15", checked = cfg.type == "R15" },
		{ label = "Modèle par id…", value = "modele", checked = cfg.type == "modele" },
		{ label = "Pièces séparées", value = "pieces", checked = cfg.type == "pieces" },
		"separator",
		{ label = "Ombres au sol", value = "ombres", checked = cfg.ombres ~= false },
		{ label = "Couleur de la hitbox…", value = "couleur" },
	}
	if type(self.deps.openSettings) == "function" then
		table.insert(items, "separator")
		table.insert(items, { label = "Paramètres 3D…", value = "parametres" })
	end
	local btn = self.manBtn
	local pos = btn.AbsolutePosition + Vector2.new(0, btn.AbsoluteSize.Y + 4)
	pcall(function()
		dialogs:menu(pos, items, function(value)
			self:_onMannequinChoice(value)
		end)
	end)
end

function HitboxPreview:_onMannequinChoice(value)
	if self._closed then
		return
	end
	local dialogs = self.deps.dialogs
	local cfg = Util.deepCopy(self._config or CONFIG_DEFAUT)
	if value == "R6" or value == "R15" then
		cfg.type = value
		saveConfig(self.deps.host, cfg)
		self:_applyConfig(cfg)
	elseif value == "modele" then
		if type(dialogs) ~= "table" or type(dialogs.prompt) ~= "function" then
			return
		end
		dialogs:prompt(
			"Modèle par id",
			"Colle l'ID d'un modèle Roblox (le nombre dans son adresse). Il doit être public ou t'appartenir. Il sera mis à la taille d'un personnage (5 studs).",
			cfg.modeleId or "",
			function(text)
				if self._closed then
					return
				end
				local id = Util.trim(tostring(text or ""))
				if id == "" then
					return
				end
				if Mannequin ~= nil and type(Mannequin.parseIds) == "function" then
					id = Mannequin.parseIds(id) or id
				end
				local cfg2 = Util.deepCopy(self._config or CONFIG_DEFAUT)
				cfg2.type = "modele"
				cfg2.modeleId = id
				saveConfig(self.deps.host, cfg2)
				self:_applyConfig(cfg2)
			end
		)
	elseif value == "pieces" then
		local any = false
		for _, v in pairs(cfg.pieces or {}) do
			if Util.trim(tostring(v)) ~= "" then
				any = true
			end
		end
		if not any then
			self:_toast("Choisis d'abord les IDs des pièces dans Paramètres → Prévisualisation 3D.", "warning")
			if type(self.deps.openSettings) == "function" then
				pcall(self.deps.openSettings, "previsualisation")
			end
			return
		end
		cfg.type = "pieces"
		saveConfig(self.deps.host, cfg)
		self:_applyConfig(cfg)
	elseif value == "ombres" then
		cfg.ombres = cfg.ombres == false
		saveConfig(self.deps.host, cfg)
		self._config = cfg
		self:_buildShadows()
	elseif value == "couleur" then
		if type(dialogs) ~= "table" or type(dialogs.colorPicker) ~= "function" then
			return
		end
		local btn = self.manBtn
		local pos = btn.AbsolutePosition + Vector2.new(0, btn.AbsoluteSize.Y + 4)
		dialogs:colorPicker(pos, Util.color3ToRgb(self._hitboxColor), function(rgb)
			if self._closed then
				return
			end
			self._hitboxColor = Util.rgbToColor3(rgb)
			memo.couleur = self._hitboxColor
			self:_recolorHitbox()
		end)
	elseif value == "parametres" then
		if type(self.deps.openSettings) == "function" then
			local ok, err = pcall(self.deps.openSettings, "previsualisation")
			if not ok then
				warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
			end
		end
	end
end

---------------------------------------------------------------------------
-- « Appliquer au bloc »
---------------------------------------------------------------------------

function HitboxPreview:_apply()
	if self._closed or self.libre then
		return
	end
	local onApply = self.deps.onApply
	if type(onApply) ~= "function" then
		return
	end
	local calcule = self.params.calcule or {}
	local v = self.values
	local out = {}
	local count = 0
	local function put(name, value)
		if not calcule[name] then
			out[name] = round2(tonumber(value) or 0)
			count += 1
		end
	end
	local kind = self.params.kind
	if kind == "tp_attaque_melee" then
		put("PORTEE", v.profondeur)
		put("DEGATS", v.degats)
	elseif kind == "tp_hitbox_degats" then
		put("LARGEUR", v.largeur)
		put("HAUTEUR", v.hauteur)
		put("PROFONDEUR", v.profondeur)
		put("DEGATS", v.degats)
	else
		put("LARGEUR", v.largeur)
		put("HAUTEUR", v.hauteur)
		put("PROFONDEUR", v.profondeur)
	end
	if count == 0 then
		self:_toast("Rien à appliquer : ces valeurs viennent d'autres blocs.", "warning")
		return
	end
	local ok, err = pcall(onApply, out)
	if ok then
		self:_toast("Hitbox appliquée au bloc ✓", "success")
	else
		warn("[Blocs FR] Prévisualiseur de hitbox : " .. tostring(err))
		self:_toast("Impossible d'appliquer les réglages au bloc : " .. tostring(err), "error")
	end
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

function HitboxPreview:isOpen()
	return not self._closed
end

-- Lance une simulation depuis le début ; renvoie le résultat (touché ou non), connu tout de suite
function HitboxPreview:simulate()
	if self._closed then
		return nil
	end
	self:_resetSim(true)
	self._sim.playing = true
	self:_updateControls()
	self:_updateHeartbeat()
	return self._sim.outcome
end

function HitboxPreview:getDebugState()
	local sim = self._sim or {}
	local v = self.values or {}
	local p = self.params or {}
	local L, H, P = 0, 0, 0
	if self.values ~= nil then
		L, H, P = self:_dims()
	end
	local portee = nil
	if self.melee then
		portee = P
	end
	local predicted, chance = nil, nil
	if self._prediction ~= nil then
		predicted = self._prediction.hit
		chance = self._prediction.chance
	end
	local phase = "attente"
	if sim.finished then
		phase = "fin"
	elseif sim.started then
		local names = { "elan", "coup", "retour", "recharge" }
		phase = names[self:_phaseIndex(sim.t or 0)]
	end
	local warnings = {}
	for _, key in ipairs({ "script", "chargement", "mannequin" }) do
		if self._warnings ~= nil and self._warnings[key] ~= nil then
			table.insert(warnings, self._warnings[key])
		end
	end
	return {
		hit = self._lastHit,
		predicted = predicted,
		chance = chance,
		params = {
			kind = p.kind,
			largeur = L,
			hauteur = H,
			profondeur = P,
			degats = v.degats,
			portee = portee,
			recharge = p.recharge,
		},
		bloc = Util.deepCopy(p),
		distance = v.distance,
		bouge = v.bouge,
		playing = sim.playing == true,
		finished = sim.finished == true,
		t = sim.t,
		phase = phase,
		mannequin = self._config and self._config.type or nil,
		warning = (#warnings > 0) and table.concat(warnings, "\n") or nil,
		view = self._camState and self._camState.view or nil,
		libre = self.libre == true,
		closed = self._closed == true,
		blockId = self.deps and self.deps.blockId or nil,
	}
end

function HitboxPreview:close()
	if self._closed and self.root == nil then
		return
	end
	local wasOpen = not self._closed
	self._closed = true
	self._buildGen = (self._buildGen or 0) + 1
	if activePreview == self then
		activePreview = nil
	end
	if self._camHandle ~= nil then
		pcall(function()
			self._camHandle:cancel()
		end)
		self._camHandle = nil
	end
	local state = self._trackState
	if state ~= nil then
		self._trackState = nil
		for _, c in ipairs(state.conns) do
			c:Disconnect()
		end
		if state.overlay ~= nil then
			state.overlay:Destroy()
		end
	end
	if self._hb ~= nil then
		self._hb:Disconnect()
		self._hb = nil
	end
	for _, c in ipairs(self.connections or {}) do
		pcall(function()
			c:Disconnect()
		end)
	end
	self.connections = {}
	for _, fn in ipairs(self.cleanups or {}) do
		pcall(fn)
	end
	self.cleanups = {}
	if self.root ~= nil then
		local root = self.root
		self.root = nil
		pcall(function()
			root:Destroy()
		end)
	end
	self.attacker = nil
	self.enemy = nil
	self.enemyParts = nil
	if wasOpen and type(self.deps.onClose) == "function" then
		task.spawn(self.deps.onClose)
	end
end

return HitboxPreview
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">Logo</string><ProtectedString name="Source"><![CDATA[-- Logo : le logo Blocs FR (trois blocs emboîtés bleu / blanc / rouge).
-- Si Theme.LogoAssetId est renseigné, on affiche l'image importée ; sinon on le dessine avec des Frames.
--
-- API :
--   Logo.create(parent, size, zIndex?) -> GuiObject   (le logo, nommé « Logo »)
--   Logo.pop(logo, onDone?)            -- arrivée (SPEC §24) : 55 % -> 110 % -> 100 %, -12° -> 3° -> 0°, fondu
--   Logo.wiggle(logo)                  -- petit coucou : les trois blocs sautent l'un après l'autre
--   Logo.attachHover(logo, trigger?) -> disconnectFn   -- wiggle quand la souris entre sur trigger
--                                       (par défaut le logo lui-même ; ex. le bouton qui le recouvre)
-- Les animations passent par Anim (durées × vitesse des réglages ; animations désactivées : rien ne
-- bouge et onDone est appelé tout de suite).
-- NOTE: Anim utilise Logo (écran d'ouverture) : Logo charge Anim seulement au moment d'animer, jamais
-- au chargement du module (sinon les deux modules se chargeraient l'un l'autre en boucle).

local Theme = require(script.Parent.Theme)

local Logo = {}

-- Rectangles en unités 0..64 : { x, y, largeur, hauteur, couleur, arrondi, zindex, bloc }
-- bloc = groupe qui saute ensemble dans Logo.wiggle (1 bleu, 2 blanc, 3 rouge)
local PIECES = {
	{ 10, 8, 26, 10, "Blue", 5, 1, 1 }, -- bosse du bloc événement
	{ 10, 13, 44, 11, "Blue", 3, 1, 1 },
	{ 10, 24, 44, 13, "White", 3, 1, 2 },
	{ 18, 24, 10, 3, "Blue", 1, 2, 1 }, -- languette du bloc bleu
	{ 10, 37, 44, 13, "Red", 3, 1, 3 },
	{ 18, 37, 10, 3, "White", 1, 2, 2 }, -- languette du bloc blanc
	{ 18, 49, 10, 4, "Red", 1, 1, 3 }, -- languette du bloc rouge
}
local BLOCK_NAMES = { "BlocBleu", "BlocBlanc", "BlocRouge" }

local SCALE_NAME = "AnimEchelle" -- même nom que les UIScale d'Anim (un seul par objet)
local POP_TIME = 0.34
local WIGGLE_TIME = 0.3
local WIGGLE_STEP = 0.06
local WIGGLE_HEIGHT = 3 -- en unités du logo (0..64)

-- Logo dessiné : position de repos de chaque pièce et taille du logo (pour les sauts)
local homes = setmetatable({}, { __mode = "k" }) -- [pièce] = UDim2
local sizes = setmetatable({}, { __mode = "k" }) -- [logo] = taille en pixels
local tiltKeys = setmetatable({}, { __mode = "k" }) -- [logo] = clé Anim de la bascule du coucou
local REST_ATTR = "BlocsFR_RotationLogo" -- rotation de repos (les animations reviennent à elle)

-- Crée le logo (taille en pixels) dans parent. Renvoie le GuiObject racine.
function Logo.create(parent: Instance?, size: number, zIndex: number?): GuiObject
	local z = zIndex or 1
	if Theme.LogoAssetId and Theme.LogoAssetId ~= "" then
		local image = Instance.new("ImageLabel")
		image.Name = "Logo"
		image.Size = UDim2.fromOffset(size, size)
		image.BackgroundTransparency = 1
		image.Image = Theme.LogoAssetId
		image.ScaleType = Enum.ScaleType.Fit
		image.ZIndex = z
		image.Parent = parent
		return image
	end

	local k = size / 64
	local tile = Instance.new("Frame")
	tile.Name = "Logo"
	tile.Size = UDim2.fromOffset(size, size)
	tile.BackgroundColor3 = Theme.LogoColors.Tile
	tile.BorderSizePixel = 0
	tile.ZIndex = z
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, math.max(2, math.floor(14 * k + 0.5)))
	corner.Parent = tile

	for _, p in ipairs(PIECES) do
		local f = Instance.new("Frame")
		f.Name = BLOCK_NAMES[p[8]] or "Piece"
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Theme.LogoColors[p[5]]
		f.Position = UDim2.fromOffset(math.floor(p[1] * k + 0.5), math.floor(p[2] * k + 0.5))
		f.Size = UDim2.fromOffset(math.max(1, math.floor(p[3] * k + 0.5)), math.max(1, math.floor(p[4] * k + 0.5)))
		f.ZIndex = z + p[7]
		if p[6] * k >= 1 then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, math.floor(p[6] * k + 0.5))
			c.Parent = f
		end
		f.Parent = tile
		homes[f] = f.Position
	end
	sizes[tile] = size

	tile.Parent = parent
	return tile
end

---------------------------------------------------------------------------
-- Animations
---------------------------------------------------------------------------

-- Module Anim, chargé au premier usage (nil s'il est indisponible : le logo reste immobile)
local AnimModule = nil
local function getAnim()
	if AnimModule ~= nil then
		return AnimModule
	end
	local module = script.Parent:FindFirstChild("Anim")
	if module == nil then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		AnimModule = result
		return result
	end
	return nil
end

local function isGui(obj)
	return typeof(obj) == "Instance" and obj:IsA("GuiObject")
end

local function callDone(onDone)
	if type(onDone) == "function" then
		task.spawn(onDone)
	end
end

-- UIScale « AnimEchelle » du logo (créé si besoin) ; nil si le logo a déjà un autre UIScale
local function scaleOf(logo)
	local own = logo:FindFirstChild(SCALE_NAME)
	if own ~= nil and own:IsA("UIScale") then
		return own
	end
	if logo:FindFirstChildOfClass("UIScale") ~= nil then
		return nil
	end
	local s = Instance.new("UIScale")
	s.Name = SCALE_NAME
	s.Parent = logo
	return s
end

local function set(inst, prop, value)
	pcall(function()
		inst[prop] = value
	end)
end

-- Rotation de repos du logo : notée au premier usage (une animation en cours ne la fausse pas)
local function restRotation(logo)
	local rest = logo:GetAttribute(REST_ATTR)
	if type(rest) ~= "number" then
		rest = logo.Rotation
		logo:SetAttribute(REST_ATTR, rest)
	end
	return rest
end

local function quadOut(t)
	return 1 - (1 - t) * (1 - t)
end

local function sineInOut(t)
	return (1 - math.cos(math.pi * t)) / 2
end

-- Arrivée du logo (écran d'ouverture, fenêtres) : il grandit en tournant puis se pose, en fondu.
-- La rotation finale est celle d'avant l'animation. onDone est appelé une fois, à la fin.
function Logo.pop(logo, onDone)
	local Anim = getAnim()
	if Anim == nil or not isGui(logo) or not Anim.enabled() then
		callDone(onDone)
		return
	end
	local ok, err = pcall(function()
		local scale = scaleOf(logo)
		local rest = restRotation(logo)
		if scale ~= nil then
			scale.Scale = 0.55
		end
		logo.Rotation = rest - 12
		Anim.fadeIn(logo, 0.16)
		-- 0 -> 60 % : 55 % -> 110 % et -12° -> +3° ; 60 % -> 100 % : 110 % -> 100 % et +3° -> 0°
		Anim.step(function(_, a)
			local s, r
			if a < 0.6 then
				local k = quadOut(a / 0.6)
				s = 0.55 + (1.1 - 0.55) * k
				r = -12 + 15 * k
			else
				local k = sineInOut((a - 0.6) / 0.4)
				s = 1.1 - 0.1 * k
				r = 3 - 3 * k
			end
			if a >= 1 then
				s, r = 1, 0
			end
			if scale ~= nil then
				set(scale, "Scale", s)
			end
			set(logo, "Rotation", rest + r)
		end, POP_TIME, "linear", onDone, logo)
	end)
	if not ok then
		warn("[Blocs FR] Logo : " .. tostring(err))
		callDone(onDone)
	end
end

-- Petit coucou : les trois blocs du logo sautent l'un après l'autre (bleu, blanc, rouge) et le
-- logo penche un instant. Logo importé (image) : il grossit un peu puis revient.
function Logo.wiggle(logo)
	local Anim = getAnim()
	if Anim == nil or not isGui(logo) or not Anim.enabled() then
		return
	end
	local ok, err = pcall(function()
		local size = sizes[logo]
		local pieces = {}
		if size ~= nil then
			for _, child in ipairs(logo:GetChildren()) do
				if homes[child] ~= nil then
					table.insert(pieces, child)
				end
			end
		end
		if #pieces == 0 then
			-- image importée (ou logo d'une autre origine) : petit rebond
			Anim.popIn(logo, 0.9)
			return
		end
		local height = math.max(1, math.floor(WIGGLE_HEIGHT * size / 64 + 0.5))
		for _, piece in ipairs(pieces) do
			local home = homes[piece]
			local group = 1
			for i, name in ipairs(BLOCK_NAMES) do
				if piece.Name == name then
					group = i
				end
			end
			Anim.step(function(_, a)
				local dy = math.floor(math.sin(math.pi * a) * height + 0.5)
				if a >= 1 then
					dy = 0
				end
				set(piece, "Position", home - UDim2.fromOffset(0, dy))
			end, WIGGLE_TIME, "linear", nil, piece, (group - 1) * WIGGLE_STEP)
		end
		-- le logo penche (-6°) puis revient, sur toute la durée du saut (clé à part : un « pop »
		-- en cours n'est pas interrompu, les deux finissent à la rotation de repos)
		local rest = restRotation(logo)
		local key = tiltKeys[logo]
		if key == nil then
			key = {}
			tiltKeys[logo] = key
		end
		Anim.step(function(_, a)
			local r = -6 * math.sin(math.pi * a)
			if a >= 1 then
				r = 0
			end
			set(logo, "Rotation", rest + r)
		end, WIGGLE_TIME + 2 * WIGGLE_STEP, "linear", nil, key)
	end)
	if not ok then
		warn("[Blocs FR] Logo : " .. tostring(err))
	end
end

-- Coucou du logo quand la souris entre sur trigger (par défaut le logo). Renvoie la fonction qui
-- coupe la connexion (aussi coupée quand trigger est détruit).
function Logo.attachHover(logo, trigger)
	local target = trigger
	if not isGui(target) then
		target = logo
	end
	if not isGui(target) or not isGui(logo) then
		return function() end
	end
	local last = 0
	local connection = target.MouseEnter:Connect(function()
		-- pas plus d'un coucou toutes les 0,6 s (la souris qui passe et repasse)
		local now = os.clock()
		if now - last < 0.6 then
			return
		end
		last = now
		Logo.wiggle(logo)
	end)
	return function()
		connection:Disconnect()
	end
end

return Logo
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Mannequin</string><ProtectedString name="Source"><![CDATA[-- Mannequin : mannequins 3D (R6, R15, modèle Roblox, pièces séparées) pour le prévisualiseur de hitbox
-- de Blocs FR (SPEC §27). Aucune image : des Parts, un SpecialMesh « Head » et, au choix, des maillages
-- (SpecialMesh FileMesh) ou un modèle chargé par son id.
--
-- Mannequin.build(config) -> Model, avertissementFR|nil
--   config = Reglages.current().previsualisation (SPEC §31) : { type = "R6" | "R15" | "modele" | "pieces",
--            modeleId = "", pieces = { tete, torse, brasGauche, brasDroit, mainGauche, mainDroite,
--            jambeGauche, jambeDroite } } ; nil = R6.
--   Le Model rendu n'a pas de parent : pieds au sol (Y = 0), centré en X = Z = 0, tourné vers -Z (comme
--   CFrame.new()). PrimaryPart = « HumanoidRootPart » à la hauteur habituelle (Y = 3 pour R6 et R15).
--   Toutes les parties sont ancrées, sans collision, sans contact ni requête, sans joints ni scripts :
--   elles sont faites pour une ViewportFrame (aucune physique).
--   * "R6" (défaut) : racine invisible 2 × 2 × 1, Torso 2 × 2 × 1, Head 2 × 1 × 1 (SpecialMesh Head,
--     échelle 1,25), bras et jambes 1 × 2 × 1, et deux petits yeux (décor) pour voir où il regarde.
--   * "R15" : la même silhouette en 15 blocs (UpperTorso, LowerTorso, bras et jambes en 3 morceaux).
--   * "modele" : InsertService:LoadAsset(modeleId) dans un pcall. ATTEND le réseau : à appeler dans
--     task.spawn. Premier Model trouvé, nettoyé (scripts, sons, joints), ancré, mis à l'échelle à
--     ≈ 5 studs de haut, tourné vers -Z et posé au sol. Gardé en cache par id (le 2e appel est immédiat ;
--     un échec n'est pas réessayé pendant 30 s).
--   * "pieces" : mannequin R6 dont chaque pièce non vide devient une Part + SpecialMesh FileMesh (MeshId
--     "rbxassetid://<id>" ; un 2e nombre facultatif dans le texte = TextureId, ex. "12345 67890"), posée sur
--     sa place R6 à l'échelle 1 (les maillages des « packages » R6 sont faits à cette taille) ; les mains,
--     facultatives, sont au bout des bras. "" = la partie en bloc habituelle.
--   Tout échec (id invalide, chargement impossible, modèle vide ou trop gros…) : mannequin R6 + un
--   avertissement en français.
-- Mannequin.setColors(model, palette)   -- "allie" (bleu / blanc) ou "ennemi" (rouge / gris)
-- Extensions (utilisées par HitboxPreview) :
--   Mannequin.armParts(model) -> { BasePart }  -- bras droit (celui qui frappe), main comprise
--   Mannequin.shoulder(model) -> Vector3       -- pivot de l'épaule droite, dans l'espace de la racine
--   Mannequin.grip(model) -> Vector3           -- prise de l'arme (main droite), dans l'espace de la racine
--   Mannequin.parseIds(texte) -> idMaillage|nil, idTexture|nil   (nombres d'au moins 3 chiffres)
--   Attributs posés : BlocsFR_Type (sur le Model), BlocsFR_Partie (racine, tete, torse, bras, main, jambe,
--   pied, visage), BlocsFR_Teinte (assombrissement 0..1), BlocsFR_BrasDroit, BlocsFR_Decor (les yeux :
--   jamais comptés dans un test de hitbox), BlocsFR_Epaule / BlocsFR_Prise (Vector3, sur le Model).
-- NOTE: Reglages.validate ne garde que les chiffres d'un id de pièce : la TextureId facultative ne sert
--   que si quelqu'un appelle build avec ce texte directement.

local InsertService = game:GetService("InsertService")

local Mannequin = {}

Mannequin.TYPES = { "R6", "R15", "modele", "pieces" }
Mannequin.PIECES = {
	"tete",
	"torse",
	"brasGauche",
	"brasDroit",
	"mainGauche",
	"mainDroite",
	"jambeGauche",
	"jambeDroite",
}
Mannequin.NOMS_PIECES = {
	tete = "tête",
	torse = "torse",
	brasGauche = "bras gauche",
	brasDroit = "bras droit",
	mainGauche = "main gauche",
	mainDroite = "main droite",
	jambeGauche = "jambe gauche",
	jambeDroite = "jambe droite",
}
Mannequin.HAUTEUR_RACINE = 3 -- centre de la racine d'un R6 / R15 debout (studs au-dessus du sol)
Mannequin.HAUTEUR_MODELE = 5 -- hauteur d'un modèle chargé par id, après mise à l'échelle
Mannequin.MAX_PIECES_MODELE = 300 -- au-delà, le modèle est refusé (trop lourd à animer)

local V3 = Vector3.new
local RGB = Color3.fromRGB

local NEUTRE = RGB(163, 162, 165)
local YEUX = RGB(24, 26, 36)
local EPAULE = V3(1.5, 0.5, 0) -- comme l'articulation « Right Shoulder » d'un R6
local PRISE = V3(1.5, -0.85, 0) -- bas du bras droit (la main)
local ECHEC_DELAI = 30

local PALETTES = {
	allie = {
		tete = RGB(201, 210, 227),
		bras = RGB(201, 210, 227),
		main = RGB(230, 235, 244),
		torse = RGB(59, 130, 246),
		jambe = RGB(30, 58, 138),
		pied = RGB(23, 37, 84),
	},
	ennemi = {
		tete = RGB(214, 211, 209),
		bras = RGB(214, 211, 209),
		main = RGB(245, 245, 244),
		torse = RGB(220, 38, 38),
		jambe = RGB(75, 85, 99),
		pied = RGB(55, 65, 81),
	},
}
Mannequin.PALETTES = PALETTES

-- Parties du bras droit et du torse d'un vrai personnage (modèle chargé par id)
local NOMS_BRAS_DROIT = { ["Right Arm"] = true, RightUpperArm = true, RightLowerArm = true, RightHand = true, ["Right Hand"] = true }
local NOMS_TORSE = { Torso = true, UpperTorso = true, LowerTorso = true }

---------------------------------------------------------------------------
-- Silhouettes : nom, taille, centre (pieds au sol, regard vers -Z), rôle, pièce, options
---------------------------------------------------------------------------

local R6 = {
	{ nom = "HumanoidRootPart", taille = V3(2, 2, 1), pos = V3(0, 3, 0), role = "racine" },
	{ nom = "Torso", taille = V3(2, 2, 1), pos = V3(0, 3, 0), role = "torse", piece = "torse" },
	{ nom = "Head", taille = V3(2, 1, 1), pos = V3(0, 4.5, 0), role = "tete", piece = "tete", tete = true },
	{ nom = "Left Arm", taille = V3(1, 2, 1), pos = V3(-1.5, 3, 0), role = "bras", piece = "brasGauche" },
	{
		nom = "Right Arm",
		taille = V3(1, 2, 1),
		pos = V3(1.5, 3, 0),
		role = "bras",
		piece = "brasDroit",
		brasDroit = true,
	},
	{ nom = "Left Leg", taille = V3(1, 2, 1), pos = V3(-0.5, 1, 0), role = "jambe", piece = "jambeGauche" },
	{ nom = "Right Leg", taille = V3(1, 2, 1), pos = V3(0.5, 1, 0), role = "jambe", piece = "jambeDroite" },
}

-- Deux petits yeux sur la face avant de la tête (le maillage « Head » à 1,25 avance d'environ 0,62 stud)
local YEUX_TETE = {
	{ nom = "OeilGauche", taille = V3(0.16, 0.3, 0.06), pos = V3(-0.24, 4.6, -0.64), role = "visage", decor = true },
	{ nom = "OeilDroit", taille = V3(0.16, 0.3, 0.06), pos = V3(0.24, 4.6, -0.64), role = "visage", decor = true },
}

-- Mains des « pièces séparées » : au bout des bras
local MAINS = {
	mainGauche = { nom = "Left Hand", taille = V3(1, 0.6, 1), pos = V3(-1.5, 1.9, 0), role = "main", piece = "mainGauche" },
	mainDroite = {
		nom = "Right Hand",
		taille = V3(1, 0.6, 1),
		pos = V3(1.5, 1.9, 0),
		role = "main",
		piece = "mainDroite",
		brasDroit = true,
	},
}

-- R15 en blocs : même silhouette que le R6 (bras de Y = 2 à 4, jambes de 0 à 2, torse de 2 à 4)
local R15 = {
	{ nom = "HumanoidRootPart", taille = V3(2, 2, 1), pos = V3(0, 3, 0), role = "racine" },
	{ nom = "LowerTorso", taille = V3(2, 0.4, 1), pos = V3(0, 2.2, 0), role = "torse", teinte = 0.14 },
	{ nom = "UpperTorso", taille = V3(2, 1.6, 1), pos = V3(0, 3.2, 0), role = "torse" },
	{ nom = "Head", taille = V3(2, 1, 1), pos = V3(0, 4.5, 0), role = "tete", tete = true },
	{ nom = "LeftUpperArm", taille = V3(1, 0.9, 1), pos = V3(-1.5, 3.55, 0), role = "bras" },
	{ nom = "LeftLowerArm", taille = V3(0.94, 0.8, 0.94), pos = V3(-1.5, 2.7, 0), role = "bras", teinte = 0.08 },
	{ nom = "LeftHand", taille = V3(0.9, 0.3, 0.9), pos = V3(-1.5, 2.15, 0), role = "main" },
	{ nom = "RightUpperArm", taille = V3(1, 0.9, 1), pos = V3(1.5, 3.55, 0), role = "bras", brasDroit = true },
	{
		nom = "RightLowerArm",
		taille = V3(0.94, 0.8, 0.94),
		pos = V3(1.5, 2.7, 0),
		role = "bras",
		teinte = 0.08,
		brasDroit = true,
	},
	{ nom = "RightHand", taille = V3(0.9, 0.3, 0.9), pos = V3(1.5, 2.15, 0), role = "main", brasDroit = true },
	{ nom = "LeftUpperLeg", taille = V3(1, 0.9, 1), pos = V3(-0.5, 1.55, 0), role = "jambe" },
	{ nom = "LeftLowerLeg", taille = V3(0.94, 0.8, 0.94), pos = V3(-0.5, 0.7, 0), role = "jambe", teinte = 0.1 },
	{ nom = "LeftFoot", taille = V3(1, 0.3, 1.1), pos = V3(-0.5, 0.15, -0.05), role = "pied" },
	{ nom = "RightUpperLeg", taille = V3(1, 0.9, 1), pos = V3(0.5, 1.55, 0), role = "jambe" },
	{ nom = "RightLowerLeg", taille = V3(0.94, 0.8, 0.94), pos = V3(0.5, 0.7, 0), role = "jambe", teinte = 0.1 },
	{ nom = "RightFoot", taille = V3(1, 0.3, 1.1), pos = V3(0.5, 0.15, -0.05), role = "pied" },
}

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local function trim(s)
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

local function darken(color, amount)
	local k = 1 - math.clamp(amount, 0, 1)
	return Color3.new(color.R * k, color.G * k, color.B * k)
end

-- Partie ancrée, sans collision ni requête (faite pour une ViewportFrame)
local function newPart(spec)
	local part = Instance.new("Part")
	part.Name = spec.nom
	part.Size = spec.taille
	part.CFrame = CFrame.new(spec.pos)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Color = NEUTRE
	if spec.role ~= nil then
		part:SetAttribute("BlocsFR_Partie", spec.role)
	end
	if spec.teinte ~= nil then
		part:SetAttribute("BlocsFR_Teinte", spec.teinte)
	end
	if spec.brasDroit then
		part:SetAttribute("BlocsFR_BrasDroit", true)
	end
	if spec.decor then
		part:SetAttribute("BlocsFR_Decor", true)
		part.Color = YEUX
	end
	if spec.role == "racine" then
		part.Transparency = 1
	end
	return part
end

local function addHeadMesh(part)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = V3(1.25, 1.25, 1.25)
	mesh.Parent = part
end

-- "12345", "rbxassetid://12345", "12345 67890" (maillage + texture) -> "12345", "67890"|nil
-- (seuls les nombres d'au moins 3 chiffres comptent)
local function parseIds(text)
	if type(text) == "number" then
		if text ~= text or text < 1 or text >= 1e15 then
			return nil, nil
		end
		text = string.format("%d", math.floor(text))
	end
	if type(text) ~= "string" then
		return nil, nil
	end
	local ids = {}
	for digits in string.gmatch(text, "%d+") do
		if #digits >= 3 and #digits <= 18 then
			table.insert(ids, digits)
			if #ids >= 2 then
				break
			end
		end
	end
	return ids[1], ids[2]
end
Mannequin.parseIds = parseIds

local function applyFileMesh(part, ids)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://" .. ids.mesh
	if ids.texture ~= nil then
		mesh.TextureId = "rbxassetid://" .. ids.texture
	end
	mesh.Scale = V3(1, 1, 1)
	mesh.Parent = part
	part:SetAttribute("BlocsFR_Maillage", true)
end

local function listWith(base, extra)
	local out = table.clone(base)
	for _, spec in ipairs(extra) do
		table.insert(out, spec)
	end
	return out
end

-- Construit un mannequin à partir d'une liste de parties (meshes = { [piece] = { mesh, texture } } | nil)
local function assemble(list, kind, meshes)
	local model = Instance.new("Model")
	model.Name = "Mannequin"
	local root = nil
	for _, spec in ipairs(list) do
		local part = newPart(spec)
		local ids = nil
		if meshes ~= nil and spec.piece ~= nil then
			ids = meshes[spec.piece]
		end
		if ids ~= nil then
			applyFileMesh(part, ids)
		elseif spec.tete then
			addHeadMesh(part)
		end
		part.Parent = model
		if spec.nom == "HumanoidRootPart" then
			root = part
		end
	end
	model.PrimaryPart = root
	model:SetAttribute("BlocsFR_Type", kind)
	model:SetAttribute("BlocsFR_Epaule", EPAULE)
	model:SetAttribute("BlocsFR_Prise", PRISE)
	return model
end

local function buildR6()
	return assemble(listWith(R6, YEUX_TETE), "R6", nil)
end

local function buildR15()
	return assemble(listWith(R15, YEUX_TETE), "R15", nil)
end

---------------------------------------------------------------------------
-- Pièces séparées (maillages)
---------------------------------------------------------------------------

-- Renvoie le mannequin, ou nil + avertissement (le R6 est alors construit par build)
local function buildPieces(config)
	local pieces = config.pieces
	if type(pieces) ~= "table" then
		pieces = {}
	end
	local meshes = {}
	local count = 0
	for _, key in ipairs(Mannequin.PIECES) do
		local raw = pieces[key]
		if raw ~= nil and trim(tostring(raw)) ~= "" then
			local meshId, textureId = parseIds(raw)
			if meshId == nil then
				return nil,
					"L'ID de la pièce « "
						.. Mannequin.NOMS_PIECES[key]
						.. " » n'est pas valide (il faut un nombre) : mannequin R6 utilisé."
			end
			meshes[key] = { mesh = meshId, texture = textureId }
			count += 1
		end
	end
	if count == 0 then
		return nil, "Aucune pièce n'est choisie (Paramètres → Prévisualisation 3D) : mannequin R6 utilisé."
	end
	local list = table.clone(R6)
	if meshes.tete == nil then
		for _, spec in ipairs(YEUX_TETE) do
			table.insert(list, spec)
		end
	end
	if meshes.mainGauche ~= nil then
		table.insert(list, MAINS.mainGauche)
	end
	if meshes.mainDroite ~= nil then
		table.insert(list, MAINS.mainDroite)
	end
	return assemble(list, "pieces", meshes), nil
end

---------------------------------------------------------------------------
-- Modèle chargé par son id
---------------------------------------------------------------------------

local cache = {} -- [id] = modèle préparé (modèle de référence, jamais affiché)
local echecs = {} -- [id] = { temps = os.clock(), message = "…" }

-- Boîte englobante (axes du monde) d'une partie : x0, y0, z0, x1, y1, z1
local function partBounds(part)
	local cf = part.CFrame
	local h = part.Size / 2
	local xv, yv, zv = cf.XVector, cf.YVector, cf.ZVector
	local ex = math.abs(xv.X) * h.X + math.abs(yv.X) * h.Y + math.abs(zv.X) * h.Z
	local ey = math.abs(xv.Y) * h.X + math.abs(yv.Y) * h.Y + math.abs(zv.Y) * h.Z
	local ez = math.abs(xv.Z) * h.X + math.abs(yv.Z) * h.Y + math.abs(zv.Z) * h.Z
	local p = cf.Position
	return p.X - ex, p.Y - ey, p.Z - ez, p.X + ex, p.Y + ey, p.Z + ez
end

-- Boîte englobante (axes du monde) de toutes les parties d'un modèle : min, max (nil si aucune partie)
local function worldBounds(model)
	local x0, y0, z0 = math.huge, math.huge, math.huge
	local x1, y1, z1 = -math.huge, -math.huge, -math.huge
	local count = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local a, b, c, e, f, g = partBounds(d)
			x0 = math.min(x0, a)
			y0 = math.min(y0, b)
			z0 = math.min(z0, c)
			x1 = math.max(x1, e)
			y1 = math.max(y1, f)
			z1 = math.max(z1, g)
			count += 1
		end
	end
	if count == 0 then
		return nil, nil
	end
	return V3(x0, y0, z0), V3(x1, y1, z1)
end

-- Met un modèle à l'échelle (Model:ScaleTo, sinon partie par partie autour de son pivot)
local function scaleModel(model, factor)
	local ok = pcall(function()
		model:ScaleTo(model:GetScale() * factor)
	end)
	if ok then
		return
	end
	local pivot = model:GetPivot()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			d.Size = d.Size * factor
			d.CFrame = pivot * (CFrame.new(rel.Position * factor) * rel.Rotation)
		elseif d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.FileMesh then
			d.Scale = d.Scale * factor
		end
	end
end

-- Prépare le contenu de LoadAsset. Renvoie le modèle prêt, ou nil + raison ("vide" / "gros").
local function prepareModele(asset)
	local modele = nil
	for _, child in ipairs(asset:GetChildren()) do
		if child:IsA("Model") then
			modele = child
			break
		end
	end
	if modele == nil then
		modele = asset:FindFirstChildWhichIsA("Model", true)
	end
	if modele == nil then
		modele = asset -- le conteneur porte directement les pièces (ex. une MeshPart seule)
	end
	if modele ~= asset then
		modele.Parent = nil
		asset:Destroy()
	end

	-- Nettoyage : ni scripts, ni sons, ni joints (les parties sont ancrées à leur place)
	for _, d in ipairs(modele:GetDescendants()) do
		local remove = d:IsA("LuaSourceContainer")
			or d:IsA("JointInstance")
			or d:IsA("Constraint")
			or d:IsA("Sound")
			or d.ClassName == "WeldConstraint"
			or d.ClassName == "NoCollisionConstraint"
		if remove then
			pcall(function()
				d:Destroy()
			end)
		end
	end

	local count = 0
	for _, d in ipairs(modele:GetDescendants()) do
		if d:IsA("BasePart") then
			count += 1
			pcall(function()
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.CastShadow = false
				d.Archivable = true
			end)
		elseif d:IsA("Humanoid") then
			pcall(function()
				d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end)
		end
	end
	if count == 0 then
		modele:Destroy()
		return nil, "vide"
	end
	if count > Mannequin.MAX_PIECES_MODELE then
		modele:Destroy()
		return nil, "gros"
	end
	modele.Archivable = true

	local root = modele:FindFirstChild("HumanoidRootPart", true)
	if root ~= nil and not root:IsA("BasePart") then
		root = nil
	end
	if root == nil and modele.PrimaryPart ~= nil then
		root = modele.PrimaryPart
	end

	-- 1) Tourné vers -Z (on le garde debout : seule la rotation autour de Y compte)
	local look
	if root ~= nil then
		look = root.CFrame.LookVector
	else
		look = modele:GetPivot().LookVector
	end
	local flat = V3(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = V3(0, 0, -1)
	end
	flat = flat.Unit
	local yaw = math.atan2(-flat.X, -flat.Z)
	local lo, hi = worldBounds(modele)
	local center = (lo + hi) / 2
	local turn = CFrame.new(center) * CFrame.Angles(0, -yaw, 0) * CFrame.new(-center)
	modele:PivotTo(turn * modele:GetPivot())

	-- 2) Environ 5 studs de haut
	lo, hi = worldBounds(modele)
	local height = hi.Y - lo.Y
	if height < 0.05 then
		modele:Destroy()
		return nil, "vide"
	end
	scaleModel(modele, Mannequin.HAUTEUR_MODELE / height)

	-- 3) Posé au sol, centré
	lo, hi = worldBounds(modele)
	local mid = (lo + hi) / 2
	modele:PivotTo(CFrame.new(-mid.X, -lo.Y, -mid.Z) * modele:GetPivot())

	-- Racine : celle du personnage, sinon une racine invisible à la hauteur d'un R6
	if root == nil then
		root = newPart({
			nom = "HumanoidRootPart",
			taille = V3(2, 2, 1),
			pos = V3(0, Mannequin.HAUTEUR_MODELE * 0.6, 0),
			role = "racine",
		})
		root.Parent = modele
	end
	modele.PrimaryPart = root
	modele.Name = "Mannequin"
	modele:SetAttribute("BlocsFR_Type", "modele")

	-- Bras droit (pour le coup), épaule et prise de l'arme
	local rootCF = root.CFrame
	local upper, hand = nil, nil
	for _, d in ipairs(modele:GetDescendants()) do
		if d:IsA("BasePart") and NOMS_BRAS_DROIT[d.Name] then
			d:SetAttribute("BlocsFR_BrasDroit", true)
			if d.Name == "RightUpperArm" or (d.Name == "Right Arm" and upper == nil) then
				upper = d
			end
			if d.Name == "RightHand" or d.Name == "Right Hand" then
				hand = d
			end
		end
	end
	local epaule = EPAULE
	local prise = PRISE
	if upper ~= nil then
		local rel = rootCF:PointToObjectSpace(upper.Position)
		epaule = V3(rel.X, rel.Y + upper.Size.Y / 2 - math.min(0.5, upper.Size.Y / 4), rel.Z)
		local bout = hand or upper
		local relHand = rootCF:PointToObjectSpace(bout.Position)
		prise = V3(relHand.X, relHand.Y - bout.Size.Y / 2 + 0.15, relHand.Z)
	end
	modele:SetAttribute("BlocsFR_Epaule", epaule)
	modele:SetAttribute("BlocsFR_Prise", prise)
	return modele, nil
end

-- Charge (ou reprend du cache) le modèle d'id « id » (texte de chiffres). ATTEND le réseau.
local function loadModele(id)
	local template = cache[id]
	if template ~= nil then
		local copy = template:Clone()
		if copy ~= nil then
			return copy, nil
		end
	end
	local echec = echecs[id]
	if echec ~= nil and os.clock() - echec.temps < ECHEC_DELAI then
		return nil, echec.message
	end
	local okLoad, asset = pcall(function()
		return InsertService:LoadAsset(tonumber(id))
	end)
	local message = nil
	local modele = nil
	if not okLoad or typeof(asset) ~= "Instance" then
		message = "Le modèle "
			.. id
			.. " n'a pas pu être chargé (il doit être public ou t'appartenir) : mannequin R6 utilisé."
	else
		local okPrep, result, why = pcall(prepareModele, asset)
		if okPrep and typeof(result) == "Instance" then
			modele = result
		else
			pcall(function()
				asset:Destroy()
			end)
			if okPrep and why == "gros" then
				message = "Le modèle "
					.. id
					.. " a trop de pièces (plus de "
					.. Mannequin.MAX_PIECES_MODELE
					.. ") : mannequin R6 utilisé."
			else
				message = "Le modèle " .. id .. " ne contient pas de pièces 3D utilisables : mannequin R6 utilisé."
			end
		end
	end
	if modele == nil then
		echecs[id] = { temps = os.clock(), message = message }
		return nil, message
	end
	echecs[id] = nil
	local ok, copy = pcall(function()
		return modele:Clone()
	end)
	if ok and copy ~= nil then
		cache[id] = copy
	end
	return modele, nil
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------

function Mannequin.build(config)
	if type(config) ~= "table" then
		return buildR6(), nil
	end
	local kind = config.type
	if kind == "R15" then
		return buildR15(), nil
	elseif kind == "pieces" then
		local ok, model, warnFR = pcall(buildPieces, config)
		if ok and typeof(model) == "Instance" then
			return model, nil
		end
		if not ok then
			warnFR = "Les pièces séparées n'ont pas pu être construites : mannequin R6 utilisé."
		end
		return buildR6(), warnFR
	elseif kind == "modele" then
		local id = parseIds(config.modeleId)
		if id == nil then
			return buildR6(), "Indique l'ID d'un modèle Roblox (un nombre) dans « Modèle par id » : mannequin R6 utilisé."
		end
		local ok, model, warnFR = pcall(loadModele, id)
		if ok and typeof(model) == "Instance" then
			return model, nil
		end
		if not ok or warnFR == nil then
			warnFR = "Le modèle " .. id .. " n'a pas pu être chargé : mannequin R6 utilisé."
		end
		return buildR6(), warnFR
	end
	return buildR6(), nil
end

-- Couleurs d'équipe : "allie" (bleu / blanc) ou "ennemi" (rouge / gris). Un modèle chargé par id ne
-- change que son torse ; un maillage texturé est seulement teinté.
function Mannequin.setColors(model, palette)
	if typeof(model) ~= "Instance" then
		return
	end
	local colors = PALETTES[palette]
	if colors == nil then
		colors = PALETTES.allie
	end
	local isModele = model:GetAttribute("BlocsFR_Type") == "modele"
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("BlocsFR_Partie")
			if role == nil and isModele and NOMS_TORSE[d.Name] then
				role = "torse"
			end
			local color = nil
			if type(role) == "string" then
				color = colors[role]
			end
			if color ~= nil then
				local teinte = tonumber(d:GetAttribute("BlocsFR_Teinte")) or 0
				if teinte > 0 then
					color = darken(color, teinte)
				end
				d.Color = color
				local mesh = d:FindFirstChildOfClass("SpecialMesh")
				if mesh ~= nil and mesh.MeshType == Enum.MeshType.FileMesh and mesh.TextureId ~= "" then
					local mix = Color3.new(1, 1, 1):Lerp(color, 0.35)
					mesh.VertexColor = V3(mix.R, mix.G, mix.B)
				end
			end
		end
	end
	model:SetAttribute("BlocsFR_Palette", palette)
end

-- Parties du bras droit (main comprise), dans l'ordre du modèle
function Mannequin.armParts(model)
	local out = {}
	if typeof(model) ~= "Instance" then
		return out
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("BlocsFR_BrasDroit") == true then
			table.insert(out, d)
		end
	end
	return out
end

function Mannequin.shoulder(model)
	if typeof(model) == "Instance" then
		local v = model:GetAttribute("BlocsFR_Epaule")
		if typeof(v) == "Vector3" then
			return v
		end
	end
	return EPAULE
end

function Mannequin.grip(model)
	if typeof(model) == "Instance" then
		local v = model:GetAttribute("BlocsFR_Prise")
		if typeof(v) == "Vector3" then
			return v
		end
	end
	return PRISE
end

return Mannequin
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">MiseAJour</string><ProtectedString name="Source"><![CDATA[-- MiseAJour : la petite notification « mise à jour disponible » de Blocs FR (SPEC §25).
-- Demande : « une petite notif lorsque le plugin détecte qu'il peut être mis à jour ».
--
-- API (SPEC §25) :
--   MiseAJour.VERSION = "2.1.0"            -- version du plugin (seule source : Main en fait host.version)
--   MiseAJour.compare(a, b) -> -1 | 0 | 1   -- "x.y.z" (parties manquantes = 0)
--   MiseAJour.start(deps) -> stopFn         -- deps = { host, getLayer = fn -> Frame, openWiki = fn(pageId),
--                                           --         onStatus = fn(info) }
--   MiseAJour.check(force) -> info          -- { status = "a_jour"|"nouvelle"|"inconnu"|"desactive",
--                                           --   latest = texte|nil, notes = texte|nil, source = "store"|"url"|nil }
--   MiseAJour.showNotice(info)              -- la carte (aussi utilisée par DevBridge « simulateUpdate »)
-- Extensions (NOTE: en plus de la SPEC) :
--   MiseAJour.check(force, host)            -- host facultatif (sinon celui de start) pour lire / écrire le cache
--   MiseAJour.showNotice(info, deps)        -- deps facultatif (sinon ceux de start) : getLayer, openWiki, host
--   info.status = "mis_a_jour"              -- carte « Blocs FR a été mis à jour en <VERSION> ✓ »
--   info.current (= VERSION), info.raison ("reglage" | "aucune_source" | "erreur"), info.erreur (texte)
--   MiseAJour.parse(texte) -> "x.y.z"|nil   -- version trouvée dans un texte (description du Creator Store)
--   MiseAJour.hideNotice() ; MiseAJour.isNoticeVisible() -> bool ; MiseAJour.lastInfo() -> info|nil
--   deps.isEnabled = fn -> bool (facultatif, App) : false -> "desactive" (comme le paramètre)
--   deps.restored = true (facultatif, App) : éditeur reconstruit après « Paramètres → Appliquer » :
--     aucune carte ne s'ouvre toute seule (deps.onStatus est quand même appelé)
--
-- Fonctionnement :
--   * Sources facultatives, toujours dans un pcall et jamais dans l'affichage (task.spawn) :
--     Theme.PluginAssetId ~= 0 -> MarketplaceService:GetProductInfo (version lue dans la description :
--     « Version : 2.2.0 ») ; Theme.UpdateUrl ~= "" -> HttpService:GetAsync d'un JSON
--     { "version": "2.2.0", "notes": "…" }. Rien de réglé -> "desactive" (aucun accès au réseau).
--   * Paramètre « Vérifier les mises à jour » (Reglages.current().majs.verifier) éteint -> "desactive".
--   * Au plus une vérification toutes les 6 h (réglage BlocsFR_MajDerniereVerif) ; le dernier résultat
--     est gardé (BlocsFR_MajInfo) et resservi entre deux vérifications.
--   * Nouvelle version -> carte en bas à droite de l'éditeur (au-dessus de la barre d'état, 340 px, style
--     des fenêtres avec une barre de couleur de 4 px, arrivée en glissant avec Anim) + une seule ligne
--     dans la sortie + deps.onStatus(info) (App met un point sur le « ? »). « Plus tard » retient la
--     version (BlocsFR_MajIgnoree) : plus de carte pour elle.
--   * Après une mise à jour (BlocsFR_DerniereVersionVue plus ancienne que VERSION) : carte « Blocs FR a
--     été mis à jour en … ✓ » une seule fois ; au premier lancement, la version est seulement notée.
-- NOTE: la carte d'une même nouvelle version ne s'ouvre toute seule qu'une fois par session de Studio
--   (réglage BlocsFR_MajCarteVue + host.sessionStart) : reconstruire l'éditeur (Paramètres → Appliquer)
--   ne la refait pas apparaître ; deps.onStatus est quand même appelé.
-- NOTE: le texte de la carte écrit « Plugins → Gérer les plugins → Mettre à jour » (la SPEC écrit « › »,
--   un signe que la police de Studio n'affiche pas toujours).
-- NOTE: la carte d'après mise à jour s'affiche même si « Vérifier les mises à jour » est éteint : elle
--   ne consulte aucun réseau et n'apparaît qu'une fois par version.
-- NOTE: la carte se pose tout en bas de son calque (ZIndex 0) : les fenêtres, panneaux, menus et
--   notifications du même calque passent devant elle, elle ne cache jamais leurs boutons. Le calque
--   donné par deps.getLayer doit être SOUS celui des glissements (App : CalqueProblemes) : au-dessus,
--   la carte (Active) recevrait le relâchement de la souris à la place du bouton de suivi d'un glissement.
-- NOTE: showNotice(info, deps) : les champs absents de deps (getLayer, openWiki, host) sont ceux de
--   start (DevBridge « simulateUpdate » pose ainsi sa carte dans le calque choisi par App).

local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)

local MiseAJour = {}

MiseAJour.VERSION = "2.1.0"

MiseAJour.SETTING_LAST_CHECK = "BlocsFR_MajDerniereVerif"
MiseAJour.SETTING_INFO = "BlocsFR_MajInfo"
MiseAJour.SETTING_IGNORED = "BlocsFR_MajIgnoree"
MiseAJour.SETTING_SEEN = "BlocsFR_DerniereVersionVue"
MiseAJour.SETTING_CARD = "BlocsFR_MajCarteVue"
MiseAJour.INTERVAL = 6 * 3600 -- au plus une vérification toutes les 6 heures
MiseAJour.WIKI_PAGE = "nouveautes"

local START_DELAY = 4 -- secondes avant la vérification (l'éditeur finit de s'ouvrir)
local UPDATED_DELAY = 1.5 -- carte « mis à jour » : juste après l'ouverture
local CARD_W = 340
local CARD_MARGIN = 14
local CARD_Z = 0 -- tout en bas de son calque : fenêtres, panneaux et menus passent devant (voir NOTE)
local MAX_NOTES = 220 -- caractères des notes de version affichées dans la carte
local VERSION_PATTERN = "[Vv]ersion%s*:?%s*[vV]?(%d+%.%d+%.?%d*)"

-- État du module : session démarrée par start, carte affichée, dernières infos
local state = {
	session = nil, -- { deps, stopped }
	host = nil,
	card = nil, -- { root, closing, connections, kind, latest }
	lastInfo = nil,
	printed = {}, -- versions déjà annoncées dans la sortie (une ligne par version)
}

---------------------------------------------------------------------------
-- Modules facultatifs (écrits par d'autres : leur absence ne casse jamais rien)
---------------------------------------------------------------------------

local function optional(name)
	local folder = script.Parent
	local moduleScript = folder and folder:FindFirstChild(name)
	if moduleScript == nil or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local function anim(name, ...)
	local Anim = optional("Anim")
	if Anim == nil or type(Anim[name]) ~= "function" then
		return nil
	end
	local ok, result = pcall(Anim[name], ...)
	if ok then
		return result
	end
	return nil
end

-- Délai d'une animation (vitesse des réglages) pour caler un task.delay dessus
local function scaled(seconds)
	local value = anim("scaled", seconds)
	if type(value) == "number" then
		return value
	end
	return seconds
end

---------------------------------------------------------------------------
-- Versions
---------------------------------------------------------------------------

local function versionParts(v)
	local parts = {}
	if type(v) == "number" then
		v = tostring(v)
	end
	if type(v) ~= "string" then
		return parts
	end
	local text = string.match(v, "(%d[%d%.]*)") or ""
	for piece in string.gmatch(text, "[^%.]+") do
		table.insert(parts, tonumber(piece) or 0)
	end
	return parts
end

-- -1 si a < b, 0 si égales, 1 si a > b ("2.1" = "2.1.0" ; texte illisible = 0.0.0)
function MiseAJour.compare(a, b)
	local pa = versionParts(a)
	local pb = versionParts(b)
	local n = math.max(#pa, #pb, 1)
	for i = 1, n do
		local x = pa[i] or 0
		local y = pb[i] or 0
		if x < y then
			return -1
		elseif x > y then
			return 1
		end
	end
	return 0
end

-- Version écrite dans un texte (« Version : 2.2.0 », « version v2.2 »…) ou nil
function MiseAJour.parse(text)
	if type(text) ~= "string" then
		return nil
	end
	local found = string.match(text, VERSION_PATTERN)
	if found == nil then
		return nil
	end
	found = string.gsub(found, "%.$", "")
	return found
end

local function cleanVersion(v)
	if type(v) == "number" then
		v = tostring(v)
	end
	if type(v) ~= "string" then
		return nil
	end
	local text = string.match(Util.trim(v), "^[vV]?(%d+[%d%.]*)")
	if text == nil then
		return nil
	end
	text = string.gsub(text, "%.$", "")
	return text
end

---------------------------------------------------------------------------
-- Réglages du plugin (host.getSetting / host.setSetting)
---------------------------------------------------------------------------

local function hostOf(host)
	if type(host) == "table" then
		return host
	end
	if state.session ~= nil and type(state.session.deps.host) == "table" then
		return state.session.deps.host
	end
	return state.host
end

local function readSetting(host, key)
	if type(host) ~= "table" or type(host.getSetting) ~= "function" then
		return nil
	end
	local ok, value = pcall(host.getSetting, key)
	if ok then
		return value
	end
	return nil
end

local function writeSetting(host, key, value)
	if type(host) ~= "table" or type(host.setSetting) ~= "function" then
		return
	end
	pcall(host.setSetting, key, value)
end

-- Paramètre « Vérifier les mises à jour » (vrai si Reglages est absent) ; deps.isEnabled d'App aussi
local function checkingAllowed()
	local session = state.session
	if session ~= nil and type(session.deps.isEnabled) == "function" then
		local okEnabled, enabled = pcall(session.deps.isEnabled)
		if okEnabled and enabled == false then
			return false
		end
	end
	local Reglages = optional("Reglages")
	if Reglages == nil or type(Reglages.current) ~= "function" then
		return true
	end
	local ok, s = pcall(Reglages.current)
	if ok and type(s) == "table" and type(s.majs) == "table" and s.majs.verifier == false then
		return false
	end
	return true
end

local function assetId()
	local id = tonumber(Theme.PluginAssetId)
	if id == nil or id ~= id or id <= 0 then
		return nil
	end
	return math.floor(id)
end

local function updateUrl()
	local url = Theme.UpdateUrl
	if type(url) ~= "string" then
		return nil
	end
	url = Util.trim(url)
	if url == "" then
		return nil
	end
	return url
end

---------------------------------------------------------------------------
-- Vérification (réseau : ne jamais appeler depuis un affichage)
---------------------------------------------------------------------------

local function fromStore(id)
	local MarketplaceService = game:GetService("MarketplaceService")
	local ok, product = pcall(function()
		return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
	end)
	if not ok or type(product) ~= "table" then
		return nil, "Creator Store : " .. tostring(product)
	end
	local latest = MiseAJour.parse(tostring(product.Description or ""))
	if latest == nil then
		return nil, "Creator Store : aucune « Version : x.y.z » dans la description"
	end
	return { latest = latest, notes = nil, source = "store" }, nil
end

local function fromUrl(url)
	local ok, body = pcall(function()
		return HttpService:GetAsync(url, true)
	end)
	if not ok or type(body) ~= "string" then
		return nil, "adresse : " .. tostring(body)
	end
	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not okDecode or type(data) ~= "table" then
		return nil, "adresse : JSON illisible"
	end
	local latest = cleanVersion(data.version)
	if latest == nil then
		return nil, "adresse : champ « version » manquant"
	end
	local notes = nil
	if type(data.notes) == "string" and Util.trim(data.notes) ~= "" then
		notes = Util.trim(data.notes)
	end
	return { latest = latest, notes = notes, source = "url" }, nil
end

local function statusFor(latest)
	if latest == nil then
		return "inconnu"
	end
	if MiseAJour.compare(latest, MiseAJour.VERSION) > 0 then
		return "nouvelle"
	end
	return "a_jour"
end

-- Résultat gardé (BlocsFR_MajInfo) -> info, état recalculé avec la version installée
local function fromCache(raw)
	if type(raw) ~= "table" then
		return nil
	end
	local latest = cleanVersion(raw.latest)
	local info = {
		status = statusFor(latest),
		latest = latest,
		notes = type(raw.notes) == "string" and raw.notes or nil,
		source = (raw.source == "store" or raw.source == "url") and raw.source or nil,
		current = MiseAJour.VERSION,
		cache = true,
	}
	return info
end

function MiseAJour.check(force, host)
	host = hostOf(host)
	if not checkingAllowed() then
		return { status = "desactive", current = MiseAJour.VERSION, raison = "reglage" }
	end
	local id = assetId()
	local url = updateUrl()
	if id == nil and url == nil then
		return { status = "desactive", current = MiseAJour.VERSION, raison = "aucune_source" }
	end
	if force ~= true then
		local last = tonumber(readSetting(host, MiseAJour.SETTING_LAST_CHECK))
		local cached = fromCache(readSetting(host, MiseAJour.SETTING_INFO))
		if last ~= nil and cached ~= nil and os.time() - last < MiseAJour.INTERVAL and os.time() >= last then
			state.lastInfo = cached
			return cached
		end
	end

	local result, err = nil, nil
	if id ~= nil then
		result, err = fromStore(id)
	end
	if result == nil and url ~= nil then
		local errStore = err
		result, err = fromUrl(url)
		if result == nil and errStore ~= nil then
			err = errStore .. " ; " .. tostring(err)
		end
	end

	local info
	if result == nil then
		info = { status = "inconnu", current = MiseAJour.VERSION, raison = "erreur", erreur = err }
	else
		info = {
			status = statusFor(result.latest),
			latest = result.latest,
			notes = result.notes,
			source = result.source,
			current = MiseAJour.VERSION,
		}
	end
	writeSetting(host, MiseAJour.SETTING_LAST_CHECK, os.time())
	if result ~= nil then
		writeSetting(host, MiseAJour.SETTING_INFO, {
			latest = info.latest,
			notes = info.notes,
			source = info.source,
			time = os.time(),
		})
	end
	state.lastInfo = info
	return info
end

function MiseAJour.lastInfo()
	return state.lastInfo
end

---------------------------------------------------------------------------
-- La carte
---------------------------------------------------------------------------

local function textHeight(text, size, font, width)
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(math.max(width, 10), 10000))
	end)
	if ok then
		return math.ceil(result.Y)
	end
	return size * 2
end

-- Coupe un texte UTF-8 à n caractères (avec « … »)
local function shorten(text, n)
	text = string.gsub(tostring(text or ""), "%c+", " ")
	local len = utf8.len(text)
	if len == nil or len <= n then
		return text
	end
	local cut = utf8.offset(text, n + 1)
	if cut == nil then
		return text
	end
	return Util.trim(string.sub(text, 1, cut - 1)) .. "…"
end

local function destroyCard(card)
	if card == nil then
		return
	end
	for _, c in ipairs(card.connections) do
		pcall(function()
			if type(c) == "function" then
				c()
			else
				c:Disconnect()
			end
		end)
	end
	card.connections = {}
	if card.root ~= nil then
		local root = card.root
		card.root = nil
		pcall(function()
			root:Destroy()
		end)
	end
end

function MiseAJour.hideNotice()
	local card = state.card
	if card == nil then
		return
	end
	state.card = nil
	if card.closing then
		return
	end
	card.closing = true
	local root = card.root
	if root == nil or root.Parent == nil then
		destroyCard(card)
		return
	end
	-- les boutons ne répondent plus pendant la sortie
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiButton") then
			d.Active = false
			d.AutoButtonColor = false
		end
	end
	local done = false
	local function finish()
		if not done then
			done = true
			destroyCard(card)
		end
	end
	if anim("slideOut", root, Vector2.new(0, 24), 0.18, finish) == nil then
		-- (slideOut ne renvoie rien : on termine aussi par sécurité après la durée)
		task.delay(scaled(0.18) + 0.1, finish)
	end
end

function MiseAJour.isNoticeVisible()
	return state.card ~= nil and state.card.root ~= nil and not state.card.closing
end

-- deps de showNotice : les champs absents sont ceux de start (le calque choisi par App, par exemple)
local function depsFor(deps)
	local base = nil
	if state.session ~= nil and type(state.session.deps) == "table" then
		base = state.session.deps
	end
	if type(deps) ~= "table" then
		return base or {}
	end
	if base == nil or base == deps then
		return deps
	end
	local merged = {}
	for k, v in pairs(base) do
		merged[k] = v
	end
	for k, v in pairs(deps) do
		merged[k] = v
	end
	return merged
end

local function makeButton(parent, text, primary, order)
	local C = Theme.Colors
	local font = Theme.Fonts.UIBold
	local size = 13
	local width = Util.textSize(text, size, font).X + 26
	local bg = C.Button
	local hover = C.ButtonHover
	local fg = C.Text
	if primary then
		bg = C.Accent
		hover = C.AccentHover
		fg = Color3.fromRGB(255, 255, 255)
	end
	local button = Util.create("TextButton", {
		Name = "Bouton",
		AutoButtonColor = false,
		BackgroundColor3 = bg,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, 30),
		Font = font,
		TextSize = size,
		TextColor3 = fg,
		Text = text,
		LayoutOrder = order,
		Parent = parent,
	})
	Util.corner(button, 8)
	local connections = {}
	local disconnectHover = anim("hover", button, bg, hover)
	if type(disconnectHover) == "function" then
		table.insert(connections, disconnectHover)
	else
		table.insert(connections, button.MouseEnter:Connect(function()
			button.BackgroundColor3 = hover
		end))
		table.insert(connections, button.MouseLeave:Connect(function()
			button.BackgroundColor3 = bg
		end))
	end
	local disconnectPress = anim("press", button)
	if type(disconnectPress) == "function" then
		table.insert(connections, disconnectPress)
	end
	return button, connections
end

-- Construit la carte (info.status = "nouvelle" ou "mis_a_jour") dans le calque ; renvoie la carte ou nil
local function buildCard(info, deps)
	local layer = nil
	if type(deps.getLayer) == "function" then
		local ok, result = pcall(deps.getLayer)
		if ok then
			layer = result
		end
	end
	if typeof(layer) ~= "Instance" or not layer:IsA("GuiBase2d") then
		return nil
	end
	local C = Theme.Colors
	local updated = info.status == "mis_a_jour"
	local latest = cleanVersion(info.latest) or MiseAJour.VERSION
	local current = cleanVersion(info.current) or MiseAJour.VERSION

	local layerW = layer.AbsoluteSize.X
	local width = CARD_W
	if layerW > 0 and layerW < CARD_W + 2 * CARD_MARGIN then
		width = math.max(220, layerW - 2 * CARD_MARGIN)
	end
	local statusBar = tonumber(Theme.Layout and Theme.Layout.StatusBarHeight) or 28
	local inner = width - 18 - 14 -- marge gauche (barre de couleur comprise) et droite

	local card = { root = nil, closing = false, connections = {}, kind = info.status, latest = latest }
	-- (hauteur calculée à la fin : en-tête + paragraphes + boutons + marges)
	local root = Util.create("Frame", {
		Name = "BlocsFR_MiseAJour",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -CARD_MARGIN, 1, -(statusBar + 12)),
		Size = UDim2.fromOffset(width, 120),
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Active = true,
		ZIndex = CARD_Z,
	})
	card.root = root
	Util.corner(root, 12)
	Util.stroke(root, C.PopupBorder, 1)
	-- barre de couleur à gauche (4 px)
	local bar = Util.create("Frame", {
		Name = "Barre",
		BackgroundColor3 = updated and C.Success or C.Accent,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0, 4, 1, 0),
		Parent = root,
	})
	Util.corner(bar, 2)

	local PAD_TOP, PAD_BOTTOM, GAP = 12, 14, 8
	local content = Util.create("Frame", {
		Name = "Contenu",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = root,
	})
	Util.create("UIPadding", {
		PaddingTop = UDim.new(0, PAD_TOP),
		PaddingBottom = UDim.new(0, PAD_BOTTOM),
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 14),
		Parent = content,
	})
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, GAP),
		Parent = content,
	})
	local heights = {} -- hauteurs des lignes du contenu (pour la taille de la carte)

	-- En-tête : logo, titre, fermer
	local title
	if updated then
		title = "Blocs FR a été mis à jour en " .. MiseAJour.VERSION .. " ✓"
	else
		title = "Mise à jour disponible"
	end
	local header = Util.create("Frame", {
		Name = "EnTete",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 1,
		Parent = content,
	})
	local logoHolder = Util.create("Frame", {
		Name = "Logo",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(28, 28),
		Parent = header,
	})
	local Logo = optional("Logo")
	if Logo ~= nil and type(Logo.create) == "function" then
		local okLogo, logo = pcall(Logo.create, logoHolder, 28)
		if okLogo and typeof(logo) == "Instance" then
			pcall(Logo.pop, logo)
		end
	end
	local titleFont = Theme.Fonts.UIBold
	local titleSize = 14
	local titleW = inner - 38 - 28
	local titleH = math.max(28, textHeight(title, titleSize, titleFont, titleW))
	header.Size = UDim2.new(1, 0, 0, titleH)
	table.insert(heights, titleH)
	Util.create("TextLabel", {
		Name = "Titre",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -(38 + 28), 1, 0),
		Font = titleFont,
		TextSize = titleSize,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		Text = title,
		Parent = header,
	})
	local close = Util.create("TextButton", {
		Name = "Fermer",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 4, 0, 0),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = C.PopupHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UIBold,
		TextSize = 16,
		TextColor3 = C.TextDim,
		Text = "×",
		Parent = header,
	})
	Util.corner(close, 6)
	table.insert(card.connections, close.MouseEnter:Connect(function()
		close.BackgroundTransparency = 0
		close.TextColor3 = C.Text
	end))
	table.insert(card.connections, close.MouseLeave:Connect(function()
		close.BackgroundTransparency = 1
		close.TextColor3 = C.TextDim
	end))

	-- Textes
	local function paragraph(name, text, size, color, order)
		local font = Theme.Fonts.UI
		local h = textHeight(text, size, font, inner)
		table.insert(heights, h + 2)
		return Util.create("TextLabel", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, h + 2),
			Font = font,
			TextSize = size,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			Text = text,
			LayoutOrder = order,
			Parent = content,
		})
	end
	if updated then
		local previous = cleanVersion(info.previous)
		local line = "Découvre ce qui a changé dans le wiki : nouveaux blocs, nouveaux outils et nouvelles pages."
		if previous ~= nil then
			line = "Tu avais la version " .. previous .. ". " .. line
		end
		paragraph("Texte", line, 13, C.TextSoft, 2)
	else
		paragraph("Texte", "Blocs FR " .. latest .. " est sorti (tu as " .. current .. ").", 13, C.Text, 2)
		paragraph(
			"Installer",
			"Pour l'installer : Plugins → Gérer les plugins → Mettre à jour, puis rouvre ta place.",
			12,
			C.TextDim,
			3
		)
		if type(info.notes) == "string" and Util.trim(info.notes) ~= "" then
			paragraph("Notes", "Nouveau : " .. shorten(info.notes, MAX_NOTES), 12, C.TextSoft, 4)
		end
	end

	-- Boutons
	local row = Util.create("Frame", {
		Name = "Boutons",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 10,
		Parent = content,
	})
	table.insert(heights, 30)
	local total = PAD_TOP + PAD_BOTTOM
	for i, h in ipairs(heights) do
		total += h
		if i > 1 then
			total += GAP
		end
	end
	root.Size = UDim2.fromOffset(width, total)
	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = row,
	})
	local function openNews()
		MiseAJour.hideNotice()
		if type(deps.openWiki) == "function" then
			task.spawn(function()
				pcall(deps.openWiki, MiseAJour.WIKI_PAGE)
			end)
		end
	end
	local newsLabel = "Nouveautés"
	if updated then
		newsLabel = "Voir les nouveautés"
	end
	local newsButton, newsConnections = makeButton(row, newsLabel, true, 1)
	for _, c in ipairs(newsConnections) do
		table.insert(card.connections, c)
	end
	table.insert(card.connections, newsButton.Activated:Connect(openNews))
	if not updated then
		local laterButton, laterConnections = makeButton(row, "Plus tard", false, 2)
		for _, c in ipairs(laterConnections) do
			table.insert(card.connections, c)
		end
		table.insert(card.connections, laterButton.Activated:Connect(function()
			writeSetting(hostOf(deps.host), MiseAJour.SETTING_IGNORED, latest)
			MiseAJour.hideNotice()
		end))
	end
	table.insert(card.connections, close.Activated:Connect(function()
		MiseAJour.hideNotice()
	end))

	-- La carte disparaît avec son calque (éditeur fermé)
	table.insert(card.connections, root.AncestryChanged:Connect(function(_, parent)
		if parent == nil and state.card == card then
			state.card = nil
			task.defer(destroyCard, card)
		end
	end))

	root.Parent = layer
	anim("slideIn", root, Vector2.new(0, 24), 0.3)
	anim("fadeIn", root, 0.2)
	return card
end

-- Affiche la carte d'une nouvelle version (info.status = "nouvelle") ou d'une mise à jour faite
-- (info.status = "mis_a_jour"). Sans calque : une ligne dans la sortie seulement.
function MiseAJour.showNotice(info, deps)
	if type(info) ~= "table" then
		return false
	end
	deps = depsFor(deps)
	local kind = info.status
	if kind ~= "mis_a_jour" then
		kind = "nouvelle"
	end
	local latest = cleanVersion(info.latest)
	if kind == "nouvelle" and latest == nil then
		return false
	end
	local copy = {}
	for k, v in pairs(info) do
		copy[k] = v
	end
	copy.status = kind
	copy.current = copy.current or MiseAJour.VERSION
	-- une seule carte à la fois
	if state.card ~= nil then
		local old = state.card
		state.card = nil
		destroyCard(old)
	end
	local ok, card = pcall(buildCard, copy, deps)
	if not ok then
		warn("[Blocs FR] Notification de mise à jour : " .. tostring(card))
		return false
	end
	if card == nil then
		if kind == "nouvelle" then
			print("[Blocs FR] Mise à jour disponible : " .. tostring(latest) .. " (installée : " .. MiseAJour.VERSION .. ")")
		end
		return false
	end
	state.card = card
	return true
end

---------------------------------------------------------------------------
-- Démarrage (une fois par App)
---------------------------------------------------------------------------

local function callStatus(deps, info)
	if type(deps.onStatus) == "function" then
		local ok, err = pcall(deps.onStatus, info)
		if not ok then
			warn("[Blocs FR] Mise à jour : " .. tostring(err))
		end
	end
end

local function announce(info)
	local latest = info.latest
	if latest == nil or state.printed[latest] then
		return
	end
	state.printed[latest] = true
	print("[Blocs FR] Mise à jour disponible : " .. latest .. " (installée : " .. MiseAJour.VERSION .. ")")
end

-- Vrai si la carte de cette version s'est déjà ouverte toute seule pendant cette session de Studio
local function alreadyShownThisSession(host, latest)
	local seen = readSetting(host, MiseAJour.SETTING_CARD)
	local session = host and host.sessionStart
	if type(seen) ~= "table" or session == nil then
		return false
	end
	return seen.version == latest and seen.session == session
end

local function rememberShown(host, latest)
	local session = host and host.sessionStart
	if session == nil then
		return
	end
	writeSetting(host, MiseAJour.SETTING_CARD, { version = latest, session = session })
end

function MiseAJour.start(deps)
	deps = type(deps) == "table" and deps or {}
	-- un démarrage précédent (éditeur reconstruit) s'arrête
	if state.session ~= nil then
		state.session.stopped = true
	end
	local session = { deps = deps, stopped = false }
	state.session = session
	if type(deps.host) == "table" then
		state.host = deps.host
	end
	local host = hostOf(deps.host)
	-- éditeur reconstruit (paramètres appliqués) : pas de carte qui s'ouvre toute seule
	local quiet = deps.restored == true

	-- Après une mise à jour : la carte « mis à jour » une fois ; au premier lancement, on note seulement
	local okSeen, seen = pcall(readSetting, host, MiseAJour.SETTING_SEEN)
	if not okSeen then
		seen = nil
	end
	if not quiet and type(seen) == "string" and MiseAJour.compare(seen, MiseAJour.VERSION) < 0 then
		task.delay(UPDATED_DELAY, function()
			if not session.stopped then
				MiseAJour.showNotice({ status = "mis_a_jour", latest = MiseAJour.VERSION, previous = seen }, deps)
			end
		end)
	end
	if seen ~= MiseAJour.VERSION then
		writeSetting(host, MiseAJour.SETTING_SEEN, MiseAJour.VERSION)
	end

	-- Vérification (réseau) en arrière-plan, jamais dans l'affichage
	task.spawn(function()
		task.wait(START_DELAY)
		if session.stopped then
			return
		end
		local ok, info = pcall(MiseAJour.check, false, host)
		if session.stopped then
			return
		end
		if not ok or type(info) ~= "table" then
			info = { status = "inconnu", current = MiseAJour.VERSION, raison = "erreur", erreur = tostring(info) }
		end
		state.lastInfo = info
		callStatus(deps, info)
		if info.status ~= "nouvelle" then
			return
		end
		announce(info)
		local ignored = readSetting(host, MiseAJour.SETTING_IGNORED)
		if quiet or ignored == info.latest or alreadyShownThisSession(host, info.latest) then
			return
		end
		-- (la carte « mis à jour » éventuelle a la priorité : on attend qu'elle soit fermée)
		local waited = 0
		while MiseAJour.isNoticeVisible() and state.card.kind == "mis_a_jour" and waited < 120 do
			waited += task.wait(1)
			if session.stopped then
				return
			end
		end
		if MiseAJour.showNotice(info, deps) then
			rememberShown(host, info.latest)
		end
	end)

	return function()
		session.stopped = true
		if state.session == session then
			state.session = nil
			MiseAJour.hideNotice()
		end
	end
end

return MiseAJour
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">Model</string><ProtectedString name="Source"><![CDATA[-- Model : données d'un projet Blocs FR (blocs, piles, variables, mode), annuler / rétablir et
-- sérialisation JSON. Voir SPEC §6.
--
-- Invariants garantis par toutes les opérations :
--  * chaque bloc possède `inputs` (une entrée par entrée de sa définition) et `sub = {}` ;
--  * les liens descendants (next, sub.DO / sub.ELSE, inputs[nom].block) et les pointeurs montants
--    (parent, slot) sont toujours cohérents ;
--  * un bloc est au premier niveau (présent dans model.tops) si et seulement si parent == nil ;
--  * aucune boucle : un bloc ne contient jamais l'un de ses ancêtres.
-- Les opérations invalides renvoient false et ne modifient rien.
-- Les méthodes qui modifient le modèle ne déclenchent PAS Changed : l'appelant regroupe une action
-- de l'utilisateur puis appelle model:commit(raison) une seule fois.
--
-- Notes de la zone de travail (SPEC §29) : model.notes = { [idNote] = { id, text, x, y, w, couleur,
-- blockId (nil = note libre), replie } } ; ids « n1 », « n2 »… ; positions en unités du canvas.
-- Supprimer un bloc supprime ses notes. Sérialisées sous « notes » (absent = aucune note : les
-- anciens projets se chargent sans changement). Annuler / rétablir les incluent.
-- Blocs désactivés (SPEC §32) : champ de bloc disabled = true (sérialisé seulement quand il est vrai).
-- NOTE: ajouts à la SPEC : model:isDisabled(id, inherited), model:disabledIds(), model:noteIds(),
-- model:stackIds(id), model:detachSingle(id) (« Détacher ce bloc » : la suite prend sa place),
-- importData renvoie aussi les ids des nouvelles notes (3e valeur), setNote accepte
-- blockId = false (détacher la note). duplicate() copie l'état désactivé mais pas les notes
-- (copier / coller : exportStack + importData).
-- Lignes tracées à la main entre deux blocs (SPEC §36) : model.liens = { [idLigne] = { id, de, vers,
-- texte = "", style = "points"|"plein"|"fleche", couleur = {r,g,b}|nil } } ; ids « l1 », « l2 »…
-- API : addLink(de, vers, fields) -> id|nil, getLink(id), setLink(id, fields) -> ok, removeLink(id) -> ok,
-- linksOf(blockId) -> ids (le bloc au départ OU à l'arrivée), linkIds(). Supprimer un bloc supprime ses
-- lignes. Sérialisées sous « liens » (absent = aucune ligne) ; annuler / rétablir les incluent ;
-- importData et exportStack les recopient avec les nouveaux ids (seulement si les deux blocs y sont).

local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)

local Model = {}
Model.__index = Model

Model.FORMAT = "BlocsFR"
Model.VERSION = 1
Model.MAX_HISTORY = 100
Model.DEFAULT_VARIABLE = "ma variable"
Model.EJECT_OFFSET = 24 -- décalage d'un bloc valeur éjecté (par rapport à la racine de la cible)
Model.DUPLICATE_OFFSET = 30 -- décalage par défaut d'une copie (par rapport à la racine de l'original)
Model.MAX_VARIABLE_LENGTH = 50
-- Modes de projet (SPEC §6, §20) : script serveur, script local, script module
Model.MODES = { "server", "local", "module" }

-- Notes (SPEC §29)
Model.NOTE_COLORS = { "jaune", "vert", "bleu", "rose", "violet" }
Model.NOTE_DEFAULT_COLOR = "jaune"
Model.NOTE_DEFAULT_WIDTH = 200
Model.NOTE_MIN_WIDTH = 80
Model.NOTE_MAX_WIDTH = 1200
Model.NOTE_MAX_TEXT = 5000 -- octets (texte UTF-8)

-- Lignes entre les blocs (SPEC §36)
Model.LINK_STYLES = { "points", "plein", "fleche" }
Model.LINK_DEFAULT_STYLE = "points"
Model.LINK_MAX_TEXT = 200 -- octets (texte UTF-8, une seule ligne)

local VALID_MODES = { server = true, ["local"] = true, module = true }
local NOTE_COLOR_SET = { jaune = true, vert = true, bleu = true, rose = true, violet = true }
local LINK_STYLE_SET = { points = true, plein = true, fleche = true }

-- Vrai si mode est un mode de projet valide
function Model.isValidMode(mode)
	return type(mode) == "string" and VALID_MODES[mode] == true
end

local SLOTS = { "DO", "ELSE" }
local STATEMENT_SHAPES = { stack = true, c = true, c2 = true, cap = true }
local VALUE_SHAPES = { reporter = true, boolean = true }
local MAX_STEPS = 1000000 -- garde-fou contre les boucles infinies (données corrompues)

---------------------------------------------------------------------------
-- Petites fonctions utiles
---------------------------------------------------------------------------

local function isFiniteNumber(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function toFinite(value, fallback)
	local n = tonumber(value)
	if isFiniteNumber(n) then
		return n
	end
	return fallback
end

local function indexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

local function removeValue(list, value)
	local i = indexOf(list, value)
	if i ~= nil then
		table.remove(list, i)
	end
	return i
end

local function copySlot(slot)
	if slot == nil then
		return nil
	end
	return { kind = slot.kind, name = slot.name }
end

-- "b12" -> 12 (nil pour un autre format ou un nombre trop grand)
local function idNumber(id)
	if type(id) ~= "string" then
		return nil
	end
	local digits = string.match(id, "^b(%d+)$")
	if digits == nil or #digits > 9 then
		return nil
	end
	return tonumber(digits)
end

-- Ordre déterministe des ids : "b2" < "b10" < "autre"
local function idLess(a, b)
	local na, nb = idNumber(a), idNumber(b)
	if na ~= nil and nb ~= nil then
		if na ~= nb then
			return na < nb
		end
		return a < b
	end
	if na ~= nil then
		return true
	end
	if nb ~= nil then
		return false
	end
	return tostring(a) < tostring(b)
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in pairs(a) do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Notes : petites fonctions (SPEC §29)
---------------------------------------------------------------------------

-- "n12" -> 12 (nil pour un autre format)
local function noteNumber(id)
	if type(id) ~= "string" then
		return nil
	end
	local digits = string.match(id, "^n(%d+)$")
	if digits == nil or #digits > 9 then
		return nil
	end
	return tonumber(digits)
end

-- Ordre déterministe des ids de notes : "n2" < "n10" < "autre"
local function noteIdLess(a, b)
	local na, nb = noteNumber(a), noteNumber(b)
	if na ~= nil and nb ~= nil then
		if na ~= nb then
			return na < nb
		end
		return a < b
	end
	if na ~= nil then
		return true
	end
	if nb ~= nil then
		return false
	end
	return tostring(a) < tostring(b)
end

-- Coupe une chaîne à maxBytes octets sans casser un caractère UTF-8
local function truncateUtf8(s, maxBytes)
	if #s <= maxBytes then
		return s
	end
	local cut = maxBytes
	while cut > 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b < 0x80 or b >= 0xC0 then
			break
		end
		cut -= 1
	end
	return string.sub(s, 1, cut)
end

-- Texte d'une note (UTF-8 valide, longueur limitée) ou nil si la valeur n'est pas un texte
local function cleanNoteText(value)
	if isFiniteNumber(value) then
		value = tostring(value)
	end
	if type(value) ~= "string" then
		return nil
	end
	local text = truncateUtf8(value, Model.NOTE_MAX_TEXT)
	if utf8.len(text) == nil then
		-- octets invalides (données abîmées) : remplacés pour que le JSON reste valide
		text = string.gsub(text, "[\128-\255]", "?")
	end
	return text
end

local function noteWidth(value)
	return Util.clamp(toFinite(value, Model.NOTE_DEFAULT_WIDTH), Model.NOTE_MIN_WIDTH, Model.NOTE_MAX_WIDTH)
end

-- Couleur des nouvelles notes : réglage « notes.couleur » de Reglages (SPEC §31) s'il existe
local function defaultNoteColor()
	local ok, couleur = pcall(function()
		local module = script.Parent:FindFirstChild("Reglages")
		if module == nil or not module:IsA("ModuleScript") then
			return nil
		end
		local Reglages = require(module)
		local settings = Reglages.current()
		return settings.notes.couleur
	end)
	if ok and NOTE_COLOR_SET[couleur] then
		return couleur
	end
	return Model.NOTE_DEFAULT_COLOR
end

-- Note validée à partir de données sérialisées (nil si illisible). blocks : blocs du modèle (une
-- note dont le bloc n'existe pas devient une note libre).
local function readNote(raw, blocks)
	if type(raw) ~= "table" then
		return nil
	end
	local couleur = raw.couleur
	if not NOTE_COLOR_SET[couleur] then
		couleur = Model.NOTE_DEFAULT_COLOR
	end
	local blockId = nil
	if type(raw.blockId) == "string" and blocks[raw.blockId] ~= nil then
		blockId = raw.blockId
	end
	return {
		id = nil,
		text = cleanNoteText(raw.text) or "",
		x = toFinite(raw.x, 0),
		y = toFinite(raw.y, 0),
		w = noteWidth(raw.w),
		couleur = couleur,
		blockId = blockId,
		replie = raw.replie == true,
	}
end

-- Copie JSON-compatible d'une note (sans son id ; décalée de dx, dy)
local function serializeNote(note, dx, dy)
	local saved = {
		text = type(note.text) == "string" and note.text or "",
		x = toFinite(note.x, 0) - dx,
		y = toFinite(note.y, 0) - dy,
		w = noteWidth(note.w),
		couleur = NOTE_COLOR_SET[note.couleur] and note.couleur or Model.NOTE_DEFAULT_COLOR,
	}
	if type(note.blockId) == "string" then
		saved.blockId = note.blockId
	end
	if note.replie == true then
		saved.replie = true
	end
	return saved
end

---------------------------------------------------------------------------
-- Formes de blocs
---------------------------------------------------------------------------

local function isStatement(def)
	return def ~= nil and STATEMENT_SHAPES[def.shape] == true
end

local function isValue(def)
	return def ~= nil and VALUE_SHAPES[def.shape] == true
end

local function isHat(def)
	return def ~= nil and def.shape == "hat"
end

-- Vrai si rien ne peut être attaché sous ce bloc (cap, noNext, valeur, définition inconnue)
local function hasNoNext(def)
	if def == nil then
		return true
	end
	return def.noNext == true or def.shape == "cap" or VALUE_SHAPES[def.shape] == true
end

local function hasSlot(def, slot)
	if def == nil then
		return false
	end
	if slot == "DO" then
		return def.shape == "c" or def.shape == "c2"
	elseif slot == "ELSE" then
		return def.shape == "c2"
	end
	return false
end

-- Une entrée accepte-t-elle un bloc valeur ?
local function acceptsReporter(spec)
	if spec == nil then
		return false
	end
	if spec.kind == "variable" then
		return false
	end
	if spec.kind == "gui" then
		-- nom d'écran / d'élément de l'interface : toujours un littéral (SPEC §21.6)
		return false
	end
	if spec.kind == "dropdown" then
		return spec.acceptReporter == true
	end
	return true
end

---------------------------------------------------------------------------
-- Valeurs littérales des entrées
---------------------------------------------------------------------------

-- {r, g, b} entiers 0-255 (copie) à partir d'une table ou d'une Color3 ; nil si invalide
local function copyColor(value)
	if typeof(value) == "Color3" then
		return Util.color3ToRgb(value)
	end
	if type(value) ~= "table" then
		return nil
	end
	local rgb = {}
	for i = 1, 3 do
		local n = tonumber(value[i])
		if not isFiniteNumber(n) then
			return nil
		end
		rgb[i] = math.floor(Util.clamp(n, 0, 255) + 0.5)
	end
	return rgb
end

local function isKnownOption(spec, code)
	if type(code) ~= "string" then
		return false
	end
	if code == spec.default then
		return true
	end
	for _, option in ipairs(spec.options or {}) do
		if type(option) == "table" and option[2] == code then
			return true
		end
	end
	return false
end

local function toText(value)
	if type(value) == "string" then
		return value
	end
	if isFiniteNumber(value) then
		return tostring(value)
	end
	return nil
end

-- Convertit une valeur littérale pour l'entrée `spec`. Renvoie ok, valeur.
-- Les entrées booléennes n'ont jamais de littéral (ok = false).
local function coerceLiteral(spec, value)
	local kind = spec.kind
	if kind == "number" then
		local n = Util.parseNumber(value)
		if n == nil and type(value) == "string" then
			n = tonumber(Util.trim(value))
		end
		if isFiniteNumber(n) then
			return true, n
		end
	elseif kind == "text" or kind == "any" or kind == "gui" then
		local text = toText(value)
		if text ~= nil then
			return true, text
		end
	elseif kind == "dropdown" then
		if isKnownOption(spec, value) then
			return true, value
		end
	elseif kind == "color" then
		local rgb = copyColor(value)
		if rgb ~= nil then
			return true, rgb
		end
	elseif kind == "variable" then
		if type(value) == "string" and value ~= "" then
			return true, value
		end
	end
	return false, nil
end

-- Valeur par défaut d'une entrée (sauf "variable", gérée par le modèle, et "boolean" = nil)
local function defaultLiteral(spec)
	local kind = spec.kind
	local d = spec.default
	if kind == "number" then
		return toFinite(Util.parseNumber(d), 0)
	elseif kind == "text" or kind == "any" or kind == "gui" then
		if d == nil then
			return ""
		end
		return tostring(d)
	elseif kind == "dropdown" then
		if type(d) == "string" then
			return d
		end
		local first = spec.options and spec.options[1]
		if type(first) == "table" and type(first[2]) == "string" then
			return first[2]
		end
		return ""
	elseif kind == "color" then
		return copyColor(d) or { 255, 0, 0 }
	end
	return nil
end

-- Copie JSON-compatible d'une valeur littérale
local function copyLiteral(value)
	local t = type(value)
	if t == "table" then
		return copyColor(value)
	elseif t == "number" then
		if isFiniteNumber(value) then
			return value
		end
		return 0
	elseif t == "string" or t == "boolean" then
		return value
	end
	return nil
end

local function blockUsesVariable(block, name)
	local def = Registry.get(block.def)
	if def == nil then
		return false
	end
	for _, spec in ipairs(def.inputs or {}) do
		if spec.kind == "variable" then
			local input = block.inputs[spec.name]
			if input ~= nil and input.value == name then
				return true
			end
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Lignes entre les blocs : petites fonctions (SPEC §36)
---------------------------------------------------------------------------

-- "l12" -> 12 (nil pour un autre format)
local function linkNumber(id)
	if type(id) ~= "string" then
		return nil
	end
	local digits = string.match(id, "^l(%d+)$")
	if digits == nil or #digits > 9 then
		return nil
	end
	return tonumber(digits)
end

-- Ordre déterministe des ids de lignes : "l2" < "l10" < "autre"
local function linkIdLess(a, b)
	local na, nb = linkNumber(a), linkNumber(b)
	if na ~= nil and nb ~= nil then
		if na ~= nb then
			return na < nb
		end
		return a < b
	end
	if na ~= nil then
		return true
	end
	if nb ~= nil then
		return false
	end
	return tostring(a) < tostring(b)
end

-- Texte d'une ligne : une seule ligne, UTF-8 valide, longueur limitée ; nil si ce n'est pas un texte
local function cleanLinkText(value)
	if isFiniteNumber(value) then
		value = tostring(value)
	end
	if type(value) ~= "string" then
		return nil
	end
	local text = string.gsub(value, "%c", " ")
	text = truncateUtf8(Util.trim(text), Model.LINK_MAX_TEXT)
	if utf8.len(text) == nil then
		text = string.gsub(text, "[\128-\255]", "?")
	end
	return text
end

-- Ligne validée à partir de données sérialisées (nil si illisible ou si un des deux blocs manque)
local function readLink(raw, blocks)
	if type(raw) ~= "table" then
		return nil
	end
	local de, vers = raw.de, raw.vers
	if type(de) ~= "string" or type(vers) ~= "string" or de == vers then
		return nil
	end
	if blocks[de] == nil or blocks[vers] == nil then
		return nil
	end
	local style = raw.style
	if not LINK_STYLE_SET[style] then
		style = Model.LINK_DEFAULT_STYLE
	end
	return {
		id = nil,
		de = de,
		vers = vers,
		texte = cleanLinkText(raw.texte) or "",
		style = style,
		couleur = copyColor(raw.couleur),
	}
end

-- Copie JSON-compatible d'une ligne (sans son id) ; de / vers éventuellement traduits par map
local function serializeLink(link, map)
	local de, vers = link.de, link.vers
	if map ~= nil then
		de, vers = map[de], map[vers]
	end
	local saved = { de = de, vers = vers }
	if type(link.texte) == "string" and link.texte ~= "" then
		saved.texte = link.texte
	end
	if LINK_STYLE_SET[link.style] and link.style ~= Model.LINK_DEFAULT_STYLE then
		saved.style = link.style
	end
	local couleur = copyColor(link.couleur)
	if couleur ~= nil then
		saved.couleur = couleur
	end
	return saved
end

---------------------------------------------------------------------------
-- Création
---------------------------------------------------------------------------

function Model.new()
	local self = setmetatable({}, Model)
	self.blocks = {}
	self.tops = {}
	self.variables = {}
	self.notes = {} -- notes de la zone de travail (SPEC §29)
	self.liens = {} -- lignes tracées à la main entre deux blocs (SPEC §36)
	self.mode = "server"
	self.Changed = Util.Signal.new()
	self.dirty = false
	self._counter = 0
	self._noteCounter = 0
	self._linkCounter = 0
	self._history = {}
	self._historyIndex = 0
	self._savedIndex = nil
	self:_resetHistory()
	return self
end

function Model:destroy()
	self.Changed:Destroy()
end

-- Nouvel id unique "b<n>"
function Model:_newId()
	local id
	repeat
		self._counter += 1
		id = "b" .. tostring(self._counter)
	until self.blocks[id] == nil
	return id
end

function Model:_ensureVariable(name)
	if type(name) == "string" and name ~= "" and indexOf(self.variables, name) == nil then
		table.insert(self.variables, name)
	end
end

-- Construit la table `inputs` d'un bloc. presets = { [nom] = valeur } (facultatif).
-- Renvoie inputs, nombre de presets invalides (remplacés par la valeur par défaut).
function Model:_initInputs(def, presets)
	local inputs = {}
	local invalid = 0
	for _, spec in ipairs(def.inputs or {}) do
		local value = nil
		if spec.kind ~= "boolean" then
			local preset = nil
			if type(presets) == "table" then
				preset = presets[spec.name]
			end
			local ok, coerced = false, nil
			if preset ~= nil then
				ok, coerced = coerceLiteral(spec, preset)
				if not ok then
					invalid += 1
				end
			end
			if ok then
				value = coerced
			elseif spec.kind == "variable" then
				value = self.variables[1] or Model.DEFAULT_VARIABLE
			else
				value = defaultLiteral(spec)
			end
			if spec.kind == "variable" then
				self:_ensureVariable(value)
			end
		end
		inputs[spec.name] = { value = value }
	end
	return inputs, invalid
end

-- Nouveau bloc au premier niveau. Renvoie son id (nil si la définition est inconnue).
function Model:create(defId, x, y, presetInputs)
	local def = Registry.get(defId)
	if def == nil then
		return nil
	end
	local id = self:_newId()
	local inputs = self:_initInputs(def, presetInputs)
	self.blocks[id] = {
		id = id,
		def = defId,
		x = toFinite(x, 0),
		y = toFinite(y, 0),
		inputs = inputs,
		next = nil,
		sub = {},
		parent = nil,
		slot = nil,
	}
	table.insert(self.tops, id)
	return id
end

---------------------------------------------------------------------------
-- Lecture
---------------------------------------------------------------------------

function Model:get(id)
	if id == nil then
		return nil
	end
	return self.blocks[id]
end

function Model:def(id)
	local block = self:get(id)
	if block == nil then
		return nil
	end
	return Registry.get(block.def)
end

function Model:isTop(id)
	local block = self:get(id)
	return block ~= nil and block.parent == nil
end

-- id et tous les blocs qui le suivent (next)
function Model:chain(id)
	local out = {}
	local seen = {}
	local current = id
	while current ~= nil and self.blocks[current] ~= nil and not seen[current] do
		seen[current] = true
		table.insert(out, current)
		current = self.blocks[current].next
	end
	return out
end

-- Dernier bloc de la chaîne qui commence à id
function Model:last(id)
	local list = self:chain(id)
	return list[#list]
end

-- Ancêtre de premier niveau
function Model:root(id)
	local block = self:get(id)
	if block == nil then
		return nil
	end
	local current = id
	local steps = 0
	while block.parent ~= nil and self.blocks[block.parent] ~= nil and steps < MAX_STEPS do
		current = block.parent
		block = self.blocks[current]
		steps += 1
	end
	return current
end

-- Vrai si id est ancestorId ou se trouve n'importe où dedans / après lui
function Model:contains(ancestorId, id)
	if ancestorId == nil or id == nil then
		return false
	end
	local current = id
	local steps = 0
	while current ~= nil and steps < MAX_STEPS do
		if current == ancestorId then
			return true
		end
		local block = self.blocks[current]
		if block == nil then
			return false
		end
		current = block.parent
		steps += 1
	end
	return false
end

function Model:count()
	local n = 0
	for _ in pairs(self.blocks) do
		n += 1
	end
	return n
end

-- Nombre de blocs qui utilisent la variable `name` (utile avant de la supprimer)
function Model:countVariableUses(name)
	local n = 0
	for _, block in pairs(self.blocks) do
		if blockUsesVariable(block, name) then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------
-- Liens (primitives internes, sans vérification)
---------------------------------------------------------------------------

-- Retire le bloc de l'emplacement de son parent (ne touche pas à model.tops)
function Model:_unlink(id)
	local block = self.blocks[id]
	if block == nil or block.parent == nil then
		return
	end
	local parent = self.blocks[block.parent]
	local slot = block.slot
	if parent ~= nil and slot ~= nil then
		if slot.kind == "next" then
			if parent.next == id then
				parent.next = nil
			end
		elseif slot.kind == "sub" then
			if parent.sub[slot.name] == id then
				parent.sub[slot.name] = nil
			end
		elseif slot.kind == "input" then
			local input = parent.inputs[slot.name]
			if input ~= nil and input.block == id then
				input.block = nil
			end
		end
	end
	block.parent = nil
	block.slot = nil
end

-- Place childId dans l'emplacement `slot` de parentId (l'emplacement doit être libre ou être
-- relié juste après par l'appelant ; childId doit être détaché).
function Model:_link(parentId, slot, childId)
	local parent = self.blocks[parentId]
	local child = self.blocks[childId]
	if slot.kind == "next" then
		parent.next = childId
	elseif slot.kind == "sub" then
		parent.sub[slot.name] = childId
	else
		local input = parent.inputs[slot.name]
		if input == nil then
			input = {}
			parent.inputs[slot.name] = input
		end
		input.block = childId
	end
	child.parent = parentId
	child.slot = copySlot(slot)
	removeValue(self.tops, childId)
end

-- Tous les ids contenus dans id (entrées, corps, et chaîne suivante si followNext), id compris
function Model:_collect(id, followNext)
	local out = {}
	local seen = {}
	local stack = { id }
	while #stack > 0 do
		local current = table.remove(stack)
		local block = self.blocks[current]
		if block ~= nil and not seen[current] then
			seen[current] = true
			table.insert(out, current)
			for _, input in pairs(block.inputs) do
				if input.block ~= nil then
					table.insert(stack, input.block)
				end
			end
			for _, slotName in ipairs(SLOTS) do
				local bodyId = block.sub[slotName]
				if bodyId ~= nil then
					table.insert(stack, bodyId)
				end
			end
			if block.next ~= nil and (followNext or current ~= id) then
				table.insert(stack, block.next)
			end
		end
	end
	return out
end

-- Supprime id et tout son contenu du modèle (id doit déjà être détaché de son parent), avec les
-- notes attachées à ces blocs
function Model:_destroyTree(id, followNext)
	local ids = self:_collect(id, followNext)
	local removed = {}
	for _, cid in ipairs(ids) do
		removed[cid] = true
		self.blocks[cid] = nil
	end
	local i = 1
	while i <= #self.tops do
		if removed[self.tops[i]] then
			table.remove(self.tops, i)
		else
			i += 1
		end
	end
	for noteId, note in pairs(self.notes) do
		if note.blockId ~= nil and removed[note.blockId] then
			self.notes[noteId] = nil
		end
	end
	for linkId, link in pairs(self.liens) do
		if removed[link.de] or removed[link.vers] then
			self.liens[linkId] = nil
		end
	end
	return #ids
end

-- Tous les blocs d'une pile : id, ses entrées, ses corps et tout ce qui le suit (NOTE: ajout à la
-- SPEC, pratique pour moveNotesWith et la sélection)
function Model:stackIds(id)
	if self.blocks[id] == nil then
		return {}
	end
	return self:_collect(id, true)
end

---------------------------------------------------------------------------
-- Déplacements
---------------------------------------------------------------------------

-- Instruction : détache id et la suite ; valeur : seulement lui. Devient un bloc de premier niveau
-- (x, y inchangés : l'appelant utilise moveTo).
function Model:detach(id)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	if block.parent ~= nil then
		self:_unlink(id)
	end
	removeValue(self.tops, id)
	table.insert(self.tops, id)
	return true
end

-- Premier niveau seulement
function Model:moveTo(id, x, y)
	local block = self.blocks[id]
	if block == nil or block.parent ~= nil then
		return false
	end
	block.x = toFinite(x, block.x)
	block.y = toFinite(y, block.y)
	return true
end

function Model:bringToFront(id)
	local rootId = self:root(id)
	if rootId == nil then
		return
	end
	removeValue(self.tops, rootId)
	table.insert(self.tops, rootId)
end

---------------------------------------------------------------------------
-- Vérifications d'assemblage (renvoient ok, raisonFR)
---------------------------------------------------------------------------

function Model:_pair(targetId, id)
	local target, block = self:get(targetId), self:get(id)
	if target == nil or block == nil then
		return nil, nil, "Bloc introuvable."
	end
	if targetId == id then
		return nil, nil, "Un bloc ne peut pas être attaché à lui-même."
	end
	local targetDef, def = Registry.get(target.def), Registry.get(block.def)
	if targetDef == nil or def == nil then
		return nil, nil, "Bloc inconnu."
	end
	if self:contains(id, targetId) then
		return nil, nil, "Un bloc ne peut pas être placé à l'intérieur de lui-même."
	end
	return targetDef, def, nil
end

-- id (tête d'une pile d'instructions, pas un événement) sous targetId
function Model:canAttachNext(targetId, id)
	local targetDef, def, err = self:_pair(targetId, id)
	if err ~= nil then
		return false, err
	end
	if isHat(def) then
		return false, "Un bloc événement ne peut pas être placé sous un autre bloc."
	end
	if not isStatement(def) then
		return false, "Un bloc valeur se place dans une entrée, pas sous un bloc."
	end
	if not (isHat(targetDef) or isStatement(targetDef)) or hasNoNext(targetDef) then
		return false, "Rien ne peut être attaché sous ce bloc."
	end
	local following = self.blocks[targetId].next
	if following == id then
		following = nil
	end
	if following ~= nil and hasNoNext(self:def(self:last(id))) then
		return false, "Ce groupe se termine par un bloc qui ne peut rien avoir en dessous : il ne peut pas être inséré au milieu d'une pile."
	end
	return true, nil
end

-- id (tête d'une pile d'instructions) au début du corps `slot` ("DO" / "ELSE") de targetId
function Model:canAttachSub(targetId, slot, id)
	local targetDef, def, err = self:_pair(targetId, id)
	if err ~= nil then
		return false, err
	end
	if not hasSlot(targetDef, slot) then
		return false, "Ce bloc n'a pas d'emplacement pour d'autres blocs."
	end
	if isHat(def) then
		return false, "Un bloc événement ne peut pas être placé dans un autre bloc."
	end
	if not isStatement(def) then
		return false, "Un bloc valeur se place dans une entrée, pas dans un corps de bloc."
	end
	local following = self.blocks[targetId].sub[slot]
	if following == id then
		following = nil
	end
	if following ~= nil and hasNoNext(self:def(self:last(id))) then
		return false, "Ce groupe se termine par un bloc qui ne peut rien avoir en dessous : il ne peut pas être inséré avant d'autres blocs."
	end
	return true, nil
end

-- id (bloc valeur ou booléen) dans l'entrée inputName de targetId
function Model:canAttachInput(targetId, inputName, id)
	local targetDef, def, err = self:_pair(targetId, id)
	if err ~= nil then
		return false, err
	end
	local spec = Registry.inputByName(targetDef, inputName)
	if spec == nil then
		return false, "Entrée introuvable."
	end
	if not isValue(def) then
		return false, "Seuls les blocs valeur (ronds ou pointus) peuvent être placés dans une entrée."
	end
	if spec.kind == "variable" then
		return false, "Cette entrée attend un nom de variable : choisis-le dans le menu."
	end
	if not acceptsReporter(spec) then
		return false, "Cette entrée n'accepte qu'un choix du menu."
	end
	return true, nil
end

-- id (pile d'instructions ou événement) au-dessus de la pile de premier niveau targetTopId
function Model:canAttachAbove(targetTopId, id)
	local targetDef, def, err = self:_pair(targetTopId, id)
	if err ~= nil then
		return false, err
	end
	if self.blocks[targetTopId].parent ~= nil then
		return false, "Le bloc cible n'est pas en haut d'une pile."
	end
	if not isStatement(targetDef) then
		return false, "Rien ne peut être placé au-dessus de ce bloc."
	end
	if not (isHat(def) or isStatement(def)) then
		return false, "Un bloc valeur se place dans une entrée, pas au-dessus d'une pile."
	end
	if hasNoNext(self:def(self:last(id))) then
		return false, "Ce groupe se termine par un bloc qui ne peut rien avoir en dessous."
	end
	return true, nil
end

---------------------------------------------------------------------------
-- Assemblage
-- Si id n'est pas au premier niveau, il est d'abord détaché (après toutes les vérifications).
---------------------------------------------------------------------------

function Model:attachNext(targetId, id)
	if not self:canAttachNext(targetId, id) then
		return false
	end
	self:_unlink(id)
	local following = self.blocks[targetId].next
	local lastId = self:last(id)
	self:_link(targetId, { kind = "next" }, id)
	if following ~= nil and following ~= id then
		self:_link(lastId, { kind = "next" }, following)
	end
	return true
end

function Model:attachSub(targetId, slot, id)
	if not self:canAttachSub(targetId, slot, id) then
		return false
	end
	self:_unlink(id)
	local following = self.blocks[targetId].sub[slot]
	local lastId = self:last(id)
	self:_link(targetId, { kind = "sub", name = slot }, id)
	if following ~= nil and following ~= id then
		self:_link(lastId, { kind = "next" }, following)
	end
	return true
end

-- Renvoie ok, ejectedId (bloc valeur qui occupait l'entrée, remis au premier niveau)
function Model:attachInput(targetId, inputName, id)
	if not self:canAttachInput(targetId, inputName, id) then
		return false, nil
	end
	local target = self.blocks[targetId]
	local input = target.inputs[inputName]
	if input == nil then
		input = {}
		target.inputs[inputName] = input
	end
	if input.block == id then
		return true, nil
	end
	local rootBlock = self.blocks[self:root(targetId)]
	self:_unlink(id)
	local ejected = nil
	local oldId = input.block
	if oldId ~= nil then
		local old = self.blocks[oldId]
		if old ~= nil then
			self:_unlink(oldId)
			removeValue(self.tops, oldId)
			table.insert(self.tops, oldId)
			old.x = (rootBlock and rootBlock.x or 0) + Model.EJECT_OFFSET
			old.y = (rootBlock and rootBlock.y or 0) + Model.EJECT_OFFSET
			ejected = oldId
		else
			input.block = nil
		end
	end
	self:_link(targetId, { kind = "input", name = inputName }, id)
	return true, ejected
end

-- last(id).next = targetTopId ; id va en (newX, newY)
function Model:attachAbove(targetTopId, id, newX, newY)
	if not self:canAttachAbove(targetTopId, id) then
		return false
	end
	local block = self.blocks[id]
	local target = self.blocks[targetTopId]
	local wasTop = block.parent == nil
	self:_unlink(id)
	local lastId = self:last(id)
	self:_link(lastId, { kind = "next" }, targetTopId)
	removeValue(self.tops, id)
	table.insert(self.tops, id)
	local defaultX, defaultY = block.x, block.y
	if not wasTop then
		defaultX, defaultY = target.x, target.y
	end
	block.x = toFinite(newX, defaultX)
	block.y = toFinite(newY, defaultY)
	return true
end

---------------------------------------------------------------------------
-- Suppression / duplication
---------------------------------------------------------------------------

-- Supprime id, les blocs de ses entrées, ses corps ET la suite
function Model:delete(id)
	if self.blocks[id] == nil then
		return false
	end
	self:_unlink(id)
	self:_destroyTree(id, true)
	return true
end

-- Supprime seulement id (+ ses entrées et ses corps) ; la suite prend sa place
function Model:deleteSingle(id)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	local nextId = block.next
	if nextId == nil or self.blocks[nextId] == nil then
		return self:delete(id)
	end
	local parentId = block.parent
	local slot = copySlot(block.slot)
	local topIndex = nil
	if parentId == nil then
		topIndex = indexOf(self.tops, id)
	end
	self:_unlink(nextId)
	self:_unlink(id)
	if parentId ~= nil and slot ~= nil and self.blocks[parentId] ~= nil then
		self:_link(parentId, slot, nextId)
	else
		local nextBlock = self.blocks[nextId]
		nextBlock.x, nextBlock.y = block.x, block.y
		if topIndex ~= nil then
			self.tops[topIndex] = nextId
		else
			removeValue(self.tops, nextId)
			table.insert(self.tops, nextId)
		end
	end
	self:_destroyTree(id, false)
	return true
end

-- « Détacher ce bloc » (SPEC §33) : sort seulement id de sa pile, sans rien supprimer. La suite
-- prend sa place (comme deleteSingle) et id, avec ses entrées et ses corps, devient une pile seule
-- de premier niveau (à l'avant-plan). Un bloc valeur, ou un bloc sans suite, est simplement détaché.
-- id garde ses x, y : l'appelant le place avec moveTo. Renvoie ok.
function Model:detachSingle(id)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	local nextId = block.next
	if nextId == nil or self.blocks[nextId] == nil then
		return self:detach(id)
	end
	local parentId = block.parent
	local slot = copySlot(block.slot)
	local topIndex = nil
	if parentId == nil then
		topIndex = indexOf(self.tops, id)
	end
	self:_unlink(nextId)
	self:_unlink(id)
	if parentId ~= nil and slot ~= nil and self.blocks[parentId] ~= nil then
		self:_link(parentId, slot, nextId)
	else
		-- id était en haut d'une pile : la suite reste à sa place
		local nextBlock = self.blocks[nextId]
		nextBlock.x, nextBlock.y = block.x, block.y
		if topIndex ~= nil then
			self.tops[topIndex] = nextId
		else
			removeValue(self.tops, nextId)
			table.insert(self.tops, nextId)
		end
	end
	removeValue(self.tops, id)
	table.insert(self.tops, id)
	return true
end

-- Copie profonde de id + la suite, nouvelle pile de premier niveau. Renvoie le nouvel id.
function Model:duplicate(id)
	local source = self.blocks[id]
	if source == nil then
		return nil
	end
	local ids = self:_collect(id, true)
	local map = {}
	for _, oldId in ipairs(ids) do
		map[oldId] = self:_newId()
	end
	local rootBlock = self.blocks[self:root(id)] or source
	for _, oldId in ipairs(ids) do
		local src = self.blocks[oldId]
		local copy = {
			id = map[oldId],
			def = src.def,
			x = src.x,
			y = src.y,
			inputs = {},
			next = nil,
			sub = {},
			parent = nil,
			slot = nil,
		}
		if src.disabled == true then
			copy.disabled = true
		end
		for name, input in pairs(src.inputs) do
			local entry = { value = copyLiteral(input.value) }
			if input.block ~= nil then
				entry.block = map[input.block]
			end
			copy.inputs[name] = entry
		end
		for _, slotName in ipairs(SLOTS) do
			local bodyId = src.sub[slotName]
			if bodyId ~= nil then
				copy.sub[slotName] = map[bodyId]
			end
		end
		if src.next ~= nil then
			copy.next = map[src.next]
		end
		if oldId == id then
			copy.x = rootBlock.x + Model.DUPLICATE_OFFSET
			copy.y = rootBlock.y + Model.DUPLICATE_OFFSET
		else
			copy.parent = map[src.parent]
			copy.slot = copySlot(src.slot)
		end
		self.blocks[copy.id] = copy
	end
	table.insert(self.tops, map[id])
	return map[id]
end

---------------------------------------------------------------------------
-- Entrées
---------------------------------------------------------------------------

-- Valeur littérale (convertie selon le type de l'entrée). Renvoie ok.
function Model:setInput(id, name, value)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	local def = Registry.get(block.def)
	local spec = def and Registry.inputByName(def, name)
	if spec == nil then
		return false
	end
	local ok, coerced = coerceLiteral(spec, value)
	if not ok then
		return false
	end
	if spec.kind == "variable" then
		self:_ensureVariable(coerced)
	end
	local input = block.inputs[name]
	if input == nil then
		input = {}
		block.inputs[name] = input
	end
	input.value = coerced
	return true
end

---------------------------------------------------------------------------
-- Variables
---------------------------------------------------------------------------

-- Renvoie nomNettoyé ou nil, erreurFR
function Model:_checkVariableName(name, ignore)
	if type(name) ~= "string" then
		return nil, "Nom de variable invalide."
	end
	local clean = Util.trim(name)
	if clean == "" then
		return nil, "Le nom de la variable ne peut pas être vide."
	end
	if string.find(clean, "%c") then
		return nil, "Le nom de la variable ne peut pas contenir de retour à la ligne ni de tabulation."
	end
	local length = utf8.len(clean)
	if length == nil then
		return nil, "Le nom de la variable contient des caractères invalides."
	end
	if length > Model.MAX_VARIABLE_LENGTH then
		return nil, "Le nom de la variable est trop long (" .. Model.MAX_VARIABLE_LENGTH .. " caractères maximum)."
	end
	if clean ~= ignore and indexOf(self.variables, clean) ~= nil then
		return nil, "La variable « " .. clean .. " » existe déjà."
	end
	return clean, nil
end

-- Renvoie ok, erreurFR, nomNettoyé (espaces retirés aux extrémités)
function Model:addVariable(name)
	local clean, err = self:_checkVariableName(name, nil)
	if clean == nil then
		return false, err
	end
	table.insert(self.variables, clean)
	return true, nil, clean
end

-- Renomme la variable et met à jour toutes les entrées de type "variable" qui l'utilisent
function Model:renameVariable(old, new)
	local index = indexOf(self.variables, old)
	if index == nil then
		return false, "La variable « " .. tostring(old) .. " » n'existe pas."
	end
	local clean, err = self:_checkVariableName(new, old)
	if clean == nil then
		return false, err
	end
	if clean == old then
		return true, nil
	end
	self.variables[index] = clean
	for _, block in pairs(self.blocks) do
		local def = Registry.get(block.def)
		if def ~= nil then
			for inputName, input in pairs(block.inputs) do
				local spec = Registry.inputByName(def, inputName)
				if spec ~= nil and spec.kind == "variable" and input.value == old then
					input.value = clean
				end
			end
		end
	end
	return true, nil
end

-- Supprime la variable et, comme dans Scratch, les blocs qui l'utilisent (deleteSingle : la suite
-- d'une pile se referme). Les corps des blocs C supprimés ne sont pas perdus : ils deviennent des
-- piles séparées. Renvoie le nombre de blocs supprimés.
function Model:removeVariable(name)
	local index = indexOf(self.variables, name)
	if index ~= nil then
		table.remove(self.variables, index)
	end
	if type(name) ~= "string" then
		return 0
	end
	local users = {}
	for id, block in pairs(self.blocks) do
		if blockUsesVariable(block, name) then
			table.insert(users, id)
		end
	end
	table.sort(users, idLess)
	local removed = 0
	for _, id in ipairs(users) do
		local block = self.blocks[id]
		if block ~= nil then
			local rootBlock = self.blocks[self:root(id)] or block
			local baseX, baseY = rootBlock.x, rootBlock.y
			local offset = 0
			for _, slotName in ipairs(SLOTS) do
				local bodyId = block.sub[slotName]
				if bodyId ~= nil and self.blocks[bodyId] ~= nil then
					offset += Model.EJECT_OFFSET
					self:detach(bodyId)
					self:moveTo(bodyId, baseX + offset, baseY + offset)
				end
			end
			self:deleteSingle(id)
			removed += 1
		end
	end
	return removed
end

---------------------------------------------------------------------------
-- Blocs désactivés (SPEC §32) : gardés dans le projet mais pas dans le code généré
---------------------------------------------------------------------------

-- Désactive (true) ou réactive (false) un bloc. Renvoie ok.
function Model:setDisabled(id, disabled)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	if disabled then
		block.disabled = true
	else
		block.disabled = nil
	end
	return true
end

-- Vrai si le bloc est désactivé. inherited = true : aussi quand il est dans le corps (ou une entrée)
-- d'un bloc désactivé, ou sous un événement désactivé (CodeGen ne l'émet pas non plus). Un bloc placé
-- APRÈS un bloc désactivé dans une pile reste actif.
function Model:isDisabled(id, inherited)
	local block = self.blocks[id]
	if block == nil then
		return false
	end
	if block.disabled == true then
		return true
	end
	if not inherited then
		return false
	end
	local current = block
	local steps = 0
	while current.parent ~= nil and steps < MAX_STEPS do
		local parent = self.blocks[current.parent]
		if parent == nil then
			break
		end
		if parent.disabled == true then
			local kind = current.slot and current.slot.kind
			if kind ~= "next" or isHat(Registry.get(parent.def)) then
				-- corps / entrée d'un bloc désactivé, ou pile d'un événement désactivé
				return true
			end
		end
		current = parent
		steps += 1
	end
	return false
end

-- Ids des blocs désactivés (ordre déterministe)
function Model:disabledIds()
	local ids = {}
	for id, block in pairs(self.blocks) do
		if block.disabled == true then
			table.insert(ids, id)
		end
	end
	table.sort(ids, idLess)
	return ids
end

---------------------------------------------------------------------------
-- Notes de la zone de travail (SPEC §29)
---------------------------------------------------------------------------

function Model:_newNoteId()
	local id
	repeat
		self._noteCounter += 1
		id = "n" .. tostring(self._noteCounter)
	until self.notes[id] == nil
	return id
end

-- Nouvelle note vide en (x, y), attachée à blockId (nil, ou bloc inconnu : note libre). Sa couleur
-- est celle des réglages (notes.couleur, « jaune » par défaut). Renvoie son id.
function Model:addNote(x, y, blockId)
	local id = self:_newNoteId()
	local attached = nil
	if type(blockId) == "string" and self.blocks[blockId] ~= nil then
		attached = blockId
	end
	self.notes[id] = {
		id = id,
		text = "",
		x = toFinite(x, 0),
		y = toFinite(y, 0),
		w = Model.NOTE_DEFAULT_WIDTH,
		couleur = defaultNoteColor(),
		blockId = attached,
		replie = false,
	}
	return id
end

-- La note (table du modèle : la modifier avec setNote), ou nil
function Model:getNote(id)
	if id == nil then
		return nil
	end
	return self.notes[id]
end

-- Modifie une note. fields = { text =, x =, y =, w =, couleur = "jaune"|"vert"|"bleu"|"rose"|"violet",
-- blockId = id d'un bloc | false (détacher), replie = bool }. Les valeurs invalides sont ignorées.
-- Renvoie ok (false si la note n'existe pas ou si une valeur a été refusée).
function Model:setNote(id, fields)
	local note = self.notes[id]
	if note == nil or type(fields) ~= "table" then
		return false
	end
	local ok = true
	for key, value in pairs(fields) do
		if key == "text" then
			local text = cleanNoteText(value)
			if text ~= nil then
				note.text = text
			else
				ok = false
			end
		elseif key == "x" or key == "y" then
			local n = toFinite(value, nil)
			if n ~= nil then
				note[key] = n
			else
				ok = false
			end
		elseif key == "w" then
			if toFinite(value, nil) ~= nil then
				note.w = noteWidth(value)
			else
				ok = false
			end
		elseif key == "couleur" then
			if NOTE_COLOR_SET[value] then
				note.couleur = value
			else
				ok = false
			end
		elseif key == "blockId" then
			if value == false or value == "" then
				note.blockId = nil
			elseif type(value) == "string" and self.blocks[value] ~= nil then
				note.blockId = value
			else
				ok = false
			end
		elseif key == "replie" then
			if type(value) == "boolean" then
				note.replie = value
			else
				ok = false
			end
		elseif key ~= "id" then
			ok = false
		end
	end
	return ok
end

-- Supprime une note. Renvoie ok.
function Model:removeNote(id)
	if id == nil or self.notes[id] == nil then
		return false
	end
	self.notes[id] = nil
	return true
end

-- Ids de toutes les notes (ordre de création)
function Model:noteIds()
	local ids = {}
	for id in pairs(self.notes) do
		table.insert(ids, id)
	end
	table.sort(ids, noteIdLess)
	return ids
end

-- Ids des notes attachées à blockId (ordre de création)
function Model:notesOf(blockId)
	local ids = {}
	if blockId == nil then
		return ids
	end
	for id, note in pairs(self.notes) do
		if note.blockId == blockId then
			table.insert(ids, id)
		end
	end
	table.sort(ids, noteIdLess)
	return ids
end

-- Déplace de (dx, dy) les notes attachées à l'un des blocs donnés (liste d'ids, ensemble
-- { [id] = true } ou un seul id) : à appeler quand une pile bouge. Renvoie le nombre de notes déplacées.
function Model:moveNotesWith(blockIds, dx, dy)
	dx = toFinite(dx, 0)
	dy = toFinite(dy, 0)
	if type(blockIds) == "string" then
		blockIds = { blockIds }
	end
	if type(blockIds) ~= "table" or (dx == 0 and dy == 0) then
		return 0
	end
	local set = {}
	for key, value in pairs(blockIds) do
		if type(value) == "string" then
			set[value] = true
		elseif value == true and type(key) == "string" then
			set[key] = true
		end
	end
	local moved = 0
	for _, note in pairs(self.notes) do
		if note.blockId ~= nil and set[note.blockId] then
			note.x += dx
			note.y += dy
			moved += 1
		end
	end
	return moved
end

---------------------------------------------------------------------------
-- Lignes tracées à la main entre deux blocs (SPEC §36)
---------------------------------------------------------------------------

function Model:_newLinkId()
	local id
	repeat
		self._linkCounter += 1
		id = "l" .. tostring(self._linkCounter)
	until self.liens[id] == nil
	return id
end

-- Applique fields = { texte =, style =, couleur = {r,g,b} | false (couleur par défaut) } à une ligne.
-- Les valeurs invalides sont ignorées ; renvoie false si l'une a été refusée.
local function applyLinkFields(link, fields)
	local ok = true
	for key, value in pairs(fields) do
		if key == "texte" then
			local text = cleanLinkText(value)
			if text ~= nil then
				link.texte = text
			else
				ok = false
			end
		elseif key == "style" then
			if LINK_STYLE_SET[value] then
				link.style = value
			else
				ok = false
			end
		elseif key == "couleur" then
			if value == false then
				link.couleur = nil
			else
				local c = copyColor(value)
				if c ~= nil then
					link.couleur = c
				else
					ok = false
				end
			end
		elseif key ~= "id" and key ~= "de" and key ~= "vers" then
			ok = false
		end
	end
	return ok
end

-- Nouvelle ligne du bloc de vers le bloc vers (deux blocs différents qui existent). Plusieurs lignes
-- peuvent partir du même bloc. fields facultatif (texte, style, couleur). Renvoie son id, ou nil.
function Model:addLink(de, vers, fields)
	if type(de) ~= "string" or type(vers) ~= "string" or de == vers then
		return nil
	end
	if self.blocks[de] == nil or self.blocks[vers] == nil then
		return nil
	end
	local id = self:_newLinkId()
	local link = {
		id = id,
		de = de,
		vers = vers,
		texte = "",
		style = Model.LINK_DEFAULT_STYLE,
		couleur = nil,
	}
	if type(fields) == "table" then
		applyLinkFields(link, fields)
	end
	self.liens[id] = link
	return id
end

-- La ligne (table du modèle : la modifier avec setLink), ou nil
function Model:getLink(id)
	if id == nil then
		return nil
	end
	return self.liens[id]
end

-- Modifie une ligne (texte, style, couleur). Renvoie ok (false si la ligne n'existe pas ou si une
-- valeur a été refusée).
function Model:setLink(id, fields)
	local link = id ~= nil and self.liens[id] or nil
	if link == nil or type(fields) ~= "table" then
		return false
	end
	return applyLinkFields(link, fields)
end

-- Supprime une ligne. Renvoie ok.
function Model:removeLink(id)
	if id == nil or self.liens[id] == nil then
		return false
	end
	self.liens[id] = nil
	return true
end

-- Ids de toutes les lignes (ordre de création)
function Model:linkIds()
	local ids = {}
	for id in pairs(self.liens) do
		table.insert(ids, id)
	end
	table.sort(ids, linkIdLess)
	return ids
end

-- Ids des lignes qui partent de blockId ou y arrivent (ordre de création)
function Model:linksOf(blockId)
	local ids = {}
	if blockId == nil then
		return ids
	end
	for id, link in pairs(self.liens) do
		if link.de == blockId or link.vers == blockId then
			table.insert(ids, id)
		end
	end
	table.sort(ids, linkIdLess)
	return ids
end

---------------------------------------------------------------------------
-- Divers
---------------------------------------------------------------------------

-- mode : "server" | "local" | "module" ; renvoie false (sans rien changer) pour un autre mode
function Model:setMode(mode)
	if not Model.isValidMode(mode) then
		return false
	end
	self.mode = mode
	return true
end

-- Supprime tous les blocs, toutes les notes et toutes les lignes (les variables et le mode sont conservés)
function Model:clear()
	table.clear(self.blocks)
	table.clear(self.tops)
	table.clear(self.notes)
	table.clear(self.liens)
end

---------------------------------------------------------------------------
-- Sérialisation
---------------------------------------------------------------------------

-- Table JSON-compatible (aucune Color3, fonction ni référence cyclique ; pas de parent/slot).
-- « disabled » n'est écrit que pour les blocs désactivés et « notes » que s'il y a des notes : un
-- projet sans notes ni bloc désactivé garde exactement l'ancienne forme.
function Model:serialize()
	local blocks = {}
	for id, block in pairs(self.blocks) do
		local entry = {
			def = block.def,
			x = toFinite(block.x, 0),
			y = toFinite(block.y, 0),
		}
		if block.disabled == true then
			entry.disabled = true
		end
		if block.next ~= nil then
			entry.next = block.next
		end
		local sub = nil
		for _, slotName in ipairs(SLOTS) do
			local bodyId = block.sub[slotName]
			if bodyId ~= nil then
				sub = sub or {}
				sub[slotName] = bodyId
			end
		end
		entry.sub = sub
		local inputs = nil
		for name, input in pairs(block.inputs) do
			if type(name) == "string" then
				local saved = {}
				local hasData = false
				local value = copyLiteral(input.value)
				if value ~= nil then
					saved.value = value
					hasData = true
				end
				if input.block ~= nil then
					saved.block = input.block
					hasData = true
				end
				if hasData then
					inputs = inputs or {}
					inputs[name] = saved
				end
			end
		end
		entry.inputs = inputs
		blocks[id] = entry
	end
	local data = {
		format = Model.FORMAT,
		version = Model.VERSION,
		mode = self.mode,
		variables = table.clone(self.variables),
		tops = table.clone(self.tops),
		blocks = blocks,
	}
	local notes = nil
	for noteId, note in pairs(self.notes) do
		if type(noteId) == "string" and type(note) == "table" then
			notes = notes or {}
			notes[noteId] = serializeNote(note, 0, 0)
		end
	end
	if notes ~= nil then
		data.notes = notes
	end
	-- Lignes (SPEC §36) : « liens » n'est écrit que s'il y a des lignes
	local liens = nil
	for linkId, link in pairs(self.liens) do
		if type(linkId) == "string" and type(link) == "table" then
			liens = liens or {}
			liens[linkId] = serializeLink(link, nil)
		end
	end
	if liens ~= nil then
		data.liens = liens
	end
	return data
end

-- Remplit le modèle (vidé au préalable) à partir de données sérialisées, en validant tout.
-- Les problèmes sont ajoutés à `warnings` (messages en français).
local function populate(self, data, warnings)
	table.clear(self.blocks)
	table.clear(self.tops)
	table.clear(self.variables)
	table.clear(self.notes)
	table.clear(self.liens)

	-- Mode
	local mode = data.mode
	if Model.isValidMode(mode) then
		self.mode = mode
	else
		self.mode = "server"
		if mode ~= nil then
			table.insert(warnings, "Mode de script inconnu (" .. tostring(mode) .. ") : le mode « script serveur » est utilisé.")
		end
	end

	-- Variables
	if type(data.variables) == "table" then
		for _, name in ipairs(data.variables) do
			if type(name) == "string" and name ~= "" then
				self:_ensureVariable(name)
			end
		end
	end

	local rawBlocks = data.blocks
	if type(rawBlocks) ~= "table" then
		rawBlocks = {}
	end
	local unknownCount = {}
	local unknownOrder = {}
	local unreadable = 0
	local badValues = 0
	local dangling = 0
	local cycles = 0
	local badLinks = 0
	local multiParents = 0

	-- 1) Blocs connus (les définitions inconnues sont ignorées)
	local ids = {}
	local dropped = {}
	for id, raw in pairs(rawBlocks) do
		if type(id) == "string" and id ~= "" and type(raw) == "table" then
			local def = nil
			if type(raw.def) == "string" then
				def = Registry.get(raw.def)
			end
			if def ~= nil then
				table.insert(ids, id)
			else
				dropped[id] = true
				local key = "?"
				if type(raw.def) == "string" then
					key = raw.def
				end
				if unknownCount[key] == nil then
					unknownCount[key] = 0
					table.insert(unknownOrder, key)
				end
				unknownCount[key] += 1
			end
		else
			unreadable += 1
		end
	end
	table.sort(ids, idLess)

	for _, id in ipairs(ids) do
		local raw = rawBlocks[id]
		local def = Registry.get(raw.def)
		local presets = {}
		if type(raw.inputs) == "table" then
			for _, spec in ipairs(def.inputs or {}) do
				local saved = raw.inputs[spec.name]
				if type(saved) == "table" and saved.value ~= nil and spec.kind ~= "boolean" then
					presets[spec.name] = saved.value
				end
			end
		end
		local inputs, invalid = self:_initInputs(def, presets)
		badValues += invalid
		self.blocks[id] = {
			id = id,
			def = raw.def,
			x = toFinite(raw.x, 0),
			y = toFinite(raw.y, 0),
			inputs = inputs,
			next = nil,
			sub = {},
			parent = nil,
			slot = nil,
		}
		if raw.disabled == true then
			self.blocks[id].disabled = true
		end
	end

	-- 2) Liens (chaque bloc a au plus un parent ; jamais de boucle ; formes compatibles)
	local function wouldCycle(parentId, childId)
		local current = parentId
		local steps = 0
		while current ~= nil and steps < MAX_STEPS do
			if current == childId then
				return true
			end
			local block = self.blocks[current]
			if block == nil then
				return false
			end
			current = block.parent
			steps += 1
		end
		return steps >= MAX_STEPS
	end

	-- Saute les instructions ignorées (définition inconnue) en suivant leur "next"
	local function skipDropped(childId)
		local seen = {}
		while type(childId) == "string" and dropped[childId] and not seen[childId] do
			seen[childId] = true
			local raw = rawBlocks[childId]
			if type(raw) == "table" then
				childId = raw.next
			else
				childId = nil
			end
		end
		if type(childId) == "string" and dropped[childId] then
			return nil -- boucle entre blocs ignorés
		end
		return childId
	end

	local function tryLink(parentId, slot, childId)
		if slot.kind ~= "input" then
			childId = skipDropped(childId)
		elseif type(childId) == "string" and dropped[childId] then
			return
		end
		if childId == nil then
			return
		end
		if type(childId) ~= "string" then
			badLinks += 1
			return
		end
		local child = self.blocks[childId]
		if child == nil then
			dangling += 1
			return
		end
		if child.parent ~= nil then
			multiParents += 1
			return
		end
		if wouldCycle(parentId, childId) then
			cycles += 1
			return
		end
		local parentDef = Registry.get(self.blocks[parentId].def)
		local childDef = Registry.get(child.def)
		local valid
		if slot.kind == "next" then
			valid = (isHat(parentDef) or isStatement(parentDef)) and not hasNoNext(parentDef) and isStatement(childDef)
		elseif slot.kind == "sub" then
			valid = hasSlot(parentDef, slot.name) and isStatement(childDef)
		else
			local spec = Registry.inputByName(parentDef, slot.name)
			valid = spec ~= nil and acceptsReporter(spec) and isValue(childDef)
		end
		if not valid then
			badLinks += 1
			return
		end
		self:_link(parentId, slot, childId)
	end

	for _, id in ipairs(ids) do
		local raw = rawBlocks[id]
		local def = Registry.get(raw.def)
		if raw.next ~= nil then
			tryLink(id, { kind = "next" }, raw.next)
		end
		if type(raw.sub) == "table" then
			for _, slotName in ipairs(SLOTS) do
				local bodyId = raw.sub[slotName]
				if bodyId ~= nil then
					tryLink(id, { kind = "sub", name = slotName }, bodyId)
				end
			end
		end
		if type(raw.inputs) == "table" then
			for _, spec in ipairs(def.inputs or {}) do
				local saved = raw.inputs[spec.name]
				if type(saved) == "table" and saved.block ~= nil then
					tryLink(id, { kind = "input", name = spec.name }, saved.block)
				end
			end
		end
	end

	-- 3) Premier niveau : ordre enregistré, puis les blocs orphelins restants
	local inTops = {}
	if type(data.tops) == "table" then
		for _, id in ipairs(data.tops) do
			local block = nil
			if type(id) == "string" then
				block = self.blocks[id]
			end
			if block ~= nil and block.parent == nil and not inTops[id] then
				inTops[id] = true
				table.insert(self.tops, id)
			end
		end
	end
	for _, id in ipairs(ids) do
		local block = self.blocks[id]
		if block ~= nil and block.parent == nil and not inTops[id] then
			inTops[id] = true
			table.insert(self.tops, id)
		end
	end

	-- 4) Compteur d'ids au-dessus du plus grand id existant
	for _, id in ipairs(ids) do
		local n = idNumber(id)
		if n ~= nil and n > self._counter then
			self._counter = n
		end
	end

	-- 4 bis) Notes (SPEC §29 ; absentes des anciens projets). Une note dont le bloc n'existe pas (ou
	-- a été ignoré) devient une note libre ; une clé invalide reçoit un nouvel id.
	local badNotes = 0
	if type(data.notes) == "table" then
		local entries = {}
		for key, raw in pairs(data.notes) do
			if type(raw) == "table" and (type(key) == "string" or type(key) == "number") then
				table.insert(entries, { key = key, raw = raw })
			else
				badNotes += 1
			end
		end
		table.sort(entries, function(p, q)
			local ka, kb = p.key, q.key
			if type(ka) ~= type(kb) then
				return type(ka) == "string"
			end
			if type(ka) == "number" then
				return ka < kb
			end
			return noteIdLess(ka, kb)
		end)
		local renamed = {}
		for _, entry in ipairs(entries) do
			local note = readNote(entry.raw, self.blocks)
			local key = entry.key
			if note == nil then
				badNotes += 1
			elseif type(key) == "string" and key ~= "" and #key <= 60 and self.notes[key] == nil then
				note.id = key
				self.notes[key] = note
				local n = noteNumber(key)
				if n ~= nil and n > self._noteCounter then
					self._noteCounter = n
				end
			else
				table.insert(renamed, note)
			end
		end
		for _, note in ipairs(renamed) do
			local noteId = self:_newNoteId()
			note.id = noteId
			self.notes[noteId] = note
		end
	end

	-- 4 ter) Lignes tracées à la main (SPEC §36 ; absentes des anciens projets). Une ligne dont un des
	-- deux blocs n'existe pas (ou a été ignoré) est retirée ; une clé invalide reçoit un nouvel id.
	local badLines = 0
	if type(data.liens) == "table" then
		local entries = {}
		for key, raw in pairs(data.liens) do
			if type(raw) == "table" and (type(key) == "string" or type(key) == "number") then
				table.insert(entries, { key = key, raw = raw })
			else
				badLines += 1
			end
		end
		table.sort(entries, function(p, q)
			local ka, kb = p.key, q.key
			if type(ka) ~= type(kb) then
				return type(ka) == "string"
			end
			if type(ka) == "number" then
				return ka < kb
			end
			return linkIdLess(ka, kb)
		end)
		local renamedLinks = {}
		for _, entry in ipairs(entries) do
			local link = readLink(entry.raw, self.blocks)
			local key = entry.key
			if link == nil then
				badLines += 1
			elseif type(key) == "string" and key ~= "" and #key <= 60 and self.liens[key] == nil then
				link.id = key
				self.liens[key] = link
				local n = linkNumber(key)
				if n ~= nil and n > self._linkCounter then
					self._linkCounter = n
				end
			else
				table.insert(renamedLinks, link)
			end
		end
		for _, link in ipairs(renamedLinks) do
			local linkId = self:_newLinkId()
			link.id = linkId
			self.liens[linkId] = link
		end
	end

	-- 5) Avertissements
	for _, key in ipairs(unknownOrder) do
		table.insert(
			warnings,
			"Bloc inconnu « " .. key .. " » ignoré (" .. unknownCount[key] .. " exemplaire(s)) : il n'existe pas dans cette version de Blocs FR."
		)
	end
	if unreadable > 0 then
		table.insert(warnings, unreadable .. " bloc(s) illisible(s) ignoré(s).")
	end
	if badValues > 0 then
		table.insert(warnings, badValues .. " valeur(s) invalide(s) remplacée(s) par la valeur par défaut.")
	end
	if dangling > 0 then
		table.insert(warnings, dangling .. " lien(s) vers des blocs manquants supprimé(s).")
	end
	if multiParents > 0 then
		table.insert(warnings, multiParents .. " bloc(s) rattaché(s) à plusieurs endroits : ils ont été séparés.")
	end
	if cycles > 0 then
		table.insert(warnings, cycles .. " boucle(s) dans l'assemblage des blocs cassée(s).")
	end
	if badLinks > 0 then
		table.insert(warnings, badLinks .. " assemblage(s) de blocs invalide(s) séparé(s).")
	end
	if badNotes > 0 then
		table.insert(warnings, badNotes .. " note(s) illisible(s) ignorée(s).")
	end
	if badLines > 0 then
		table.insert(warnings, badLines .. " ligne(s) entre des blocs manquants ignorée(s).")
	end
end

-- Nouveau modèle à partir de données sérialisées. Renvoie model, warnings (liste de textes FR).
function Model.fromData(data)
	local self = Model.new()
	local warnings = {}
	if type(data) ~= "table" then
		table.insert(warnings, "Données de projet invalides : un projet vide a été créé.")
		return self, warnings
	end
	if data.format ~= nil and data.format ~= Model.FORMAT then
		table.insert(warnings, "Format de données inattendu (" .. tostring(data.format) .. ") : chargement tenté quand même.")
	end
	local version = tonumber(data.version)
	if version ~= nil and version > Model.VERSION then
		table.insert(warnings, "Ce projet vient d'une version plus récente de Blocs FR : certaines parties peuvent manquer.")
	end
	local ok, err = pcall(populate, self, data, warnings)
	if not ok then
		table.clear(self.blocks)
		table.clear(self.tops)
		table.clear(self.notes)
		table.clear(self.liens)
		table.insert(warnings, "Erreur pendant le chargement du projet : " .. tostring(err))
	end
	self:_resetHistory()
	return self, warnings
end

-- Ajoute un projet sérialisé (un exemple du wiki, par exemple) à ce modèle sans rien remplacer
-- (SPEC §18). Les données sont validées comme par fromData (définitions inconnues ignorées,
-- liens invalides séparés), chaque bloc reçoit un nouvel id (compteur du modèle), la structure est
-- conservée, les piles de premier niveau sont décalées de (dx, dy) et les variables sont fusionnées.
-- Le mode du modèle ne change pas. Ne déclenche pas Changed : l'appelant fait commit("exemple").
-- Les notes des données (SPEC §29) sont ajoutées aussi, décalées de (dx, dy), avec les nouveaux ids
-- de leurs blocs. Renvoie la liste des nouveaux ids de premier niveau (ordre des données),
-- warnings (textes FR) et (NOTE: en plus de la SPEC) la liste des ids des nouvelles notes.
function Model:importData(data, dx, dy)
	dx = toFinite(dx, 0)
	dy = toFinite(dy, 0)
	local source, warnings = Model.fromData(data)
	local newTops = {}

	-- Variables : fusion (sans doublon), dans l'ordre du projet importé
	for _, name in ipairs(source.variables) do
		self:_ensureVariable(name)
	end

	-- Nouveaux ids, attribués dans un ordre déterministe
	local ids = {}
	for id in pairs(source.blocks) do
		table.insert(ids, id)
	end
	table.sort(ids, idLess)
	local map = {}
	for _, oldId in ipairs(ids) do
		map[oldId] = self:_newId()
	end

	-- Copie des blocs avec les liens traduits
	for _, oldId in ipairs(ids) do
		local src = source.blocks[oldId]
		local copy = {
			id = map[oldId],
			def = src.def,
			x = toFinite(src.x, 0),
			y = toFinite(src.y, 0),
			inputs = {},
			next = nil,
			sub = {},
			parent = nil,
			slot = nil,
		}
		if src.disabled == true then
			copy.disabled = true
		end
		for name, input in pairs(src.inputs) do
			local entry = { value = copyLiteral(input.value) }
			if input.block ~= nil then
				entry.block = map[input.block]
			end
			copy.inputs[name] = entry
		end
		for _, slotName in ipairs(SLOTS) do
			local bodyId = src.sub[slotName]
			if bodyId ~= nil then
				copy.sub[slotName] = map[bodyId]
			end
		end
		if src.next ~= nil then
			copy.next = map[src.next]
		end
		if src.parent ~= nil then
			copy.parent = map[src.parent]
			copy.slot = copySlot(src.slot)
		else
			copy.x += dx
			copy.y += dy
		end
		self.blocks[copy.id] = copy
	end

	-- Piles de premier niveau : à l'avant-plan, dans l'ordre des données
	for _, oldId in ipairs(source.tops) do
		local newId = map[oldId]
		local block = newId and self.blocks[newId]
		if block ~= nil and block.parent == nil and indexOf(self.tops, newId) == nil then
			table.insert(self.tops, newId)
			table.insert(newTops, newId)
		end
	end

	-- Notes (déjà validées par fromData) : ids de blocs traduits, positions décalées
	local newNotes = {}
	for _, oldNoteId in ipairs(source:noteIds()) do
		local src = source.notes[oldNoteId]
		local noteId = self:_newNoteId()
		local blockId = nil
		if src.blockId ~= nil then
			blockId = map[src.blockId]
		end
		self.notes[noteId] = {
			id = noteId,
			text = src.text,
			x = src.x + dx,
			y = src.y + dy,
			w = src.w,
			couleur = src.couleur,
			blockId = blockId,
			replie = src.replie == true,
		}
		table.insert(newNotes, noteId)
	end

	-- Lignes (SPEC §36, déjà validées par fromData) : nouveaux ids, blocs traduits
	for _, oldLinkId in ipairs(source:linkIds()) do
		local src = source.liens[oldLinkId]
		local de, vers = map[src.de], map[src.vers]
		if de ~= nil and vers ~= nil and de ~= vers and self.blocks[de] ~= nil and self.blocks[vers] ~= nil then
			local linkId = self:_newLinkId()
			self.liens[linkId] = {
				id = linkId,
				de = de,
				vers = vers,
				texte = src.texte or "",
				style = LINK_STYLE_SET[src.style] and src.style or Model.LINK_DEFAULT_STYLE,
				couleur = copyColor(src.couleur),
			}
		end
	end
	source:destroy()
	return newTops, warnings, newNotes
end

-- Copie pour le presse-papiers (SPEC §32) : blockId et tout ce qui le suit — ou, avec singleOnly,
-- seulement ce bloc avec ses entrées et ses corps — et les notes de ces blocs, au format de
-- sérialisation (SPEC §6). Le bloc copié est la seule pile de premier niveau, en (0, 0) ; les notes
-- gardent leur décalage par rapport au haut de la pile d'origine (exact quand le bloc copié est en
-- haut d'une pile). À recoller avec model:importData(data, x, y) : le bloc arrive en (x, y). Seules
-- les variables utilisées par ces blocs sont incluses. Renvoie data, ou nil si le bloc n'existe pas.
function Model:exportStack(blockId, singleOnly)
	local head = self.blocks[blockId]
	if head == nil then
		return nil
	end
	local ids = self:_collect(blockId, singleOnly ~= true)
	local inside = {}
	for _, id in ipairs(ids) do
		inside[id] = true
	end
	local blocks = {}
	local used = {}
	for _, id in ipairs(ids) do
		local src = self.blocks[id]
		local entry = { def = src.def, x = 0, y = 0 }
		if src.disabled == true then
			entry.disabled = true
		end
		if src.next ~= nil and inside[src.next] then
			entry.next = src.next
		end
		for _, slotName in ipairs(SLOTS) do
			local bodyId = src.sub[slotName]
			if bodyId ~= nil and inside[bodyId] then
				entry.sub = entry.sub or {}
				entry.sub[slotName] = bodyId
			end
		end
		for name, input in pairs(src.inputs) do
			if type(name) == "string" then
				local saved = {}
				local hasData = false
				local value = copyLiteral(input.value)
				if value ~= nil then
					saved.value = value
					hasData = true
				end
				if input.block ~= nil and inside[input.block] then
					saved.block = input.block
					hasData = true
				end
				if hasData then
					entry.inputs = entry.inputs or {}
					entry.inputs[name] = saved
				end
			end
		end
		local def = Registry.get(src.def)
		if def ~= nil then
			for _, spec in ipairs(def.inputs or {}) do
				local input = src.inputs[spec.name]
				if spec.kind == "variable" and input ~= nil and type(input.value) == "string" and input.value ~= "" then
					used[input.value] = true
				end
			end
		end
		blocks[id] = entry
	end

	-- Variables utilisées : dans l'ordre du projet, puis les autres par ordre alphabétique
	local variables = {}
	for _, name in ipairs(self.variables) do
		if used[name] then
			table.insert(variables, name)
			used[name] = nil
		end
	end
	local others = {}
	for name in pairs(used) do
		table.insert(others, name)
	end
	table.sort(others)
	for _, name in ipairs(others) do
		table.insert(variables, name)
	end

	local data = {
		format = Model.FORMAT,
		version = Model.VERSION,
		mode = self.mode,
		variables = variables,
		tops = { blockId },
		blocks = blocks,
	}
	local rootBlock = self.blocks[self:root(blockId)] or head
	local ox, oy = toFinite(rootBlock.x, 0), toFinite(rootBlock.y, 0)
	local notes = nil
	for noteId, note in pairs(self.notes) do
		if note.blockId ~= nil and inside[note.blockId] then
			notes = notes or {}
			notes[noteId] = serializeNote(note, ox, oy)
		end
	end
	if notes ~= nil then
		data.notes = notes
	end
	-- Lignes entre deux blocs copiés tous les deux (SPEC §36)
	local liens = nil
	for linkId, link in pairs(self.liens) do
		if inside[link.de] and inside[link.vers] then
			liens = liens or {}
			liens[linkId] = serializeLink(link, nil)
		end
	end
	if liens ~= nil then
		data.liens = liens
	end
	return data
end

---------------------------------------------------------------------------
-- Historique (annuler / rétablir)
---------------------------------------------------------------------------

function Model:_resetHistory()
	self._history = { self:serialize() }
	self._historyIndex = 1
	self._savedIndex = 1
	self._savedMark = nil
	self.dirty = false
end

function Model:_restore(snapshot)
	local ok = pcall(populate, self, snapshot, {})
	if not ok then
		table.clear(self.blocks)
		table.clear(self.tops)
		table.clear(self.notes)
		table.clear(self.liens)
	end
end

-- Enregistre l'état actuel dans l'historique, dirty = true, déclenche Changed(reason).
-- Si rien n'a changé depuis le dernier instantané, aucun instantané n'est ajouté (Changed est
-- quand même déclenché). Renvoie true si un instantané a été ajouté.
function Model:commit(reason)
	reason = reason or "modifier"
	local snapshot = self:serialize()
	local current = self._history[self._historyIndex]
	if current ~= nil and deepEqual(current, snapshot) then
		self.Changed:Fire(reason)
		return false
	end
	for i = #self._history, self._historyIndex + 1, -1 do
		self._history[i] = nil
	end
	if self._savedIndex ~= nil and self._savedIndex > self._historyIndex then
		self._savedIndex = nil
	end
	table.insert(self._history, snapshot)
	self._historyIndex = #self._history
	while #self._history > Model.MAX_HISTORY do
		table.remove(self._history, 1)
		self._historyIndex -= 1
		if self._savedIndex ~= nil then
			self._savedIndex -= 1
			if self._savedIndex < 1 then
				self._savedIndex = nil
			end
		end
	end
	self.dirty = true
	self.Changed:Fire(reason)
	return true
end

function Model:canUndo()
	return self._historyIndex > 1
end

function Model:canRedo()
	return self._historyIndex < #self._history
end

function Model:undo()
	if not self:canUndo() then
		return false
	end
	self._historyIndex -= 1
	self:_restore(self._history[self._historyIndex])
	self.dirty = self._historyIndex ~= self._savedIndex
	self.Changed:Fire("undo")
	return true
end

function Model:redo()
	if not self:canRedo() then
		return false
	end
	self._historyIndex += 1
	self:_restore(self._history[self._historyIndex])
	self.dirty = self._historyIndex ~= self._savedIndex
	self.Changed:Fire("redo")
	return true
end

-- Marque un état comme enregistré (sans Changed). Annuler / rétablir jusqu'à cet état redonnera
-- dirty = false.
-- snapshot (facultatif) : la table model:serialize() réellement écrite (Storage.save). Sans lui,
-- c'est l'état actuel (dirty = false). Avec lui, un changement fait pendant l'écriture
-- (UpdateSourceAsync cède la main) reste « non enregistré » (dirty = true).
function Model:markSaved(snapshot)
	local current = self:serialize()
	if snapshot == nil then
		-- Second appel sans instantané juste après Storage.save (App) : si rien n'a changé depuis,
		-- l'état enregistré reste celui que Storage.save a réellement écrit.
		local mark = self._savedMark
		if mark ~= nil and deepEqual(mark, current) then
			return
		end
		self._savedMark = nil
		snapshot = current
	else
		self._savedMark = current
	end
	local index = self._historyIndex
	local savedIndex = nil
	local entry = self._history[index]
	if entry ~= nil and deepEqual(entry, snapshot) then
		savedIndex = index
	else
		-- L'état écrit est un peu plus ancien (changement pendant l'écriture) : on le cherche dans
		-- l'historique, du plus proche au plus lointain.
		for distance = 1, #self._history do
			local before = self._history[index - distance]
			if before ~= nil and deepEqual(before, snapshot) then
				savedIndex = index - distance
				break
			end
			local after = self._history[index + distance]
			if after ~= nil and deepEqual(after, snapshot) then
				savedIndex = index + distance
				break
			end
		end
	end
	self._savedIndex = savedIndex
	self.dirty = not deepEqual(current, snapshot)
end

return Model
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">Modeles</string><ProtectedString name="Source"><![CDATA[-- Modeles : la palette « Modèles » — des scripts entiers prêts à poser (SPEC §22.2).
--
-- API (SPEC §22.2) :
--   Modeles.list() -> { entrée, … }   (ordre des cartes de la palette)
--   Modeles.get(id) -> entrée | nil
--   entrée = { id, title, description, mode = "server"|"local"|"module", data = <projet sérialisé (SPEC §6)>,
--              count = nombre de blocs, colors = { Color3, … } (couleurs des catégories des 4 premiers
--              blocs de la première pile, pour l'aperçu de la carte) }
-- NOTE: champs en plus de la SPEC : cible (où placer le script), exemple (id de l'exemple d'origine dans
--   Examples.lua), subtitle (« 3 blocs · serveur ») et tag (petit mot pour la carte, ex. « caméra »).
-- NOTE: modèle d'écran (board BlocsGUI « Menu principal · écran + 3 boutons » : « les modèles d'écran
--   ajoutent aussi l'interface dans StarterGui ») : champs ecran (id du modèle d'interface de
--   GuiTemplates, ex. "menu") et screen (nom de l'écran, ex. "Menu") ; data = les blocs de cet écran
--   (script local). App pose alors l'écran ET ses blocs avec app:insertTemplate(ecran) au lieu
--   d'importer data dans le projet ouvert.
--
-- Les données viennent des exemples (Examples.lua) par leur id : chaque appel renvoie une copie neuve
-- (l'appelant peut la modifier ; App la pose avec model:importData(data, dx, dy)). Les notes des exemples
-- (SPEC §29) sont dans data.notes : importData les ajoute avec les blocs. Un modèle dont l'exemple
-- (ou le modèle d'interface) n'existe pas (bloc pas encore disponible) n'apparaît simplement pas.

local Registry = require(script.Parent.Registry)
local Util = require(script.Parent.Util)

local Modeles = {}

local MODE_LABELS = { server = "serveur", ["local"] = "local", module = "module" }
local MAX_COLORS = 4

-- Ordre des cartes (les modèles demandés par la SPEC d'abord)
local LISTE = {
	{
		id = "piece",
		exemple = "piece_toute_prete",
		title = "Pièce à ramasser",
		description = "Une pièce qui donne 1 point au joueur qui la touche, puis revient 5 secondes plus tard.",
		tag = "classement",
	},
	{
		id = "brique_mortelle",
		exemple = "brique_mortelle",
		title = "Brique mortelle",
		description = "Une brique rouge en néon qui élimine les joueurs qui la touchent.",
		tag = "piège",
	},
	{
		id = "obby_complet",
		exemple = "obby_complet",
		title = "Obby complet",
		description = "Points de sauvegarde, plateforme qui disparaît et brique mortelle, dans un seul script.",
		tag = "sauvegarde + mort",
	},
	{
		id = "porte",
		exemple = "porte",
		title = "Porte à clic",
		description = "Clique sur la porte : elle s'ouvre 3 secondes, puis se referme toute seule.",
		tag = "clic",
	},
	{
		id = "combat_epee",
		exemple = "combat_local",
		title = "Combat à l'épée",
		description = "Le script local du combat : la touche F ou un clic envoie « attaque » au serveur. Ajoute aussi « Combat à l'épée : l'attaque » dans un script serveur.",
		tag = "clic + touche F",
	},
	{
		id = "combat_epee_attaque",
		exemple = "combat_serveur",
		title = "Combat à l'épée : l'attaque",
		description = "Le script serveur du combat : coup d'épée, hitbox, dégâts et temps de recharge à chaque message « attaque ».",
		tag = "hitbox",
	},
	{
		id = "menu_principal",
		ecran = "menu", -- modèle d'interface (GuiTemplates) : l'écran et ses blocs
		title = "Menu principal",
		description = "Un écran de menu pour StarterGui (titre, boutons Jouer, Boutique et Paramètres, compteur de pièces) avec ses blocs : un clic sur Jouer cache le menu en fondu. Il s'ouvre dans le Studio d'interface.",
		tag = "écran + 3 boutons",
	},
	{
		id = "pnj_ennemi",
		exemple = "pnj_ennemi",
		title = "PNJ ennemi",
		description = "Un PNJ qui poursuit le joueur le plus proche et le frappe, avec une barre de vie.",
		tag = "poursuite + dégâts",
	},
	{
		id = "cinematique",
		exemple = "cinematique",
		title = "Cinématique",
		description = "Bandes de cinéma et caméra qui glisse de Point1 à Point2, puis revient au joueur.",
		tag = "caméra",
	},
	{
		id = "sprint_double_saut",
		exemple = "sprint_double_saut",
		title = "Sprint + double saut",
		description = "Maj pour courir, et un deuxième saut en l'air.",
		tag = "mouvements",
	},
	{
		id = "bouton_achat_epee",
		exemple = "boutique_epee",
		title = "Bouton d'achat d'épée",
		description = "Clique sur le bouton pour acheter l'épée de ServerStorage avec 100 pièces.",
		tag = "boutique",
	},
	{
		id = "jour_nuit",
		exemple = "jour_nuit",
		title = "Cycle jour/nuit",
		description = "Le soleil et la lune tournent tout seuls : une journée dure 5 minutes.",
		tag = "ciel",
	},
	{
		id = "generateur_pieces",
		exemple = "generateur_pieces",
		title = "Générateur de pièces",
		description = "Une copie de la pièce de ServerStorage apparaît toutes les 3 secondes (10 au plus).",
		tag = "apparition",
	},
	{
		id = "attaque_effets",
		exemple = "effets_attaque",
		title = "Attaque avec effets",
		description = "Onde de choc, éclair d'impact, chiffres de dégâts et contour rouge à chaque coup.",
		tag = "effets",
	},
	{
		id = "course_chrono",
		exemple = "course_chrono",
		title = "Course chronométrée",
		description = "Un chrono de Départ à Arrivée pour chaque joueur, et son record dans le classement.",
		tag = "chrono",
	},
}

---------------------------------------------------------------------------
-- Construction des entrées
---------------------------------------------------------------------------

-- Exemples (Examples.lua) : chargés à chaque appel (le module garde ses données en mémoire)
local function loadExamples()
	local folder = script.Parent
	local moduleScript = folder and folder:FindFirstChild("Examples")
	if moduleScript == nil then
		return {}
	end
	local ok, list = pcall(require, moduleScript)
	if ok and type(list) == "table" then
		return list
	end
	warn("[Blocs FR] Modèles : impossible de charger les exemples : " .. tostring(list))
	return {}
end

-- Modèles d'interface (GuiTemplates.lua, écrit par un autre module) : nil s'il manque ou ne se charge pas
local function loadGuiTemplates()
	local folder = script.Parent
	local moduleScript = folder and folder:FindFirstChild("GuiTemplates")
	if moduleScript == nil then
		return nil
	end
	local ok, GuiTemplates = pcall(require, moduleScript)
	if ok and type(GuiTemplates) == "table" and type(GuiTemplates.get) == "function" then
		return GuiTemplates
	end
	warn("[Blocs FR] Modèles : impossible de charger les modèles d'interface : " .. tostring(GuiTemplates))
	return nil
end

local function findExample(examples, id)
	for _, ex in ipairs(examples) do
		if type(ex) == "table" and ex.id == id then
			return ex
		end
	end
	return nil
end

local function countBlocks(data)
	local n = 0
	if type(data.blocks) == "table" then
		for _ in pairs(data.blocks) do
			n += 1
		end
	end
	return n
end

-- Couleurs des catégories des premiers blocs de la première pile (l'événement puis la suite)
local function firstStackColors(data)
	local colors = {}
	local blocks = type(data.blocks) == "table" and data.blocks or {}
	local id = type(data.tops) == "table" and data.tops[1] or nil
	local steps = 0
	while id ~= nil and #colors < MAX_COLORS and steps < 100 do
		steps += 1
		local block = blocks[id]
		if type(block) ~= "table" then
			break
		end
		local ok, color = pcall(Registry.color, block.def)
		if ok and typeof(color) == "Color3" then
			table.insert(colors, color)
		end
		id = block.next
	end
	return colors
end

-- Modèle d'écran : les blocs du modèle d'interface (script local de l'écran) ; l'écran lui-même est
-- posé par App (app:insertTemplate(ecran)). nil si le modèle d'interface n'existe pas.
local function buildScreenEntry(spec)
	local GuiTemplates = loadGuiTemplates()
	if GuiTemplates == nil then
		return nil
	end
	local template = GuiTemplates.get(spec.ecran)
	if type(template) ~= "table" or type(template.blocs) ~= "table" then
		return nil
	end
	local data = Util.deepCopy(template.blocs)
	local mode = "local" -- (les blocs d'un écran sont toujours un script local, SPEC §21.5)
	data.mode = mode
	local count = countBlocks(data)
	local subtitle = "écran + " .. tostring(count) .. " bloc"
	if count > 1 then
		subtitle = subtitle .. "s"
	end
	subtitle = subtitle .. " · " .. MODE_LABELS[mode]
	return {
		id = spec.id,
		title = spec.title,
		description = spec.description or template.description,
		mode = mode,
		data = data,
		count = count,
		colors = firstStackColors(data),
		ecran = spec.ecran,
		screen = template.screen,
		subtitle = subtitle,
		tag = spec.tag,
	}
end

local function buildEntry(spec, examples)
	if spec.ecran ~= nil then
		return buildScreenEntry(spec)
	end
	local ex = findExample(examples, spec.exemple)
	if ex == nil or type(ex.data) ~= "table" then
		return nil
	end
	local data = Util.deepCopy(ex.data)
	local mode = ex.mode
	if MODE_LABELS[mode] == nil then
		mode = "server"
	end
	local count = countBlocks(data)
	local subtitle = tostring(count) .. " bloc"
	if count > 1 then
		subtitle = subtitle .. "s"
	end
	subtitle = subtitle .. " · " .. MODE_LABELS[mode]
	return {
		id = spec.id,
		title = spec.title,
		description = spec.description or ex.description,
		mode = mode,
		data = data,
		count = count,
		colors = firstStackColors(data),
		cible = ex.cible,
		exemple = ex.id,
		subtitle = subtitle,
		tag = spec.tag,
	}
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------

-- Tous les modèles disponibles, dans l'ordre des cartes (copies neuves à chaque appel)
function Modeles.list()
	local examples = loadExamples()
	local out = {}
	for _, spec in ipairs(LISTE) do
		local ok, entry = pcall(buildEntry, spec, examples)
		if ok and entry ~= nil then
			table.insert(out, entry)
		elseif not ok then
			warn("[Blocs FR] Modèle « " .. spec.id .. " » ignoré : " .. tostring(entry))
		end
	end
	return out
end

-- Un modèle par son id (copie neuve), ou nil
function Modeles.get(id)
	for _, spec in ipairs(LISTE) do
		if spec.id == id then
			local ok, entry = pcall(buildEntry, spec, loadExamples())
			if ok then
				return entry
			end
			warn("[Blocs FR] Modèle « " .. tostring(id) .. " » : " .. tostring(entry))
			return nil
		end
	end
	return nil
end

return Modeles
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">Palette</string><ProtectedString name="Source"><![CDATA[-- Palette : panneau de gauche de Blocs FR (design « Blocs FR — interface et logo »).
-- Recherche « Rechercher un bloc… » (36 px, loupe), grille des catégories (2 colonnes de boutons de 32 px,
-- pastille colorée ; 12 catégories = 6 rangées, la grille suit Registry.categories()), puis une longue liste
-- défilante de vrais blocs (Renderer.renderPrototype) sous un titre par catégorie (pastille + MAJUSCULES
-- 12 px). Un appui sur un bloc démarre un glisser-déposer vers le canvas (canvas:beginPaletteDrag) ;
-- clic droit → « Aide sur ce bloc » (deps.openHelp).
-- Types de script (SPEC §20) : un bloc réservé à un autre type porte l'étiquette « serveur » / « local » /
-- « module » et est estompé ; dans un script module, les blocs serveur / local ne sont pas estompés.
-- deps = { host, dialogs, canvas, getModel, setStatus, openHelp? }
--
-- Animations (SPEC §24, module Anim ; état final immédiat quand elles sont désactivées) :
--   * clic sur une catégorie : la liste défile en douceur, les blocs de la section arrivent un par un
--     (70 ms d'écart, glissement de 16 px) et une barre de la couleur de la catégorie pousse dans
--     le bouton sélectionné ;
--   * survol d'un bloc : il s'éclaircit et glisse de 4 px ;
--   * palette:setDeleteHint(bool) : la palette rougit pendant qu'une pile glissée passe au-dessus
--     (appelé par le Canvas : la palette s'enregistre avec canvas:setPalette).
--
-- Phase 2 (SPEC §22.2, §31-§33) :
--   * tuile « ◆ Modèles — scripts entiers prêts à poser » sous les catégories et section MODÈLES à la
--     fin de la liste (cartes : mini-barres aux couleurs des blocs, titre, « n blocs · serveur ») ; une
--     carte glissée sur la zone de travail -> deps.insertModele(id, screenPos) ; un clic ->
--     deps.insertModele(id, nil) (centre visible). Module Modeles facultatif (écrit en parallèle) ;
--   * section FAVORIS en premier (Reglages.current().palette.favoris) ; mode débutant
--     (palette.debutant) : seulement les blocs les plus simples de chaque catégorie ;
--   * menu du clic droit d'un bloc (§33) : Ajouter à la zone de travail, Ajouter aux favoris /
--     Retirer, Ouvrir dans le wiki, Aide sur ce bloc (+ Renommer / Supprimer pour une variable) ;
--   * mise en page qui s'adapte : la largeur suit le cadre (palette replacée dans la zone « Blocs de
--     l'écran », 230 px) et, quand la hauteur manque, les catégories deviennent compactes (24 px,
--     2 puis 3 colonnes) puis un simple menu « ≡ Catégories ▼ » : la liste des blocs garde toujours au
--     moins 140 px (fenêtre de 460 px de haut).
-- deps facultatifs : insertModele(id, screenPos|nil), toggleFavorite(defId), isFavorite(defId),
-- openWiki(defId), openHelp(defId) (ancien nom de « ouvrir dans le wiki »).

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local Renderer = require(script.Parent.Renderer)
local Anim = require(script.Parent.Anim)

-- Modules facultatifs (Reglages, Modeles : écrits en parallèle) ; leur absence ne casse jamais la palette
local optionalCache = {}
local function optionalModule(name)
	local cached = optionalCache[name]
	if cached ~= nil then
		return cached or nil
	end
	local result = false
	local ok, module = pcall(function()
		local inst = script.Parent:FindFirstChild(name)
		if inst and inst:IsA("ModuleScript") then
			return require(inst)
		end
		return nil
	end)
	if ok and type(module) == "table" then
		result = module
	end
	optionalCache[name] = result
	return result or nil
end

local Palette = {}
Palette.__index = Palette

-- Couleurs du thème lues à chaque usage (les réglages peuvent changer le thème)
local C = setmetatable({}, {
	__index = function(_, key)
		return Theme.Colors[key]
	end,
})
local FONT = Theme.Fonts.UI
local FONT_BOLD = Theme.Fonts.UIBold

local MARGIN = 12 -- marge du panneau
local LIST_X = 12 -- marge gauche des blocs dans la liste
local ITEM_GAP = 8 -- espace vertical entre deux blocs
local HEADER_H = 34
local SCROLLBAR = 6
local TOOLTIP_DELAY = 0.55
local SEARCH_DELAY = 0.18
local DIM_AMOUNT = 0.55 -- blocs d'un autre type de script : aspect « 45 % d'opacité »
local FAST = (Theme.Anim and Theme.Anim.Fast) or 0.12
local SCROLL_TIME = 0.3 -- défilement vers une catégorie
local HOVER_SHIFT = 4 -- un bloc survolé glisse de 4 px
local HOVER_LIGHTEN = 0.12 -- et s'éclaircit (comme un voile blanc à 88 % de transparence)
local ACCENT_W = 4 -- barre colorée du bouton de catégorie sélectionné
local WHITE = Color3.fromRGB(255, 255, 255)
local MIN_LIST_H = 140 -- hauteur minimale de la liste des blocs (SPEC §22.2)
local MODELES_ACCENT = Color3.fromRGB(245, 158, 11) -- #F59E0B (Theme.Colors.ModelesAccent)
local FAVORIS_DOT = Color3.fromRGB(240, 180, 60)
local MODELE_CARD_H = 104
local MODELE_PREVIEW_H = 50

-- Mises en page de l'en-tête (recherche + catégories + tuile Modèles), de la plus confortable à la
-- plus compacte. "menu" : un bouton « ≡ Catégories ▼ » remplace la grille.
local HEADER_MODES = { "normal", "compact", "compact3", "menu" }

local function headerConfig(mode)
	local layout = Theme.Layout
	if mode == "normal" then
		return {
			margin = MARGIN,
			searchH = layout.SearchHeight or 36,
			afterSearch = 10,
			cols = 2,
			rowH = layout.CategoryButtonHeight or 32,
			gap = 6,
			textSize = Theme.TextSize.UI or 13,
			dot = 9,
			radius = 7,
			tileH = 38,
			afterGrid = 12,
			minWidth = 0,
		}
	elseif mode == "compact" then
		return {
			margin = 10,
			searchH = 30,
			afterSearch = 8,
			cols = 2,
			rowH = 24,
			gap = 4,
			textSize = 11,
			dot = 8,
			radius = 6,
			tileH = 28,
			afterGrid = 8,
			minWidth = 0,
		}
	elseif mode == "compact3" then
		return {
			margin = 10,
			searchH = 30,
			afterSearch = 8,
			cols = 3,
			rowH = 24,
			gap = 4,
			textSize = 10,
			dot = 7,
			radius = 6,
			tileH = 28,
			afterGrid = 8,
			minWidth = 240,
		}
	end
	return {
		margin = 10,
		searchH = 30,
		afterSearch = 8,
		rowH = 28,
		textSize = 12,
		radius = 6,
		afterGrid = 8,
		minWidth = 0,
	}
end

-- Mode débutant (réglage palette.debutant) : les blocs les plus simples de chaque catégorie. Une
-- catégorie absente de cette liste garde ses 6 premiers blocs ; « modules » est entièrement cachée.
local BEGINNER = {
	evenements = { "evt_demarrage", "evt_touche", "evt_touche_perso", "evt_clic", "evt_joueur_rejoint", "evt_message", "evt_touche_clavier" },
	debogage = { "dbg_afficher" },
	controle = { "ctrl_attendre", "ctrl_repeter", "ctrl_toujours", "ctrl_si", "ctrl_si_sinon", "ctrl_envoyer_message" },
	variables = { "var_definir", "var_ajouter" },
	actions = { "act_deplacer", "act_teleporter", "act_tourner", "act_glisser", "act_taille", "act_ancrer", "act_collision", "act_detruire", "act_cloner", "act_jouer_son" },
	monde = { "monde_creer_partie", "monde_heure", "monde_objet_nomme" },
	joueurs = { "j_eliminer", "j_degats", "j_soigner", "j_vitesse", "j_saut", "j_teleporter", "j_creer_stat", "j_ajouter_stat", "j_message_ecran" },
	apparence = { "app_couleur", "app_couleur_aleatoire", "app_transparence", "app_materiau", "app_cacher", "app_montrer", "app_effet" },
	operateurs = { "op_plus", "op_moins", "op_fois", "op_divise", "op_aleatoire", "op_superieur", "op_inferieur", "op_egal", "op_et", "op_ou", "op_non", "op_joindre" },
	valeurs = { "val_vrai", "val_faux", "val_cet_objet", "val_joueur", "val_personnage", "val_nombre", "val_texte" },
	interface = { "gui_quand_clic", "gui_afficher_ecran", "gui_cacher_ecran", "gui_texte", "gui_montrer", "gui_cacher", "gui_notification" },
	camera = { "cam_mode", "cam_trembler", "cam_normale" },
	vfx = { "vfx_particules", "vfx_explosion", "vfx_trainee", "vfx_degats", "vfx_arreter" },
	toutprets = { "tp_attaque_melee", "tp_animation", "tp_point_sauvegarde", "tp_teleporteur", "tp_ramasser", "tp_trampoline", "tp_plateforme_disparait", "tp_porte_auto", "tp_sprint", "tp_double_saut" },
}
local BEGINNER_HIDDEN = { modules = true }

-- Blocs d'une catégorie gardés en mode débutant ; renvoie la liste et le nombre de blocs cachés
local function beginnerFilter(catId, defs)
	if BEGINNER_HIDDEN[catId] then
		return {}, #defs
	end
	local list = BEGINNER[catId]
	local out = {}
	if list then
		local wanted = {}
		for _, id in ipairs(list) do
			wanted[id] = true
		end
		for _, def in ipairs(defs) do
			if wanted[def.id] then
				table.insert(out, def)
			end
		end
	end
	if #out == 0 then
		for i = 1, math.min(6, #defs) do
			table.insert(out, defs[i])
		end
	end
	return out, #defs - #out
end

local function currentSettings()
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.current) == "function" then
		local ok, s = pcall(Reglages.current)
		if ok and type(s) == "table" then
			return s
		end
	end
	return nil
end

-- Réglages qui changent la liste : favoris et mode débutant
local function settingsSignature()
	local s = currentSettings()
	if not s or type(s.palette) ~= "table" then
		return ""
	end
	local parts = { s.palette.debutant == true and "debutant" or "tout" }
	if type(s.palette.favoris) == "table" then
		for _, id in ipairs(s.palette.favoris) do
			table.insert(parts, tostring(id))
		end
	end
	return table.concat(parts, "|")
end

local function isBeginner()
	local s = currentSettings()
	return s ~= nil and type(s.palette) == "table" and s.palette.debutant == true
end

local function modeText(mode)
	if mode == "local" then
		return "local"
	elseif mode == "module" then
		return "module"
	end
	return "serveur"
end

-- Modèle d'écran de la palette « Modèles » (Modeles : champ ecran) : App l'ouvre dans le Studio d'interface
local function isScreenModele(entry)
	return type(entry) == "table" and type(entry.ecran) == "string" and entry.ecran ~= ""
end

-- Pastille de catégorie (plus claire que la couleur des blocs, lisible sur fond sombre)
local function dotColor(cat)
	return cat.dot or cat.color
end

-- Coins entièrement arrondis (cercle / pilule)
local function round(inst)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = inst
	return c
end

-- Majuscules en tenant compte des lettres accentuées françaises (é -> É, ç -> Ç…)
local function upperFr(s)
	local ok, result = pcall(function()
		local parts = {}
		for _, cp in utf8.codes(s) do
			if cp >= 97 and cp <= 122 then
				cp -= 32
			elseif cp >= 0xE0 and cp <= 0xFE and cp ~= 0xF7 then
				cp -= 32
			elseif cp == 0x153 then
				cp = 0x152
			end
			table.insert(parts, utf8.char(cp))
		end
		return table.concat(parts)
	end)
	if ok then
		return result
	end
	return string.upper(s)
end

local function makeLabel(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = Theme.TextSize.UI,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

-- Types de script (SPEC §20) : étiquette affichée à côté d'un bloc réservé à un type de script
local SCRIPT_TAGS = { server = "serveur", ["local"] = "local", module = "module" }

-- Étiquette du bloc dans le mode actuel ("server" / "local" / "module") : nil s'il fonctionne partout
-- ou s'il est fait pour ce mode, sinon « serveur » / « local » / « module »
local function scriptTag(def, mode)
	local st = def.scriptType or "both"
	if st == "both" or st == mode then
		return nil
	end
	return SCRIPT_TAGS[st] or tostring(st)
end

-- Vrai si le bloc doit être estompé dans le mode actuel. Dans un script module, les blocs « serveur » /
-- « local » gardent leur étiquette sans être estompés : un module s'exécute du côté du script qui le charge.
local function isDimmed(def, mode)
	local st = def.scriptType or "both"
	if st == "both" or st == mode then
		return false
	end
	if mode == "module" and (st == "server" or st == "local") then
		return false
	end
	return true
end

-- Remarque ajoutée à l'explication d'un bloc réservé à un type de script (ou nil)
local function scriptNote(def, mode)
	local st = def.scriptType or "both"
	if st == "both" or st == mode then
		return nil
	end
	if mode == "module" and (st == "server" or st == "local") then
		local side = "serveur"
		if st == "local" then
			side = "local"
		end
		return "Dans un script module, ce bloc ne fonctionne que si le module est chargé par un script " .. side .. "."
	end
	if st == "local" then
		return "⚠ Ce bloc ne fonctionne que dans un script local."
	elseif st == "module" then
		return "⚠ Ce bloc ne fonctionne que dans un script module."
	end
	return "⚠ Ce bloc ne fonctionne que dans un script serveur."
end

-- Signature de ce qui change l'affichage de la palette (mode + variables)
local function signatureOf(model)
	if not model then
		return "aucun"
	end
	local parts = { tostring(model.mode) }
	for _, name in ipairs(model.variables or {}) do
		table.insert(parts, tostring(name))
	end
	return table.concat(parts, "\n")
end

-- Nom de la première entrée de type "variable" d'un bloc (ou nil)
local function variableInputName(def)
	for _, input in ipairs(def.inputs or {}) do
		if input.kind == "variable" then
			return input.name
		end
	end
	return nil
end

-- Estompe un bloc dessiné : chaque couleur est mélangée avec le fond du panneau.
-- (Mélange plutôt que transparence : les cadres superposés d'un bloc ne laissent pas voir leurs bords.)
local function dimGui(root)
	local list = root:GetDescendants()
	table.insert(list, root)
	local bg = C.Panel
	for _, inst in ipairs(list) do
		if inst:IsA("GuiObject") then
			inst.BackgroundColor3 = inst.BackgroundColor3:Lerp(bg, DIM_AMOUNT)
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				inst.TextColor3 = inst.TextColor3:Lerp(bg, DIM_AMOUNT)
			elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
				inst.ImageTransparency = 1 - (1 - inst.ImageTransparency) * (1 - DIM_AMOUNT)
			end
		elseif inst:IsA("UIStroke") then
			inst.Color = inst.Color:Lerp(bg, DIM_AMOUNT)
		end
	end
end

-- Couleurs de fond visibles d'un bloc dessiné (survol : elles sont mélangées avec du blanc).
-- La zone de clic, l'étiquette « serveur » / « local » et les voiles d'animation sont ignorés.
local function hoverEntries(holder)
	local entries = {}
	for _, inst in ipairs(holder:GetDescendants()) do
		if inst:IsA("GuiObject") and inst.BackgroundTransparency < 1 then
			local name = inst.Name
			local ignored = name == "Zone"
				or name == "Etiquette"
				or string.sub(name, 1, 4) == "Anim"
				or inst:FindFirstAncestor("Etiquette") ~= nil
			if not ignored then
				table.insert(entries, { inst, inst.BackgroundColor3 })
			end
		end
	end
	return entries
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function Palette.new(parentFrame, deps)
	local self = setmetatable({}, Palette)
	deps = deps or {}
	self.deps = deps
	self.host = deps.host
	self.dialogs = deps.dialogs
	self.canvas = deps.canvas
	self.getModel = deps.getModel or function()
		return nil
	end
	self.setStatus = deps.setStatus or function() end
	self.connections = {}
	self.itemMaid = Util.Maid.new()
	self.views = {}
	self.headerY = {}
	self.categoryButtons = {}
	self.query = ""
	self.contentHeight = 0
	self.activeCategory = nil
	self._sig = nil
	self._hoverToken = 0
	self._searchToken = 0
	self._tooltipShown = false
	self._tweening = false
	self._scrollTween = nil -- défilement animé en cours (poignée Anim)
	self._scrollToken = 0
	self.sectionItems = {} -- [catégorie] = objets de la liste sous son titre (arrivée en cascade)
	self._currentSection = nil
	self._hoverStates = setmetatable({}, { __mode = "k" }) -- [bloc] = éclaircissement au survol
	self._deleteHint = false
	self._deleteGlow = nil
	self._deleteGlowStroke = nil
	self._destroyed = false
	-- largeur des réglages (Theme.Layout.PanelWidth) tant que le cadre n'a pas de taille
	self.listWidth = (Theme.Layout.PanelWidth or 280) - SCROLLBAR
	self.headerMaid = Util.Maid.new() -- grille des catégories, tuile Modèles, menu compact
	self._headerMode = nil
	self._layoutWidth = 0
	self._reflowPending = false
	self._tempVeils = nil -- voiles posés pendant le défilement vers une catégorie
	self._menuLabel = nil -- texte du bouton « ≡ Catégories ▼ » (mode compact)

	Registry.load()

	self.frame = Util.create("Frame", {
		Name = "Palette",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parentFrame,
	})

	self:_buildSearch()

	self.separator = Util.create("Frame", {
		Name = "Separateur",
		BackgroundColor3 = C.PanelBorder,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Parent = self.frame,
	})

	self.list = Util.create("ScrollingFrame", {
		Name = "Blocs",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.None, -- hauteur calculée exactement (défilement vers les catégories)
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = SCROLLBAR,
		ScrollBarImageColor3 = C.ButtonActive,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		ClipsDescendants = true,
		Parent = self.frame,
	})
	table.insert(self.connections, self.list:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:_hoverEnd()
		self:_updateActiveCategory()
	end))

	-- en-tête (catégories) selon la place disponible, puis la liste
	local size = self.frame.AbsoluteSize
	self:_layoutHeader(self:_chooseHeaderMode(size.X, size.Y))
	if size.X >= 100 then
		self._layoutWidth = size.X
	end
	self:refresh(true)

	-- la palette suit la taille de son cadre (palette replacée dans la zone « Blocs de l'écran »)
	table.insert(self.connections, self.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_scheduleReflow()
	end))
	-- favoris et mode débutant (SPEC §31, §32)
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.Changed) == "table" and type(Reglages.Changed.Connect) == "function" then
		local okConnect, connection = pcall(function()
			return Reglages.Changed:Connect(function()
				task.defer(function()
					if not self._destroyed then
						self:refresh()
					end
				end)
			end)
		end)
		if okConnect and connection then
			table.insert(self.connections, connection)
		end
	end
	-- le canvas fait rougir la palette quand une pile glissée passe au-dessus (setDeleteHint)
	if self.canvas and type(self.canvas.setPalette) == "function" then
		pcall(self.canvas.setPalette, self.canvas, self)
	end
	return self
end

-- Loupe dessinée avec des Frames (anneau + manche en escalier)
local function drawMagnifier(parent)
	local icon = Util.create("Frame", {
		Name = "Loupe",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		Parent = parent,
	})
	local ring = Util.create("Frame", {
		Name = "Anneau",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.fromOffset(8, 8),
		Parent = icon,
	})
	round(ring)
	Util.stroke(ring, C.TextDim, 1.6)
	for i = 0, 2 do
		Util.create("Frame", {
			Name = "Manche",
			BackgroundColor3 = C.TextDim,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(9 + i, 9 + i),
			Size = UDim2.fromOffset(2, 2),
			Parent = icon,
		})
	end
	return icon
end

function Palette:_buildSearch()
	-- (position et hauteur fixées par _layoutHeader selon la place disponible)
	local box = Util.create("Frame", {
		Name = "Recherche",
		BackgroundColor3 = C.SearchBg,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(MARGIN, MARGIN),
		Size = UDim2.new(1, -2 * MARGIN, 0, Theme.Layout.SearchHeight or 36),
		Parent = self.frame,
	})
	self.searchFrame = box
	Util.corner(box, 8)
	local stroke = Util.stroke(box, C.SearchStroke, 1)

	drawMagnifier(box)

	self.searchBox = Util.create("TextBox", {
		Name = "Texte",
		Text = "",
		PlaceholderText = "Rechercher un bloc…",
		PlaceholderColor3 = C.TextDim,
		ClearTextOnFocus = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = Theme.TextSize.UI,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -64, 1, 0),
		Parent = box,
	})

	local clearButton = Util.create("TextButton", {
		Name = "Effacer",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.ButtonHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		Visible = false,
		Parent = box,
	})
	Util.corner(clearButton, 11)
	makeLabel({
		Text = "×",
		TextSize = Theme.TextSize.Small,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = clearButton,
	})

	table.insert(self.connections, self.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		clearButton.Visible = self.searchBox.Text ~= ""
		self:_scheduleSearch()
	end))
	table.insert(self.connections, self.searchBox.Focused:Connect(function()
		stroke.Color = C.Accent
	end))
	table.insert(self.connections, self.searchBox.FocusLost:Connect(function(enterPressed)
		stroke.Color = C.SearchStroke
		if enterPressed then
			self._searchToken += 1
			-- reconstruction différée : jamais pendant le FocusLost du champ
			task.defer(function()
				if not self._destroyed then
					self:_applySearch(self.searchBox.Text)
				end
			end)
		end
	end))
	table.insert(self.connections, clearButton.MouseEnter:Connect(function()
		clearButton.BackgroundTransparency = 0
	end))
	table.insert(self.connections, clearButton.MouseLeave:Connect(function()
		clearButton.BackgroundTransparency = 1
	end))
	table.insert(self.connections, clearButton.MouseButton1Click:Connect(function()
		self.searchBox.Text = ""
		self._searchToken += 1
		self:_applySearch("")
	end))
end

---------------------------------------------------------------------------
-- En-tête : catégories et tuile « Modèles », selon la place disponible
---------------------------------------------------------------------------

-- Vrai si la section « Modèles » peut être montrée (module Modeles + deps.insertModele)
function Palette:_modelesAvailable()
	if type(self.deps.insertModele) ~= "function" then
		return false
	end
	local Modeles = optionalModule("Modeles")
	return Modeles ~= nil and type(Modeles.list) == "function"
end

-- Hauteur de l'en-tête (recherche + catégories + tuile + séparateur) dans un mode
function Palette:_headerHeight(mode)
	local cfg = headerConfig(mode)
	local y = cfg.margin + cfg.searchH + cfg.afterSearch
	if mode == "menu" then
		y += cfg.rowH
	else
		local rows = math.ceil(#Registry.categories() / cfg.cols)
		y += rows * cfg.rowH + math.max(0, rows - 1) * cfg.gap
		if self:_modelesAvailable() then
			y += cfg.gap + 2 + cfg.tileH
		end
	end
	return y + cfg.afterGrid + 1
end

-- Le mode le plus confortable qui laisse au moins MIN_LIST_H px à la liste des blocs
function Palette:_chooseHeaderMode(width, height)
	if height <= 0 or width <= 0 then
		return "normal"
	end
	for _, mode in ipairs(HEADER_MODES) do
		if mode ~= "menu" then
			local cfg = headerConfig(mode)
			if width >= cfg.minWidth and height - self:_headerHeight(mode) >= MIN_LIST_H then
				return mode
			end
		end
	end
	return "menu"
end

-- (Re)construit l'en-tête dans le mode donné puis place le séparateur et la liste
function Palette:_layoutHeader(mode)
	self._headerMode = mode
	self.headerMaid:clean()
	self.categoryButtons = {}
	self._menuLabel = nil
	local cfg = headerConfig(mode)
	self.searchFrame.Position = UDim2.fromOffset(cfg.margin, cfg.margin)
	self.searchFrame.Size = UDim2.new(1, -2 * cfg.margin, 0, cfg.searchH)
	local y = cfg.margin + cfg.searchH + cfg.afterSearch
	if mode == "menu" then
		y = self:_buildCategoryMenuRow(y, cfg)
	else
		y = self:_buildCategoryGrid(y, cfg)
		if self:_modelesAvailable() then
			y = self:_buildModelesTile(y + cfg.gap + 2, cfg)
		end
	end
	self.separator.Position = UDim2.fromOffset(0, y + cfg.afterGrid)
	local listTop = y + cfg.afterGrid + 1
	self.list.Position = UDim2.fromOffset(0, listTop)
	self.list.Size = UDim2.new(1, 0, 1, -listTop)
	for id in pairs(self.categoryButtons) do
		self:_applyCategoryLook(id)
	end
	self:_updateMenuLabel()
end

-- Grille des catégories (2 ou 3 colonnes) ; renvoie la position Y du bas de la grille
function Palette:_buildCategoryGrid(top, cfg)
	local cats = Registry.categories()
	local cols = cfg.cols
	local rows = math.ceil(#cats / cols)
	local h = cfg.rowH
	local gap = cfg.gap
	local gridH = rows * h + math.max(0, rows - 1) * gap
	local maid = self.headerMaid

	local grid = Util.create("Frame", {
		Name = "Categories",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(cfg.margin, top),
		Size = UDim2.new(1, -2 * cfg.margin, 0, gridH),
		Parent = self.frame,
	})
	maid:give(grid)

	local dotX = 11
	if cfg.dot < 9 then
		dotX = 8
	end
	local labelX = dotX + cfg.dot + 8
	for i, cat in ipairs(cats) do
		local col = (i - 1) % cols
		local row = math.floor((i - 1) / cols)
		local button = Util.create("TextButton", {
			Name = cat.id,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Button,
			BorderSizePixel = 0,
			Position = UDim2.new(col / cols, col * gap / cols, 0, row * (h + gap)),
			Size = UDim2.new(1 / cols, -gap * (cols - 1) / cols, 0, h),
			Parent = grid,
		})
		Util.corner(button, cfg.radius)
		local stroke = Util.stroke(button, C.ButtonActiveStroke, 1, 0)
		stroke.Enabled = false
		local dot = Util.create("Frame", {
			Name = "Pastille",
			BackgroundColor3 = dotColor(cat),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, dotX, 0.5, 0),
			Size = UDim2.fromOffset(cfg.dot, cfg.dot),
			Parent = button,
		})
		round(dot)
		local label = makeLabel({
			Text = cat.name,
			TextSize = cfg.textSize,
			TextColor3 = C.TextSoft,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(labelX, 0),
			Size = UDim2.new(1, -(labelX + 3), 1, 0),
			Parent = button,
		})
		-- barre de la couleur de la catégorie qui pousse quand elle est sélectionnée (largeur 0 sinon)
		local accentH = math.max(8, h - 12)
		local accent = Util.create("Frame", {
			Name = "Accent",
			BackgroundColor3 = dotColor(cat),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(0, accentH),
			Parent = button,
		})
		Util.corner(accent, 2)

		local entry = {
			button = button,
			stroke = stroke,
			label = label,
			hovered = false,
			accent = accent,
			accentH = accentH,
		}
		maid:give(button.MouseEnter:Connect(function()
			entry.hovered = true
			self:_applyCategoryLook(cat.id)
		end))
		maid:give(button.MouseLeave:Connect(function()
			entry.hovered = false
			self:_applyCategoryLook(cat.id)
		end))
		maid:give(button.MouseButton1Click:Connect(function()
			self:scrollToCategory(cat.id)
		end))
		self.categoryButtons[cat.id] = entry
	end

	return top + gridH
end

-- Tuile « ◆ Modèles — scripts entiers prêts à poser » (planche « Nouveaux blocs ») ; renvoie le bas
function Palette:_buildModelesTile(top, cfg)
	local maid = self.headerMaid
	local accent = C.ModelesAccent or MODELES_ACCENT
	local tile = Util.create("TextButton", {
		Name = "Modeles",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(cfg.margin, top),
		Size = UDim2.new(1, -2 * cfg.margin, 0, cfg.tileH),
		Parent = self.frame,
	})
	maid:give(tile)
	Util.corner(tile, 8)
	Util.create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(59, 42, 11), C.PanelAlt or Color3.fromRGB(35, 35, 40)),
		Parent = tile,
	})
	local stroke = Util.stroke(tile, accent, 1.5, 0)
	makeLabel({
		Name = "Icone",
		Text = "◆",
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 0),
		Size = UDim2.new(0, 18, 1, 0),
		Parent = tile,
	})
	local frameW = self.frame.AbsoluteSize.X
	if frameW < 100 then
		frameW = Theme.Layout.PanelWidth or 280
	end
	local showBadge = cfg.tileH >= 34 and frameW >= 250
	local badgeW = 0
	if showBadge then
		local badgeText = "NOUVEAU"
		badgeW = math.ceil(Util.textSize(badgeText, 10, FONT_BOLD).X) + 12
		local badge = Util.create("Frame", {
			Name = "Nouveau",
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(badgeW, 18),
			Parent = tile,
		})
		Util.corner(badge, 5)
		makeLabel({
			Text = badgeText,
			Font = FONT_BOLD,
			TextSize = 10,
			TextColor3 = Color3.fromRGB(28, 20, 6),
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = badge,
		})
		badgeW += 12
	end
	local text = "Modèles — scripts entiers prêts à poser"
	if cfg.tileH < 34 then
		text = "Modèles — scripts prêts à poser"
	end
	makeLabel({
		Name = "Texte",
		Text = text,
		Font = FONT_BOLD,
		TextSize = math.min(12, cfg.textSize + 1),
		TextColor3 = C.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(28, 0),
		Size = UDim2.new(1, -(30 + badgeW), 1, 0),
		Parent = tile,
	})
	maid:give(tile.MouseEnter:Connect(function()
		Anim.tween(stroke, { Thickness = 2.5 }, FAST, "quadOut")
	end))
	maid:give(tile.MouseLeave:Connect(function()
		Anim.tween(stroke, { Thickness = 1.5 }, FAST, "quadOut")
	end))
	maid:give(tile.MouseButton1Click:Connect(function()
		self:scrollToCategory("modeles")
	end))
	return top + cfg.tileH
end

-- Mode le plus compact : « ≡ Catégories ▼ » (menu des catégories) et « ◆ Modèles » ; renvoie le bas
function Palette:_buildCategoryMenuRow(top, cfg)
	local maid = self.headerMaid
	local hasModeles = self:_modelesAvailable()
	local modelesW = 0
	if hasModeles then
		modelesW = 96
	end
	local button = Util.create("TextButton", {
		Name = "MenuCategories",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(cfg.margin, top),
		Size = UDim2.new(1, -(2 * cfg.margin + (modelesW > 0 and modelesW + 6 or 0)), 0, cfg.rowH),
		Parent = self.frame,
	})
	maid:give(button)
	Util.corner(button, cfg.radius)
	Util.stroke(button, C.ButtonActiveStroke, 1, 0.3)
	self._menuLabel = makeLabel({
		Name = "Texte",
		Text = "≡  Catégories",
		Font = FONT_BOLD,
		TextSize = cfg.textSize,
		TextColor3 = C.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -34, 1, 0),
		Parent = button,
	})
	makeLabel({
		Text = "▼",
		TextSize = 10,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 0),
		Size = UDim2.new(0, 18, 1, 0),
		Parent = button,
	})
	maid:give(Anim.hover(button, C.Button, C.ButtonHover))
	maid:give(button.MouseButton1Click:Connect(function()
		self:_openCategoryMenu(button)
	end))
	if hasModeles then
		local accent = C.ModelesAccent or MODELES_ACCENT
		local modeles = Util.create("TextButton", {
			Name = "Modeles",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Button,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -cfg.margin, 0, top),
			Size = UDim2.fromOffset(modelesW, cfg.rowH),
			Parent = self.frame,
		})
		maid:give(modeles)
		Util.corner(modeles, cfg.radius)
		Util.stroke(modeles, accent, 1.5, 0)
		makeLabel({
			Text = "◆ Modèles",
			Font = FONT_BOLD,
			TextSize = cfg.textSize,
			TextColor3 = accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = modeles,
		})
		maid:give(Anim.hover(modeles, C.Button, C.ButtonHover))
		maid:give(modeles.MouseButton1Click:Connect(function()
			self:scrollToCategory("modeles")
		end))
	end
	return top + cfg.rowH
end

-- Menu des catégories (mode compact) : favoris, catégories, modèles
function Palette:_openCategoryMenu(button)
	if self._destroyed or not self.dialogs then
		return
	end
	local items = {}
	if self.headerY.favoris then
		table.insert(items, { label = "Favoris", value = "favoris", icon = "●", checked = self.activeCategory == "favoris" })
	end
	for _, cat in ipairs(Registry.categories()) do
		table.insert(items, { label = cat.name, value = cat.id, checked = self.activeCategory == cat.id })
	end
	if self.headerY.modeles then
		table.insert(items, "separator")
		table.insert(items, { label = "Modèles — scripts entiers", value = "modeles", icon = "◆", checked = self.activeCategory == "modeles" })
	end
	local pos = button.AbsolutePosition + Vector2.new(0, button.AbsoluteSize.Y + 2)
	self.dialogs:menu(pos, items, function(value)
		if not self._destroyed and type(value) == "string" then
			self:scrollToCategory(value)
		end
	end)
end

-- Bouton « ≡ Catégories » : nom de la section visible
function Palette:_updateMenuLabel()
	local label = self._menuLabel
	if not label or label.Parent == nil then
		return
	end
	local id = self.activeCategory
	local name = "Catégories"
	if id == "favoris" then
		name = "Favoris"
	elseif id == "modeles" then
		name = "Modèles"
	elseif id ~= nil then
		local ok, cat = pcall(Registry.category, id)
		if ok and type(cat) == "table" and type(cat.name) == "string" then
			name = cat.name
		end
	end
	label.Text = "≡  " .. name
end

-- La taille du cadre a changé : nouvel en-tête si besoin, liste recalculée si la largeur change
function Palette:_scheduleReflow()
	if self._reflowPending or self._destroyed then
		return
	end
	self._reflowPending = true
	task.delay(0.05, function()
		self._reflowPending = false
		if not self._destroyed then
			self:_reflow()
		end
	end)
end

function Palette:_reflow()
	local size = self.frame.AbsoluteSize
	if size.X < 60 or size.Y < 60 then
		return
	end
	local mode = self:_chooseHeaderMode(size.X, size.Y)
	local widthChanged = math.abs(size.X - (self._layoutWidth or 0)) >= 2
	if mode ~= self._headerMode or widthChanged then
		self:_layoutHeader(mode)
	end
	if widthChanged then
		self._layoutWidth = size.X
		self:_rebuild(false)
	end
end

---------------------------------------------------------------------------
-- Recherche
---------------------------------------------------------------------------

function Palette:_scheduleSearch()
	self._searchToken += 1
	local token = self._searchToken
	task.delay(SEARCH_DELAY, function()
		if self._destroyed or token ~= self._searchToken then
			return
		end
		self:_applySearch(self.searchBox.Text)
	end)
end

function Palette:_applySearch(text)
	if self._destroyed then
		return
	end
	local q = Util.trim(tostring(text or ""))
	if q == self.query then
		return
	end
	self.query = q
	self:_rebuild(true)
end

---------------------------------------------------------------------------
-- Liste des blocs
---------------------------------------------------------------------------

function Palette:_mouse()
	if self.host and type(self.host.getMousePosition) == "function" then
		local ok, pos = pcall(self.host.getMousePosition)
		if ok and typeof(pos) == "Vector2" then
			return pos
		end
	end
	return self.frame.AbsolutePosition
end

function Palette:_windowHeight()
	local h = self.list.AbsoluteWindowSize.Y
	if h <= 0 then
		h = self.list.AbsoluteSize.Y
	end
	return h
end

function Palette:_clearList()
	for _, view in ipairs(self.views) do
		pcall(function()
			view:destroy()
		end)
	end
	self.views = {}
	self.headerY = {}
	self.sectionItems = {}
	self._currentSection = nil
	self._hoverStates = setmetatable({}, { __mode = "k" })
	self.itemMaid:clean()
	for _, child in ipairs(self.list:GetChildren()) do
		child:Destroy()
	end
end

-- Range un objet de la liste dans la section (catégorie) en cours de construction
function Palette:_registerItem(obj)
	local id = self._currentSection
	if id == nil or obj == nil then
		return
	end
	local list = self.sectionItems[id]
	if list == nil then
		list = {}
		self.sectionItems[id] = list
	end
	table.insert(list, obj)
end

function Palette:_rebuild(resetScroll)
	if self._destroyed then
		return
	end
	local keep = self.list.CanvasPosition
	self:_hoverEnd()
	self:_stopScroll()
	self:_clearList()

	-- Largeur utile de la liste (sans la barre de défilement)
	local frameW = self.frame.AbsoluteSize.X
	if frameW < 100 then
		frameW = Theme.Layout.PanelWidth or 280
	end
	self.listWidth = frameW - SCROLLBAR

	local model = self.getModel()
	local ok, result
	if self.query ~= "" then
		ok, result = pcall(self._buildSearchResults, self, model)
	else
		ok, result = pcall(self._buildFullList, self, model)
	end
	local height = 40
	if ok and type(result) == "number" then
		height = result
	else
		warn("[Blocs FR] Palette : erreur pendant la construction de la liste : " .. tostring(result))
		self.setStatus("Erreur dans la palette : " .. tostring(result), "error")
	end

	self.contentHeight = height
	self.list.CanvasSize = UDim2.fromOffset(0, height)
	if resetScroll then
		self.list.CanvasPosition = Vector2.new(0, 0)
	else
		local maxY = math.max(0, height - self:_windowHeight())
		self.list.CanvasPosition = Vector2.new(0, math.min(keep.Y, maxY))
	end
	self:_updateActiveCategory()
end

function Palette:_renderOpts()
	return {
		interactive = false,
		callbacks = {
			getVariables = function()
				local model = self.getModel()
				return (model and model.variables) or {}
			end,
			openMenu = function() end,
			openColorPicker = function() end,
		},
	}
end

-- Préréglages d'un bloc : ses entrées "variable" reçoivent la première variable du projet
function Palette:_presetsFor(def, variables)
	local presets = {}
	local first = variables and variables[1]
	if first then
		for _, input in ipairs(def.inputs or {}) do
			if input.kind == "variable" then
				presets[input.name] = first
			end
		end
	end
	return presets
end

function Palette:_addHeader(cat, y)
	local header = Util.create("Frame", {
		Name = "Titre_" .. cat.id,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, HEADER_H),
		Parent = self.list,
	})
	local dot = Util.create("Frame", {
		Name = "Pastille",
		BackgroundColor3 = dotColor(cat),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, LIST_X, 0.5, 2),
		Size = UDim2.fromOffset(8, 8),
		Parent = header,
	})
	round(dot)
	-- Titre de section : MAJUSCULES, 12 px, gras, TextSoft (#C9C9CF)
	local title = upperFr(cat.name)
	local titleSize = 12
	local nameWidth = math.ceil(Util.textSize(title, titleSize, FONT_BOLD).X)
	makeLabel({
		Name = "Nom",
		Text = title,
		Font = FONT_BOLD,
		TextSize = titleSize,
		TextColor3 = C.TextSoft,
		Position = UDim2.fromOffset(LIST_X + 15, 4),
		Size = UDim2.new(0, nameWidth + 4, 1, -4),
		Parent = header,
	})
	-- petite ligne décorative après le titre
	local lineX = LIST_X + 15 + nameWidth + 12
	if lineX < self.listWidth - 30 then
		Util.create("Frame", {
			Name = "Ligne",
			BackgroundColor3 = C.PanelBorder,
			BorderSizePixel = 0,
			Position = UDim2.new(0, lineX, 0.5, 2),
			Size = UDim2.new(0, self.listWidth - lineX - LIST_X, 0, 1),
			Parent = header,
		})
	end
	return y + HEADER_H
end

function Palette:_addHint(text, y)
	local hint = makeLabel({
		Name = "Indication",
		Text = text,
		TextSize = Theme.TextSize.Small,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(LIST_X, y),
		Size = UDim2.fromOffset(self.listWidth - 2 * LIST_X, 30),
		Parent = self.list,
	})
	self:_registerItem(hint)
	return y + 30
end

-- Ajoute un bloc (prototype non interactif) dans la liste ; renvoie le Y suivant.
-- opts = { variable = nom } pour les blocs « valeur de variable »
function Palette:_addBlock(def, presets, y, mode, opts)
	opts = opts or {}
	local home = UDim2.fromOffset(LIST_X, y) -- position de repos (le survol décale de 4 px)
	local holder = Util.create("Frame", {
		Name = def.id,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = home,
		Size = UDim2.fromOffset(10, 10),
		Parent = self.list,
	})
	self:_registerItem(holder)

	local view = nil
	local w, h
	local ok, result = pcall(Renderer.renderPrototype, def.id, presets, holder, self:_renderOpts())
	if ok and type(result) == "table" and typeof(result.frame) == "Instance" then
		view = result
		table.insert(self.views, view)
		w = tonumber(view.width) or view.frame.AbsoluteSize.X
		h = tonumber(view.height) or view.frame.AbsoluteSize.Y
	else
		-- Repli : simple étiquette colorée (le bloc reste utilisable)
		warn("[Blocs FR] Palette : impossible de dessiner « " .. tostring(def.id) .. " » : " .. tostring(result))
		local text = Registry.plainLabel(def)
		if opts.variable then
			text = opts.variable
		end
		w = math.ceil(Util.textSize(text, Theme.TextSize.Block, Theme.Fonts.Block).X) + 22
		h = 32
		local fallback = Util.create("Frame", {
			Name = "Repli",
			BackgroundColor3 = Registry.color(def),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(w, h),
			Parent = holder,
		})
		Util.corner(fallback, 6)
		makeLabel({
			Text = text,
			Font = Theme.Fonts.Block,
			TextSize = Theme.TextSize.Block,
			Position = UDim2.fromOffset(11, 0),
			Size = UDim2.new(1, -22, 1, 0),
			Parent = fallback,
		})
	end
	w = math.max(10, math.ceil(w or 10))
	h = math.max(10, math.ceil(h or 10))
	-- Bloc plus large que la palette : on le réduit (jusqu'à 60 %) pour qu'il reste lisible en entier
	local scale = 1
	local available = (tonumber(self.listWidth) or 0) - 2 * LIST_X - 4
	if view and w > available and available > 40 then
		scale = math.max(0.6, available / w)
		Util.create("UIScale", { Scale = scale, Parent = view.frame })
		w = math.ceil(w * scale)
		h = math.ceil(h * scale)
	end
	-- la languette d'un bloc instruction dépasse sous le bloc : le cadre la couvre aussi (le voile de
	-- l'arrivée en cascade la cache avec le bloc) ; l'espacement de la liste ne change pas
	local tabExtra = 0
	local shape = def.shape
	if shape ~= "reporter" and shape ~= "boolean" and shape ~= "cap" and def.noNext ~= true then
		tabExtra = math.ceil((Theme.Block.NotchHeight or 5) * scale)
	end
	holder.Size = UDim2.fromOffset(w, h + tabExtra)

	-- Bloc réservé à un autre type de script : étiquette « serveur » / « local » / « module », et estompé
	-- (sauf les blocs serveur / local dans un script module, voir isDimmed)
	local tagText = scriptTag(def, mode)
	local note = scriptNote(def, mode)
	if tagText then
		if isDimmed(def, mode) then
			pcall(dimGui, holder)
		end
		local tagSize = 10
		local tagW = math.ceil(Util.textSize(tagText, tagSize, FONT_BOLD).X) + 14
		local maxX = self.listWidth - 2 * LIST_X - tagW
		local tagX = math.max(0, math.min(w + 6, maxX))
		local tag = Util.create("Frame", {
			Name = "Etiquette",
			BackgroundColor3 = C.Background,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(tagX, math.max(0, math.floor((h - 18) / 2))),
			Size = UDim2.fromOffset(tagW, 18),
			ZIndex = 45,
			Parent = holder,
		})
		round(tag)
		Util.stroke(tag, C.PanelBorder, 1)
		makeLabel({
			Text = tagText,
			Font = FONT_BOLD,
			TextSize = tagSize,
			TextColor3 = C.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 45,
			Parent = tag,
		})
	end

	-- Zone invisible au-dessus du bloc : reçoit appui, survol et clic droit
	local hit = Util.create("TextButton", {
		Name = "Zone",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = holder,
	})
	self.itemMaid:give(hit.MouseEnter:Connect(function()
		self:_hoverStart(def, note, opts.variable)
		self:_hoverLook(holder, home, true)
	end))
	self.itemMaid:give(hit.MouseLeave:Connect(function()
		self:_hoverEnd()
		self:_hoverLook(holder, home, false)
	end))
	self.itemMaid:give(hit.MouseButton1Down:Connect(function()
		self:_startDrag(def, presets, view, holder, scale)
	end))
	self.itemMaid:give(hit.MouseButton2Click:Connect(function()
		self:_contextMenu(def, opts.variable, note, presets)
	end))

	return y + h + ITEM_GAP
end

function Palette:_addVariablesSection(model, cat, y, mode)
	local buttonW = self.listWidth - 2 * LIST_X
	local button = Util.create("TextButton", {
		Name = "CreerVariable",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(LIST_X, y),
		Size = UDim2.fromOffset(buttonW, 32),
		Parent = self.list,
	})
	Util.corner(button, 7)
	Util.stroke(button, dotColor(cat), 1, 0.4)
	makeLabel({
		Text = "＋ Créer une variable",
		Font = FONT_BOLD,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	self:_registerItem(button)
	self.itemMaid:give(Anim.hover(button, C.Button, C.ButtonHover))
	self.itemMaid:give(button.MouseButton1Click:Connect(function()
		self:_createVariable()
	end))
	y += 32 + 10

	local variables = (model and model.variables) or {}
	if #variables == 0 then
		y = self:_addHint("Aucune variable pour l'instant : crée-en une pour compter des points, des vies…", y)
	else
		local valueDef = Registry.get("var_valeur")
		if valueDef then
			local inputName = variableInputName(valueDef) or "VAR"
			for _, name in ipairs(variables) do
				local presets = {}
				presets[inputName] = name
				y = self:_addBlock(valueDef, presets, y, mode, { variable = name })
			end
			y += 4
		end
	end
	return y
end

-- Blocs favoris (réglage palette.favoris), dans l'ordre où ils ont été ajoutés
function Palette:_favoriteDefs()
	local s = currentSettings()
	local out = {}
	if not s or type(s.palette) ~= "table" or type(s.palette.favoris) ~= "table" then
		return out
	end
	local seen = {}
	for _, id in ipairs(s.palette.favoris) do
		if type(id) == "string" and not seen[id] then
			seen[id] = true
			local def = Registry.get(id)
			if def and not def.hidden then
				table.insert(out, def)
			end
		end
	end
	return out
end

-- Liste complète : FAVORIS, un titre par catégorie puis ses blocs, MODÈLES. Renvoie la hauteur totale.
function Palette:_buildFullList(model)
	local mode = (model and model.mode) or "server"
	local variables = (model and model.variables) or {}
	local beginner = isBeginner()
	local y = 6
	local favorites = self:_favoriteDefs()
	if #favorites > 0 then
		self.headerY.favoris = y
		y = self:_addHeader({ id = "favoris", name = "Favoris", dot = FAVORIS_DOT }, y)
		self._currentSection = "favoris"
		for _, def in ipairs(favorites) do
			y = self:_addBlock(def, self:_presetsFor(def, variables), y, mode)
		end
		self._currentSection = nil
		y += 6
	end
	for _, cat in ipairs(Registry.categories()) do
		self.headerY[cat.id] = y
		y = self:_addHeader(cat, y)
		self._currentSection = cat.id -- objets qui arriveront en cascade au clic sur la catégorie
		if cat.id == "variables" then
			y = self:_addVariablesSection(model, cat, y, mode)
		end
		local defs = Registry.list(cat.id)
		local hiddenCount = 0
		if beginner then
			defs, hiddenCount = beginnerFilter(cat.id, defs)
		end
		for _, def in ipairs(defs) do
			y = self:_addBlock(def, self:_presetsFor(def, variables), y, mode)
		end
		if hiddenCount > 0 then
			local text = "Mode débutant : " .. hiddenCount .. " autre(s) bloc(s) caché(s) (Paramètres → Palette)."
			if #defs == 0 then
				text = "Mode débutant : cette catégorie est cachée (Paramètres → Palette)."
			end
			y = self:_addHint(text, y)
		elseif #defs == 0 and cat.id ~= "variables" then
			y = self:_addHint("Aucun bloc dans cette catégorie.", y)
		end
		self._currentSection = nil
		y += 6
	end
	if self:_modelesAvailable() then
		local ok, result = pcall(self._addModelesSection, self, y)
		if ok and type(result) == "number" then
			y = result
		else
			warn("[Blocs FR] Palette : modèles impossibles à afficher : " .. tostring(result))
		end
	end
	return y + 12
end

-- Section MODÈLES (SPEC §22.2) : cartes en 2 colonnes. Renvoie le Y suivant.
function Palette:_addModelesSection(y)
	local Modeles = optionalModule("Modeles")
	if not Modeles or type(Modeles.list) ~= "function" then
		return y
	end
	local ok, list = pcall(Modeles.list)
	if not ok or type(list) ~= "table" or #list == 0 then
		return y
	end
	self.headerY.modeles = y
	y = self:_addHeader({ id = "modeles", name = "Modèles", dot = C.ModelesAccent or MODELES_ACCENT }, y)
	self._currentSection = "modeles"
	y = self:_addHint("Des scripts entiers prêts à poser : glisse une carte dans la zone de travail, ou clique dessus.", y)
	y += 4
	local cols = 2
	if self.listWidth < 210 then
		cols = 1
	end
	local gap = 8
	local cardW = math.floor((self.listWidth - 2 * LIST_X - (cols - 1) * gap) / cols)
	local count = 0
	for _, entry in ipairs(list) do
		if type(entry) == "table" and entry.id ~= nil then
			local col = count % cols
			local row = math.floor(count / cols)
			self:_addModeleCard(entry, LIST_X + col * (cardW + gap), y + row * (MODELE_CARD_H + gap), cardW, MODELE_CARD_H)
			count += 1
		end
	end
	local rows = math.ceil(count / cols)
	y += rows * MODELE_CARD_H + math.max(0, rows - 1) * gap + 8
	self._currentSection = nil
	return y
end

-- Une carte de modèle : mini-barres aux couleurs des premiers blocs, titre, « n blocs · serveur »
function Palette:_addModeleCard(entry, x, y, w, h)
	local accent = C.ModelesAccent or MODELES_ACCENT
	local card = Util.create("TextButton", {
		Name = "Modele_" .. tostring(entry.id),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Parent = self.list,
	})
	Util.corner(card, 10)
	local stroke = Util.stroke(card, C.PopupBorder or C.PanelBorder, 1, 0)
	self:_registerItem(card)

	local preview = Util.create("Frame", {
		Name = "Apercu",
		BackgroundColor3 = Color3.fromRGB(23, 23, 26),
		BorderSizePixel = 0,
		Active = false,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, MODELE_PREVIEW_H),
		Parent = card,
	})
	Util.corner(preview, 7)
	local colors = {}
	if type(entry.colors) == "table" then
		for _, c in ipairs(entry.colors) do
			if typeof(c) == "Color3" then
				table.insert(colors, c)
			elseif type(c) == "table" then
				table.insert(colors, Util.rgbToColor3(c))
			end
			if #colors >= 4 then
				break
			end
		end
	end
	if #colors == 0 then
		colors = { accent }
	end
	local widths = { 0.72, 0.84, 0.58, 0.68 }
	local by = 5
	for i, color in ipairs(colors) do
		local bh = 8
		local radius = 2
		if i == 1 then
			bh = 10
			radius = 5
		end
		local bar = Util.create("Frame", {
			Name = "Barre",
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(7, by),
			Size = UDim2.new(widths[i] or 0.6, -10, 0, bh),
			Parent = preview,
		})
		Util.corner(bar, radius)
		by += bh + 2
	end

	makeLabel({
		Name = "Titre",
		Text = tostring(entry.title or entry.id),
		Font = FONT_BOLD,
		TextSize = 12,
		TextColor3 = C.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(9, 8 + MODELE_PREVIEW_H + 6),
		Size = UDim2.new(1, -18, 0, 16),
		Parent = card,
	})
	local count = tonumber(entry.count)
	local sub = modeText(entry.mode)
	if count then
		local n = math.floor(count)
		sub = n .. " bloc" .. (n > 1 and "s" or "") .. " · " .. sub
	end
	-- modèle d'écran (Modeles : champ ecran) : le petit mot du board (« écran + 3 boutons »)
	if isScreenModele(entry) and type(entry.tag) == "string" and entry.tag ~= "" then
		sub = entry.tag
	end
	makeLabel({
		Name = "Detail",
		Text = sub,
		TextSize = Theme.TextSize.Small or 11,
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(9, 8 + MODELE_PREVIEW_H + 24),
		Size = UDim2.new(1, -18, 0, 14),
		Parent = card,
	})

	local description = tostring(entry.description or "")
	local howTo = "\nGlisse la carte dans la zone de travail (ou clique dessus)."
	if isScreenModele(entry) then
		howTo = "\nClique sur la carte (ou glisse-la) : l'écran s'ouvre dans le Studio d'interface."
	end
	self.itemMaid:give(card.MouseEnter:Connect(function()
		Anim.tween(card, { BackgroundColor3 = C.ButtonHover }, FAST, "quadOut")
		Anim.tween(stroke, { Color = accent }, FAST, "quadOut")
		if description ~= "" then
			self:_hoverStartText(description .. howTo)
		end
	end))
	self.itemMaid:give(card.MouseLeave:Connect(function()
		Anim.tween(card, { BackgroundColor3 = C.PanelAlt }, FAST, "quadOut")
		Anim.tween(stroke, { Color = C.PopupBorder or C.PanelBorder }, FAST, "quadOut")
		self:_hoverEnd()
	end))
	self.itemMaid:give(card.MouseButton1Down:Connect(function()
		self:_startModeleDrag(entry, card)
	end))
	self.itemMaid:give(card.MouseButton2Click:Connect(function()
		self:_modeleMenu(entry)
	end))
	return card
end

function Palette:_insertModele(id, screenPos)
	local fn = self.deps.insertModele
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, id, screenPos)
	if not ok then
		warn("[Blocs FR] Palette : " .. tostring(err))
		self.setStatus("Impossible d'ajouter ce modèle : " .. tostring(err), "error")
	end
end

-- Appui sur une carte : glisser-déposer vers la zone de travail (canvas:beginGhostDrag) ; un simple
-- clic ajoute le modèle au centre de la partie visible
function Palette:_startModeleDrag(entry, card)
	self:_hoverEnd()
	local canvas = self.canvas
	if canvas and type(canvas.beginGhostDrag) == "function" then
		local okClone, visual = pcall(function()
			return card:Clone()
		end)
		if okClone and typeof(visual) == "Instance" then
			local grab = self:_mouse() - card.AbsolutePosition
			local okStart, started = pcall(canvas.beginGhostDrag, canvas, {
				visual = visual,
				grab = grab,
				onDrop = function(p, how)
					if how == "clic" then
						self:_insertModele(entry.id, nil)
					elseif how == "depose" then
						self:_insertModele(entry.id, p)
					end
				end,
			})
			if okStart and started then
				return
			end
			pcall(function()
				visual:Destroy()
			end)
		end
	end
	-- (sans glisser-déposer possible : ajout au centre)
	self:_insertModele(entry.id, nil)
end

-- Menu du clic droit d'une carte de modèle
function Palette:_modeleMenu(entry)
	self:_hoverEnd()
	if not self.dialogs then
		return
	end
	local addLabel = "Ajouter à la zone de travail"
	if isScreenModele(entry) then
		addLabel = "Ouvrir dans le Studio d'interface"
	end
	local items = {
		{ label = addLabel, value = "ajouter", icon = "＋" },
		{ label = "Description du modèle", value = "description", disabled = tostring(entry.description or "") == "" },
	}
	self.dialogs:menu(self:_mouse(), items, function(value)
		if self._destroyed then
			return
		end
		if value == "ajouter" then
			self:_insertModele(entry.id, nil)
		elseif value == "description" then
			self.dialogs:alert(tostring(entry.title or entry.id), tostring(entry.description or ""))
		end
	end)
end

-- Résultats de recherche (insensible aux accents). Renvoie la hauteur totale.
function Palette:_buildSearchResults(model)
	local mode = (model and model.mode) or "server"
	local variables = (model and model.variables) or {}
	local query = self.query
	local results = Registry.search(query)

	-- Les variables du projet dont le nom correspond
	local folded = Util.fold(query)
	local matchingVariables = {}
	for _, name in ipairs(variables) do
		if string.find(Util.fold(tostring(name)), folded, 1, true) then
			table.insert(matchingVariables, name)
		end
	end

	local y = 8
	local total = #results + #matchingVariables
	if total == 0 then
		makeLabel({
			Text = "Aucun bloc trouvé",
			Font = FONT_BOLD,
			TextColor3 = C.TextSoft,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, y + 16),
			Size = UDim2.fromOffset(self.listWidth, 20),
			Parent = self.list,
		})
		makeLabel({
			Text = "Essaie un autre mot, par exemple : toucher, couleur, joueur, attendre.",
			TextSize = Theme.TextSize.Small,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(LIST_X, y + 40),
			Size = UDim2.fromOffset(self.listWidth - 2 * LIST_X, 34),
			Parent = self.list,
		})
		return y + 90
	end

	local countText = total .. " résultat"
	if total > 1 then
		countText = countText .. "s"
	end
	countText = countText .. " pour « " .. query .. " »"
	makeLabel({
		Text = countText,
		TextSize = Theme.TextSize.Small,
		TextColor3 = C.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(LIST_X, y),
		Size = UDim2.fromOffset(self.listWidth - 2 * LIST_X, 18),
		Parent = self.list,
	})
	y += 26

	if #matchingVariables > 0 then
		local valueDef = Registry.get("var_valeur")
		if valueDef then
			local inputName = variableInputName(valueDef) or "VAR"
			for _, name in ipairs(matchingVariables) do
				local presets = {}
				presets[inputName] = name
				y = self:_addBlock(valueDef, presets, y, mode, { variable = name })
			end
		end
	end
	for _, def in ipairs(results) do
		y = self:_addBlock(def, self:_presetsFor(def, variables), y, mode)
	end
	return y + 12
end

---------------------------------------------------------------------------
-- Interactions
---------------------------------------------------------------------------

-- note : remarque sur le type de script (scriptNote) ou nil
local function tooltipText(def, note, variableName)
	local text = tostring(def.tooltip or "")
	if variableName then
		text = "Valeur de la variable « " .. variableName .. " ». Clic droit pour la renommer ou la supprimer."
	end
	if type(note) == "string" and note ~= "" then
		if text ~= "" then
			text = text .. "\n" .. note
		else
			text = note
		end
	end
	return text
end

function Palette:_hoverStart(def, note, variableName)
	self:_hoverStartText(tooltipText(def, note, variableName))
end

-- Info-bulle après un court instant de survol
function Palette:_hoverStartText(text)
	self._hoverToken += 1
	local token = self._hoverToken
	task.delay(TOOLTIP_DELAY, function()
		if self._destroyed or token ~= self._hoverToken or not self.dialogs then
			return
		end
		if type(text) ~= "string" or text == "" then
			return
		end
		self.dialogs:tooltip(text, self:_mouse())
		self._tooltipShown = true
	end)
end

function Palette:_hoverEnd()
	self._hoverToken += 1
	if self._tooltipShown then
		self._tooltipShown = false
		if self.dialogs then
			self.dialogs:hideTooltip()
		end
	end
end

-- Survol d'un bloc de la liste : il glisse de 4 px et s'éclaircit (on = false : retour au repos).
-- home = position de repos du bloc.
function Palette:_hoverLook(holder, home, on)
	if self._destroyed or holder.Parent == nil then
		return
	end
	local target = home
	if on then
		target = home + UDim2.fromOffset(HOVER_SHIFT, 0)
	end
	Anim.tween(holder, { Position = target }, FAST, "quadOut")
	local st = self._hoverStates[holder]
	if st == nil then
		if not on then
			return
		end
		st = { k = 0, entries = hoverEntries(holder) }
		self._hoverStates[holder] = st
	end
	local from = st.k
	local to = 0
	if on then
		to = 1
	end
	-- une seule animation d'éclaircissement par bloc (clé = le bloc) : la nouvelle remplace l'ancienne
	Anim.step(function(k)
		st.k = from + (to - from) * k
		local amount = HOVER_LIGHTEN * st.k
		for _, e in ipairs(st.entries) do
			local inst = e[1]
			if inst.Parent ~= nil then
				inst.BackgroundColor3 = e[2]:Lerp(WHITE, amount)
			end
		end
	end, FAST, "quadOut", nil, holder)
end

function Palette:_startDrag(def, presets, view, holder, scale)
	self:_hoverEnd()
	if not self.canvas then
		return
	end
	local mouse = self:_mouse()
	local origin = holder.AbsolutePosition
	if view and view.frame and view.frame.Parent then
		origin = view.frame.AbsolutePosition
	end
	-- décalage exprimé à l'échelle 1 (le canvas le multiplie par son zoom)
	local s = tonumber(scale) or 1
	if s <= 0 then
		s = 1
	end
	local grabOffset = (mouse - origin) / s
	local ok, err = pcall(function()
		self.canvas:beginPaletteDrag(def.id, Util.deepCopy(presets or {}), grabOffset)
	end)
	if not ok then
		warn("[Blocs FR] Palette : " .. tostring(err))
		self.setStatus("Impossible de prendre ce bloc : " .. tostring(err), "error")
	end
end

-- Aide rapide sur un bloc : une fenêtre avec son explication (le wiki a sa propre ligne de menu)
function Palette:_showHelp(def, variableName, note)
	if not self.dialogs then
		return
	end
	local title = Registry.plainLabel(def)
	if variableName then
		title = "Variable « " .. variableName .. " »"
	end
	local text = tooltipText(def, note, variableName)
	if text == "" then
		text = "Pas d'explication disponible pour ce bloc."
	end
	text = text .. "\n\nGlisse ce bloc dans la zone de travail pour l'utiliser. Pour tout savoir sur lui : clic droit → « Ouvrir dans le wiki »."
	self.dialogs:alert(title, text)
end

-- « Ouvrir dans le wiki » : deps.openWiki(defId), sinon deps.openHelp(defId), sinon host.openWiki
function Palette:_openWiki(defId)
	local fn = self.deps.openWiki
	if type(fn) == "function" then
		local ok = pcall(fn, defId)
		if ok then
			return
		end
	end
	if type(self.deps.openHelp) == "function" then
		local ok = pcall(self.deps.openHelp, defId)
		if ok then
			return
		end
	end
	local hostOpen = self.host and self.host.openWiki
	if type(hostOpen) == "function" then
		local ok, shown = pcall(hostOpen, nil, defId)
		if ok and shown ~= false then
			return
		end
	end
	self.setStatus("Le wiki n'est pas disponible pour le moment.", "warning")
end

-- Favoris (SPEC §32) : deps.isFavorite / deps.toggleFavorite, sinon Reglages
function Palette:_isFavorite(defId)
	local fn = self.deps.isFavorite
	if type(fn) == "function" then
		local ok, yes = pcall(fn, defId)
		if ok then
			return yes == true
		end
	end
	local Reglages = optionalModule("Reglages")
	if Reglages and type(Reglages.isFavorite) == "function" then
		local ok, yes = pcall(Reglages.isFavorite, defId)
		if ok then
			return yes == true
		end
	end
	return false
end

function Palette:_canFavorite()
	if type(self.deps.toggleFavorite) == "function" then
		return true
	end
	local Reglages = optionalModule("Reglages")
	return Reglages ~= nil and type(Reglages.toggleFavorite) == "function"
end

function Palette:_toggleFavorite(defId)
	local was = self:_isFavorite(defId)
	local ok = false
	if type(self.deps.toggleFavorite) == "function" then
		ok = pcall(self.deps.toggleFavorite, defId)
	else
		local Reglages = optionalModule("Reglages")
		if Reglages and type(Reglages.toggleFavorite) == "function" then
			ok = pcall(Reglages.toggleFavorite, self.host, defId)
		end
	end
	if not ok then
		self.setStatus("Impossible de changer les favoris.", "error")
		return
	end
	-- (Reglages.Changed redessine aussi la liste ; on le fait tout de suite au cas où)
	self:refresh(true)
	if self.dialogs then
		if was then
			self.dialogs:toast("Retiré des favoris", "info")
		else
			self.dialogs:toast("Ajouté aux favoris : il est en haut de la palette", "success")
		end
	end
end

-- Menu du clic droit d'un bloc de la palette (SPEC §33)
function Palette:_contextMenu(def, variableName, note, presets)
	self:_hoverEnd()
	if not self.dialogs then
		return
	end
	local canvas = self.canvas
	local canAdd = canvas ~= nil and type(canvas.addBlockAtCenter) == "function"
	local favorite = self:_isFavorite(def.id)
	-- projet affiché à l'ouverture du menu : « Renommer » / « Supprimer la variable » visent lui seul
	local model = self.getModel()
	local items = {
		{ label = "Ajouter à la zone de travail", value = "add", icon = "＋", hidden = not canAdd },
		{
			label = favorite and "Retirer des favoris" or "Ajouter aux favoris",
			value = "favorite",
			icon = "●",
			hidden = not self:_canFavorite(),
		},
		{ label = "Ouvrir dans le wiki", value = "wiki", icon = "≡" },
		{ label = "Aide sur ce bloc", value = "help" },
	}
	if variableName then
		table.insert(items, "separator")
		table.insert(items, { label = "Renommer la variable", value = "rename" })
		table.insert(items, { label = "Supprimer la variable", value = "delete", icon = "×", danger = true })
	end
	self.dialogs:menu(self:_mouse(), items, function(value)
		if self._destroyed then
			return
		end
		if value == "add" then
			local ok, err = pcall(canvas.addBlockAtCenter, canvas, def.id, Util.deepCopy(presets or {}))
			if not ok then
				warn("[Blocs FR] Palette : " .. tostring(err))
				self.setStatus("Impossible d'ajouter ce bloc : " .. tostring(err), "error")
			end
		elseif value == "favorite" then
			self:_toggleFavorite(def.id)
		elseif value == "wiki" then
			self:_openWiki(def.id)
		elseif value == "rename" then
			self:_renameVariable(variableName, model)
		elseif value == "delete" then
			self:_deleteVariable(variableName, model)
		elseif value == "help" then
			self:_showHelp(def, variableName, note)
		end
	end)
end

-- Appelle une méthode du modèle sans jamais faire planter la palette ; renvoie ok, err
-- (addVariable / renameVariable renvoient ok, errFR ; removeVariable renvoie un nombre)
local function callModel(model, method, ...)
	local args = table.pack(...)
	local okCall, ok, err = pcall(function()
		return model[method](model, table.unpack(args, 1, args.n))
	end)
	if not okCall then
		return false, tostring(ok)
	end
	if ok == nil then
		return err == nil, err
	end
	return ok ~= false, err
end

-- Une fenêtre (menu, question) ouverte sur un projet ne modifie jamais un autre projet chargé entre-temps
-- (autre script choisi dans l'Explorateur, autre onglet, autre écran) : renvoie true s'il faut abandonner
-- (comme Canvas : self.getModel() ~= model), la barre d'état dit pourquoi
function Palette:_projectChanged(model)
	if self._destroyed or model == nil then
		return true
	end
	if self.getModel() == model then
		return false
	end
	self.setStatus("Un autre projet a été ouvert entre-temps : rien n'a été modifié.", "warning")
	return true
end

function Palette:_createVariable()
	if not self.dialogs then
		return
	end
	-- projet visé : celui affiché à l'ouverture de la question (pas celui chargé au moment du clic)
	local model = self.getModel()
	if not model then
		return
	end
	self.dialogs:prompt(
		"Nouvelle variable",
		"Nom de la nouvelle variable (par exemple : score, vies, compteur) :",
		"",
		function(text)
			local name = Util.trim(tostring(text or ""))
			if name == "" then
				return
			end
			if self:_projectChanged(model) then
				return
			end
			local ok, err = callModel(model, "addVariable", name)
			if ok then
				model:commit("variables")
				self.setStatus("Variable « " .. name .. " » créée.", "success")
			else
				self.dialogs:toast(err or "Nom de variable invalide.", "error")
			end
		end
	)
end

-- model (facultatif) : projet affiché à l'ouverture du menu ; par défaut celui affiché maintenant
function Palette:_renameVariable(oldName, model)
	if not self.dialogs or not oldName then
		return
	end
	model = model or self.getModel()
	if self:_projectChanged(model) then
		return
	end
	self.dialogs:prompt(
		"Renommer la variable",
		"Nouveau nom pour la variable « " .. oldName .. " » :",
		oldName,
		function(text)
			local newName = Util.trim(tostring(text or ""))
			if newName == "" or newName == oldName then
				return
			end
			if self:_projectChanged(model) then
				return
			end
			local ok, err = callModel(model, "renameVariable", oldName, newName)
			if ok then
				model:commit("variables")
				self.setStatus("Variable « " .. oldName .. " » renommée en « " .. newName .. " ».", "success")
			else
				self.dialogs:toast(err or "Impossible de renommer cette variable.", "error")
			end
		end
	)
end

-- model (facultatif) : projet affiché à l'ouverture du menu ; par défaut celui affiché maintenant.
-- Le message (nombre de blocs) et la suppression portent sur ce projet seul.
function Palette:_deleteVariable(name, model)
	if not self.dialogs or not name then
		return
	end
	model = model or self.getModel()
	if self:_projectChanged(model) then
		return
	end
	-- Nombre de blocs qui utilisent la variable (ils seront supprimés avec elle)
	local uses = 0
	if type(model.countVariableUses) == "function" then
		pcall(function()
			uses = tonumber(model:countVariableUses(name)) or 0
		end)
	end
	local message = "Supprimer la variable « " .. name .. " » ?"
	if uses == 1 then
		message = message .. "\nLe bloc qui l'utilise sera aussi supprimé."
	elseif uses > 1 then
		message = message .. "\nLes " .. uses .. " blocs qui l'utilisent seront aussi supprimés."
	else
		message = message .. "\nAucun bloc ne l'utilise."
	end
	self.dialogs:confirm(
		"Supprimer la variable",
		message,
		function()
			if self:_projectChanged(model) then
				return
			end
			local ok, err = callModel(model, "removeVariable", name)
			if ok then
				model:commit("variables")
				self.setStatus("Variable « " .. name .. " » supprimée.", "info")
			else
				self.dialogs:toast(err or "Impossible de supprimer cette variable.", "error")
			end
		end,
		"Supprimer",
		"Annuler"
	)
end

---------------------------------------------------------------------------
-- Catégorie active
---------------------------------------------------------------------------

-- Apparence d'un bouton de catégorie : sélectionnée = fond ButtonActive + contour + barre colorée ;
-- survol = ButtonHover (couleurs animées en 0,12 s, barre en 0,22 s)
function Palette:_applyCategoryLook(id)
	local entry = self.categoryButtons[id]
	if not entry then
		return
	end
	local selected = self.activeCategory == id
	entry.stroke.Enabled = selected
	local background = C.Button
	if selected then
		background = C.ButtonActive
		entry.label.TextColor3 = C.Text
		entry.label.Font = FONT_BOLD
	elseif entry.hovered then
		background = C.ButtonHover
		entry.label.TextColor3 = C.Text
		entry.label.Font = FONT
	else
		entry.label.TextColor3 = C.TextSoft
		entry.label.Font = FONT
	end
	Anim.tween(entry.button, { BackgroundColor3 = background }, FAST, "quadOut")
	if entry.accent then
		local w = 0
		if selected then
			w = ACCENT_W
		end
		Anim.tween(entry.accent, { Size = UDim2.fromOffset(w, entry.accentH) }, (Theme.Anim and Theme.Anim.Normal) or 0.22, "quintOut")
	end
end

function Palette:_setActiveCategory(id)
	if self.activeCategory == id then
		return
	end
	self.activeCategory = id
	for cid in pairs(self.categoryButtons) do
		self:_applyCategoryLook(cid)
	end
	self:_updateMenuLabel()
end

function Palette:_updateActiveCategory()
	if self._tweening then
		return
	end
	if self.query ~= "" then
		self:_setActiveCategory(nil)
		return
	end
	local pos = self.list.CanvasPosition.Y + 12
	local best, bestY = nil, -1
	for id, y in pairs(self.headerY) do
		if y <= pos and y > bestY then
			best = id
			bestY = y
		end
	end
	self:_setActiveCategory(best)
end

---------------------------------------------------------------------------
-- API publique
---------------------------------------------------------------------------

-- Reconstruit la liste si le mode, les variables, les favoris ou le mode débutant ont changé (ou si
-- force = true)
function Palette:refresh(force)
	if self._destroyed then
		return
	end
	local sig = signatureOf(self.getModel()) .. "\n#" .. settingsSignature()
	if not force and sig == self._sig then
		return
	end
	self._sig = sig
	-- (la tuile Modèles peut apparaître quand le module est prêt)
	local size = self.frame.AbsoluteSize
	local mode = self:_chooseHeaderMode(size.X, size.Y)
	if mode ~= self._headerMode then
		self:_layoutHeader(mode)
	end
	self:_rebuild(false)
end

-- Voile de la couleur du panneau posé sur les premiers objets d'une section pendant le défilement :
-- ils n'apparaissent (en cascade) qu'une fois la liste arrivée
function Palette:_coverItems(items)
	local veils = {}
	for i = 1, math.min(#items, 14) do
		local obj = items[i]
		if typeof(obj) == "Instance" and obj.Parent ~= nil then
			local veil = Util.create("Frame", {
				Name = "AnimVoileDefilement",
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				Active = false,
				Position = UDim2.fromOffset(-2, -2),
				Size = UDim2.new(1, 80, 1, 4),
				ZIndex = 1000,
				Parent = obj,
			})
			table.insert(veils, veil)
		end
	end
	return veils
end

local function removeVeils(veils)
	if type(veils) ~= "table" then
		return
	end
	for _, veil in ipairs(veils) do
		pcall(function()
			veil:Destroy()
		end)
	end
end

-- Fait défiler la liste jusqu'au titre de la catégorie (ou de la section « favoris » / « modeles »)
function Palette:scrollToCategory(id)
	if self._destroyed then
		return
	end
	if self.query ~= "" or self.searchBox.Text ~= "" then
		self._searchToken += 1
		self.query = ""
		if self.searchBox.Text ~= "" then
			self.searchBox.Text = ""
		end
		self._searchToken += 1
		self:_rebuild(true)
	end
	local y = self.headerY[id]
	if not y then
		return
	end
	local maxY = math.max(0, self.contentHeight - self:_windowHeight())
	local target = Vector2.new(0, math.floor(Util.clamp(y - 2, 0, maxY)))
	-- les blocs de la section arrivent un par un (70 ms d'écart, glissement de 16 px, voile de la
	-- couleur du panneau qui s'efface : les blocs sont faits de cadres superposés) une fois la liste
	-- arrivée ; pendant le défilement ils restent cachés sous un voile
	local items = self.sectionItems[id]
	local function cascade()
		if items and #items > 0 then
			Anim.stagger(items, 0.07, -16, C.Panel)
		end
	end
	if math.abs(self.list.CanvasPosition.Y - target.Y) < 1 or not Anim.enabled() then
		self:_scrollTo(target)
		cascade()
	else
		self:_scrollTo(target, function()
			removeVeils(self._tempVeils)
			self._tempVeils = nil
			cascade()
		end)
		-- (posés après le départ du défilement : _scrollTo retire les voiles d'un défilement précédent)
		if self._tweening and items and #items > 0 then
			self._tempVeils = self:_coverItems(items)
		end
	end
	self:_setActiveCategory(id)
end

-- Défilement doux de la liste ; pendant ce temps, la catégorie active ne suit pas le défilement.
-- onArrive (facultatif) : appelé quand la liste est arrivée (pas si le défilement est interrompu).
function Palette:_scrollTo(target, onArrive)
	self:_stopScroll()
	local token = self._scrollToken
	self._tweening = true
	local handle = Anim.tween(self.list, { CanvasPosition = target }, SCROLL_TIME, "quintOut", function()
		if self._scrollToken == token then
			self._scrollTween = nil
			self._tweening = false
			if type(onArrive) == "function" and not self._destroyed then
				onArrive()
			end
		end
	end)
	-- (animations désactivées : le défilement est déjà fini, onDone a été appelé)
	if self._scrollToken == token and self._tweening then
		self._scrollTween = handle
	end
end

-- Arrête le défilement animé là où il en est (et retire les voiles de la cascade en attente)
function Palette:_stopScroll()
	self._scrollToken += 1
	local handle = self._scrollTween
	self._scrollTween = nil
	self._tweening = false
	if handle then
		handle:cancel()
	end
	removeVeils(self._tempVeils)
	self._tempVeils = nil
end

-- Indice de suppression (SPEC §24) : la palette rougit pendant qu'une pile glissée passe au-dessus
-- (appelé par le Canvas). Voile rouge très léger + contour rouge de 2 px, en 0,12 s.
function Palette:setDeleteHint(on)
	if self._destroyed or not self.frame then
		return
	end
	on = on == true
	if self._deleteHint == on then
		return
	end
	self._deleteHint = on
	local glow = self._deleteGlow
	if glow == nil or glow.Parent == nil then
		if not on then
			return
		end
		glow = Util.create("Frame", {
			Name = "AnimSuppression",
			BackgroundColor3 = C.Danger,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Position = UDim2.fromOffset(2, 2),
			Size = UDim2.new(1, -4, 1, -4),
			Visible = false,
			ZIndex = 100,
			Parent = self.frame,
		})
		Util.corner(glow, 8)
		self._deleteGlowStroke = Util.stroke(glow, C.Danger, 2, 1)
		self._deleteGlow = glow
	end
	local stroke = self._deleteGlowStroke
	if on then
		glow.Visible = true
		Anim.tween(glow, { BackgroundTransparency = 0.86 }, FAST, "quadOut")
		if stroke then
			Anim.tween(stroke, { Transparency = 0 }, FAST, "quadOut")
		end
	else
		Anim.tween(glow, { BackgroundTransparency = 1 }, FAST, "quadOut", function()
			if not self._deleteHint and glow.Parent ~= nil then
				glow.Visible = false
			end
		end)
		if stroke then
			Anim.tween(stroke, { Transparency = 1 }, FAST, "quadOut")
		end
	end
end

-- La palette change de largeur (App : palette replacée dans la zone « Blocs de l'écran », 230 px, ou
-- revenue dans le panneau de gauche) : nouvelle mise en page dès que son cadre a sa nouvelle taille.
-- (La palette suit de toute façon la taille de son cadre ; la largeur passée sert seulement d'indice.)
function Palette:setWidth(_width)
	if self._destroyed then
		return
	end
	self:_scheduleReflow()
end

-- Vrai si le point écran est au-dessus de la palette (utilisé pour supprimer les blocs déposés)
function Palette:isInside(screenPos)
	if self._destroyed or typeof(screenPos) ~= "Vector2" then
		return false
	end
	return Util.pointInGui(screenPos, self.frame)
end

function Palette:destroy()
	if self._destroyed then
		return
	end
	self:_hoverEnd()
	self:_stopScroll()
	self._destroyed = true
	self._searchToken += 1
	for _, view in ipairs(self.views) do
		pcall(function()
			view:destroy()
		end)
	end
	self.views = {}
	self.itemMaid:clean()
	self.headerMaid:clean()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.connections = {}
	if self.frame then
		self.frame:Destroy()
		self.frame = nil
	end
end

return Palette
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">Registry</string><ProtectedString name="Source"><![CDATA[-- Registry : charge toutes les définitions de blocs (Defs_*.lua), les valide et permet de les retrouver.

local Categories = require(script.Parent.Categories)
local Shared = require(script.Parent.Shared)
local Util = require(script.Parent.Util)

local Registry = {}

local loaded = false
local defsById = {}
local defsList = {} -- tous les blocs, dans l'ordre (catégorie puis fichier)
local defsByCategory = {}
local categoriesById = {}
local helpers = {}
local problems = {}

local VALID_SHAPES = {
	hat = true,
	stack = true,
	c = true,
	c2 = true,
	cap = true,
	reporter = true,
	boolean = true,
}

local VALID_KINDS = {
	number = true,
	text = true,
	any = true,
	boolean = true,
	dropdown = true,
	color = true,
	variable = true,
	gui = true, -- nom d'un écran / élément du Studio d'interface (SPEC §21.6)
}

-- Filtres des entrées « gui » (SPEC §21.6) : écrans, tous les éléments, ou un type d'élément
local GUI_FILTERS = {
	ecran = true,
	element = true,
	bouton = true,
	texte = true,
	barre = true,
	champ = true,
	image = true,
}

local function problem(msg)
	table.insert(problems, msg)
	warn("[Blocs FR] Registre : " .. msg)
end

local function addHelper(name, spec, origin)
	if type(name) ~= "string" or type(spec) ~= "table" then
		problem("aide invalide dans " .. origin)
		return
	end
	if helpers[name] then
		problem("aide en double « " .. name .. " » (" .. origin .. ")")
		return
	end
	if type(spec.code) ~= "string" or not string.find(spec.code, "local function " .. name .. "(", 1, true) then
		problem("l'aide « " .. name .. " » doit définir 'local function " .. name .. "(' (" .. origin .. ")")
	end
	spec.deps = spec.deps or {}
	spec.services = spec.services or {}
	spec.name = name
	helpers[name] = spec
end

local function countPlaceholders(label)
	local seen = {}
	local count = 0
	for n in string.gmatch(label, "%%(%d)") do
		local i = tonumber(n)
		if seen[i] then
			return -1
		end
		seen[i] = true
		count += 1
	end
	for i = 1, count do
		if not seen[i] then
			return -1
		end
	end
	return count
end

local function validateDef(def, origin)
	if type(def) ~= "table" then
		problem("définition non-table dans " .. origin)
		return false
	end
	if type(def.id) ~= "string" or def.id == "" then
		problem("bloc sans id dans " .. origin)
		return false
	end
	if defsById[def.id] then
		problem("id de bloc en double « " .. def.id .. " » (" .. origin .. ")")
		return false
	end
	if not VALID_SHAPES[def.shape] then
		problem("forme invalide pour « " .. def.id .. " » : " .. tostring(def.shape))
		return false
	end
	if type(def.label) ~= "string" then
		problem("libellé manquant pour « " .. def.id .. " »")
		return false
	end
	if type(def.gen) ~= "function" then
		problem("fonction gen manquante pour « " .. def.id .. " »")
		return false
	end
	def.inputs = def.inputs or {}
	local n = countPlaceholders(def.label)
	if n ~= #def.inputs then
		problem("« " .. def.id .. " » : le libellé contient " .. tostring(n) .. " champ(s) %n mais " .. #def.inputs .. " entrée(s)")
		return false
	end
	local names = {}
	for _, input in ipairs(def.inputs) do
		if type(input.name) ~= "string" or names[input.name] then
			problem("« " .. def.id .. " » : nom d'entrée invalide ou en double")
			return false
		end
		names[input.name] = true
		if not VALID_KINDS[input.kind] then
			problem("« " .. def.id .. " » : type d'entrée invalide " .. tostring(input.kind))
			return false
		end
		if input.kind == "dropdown" then
			if type(input.options) ~= "table" or #input.options == 0 then
				problem("« " .. def.id .. " » : liste d'options vide pour " .. input.name)
				return false
			end
			if input.default == nil then
				input.default = input.options[1][2]
			end
		end
		if input.kind == "gui" then
			-- NOTE: sans filtre, l'entrée accepte tous les éléments (« element »)
			if input.filter == nil then
				input.filter = "element"
			end
			if not GUI_FILTERS[input.filter] then
				problem("« " .. def.id .. " » : filtre d'interface invalide « " .. tostring(input.filter) .. " » pour " .. input.name)
				return false
			end
		end
	end
	if def.shape == "c2" and type(def.label2) ~= "string" then
		def.label2 = "sinon"
	end
	def.scriptType = def.scriptType or "both"
	if def.shape == "hat" and def.hatOrder == nil then
		def.hatOrder = 1
	end
	if def.shape == "cap" then
		def.noNext = true
	end
	def.keywords = def.keywords or ""
	def.tooltip = def.tooltip or ""
	return true
end

-- Charge toutes les catégories (idempotent)
function Registry.load()
	if loaded then
		return
	end
	loaded = true

	for name, spec in pairs(Shared.helpers) do
		addHelper(name, spec, "Shared")
	end

	for _, cat in ipairs(Categories) do
		categoriesById[cat.id] = cat
		defsByCategory[cat.id] = {}
		local moduleScript = script.Parent:FindFirstChild(cat.module)
		if not moduleScript then
			problem("module manquant : " .. cat.module)
			continue
		end
		local ok, data = pcall(require, moduleScript)
		if not ok then
			problem("erreur au chargement de " .. cat.module .. " : " .. tostring(data))
			continue
		end
		if type(data) ~= "table" or type(data.blocks) ~= "table" then
			problem(cat.module .. " doit renvoyer { category = ..., blocks = {...}, helpers = {...} }")
			continue
		end
		for name, spec in pairs(data.helpers or {}) do
			addHelper(name, spec, cat.module)
		end
		for _, def in ipairs(data.blocks) do
			if validateDef(def, cat.module) then
				def.category = def.category or data.category or cat.id
				if not categoriesById[def.category] then
					def.category = cat.id
				end
				defsById[def.id] = def
				table.insert(defsList, def)
				table.insert(defsByCategory[cat.id], def)
			end
		end
	end

	-- Vérifie les dépendances des aides et des options
	for name, spec in pairs(helpers) do
		for _, dep in ipairs(spec.deps) do
			if not helpers[dep] then
				problem("l'aide « " .. name .. " » dépend de « " .. tostring(dep) .. " » qui n'existe pas")
			end
		end
	end
	for _, def in ipairs(defsList) do
		for _, input in ipairs(def.inputs) do
			if input.kind == "dropdown" then
				for _, opt in ipairs(input.options) do
					if opt.helper and not helpers[opt.helper] then
						problem("« " .. def.id .. " » : l'option « " .. tostring(opt[1]) .. " » utilise l'aide inconnue " .. opt.helper)
					end
				end
			end
		end
	end
end

function Registry.get(defId: string)
	Registry.load()
	return defsById[defId]
end

-- Blocs visibles d'une catégorie (sans les blocs "hidden"), dans l'ordre du fichier
function Registry.list(categoryId: string)
	Registry.load()
	local out = {}
	for _, def in ipairs(defsByCategory[categoryId] or {}) do
		if not def.hidden then
			table.insert(out, def)
		end
	end
	return out
end

function Registry.all()
	Registry.load()
	return defsList
end

function Registry.categories()
	return Categories
end

function Registry.category(id: string)
	Registry.load()
	return categoriesById[id]
end

function Registry.color(defOrId)
	Registry.load()
	local def = type(defOrId) == "table" and defOrId or defsById[defOrId]
	local cat = def and categoriesById[def.category]
	return cat and cat.color or Color3.fromRGB(120, 120, 120)
end

function Registry.helper(name: string)
	Registry.load()
	return helpers[name]
end

function Registry.helpers()
	Registry.load()
	return helpers
end

function Registry.inputByName(def, name: string)
	for _, input in ipairs(def.inputs or {}) do
		if input.name == name then
			return input
		end
	end
	return nil
end

-- Libellé sans les champs : "Quand cet objet est touché (délai … s)"
function Registry.plainLabel(def): string
	local text = string.gsub(def.label, "%%%d", "…")
	return text
end

-- Recherche insensible aux accents et aux majuscules. Tous les mots doivent être trouvés.
function Registry.search(query: string)
	Registry.load()
	local words = {}
	for word in string.gmatch(Util.fold(query or ""), "[^%s]+") do
		table.insert(words, word)
	end
	local out = {}
	if #words == 0 then
		return out
	end
	for _, def in ipairs(defsList) do
		if not def.hidden then
			local cat = categoriesById[def.category]
			local haystack = Util.fold(
				Registry.plainLabel(def)
					.. " "
					.. (def.label2 or "")
					.. " "
					.. def.keywords
					.. " "
					.. (cat and cat.name or "")
			)
			local all = true
			for _, word in ipairs(words) do
				if not string.find(haystack, word, 1, true) then
					all = false
					break
				end
			end
			if all then
				table.insert(out, def)
			end
		end
	end
	return out
end

function Registry.problems()
	Registry.load()
	return problems
end

return Registry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">Reglages</string><ProtectedString name="Source"><![CDATA[-- Reglages : les paramètres de Blocs FR (SPEC §31, planche « Options »).
-- « Dans les options on peut personnaliser tout le plugin » : thème, couleur principale, taille de
-- l'interface, style et couleurs des blocs, grille, aimant, palette, animations, code généré, notes,
-- prévisualisation 3D, brouillon automatique, mises à jour.
--
-- API :
--   Reglages.DEFAULTS                     -- valeurs par défaut (table imbriquée, ne pas modifier)
--   Reglages.load(host) -> s              -- lit host.getSetting("BlocsFR_Reglages") (texte JSON), le
--                                         -- fusionne avec DEFAULTS et le vérifie (valeur abîmée -> défaut)
--   Reglages.save(host, s) -> s           -- vérifie, garde comme réglages actuels, écrit le réglage,
--                                         -- déclenche Reglages.Changed(s)
--   Reglages.current() -> s               -- réglages actuels (DEFAULTS tant que rien n'est chargé).
--                                         -- NE PAS modifier cette table : passer par set / save.
--   Reglages.get("blocs.style") -> valeur -- (copie pour les tables)
--   Reglages.Changed                      -- Util.Signal(s) : load, save, set, favoris
--   Reglages.applyToTheme(s)              -- modifie SUR PLACE Theme.Colors / TextSize / Layout / Block /
--                                         -- Canvas / Anim et les couleurs des catégories ; repart toujours
--                                         -- des valeurs d'origine (Theme.Base) : idempotent, et revenir au
--                                         -- thème « Sombre » redonne exactement les couleurs du départ
--   Reglages.export(s) -> texte ; Reglages.import(texte) -> s | nil, erreurFR
-- Extensions (NOTE: en plus de la SPEC) :
--   Reglages.init(host) -> s              -- load + applyToTheme (au démarrage, avant de construire l'UI)
--   Reglages.isLoaded() -> bool           -- load (ou save) déjà fait ?
--   Reglages.set(host, "zone.miniCarte", false) -> s   -- change une valeur puis save
--   Reglages.validate(t) -> s             -- copie vérifiée et complète (jamais de table partagée)
--   Reglages.defaults() -> s              -- copie neuve des valeurs par défaut
--   Reglages.colorsFor(s) -> { [clé] = Color3 }       -- couleurs du thème SANS toucher à Theme (aperçu)
--   Reglages.categoryColor(categoryId, s?) -> color, dot  -- couleur d'une catégorie (avec la couleur
--                                         -- personnalisée de s) ; dot = lighten(color, 0.3) si personnalisée
--   Reglages.isFavorite(defId) ; Reglages.setFavorite(host, defId, on) ; Reglages.toggleFavorite(host, defId) -> on
--   Reglages.assetId(texte|nombre) -> "123456" | ""   -- id d'un objet du Creator Store (ou "")
--   Reglages.THEMES, Reglages.ACCENTS, Reglages.NOTE_COLORS, Reglages.PIECES (listes pour l'interface)
-- host peut être nil : on réutilise alors le dernier host reçu par load / save (sinon rien n'est écrit).
--
-- NOTE: la vitesse des animations est Theme.Anim.Facteur (lente 1,5 · normale 1 · rapide 0,6) : Anim
-- multiplie ses durées par ce facteur. « animations.actives » est synchronisé avec le réglage
-- « BlocsFR_Animations » d'Anim (menu « ? ») : load le relit (il est le plus récent), save l'écrit, et
-- applyToTheme appelle Anim.setEnabled si besoin.
-- NOTE: « Taille de l'interface » multiplie Theme.TextSize (sauf Block : la taille des blocs, c'est le
-- zoom « blocs.echelle ») et les hauteurs de Theme.Layout (clés qui contiennent « Height »).
-- NOTE: la couleur principale garde toujours un contraste d'au moins 3:1 avec le texte blanc des
-- boutons (une couleur trop claire est un peu assombrie pour les fonds de boutons ; AccentText garde la
-- teinte claire pour les textes). Le thème « Contraste élevé » utilise toujours le jaune #FFD400.

local HttpService = game:GetService("HttpService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)

local okCategories, Categories = pcall(require, script.Parent.Categories)
if not okCategories or type(Categories) ~= "table" then
	Categories = {}
end

local Reglages = {}

Reglages.SETTING = "BlocsFR_Reglages"
Reglages.ANIM_SETTING = "BlocsFR_Animations" -- (= réglage d'Anim)
Reglages.EXPORT_PREFIX = "BLOCSFR_REGLAGES1:"
Reglages.MAX_FAVORIS = 60
Reglages.Changed = Util.Signal.new()

Reglages.DEFAULTS = {
	apparence = { theme = "sombre", accent = { 37, 99, 235 }, taille = "normale" },
	blocs = { echelle = 1.0, style = "relief", arrondi = 6, couleurs = {} },
	-- liens : lignes automatiques entre les blocs (SPEC §36) : "toujours" | "survol" | "jamais"
	zone = { grille = "points", tailleGrille = 22, aimant = 28, miniCarte = true, liens = "toujours" },
	palette = { largeur = 280, debutant = false, favoris = {} },
	animations = { actives = true, vitesse = "normale" },
	code = { notes = true, entete = true },
	notes = { couleur = "jaune", taille = 12 },
	previsualisation = {
		type = "R6",
		modeleId = "",
		pieces = {
			tete = "",
			torse = "",
			brasGauche = "",
			brasDroit = "",
			mainGauche = "",
			mainDroite = "",
			jambeGauche = "",
			jambeDroite = "",
		},
		ombres = true,
	},
	sauvegarde = { brouillon = 30 },
	majs = { verifier = true },
}

-- Listes utiles à l'interface des paramètres
Reglages.THEMES = {
	{ id = "sombre", nom = "Sombre" },
	{ id = "nuit", nom = "Nuit" },
	{ id = "clair", nom = "Clair" },
	{ id = "contraste", nom = "Contraste élevé" },
}

-- Les 9 couleurs principales de la planche (bleu, violet, rose, rouge, orange, jaune, vert, sarcelle, cyan)
Reglages.ACCENTS = {
	{ 37, 99, 235 },
	{ 124, 58, 237 },
	{ 219, 39, 119 },
	{ 229, 72, 77 },
	{ 234, 88, 12 },
	{ 210, 154, 28 },
	{ 34, 165, 90 },
	{ 13, 148, 136 },
	{ 8, 145, 178 },
}

Reglages.NOTE_COLORS = { "jaune", "vert", "bleu", "rose", "violet" }

-- Pièces séparées du mannequin : { clé, libellé }
Reglages.PIECES = {
	{ "tete", "Tête" },
	{ "torse", "Torse" },
	{ "brasGauche", "Bras gauche" },
	{ "brasDroit", "Bras droit" },
	{ "mainGauche", "Main gauche" },
	{ "mainDroite", "Main droite" },
	{ "jambeGauche", "Jambe gauche" },
	{ "jambeDroite", "Jambe droite" },
}

local THEME_IDS = { "sombre", "nuit", "clair", "contraste" }
local TAILLE_IDS = { "normale", "petite", "grande" }
local STYLE_IDS = { "relief", "plat", "contour", "bonbon" }
local GRILLE_IDS = { "points", "lignes", "aucune" }
local LIENS_IDS = { "toujours", "survol", "jamais" }
-- Réglage gardé à part par App avant que « zone.liens » n'existe ici (repris s'il est plus récent)
local LIENS_SETTING = "BlocsFR_Liens"
local VITESSE_IDS = { "normale", "lente", "rapide" }
local MANNEQUIN_IDS = { "R6", "R15", "modele", "pieces" }
local BROUILLON_STEPS = { 30, 60, 120 }

-- « Taille de l'interface » : facteurs du texte et des hauteurs
local TAILLES = {
	petite = { texte = 0.9, hauteurs = 0.92 },
	normale = { texte = 1, hauteurs = 1 },
	grande = { texte = 1.15, hauteurs = 1.1 },
}

-- « Vitesse des animations » : facteur des durées (Theme.Anim.Facteur)
local VITESSES = { lente = 1.5, normale = 1, rapide = 0.6 }

local WHITE = Color3.fromRGB(255, 255, 255)
local CONTRAST_YELLOW = Color3.fromRGB(255, 212, 0) -- #FFD400

local function rgb3(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Couleurs qui changent selon le thème (les autres clés gardent la valeur du thème « Sombre »).
-- Les blocs gardent leurs couleurs et leur texte blanc dans tous les thèmes.
local THEME_COLORS = {
	sombre = {},
	nuit = {
		Background = rgb3(5, 5, 6), -- #050506
		GridDot = rgb3(32, 32, 38),
		Panel = rgb3(11, 11, 13), -- #0B0B0D
		PanelAlt = rgb3(18, 18, 21),
		PanelBorder = rgb3(30, 30, 35),
		Button = rgb3(22, 22, 26),
		ButtonHover = rgb3(32, 32, 37),
		ButtonActive = rgb3(43, 43, 49),
		ButtonActiveStroke = rgb3(62, 62, 70),
		SearchBg = rgb3(22, 22, 26),
		SearchStroke = rgb3(40, 40, 46),
		FieldBg = rgb3(5, 5, 6),
		Popup = rgb3(16, 16, 19),
		PopupBorder = rgb3(40, 40, 46),
		PopupHover = rgb3(30, 30, 35),
		Tooltip = rgb3(0, 0, 0),
		CodeBg = rgb3(8, 8, 10),
		DeviceFrame = rgb3(0, 0, 0),
		Splitter = rgb3(12, 12, 14),
	},
	clair = {
		Background = rgb3(241, 242, 246), -- #F1F2F6
		GridDot = rgb3(212, 214, 220), -- #D4D6DC
		Panel = rgb3(255, 255, 255), -- #FFFFFF
		PanelAlt = rgb3(246, 247, 250),
		PanelBorder = rgb3(220, 221, 227), -- #DCDDE3
		Button = rgb3(238, 239, 243),
		ButtonHover = rgb3(228, 230, 236),
		ButtonActive = rgb3(216, 218, 226),
		ButtonActiveStroke = rgb3(186, 188, 198),
		Text = rgb3(31, 31, 35), -- #1F1F23
		TextSoft = rgb3(58, 58, 64),
		TextDim = rgb3(107, 107, 115), -- #6B6B73
		TextDisabled = rgb3(160, 160, 168),
		DangerText = rgb3(190, 40, 46),
		WarningText = rgb3(160, 90, 0),
		SuccessText = rgb3(21, 128, 61),
		SearchBg = rgb3(241, 242, 246),
		SearchStroke = rgb3(214, 216, 222),
		FieldBg = rgb3(241, 242, 246),
		SnapHighlight = rgb3(31, 31, 35), -- le fantôme blanc ne se verrait pas sur un fond clair
		Popup = rgb3(255, 255, 255),
		PopupBorder = rgb3(214, 216, 222),
		PopupHover = rgb3(238, 240, 245),
		Tooltip = rgb3(255, 255, 255),
		CodeBg = rgb3(24, 24, 28), -- le code reste sur fond sombre (couleurs de Theme.Code)
		LinkHighlight = rgb3(8, 145, 178),
		Splitter = rgb3(228, 230, 236),
	},
	contraste = {
		Background = rgb3(0, 0, 0),
		GridDot = rgb3(70, 70, 78),
		Panel = rgb3(0, 0, 0),
		PanelAlt = rgb3(12, 12, 14),
		PanelBorder = rgb3(255, 255, 255), -- bordures blanches de 1 px
		Button = rgb3(22, 22, 26),
		ButtonHover = rgb3(48, 48, 56),
		ButtonActive = rgb3(72, 72, 82),
		ButtonActiveStroke = rgb3(255, 255, 255),
		Text = rgb3(255, 255, 255),
		TextSoft = rgb3(245, 245, 245),
		TextDim = rgb3(215, 215, 220),
		TextDisabled = rgb3(150, 150, 158),
		TextDark = rgb3(0, 0, 0),
		DangerText = rgb3(255, 150, 150),
		WarningText = rgb3(255, 214, 102),
		SuccessText = rgb3(110, 235, 155),
		SearchBg = rgb3(0, 0, 0),
		SearchStroke = rgb3(255, 255, 255),
		FieldBg = rgb3(0, 0, 0),
		Popup = rgb3(0, 0, 0),
		PopupBorder = rgb3(255, 255, 255),
		PopupHover = rgb3(52, 52, 60),
		Tooltip = rgb3(0, 0, 0),
		CodeBg = rgb3(0, 0, 0),
		DeviceFrame = rgb3(0, 0, 0),
		Splitter = rgb3(30, 30, 34),
	},
}

local current = nil -- réglages actuels (vérifiés)
local lastHost = nil
local loaded = false -- true après le premier load (ou save)

---------------------------------------------------------------------------
-- Vérification des valeurs
---------------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function oneOf(value, list, default)
	for _, v in ipairs(list) do
		if value == v then
			return v
		end
	end
	return default
end

local function bool(value, default)
	if type(value) == "boolean" then
		return value
	end
	return default
end

-- Nombre dans [lo, hi] (arrondi à l'entier si integer) ; pas un nombre -> default
local function number(value, lo, hi, default, integer)
	local n = tonumber(value)
	if n == nil or n ~= n then
		return default
	end
	if n == math.huge then
		n = hi
	elseif n == -math.huge then
		n = lo
	end
	if integer then
		n = math.floor(n + 0.5)
	end
	return math.clamp(n, lo, hi)
end

-- {r, g, b} entiers 0-255 (nouvelle table) ou nil
local function rgb(value)
	if typeof(value) == "Color3" then
		return Util.color3ToRgb(value)
	end
	if type(value) ~= "table" then
		return nil
	end
	local out = {}
	for i = 1, 3 do
		local n = tonumber(value[i])
		if not isFinite(n) then
			return nil
		end
		out[i] = math.floor(math.clamp(n, 0, 255) + 0.5)
	end
	return out
end

local function sameRgb(a, b)
	return type(a) == "table" and type(b) == "table" and a[1] == b[1] and a[2] == b[2] and a[3] == b[3]
end

local function section(t, key)
	local v = nil
	if type(t) == "table" then
		v = t[key]
	end
	if type(v) == "table" then
		return v
	end
	return {}
end

-- Aimant : 0 = désactivé, sinon 12 à 48
local function aimantValue(value)
	local n = tonumber(value)
	if n == nil or n ~= n then
		return Reglages.DEFAULTS.zone.aimant
	end
	if n <= 0 then
		return 0
	end
	if n == math.huge then
		return 48
	end
	return math.clamp(math.floor(n + 0.5), 12, 48)
end

-- Brouillon : 0 (désactivé), 30, 60 ou 120 secondes (la valeur la plus proche)
local function brouillonValue(value)
	local n = tonumber(value)
	if n == nil or n ~= n then
		return Reglages.DEFAULTS.sauvegarde.brouillon
	end
	if n <= 0 then
		return 0
	end
	local best, bestDistance = BROUILLON_STEPS[1], math.huge
	for _, step in ipairs(BROUILLON_STEPS) do
		local d = math.abs(step - n)
		if d < bestDistance then
			best, bestDistance = step, d
		end
	end
	return best
end

local function favorisValue(value)
	local out = {}
	if type(value) ~= "table" then
		return out
	end
	local seen = {}
	for _, id in ipairs(value) do
		if type(id) == "string" and #id <= 80 and string.match(id, "^[%w_]+$") and not seen[id] then
			seen[id] = true
			table.insert(out, id)
			if #out >= Reglages.MAX_FAVORIS then
				break
			end
		end
	end
	return out
end

-- Id d'un objet du Creator Store : "1234567890", "rbxassetid://123", un lien …/123/… ou ?id=123.
-- Renvoie les chiffres ("" si ce n'est pas un id).
function Reglages.assetId(value)
	if type(value) == "number" then
		if isFinite(value) and value >= 1 and value < 1e15 then
			return string.format("%d", math.floor(value))
		end
		return ""
	end
	if type(value) ~= "string" then
		return ""
	end
	local text = Util.trim(value)
	if text == "" then
		return ""
	end
	local digits = string.match(text, "^(%d+)$")
		or string.match(text, "rbxassetid://(%d+)")
		or string.match(text, "[?&][iI][dD]=(%d+)")
		or string.match(text, "/(%d%d%d%d+)")
	if digits == nil or #digits > 18 then
		return ""
	end
	digits = string.gsub(digits, "^0+", "")
	return digits
end

-- Copie vérifiée et complète des réglages t (n'importe quoi accepté : valeur abîmée -> défaut)
local function validate(t)
	local D = Reglages.DEFAULTS
	local src = t
	if type(src) ~= "table" then
		src = {}
	end
	local s = {}

	local a = section(src, "apparence")
	s.apparence = {
		theme = oneOf(a.theme, THEME_IDS, D.apparence.theme),
		accent = rgb(a.accent) or rgb(D.apparence.accent),
		taille = oneOf(a.taille, TAILLE_IDS, D.apparence.taille),
	}

	local b = section(src, "blocs")
	local echelle = number(b.echelle, 0.7, 1.4, D.blocs.echelle, false)
	echelle = math.clamp(math.floor(echelle * 20 + 0.5) / 20, 0.7, 1.4) -- pas de 5 %
	local couleurs = {}
	if type(b.couleurs) == "table" then
		for key, value in pairs(b.couleurs) do
			if type(key) == "string" and #key <= 40 and string.match(key, "^[%w_]+$") then
				local c = rgb(value)
				if c then
					couleurs[key] = c
				end
			end
		end
	end
	s.blocs = {
		echelle = echelle,
		style = oneOf(b.style, STYLE_IDS, D.blocs.style),
		arrondi = number(b.arrondi, 0, 12, D.blocs.arrondi, true),
		couleurs = couleurs,
	}

	local z = section(src, "zone")
	s.zone = {
		grille = oneOf(z.grille, GRILLE_IDS, D.zone.grille),
		tailleGrille = number(z.tailleGrille, 14, 40, D.zone.tailleGrille, true),
		aimant = aimantValue(z.aimant),
		miniCarte = bool(z.miniCarte, D.zone.miniCarte),
		liens = oneOf(z.liens, LIENS_IDS, D.zone.liens),
	}

	local p = section(src, "palette")
	s.palette = {
		largeur = number(p.largeur, 240, 360, D.palette.largeur, true),
		debutant = bool(p.debutant, D.palette.debutant),
		favoris = favorisValue(p.favoris),
	}

	local an = section(src, "animations")
	s.animations = {
		actives = bool(an.actives, D.animations.actives),
		vitesse = oneOf(an.vitesse, VITESSE_IDS, D.animations.vitesse),
	}

	local c = section(src, "code")
	s.code = {
		notes = bool(c.notes, D.code.notes),
		entete = bool(c.entete, D.code.entete),
	}

	local n = section(src, "notes")
	s.notes = {
		couleur = oneOf(n.couleur, Reglages.NOTE_COLORS, D.notes.couleur),
		taille = number(n.taille, 10, 18, D.notes.taille, true),
	}

	local pv = section(src, "previsualisation")
	local piecesSrc = section(pv, "pieces")
	local pieces = {}
	for _, entry in ipairs(Reglages.PIECES) do
		pieces[entry[1]] = Reglages.assetId(piecesSrc[entry[1]])
	end
	s.previsualisation = {
		type = oneOf(pv.type, MANNEQUIN_IDS, D.previsualisation.type),
		modeleId = Reglages.assetId(pv.modeleId),
		pieces = pieces,
		ombres = bool(pv.ombres, D.previsualisation.ombres),
	}

	local sv = section(src, "sauvegarde")
	s.sauvegarde = { brouillon = brouillonValue(sv.brouillon) }

	local m = section(src, "majs")
	s.majs = { verifier = bool(m.verifier, D.majs.verifier) }

	return s
end

Reglages.validate = validate

function Reglages.defaults()
	return validate(nil)
end

---------------------------------------------------------------------------
-- Lecture / écriture
---------------------------------------------------------------------------

local function hostOf(host)
	if type(host) == "table" then
		lastHost = host
		return host
	end
	return lastHost
end

local function readSetting(host, key)
	if type(host) ~= "table" or type(host.getSetting) ~= "function" then
		return nil
	end
	local ok, value = pcall(host.getSetting, key)
	if ok then
		return value
	end
	return nil
end

local function writeSetting(host, key, value)
	if type(host) ~= "table" or type(host.setSetting) ~= "function" then
		return false
	end
	local ok, err = pcall(host.setSetting, key, value)
	if not ok then
		warn("[Blocs FR] Paramètres : impossible d'enregistrer « " .. key .. " » : " .. tostring(err))
	end
	return ok
end

local function encode(s)
	local ok, json = pcall(function()
		return HttpService:JSONEncode(s)
	end)
	if ok and type(json) == "string" then
		return json
	end
	return nil
end

local function decode(raw)
	if type(raw) == "table" then
		return raw
	end
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

function Reglages.current()
	if current == nil then
		current = validate(nil)
	end
	return current
end

-- Vrai quand les réglages ont été lus (load) ou écrits (save) au moins une fois
function Reglages.isLoaded()
	return loaded
end

function Reglages.load(host)
	host = hostOf(host)
	local data = decode(readSetting(host, Reglages.SETTING))
	local s = validate(data)
	-- Le menu « ? » change « BlocsFR_Animations » directement : c'est la valeur la plus récente
	local animations = readSetting(host, Reglages.ANIM_SETTING)
	if type(animations) == "boolean" then
		s.animations.actives = animations
	end
	-- « zone.liens » jamais enregistré ici : valeur gardée à part par App (menu des lignes)
	local storedZone = type(data) == "table" and data.zone or nil
	if type(storedZone) ~= "table" or storedZone.liens == nil then
		s.zone.liens = oneOf(readSetting(host, LIENS_SETTING), LIENS_IDS, s.zone.liens)
	end
	current = s
	loaded = true
	Reglages.Changed:Fire(s)
	return s
end

function Reglages.save(host, s)
	host = hostOf(host)
	local validated = validate(s)
	current = validated
	loaded = true
	local json = encode(validated)
	if json then
		writeSetting(host, Reglages.SETTING, json)
	end
	writeSetting(host, Reglages.ANIM_SETTING, validated.animations.actives)
	Reglages.Changed:Fire(validated)
	return validated
end

-- Charge les réglages puis les applique au thème (au démarrage, avant de construire l'interface)
function Reglages.init(host)
	local s = Reglages.load(host)
	Reglages.applyToTheme(s)
	return s
end

-- Valeur d'un chemin "section.cle" (copie pour les tables) ; nil si le chemin n'existe pas
function Reglages.get(path)
	local node = Reglages.current()
	if type(path) == "string" and path ~= "" then
		for key in string.gmatch(path, "[^%.]+") do
			if type(node) ~= "table" then
				return nil
			end
			node = node[key]
		end
	end
	if type(node) == "table" then
		return Util.deepCopy(node)
	end
	return node
end

-- Avant de modifier les réglages : les lire s'ils ne l'ont jamais été (sinon l'enregistrement
-- remplacerait les réglages gardés par Studio par les valeurs par défaut)
local function ensureLoaded(host)
	if loaded then
		return
	end
	local h = hostOf(host)
	if type(h) == "table" then
		Reglages.load(h)
	end
end

-- Change une valeur ("palette.debutant", true) puis enregistre. Renvoie les nouveaux réglages.
-- (n'applique pas le thème : appeler applyToTheme si la valeur change l'apparence)
function Reglages.set(host, path, value)
	ensureLoaded(host)
	if type(path) ~= "string" or path == "" then
		return Reglages.current()
	end
	local keys = {}
	for key in string.gmatch(path, "[^%.]+") do
		table.insert(keys, key)
	end
	if #keys == 0 then
		return Reglages.current()
	end
	local copy = Util.deepCopy(Reglages.current())
	local node = copy
	for i = 1, #keys - 1 do
		if type(node[keys[i]]) ~= "table" then
			node[keys[i]] = {}
		end
		node = node[keys[i]]
	end
	node[keys[#keys]] = Util.deepCopy(value)
	return Reglages.save(host, copy)
end

---------------------------------------------------------------------------
-- Favoris (SPEC §32)
---------------------------------------------------------------------------

function Reglages.isFavorite(defId)
	for _, id in ipairs(Reglages.current().palette.favoris) do
		if id == defId then
			return true
		end
	end
	return false
end

-- Ajoute (on = true) ou retire un bloc des favoris ; renvoie true s'il est maintenant favori
function Reglages.setFavorite(host, defId, on)
	if type(defId) ~= "string" or defId == "" then
		return false
	end
	ensureLoaded(host)
	local list = {}
	for _, id in ipairs(Reglages.current().palette.favoris) do
		if id ~= defId then
			table.insert(list, id)
		end
	end
	if on then
		if #list >= Reglages.MAX_FAVORIS then
			table.remove(list, 1)
		end
		table.insert(list, defId)
	end
	Reglages.set(host, "palette.favoris", list)
	return Reglages.isFavorite(defId)
end

function Reglages.toggleFavorite(host, defId)
	ensureLoaded(host)
	return Reglages.setFavorite(host, defId, not Reglages.isFavorite(defId))
end

---------------------------------------------------------------------------
-- Couleurs
---------------------------------------------------------------------------

-- Couleur de fond de bouton sur laquelle le texte blanc reste lisible (contraste >= 3:1)
local function readableBackground(color)
	local c = color
	for _ = 1, 40 do
		if Theme.contrast(c, WHITE) >= 3 then
			break
		end
		c = Theme.darken(c, 0.05)
	end
	return c
end

-- Couleur de texte lisible sur background (contraste >= minContrast)
local function readableText(color, background, minContrast)
	local c = color
	local lighter = Theme.luminance(background) < 0.4
	for _ = 1, 40 do
		if Theme.contrast(c, background) >= minContrast then
			break
		end
		if lighter then
			c = Theme.lighten(c, 0.1)
		else
			c = Theme.darken(c, 0.08)
		end
	end
	return c
end

local function baseColors()
	if type(Theme.Base) == "table" and type(Theme.Base.Colors) == "table" then
		return Theme.Base.Colors
	end
	return Theme.Colors
end

-- Couleurs complètes du thème choisi dans s, sans modifier Theme (pour l'aperçu des paramètres)
function Reglages.colorsFor(s)
	local settings = validate(s)
	local base = baseColors()
	local out = {}
	for key, value in pairs(base) do
		out[key] = value
	end
	local themeId = settings.apparence.theme
	for key, value in pairs(THEME_COLORS[themeId] or {}) do
		out[key] = value
	end

	if themeId == "contraste" then
		local background = readableBackground(CONTRAST_YELLOW)
		out.Accent = background
		out.AccentHover = Theme.lighten(background, 0.12)
		out.Info = background
		out.AccentText = CONTRAST_YELLOW
		out.InfoText = CONTRAST_YELLOW
		return out
	end

	local accentRgb = settings.apparence.accent
	local isDefault = sameRgb(accentRgb, Reglages.DEFAULTS.apparence.accent)
	if isDefault and themeId ~= "clair" then
		return out -- couleurs d'origine, à l'identique
	end
	local accent = Util.rgbToColor3(accentRgb)
	if isDefault then
		accent = base.Accent or accent
	end
	local background = readableBackground(accent)
	out.Accent = background
	out.Info = background
	if not isDefault then
		out.AccentHover = Theme.lighten(background, 0.12)
	end
	local text
	if themeId == "clair" then
		text = readableText(accent, out.Panel, 4.5)
	else
		text = readableText(Theme.lighten(accent, 0.45), out.Panel, 4.5)
	end
	out.AccentText = text
	out.InfoText = text
	return out
end

local function categoryEntry(categoryId)
	for _, entry in ipairs(Categories) do
		if type(entry) == "table" and entry.id == categoryId then
			return entry
		end
	end
	return nil
end

-- Couleurs d'origine d'une catégorie (gardées sur l'entrée avant toute modification)
local function categoryBase(entry)
	if typeof(entry._couleurBase) ~= "Color3" then
		entry._couleurBase = entry.color
		entry._pointBase = entry.dot
	end
	return entry._couleurBase, entry._pointBase
end

-- Couleur (et pastille) d'une catégorie avec les couleurs personnalisées de s (réglages actuels si nil).
-- Catégorie inconnue sans couleur personnalisée -> nil, nil.
function Reglages.categoryColor(categoryId, s)
	local settings = s
	if type(settings) ~= "table" then
		settings = Reglages.current()
	end
	-- (la couleur d'origine est gardée AVANT qu'une couleur personnalisée ne la remplace)
	local entry = categoryEntry(categoryId)
	local baseColor, baseDot = nil, nil
	if entry ~= nil then
		baseColor, baseDot = categoryBase(entry)
	end
	local couleurs = nil
	if type(settings.blocs) == "table" and type(settings.blocs.couleurs) == "table" then
		couleurs = settings.blocs.couleurs
	end
	local override = nil
	if couleurs ~= nil then
		override = rgb(couleurs[categoryId])
	end
	if override ~= nil then
		local color = Util.rgbToColor3(override)
		return color, Theme.lighten(color, 0.3)
	end
	return baseColor, baseDot
end

---------------------------------------------------------------------------
-- Application au thème
---------------------------------------------------------------------------

local function snapshot(t)
	local copy = {}
	if type(t) == "table" then
		for key, value in pairs(t) do
			copy[key] = value
		end
	end
	return copy
end

local function ensureBase()
	if type(Theme.Base) ~= "table" then
		-- (ancien Theme sans copie d'origine : on la fait maintenant, une seule fois)
		Theme.Base = {}
	end
	local base = Theme.Base
	for _, group in ipairs({ "Colors", "TextSize", "Layout", "Block", "Canvas", "Anim" }) do
		if type(base[group]) ~= "table" then
			base[group] = snapshot(Theme[group])
		end
	end
	return base
end

local function restore(target, source)
	for key, value in pairs(source) do
		target[key] = value
	end
end

function Reglages.applyToTheme(s)
	local settings = validate(s or Reglages.current())
	local base = ensureBase()
	if type(Theme.Canvas) ~= "table" then
		Theme.Canvas = {}
	end

	-- Couleurs du thème et couleur principale
	restore(Theme.Colors, base.Colors)
	for key, value in pairs(Reglages.colorsFor(settings)) do
		Theme.Colors[key] = value
	end

	-- Taille de l'interface (le texte des blocs suit le zoom, pas ce réglage)
	local taille = TAILLES[settings.apparence.taille] or TAILLES.normale
	for key, value in pairs(base.TextSize) do
		if key ~= "Block" and isFinite(value) then
			Theme.TextSize[key] = math.max(8, math.floor(value * taille.texte + 0.5))
		else
			Theme.TextSize[key] = value
		end
	end
	for key, value in pairs(base.Layout) do
		if isFinite(value) and string.find(key, "Height", 1, true) then
			Theme.Layout[key] = math.floor(value * taille.hauteurs + 0.5)
		else
			Theme.Layout[key] = value
		end
	end
	Theme.Layout.PanelWidth = settings.palette.largeur

	-- Blocs
	restore(Theme.Block, base.Block)
	Theme.Block.Style = settings.blocs.style
	Theme.Block.Corner = settings.blocs.arrondi
	Theme.Block.SnapDistance = settings.zone.aimant

	-- Zone de travail
	restore(Theme.Canvas, base.Canvas)
	Theme.Canvas.GridStyle = settings.zone.grille
	Theme.Canvas.GridSize = settings.zone.tailleGrille
	Theme.Canvas.Zoom = settings.blocs.echelle
	Theme.Canvas.MiniCarte = settings.zone.miniCarte

	-- Animations
	restore(Theme.Anim, base.Anim)
	Theme.Anim.Facteur = VITESSES[settings.animations.vitesse] or 1

	-- Couleurs des catégories (Registry, Palette et Renderer lisent ces entrées)
	for _, entry in ipairs(Categories) do
		if type(entry) == "table" and type(entry.id) == "string" then
			local color, dot = Reglages.categoryColor(entry.id, settings)
			if typeof(color) == "Color3" then
				entry.color = color
			end
			if typeof(dot) == "Color3" then
				entry.dot = dot
			end
		end
	end

	-- Animations activées / désactivées (même réglage que le menu « ? »)
	local okAnim, Anim = pcall(require, script.Parent.Anim)
	if okAnim and type(Anim) == "table" and type(Anim.enabled) == "function" and type(Anim.setEnabled) == "function" then
		local wanted = settings.animations.actives == true
		local okEnabled, isEnabled = pcall(Anim.enabled)
		if okEnabled and isEnabled ~= wanted then
			pcall(Anim.setEnabled, wanted)
		end
	end
	return settings
end

---------------------------------------------------------------------------
-- Exporter / importer (texte à copier-coller)
---------------------------------------------------------------------------

function Reglages.export(s)
	local json = encode(validate(s or Reglages.current()))
	return Reglages.EXPORT_PREFIX .. (json or "{}")
end

function Reglages.import(text)
	if type(text) ~= "string" or Util.trim(text) == "" then
		return nil, "Colle d'abord le texte de tes réglages."
	end
	local body = Util.trim(text)
	if string.sub(body, 1, 9) == "BLOCSFR1:" then
		return nil, "Ce texte est un code de script (à coller avec « Importer un code… »), pas des réglages."
	end
	local prefix = Reglages.EXPORT_PREFIX
	if string.sub(body, 1, #prefix) == prefix then
		body = Util.trim(string.sub(body, #prefix + 1))
	end
	if string.sub(body, 1, 1) ~= "{" then
		return nil, "Ce texte n'est pas un code de réglages Blocs FR : il doit commencer par « " .. prefix .. " »."
	end
	local data = decode(body)
	if type(data) ~= "table" then
		return nil, "Le code de réglages est abîmé (il manque peut-être un morceau) : recopie-le en entier."
	end
	local known = 0
	for key in pairs(Reglages.DEFAULTS) do
		if type(data[key]) == "table" then
			known += 1
		end
	end
	if known == 0 then
		return nil, "Ce code ne contient aucun réglage Blocs FR."
	end
	return validate(data), nil
end

return Reglages
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">ReglagesPanel</string><ProtectedString name="Source"><![CDATA[-- ReglagesPanel : la fenêtre « Paramètres » de Blocs FR (SPEC §31, planche « Options »).
-- Fenêtre modale : à gauche la recherche et les sections (Apparence, Blocs, Zone de travail, Palette,
-- Animations, Code généré, Notes, Prévisualisation 3D, Sauvegarde auto, Mises à jour), au milieu les
-- réglages (une seule liste qui défile ; un clic sur une section y saute), à droite un aperçu en direct
-- (mini barre du haut, palette, blocs et note recolorés au fil des changements), en bas « Tout
-- réinitialiser », « Exporter mes réglages », « Importer », « Annuler » et « Appliquer ».
-- Les changements restent un brouillon jusqu'à « Appliquer ».
--
-- API :
--   ReglagesPanel.open(layer, deps) -> panel | nil
--       layer = calque des dialogues d'App (le panneau se place en ZIndex 6, SOUS les menus et fenêtres
--               de Dialogs : le sélecteur de couleur et la confirmation s'ouvrent par-dessus)
--       deps = { host, dialogs, version, onApply = fn(s), onClose = fn() (facultatif) }
--       « Appliquer » ferme le panneau puis appelle onApply(s) (s vérifié) quand quelque chose a changé ;
--       sans onApply : Reglages.save(host, s) puis Reglages.applyToTheme(s).
--   panel:close() ; panel:isOpen() ; panel:showSection(id) (défile jusqu'à la section « zone »…)
-- Extensions (tests / DevBridge) : panel:getDraft() -> copie du brouillon ; panel:setValue(chemin, valeur) ;
--   panel:getDebugState().
-- Un seul panneau à la fois : en ouvrir un second ferme le premier.
-- NOTE: la fenêtre s'adapte à la place disponible (760 × 460 au minimum de l'éditeur) : colonnes plus
-- étroites, libellés au-dessus des réglages, aperçu masqué sous 700 px de large ; elle se reconstruit
-- quand le calque change de taille (le brouillon est gardé).

local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Reglages = require(script.Parent.Reglages)

local function optionalModule(name)
	local moduleScript = script.Parent:FindFirstChild(name)
	if moduleScript == nil then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local Anim = optionalModule("Anim")
local Logo = optionalModule("Logo")
local Categories = optionalModule("Categories") or {}

local ReglagesPanel = {}
ReglagesPanel.__index = ReglagesPanel

local Z_PANEL = 6 -- sous les menus (10+) et fenêtres (20) de Dialogs
local Z_SHEET = 50
local Z_DRAG = 100
local FOOTER_H = 58
local NAV_ITEM_H = 32
local NAV_TOP = 88
local LABEL_W = 168
local ROW_GAP = 18
local SECTION_GAP = 16
local WIDE_MIN = 480 -- largeur de ligne à partir de laquelle le libellé est à gauche du réglage
local WHITE = Color3.fromRGB(255, 255, 255)
local DARK_TEXT = Color3.fromRGB(31, 31, 35)
local THEME_ACTIONS_BAR = Color3.fromRGB(169, 34, 181) -- barre « bloc » des miniatures de thème
local VFX_COLOR = Color3.fromRGB(180, 30, 150) -- catégorie « Effets » (si elle n'existe pas encore)
local VFX_DOT = Color3.fromRGB(240, 110, 210)

local openPanel = nil

---------------------------------------------------------------------------
-- Petites fonctions
---------------------------------------------------------------------------

local measureCache = {}
local measureCount = 0

-- Hauteur d'un texte qui passe à la ligne (ne cède jamais la main)
local function measure(text, size, font, width)
	width = math.max(10, math.floor(width))
	local key = font.Name .. "|" .. size .. "|" .. width .. "|" .. text
	local cached = measureCache[key]
	if cached then
		return cached
	end
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 100000))
	end)
	local h
	if ok and typeof(result) == "Vector2" then
		h = math.ceil(result.Y)
	else
		local w = Util.textSize(text, size, font).X
		h = math.max(1, math.ceil(w / width)) * (size + 3)
	end
	if measureCount > 600 then
		measureCache = {}
		measureCount = 0
	end
	measureCache[key] = h
	measureCount += 1
	return h
end

local function textWidth(text, size, font)
	return math.ceil(Util.textSize(text, size, font).X)
end

local function label(props)
	local all = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.Fonts.UI,
		TextSize = 13,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextLabel", all)
end

local function frame(props)
	local all = {
		BorderSizePixel = 0,
		BackgroundColor3 = Theme.Colors.Panel,
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("Frame", all)
end

local function button(props)
	local all = {
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundColor3 = Theme.Colors.Button,
	}
	for key, value in pairs(props) do
		all[key] = value
	end
	return Util.create("TextButton", all)
end

local function getPath(t, path)
	local node = t
	for key in string.gmatch(path, "[^%.]+") do
		if type(node) ~= "table" then
			return nil
		end
		node = node[key]
	end
	return node
end

local function setPath(t, path, value)
	local keys = {}
	for key in string.gmatch(path, "[^%.]+") do
		table.insert(keys, key)
	end
	if #keys == 0 then
		return
	end
	local node = t
	for i = 1, #keys - 1 do
		if type(node[keys[i]]) ~= "table" then
			node[keys[i]] = {}
		end
		node = node[keys[i]]
	end
	node[keys[#keys]] = value
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for key, value in pairs(a) do
		if not deepEqual(value, b[key]) then
			return false
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false
		end
	end
	return true
end

local function sameRgb(a, b)
	return type(a) == "table" and type(b) == "table" and a[1] == b[1] and a[2] == b[2] and a[3] == b[3]
end

local function percentText(v)
	return tostring(math.floor((tonumber(v) or 1) * 100 + 0.5)) .. " %"
end

local function pxText(v)
	return tostring(math.floor((tonumber(v) or 0) + 0.5)) .. " px"
end

local function aimantText(v)
	if (tonumber(v) or 0) <= 0 then
		return "désactivé"
	end
	return pxText(v)
end

local function round2(v)
	return math.floor(v * 100 + 0.5) / 100
end

local function words(query)
	local list = {}
	for word in string.gmatch(Util.fold(query or ""), "[^%s]+") do
		table.insert(list, word)
	end
	return list
end

-- Vrai quand aucune source de mise à jour n'est réglée (Theme.PluginAssetId = 0 et Theme.UpdateUrl = "") :
-- MiseAJour ne peut alors rien vérifier (SPEC §25 : « desactive », raison « aucune_source »)
local function updateSourceMissing()
	local id = tonumber(Theme.PluginAssetId)
	if id ~= nil and id == id and id > 0 then
		return false
	end
	local url = Theme.UpdateUrl
	if type(url) == "string" and Util.trim(url) ~= "" then
		return false
	end
	return true
end

