						Size = seq(0, 0.15, 0.3, 0.35, 1, 0.45),
						Transparency = seq(0, 0.4, 0.85, 0.5, 1, 1),
						Lifetime = plage(1.5, 2.5),
						Speed = plage(1, 2.5),
						SpreadAngle = Vector2.new(30, 30),
						Acceleration = Vector3.new(0, 2, 0),
						Drag = 0.6,
						Rate = 12,
						RotSpeed = plage(-30, 30),
					}, { Speed = plage(5, 10), Drag = 2.5 }),
				},
			}
		end,
		coeurs = function()
			return {
				lumiere = rgb(255, 100, 160),
				duree = 2,
				objets = {
					emetteur({
						Color = degrade(rgb(255, 140, 190), rgb(255, 40, 100)),
						LightEmission = 0.8,
						Size = seq(0, 0.2, 0.3, 0.6, 1, 0.3),
						Transparency = seq(0, 0.1, 0.7, 0.2, 1, 1),
						Lifetime = plage(1.2, 2),
						Speed = plage(1.5, 3),
						SpreadAngle = Vector2.new(35, 35),
						Acceleration = Vector3.new(0, 1, 0),
						Drag = 0.5,
						Rate = 8,
						Rotation = plage(-20, 20),
						RotSpeed = plage(-25, 25),
					}, { Speed = plage(6, 12), Drag = 3 }),
				},
			}
		end,
		neige = function()
			return {
				lumiere = rgb(210, 235, 255),
				duree = 5,
				objets = {
					emetteur({
						Color = ColorSequence.new(rgb(245, 250, 255)),
						LightEmission = 0.3,
						LightInfluence = 0.4,
						Size = seq(0, 0.2, 1, 0.14),
						Transparency = seq(0, 1, 0.1, 0.1, 0.85, 0.2, 1, 1),
						Lifetime = plage(3, 5),
						Speed = plage(0.5, 1.5),
						SpreadAngle = Vector2.new(60, 60),
						EmissionDirection = Enum.NormalId.Bottom,
						Acceleration = Vector3.new(0, -1.5, 0),
						Drag = 0.4,
						Rate = 30,
						RotSpeed = plage(-60, 60),
					}, { Speed = plage(4, 8), Drag = 2 }),
				},
			}
		end,
		eclairs = function()
			return {
				lumiere = rgb(140, 200, 255),
				duree = 0.3,
				objets = { zaps(45, 28) },
			}
		end,
		confettis = function()
			local objets = {}
			for _, teinte in ipairs({ rgb(255, 70, 90), rgb(255, 205, 50), rgb(70, 220, 120), rgb(60, 160, 255), rgb(200, 90, 255) }) do
				table.insert(objets, emetteur({
					Color = ColorSequence.new(teinte),
					LightEmission = 0.15,
					Size = NumberSequence.new(0.22),
					Squash = seq(0, 0, 0.25, 1.6, 0.5, 0, 0.75, -1.6, 1, 0),
					Transparency = seq(0, 0, 0.85, 0, 1, 1),
					Lifetime = plage(1.5, 2.5),
