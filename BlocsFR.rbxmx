		tooltip = "Entoure le personnage (ou l'objet) d'une aura avec une lumière de la même couleur : magique, feu, glace, ténèbres, électrique ou soin. Elle reste jusqu'à « arrêter les effets » ou la mort du personnage ; une nouvelle aura remplace l'ancienne. À mettre dans un script serveur, par exemple sous « Quand un personnage apparaît ». Astuce : donne une aura de feu au joueur qui a le plus de points !",
		gen = function(a, g)
			return appel(g, "_vfxAura", a.TYPE, persoOu(a, "CIBLE"))
