			tutoPiece,
			tutoPlateforme,
			tutoBienvenue,
			tutoToucheE,
			tutoInterrupteur,
			tutoCombat,
			tutoModule,
			tutoMenu,
			tutoHud,
			tutoCinematique,
		},
	},
	{
		id = "exemples",
		title = "Exemples",
		pages = { galerie },
	},
	{
		id = "blocs",
		title = "Tous les blocs",
		generated = "categories",
		pages = {},
	},
	{
		id = "aide",
		title = "Aide",
		pages = { faq, rienNeSePasse, erreurs, astuces },
	},
}

---------------------------------------------------------------------------
-- Vérification des références (SPEC §26 : chaque bloc, exemple et lien doit exister)
---------------------------------------------------------------------------

-- Retire des pages les blocs, exemples et liens qui n'existent pas (bloc écrit en parallèle et pas encore
-- là, exemple caché faute de bloc…) ; renvoie la liste de ce qui a été retiré
local function nettoyer(liste)
	local retires = {}
	local okRegistry, Registry = pcall(function()
		return require(script.Parent.Registry)
	end)
	if not okRegistry or type(Registry) ~= "table" then
		Registry = nil
	end
	local okExamples, Examples = pcall(function()
		return require(script.Parent.Examples)
	end)
	local exemples = nil
	if okExamples and type(Examples) == "table" then
		exemples = {}
		for _, ex in ipairs(Examples) do
			if type(ex) == "table" and type(ex.id) == "string" then
				exemples[ex.id] = true
			end
		end
	end
	local pages = {}
	for _, section in ipairs(liste) do
		for _, page in ipairs(section.pages) do
			pages[page.id] = true
		end
	end
	if Registry ~= nil then
		pcall(function()
			for _, cat in ipairs(Registry.categories()) do
				pages["cat_" .. cat.id] = true
			end
		end)
	end
	local function blocExiste(defId)
		if Registry == nil then
			return true -- (rien à vérifier : le wiki affichera lui-même ce qui manque)
		end
		local ok, def = pcall(Registry.get, defId)
		return ok and type(def) == "table"
	end
	local function exempleExiste(id)
		return exemples == nil or exemples[id] == true
	end
	-- Raison du retrait d'un élément, ou nil s'il est valide
	local function probleme(element)
		if type(element) ~= "table" then
			return nil
		end
		if element.kind == "block" then
			if not blocExiste(element.def) then
				return "bloc " .. tostring(element.def)
			end
		elseif element.kind == "example" then
			if not exempleExiste(element.id) then
				return "exemple " .. tostring(element.id)
			end
		elseif element.kind == "link" then
			if element.def ~= nil then
				if not blocExiste(element.def) then
					return "lien vers le bloc " .. tostring(element.def)
				end
			elseif element.example ~= nil then
				if not exempleExiste(element.example) then
					return "lien vers l'exemple " .. tostring(element.example)
				end
			elseif not pages[element.page] then
				return "lien vers la page " .. tostring(element.page)
			end
			if type(element.anchor) == "string" then
				local ancre = string.match(element.anchor, "^ex_(.+)$")
				if ancre ~= nil and not exempleExiste(ancre) then
					return "lien vers l'exemple " .. ancre
				end
			end
		end
		return nil
	end
	for _, section in ipairs(liste) do
		for _, page in ipairs(section.pages) do
			local corps = {}
			for _, element in ipairs(page.body or {}) do
				local raison = probleme(element)
				if raison == nil then
					table.insert(corps, element)
				else
					table.insert(retires, page.id .. " : " .. raison)
				end
			end
			page.body = corps
		end
	end
	return retires
end

local okNettoyage, retires = pcall(nettoyer, sections)
if not okNettoyage then
	warn("[Blocs FR] Wiki : vérification des pages impossible : " .. tostring(retires))
	retires = {}
end

return {
	home = "accueil",
	sections = sections,
	categoryIntros = categoryIntros,
	retires = retires,
}
]]></ProtectedString></Properties></Item></Item></roblox>