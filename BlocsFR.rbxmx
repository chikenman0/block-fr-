}

local modelesScripts = {
	id = "modeles_scripts",
	title = "Les modèles (scripts tout faits)",
	summary = "Des scripts entiers prêts à poser depuis la palette : pièce à ramasser, obby complet, combat à l'épée, cinématique, bouton d'achat…",
	body = {
		p("Un **modèle**, c'est un script entier déjà assemblé : tu le poses d'un coup sur la zone de travail, puis tu le modifies comme tu veux. Pratique pour démarrer vite, ou pour voir comment un système est construit."),
		h("Trouver les modèles"),
		p("Dans la palette, sous les boutons des catégories, clique sur la tuile **◆ Modèles — scripts entiers prêts à poser** : la palette descend jusqu'à la section **MODÈLES**. Chaque carte montre les couleurs de ses premiers blocs, son nom, son nombre de blocs et son type de script (serveur ou local)."),
		h("Poser un modèle"),
		etapes({
			"Sélectionne d'abord la bonne **cible** dans l'Explorateur (la description du modèle dit où le mettre).",
			"**Glisse** la carte sur la zone de travail, ou **clique** dessus pour la poser au milieu de la vue.",
			"Les blocs arrivent avec leurs notes. Si ton projet était vide, il prend aussi le type de script du modèle.",
			"Change ce que tu veux, puis clique sur **Enregistrer**.",
		}),
		p("Le clic droit sur une carte propose **Ajouter à la zone de travail** et **Description du modèle**."),
		attention("Un modèle est fait pour un type de script. Si tu poses un modèle prévu pour un script local dans un script serveur (ou l'inverse), un message te prévient : change le type de script en haut de l'éditeur, ou pose-le dans un autre projet."),
		h("Les modèles disponibles"),
		p("**Pièce à ramasser**, **Brique mortelle**, **Obby complet** (points de sauvegarde, plateforme qui disparaît et brique mortelle), **Porte à clic**, **Combat à l'épée** (le script local de la touche F) et **Combat à l'épée : l'attaque** (le script serveur), **Menu principal** (un écran et ses boutons), **PNJ ennemi**, **Cinématique** (caméra), **Sprint + double saut**, **Bouton d'achat d'épée**, **Cycle jour/nuit**, **Générateur de pièces**, **Attaque avec effets** et **Course chronométrée**."),
		p("**Menu principal** est un modèle d'**écran** : il ne pose pas ses blocs dans ton script, il ouvre le **Studio d'interface** avec un nouvel écran « Menu » (titre, boutons Jouer, Boutique et Paramètres, compteur de pièces) et ses blocs juste en dessous. Clique ensuite sur **Enregistrer l'écran** pour le mettre dans StarterGui."),
		astuce("Les autres modèles viennent des exemples du wiki : les pages des exemples expliquent chaque script en détail, avec le bouton **Charger cet exemple**."),
		lien("galerie", "Tous les exemples"),
		lien("toutprets_systemes", "Les systèmes tout prêts"),
		lien("studio_interface", "Le Studio d'interface"),
	},
}

local hitbox = {
	id = "hitbox",
	title = "Le prévisualiseur de hitbox",
	summary = "Vois ta hitbox en 3D sur un mannequin, règle-la, et lance une simulation : « TOUCHÉ ! LET'S GO » ou « RATÉ… BOF ».",
	body = {
		p("Une **hitbox**, c'est la boîte invisible placée devant ton personnage quand il attaque : tout ennemi dedans est touché. Trop petite, ton coup rate ; trop grande, il touche à travers les murs. Le **prévisualiseur de hitbox** te montre exactement où elle sera dans le jeu, en 3D, sans lancer le jeu."),
		h("L'ouvrir"),
		p("Fais un **clic droit** sur un bloc de combat (« attaque de … », « hitbox devant … », « pour chaque ennemi dans une hitbox devant … ») puis **Prévisualiser la hitbox**. Tu peux aussi l'ouvrir sans bloc depuis le menu **?** (**Prévisualiseur de hitbox**), ou avec **Voir la simulation 3D** dans le panneau « Ce que fait ce script »."),
		h("La vue 3D"),
		p("Ton mannequin (en bleu) tient son arme ; l'ennemi d'entraînement (en rouge) est à quelques studs devant lui ; la **boîte rouge** est la hitbox. **Glisse** avec la souris pour tourner autour, utilise la **molette** pour zoomer, et choisis la vue **3D**, **Dessus** ou **Côté**. Le clic droit sur la vue ouvre un petit menu (lecture, vues, l'ennemi bouge…)."),
		h("Régler la hitbox"),
		p("À droite, les curseurs **Largeur**, **Hauteur**, **Profondeur** (ou **Portée** pour « attaque de … »), **Dégâts** et **Distance de l'ennemi**, et l'interrupteur **Il bouge** (l'ennemi se déplace de côté, comme un vrai joueur). Tu peux aussi écrire les nombres. La carte du résultat dit tout de suite si le coup touche."),
		h("La simulation"),
		p("**Lancer la simulation** joue l'attaque : le bras prend son élan, frappe (la hitbox s'allume), revient, puis le temps de recharge passe. La barre du temps en dessous montre chaque étape ; **Pas à pas** avance d'une étape, **Recommencer** repart du début, et les vitesses **× 0,25**, **× 0,5** et **× 1** ralentissent tout."),
		p("Si l'ennemi est touché, il recule en clignotant en rouge, un « -20 » monte au-dessus de lui et la bannière verte **TOUCHÉ ! LET'S GO** apparaît. Sinon, la bannière grise **RATÉ… BOF** te donne un conseil : augmenter la profondeur, ou rapprocher l'ennemi."),
		h("Appliquer au bloc"),
		p("Quand la hitbox te plaît, clique sur **Appliquer au bloc** : les nombres sont écrits dans les cases du bloc (tu peux annuler avec **Annuler**). Sans bloc (ouvert depuis le menu **?**), ce bouton n'existe pas : c'est un bac à sable pour essayer."),
		h("Le mannequin"),
		p("Le menu **Mannequin ▼** choisit le mannequin : **R6** (6 parties), **R15** (15 parties), **un modèle par son id** (un avatar ou un PNJ de la Boîte à outils) ou **des pièces séparées** (un id de mesh pour la tête, le torse, chaque bras, chaque main et chaque jambe). Ces choix se retrouvent dans **Paramètres → Prévisualisation 3D**."),
		astuce("La boîte est placée exactement comme dans le jeu : juste devant le personnage, centrée à la hauteur de son torse. Ce que tu vois ici, c'est ce que tes joueurs vivront !"),
		lien("tuto_combat", "Tutoriel : système de combat (animation + hitbox)"),
		lien("expliquer", "Explique-moi ce script"),
	},
}

local expliquer = {
	id = "expliquer",
	title = "Explique-moi ce script",
	summary = "Le bouton « Expliquer » raconte en français ce que fait ton script, étape par étape, et peut le jouer pas à pas.",
	body = {
		p("Tu ne sais plus ce que fait un script ? Tu veux vérifier avant de jouer ? Clique sur **Expliquer** dans la barre du haut (ou fais un clic droit, puis **Expliquer ce script**) : le panneau **Ce que fait ce script** s'ouvre à droite."),
		h("Ce qu'il montre"),
		p("Une carte par événement, avec des étapes numérotées écrites en français : « Chaque fois que quelque chose touche cet objet : », « Au démarrage : », « Si … alors : », « Répète 10 fois : », « Pour toujours : »… Les vraies valeurs de tes blocs sont écrites dedans : les nombres, les textes entre « », les choix des menus, et même les blocs glissés dans les cases (« la vie du joueur »)."),
		p("Chaque étape a une pastille de la couleur de sa catégorie. **Clique sur une étape** pour voir son bloc dans la zone de travail."),
		p("Quand un bloc **envoie un message**, son étape dit aussi qui le reçoit, par exemple « Envoyer le message « attaque », reçu par le script « Quand je reçois le message « attaque » » ». Si aucun script de ce projet ne le reçoit, l'étape le dit aussi : un autre script de ton jeu peut quand même le recevoir. Et quand un bloc appelle une **fonction de module** définie dans le même projet, l'étape dit où elle est définie. Ce sont les mêmes liens que les lignes entre les blocs."),
		h("Lecture pas à pas"),
		p("**Lecture pas à pas** allume les étapes une par une, avec leur bloc, comme si le script s'exécutait au ralenti (un peu moins d'une seconde par étape). Clique sur **Stop** pour arrêter."),
		h("Les problèmes"),
		p("Sous chaque script, les problèmes trouvés par le détecteur d'erreurs sont écrits avec « Attention : … ». Les blocs désactivés et les blocs vides sont signalés aussi."),
		h("Les combats"),
		p("Si ton script contient une attaque ou une hitbox, le bouton **Voir la simulation 3D** ouvre le prévisualiseur de hitbox : tu vois l'attaque, et si elle touche."),
		lien("hitbox", "Le prévisualiseur de hitbox"),
		lien("detecteur", "Le détecteur d'erreurs"),
		lien("lignes", "Les lignes entre les blocs"),
	},
}

---------------------------------------------------------------------------
-- Outils de l'éditeur (version 2.1.0)
---------------------------------------------------------------------------

local menus = {
	id = "menus",
	title = "Le clic droit et la sélection",
	summary = "Comme sur le bureau de Windows : des menus partout, la sélection de plusieurs blocs, et les raccourcis clavier.",
	body = {
		p("Le **clic droit** ouvre un menu partout dans l'éditeur, comme sur le bureau de Windows. Les options grisées ne sont pas possibles pour l'instant (par exemple **Coller** quand rien n'a été copié). Une petite flèche ouvre un sous-menu quand tu passes dessus."),
		h("Sur un bloc"),
		p("**Couper**, **Copier**, **Coller**, **Dupliquer** ; **Sélectionner uniquement ce bloc**, **Sélectionner tout le groupe**, **Tout sélectionner** ; **Détacher ce bloc** (le sortir de sa pile, les blocs du dessous restent à leur place), **Désactiver ce bloc** (ou **Réactiver**), **Ajouter une note** ; **Ajouter aux favoris** (ou **Retirer des favoris**), **Prévisualiser la hitbox** (blocs de combat), **Expliquer ce script**, **Voir dans le code** (le code s'ouvre sur les lignes de ce bloc) ; **Ouvrir dans le wiki**, **Aide sur ce bloc** ; enfin **Supprimer ce bloc** et **Supprimer le groupe** (le bloc et tous ceux du dessous)."),
		h("Sur le fond de la zone de travail"),
		p("**Coller ici**, **Ajouter une note ici** ; **Tout sélectionner**, **Ranger les blocs**, **Recentrer la vue**, **Zoom** (de 50 % à 150 %) ; **Annuler**, **Refaire** ; **Expliquer ce script**, **Voir le code**, **Partager ce script…**, **Importer un code…** ; **Paramètres…**, **Ouvrir le wiki** ; et **Tout effacer** (Blocs FR demande d'abord, et **Annuler** répare tout)."),
		h("Sur une note, dans la palette, dans l'interface"),
		p("**Une note** : Écrire dans la note, Couleur, Détacher du bloc, Dupliquer la note, Supprimer la note. **Un bloc de la palette** : Ajouter à la zone de travail (au milieu de la vue), Ajouter aux favoris, Ouvrir dans le wiki, Aide sur ce bloc. **Un élément du Studio d'interface** : couper, copier, coller, dupliquer, renommer, mettre devant ou derrière, ajouter un script au clic…"),
		h("Sélectionner plusieurs blocs"),
		etapes({
			"**Clique** sur un bloc : il est sélectionné (contour blanc).",
			"**Maj + clic** sur d'autres blocs pour les ajouter (ou les retirer) de la sélection.",
			"**Maj + glisser** sur le fond dessine un rectangle : tous les blocs dedans sont sélectionnés.",
			"Le clic droit sur la sélection propose : Copier la sélection, Couper la sélection, Dupliquer la sélection, Désactiver ou Réactiver, Supprimer la sélection.",
			"Glisse une des piles sélectionnées : les autres piles sélectionnées bougent avec elle.",
		}),
		h("Les raccourcis clavier"),
		p("Quand la souris est sur la zone de travail : **Ctrl+C** copier, **Ctrl+X** couper, **Ctrl+V** coller à l'endroit de la souris, **Ctrl+D** dupliquer, **Ctrl+A** tout sélectionner, **Ctrl+Z** annuler, **Ctrl+Y** refaire, **Suppr** supprimer la sélection, **Échap** tout désélectionner."),
		astuce("Le presse-papiers de Blocs FR marche entre deux scripts, et même après avoir fermé Studio : copie des blocs dans un projet, ouvre un autre objet, puis colle-les."),
		lien("outils", "Favoris, copier-coller, partage, brouillon et mini-carte"),
		lien("desactiver", "Désactiver un bloc"),
		lien("notes", "Les notes"),
	},
}

local notes = {
	id = "notes",
	title = "Les notes",
	summary = "Des petites notes sur la zone de travail (« ici, la porte s'ouvre… ») qui deviennent des commentaires dans le code.",
	body = {
		p("Une **note**, c'est un petit papier collé sur ta zone de travail : pour te rappeler ce que fait une pile, expliquer une astuce à un ami, ou noter ce qu'il reste à faire."),
		h("Ajouter une note"),
		p("Fais un clic droit sur un bloc, puis **Ajouter une note** : la note est **attachée** à ce bloc (une ligne de petits points les relie) et elle le suit quand il bouge. Un clic droit sur le fond, puis **Ajouter une note ici**, crée une note **libre**."),
		h("Écrire et ranger"),
		p("**Double-clique** sur la note pour écrire dedans (plusieurs lignes possibles), puis clique ailleurs. Une note qui commence par « à faire » prend le titre **À FAIRE** : pratique pour ta liste de choses à finir."),
		p("Le bandeau du haut sert à la **déplacer**. Ses pastilles changent sa **couleur** (jaune, vert, bleu, rose, violet), **−** la replie et **×** la supprime. Tire le coin en bas à droite pour la rendre plus large."),
		p("Le clic droit sur une note propose : Écrire dans la note, Couleur, **Détacher du bloc**, Dupliquer la note et Supprimer la note."),
		h("Les notes dans le code"),
		p("Quand tu enregistres, chaque note attachée devient un **commentaire** juste au-dessus du code de son bloc, et les notes libres sont écrites au début du script, sous `-- Notes`. Clique sur **Voir le code** pour les voir :"),
		code("-- Note : ici, la porte s'ouvre pendant 3 secondes\n--   puis elle se referme toute seule"),
		p("Les commentaires ne changent rien à ce que fait le script : Roblox les ignore. Tu peux les enlever du code avec **Paramètres → Code généré → Notes dans le code**."),
		astuce("Les notes sont gardées avec le projet, copiées avec leurs blocs (copier-coller, dupliquer) et **Annuler** marche aussi sur elles. La couleur des nouvelles notes et la taille de leur texte se règlent dans **Paramètres → Notes**."),
		exemple("obby_complet"),
		lien("menus", "Le clic droit et la sélection"),
		lien("parametres", "Les paramètres"),
	},
}

local lignes = {
	id = "lignes",
	title = "Les lignes entre les blocs",
	summary = "Des lignes relient les blocs qui travaillent ensemble : messages, fonctions de module, variables… et tes propres lignes.",
	body = {
		p("Dans un grand projet, il est difficile de voir quels blocs travaillent ensemble. Les **lignes** les relient sur la zone de travail, sous les blocs : une courbe en pointillés part du bord droit d'un bloc et arrive au bord gauche d'un autre, avec une petite étiquette au milieu."),
		h("Les lignes automatiques"),
		p("Blocs FR les trace tout seul, sans que tu aies rien à faire :"),
		p("**Message** (orange) : de « envoyer le message … » (ou de « minuteur à l'écran de … s puis envoyer … ») vers chaque « Quand je reçois le message … » qui porte **le même nom** (étiquette « message « attaque » »)."),
		p("**Module** (gris ardoise) : de « appeler la fonction … du module … » ou « résultat de … » vers « Définir la fonction … » du même nom, quand la fonction est dans le même projet (étiquette « fonction du module »)."),
		p("**Variable** (rouge) : des blocs qui changent une variable vers ceux qui la lisent. Pour ne pas tout encombrer, elles n'apparaissent que pour le bloc survolé ou sélectionné."),
		p("Quand les animations sont allumées, de petits points glissent le long de la ligne, du bloc de départ vers le bloc d'arrivée. Passe la souris sur un bloc : ses lignes s'éclairent et les autres pâlissent."),
		astuce("Une ligne de message qui n'apparaît pas ? Les deux noms ne sont sûrement pas écrits pareil (majuscules, accents, espaces). Le détecteur d'erreurs le signale aussi."),
		h("Tes propres lignes"),
		etapes({
			"Fais un clic droit sur un bloc, puis **Relier à un autre bloc…**.",
			"Clique sur le bloc à relier : la ligne est tracée. (**Échap**, un clic droit ou un clic à côté des blocs annule.)",
			"Recommence depuis le même bloc pour le relier à plusieurs blocs, comme un arbre : un bloc en haut, deux blocs en dessous.",
		}),
		p("Le clic droit sur une de tes lignes (ou sur son étiquette) propose : **Renommer la ligne** (son étiquette), **Style** (pointillés, trait plein ou flèche), **Couleur** et **Supprimer la ligne**. Sur n'importe quelle ligne, **Aller au bloc de départ** et **Aller au bloc d'arrivée** t'emmènent à l'un des deux bouts, même s'il est loin. Tes lignes suivent leurs blocs quand ils bougent, et elles disparaissent avec eux."),
		h("Dans le code"),
		p("Les lignes ne changent rien à ce que fait le script. Une de tes lignes qui a une étiquette ajoute seulement un commentaire au-dessus de son bloc de départ, par exemple `-- Lien vers « Quand je reçois le message … » : ouvre la porte` (si les notes sont écrites dans le code)."),
		h("Montrer ou cacher les lignes"),
		p("Dans les **Paramètres**, partie **Zone de travail**, choisis si les lignes automatiques sont montrées **toujours**, seulement **au survol** d'un bloc, ou **jamais**. Le clic droit sur une ligne automatique, puis **Réglages des lignes…**, t'y emmène directement. Tes propres lignes, elles, restent toujours visibles."),
		lien("messages", "Les messages entre scripts"),
		lien("modules", "Les scripts modules"),
		lien("parametres", "Les paramètres"),
	},
}

local desactiver = {
	id = "desactiver",
	title = "Désactiver un bloc",
	summary = "Mets un bloc en pause pour tester sans lui, sans le supprimer : il reste là, mais n'est plus dans le script.",
	body = {
		p("Ton script ne marche pas et tu cherches le coupable ? Au lieu de supprimer des blocs (et de devoir les remettre ensuite), **désactive**-les : ils restent sur la zone de travail, mais Blocs FR fait comme s'ils n'existaient pas quand il écrit le script."),
		h("Désactiver et réactiver"),
		etapes({
			"Fais un clic droit sur le bloc, puis **Désactiver ce bloc**.",
			"Le bloc devient pâle, rayé, avec l'étiquette « désactivé ».",
			"Enregistre et teste ton jeu : le bloc n'est plus dans le script.",
			"Pour le remettre : clic droit dessus, puis **Réactiver ce bloc**.",
