			E(
				"texte",
				"Saison",
				{ 536, 236, 208, 44 },
				texte("SAISON 1", POLICE_TEXTE, 24, BLANC, 0, {
					fond = { 229, 56, 59 },
					transparence = 0,
					arrondi = 22,
					contour = 3,
					contourCouleur = NUIT,
				})
			),
			E("bouton", "Jouer", { 400, 320, 480, 116 }, bouton("JOUER", VERT_HAUT, VERT_BAS, 52)),
