---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- Avertissement affiché une seule fois par script (etat = table _etatTP)
	_tpAvertirUneFois = {
		deps = { "_avertir" },
		services = {},
		code = [[
local function _tpAvertirUneFois(etat, cle, message)
	if type(etat) == "table" then
		etat.avertis = etat.avertis or {}
		if etat.avertis[cle] then
			return
		end
		etat.avertis[cle] = true
	end
	_avertir(message)
end]],
	},

	-- Animator d'un personnage, d'un joueur ou d'un PNJ (Humanoid ou AnimationController).
	-- creer = true : l'Animator est créé s'il manque. Avertit si aucun personnage n'est trouvé.
	_tpAnimateur = {
		deps = { "_humanoid", "_obj", "_avertirCible" },
		services = { "RunService" },
		code = [[
local function _tpAnimateur(valeur, action, creer)
	local hote = _humanoid(valeur)
	if hote == nil then
		local objet = _obj(valeur)
		if objet then
			hote = objet:FindFirstChildOfClass("AnimationController")
		end
	end
	if hote == nil then
		_avertirCible(action, valeur, "personnage")
		return nil
	end
	local animateur = hote:FindFirstChildOfClass("Animator")
	if animateur == nil and creer then
		if RunService:IsClient() then
			-- l'Animator d'un personnage est créé par le serveur : on lui laisse le temps d'arriver
			local trouve = hote:WaitForChild("Animator", 2)
			if trouve and trouve:IsA("Animator") then
				animateur = trouve
			end
		end
		if animateur == nil then
			animateur = Instance.new("Animator")
			animateur.Parent = hote
		end
	end
	return animateur
end]],
	},

	-- Piste d'animation (AnimationTrack), chargée une seule fois par Animator et par ID.
	-- Un nouvel Animator (réapparition…) fait oublier ceux des personnages qui ne sont plus dans le jeu.
	_tpPiste = {
		deps = { "_avertir" },
		services = {},
		code = [[
local function _tpPiste(etat, animateur, id)
	local cache = nil
	if type(etat) == "table" then
		etat.pistes = etat.pistes or setmetatable({}, { __mode = "k" })
		cache = etat.pistes[animateur]
		if cache == nil then
			for ancien in pairs(etat.pistes) do
				if ancien.Parent == nil then
					etat.pistes[ancien] = nil
				end
			end
			cache = {}
			etat.pistes[animateur] = cache
		end
		local dejaChargee = cache[id]
		if dejaChargee ~= nil then
			return dejaChargee
		end
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, piste = pcall(function()
		return animateur:LoadAnimation(animation)
	end)
	if not ok or piste == nil then
		_avertir("Impossible de charger l'animation « " .. id .. " » (" .. tostring(piste) .. ").")
		return nil
	end
	if cache then
		cache[id] = piste
	end
	return piste
end]],
	},

	-- Avertit (une fois) si une animation ne se charge pas (animation qui n'appartient pas au jeu…)
	_tpVerifierPiste = {
		deps = { "_tpAvertirUneFois" },
		services = {},
		code = [[
local function _tpVerifierPiste(etat, piste, id)
	if piste.Length > 0 then
		return
	end
	task.spawn(function()
		local attente = 0
		while piste.Length <= 0 and attente < 5 do
			attente += task.wait(0.25)
		end
		if piste.Length <= 0 then
			_tpAvertirUneFois(etat, "anim:" .. id, "L'animation « " .. id .. " » ne se charge pas. Pour être jouée dans ton jeu, une animation doit t'appartenir (ou appartenir au groupe à qui appartient le jeu), ou être une animation de Roblox. Vérifie aussi l'ID.")
		end
	end)
end]],
	},

	-- Attend la fin d'une piste ; une animation en boucle est jouée une seule fois puis arrêtée
	_tpAttendrePiste = {
		deps = {},
		services = {},
		code = [[
local function _tpAttendrePiste(piste, vitesse)
	local attente = 0
	while piste.Length <= 0 and attente < 3 do
		attente += task.wait(0.05)
	end
	if piste.Length <= 0 then
		return
	end
	local duree = piste.Length / math.max(math.abs(vitesse), 0.05)
	local debut = os.clock()
	-- pauses de 0,03 à 0,05 s : la fin (ou l'arrêt) de l'animation est vue à 0,05 s près
	while piste.IsPlaying do
		local reste = duree - (os.clock() - debut)
		if reste <= 0 then
			break
		end
		task.wait(math.clamp(reste, 0.03, 0.05))
	end
	if piste.Looped and piste.IsPlaying then
		piste:Stop(0.2)
	end
end]],
	},

	-- Joue une animation (ID, nombre ou rbxassetid://…) sur un personnage / joueur / PNJ
	_tpAnimation = {
		deps = {
			"_idSon",
			"_tpAnimateur",
			"_tpPiste",
			"_tpVerifierPiste",
			"_tpAttendrePiste",
			"_tpAvertirUneFois",
			"_nombreOu",
			"_avertir",
		},
		services = {},
		code = [[
local function _tpAnimation(etat, anim, valeur, vitesse, attendre)
	local id = _idSon(anim)
	if id ~= nil and string.find(id, "^https?://") then
		-- lien de page copié depuis le site (Creator Store…) : on garde le numéro de l'animation
		local chiffres = string.match(id, "(%d%d%d%d+)")
		id = nil
		if chiffres then
			id = "rbxassetid://" .. chiffres
		end
	end
	if id == nil then
		_avertir("« jouer l'animation » : ID d'animation vide ou invalide (" .. tostring(anim) .. "). Colle l'ID de ton animation : un nombre ou rbxassetid://….")
		return
	end
	local animateur = _tpAnimateur(valeur, "jouer l'animation", true)
	if animateur == nil then
		return
	end
	local hote = animateur.Parent
	if hote and hote:IsA("Humanoid") and hote.RigType == Enum.HumanoidRigType.R6 then
		local animationsR15 = {
			["rbxassetid://522635514"] = true,
			["rbxassetid://522638767"] = true,
			["rbxassetid://507770239"] = true,
			["rbxassetid://507771019"] = true,
			["rbxassetid://507776043"] = true,
			["rbxassetid://507770677"] = true,
			["rbxassetid://507770818"] = true,
			["rbxassetid://507770453"] = true,
		}
		if animationsR15[id] then
			local nom = "?"
			if hote.Parent then
				nom = hote.Parent.Name
			end
			_tpAvertirUneFois(etat, "r6:" .. nom, "« jouer l'animation » : les animations de la liste sont faites pour les personnages R15, mais « " .. nom .. " » est R6. Choisis R15 dans les paramètres du jeu (Avatar) ou joue ta propre animation R6.")
			return
		end
	end
	local piste = _tpPiste(etat, animateur, id)
	if piste == nil then
		return
	end
	local v = math.clamp(_nombreOu(vitesse, 1), 0, 20)
	local ok, erreur = pcall(function()
		if piste.IsPlaying then
			piste:Stop(0)
		end
		piste.Priority = Enum.AnimationPriority.Action
		piste:Play(0.1, 1, v)
	end)
	if not ok then
		_avertir("« jouer l'animation » : impossible de jouer « " .. id .. " » (" .. tostring(erreur) .. ").")
		return
	end
	_tpVerifierPiste(etat, piste, id)
	if attendre then
		_tpAttendrePiste(piste, v)
	end
end]],
	},

	-- Arrête les animations jouées (sauf celles de base : marcher, courir, sauter…)
	_tpArreterAnimations = {
		deps = { "_tpAnimateur" },
		services = {},
		code = [[
local function _tpArreterAnimations(valeur)
	local animateur = _tpAnimateur(valeur, "arrêter les animations", false)
	if animateur == nil then
		return
	end
	for _, piste in ipairs(animateur:GetPlayingAnimationTracks()) do
		if piste.Priority ~= Enum.AnimationPriority.Core then
			piste:Stop(0.2)
		end
	end
end]],
	},

	-- Boîte rouge transparente qui montre une hitbox pendant 0,2 s
	_tpMontrerBoite = {
		deps = {},
		services = { "Debris" },
		code = [[
local function _tpMontrerBoite(centre, taille)
	local boite = Instance.new("Part")
	boite.Name = "BlocsFR_Hitbox"
	boite.Anchored = true
	boite.CanCollide = false
	boite.CanQuery = false
	boite.CanTouch = false
	boite.CastShadow = false
	boite.Material = Enum.Material.SmoothPlastic
	boite.Color = Color3.fromRGB(255, 40, 40)
	boite.Transparency = 0.6
	boite.Size = taille
	boite.CFrame = centre
	boite.Parent = workspace
	Debris:AddItem(boite, 0.2)
end]],
	},

	-- Personnage (modèle avec un Humanoid) et son Humanoid pour une partie (membre, accessoire…), comme
	-- _perso. Cache par script (etat.persos) : clé faible = le parent de la partie (le personnage pour
	-- un membre, l'Accessory pour un accessoire), valeur = l'Humanoid ; vérifié à chaque usage. Toutes
	-- les 50 nouvelles clés, les personnages qui ne sont plus dans le jeu sont oubliés.
	_tpPersoDe = {
		deps = { "_perso" },
		services = {},
		code = [[
local function _tpPersoDe(etat, partie)
	if typeof(partie) ~= "Instance" then
		return nil, nil
	end
	local parent = partie.Parent
	if parent == nil then
		return nil, nil
	end
	local cache = nil
	if type(etat) == "table" then
		cache = etat.persos
		if cache == nil then
			cache = setmetatable({}, { __mode = "k" })
			etat.persos = cache
			etat.persosNouveaux = 0
		end
		local connu = cache[parent]
		if connu ~= nil then
			local modele = connu.Parent
			if modele ~= nil and (parent == modele or parent.Parent == modele) then
				return modele, connu
			end
			cache[parent] = nil
		end
	end
	local perso = _perso(partie)
	if perso == nil then
		return nil, nil
	end
	local h = perso:FindFirstChildOfClass("Humanoid")
	if cache ~= nil and h ~= nil and (parent == perso or parent.Parent == perso) then
		etat.persosNouveaux = (etat.persosNouveaux or 0) + 1
		if etat.persosNouveaux >= 50 then
			etat.persosNouveaux = 0
			for cle, hum in pairs(cache) do
				if cle.Parent == nil or hum.Parent == nil then
					cache[cle] = nil
				end
			end
		end
		cache[parent] = h
	end
	return perso, h
end]],
	},

	-- Ennemis (personnages avec un Humanoid en vie, joueurs ET PNJ) dans une boîte devant un
	-- personnage (ou devant une partie). Chaque personnage n'apparaît qu'une fois ; jamais l'attaquant.
	-- Renvoie la liste des personnages et (2e valeur) la liste de leurs Humanoid, dans le même ordre.
	-- Géométrie : boîte largeur × hauteur × profondeur, centrée à (0, 0, -(profondeur / 2 + d)) de la
	-- partie racine (HumanoidRootPart), d = 1 pour un personnage, la demi-profondeur (Size.Z / 2) de la
	-- partie sinon. Un seul OverlapParams par script (etat.paramsHitbox).
	_tpCiblesDevant = {
		deps = { "_perso", "_partie", "_obj", "_avertirCible", "_nombreOu", "_tpMontrerBoite", "_tpPersoDe" },
		services = {},
		code = [[
local function _tpCiblesDevant(etat, valeur, largeur, hauteur, profondeur, action)
	local cibles = {}
	local humanoides = {}
	local perso = _perso(valeur)
	local origine = nil
	if perso then
		origine = perso:FindFirstChild("HumanoidRootPart")
	end
	if origine == nil or not origine:IsA("BasePart") then
		origine = _partie(valeur)
	end
	if origine == nil then
		_avertirCible(action or "hitbox", valeur, "personnage")
		return cibles, humanoides
	end
	local exclu = perso or _obj(valeur) or origine
	largeur = math.clamp(_nombreOu(largeur, 5), 0.2, 200)
	hauteur = math.clamp(_nombreOu(hauteur, 5), 0.2, 200)
	profondeur = math.clamp(_nombreOu(profondeur, 6), 0.2, 200)
	local decalage = 1
	if perso == nil then
		decalage = origine.Size.Z / 2
	end
	local centre = origine.CFrame * CFrame.new(0, 0, -(profondeur / 2 + decalage))
	local taille = Vector3.new(largeur, hauteur, profondeur)
	local params = nil
	if type(etat) == "table" then
		params = etat.paramsHitbox
	end
	if params == nil then
		params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if type(etat) == "table" then
			etat.paramsHitbox = params
		end
	end
	params.FilterDescendantsInstances = { exclu }
	local ok, parties = pcall(workspace.GetPartBoundsInBox, workspace, centre, taille, params)
	if type(etat) == "table" and etat.montrer then
		_tpMontrerBoite(centre, taille)
	end
	if not ok or type(parties) ~= "table" then
		return cibles, humanoides
	end
	local parentsVus = {}
	local persosVus = {}
	for _, p in ipairs(parties) do
		-- les membres d'un personnage ont le même parent : il n'est examiné qu'une fois
		local parent = p.Parent
		if parent ~= nil and not parentsVus[parent] then
			parentsVus[parent] = true
			-- une partie d'accessoire compte pour son personnage
			local modele, h = _tpPersoDe(etat, p)
			if modele and modele ~= exclu and not persosVus[modele] then
				persosVus[modele] = true
				if h and h.Health > 0 then
					table.insert(cibles, modele)
					table.insert(humanoides, h)
				end
			end
		end
	end
	return cibles, humanoides
end]],
	},

	-- Hitbox devant un personnage : dégâts une fois à chaque ennemi. Renvoie le nombre d'ennemis touchés.
	_tpHitboxDegats = {
		deps = { "_tpCiblesDevant", "_nombreOu" },
		services = {},
		code = [[
local function _tpHitboxDegats(etat, valeur, largeur, hauteur, profondeur, degats)
	local cibles, humanoides = _tpCiblesDevant(etat, valeur, largeur, hauteur, profondeur, "hitbox")
	local d = math.max(_nombreOu(degats, 0), 0)
	for _, h in ipairs(humanoides) do
		h:TakeDamage(d)
	end
	return #cibles
end]],
	},

	-- Donne une vitesse à une partie pendant « duree » secondes (LinearVelocity : marche aussi pour
	-- les personnages des joueurs, car l'objet est répliqué vers le client qui les simule).
	_tpPoussee = {
		deps = {},
		services = { "Debris" },
		code = [[
local function _tpPoussee(partie, vitesse, duree)
	for _, enfant in ipairs(partie:GetChildren()) do
		if enfant.Name == "BlocsFR_Poussee" then
			enfant:Destroy()
		end
	end
	pcall(function()
		partie.AssemblyLinearVelocity = vitesse
	end)
	local attache = Instance.new("Attachment")
	attache.Name = "BlocsFR_Poussee"
	attache.Parent = partie
	local moteur = Instance.new("LinearVelocity")
	moteur.Name = "BlocsFR_Poussee"
	moteur.Attachment0 = attache
	moteur.RelativeTo = Enum.ActuatorRelativeTo.World
	moteur.MaxForce = math.huge
	moteur.VectorVelocity = vitesse
	moteur.Parent = partie
	Debris:AddItem(moteur, duree)
	Debris:AddItem(attache, duree)
end]],
	},

	-- Recul (knockback) : repousse la cible loin de la source, avec un petit saut
	_tpRepousser = {
		deps = { "_perso", "_partie", "_pos", "_pivot", "_nombreOu", "_avertir", "_tpPoussee" },
		services = {},
		code = [[
local function _tpRepousser(cible, source, force)
	local partie = nil
	local modele = _perso(cible)
	if modele then
		partie = modele:FindFirstChild("HumanoidRootPart")
	end
	if partie == nil or not partie:IsA("BasePart") then
		partie = _partie(cible)
	end
	if partie == nil then
		_avertir("« repousser » : rien à repousser (la cible est vide ou introuvable).")
		return
	end
	local racine = partie.AssemblyRootPart or partie
	if partie.Anchored or racine.Anchored then
		_avertir("« repousser » : « " .. partie.Name .. " » est ancré, il ne peut pas bouger.")
		return
	end
	local horizontal = Vector3.new(1, 0, 1)
	local direction = Vector3.zero
	local origine = _pos(source)
	if origine then
		direction = (partie.Position - origine) * horizontal
	end
	if direction.Magnitude < 0.05 then
		local cf = _pivot(source)
		if cf then
			direction = cf.LookVector * horizontal
		end
	end
	if direction.Magnitude < 0.05 then
		direction = -partie.CFrame.LookVector * horizontal
	end
	if direction.Magnitude < 0.05 then
		direction = Vector3.zAxis
	end
	local puissance = math.clamp(_nombreOu(force, 50), 0, 500)
	_tpPoussee(partie, direction.Unit * puissance + Vector3.new(0, puissance * 0.35, 0), 0.15)
end]],
	},

	-- Fait briller un personnage (ou un objet) en rouge pendant un court instant
	_tpFlash = {
		deps = { "_perso", "_obj", "_avertir" },
		services = { "Debris" },
		code = [[
local function _tpFlash(valeur)
	local modele = _perso(valeur)
	if modele == nil then
		modele = _obj(valeur)
	end
	if modele == nil or not (modele:IsA("Model") or modele:IsA("BasePart")) then
		_avertir("« faire clignoter en rouge » : personnage ou objet introuvable.")
		return
	end
	local ancien = modele:FindFirstChild("BlocsFR_Flash")
	if ancien then
		ancien:Destroy()
	end
	local eclat = Instance.new("Highlight")
	eclat.Name = "BlocsFR_Flash"
	eclat.FillColor = Color3.fromRGB(255, 40, 40)
	eclat.FillTransparency = 0.35
	eclat.OutlineColor = Color3.fromRGB(255, 255, 255)
	eclat.OutlineTransparency = 0.6
	eclat.DepthMode = Enum.HighlightDepthMode.Occluded
	eclat.Adornee = modele
	eclat.Parent = modele
	Debris:AddItem(eclat, 0.25)
end]],
	},

	-- Attaque toute prête : animation, impact après 0,25 s, hitbox 5 × 5 × portée devant le
	-- personnage (celle de _tpCiblesDevant), dégâts, recul, flash rouge et sons.
	_tpAttaqueMelee = {
		deps = {
			"_exigerPerso",
			"_tpAnimation",
			"_jouerSon",
			"_tpCiblesDevant",
			"_nombreOu",
			"_tpRepousser",
			"_tpFlash",
		},
		services = {},
		code = [[
local function _tpAttaqueMelee(etat, valeur, anim, degats, portee)
	local perso = _exigerPerso(valeur, "attaque")
	if perso == nil then
		return
	end
	local h = perso:FindFirstChildOfClass("Humanoid")
	if h == nil or h.Health <= 0 then
		return
	end
	if anim ~= nil and anim ~= "" then
		_tpAnimation(etat, anim, perso, 1, false)
	end
	_jouerSon("rbxasset://sounds/swordslash.wav", perso, 0.6)
	task.wait(0.25)
	if perso.Parent == nil or h.Health <= 0 then
		return
	end
	local cibles, humanoides = _tpCiblesDevant(etat, perso, 5, 5, portee, "attaque")
	local d = math.max(_nombreOu(degats, 0), 0)
	for i, cible in ipairs(cibles) do
		humanoides[i]:TakeDamage(d)
		_tpRepousser(cible, perso, 35)
		_tpFlash(cible)
	end
	if #cibles > 0 then
		_jouerSon("rbxasset://sounds/collide.wav", cibles[1], 0.5)
	end
end]],
	},

	-- Projectile : boule lumineuse qui avance droit devant (LinearVelocity, physique gérée par le
	-- serveur), détection des chocs par Spherecast entre deux images, dégâts au premier personnage.
	-- Tous les projectiles d'un script avancent avec UNE connexion Heartbeat (etat.projectiles),
	-- coupée quand il n'y en a plus. etat (_etatTP) est le dernier argument, facultatif.
	_tpProjectile = {
		deps = { "_perso", "_partie", "_obj", "_avertirCible", "_nombreOu", "_tpFlash", "_tpPersoDe" },
		services = { "Debris", "RunService" },
		code = [[
local function _tpProjectile(valeur, vitesse, degats, etat)
	local perso = _perso(valeur)
	local depart = nil
	if perso then
		depart = perso:FindFirstChild("HumanoidRootPart")
	end
	if depart == nil or not depart:IsA("BasePart") then
		depart = _partie(valeur)
	end
	if depart == nil then
		_avertirCible("lancer un projectile", valeur, "personnage")
		return
	end
	local tireur = perso or _obj(valeur) or depart
	vitesse = math.clamp(_nombreOu(vitesse, 80), 1, 1000)
	degats = math.max(_nombreOu(degats, 0), 0)
	local direction = depart.CFrame.LookVector
	local position = (depart.CFrame * CFrame.new(0, 0.5, -3)).Position
	local balle = Instance.new("Part")
	balle.Name = "BlocsFR_Projectile"
	balle.Shape = Enum.PartType.Ball
	balle.Size = Vector3.new(1.2, 1.2, 1.2)
	balle.Material = Enum.Material.Neon
	balle.Color = Color3.fromRGB(255, 140, 40)
	balle.CanCollide = false
	balle.CanQuery = false
	balle.CanTouch = false
	balle.CastShadow = false
	balle.CFrame = CFrame.new(position)
	local attache = Instance.new("Attachment")
	attache.Parent = balle
	local moteur = Instance.new("LinearVelocity")
	moteur.Attachment0 = attache
	moteur.RelativeTo = Enum.ActuatorRelativeTo.World
	moteur.MaxForce = math.huge
	moteur.VectorVelocity = direction * vitesse
	moteur.Parent = balle
	balle.Parent = workspace
	balle.AssemblyLinearVelocity = direction * vitesse
	if RunService:IsServer() then
		pcall(function()
			balle:SetNetworkOwner(nil)
		end)
	end
	Debris:AddItem(balle, 4)
	local ignores = { tireur, balle }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignores
	local precedente = position
	if depart:IsDescendantOf(tireur) then
		-- le tireur entier (personnage ou modèle) est ignoré : le premier balayage part de son centre,
		-- un peu en arrière, pour toucher aussi un ennemi ou un mur collé à lui (la balle apparaît
		-- 3 studs devant, et un balayage ne voit pas ce qui touche déjà la sphère à son départ)
		precedente = depart.Position - direction * 0.6
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.projectiles = etat.projectiles or {}
	table.insert(etat.projectiles, { balle = balle, precedente = precedente, ignores = ignores, params = params, degats = degats })
	if etat.connexionProjectiles ~= nil and etat.connexionProjectiles.Connected then
		return
	end
	-- Spherecast (lu une fois ; sans lui, un simple rayon)
	local okSphere, spherecast = pcall(function()
		return workspace.Spherecast
	end)
	if not okSphere then
		spherecast = nil
	end
	-- un pas de chaque projectile en vol (du dernier au premier : on peut retirer en parcourant)
	local function avancer(liste, i)
		local pr = liste[i]
		local b = pr.balle
		if b.Parent == nil then
			table.remove(liste, i)
			return
		end
		local actuelle = b.Position
		local trajet = actuelle - pr.precedente
		if trajet.Magnitude < 0.01 then
			return
		end
		local ok, resultat = false, nil
		if spherecast ~= nil then
			ok, resultat = pcall(spherecast, workspace, pr.precedente, 0.6, trajet, pr.params)
		end
		if not ok then
			resultat = workspace:Raycast(pr.precedente, trajet, pr.params)
		end
		pr.precedente = actuelle
		if resultat == nil then
			return
		end
		local touche, h = _tpPersoDe(etat, resultat.Instance)
		if touche == nil and not resultat.Instance.CanCollide then
			-- partie décorative sans collision : le projectile passe à travers
			table.insert(pr.ignores, resultat.Instance)
			pr.params.FilterDescendantsInstances = pr.ignores
			return
		end
		table.remove(liste, i)
		if touche and h and h.Health > 0 then
			h:TakeDamage(pr.degats)
			_tpFlash(touche)
		end
		b:Destroy()
	end
	etat.connexionProjectiles = RunService.Heartbeat:Connect(function()
		local liste = etat.projectiles
		for i = #liste, 1, -1 do
			avancer(liste, i)
		end
		if #liste == 0 and etat.connexionProjectiles ~= nil then
			etat.connexionProjectiles:Disconnect()
			etat.connexionProjectiles = nil
		end
	end)
end]],
	},

	-- Dash : bond rapide dans la direction de marche (ou droit devant) pendant 0,2 s
	_tpDash = {
		deps = { "_exigerPerso", "_nombreOu", "_avertir", "_tpPoussee", "_jouerSon" },
		services = {},
		code = [[
local function _tpDash(valeur, distance)
	local perso = _exigerPerso(valeur, "faire un dash")
	if perso == nil then
		return
	end
	local racine = perso:FindFirstChild("HumanoidRootPart")
	local h = perso:FindFirstChildOfClass("Humanoid")
	if racine == nil or not racine:IsA("BasePart") or h == nil or h.Health <= 0 then
		return
	end
	if racine.Anchored then
		_avertir("« faire un dash » : « " .. perso.Name .. " » est ancré, il ne peut pas bouger.")
		return
	end
	local longueur = math.clamp(_nombreOu(distance, 20), 0, 200)
	if longueur <= 0 then
		return
	end
	local horizontal = Vector3.new(1, 0, 1)
	local direction = h.MoveDirection * horizontal
	if direction.Magnitude < 0.1 then
		direction = racine.CFrame.LookVector * horizontal
	end
	if direction.Magnitude < 0.01 then
		return
	end
	local duree = 0.2
	_tpPoussee(racine, direction.Unit * (longueur / duree), duree)
	_jouerSon("rbxasset://sounds/swoosh.wav", racine, 0.5)
end]],
	},

	-- Invincibilité temporaire : champ de force + la vie ne peut pas baisser (les soins sont gardés).
	-- Appelé de nouveau pendant l'effet, le bloc prolonge seulement la durée. Pas de boucle : la fin
	-- est vérifiée par task.delay (et repoussée si la durée a été prolongée).
	_tpInvincible = {
		deps = { "_exigerHumanoid", "_nombreOu" },
		services = {},
		code = [[
local function _tpInvincible(etat, valeur, secondes)
	local h = _exigerHumanoid(valeur, "rendre invincible")
	if h == nil or h.Health <= 0 or h.Parent == nil then
		return
	end
	local duree = _nombreOu(secondes, 0)
	if duree <= 0 then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.invincibles = etat.invincibles or setmetatable({}, { __mode = "k" })
	local fin = os.clock() + duree
	local actuelle = etat.invincibles[h]
	if actuelle ~= nil then
		actuelle.fin = math.max(actuelle.fin, fin)
		return
	end
	local protection = { fin = fin }
	etat.invincibles[h] = protection
	local bouclier = Instance.new("ForceField")
	bouclier.Name = "BlocsFR_Invincible"
	bouclier.Parent = h.Parent
	local vie = h.Health
	local connexion = h.HealthChanged:Connect(function(nouvelle)
		if nouvelle > vie then
			vie = nouvelle
		elseif nouvelle < vie and nouvelle > 0 then
			h.Health = vie
		end
	end)
	local function verifier()
		local reste = protection.fin - os.clock()
		if reste > 0.01 and h.Parent ~= nil then
			-- durée prolongée entre-temps
			task.delay(reste, verifier)
			return
		end
		connexion:Disconnect()
		if etat.invincibles[h] == protection then
			etat.invincibles[h] = nil
		end
		if bouclier.Parent ~= nil then
			bouclier:Destroy()
		end
	end
	task.delay(duree, verifier)
end]],
	},

	-- Temps de recharge : vrai (et le temps repart) si la recharge de cette clé est terminée.
	-- La clé est le joueur (même après une réapparition), sinon le personnage, l'objet ou le texte.
	_tpRechargePrete = {
		deps = { "_joueur", "_perso", "_nombreOu" },
		services = {},
		code = [[
local function _tpRechargePrete(recharges, valeur, secondes)
	if type(recharges) ~= "table" then
		return true
	end
	local cle = "(tous)"
	if typeof(valeur) == "Instance" then
		cle = _joueur(valeur) or _perso(valeur) or valeur
	elseif valeur ~= nil then
		cle = tostring(valeur)
	end
	local maintenant = os.clock()
	local derniere = recharges[cle]
	if type(derniere) == "number" and maintenant - derniere < _nombreOu(secondes, 0) then
		return false
	end
	if derniere == nil and typeof(cle) == "Instance" then
		-- nouvelle clé : on oublie les joueurs / personnages / objets qui ne sont plus dans le jeu
		for ancienne in pairs(recharges) do
			if typeof(ancienne) == "Instance" and ancienne.Parent == nil then
				recharges[ancienne] = nil
			end
		end
	end
	recharges[cle] = maintenant
	return true
end]],
	},

	-- Barre de vie (BillboardGui « BlocsFR_BarreVie ») au-dessus de la tête ; une seule par personnage
	_tpBarreVie = {
		deps = { "_exigerHumanoid", "_partie", "_avertir" },
		services = {},
		code = [[
local function _tpBarreVie(valeur)
	local h = _exigerHumanoid(valeur, "afficher une barre de vie")
	if h == nil or h.Parent == nil then
		return
	end
	local perso = h.Parent
	local support = perso:FindFirstChild("Head")
	local hauteur = 2
	if support == nil or not support:IsA("BasePart") then
		support = _partie(perso)
		hauteur = 4
	end
	if support == nil then
		_avertir("« afficher une barre de vie » : « " .. perso.Name .. " » ne contient aucune partie.")
		return
	end
	for _, d in ipairs(perso:GetDescendants()) do
		if d.Name == "BlocsFR_BarreVie" and d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
	pcall(function()
		h.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end)
	local panneau = Instance.new("BillboardGui")
	panneau.Name = "BlocsFR_BarreVie"
	panneau.Size = UDim2.new(4, 0, 0.6, 0)
	panneau.StudsOffsetWorldSpace = Vector3.new(0, hauteur, 0)
	panneau.AlwaysOnTop = true
	panneau.LightInfluence = 0
	panneau.MaxDistance = 120
	panneau.Adornee = support
	local fond = Instance.new("Frame")
	fond.Name = "Fond"
	fond.Size = UDim2.fromScale(1, 1)
	fond.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	fond.BackgroundTransparency = 0.2
	fond.BorderSizePixel = 0
	fond.Parent = panneau
	local coinsFond = Instance.new("UICorner")
	coinsFond.CornerRadius = UDim.new(0.5, 0)
	coinsFond.Parent = fond
	local contour = Instance.new("UIStroke")
	contour.Color = Color3.fromRGB(0, 0, 0)
	contour.Thickness = 1.5
	contour.Parent = fond
	local remplissage = Instance.new("Frame")
	remplissage.Name = "Vie"
	remplissage.Size = UDim2.fromScale(1, 1)
	remplissage.BorderSizePixel = 0
	remplissage.Parent = fond
	local coinsVie = Instance.new("UICorner")
	coinsVie.CornerRadius = UDim.new(0.5, 0)
	coinsVie.Parent = remplissage
	local texte = Instance.new("TextLabel")
	texte.Name = "Texte"
	texte.Size = UDim2.fromScale(1, 1)
	texte.BackgroundTransparency = 1
	texte.Font = Enum.Font.GothamBold
	texte.TextScaled = true
	texte.TextColor3 = Color3.new(1, 1, 1)
	texte.TextStrokeTransparency = 0.3
	texte.ZIndex = 2
	texte.Parent = fond
	local rouge = Color3.fromRGB(230, 50, 50)
	local vert = Color3.fromRGB(70, 200, 90)
	local function mettreAJour()
		local vie = math.max(h.Health, 0)
		local maxi = math.max(h.MaxHealth, 1)
		local ratio = 1
		if maxi < math.huge then
			ratio = math.clamp(vie / maxi, 0, 1)
			texte.Text = tostring(math.ceil(vie)) .. " / " .. tostring(math.ceil(maxi))
		else
			-- (pas de symbole « infini » : la police Gotham ne l'a pas partout)
			texte.Text = "infinie"
		end
		remplissage.Size = UDim2.fromScale(ratio, 1)
		remplissage.BackgroundColor3 = rouge:Lerp(vert, ratio)
	end
	mettreAJour()
	panneau.Parent = support
	local connexions = {}
	local function suivre(signal)
		table.insert(connexions, signal:Connect(function()
			if panneau.Parent == nil then
				-- barre remplacée ou retirée : on arrête de la mettre à jour
				for _, c in ipairs(connexions) do
					c:Disconnect()
				end
				return
			end
			mettreAJour()
		end))
	end
	suivre(h.HealthChanged)
	suivre(h:GetPropertyChangedSignal("MaxHealth"))
end]],
	},

	-- Zone de dégâts (lave, poison…) : toutes les 0,25 s, chaque personnage dans (ou sur) une partie
	-- de l'objet perd dps / 4 points de vie (un dps négatif soigne). Une seule boucle pour toutes les
	-- zones du script (etat.zones : objet -> { dps, params, parties }) ; chaque zone garde son
	-- OverlapParams, et sa liste de parties est relue toutes les secondes.
	_tpZoneDegats = {
		deps = { "_obj", "_parties", "_partiesOuAvertir", "_tpPersoDe", "_nombreOu" },
		services = {},
		code = [[
local function _tpZoneDegats(etat, valeur, dps)
	local objet = _obj(valeur)
	if objet == nil or #_partiesOuAvertir(valeur, "zone de dégâts") == 0 then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.zones = etat.zones or setmetatable({}, { __mode = "k" })
	local zone = etat.zones[objet]
	if zone ~= nil then
		zone.dps = _nombreOu(dps, 0)
		return
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { objet }
	etat.zones[objet] = { dps = _nombreOu(dps, 0), params = params, parties = nil, relues = 0 }
	if etat.zonesActives then
		-- la boucle des zones de ce script tourne déjà : elle prend la nouvelle zone au prochain tour
		return
	end
	etat.zonesActives = true
	task.spawn(function()
		local marge = Vector3.new(1, 1, 1)
		while next(etat.zones) ~= nil do
			local maintenant = os.clock()
			local liste = {}
			for o, z in pairs(etat.zones) do
				table.insert(liste, { o, z })
			end
			for _, ligne in ipairs(liste) do
				local o, z = ligne[1], ligne[2]
				if o.Parent == nil then
					-- objet supprimé : le bloc pourra de nouveau l'armer s'il revient
					if etat.zones[o] == z then
						etat.zones[o] = nil
					end
				elseif z.dps ~= 0 and o:IsDescendantOf(workspace) then
					-- (rangé hors de Workspace, dans ServerStorage… : la zone est en pause)
					if z.parties == nil or maintenant - z.relues >= 1 then
						z.parties = _parties(o)
						z.relues = maintenant
					end
					local touches = {}
					local parentsVus = {}
					for _, partie in ipairs(z.parties) do
						if partie.Parent ~= nil then
							local ok, trouvees = pcall(workspace.GetPartBoundsInBox, workspace, partie.CFrame, partie.Size + marge, z.params)
							if ok and type(trouvees) == "table" then
								for _, p in ipairs(trouvees) do
									local parent = p.Parent
									if parent ~= nil and not parentsVus[parent] then
										parentsVus[parent] = true
										local perso, h = _tpPersoDe(etat, p)
										if perso ~= nil and h ~= nil then
											touches[perso] = h
										end
									end
								end
							end
						end
					end
					local parQuart = z.dps * 0.25
					for _, h in pairs(touches) do
						if h.Health > 0 then
							if parQuart > 0 then
								h:TakeDamage(parQuart)
							else
								h.Health = math.min(h.Health - parQuart, h.MaxHealth)
							end
						end
					end
				end
			end
			task.wait(0.25)
		end
		etat.zonesActives = false
	end)
end]],
	},

	-- Fait marcher un PNJ vers une cible (joueur, personnage, objet ou position)
	_tpMarcherVers = {
		deps = { "_humanoid", "_obj", "_pos", "_perso", "_tpAvertirUneFois" },
		services = { "RunService" },
		code = [[
local function _tpMarcherVers(etat, valeur, cible)
	local h = _humanoid(valeur)
	if h == nil or h.Parent == nil then
		local objet = _obj(valeur)
		local nom = "?"
		if objet then
			nom = objet.Name
		end
		_tpAvertirUneFois(etat, "pnj:" .. nom, "« faire marcher » : « " .. nom .. " » n'est pas un PNJ (il faut un modèle qui contient un Humanoid).")
		return
	end
	if h.Health <= 0 then
		return
	end
	local pnj = h.Parent
	local destination = _pos(cible)
	if destination == nil or _perso(cible) == pnj then
		-- pas de cible pour l'instant (par exemple aucun joueur) : rien à faire
		return
	end
	local racine = pnj:FindFirstChild("HumanoidRootPart")
	if racine and racine:IsA("BasePart") then
		if racine.Anchored then
			_tpAvertirUneFois(etat, "ancre:" .. pnj.Name, "« faire marcher » : « " .. pnj.Name .. " » est ancré, il ne peut pas marcher. Utilise « ancrer … : non ».")
			return
		end
		if type(etat) == "table" then
			etat.proprietaires = etat.proprietaires or setmetatable({}, { __mode = "k" })
		end
		if RunService:IsServer() and not (type(etat) == "table" and etat.proprietaires[racine]) then
			-- le serveur garde la physique du PNJ : mouvement plus régulier (une fois par PNJ)
			local ok = pcall(function()
				if racine:GetNetworkOwner() ~= nil then
					racine:SetNetworkOwner(nil)
				end
			end)
			if ok and type(etat) == "table" then
				etat.proprietaires[racine] = true
			end
		end
	end
	h:MoveTo(destination)
end]],
	},

	-- Ennemi tout prêt : poursuit le joueur en vie le plus proche (80 studs) et le frappe (1 coup / s).
	-- En pause tant que le PNJ est rangé hors de Workspace. Une seule boucle (0,2 s) pour tous les PNJ
	-- ennemis du script (etat.ennemis : pnj -> { h, degats, dernierCoup, proprietaire }) ; les joueurs
	-- en vie sont lus une seule fois par tour pour tous les PNJ.
	_tpPnjEnnemi = {
		deps = {
			"_humanoid",
			"_obj",
			"_partie",
			"_nombreOu",
			"_avertir",
			"_tpFlash",
			"_tpRepousser",
			"_tpAnimation",
		},
		services = { "Players", "RunService" },
		code = [[
local function _tpPnjEnnemi(etat, valeur, degats)
	local h = _humanoid(valeur)
	if h == nil or h.Parent == nil then
		local objet = _obj(valeur)
		local nom = "?"
		if objet then
			nom = objet.Name
		end
		_avertir("« ennemi qui poursuit les joueurs » : « " .. nom .. " » n'est pas un PNJ (il faut un modèle qui contient un Humanoid).")
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.ennemis = etat.ennemis or setmetatable({}, { __mode = "k" })
	local pnj = h.Parent
	local ennemi = etat.ennemis[pnj]
	if ennemi ~= nil then
		ennemi.degats = math.max(_nombreOu(degats, 10), 0)
		return
	end
	etat.ennemis[pnj] = { h = h, degats = math.max(_nombreOu(degats, 10), 0), dernierCoup = 0, proprietaire = false }
	if etat.ennemisActifs then
		-- la boucle des ennemis de ce script tourne déjà : elle prend ce PNJ au prochain tour
		return
	end
	etat.ennemisActifs = true
	task.spawn(function()
		while next(etat.ennemis) ~= nil do
			-- joueurs en vie (un joueur mort garde son personnage jusqu'à sa réapparition)
			local joueurs = {}
			for _, joueur in ipairs(Players:GetPlayers()) do
				local c = joueur.Character
				if c then
					local hc = c:FindFirstChildOfClass("Humanoid")
					local rc = c:FindFirstChild("HumanoidRootPart")
					if hc and hc.Health > 0 and rc and rc:IsA("BasePart") then
						table.insert(joueurs, { perso = c, h = hc, position = rc.Position })
					end
				end
			end
			local liste = {}
			for p, e in pairs(etat.ennemis) do
				table.insert(liste, { p, e })
			end
			for _, ligne in ipairs(liste) do
				local p, e = ligne[1], ligne[2]
				local hp = e.h
				if p.Parent == nil or hp.Parent ~= p or hp.Health <= 0 then
					-- PNJ mort ou supprimé : le bloc pourra de nouveau l'armer
					if etat.ennemis[p] == e then
						etat.ennemis[p] = nil
					end
				elseif p:IsDescendantOf(workspace) then
					-- (rangé ailleurs, dans ServerStorage… : en pause, il reprend si on le remet dans Workspace)
					local racine = p:FindFirstChild("HumanoidRootPart")
					if racine == nil or not racine:IsA("BasePart") then
						racine = _partie(p)
					end
					if racine then
						if not e.proprietaire and RunService:IsServer() then
							e.proprietaire = true
							pcall(function()
								racine:SetNetworkOwner(nil)
							end)
						end
						local origine = racine.Position
						local cible = nil
						local distance = math.huge
						for _, j in ipairs(joueurs) do
							if j.perso ~= p then
								local d = (j.position - origine).Magnitude
								if d < distance then
									cible, distance = j, d
								end
							end
						end
						if cible ~= nil and distance <= 80 then
							hp:MoveTo(cible.position)
							if distance <= 5 and cible.h.Health > 0 and os.clock() - e.dernierCoup >= 1 then
								e.dernierCoup = os.clock()
								cible.h:TakeDamage(e.degats)
								_tpFlash(cible.perso)
								_tpRepousser(cible.perso, p, 30)
								if hp.RigType == Enum.HumanoidRigType.R15 then
									-- dans son propre fil : un chargement d'animation ne retarde pas les autres PNJ
									task.spawn(_tpAnimation, etat, "rbxassetid://522635514", p, 1.2, false)
								end
							end
						end
					end
				end
			end
			task.wait(0.2)
		end
		etat.ennemisActifs = false
	end)
end]],
	},

	-- Ennemis (personnages en vie, joueurs et PNJ) autour d'un personnage ou d'un objet,
	-- du plus proche au plus lointain : { { modele = Model, distance = n }, … }
	-- etat (_etatTP, dernier argument, facultatif) : OverlapParams réutilisé et cache des personnages.
	_tpEnnemisAutour = {
		deps = { "_pos", "_perso", "_obj", "_partie", "_nombreOu", "_tpPersoDe" },
		services = {},
		code = [[
local function _tpEnnemisAutour(valeur, rayon, etat)
	local liste = {}
	local centre = _pos(valeur)
	if centre == nil then
		return liste
	end
	local r = math.clamp(_nombreOu(rayon, 15), 0, 1000)
	local soi = _perso(valeur) or _obj(valeur)
	local params = nil
	if type(etat) == "table" then
		params = etat.paramsRayon
	end
	if params == nil then
		params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if type(etat) == "table" then
			etat.paramsRayon = params
		end
	end
	if soi then
		params.FilterDescendantsInstances = { soi }
	else
		params.FilterDescendantsInstances = {}
	end
	local ok, parties = pcall(workspace.GetPartBoundsInRadius, workspace, centre, r, params)
	if not ok or type(parties) ~= "table" then
		return liste
	end
	local parentsVus = {}
	local vus = {}
	for _, p in ipairs(parties) do
		-- les membres d'un personnage ont le même parent : il n'est examiné qu'une fois
		local parent = p.Parent
		local modele, h = nil, nil
		if parent ~= nil and not parentsVus[parent] then
			parentsVus[parent] = true
			modele, h = _tpPersoDe(etat, p)
		end
		if modele and modele ~= soi and not vus[modele] then
			vus[modele] = true
			if h and h.Health > 0 then
				local racine = _partie(modele)
				local distance = math.huge
				if racine then
					distance = (racine.Position - centre).Magnitude
				end
				table.insert(liste, { modele = modele, distance = distance })
			end
		end
	end
	table.sort(liste, function(x, y)
		return x.distance < y.distance
	end)
	return liste
end]],
	},

	-- L'ennemi le plus proche (personnage) ou nil ; etat (_etatTP) facultatif, en dernier
	_tpEnnemiProche = {
		deps = { "_tpEnnemisAutour" },
		services = {},
		code = [[
local function _tpEnnemiProche(valeur, rayon, etat)
	local premier = _tpEnnemisAutour(valeur, rayon, etat)[1]
	if premier then
		return premier.modele
	end
	return nil
end]],
	},

	---------------------------------------------------------------------------
	-- Systèmes de jeu tout prêts (SPEC §22.1) : outils communs
	---------------------------------------------------------------------------

	-- Table commune à tous les scripts du même côté (serveur, ou joueur local) : ce qui doit être
	-- unique dans le jeu (réapparition sur les points de sauvegarde, cycle jour/nuit, sauvegarde)
	_tpPartage = {
		deps = {},
		services = {},
		code = [[
local function _tpPartage()
	local partage = shared.BlocsFR_ToutPrets
	if type(partage) ~= "table" then
		partage = {}
		shared.BlocsFR_ToutPrets = partage
	end
	return partage
end]],
	},

	-- Objet d'un système tout prêt : une partie ou un modèle qui contient des parties.
	-- Renvoie l'objet et ses parties, ou nil + avertissement (une seule fois par script).
	_tpObjetValide = {
		deps = { "_obj", "_parties", "_estProtege", "_tpAvertirUneFois" },
		services = {},
		code = [[
local function _tpObjetValide(etat, valeur, action)
	local objet = _obj(valeur)
	if objet == nil then
		_tpAvertirUneFois(etat, action .. ":introuvable", "« " .. action .. " » : objet introuvable.")
		return nil, nil
	end
	if _estProtege(objet) or not (objet:IsA("BasePart") or objet:IsA("Model")) then
		_tpAvertirUneFois(etat, action .. ":" .. objet:GetFullName(), "« " .. action .. " » : place le script dans une partie ou un modèle (pas dans « " .. objet.Name .. " »), ou choisis l'objet avec « objet nommé … ».")
		return nil, nil
	end
	local parties = _parties(objet)
	if #parties == 0 then
		_tpAvertirUneFois(etat, action .. ":vide:" .. objet:GetFullName(), "« " .. action .. " » : « " .. objet.Name .. " » ne contient aucune partie.")
		return nil, nil
	end
	return objet, parties
end]],
	},

	-- Destination donnée par un nom d'objet, un objet, un joueur (son personnage) ou une position.
	-- Renvoie un objet (Instance), une position (Vector3) ou nil.
	_tpCible = {
		deps = { "_obj", "_objetNomme" },
		services = {},
		code = [[
local function _tpCible(valeur)
	local t = typeof(valeur)
	if t == "Vector3" then
		return valeur
	elseif t == "CFrame" then
		return valeur.Position
	elseif t == "Instance" then
		local objet = _obj(valeur)
		if objet ~= nil and objet.Parent ~= nil then
			return objet
		end
	elseif (t == "string" and valeur ~= "") or t == "number" then
		local trouve = _objetNomme(valeur)
		if typeof(trouve) == "Instance" then
			return _obj(trouve)
		end
	end
	return nil
end]],
	},

	-- Fait briller un objet d'une couleur pendant « duree » secondes (Highlight « BlocsFR_Eclat »)
	_tpEclat = {
		deps = {},
		services = { "Debris" },
		code = [[
local function _tpEclat(objet, couleur, duree)
	if typeof(objet) ~= "Instance" or objet.Parent == nil then
		return
	end
	local ancien = objet:FindFirstChild("BlocsFR_Eclat")
	if ancien ~= nil then
		ancien:Destroy()
	end
	local eclat = Instance.new("Highlight")
	eclat.Name = "BlocsFR_Eclat"
	eclat.FillColor = couleur
	eclat.FillTransparency = 0.35
	eclat.OutlineColor = Color3.new(1, 1, 1)
	eclat.OutlineTransparency = 0.2
	eclat.DepthMode = Enum.HighlightDepthMode.Occluded
	eclat.Adornee = objet
	eclat.Parent = objet
	Debris:AddItem(eclat, duree)
end]],
	},

	-- Cache un objet : parties invisibles, traversables et sans contact ; images, lumières, textes et
	-- effets éteints. Renvoie la fonction qui remet tout comme avant.
	_tpCacher = {
		deps = {},
		services = {},
		code = [[
local function _tpCacher(objet)
	local sauve = {}
	local liste = objet:GetDescendants()
	table.insert(liste, objet)
	for _, d in ipairs(liste) do
		if d:IsA("BasePart") then
			table.insert(sauve, { d, "Transparency", d.Transparency })
			table.insert(sauve, { d, "CanCollide", d.CanCollide })
			table.insert(sauve, { d, "CanTouch", d.CanTouch })
			d.Transparency = 1
			d.CanCollide = false
			d.CanTouch = false
		elseif d:IsA("Decal") then
			table.insert(sauve, { d, "Transparency", d.Transparency })
			d.Transparency = 1
		elseif d:IsA("LayerCollector") or d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") or d:IsA("Trail") or d:IsA("Beam") then
			table.insert(sauve, { d, "Enabled", d.Enabled })
			d.Enabled = false
		end
	end
	return function()
		for _, ligne in ipairs(sauve) do
			local instance, propriete, valeur = ligne[1], ligne[2], ligne[3]
			if instance.Parent ~= nil then
				pcall(function()
					instance[propriete] = valeur
				end)
			end
		end
	end
end]],
	},

	-- Anime une partie (sa CFrame) ou un modèle (son pivot, via une CFrameValue) avec TweenService.
	-- arrivee : la CFrame de la partie, ou le pivot du modèle. Renvoie le Tween, déjà lancé.
	_tpTween = {
		deps = {},
		services = { "TweenService" },
		code = [[
local function _tpTween(objet, info, arrivee)
	if objet:IsA("BasePart") then
		local tween = TweenService:Create(objet, info, { CFrame = arrivee })
		tween:Play()
		return tween
	end
	local support = Instance.new("CFrameValue")
	support.Value = objet:GetPivot()
	local connexion = support.Changed:Connect(function(cf)
		if objet.Parent ~= nil then
			objet:PivotTo(cf)
		end
	end)
	local tween = TweenService:Create(support, info, { Value = arrivee })
	tween.Completed:Once(function()
		connexion:Disconnect()
		support:Destroy()
	end)
	tween:Play()
	return tween
end]],
	},

	---------------------------------------------------------------------------
	-- Systèmes de jeu tout prêts : un bloc = un système
	---------------------------------------------------------------------------

	-- « sprint » : touche gardée appuyée -> WalkSpeed = vitesse ; relâchée -> la vitesse d'avant.
	-- Une seule installation par script ; le personnage est relu à chaque appui (réapparitions).
	_tpSprint = {
		deps = { "_tpAvertirUneFois", "_nombreOu", "_humanoid", "_lettreTouche", "_toucheIgnoree" },
		services = { "RunService", "UserInputService" },
		code = [[
local function _tpSprint(etat, touche, vitesse)
	if not RunService:IsClient() then
		_tpAvertirUneFois(etat, "sprint:serveur", "« sprint » ne fonctionne que dans un script local (il écoute le clavier du joueur) : mets-le dans un script local, par exemple dans StarterPlayerScripts.")
		return
	end
	if typeof(touche) ~= "EnumItem" or touche.EnumType ~= Enum.KeyCode then
		_tpAvertirUneFois(etat, "sprint:touche", "« sprint » : touche invalide (" .. tostring(touche) .. ").")
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	local v = math.clamp(_nombreOu(vitesse, 28), 0, 1000)
	local sprint = etat.sprint
	if sprint ~= nil then
		-- déjà installé dans ce script : on change seulement la touche et la vitesse
		sprint.touche = touche
		sprint.vitesse = v
		return
	end
	sprint = { touche = touche, vitesse = v, humanoid = nil, avant = 16, mise = v }
	etat.sprint = sprint
	local function estLaTouche(entree)
		local nom = sprint.touche.Name
		if #nom == 1 and string.match(nom, "^%u$") then
			-- une lettre : celle qui est écrite sur la touche (clavier AZERTY, QWERTY…)
			return _lettreTouche(entree) == nom
		end
		return entree.KeyCode == sprint.touche
	end
	local function arreter()
		local h = sprint.humanoid
		sprint.humanoid = nil
		-- la vitesse d'avant revient, sauf si un autre bloc l'a changée pendant le sprint
		if h ~= nil and h.Parent ~= nil and math.abs(h.WalkSpeed - sprint.mise) < 0.01 then
			h.WalkSpeed = sprint.avant
		end
	end
	UserInputService.InputBegan:Connect(function(entree, dejaTraite)
		if sprint.humanoid ~= nil or not estLaTouche(entree) or _toucheIgnoree(entree, dejaTraite) then
			return
		end
		local h = _humanoid(nil)
		if h == nil or h.Health <= 0 then
			return
		end
		sprint.humanoid = h
		sprint.avant = h.WalkSpeed
		sprint.mise = sprint.vitesse
		h.WalkSpeed = sprint.vitesse
	end)
	UserInputService.InputEnded:Connect(function(entree)
		if sprint.humanoid ~= nil and estLaTouche(entree) then
			arreter()
		end
	end)
	UserInputService.WindowFocusReleased:Connect(arreter)
end]],
	},

	-- « double saut » : saut demandé en chute libre avec des sauts restants -> ChangeState(Jumping).
	-- Les sauts en l'air reviennent à l'atterrissage ; chaque nouveau personnage est suivi.
	_tpDoubleSaut = {
		deps = { "_tpAvertirUneFois", "_nombreOu", "_humanoid" },
		services = { "Players", "RunService", "UserInputService" },
		code = [[
local function _tpDoubleSaut(etat, sauts)
	if not RunService:IsClient() then
		_tpAvertirUneFois(etat, "doubleSaut:serveur", "« double saut » ne fonctionne que dans un script local (il écoute les sauts du joueur) : mets-le dans un script local, par exemple dans StarterPlayerScripts.")
		return
	end
	local joueurLocal = Players.LocalPlayer
	if joueurLocal == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	local n = math.clamp(math.floor(_nombreOu(sauts, 1)), 0, 20)
	local saut = etat.doubleSaut
	if saut ~= nil then
		saut.sauts = n
		return
	end
	saut = { sauts = n, restants = n, depuis = 0 }
	etat.doubleSaut = saut
	local function suivre(perso)
		local h = perso:FindFirstChildOfClass("Humanoid") or perso:WaitForChild("Humanoid", 10)
		if h == nil or not h:IsA("Humanoid") then
			return
		end
		saut.restants = saut.sauts
		h.StateChanged:Connect(function(_, nouvel)
			if nouvel == Enum.HumanoidStateType.Freefall then
				saut.depuis = os.clock()
			elseif nouvel == Enum.HumanoidStateType.Landed or nouvel == Enum.HumanoidStateType.Running or nouvel == Enum.HumanoidStateType.Swimming or nouvel == Enum.HumanoidStateType.Climbing then
				saut.restants = saut.sauts
			end
		end)
	end
	joueurLocal.CharacterAdded:Connect(suivre)
	if joueurLocal.Character ~= nil then
		task.spawn(suivre, joueurLocal.Character)
	end
	UserInputService.JumpRequest:Connect(function()
		local h = _humanoid(nil)
		if h == nil or h.Health <= 0 or saut.restants <= 0 then
			return
		end
		-- en chute libre depuis au moins 0,2 s : sinon le saut normal compterait comme un saut en l'air
		if h:GetState() ~= Enum.HumanoidStateType.Freefall or os.clock() - saut.depuis < 0.2 then
			return
		end
		saut.restants -= 1
		saut.depuis = os.clock()
		h:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
end]],
	},

	-- « point de sauvegarde » : le dernier point touché par un joueur est gardé dans _tpPartage (commun
	-- à tous les scripts) ; à chaque apparition de son personnage, il est posé dessus. La réapparition
	-- est installée une seule fois pour tous les scripts ; si le script qui l'avait installée disparaît,
	-- le prochain point touché (ou le prochain bloc) la réinstalle.
	_tpPointSauvegarde = {
		deps = { "_tpObjetValide", "_tpPartage", "_tpPersoDe", "_teleporterJoueurSur", "_tpEclat", "_jouerSon" },
		services = { "Players", "RunService" },
		code = [[
local function _tpPointSauvegarde(etat, valeur)
	local objet, parties = _tpObjetValide(etat, valeur, "point de sauvegarde")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.sauvegardes = etat.sauvegardes or setmetatable({}, { __mode = "k" })
	if etat.sauvegardes[objet] then
		return
	end
	etat.sauvegardes[objet] = true
	local client = RunService:IsClient()
	local partage = _tpPartage()
	partage.points = partage.points or setmetatable({}, { __mode = "k" })
	local points = partage.points
	local function surPerso(p, perso)
		local attente = 0
		while perso.Parent == nil and attente < 10 do
			attente += task.wait(0.1)
		end
		if perso:WaitForChild("HumanoidRootPart", 10) == nil then
			return
		end
		-- on laisse Roblox poser le personnage sur son point d'apparition, puis on le déplace
		task.wait(0.1)
		local point = points[p]
		if point ~= nil and point.Parent ~= nil and p.Character == perso then
			_teleporterJoueurSur(perso, point)
		end
	end
	local function suivre(p)
		return p.CharacterAdded:Connect(function(perso)
			surPerso(p, perso)
		end)
	end
	local function installer()
		if partage.reapparition ~= nil and partage.reapparition.Connected then
			return
		end
		if client then
			if Players.LocalPlayer ~= nil then
				partage.reapparition = suivre(Players.LocalPlayer)
			end
		else
			partage.reapparition = Players.PlayerAdded:Connect(suivre)
			for _, p in ipairs(Players:GetPlayers()) do
				suivre(p)
			end
		end
	end
	installer()
	local deja = setmetatable({}, { __mode = "k" })
	local function touche(autre)
		local perso, h = _tpPersoDe(etat, autre)
		if perso == nil or h == nil or h.Health <= 0 then
			return
		end
		local p = Players:GetPlayerFromCharacter(perso)
		if p == nil then
			return
		end
		if client and p ~= Players.LocalPlayer then
			return
		end
		if points[p] ~= objet then
			points[p] = objet
			installer()
		end
		if not deja[p] then
			-- la première fois pour ce joueur : l'objet brille en vert (et on oublie les joueurs partis)
			for ancien in pairs(deja) do
				if ancien.Parent == nil then
					deja[ancien] = nil
				end
			end
			deja[p] = true
			_tpEclat(objet, Color3.fromRGB(47, 191, 90), 0.6)
			_jouerSon("rbxasset://sounds/electronicpingshort.wav", objet, 0.6)
		end
	end
	for _, partie in ipairs(parties) do
		partie.Touched:Connect(touche)
	end
end]],
	},

	-- « téléporter qui touche … vers … » : 1 s de pause par personnage, pour TOUS les téléporteurs
	-- (attribut « BlocsFR_Teleporte » du personnage) : pas d'allers-retours entre deux téléporteurs.
	_tpTeleporteur = {
		deps = {
			"_tpObjetValide",
			"_tpCible",
			"_tpPersoDe",
			"_texte",
			"_placerPerso",
			"_teleporterJoueurSur",
			"_tpAvertirUneFois",
		},
		services = { "Players", "RunService" },
		code = [[
local function _tpTeleporteur(etat, valeur, cible)
	local objet, parties = _tpObjetValide(etat, valeur, "téléporter qui touche")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.teleporteurs = etat.teleporteurs or setmetatable({}, { __mode = "k" })
	local reglage = etat.teleporteurs[objet]
	if reglage ~= nil then
		reglage.cible = cible
		reglage.echec = nil
		reglage.destination = nil
		return
	end
	-- destination : gardée en mémoire après la première recherche (cherchée de nouveau si elle a disparu)
	reglage = { cible = cible, echec = nil, destination = nil }
	etat.teleporteurs[objet] = reglage
	local client = RunService:IsClient()
	local function touche(autre)
		local perso, h = _tpPersoDe(etat, autre)
		if perso == nil or perso == objet or h == nil or h.Health <= 0 then
			return
		end
		if client and Players:GetPlayerFromCharacter(perso) ~= Players.LocalPlayer then
			return
		end
		local maintenant = os.clock()
		local dernier = perso:GetAttribute("BlocsFR_Teleporte")
		if type(dernier) == "number" and maintenant - dernier < 1 then
			return
		end
		if reglage.echec ~= nil and maintenant - reglage.echec < 1 then
			return
		end
		local destination = reglage.destination
		if typeof(destination) == "Instance" and destination.Parent == nil then
			destination = nil
		end
		if destination == nil then
			destination = _tpCible(reglage.cible)
			reglage.destination = destination
		end
		if destination == nil then
			reglage.echec = maintenant
			_tpAvertirUneFois(etat, "teleporteur:" .. _texte(reglage.cible), "« téléporter qui touche » : la destination « " .. _texte(reglage.cible) .. " » est introuvable. Crée une partie avec ce nom (ancrée, transparente et sans collision) là où les joueurs doivent arriver.")
			return
		end
		if typeof(destination) == "Instance" and (destination == objet or destination:IsDescendantOf(objet)) then
			reglage.echec = maintenant
			_tpAvertirUneFois(etat, "teleporteur:soi", "« téléporter qui touche » : la destination est le téléporteur lui-même. Choisis une autre partie.")
			return
		end
		perso:SetAttribute("BlocsFR_Teleporte", maintenant)
		if typeof(destination) == "Vector3" then
			_placerPerso(perso, destination + Vector3.new(0, 4, 0))
		else
			_teleporterJoueurSur(perso, destination)
		end
	end
	for _, partie in ipairs(parties) do
		partie.Touched:Connect(touche)
	end
end]],
	},

	-- « … se ramasse : + n Stat, revient après … s » : un seul joueur ramasse l'objet ; il est caché
	-- (puis remis) ou détruit si le délai vaut 0.
	_tpRamasser = {
		deps = { "_tpObjetValide", "_tpPersoDe", "_ajouterStat", "_jouerSon", "_tpCacher", "_nombreOu", "_texte" },
		services = { "Players", "RunService" },
		code = [[
local function _tpRamasser(etat, valeur, quantite, stat, delai)
	local objet, parties = _tpObjetValide(etat, valeur, "se ramasse")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.ramassables = etat.ramassables or setmetatable({}, { __mode = "k" })
	local reglage = etat.ramassables[objet]
	if reglage == nil then
		reglage = { pris = false, quantite = 1, stat = "", delai = 5 }
		etat.ramassables[objet] = reglage
		local client = RunService:IsClient()
		local function touche(autre)
			if reglage.pris or objet.Parent == nil then
				return
			end
			local perso, h = _tpPersoDe(etat, autre)
			if perso == nil or h == nil or h.Health <= 0 then
				return
			end
			local p = Players:GetPlayerFromCharacter(perso)
			if p == nil then
				return
			end
			if client and p ~= Players.LocalPlayer then
				return
			end
			reglage.pris = true
			_ajouterStat(p, reglage.stat, reglage.quantite)
			_jouerSon("rbxasset://sounds/electronicpingshort.wav", perso, 0.5)
			local restaurer = _tpCacher(objet)
			if reglage.delai <= 0 then
				-- délai 0 : l'objet est détruit pour de bon, 1 s plus tard (caché d'ici là) : si ce script
				-- est dans l'objet, il a le temps de finir le son joué dans le personnage (sinon le son
				-- resterait dans le personnage jusqu'à sa réapparition)
				task.delay(1, function()
					if objet.Parent ~= nil then
						objet:Destroy()
					end
				end)
				return
			end
			task.delay(reglage.delai, function()
				if objet.Parent ~= nil then
					restaurer()
				end
				reglage.pris = false
			end)
		end
		for _, partie in ipairs(parties) do
			partie.Touched:Connect(touche)
		end
	end
	reglage.quantite = _nombreOu(quantite, 1)
	reglage.stat = _texte(stat)
	reglage.delai = math.max(_nombreOu(delai, 5), 0)
end]],
	},

	-- « générer une copie de … toutes les … s (max …) » : l'original est copié une fois en mémoire
	-- (sans ce script s'il est dedans : sinon les copies se multiplieraient), puis cette copie
	-- privée sert de modèle. Seules les copies encore dans Workspace comptent pour le maximum.
	-- Une seule boucle pour tous les générateurs du script (etat.generateurs) : elle dort jusqu'au
	-- prochain générateur prêt (0,5 s au plus, au moins 0,03 s).
	_tpGenerateur = {
		deps = { "_obj", "_pos", "_pivot", "_texte", "_nombreOu", "_estProtege", "_tpAvertirUneFois" },
		services = {},
		code = [[
local function _tpGenerateur(etat, modele, delai, maxi)
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.generateurs = etat.generateurs or {}
	local cle = modele
	if typeof(modele) ~= "Instance" then
		cle = _texte(modele)
	end
	local d = math.clamp(_nombreOu(delai, 3), 0.1, 3600)
	local m = math.clamp(math.floor(_nombreOu(maxi, 10)), 0, 500)
	local reglage = etat.generateurs[cle]
	if reglage ~= nil then
		reglage.delai = d
		reglage.max = m
		return
	end
	reglage = { delai = d, max = m, copies = {}, gabarit = nil, prochain = 0, generer = nil }
	etat.generateurs[cle] = reglage
	local origine = script.Parent
	local nomModele = _texte(modele)
	-- l'original : l'objet donné, ou cherché par son nom dans ServerStorage, ReplicatedStorage,
	-- Workspace puis Lighting
	local function trouver()
		if typeof(modele) == "Instance" then
			return _obj(modele)
		end
		if nomModele == "" then
			return nil
		end
		for _, nomService in ipairs({ "ServerStorage", "ReplicatedStorage", "Workspace", "Lighting" }) do
			local ok, service = pcall(function()
				return game:GetService(nomService)
			end)
			if ok and service then
				local trouve = service:FindFirstChild(nomModele, true)
				if trouve then
					return trouve
				end
			end
		end
		return nil
	end
	local function gabarit()
		if reglage.gabarit ~= nil then
			return reglage.gabarit
		end
		local original = trouver()
		if original == nil then
			_tpAvertirUneFois(etat, "generateur:" .. nomModele, "« générer une copie » : aucun objet nommé « " .. nomModele .. " » dans ServerStorage, ReplicatedStorage ou Workspace.")
			return nil
		end
		if _estProtege(original) or not (original:IsA("PVInstance") or original:IsA("Tool")) then
			_tpAvertirUneFois(etat, "generateur:type:" .. original.Name, "« générer une copie » : « " .. original.Name .. " » n'est ni une partie, ni un modèle, ni un outil.")
			return nil
		end
		local scriptDedans = script:IsDescendantOf(original)
		local archivableScript = script.Archivable
		local archivableObjet = original.Archivable
		if scriptDedans then
			script.Archivable = false
		end
		original.Archivable = true
		local ok, copie = pcall(function()
			return original:Clone()
		end)
		original.Archivable = archivableObjet
		if scriptDedans then
			script.Archivable = archivableScript
		end
		if not ok or copie == nil then
			_tpAvertirUneFois(etat, "generateur:copie:" .. original.Name, "« générer une copie » : impossible de copier « " .. original.Name .. " ».")
			return nil
		end
		reglage.gabarit = copie
		return copie
	end
	local function generer()
		-- copies encore dans le jeu : une copie ramassée, détruite ou rangée ailleurs ne compte plus
		local vivantes = {}
		for _, c in ipairs(reglage.copies) do
			if c.Parent ~= nil and c:IsDescendantOf(workspace) then
				table.insert(vivantes, c)
			end
		end
		reglage.copies = vivantes
		if #vivantes >= reglage.max then
			return
		end
		local source = gabarit()
		if source == nil then
			return
		end
		local ok, copie = pcall(function()
			return source:Clone()
		end)
		if not ok or copie == nil then
			return
		end
		-- près de cet objet (à 4 studs au plus), sinon près de la place de l'original
		local pivotSource = _pivot(source)
		local base = _pos(origine)
		if base == nil and pivotSource ~= nil then
			base = pivotSource.Position
		end
		if base ~= nil then
			local cf = CFrame.new(base + Vector3.new(math.random() * 8 - 4, 3, math.random() * 8 - 4))
			if pivotSource ~= nil then
				cf = cf * pivotSource.Rotation
			end
			if copie:IsA("PVInstance") then
				copie:PivotTo(cf)
			else
				local poignee = copie:FindFirstChild("Handle")
				if poignee ~= nil and poignee:IsA("BasePart") then
					poignee.CFrame = cf
				end
			end
		end
		copie.Parent = workspace
		table.insert(reglage.copies, copie)
	end
	reglage.generer = generer
	-- une erreur dans un générateur n'arrête ni le script ni les autres générateurs
	local function essayer(r)
		local ok, erreur = pcall(r.generer)
		if not ok then
			_tpAvertirUneFois(etat, "generateur:erreur", "« générer une copie » : " .. tostring(erreur))
		end
	end
	-- première copie tout de suite, puis toutes les « delai » secondes
	essayer(reglage)
	reglage.prochain = os.clock() + reglage.delai
	if etat.generateursActifs then
		return
	end
	etat.generateursActifs = true
	task.spawn(function()
		while next(etat.generateurs) ~= nil do
			local liste = {}
			for _, r in pairs(etat.generateurs) do
				table.insert(liste, r)
			end
			local attente = 0.5
			for _, r in ipairs(liste) do
				if os.clock() >= r.prochain then
					essayer(r)
					r.prochain = os.clock() + r.delai
				end
				attente = math.min(attente, r.prochain - os.clock())
			end
			task.wait(math.max(attente, 0.03))
		end
		etat.generateursActifs = false
	end)
end]],
	},

	-- « porte automatique … s'ouvre à … studs » : toutes les 0,2 s, un joueur en vie assez près ->
	-- la porte (ancrée) monte de sa hauteur en 0,4 s ; plus personne -> elle redescend. Une seule
	-- boucle pour toutes les portes du script (etat.portes) ; les joueurs en vie sont lus une fois
	-- par tour pour toutes les portes.
	_tpPorteAuto = {
		deps = { "_tpObjetValide", "_boiteObjet", "_demiHauteur", "_nombreOu", "_tpTween" },
		services = { "Players" },
		code = [[
local function _tpPorteAuto(etat, valeur, distance)
	local objet, parties = _tpObjetValide(etat, valeur, "porte automatique")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.portes = etat.portes or setmetatable({}, { __mode = "k" })
	local reglage = etat.portes[objet]
	if reglage ~= nil then
		reglage.distance = math.max(_nombreOu(distance, 10), 0)
		return
	end
	local cf, taille = _boiteObjet(objet)
	if cf == nil then
		return
	end
	for _, partie in ipairs(parties) do
		partie.Anchored = true
	end
	local ferme = objet:IsA("BasePart") and objet.CFrame or objet:GetPivot()
	reglage = {
		distance = math.max(_nombreOu(distance, 10), 0),
		ferme = ferme,
		ouvert = ferme + Vector3.new(0, 2 * _demiHauteur(cf, taille), 0),
		centre = cf.Position,
		ouverte = false,
		tween = nil,
	}
	etat.portes[objet] = reglage
	if etat.portesActives then
		-- la boucle des portes de ce script tourne déjà : elle prend cette porte au prochain tour
		return
	end
	etat.portesActives = true
	task.spawn(function()
		local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		while next(etat.portes) ~= nil do
			-- positions des joueurs en vie, lues une seule fois pour toutes les portes
			local positions = {}
			for _, p in ipairs(Players:GetPlayers()) do
				local perso = p.Character
				local racine = perso and perso:FindFirstChild("HumanoidRootPart")
				local h = perso and perso:FindFirstChildOfClass("Humanoid")
				if racine and racine:IsA("BasePart") and h and h.Health > 0 then
					table.insert(positions, racine.Position)
				end
			end
			local liste = {}
			for o, porte in pairs(etat.portes) do
				table.insert(liste, { o, porte })
			end
			for _, ligne in ipairs(liste) do
				local o, porte = ligne[1], ligne[2]
				if o.Parent == nil then
					-- porte supprimée : le bloc pourra de nouveau l'armer si elle revient
					if porte.tween ~= nil then
						porte.tween:Cancel()
					end
					if etat.portes[o] == porte then
						etat.portes[o] = nil
					end
				else
					local proche = false
					if o:IsDescendantOf(workspace) then
						for _, position in ipairs(positions) do
							if (position - porte.centre).Magnitude <= porte.distance then
								proche = true
								break
							end
						end
					end
					if proche ~= porte.ouverte then
						porte.ouverte = proche
						if porte.tween ~= nil then
							porte.tween:Cancel()
						end
						local destination = porte.ferme
						if proche then
							destination = porte.ouvert
						end
						porte.tween = _tpTween(o, info, destination)
					end
				end
			end
			task.wait(0.2)
		end
		etat.portesActives = false
	end)
end]],
	},

	-- « plateforme … va-et-vient vers … en … s » : aller-retour sans fin (TweenService, répétition
	-- infinie avec retour). La vitesse des parties suit le mouvement : les personnages posés dessus
	-- sont emportés (une partie ancrée déplacée par CFrame n'emporte rien toute seule). Une seule
	-- connexion Heartbeat pour toutes les plateformes du script (etat.listePlateformes), coupée quand
	-- il n'y en a plus.
	_tpPlateformeMobile = {
		deps = { "_tpObjetValide", "_tpCible", "_pos", "_texte", "_nombreOu", "_tpTween", "_tpAvertirUneFois" },
		services = { "RunService" },
		code = [[
local function _tpPlateformeMobile(etat, valeur, cible, duree)
	local objet, parties = _tpObjetValide(etat, valeur, "plateforme qui va et vient")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.plateformes = etat.plateformes or setmetatable({}, { __mode = "k" })
	if etat.plateformes[objet] ~= nil then
		-- déjà en mouvement : une seule animation par plateforme
		return
	end
	local destination = _tpCible(cible)
	local point = nil
	if typeof(destination) == "Vector3" then
		point = destination
	elseif destination ~= nil then
		point = _pos(destination)
	end
	if point == nil then
		_tpAvertirUneFois(etat, "plateforme:" .. _texte(cible), "« plateforme qui va et vient » : la destination « " .. _texte(cible) .. " » est introuvable. Crée une partie avec ce nom (ancrée, transparente et sans collision) là où la plateforme doit aller.")
		return
	end
	for _, partie in ipairs(parties) do
		partie.Anchored = true
	end
	local depart = objet:IsA("BasePart") and objet.CFrame or objet:GetPivot()
	local arrivee = CFrame.new(point) * depart.Rotation
	local d = math.clamp(_nombreOu(duree, 3), 0.1, 3600)
	local tween = _tpTween(objet, TweenInfo.new(d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), arrivee)
	local plateforme = { objet = objet, parties = parties, tween = tween, avant = depart.Position, estPartie = objet:IsA("BasePart") }
	etat.plateformes[objet] = plateforme
	etat.listePlateformes = etat.listePlateformes or {}
	table.insert(etat.listePlateformes, plateforme)
	if etat.connexionPlateformes ~= nil and etat.connexionPlateformes.Connected then
		return
	end
	etat.connexionPlateformes = RunService.Heartbeat:Connect(function(dt)
		local liste = etat.listePlateformes
		-- du dernier au premier : une plateforme supprimée est retirée pendant le parcours
		for i = #liste, 1, -1 do
			local pl = liste[i]
			local o = pl.objet
			if o.Parent == nil then
				pl.tween:Cancel()
				table.remove(liste, i)
				if etat.plateformes[o] == pl then
					etat.plateformes[o] = nil
				end
			else
				local ici = nil
				if pl.estPartie then
					ici = o.Position
				else
					ici = o:GetPivot().Position
				end
				if dt > 0 then
					local vitesse = (ici - pl.avant) / dt
					for _, partie in ipairs(pl.parties) do
						if partie.Parent ~= nil then
							partie.AssemblyLinearVelocity = vitesse
						end
					end
				end
				pl.avant = ici
			end
		end
		if #liste == 0 and etat.connexionPlateformes ~= nil then
			etat.connexionPlateformes:Disconnect()
			etat.connexionPlateformes = nil
		end
	end)
end]],
	},

	-- « plateforme … disparaît au contact, revient après … s » : clignote 0,6 s, cachée (invisible et
	-- traversable) pendant le délai, puis remise comme avant
	_tpPlateformeDisparait = {
		deps = { "_tpObjetValide", "_tpPersoDe", "_tpCacher", "_nombreOu" },
		services = {},
		code = [[
local function _tpPlateformeDisparait(etat, valeur, delai)
	local objet, parties = _tpObjetValide(etat, valeur, "plateforme qui disparaît")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.disparitions = etat.disparitions or setmetatable({}, { __mode = "k" })
	local reglage = etat.disparitions[objet]
	if reglage == nil then
		reglage = { occupe = false, delai = 3 }
		etat.disparitions[objet] = reglage
		local function touche(autre)
			if reglage.occupe then
				return
			end
			local perso, h = _tpPersoDe(etat, autre)
			if perso == nil or h == nil or h.Health <= 0 then
				return
			end
			reglage.occupe = true
			task.spawn(function()
				local origines = {}
				for _, partie in ipairs(parties) do
					origines[partie] = partie.Transparency
				end
				for i = 1, 6 do
					for partie, t in pairs(origines) do
						if partie.Parent ~= nil then
							if i % 2 == 1 then
								partie.Transparency = math.max(t, 0.6)
							else
								partie.Transparency = t
							end
						end
					end
					task.wait(0.1)
				end
				if objet.Parent ~= nil then
					local restaurer = _tpCacher(objet)
					task.wait(reglage.delai)
					if objet.Parent ~= nil then
						restaurer()
					end
				end
				reglage.occupe = false
			end)
		end
		for _, partie in ipairs(parties) do
			partie.Touched:Connect(touche)
		end
	end
	reglage.delai = math.max(_nombreOu(delai, 3), 0)
end]],
	},

	-- « tapis roulant … vitesse … » : parties ancrées dont la vitesse (AssemblyLinearVelocity) emporte
	-- ce qui est posé dessus vers la face avant de l'objet
	_tpTapisRoulant = {
		deps = { "_tpObjetValide", "_nombreOu" },
		services = {},
		code = [[
local function _tpTapisRoulant(etat, valeur, vitesse)
	local objet, parties = _tpObjetValide(etat, valeur, "tapis roulant")
	if objet == nil then
		return
	end
	local cf = objet:IsA("BasePart") and objet.CFrame or objet:GetPivot()
	local v = cf.LookVector * math.clamp(_nombreOu(vitesse, 16), -500, 500)
	for _, partie in ipairs(parties) do
		partie.Anchored = true
		partie.AssemblyLinearVelocity = v
	end
end]],
	},

	-- « trampoline … force … » : vitesse verticale = force (LinearVelocity 0,1 s : marche aussi pour les
	-- personnages des joueurs), 0,3 s de pause par personnage (table à clés faibles : un nouveau
	-- personnage fait oublier ceux qui ne sont plus dans le jeu)
	_tpTrampoline = {
		deps = { "_tpObjetValide", "_tpPersoDe", "_tpPoussee", "_nombreOu" },
		services = {},
		code = [[
local function _tpTrampoline(etat, valeur, force)
	local objet, parties = _tpObjetValide(etat, valeur, "trampoline")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.trampolines = etat.trampolines or setmetatable({}, { __mode = "k" })
	local reglage = etat.trampolines[objet]
	if reglage == nil then
		reglage = { force = 120, derniers = setmetatable({}, { __mode = "k" }) }
		etat.trampolines[objet] = reglage
		local function touche(autre)
			local perso, h = _tpPersoDe(etat, autre)
			if perso == nil or perso == objet or h == nil or h.Health <= 0 then
				return
			end
			local maintenant = os.clock()
			local dernier = reglage.derniers[perso]
			if dernier ~= nil and maintenant - dernier < 0.3 then
				return
			end
			local racine = perso:FindFirstChild("HumanoidRootPart")
			if racine == nil or not racine:IsA("BasePart") then
				return
			end
			if dernier == nil then
				for ancien in pairs(reglage.derniers) do
					if ancien.Parent == nil then
						reglage.derniers[ancien] = nil
					end
				end
			end
			reglage.derniers[perso] = maintenant
			local v = racine.AssemblyLinearVelocity
			_tpPoussee(racine, Vector3.new(v.X, reglage.force, v.Z), 0.1)
		end
		for _, partie in ipairs(parties) do
			partie.Touched:Connect(touche)
		end
	end
	reglage.force = math.clamp(_nombreOu(force, 120), 0, 2000)
end]],
	},

	-- « zone de soin … : + … vie par seconde » : le moteur de « zone de dégâts » avec des dégâts
	-- négatifs (soin sans dépasser la vie maximum, personnages en vie seulement)
	_tpZoneSoin = {
		deps = { "_tpObjetValide", "_tpZoneDegats", "_nombreOu" },
		services = {},
		code = [[
local function _tpZoneSoin(etat, valeur, soin)
	local objet = _tpObjetValide(etat, valeur, "zone de soin")
	if objet == nil then
		return
	end
	_tpZoneDegats(etat, objet, -_nombreOu(soin, 10))
end]],
	},

	-- « cycle jour/nuit de … minutes » : Lighting.ClockTime avance toutes les 0,1 s. Un seul cycle pour
	-- tous les scripts (un deuxième bloc change seulement la durée ; si le script du cycle disparaît,
	-- le prochain bloc en relance un).
	_tpJourNuit = {
		deps = { "_tpPartage", "_nombreOu" },
		services = { "Lighting" },
		code = [[
local function _tpJourNuit(minutes)
	local duree = math.clamp(_nombreOu(minutes, 10), 0.1, 1440)
	local partage = _tpPartage()
	local cycle = partage.jourNuit
	if type(cycle) == "table" and os.clock() - cycle.vu < 1 then
		cycle.minutes = duree
		return
	end
	cycle = { minutes = duree, vu = os.clock() }
	partage.jourNuit = cycle
	task.spawn(function()
		while partage.jourNuit == cycle do
			local ecoule = task.wait(0.1)
			cycle.vu = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + 24 * ecoule / (cycle.minutes * 60)) % 24
		end
	end)
end]],
	},

	-- « sauvegarder les statistiques des joueurs » : DataStore « BlocsFR_Stats », clé « joueur_<UserId> »,
	-- valeur { [nom de la statistique] = valeur } (IntValue, NumberValue, StringValue de leaderstats).
	-- Lecture à l'arrivée (les statistiques manquantes sont créées), écriture au départ et à la
	-- fermeture du serveur. Un joueur dont la lecture a échoué n'est jamais enregistré (ses anciennes
	-- données ne sont pas écrasées). Une seule installation par serveur.
	_tpSauverStats = {
		deps = { "_tpPartage", "_tpAvertirUneFois", "_statTrouver", "_ecrireStat" },
		services = { "DataStoreService", "Players", "RunService" },
		code = [[
local function _tpSauverStats(etat)
	if not RunService:IsServer() then
		_tpAvertirUneFois(etat, "stats:client", "« sauvegarder les statistiques » ne fonctionne que dans un script serveur (par exemple dans ServerScriptService).")
		return
	end
	local partage = _tpPartage()
	if partage.sauvegardeStats ~= nil and partage.sauvegardeStats.Connected then
		-- déjà installé sur ce serveur : un seul bloc suffit
		return
	end
	local messageApi = 'Active "Accès aux services API" dans Paramètres du jeu › Sécurité pour sauvegarder.'
	local okMagasin, magasin = pcall(function()
		return DataStoreService:GetDataStore("BlocsFR_Stats")
	end)
	if not okMagasin or magasin == nil then
		_tpAvertirUneFois(etat, "stats:api", messageApi)
		return
	end
	local charges = setmetatable({}, { __mode = "k" })
	local enregistres = setmetatable({}, { __mode = "k" })
	local enCours = 0
	local function erreurMagasin(erreur)
		if RunService:IsStudio() then
			_tpAvertirUneFois(etat, "stats:api", messageApi)
		else
			_tpAvertirUneFois(etat, "stats:" .. tostring(erreur), "« sauvegarder les statistiques » : " .. tostring(erreur))
		end
	end
	local function cle(p)
		return "joueur_" .. tostring(p.UserId)
	end
	local function charger(p)
		local donnees = nil
		local ok, erreur = false, nil
		for _ = 1, 3 do
			ok, erreur = pcall(function()
				donnees = magasin:GetAsync(cle(p))
			end)
			if ok or RunService:IsStudio() then
				break
			end
			task.wait(2)
		end
		if not ok then
			erreurMagasin(erreur)
			return
		end
		if p.Parent == nil then
			return
		end
		if type(donnees) == "table" then
			if p:FindFirstChild("leaderstats") == nil then
				p:WaitForChild("leaderstats", 10)
			end
			for nom, v in pairs(donnees) do
				if type(nom) == "string" and (type(v) == "number" or type(v) == "string") and p.Parent ~= nil then
					local stat = _statTrouver(p, nom, v)
					if stat ~= nil and stat:IsA("ValueBase") then
						_ecrireStat(stat, v)
					end
				end
			end
		end
		charges[p] = true
	end
	local function sauver(p)
		if not charges[p] or enregistres[p] then
			return
		end
		local dossier = p:FindFirstChild("leaderstats")
		if dossier == nil then
			return
		end
		local donnees = {}
		local nombre = 0
		for _, stat in ipairs(dossier:GetChildren()) do
			if stat:IsA("IntValue") or stat:IsA("NumberValue") or stat:IsA("StringValue") then
				donnees[stat.Name] = stat.Value
				nombre += 1
			end
		end
		if nombre == 0 then
			return
		end
		enregistres[p] = true
		enCours += 1
		for _ = 1, 3 do
			local ok, erreur = pcall(function()
				magasin:SetAsync(cle(p), donnees)
			end)
			if ok then
				break
			end
			erreurMagasin(erreur)
			if RunService:IsStudio() then
				break
			end
			task.wait(2)
		end
		enCours -= 1
	end
	partage.sauvegardeStats = Players.PlayerRemoving:Connect(sauver)
	Players.PlayerAdded:Connect(charger)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(charger, p)
	end
	game:BindToClose(function()
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(sauver, p)
		end
		local attente = 0
		while enCours > 0 and attente < 25 do
			attente += task.wait(0.1)
		end
	end)
end]],
	},

	-- « minuteur à l'écran de … s puis envoyer … » : pilule en haut au centre (ScreenGui
	-- « BlocsFR_Minuteur », style jeu : contour sombre, relief, police FredokaOne), pour tous les
	-- joueurs (serveur) ou le joueur local ; rouge les 10 dernières secondes ; à 0, le message est
	-- envoyé comme avec « envoyer le message ». Ne fait pas attendre ; un nouveau minuteur du même
	-- script remplace l'ancien (qui n'envoie alors rien).
	_tpMinuteurEcran = {
		deps = { "_nombreOu", "_texte", "_envoyerMessage" },
		services = { "Players", "RunService", "TweenService" },
		code = [[
local function _tpMinuteurEcran(etat, secondes, message, joueur)
	if type(etat) ~= "table" then
		etat = {}
	end
	local total = math.clamp(_nombreOu(secondes, 60), 0, 86400)
	local nom = _texte(message)
	local jeton = {}
	etat.minuteur = jeton
	local function envoyer()
		if nom ~= "" then
			_envoyerMessage(nom, joueur)
		end
	end
	if total <= 0 then
		envoyer()
		return
	end
	local bleu = ColorSequence.new(Color3.fromRGB(43, 58, 103), Color3.fromRGB(30, 42, 74))
	local rouge = ColorSequence.new(Color3.fromRGB(255, 122, 133), Color3.fromRGB(229, 56, 59))
	local sombre = Color3.fromRGB(14, 22, 48)
	local function joueurs()
		if RunService:IsClient() then
			return { Players.LocalPlayer }
		end
		return Players:GetPlayers()
	end
	local function arrondir(cadre)
		local coins = Instance.new("UICorner")
		coins.CornerRadius = UDim.new(1, 0)
		coins.Parent = cadre
	end
	-- pilule d'un joueur, créée si besoin ; renvoie son texte (ou nil)
	local function pilule(p)
		local interface = p and p:FindFirstChildOfClass("PlayerGui")
		if interface == nil then
			return nil
		end
		local ecran = interface:FindFirstChild("BlocsFR_Minuteur")
		if ecran == nil then
			ecran = Instance.new("ScreenGui")
			ecran.Name = "BlocsFR_Minuteur"
			ecran.ResetOnSpawn = false
			ecran.DisplayOrder = 40
			ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
			local relief = Instance.new("Frame")
			relief.Name = "Relief"
			relief.AnchorPoint = Vector2.new(0.5, 0)
			relief.Position = UDim2.new(0.5, 0, 0, 14)
			relief.Size = UDim2.fromOffset(150, 52)
			relief.BackgroundColor3 = sombre
			relief.BorderSizePixel = 0
			arrondir(relief)
			relief.Parent = ecran
			local cadre = Instance.new("Frame")
			cadre.Name = "Pilule"
			cadre.AnchorPoint = Vector2.new(0.5, 0)
			cadre.Position = UDim2.new(0.5, 0, 0, 8)
			cadre.Size = UDim2.fromOffset(150, 52)
			cadre.BackgroundColor3 = Color3.new(1, 1, 1)
			cadre.BorderSizePixel = 0
			cadre.ZIndex = 2
			arrondir(cadre)
			local degrade = Instance.new("UIGradient")
			degrade.Color = bleu
			degrade.Rotation = 90
			degrade.Parent = cadre
			local bord = Instance.new("UIStroke")
			bord.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			bord.Color = sombre
			bord.Thickness = 3
			bord.Parent = cadre
			local echelle = Instance.new("UIScale")
			echelle.Parent = cadre
			local texte = Instance.new("TextLabel")
			texte.Name = "Temps"
			texte.Size = UDim2.fromScale(1, 1)
			texte.BackgroundTransparency = 1
			texte.Font = Enum.Font.FredokaOne
			texte.TextScaled = true
			texte.TextColor3 = Color3.new(1, 1, 1)
			texte.Text = ""
			texte.ZIndex = 3
			local contour = Instance.new("UIStroke")
			contour.Color = sombre
			contour.Thickness = 2
			contour.Parent = texte
			local marges = Instance.new("UIPadding")
			marges.PaddingTop = UDim.new(0, 6)
			marges.PaddingBottom = UDim.new(0, 6)
			marges.PaddingLeft = UDim.new(0, 16)
			marges.PaddingRight = UDim.new(0, 16)
			marges.Parent = texte
			texte.Parent = cadre
			cadre.Parent = ecran
			ecran.Parent = interface
		end
		local cadre = ecran:FindFirstChild("Pilule")
		if cadre == nil then
			return nil
		end
		return cadre:FindFirstChild("Temps")
	end
	-- écrit le temps dans la pilule d'un joueur (rouge les 10 dernières secondes)
	local function afficher(p, voulu, reste)
		local texte = pilule(p)
		if texte == nil or texte.Text == voulu then
			return
		end
		texte.Text = voulu
		local cadre = texte.Parent
		local degrade = cadre:FindFirstChildOfClass("UIGradient")
		if degrade ~= nil then
			if reste <= 10 then
				degrade.Color = rouge
			else
				degrade.Color = bleu
			end
		end
		local echelle = cadre:FindFirstChildOfClass("UIScale")
		if reste <= 10 and echelle ~= nil and RunService:IsClient() then
			-- les 10 dernières secondes : la pilule saute à chaque seconde
			echelle.Scale = 1.18
			TweenService:Create(echelle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
	task.spawn(function()
		local fin = os.clock() + total
		local affiche = nil
		while etat.minuteur == jeton do
			local reste = math.max(0, math.ceil(fin - os.clock()))
			local voulu = string.format("%d:%02d", math.floor(reste / 60), reste % 60)
			-- les pilules ne sont relues que quand le temps affiché change (une fois par seconde) ;
			-- un joueur qui arrive voit la sienne à la seconde suivante
			if voulu ~= affiche then
				affiche = voulu
				for _, p in ipairs(joueurs()) do
					afficher(p, voulu, reste)
				end
			end
			if reste <= 0 then
				break
			end
			task.wait(0.2)
		end
		if etat.minuteur ~= jeton then
			-- remplacé par un nouveau minuteur : pas de message
			return
		end
		envoyer()
		task.wait(1.5)
		if etat.minuteur == jeton then
			etat.minuteur = nil
			for _, p in ipairs(joueurs()) do
				local interface = p and p:FindFirstChildOfClass("PlayerGui")
				local ecran = interface and interface:FindFirstChild("BlocsFR_Minuteur")
				if ecran ~= nil then
					ecran:Destroy()
				end
			end
		end
	end)
end]],
	},

	-- « bouton … : donner … pour … … » : clic (ClickDetector trouvé ou créé par _surClic) -> si le
	-- joueur a assez de la statistique, le prix est retiré et l'outil (Tool) est copié dans son sac
	-- (+ StarterGear) ; l'objet brille en vert, sinon en rouge. Un outil déjà possédé n'est pas revendu.
	-- L'outil trouvé est gardé en mémoire (cherché de nouveau s'il a disparu ou si le nom change).
	_tpBoutonAchat = {
		deps = {
			"_tpObjetValide",
			"_surClic",
			"_statTrouver",
			"_ecrireStat",
			"_messageEcran",
			"_texte",
			"_nombreOu",
			"_tpEclat",
			"_jouerSon",
			"_tpAvertirUneFois",
		},
		services = {},
		code = [[
local function _tpBoutonAchat(etat, valeur, outil, prix, stat)
	local objet = _tpObjetValide(etat, valeur, "bouton d'achat")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.boutonsAchat = etat.boutonsAchat or setmetatable({}, { __mode = "k" })
	local reglage = etat.boutonsAchat[objet]
	if reglage == nil then
		reglage = { outil = "", prix = 0, stat = "", derniers = setmetatable({}, { __mode = "k" }), modele = nil, modeleNom = nil }
		etat.boutonsAchat[objet] = reglage
		local vert = Color3.fromRGB(47, 191, 90)
		local rouge = Color3.fromRGB(229, 56, 59)
		-- l'outil à vendre : ServerStorage, ReplicatedStorage puis Lighting (nom exact, sinon sans
		-- tenir compte des majuscules)
		local function trouverOutil(nom)
			if nom == "" then
				return nil
			end
			local cherche = string.lower(nom)
			local approchant = nil
			for _, nomService in ipairs({ "ServerStorage", "ReplicatedStorage", "Lighting" }) do
				local ok, conteneur = pcall(function()
					return game:GetService(nomService)
				end)
				if ok and conteneur then
					for _, d in ipairs(conteneur:GetDescendants()) do
						if d:IsA("Tool") then
							if d.Name == nom then
								return d
							elseif approchant == nil and string.lower(d.Name) == cherche then
								approchant = d
							end
						end
					end
				end
			end
			return approchant
		end
		local function possede(conteneur, nom)
			local trouve = conteneur and conteneur:FindFirstChild(nom)
			return trouve ~= nil and trouve:IsA("Tool")
		end
		_surClic(objet, function(p)
			if typeof(p) ~= "Instance" or not p:IsA("Player") then
				return
			end
			local maintenant = os.clock()
			local dernier = reglage.derniers[p]
			if dernier ~= nil and maintenant - dernier < 0.5 then
				return
			end
			if dernier == nil then
				-- nouveau joueur : on oublie ceux qui sont partis
				for ancien in pairs(reglage.derniers) do
					if ancien.Parent == nil then
						reglage.derniers[ancien] = nil
					end
				end
			end
			reglage.derniers[p] = maintenant
			local modele = reglage.modele
			if modele == nil or modele.Parent == nil or reglage.modeleNom ~= reglage.outil or string.lower(modele.Name) ~= string.lower(reglage.outil) then
				modele = trouverOutil(reglage.outil)
				reglage.modele = modele
				reglage.modeleNom = reglage.outil
			end
			if modele == nil then
				_tpEclat(objet, rouge, 0.3)
				_tpAvertirUneFois(etat, "achat:" .. reglage.outil, "« bouton d'achat » : aucun outil (Tool) nommé « " .. reglage.outil .. " » dans ServerStorage, ReplicatedStorage ou Lighting.")
				return
			end
			local sac = p:FindFirstChildOfClass("Backpack")
			local reserve = p:FindFirstChildOfClass("StarterGear")
			if possede(sac, modele.Name) or possede(p.Character, modele.Name) or possede(reserve, modele.Name) then
				_messageEcran(p, "Tu as déjà « " .. modele.Name .. " ».", 2)
				return
			end
			if sac == nil then
				return
			end
			local compte = nil
			if reglage.prix > 0 then
				compte = _statTrouver(p, reglage.stat, nil)
				if compte ~= nil and not (compte:IsA("IntValue") or compte:IsA("NumberValue")) then
					compte = nil
				end
				if compte == nil or compte.Value < reglage.prix then
					_tpEclat(objet, rouge, 0.3)
					_messageEcran(p, "Il te faut " .. _texte(reglage.prix) .. " " .. reglage.stat .. " pour acheter « " .. modele.Name .. " ».", 2)
					return
				end
			end
			local ok, copie = pcall(function()
				return modele:Clone()
			end)
			if not ok or copie == nil then
				_tpAvertirUneFois(etat, "achat:copie:" .. modele.Name, "« bouton d'achat » : impossible de copier « " .. modele.Name .. " » (sa propriété Archivable est-elle désactivée ?).")
				return
			end
			if compte ~= nil then
				_ecrireStat(compte, compte.Value - reglage.prix)
			end
			copie.Parent = sac
			if reserve ~= nil then
				-- une 2e copie dans StarterGear : le joueur la retrouve après une réapparition
				local okReserve, copieReserve = pcall(function()
					return modele:Clone()
				end)
				if okReserve and copieReserve ~= nil then
					copieReserve.Parent = reserve
				end
			end
			_tpEclat(objet, vert, 0.3)
			_jouerSon("rbxasset://sounds/electronicpingshort.wav", objet, 0.6)
		end)
	end
	reglage.outil = _texte(outil)
	reglage.prix = math.max(_nombreOu(prix, 0), 0)
	reglage.stat = _texte(stat)
end]],
	},

	---------------------------------------------------------------------------
	-- Encore plus de systèmes tout prêts (SPEC §34)
	---------------------------------------------------------------------------

	-- Moteur des objets qui bougent à chaque image (flotter, tourner, ascenseur, lave, familiers) :
	-- UNE connexion Heartbeat par script pour tous (etat.mouvements), coupée quand plus rien ne bouge.
	-- pas(dt) renvoie false pour s'arrêter ; fin() (facultative) est appelée quand l'entrée est retirée
	-- (objet supprimé, arrêt ou erreur). Une erreur n'arrête que cet objet (un seul avertissement).
	_tpMoteur = {
		deps = { "_tpAvertirUneFois" },
		services = { "RunService" },
		code = [[
local function _tpMoteur(etat, objet, pas, fin)
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.mouvements = etat.mouvements or {}
	table.insert(etat.mouvements, { objet = objet, pas = pas, fin = fin })
	if etat.connexionMouvements ~= nil and etat.connexionMouvements.Connected then
		return
	end
	etat.connexionMouvements = RunService.Heartbeat:Connect(function(dt)
		local liste = etat.mouvements
		-- du dernier au premier : une entrée terminée est retirée pendant le parcours
		for i = #liste, 1, -1 do
			local entree = liste[i]
			local garder = false
			if entree.objet.Parent ~= nil then
				local ok, suite = pcall(entree.pas, dt)
				if ok then
					garder = suite ~= false
				else
					_tpAvertirUneFois(etat, "mouvement:" .. tostring(suite), "« " .. entree.objet.Name .. " » ne bouge plus tout seul : " .. tostring(suite))
				end
			end
			if not garder then
				table.remove(liste, i)
				if entree.fin ~= nil then
					pcall(entree.fin)
				end
			end
		end
		if #liste == 0 and etat.connexionMouvements ~= nil then
			etat.connexionMouvements:Disconnect()
			etat.connexionMouvements = nil
		end
	end)
end]],
	},

	-- Place un objet qui bouge (partie : CFrame ; modèle : pivot) et donne à ses parties ancrées la
	-- vitesse de leur mouvement (déplacement + rotation autour du pivot) : ce qui est posé dessus est
	-- emporté. m = { objet, parties, estPartie, cf (dernière place), porte (false : rien ne peut se
	-- poser dessus, pas de vitesse) }. Les vitesses ne sont réécrites que si elles changent (une seule
	-- partie qui tourne régulièrement : une seule fois).
	_tpBouger = {
		deps = {},
		services = {},
		code = [[
local function _tpBouger(m, cf, dt)
	local avant = m.cf
	m.cf = cf
	if m.estPartie then
		m.objet.CFrame = cf
	else
		m.objet:PivotTo(cf)
	end
	if avant == nil or dt <= 0 or m.porte == false then
		return
	end
	local vitesse = (cf.Position - avant.Position) / dt
	local rotation = Vector3.zero
	local axe, angle = (cf.Rotation * avant.Rotation:Inverse()):ToAxisAngle()
	if angle == angle and angle > 1e-6 and axe.Magnitude > 0.5 then
		rotation = axe.Unit * (angle / dt)
	end
	if m.v ~= nil and (vitesse - m.v).Magnitude < 0.01 and (rotation - m.w).Magnitude < 0.001 and (m.estPartie or rotation.Magnitude < 1e-6) then
		return
	end
	m.v = vitesse
	m.w = rotation
	local centre = cf.Position
	for _, partie in ipairs(m.parties) do
		if partie.Parent ~= nil and partie.Anchored then
			partie.AssemblyLinearVelocity = vitesse + rotation:Cross(partie.Position - centre)
			partie.AssemblyAngularVelocity = rotation
		end
	end
end]],
	},

	-- Objet animé par « faire flotter » et « faire tourner … sans arrêt » (les deux sur le même objet : il
	-- flotte ET tourne). Une entrée par objet (etat.animes), animée par _tpMoteur. Parties ancrées et
	-- relues toutes les secondes ; un objet déplacé par un autre bloc (téléporter, glisser…) continue à
	-- sa nouvelle place ; en pause hors de Workspace. Jamais le personnage d'un joueur (il serait figé).
	_tpAnimer = {
		deps = { "_tpObjetValide", "_parties", "_tpMoteur", "_tpBouger", "_tpAvertirUneFois" },
		services = { "Players" },
		code = [[
local function _tpAnimer(etat, valeur, action)
	local objet, parties = _tpObjetValide(etat, valeur, action)
	if objet == nil then
		return nil
	end
	-- le personnage d'un joueur (ou un de ses membres) serait figé : refusé
	local modele = objet
	if not modele:IsA("Model") then
		modele = objet:FindFirstAncestorOfClass("Model")
	end
	if modele ~= nil and Players:GetPlayerFromCharacter(modele) ~= nil then
		_tpAvertirUneFois(etat, action .. ":joueur", "« " .. action .. " » ne marche pas sur le personnage d'un joueur (il serait figé) : choisis une partie ou un modèle.")
		return nil
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.animes = etat.animes or setmetatable({}, { __mode = "k" })
	local m = etat.animes[objet]
	if m ~= nil then
		return m
	end
	-- ancre les parties ; vrai si l'une d'elles peut porter quelque chose (collision)
	local function preparer(liste)
		local porte = false
		for _, partie in ipairs(liste) do
			if not partie.Anchored then
				partie.Anchored = true
			end
			if partie.CanCollide then
				porte = true
			end
		end
		return porte
	end
	local estPartie = objet:IsA("BasePart")
	local base = estPartie and objet.CFrame or objet:GetPivot()
	m = { objet = objet, parties = parties, estPartie = estPartie, base = base, cf = nil, phase = 0, angle = 0, relue = 1, flotte = nil, tourne = nil }
	m.porte = preparer(parties)
	etat.animes[objet] = m
	_tpMoteur(etat, objet, function(dt)
		if not objet:IsDescendantOf(workspace) then
			-- rangé ailleurs (ServerStorage…) : en pause
			return true
		end
		m.relue -= dt
		if m.relue <= 0 then
			m.relue = 1
			m.parties = _parties(objet)
			m.porte = preparer(m.parties)
		end
		if m.cf ~= nil then
			-- déplacé par un autre bloc depuis la dernière image : il continue à sa nouvelle place
			local actuel = m.estPartie and objet.CFrame or objet:GetPivot()
			local ecart = actuel.Position - m.cf.Position
			if ecart.Magnitude > 0.05 then
				m.base = m.base + ecart
			end
		end
		local y = 0
		local f = m.flotte
		if f ~= nil then
			m.phase = (m.phase + dt * math.pi * f.vitesse) % (2 * math.pi)
			y = f.hauteur * (1 - math.cos(m.phase)) / 2
		end
		if m.tourne ~= nil then
			m.angle = (m.angle + math.rad(m.tourne) * dt) % (2 * math.pi)
		end
		_tpBouger(m, CFrame.new(m.base.Position + Vector3.new(0, y, 0)) * CFrame.Angles(0, m.angle, 0) * m.base.Rotation, dt)
		return true
	end, function()
		if etat.animes[objet] == m then
			etat.animes[objet] = nil
		end
	end)
	return m
end]],
	},

	-- « faire flotter … (hauteur …, vitesse …) » : monte de « hauteur » studs au-dessus de sa place puis
	-- revient, en douceur (cosinus : il ne descend jamais sous sa place) ; vitesse 1 = un aller-retour
	-- toutes les 2 secondes
	_tpFlotter = {
		deps = { "_tpAnimer", "_nombreOu" },
		services = {},
		code = [[
local function _tpFlotter(etat, valeur, hauteur, vitesse)
	local m = _tpAnimer(etat, valeur, "faire flotter")
	if m == nil then
		return
	end
	m.flotte = {
		hauteur = math.clamp(_nombreOu(hauteur, 2), -500, 500),
		vitesse = math.clamp(_nombreOu(vitesse, 1), 0, 50),
	}
end]],
	},

	-- « faire tourner … sans arrêt (vitesse …) » : autour de l'axe vertical, en degrés par seconde
	-- (négatif = dans l'autre sens)
	_tpRotation = {
		deps = { "_tpAnimer", "_nombreOu" },
		services = {},
		code = [[
local function _tpRotation(etat, valeur, vitesse)
	local m = _tpAnimer(etat, valeur, "faire tourner")
	if m == nil then
		return
	end
	m.tourne = math.clamp(_nombreOu(vitesse, 90), -7200, 7200)
end]],
	},

	-- « … élimine qui le touche » : brique mortelle (vie à 0), une connexion par partie, installée une
	-- seule fois par objet. Jamais le personnage dont l'objet fait partie.
	_tpMortel = {
		deps = { "_tpObjetValide", "_tpPersoDe" },
		services = { "Players", "RunService" },
		code = [[
local function _tpMortel(etat, valeur)
	local objet, parties = _tpObjetValide(etat, valeur, "élimine qui le touche")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.mortels = etat.mortels or setmetatable({}, { __mode = "k" })
	if etat.mortels[objet] then
		return
	end
	etat.mortels[objet] = true
	local client = RunService:IsClient()
	local function touche(autre)
		local perso, h = _tpPersoDe(etat, autre)
		if perso == nil or h == nil or h.Health <= 0 then
			return
		end
		if perso == objet or objet:IsDescendantOf(perso) then
			return
		end
		if client and Players:GetPlayerFromCharacter(perso) ~= Players.LocalPlayer then
			return
		end
		h.Health = 0
	end
	for _, partie in ipairs(parties) do
		partie.Touched:Connect(touche)
	end
end]],
	},

	-- « ascenseur … monte de … studs quand on monte dessus » : un personnage posé dessus (une partie de
	-- l'ascenseur est juste sous lui : un contact par le côté ne compte pas, une cabine avec des murs ou
	-- un toit marche aussi) -> 0,5 s, montée en douceur (8 studs/s en moyenne), 3 s en haut, descente.
	-- Ancré, il emporte les joueurs (_tpBouger). Animé par _tpMoteur ; au repos, rien n'est recalculé.
	_tpAscenseur = {
		deps = { "_tpObjetValide", "_tpPersoDe", "_tpMoteur", "_tpBouger", "_nombreOu" },
		services = { "Players", "RunService" },
		code = [[
local function _tpAscenseur(etat, valeur, hauteur)
	local objet, parties = _tpObjetValide(etat, valeur, "ascenseur")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.ascenseurs = etat.ascenseurs or setmetatable({}, { __mode = "k" })
	local h = math.clamp(_nombreOu(hauteur, 20), -1000, 1000)
	local a = etat.ascenseurs[objet]
	if a ~= nil then
		-- déjà installé : la nouvelle hauteur sert au prochain trajet
		a.hauteur = h
		return
	end
	for _, partie in ipairs(parties) do
		partie.Anchored = true
	end
	local estPartie = objet:IsA("BasePart")
	local base = estPartie and objet.CFrame or objet:GetPivot()
	-- rayon vers le bas qui ne voit que l'ascenseur (créé une seule fois)
	local sol = RaycastParams.new()
	sol.FilterType = Enum.RaycastFilterType.Include
	sol.FilterDescendantsInstances = { objet }
	a = {
		objet = objet,
		parties = parties,
		estPartie = estPartie,
		base = base,
		cf = base,
		hauteur = h,
		trajet = h,
		p = 0,
		phase = "bas",
		attente = 0,
	}
	etat.ascenseurs[objet] = a
	local client = RunService:IsClient()
	local function touche(autre)
		if a.phase ~= "bas" then
			return
		end
		local perso, hum = _tpPersoDe(etat, autre)
		if perso == nil or perso == objet or hum == nil or hum.Health <= 0 then
			return
		end
		if client and Players:GetPlayerFromCharacter(perso) ~= Players.LocalPlayer then
			return
		end
		local racine = perso:FindFirstChild("HumanoidRootPart")
		if racine == nil or not racine:IsA("BasePart") then
			return
		end
		-- seulement quelqu'un qui est monté dessus : une partie de l'ascenseur est juste sous sa racine
		-- (un contact par le côté ne compte pas ; une cabine avec des murs ou un toit marche aussi)
		if workspace:Raycast(racine.Position, Vector3.new(0, -10, 0), sol) == nil then
			return
		end
		a.phase = "depart"
		a.attente = 0.5
		a.trajet = a.hauteur
	end
	for _, partie in ipairs(parties) do
		partie.Touched:Connect(touche)
	end
	_tpMoteur(etat, objet, function(dt)
		if a.phase == "bas" or not objet:IsDescendantOf(workspace) then
			return true
		end
		if a.phase == "depart" or a.phase == "haut" then
			a.attente -= dt
			if a.attente > 0 then
				return true
			end
			if a.phase == "depart" then
				a.phase = "monte"
			else
				a.phase = "descend"
			end
		end
		local pas = dt * 8 / math.max(math.abs(a.trajet), 1)
		if a.phase == "monte" then
			a.p = math.min(a.p + pas, 1)
		else
			a.p = math.max(a.p - pas, 0)
		end
		-- départ et arrivée en douceur
		local y = a.trajet * a.p * a.p * (3 - 2 * a.p)
		_tpBouger(a, a.base + Vector3.new(0, y, 0), dt)
		if a.phase == "monte" and a.p >= 1 then
			a.phase = "haut"
			a.attente = 3
			-- arrêté : ses parties ne donnent plus de vitesse (sinon on glisserait dessus)
			_tpBouger(a, a.cf, 1)
		elseif a.phase == "descend" and a.p <= 0 then
			a.phase = "bas"
			_tpBouger(a, a.cf, 1)
		end
		return true
	end, function()
		if etat.ascenseurs[objet] == a then
			etat.ascenseurs[objet] = nil
		end
	end)
end]],
	},

	-- Pilule de jeu en haut au centre de l'écran d'un joueur (ScreenGui « nom », style du minuteur :
	-- contour sombre, relief, police FredokaOne), créée si besoin à « y » pixels du haut. Renvoie son
	-- texte (TextLabel « Temps ») ou nil.
	_tpPilule = {
		deps = {},
		services = {},
		code = [[
local function _tpPilule(p, nom, y)
	local interface = p and p:FindFirstChildOfClass("PlayerGui")
	if interface == nil then
		return nil
	end
	local ecran = interface:FindFirstChild(nom)
	if ecran == nil then
		local sombre = Color3.fromRGB(14, 22, 48)
		ecran = Instance.new("ScreenGui")
		ecran.Name = nom
		ecran.ResetOnSpawn = false
		ecran.DisplayOrder = 40
		ecran.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		local relief = Instance.new("Frame")
		relief.Name = "Relief"
		relief.AnchorPoint = Vector2.new(0.5, 0)
		relief.Position = UDim2.new(0.5, 0, 0, y + 6)
		relief.Size = UDim2.fromOffset(210, 52)
		relief.BackgroundColor3 = sombre
		relief.BorderSizePixel = 0
		local coinsRelief = Instance.new("UICorner")
		coinsRelief.CornerRadius = UDim.new(1, 0)
		coinsRelief.Parent = relief
		relief.Parent = ecran
		local cadre = Instance.new("Frame")
		cadre.Name = "Pilule"
		cadre.AnchorPoint = Vector2.new(0.5, 0)
		cadre.Position = UDim2.new(0.5, 0, 0, y)
		cadre.Size = UDim2.fromOffset(210, 52)
		cadre.BackgroundColor3 = Color3.new(1, 1, 1)
		cadre.BorderSizePixel = 0
		cadre.ZIndex = 2
		local coins = Instance.new("UICorner")
		coins.CornerRadius = UDim.new(1, 0)
		coins.Parent = cadre
		local degrade = Instance.new("UIGradient")
		degrade.Color = ColorSequence.new(Color3.fromRGB(43, 58, 103), Color3.fromRGB(30, 42, 74))
		degrade.Rotation = 90
		degrade.Parent = cadre
		local bord = Instance.new("UIStroke")
		bord.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bord.Color = sombre
		bord.Thickness = 3
		bord.Parent = cadre
		local texte = Instance.new("TextLabel")
		texte.Name = "Temps"
		texte.Size = UDim2.fromScale(1, 1)
		texte.BackgroundTransparency = 1
		texte.Font = Enum.Font.FredokaOne
		texte.TextScaled = true
		texte.TextColor3 = Color3.new(1, 1, 1)
		texte.Text = ""
		texte.ZIndex = 3
		local contour = Instance.new("UIStroke")
		contour.Color = sombre
		contour.Thickness = 2
		contour.Parent = texte
		local marges = Instance.new("UIPadding")
		marges.PaddingTop = UDim.new(0, 6)
		marges.PaddingBottom = UDim.new(0, 6)
		marges.PaddingLeft = UDim.new(0, 16)
		marges.PaddingRight = UDim.new(0, 16)
		marges.Parent = texte
		texte.Parent = cadre
		cadre.Parent = ecran
		ecran.Parent = interface
	end
	local cadre = ecran:FindFirstChild("Pilule")
	if cadre == nil then
		return nil
	end
	return cadre:FindFirstChild("Temps")
end]],
	},

	-- « chronomètre : départ …, arrivée … » : pour chaque joueur, le chrono part quand il QUITTE le
	-- départ (tant qu'il est dessus, il reste à 0) et s'arrête quand il touche l'arrivée. Temps affiché
	-- en haut au centre (pilule « BlocsFR_Chrono », sous celle du minuteur) ; meilleur temps dans la
	-- statistique « Record » (NumberValue de leaderstats, plus petit = meilleur). UNE boucle (0,1 s) pour
	-- tous les coureurs du script (etat.coureurs). Départ et arrivée cherchés pendant 5 s au plus (un
	-- autre script peut les créer) ; un seul chronomètre par départ ; départ = arrivée : un tour de circuit.
	_tpChronoCourse = {
		deps = {
			"_tpCible",
			"_parties",
			"_boiteObjet",
			"_tpPersoDe",
			"_tpPilule",
			"_ecrireStat",
			"_jouerSon",
			"_tpAvertirUneFois",
			"_texte",
		},
		services = { "Players", "RunService" },
		code = [[
local function _tpChronoCourse(etat, depart, arrivee)
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.chronos = etat.chronos or setmetatable({}, { __mode = "k" })
	etat.coureurs = etat.coureurs or setmetatable({}, { __mode = "k" })
	etat.chronoJetons = etat.chronoJetons or setmetatable({}, { __mode = "k" })
	local client = RunService:IsClient()
	local bleu = ColorSequence.new(Color3.fromRGB(43, 58, 103), Color3.fromRGB(30, 42, 74))
	local vert = ColorSequence.new(Color3.fromRGB(111, 240, 143), Color3.fromRGB(47, 191, 90))
	local dore = ColorSequence.new(Color3.fromRGB(255, 222, 110), Color3.fromRGB(235, 160, 20))
	-- 75,3 s -> « 1:15,3 » (dixièmes) ou « 1:15,30 » (centièmes)
	local function texteTemps(t, centiemes)
		t = math.max(t, 0)
		if centiemes then
			local c = math.floor(t * 100 + 0.5)
			local minutes = math.floor(c / 6000)
			local reste = c - minutes * 6000
			return string.format("%d:%02d,%02d", minutes, math.floor(reste / 100), reste % 100)
		end
		local d = math.floor(t * 10)
		local minutes = math.floor(d / 600)
		local reste = d - minutes * 600
		return string.format("%d:%02d,%d", minutes, math.floor(reste / 10), reste % 10)
	end
	-- écrit dans la pilule du joueur ; le texte et la couleur ne sont réécrits que s'ils changent
	local function montrer(p, c, texte, couleurs)
		if texte == c.affiche and couleurs == c.couleurs then
			return
		end
		local etiquette = c.etiquette
		if etiquette == nil or etiquette.Parent == nil then
			etiquette = _tpPilule(p, "BlocsFR_Chrono", 74)
			c.etiquette = etiquette
			c.couleurs = nil
		end
		if etiquette == nil then
			return
		end
		c.affiche = texte
		etiquette.Text = texte
		if couleurs ~= c.couleurs then
			c.couleurs = couleurs
			local degrade = etiquette.Parent:FindFirstChildOfClass("UIGradient")
			if degrade ~= nil then
				degrade.Color = couleurs
			end
		end
	end
	-- vrai si la position (racine du personnage) est sur le départ ou juste au-dessus
	local function surDepart(course, position)
		local cf, taille = course.cf, course.taille
		if cf == nil or taille == nil then
			return false
		end
		local l = cf:PointToObjectSpace(position)
		return math.abs(l.X) <= taille.X / 2 + 1 and math.abs(l.Z) <= taille.Z / 2 + 1 and l.Y >= -taille.Y / 2 - 1 and l.Y <= taille.Y / 2 + 6
	end
	-- meilleur temps dans leaderstats « Record » ; vrai si c'est un nouveau record
	local function enregistrer(p, temps)
		local arrondi = math.floor(temps * 100 + 0.5) / 100
		local dossier = p:FindFirstChild("leaderstats")
		if dossier == nil then
			dossier = Instance.new("Folder")
			dossier.Name = "leaderstats"
			dossier.Parent = p
		end
		local stat = dossier:FindFirstChild("Record")
		if stat == nil then
			stat = Instance.new("NumberValue")
			stat.Name = "Record"
			stat.Value = arrondi
			stat.Parent = dossier
			return true
		end
		if not (stat:IsA("NumberValue") or stat:IsA("IntValue")) then
			return false
		end
		if stat.Value <= 0 or arrondi < stat.Value then
			_ecrireStat(stat, arrondi)
			return true
		end
		return false
	end
	-- joueur (et personnage) en vie qui a touché, ou nil
	local function joueurDe(autre)
		local perso, h = _tpPersoDe(etat, autre)
		if perso == nil or h == nil or h.Health <= 0 then
			return nil, nil
		end
		local p = Players:GetPlayerFromCharacter(perso)
		if p == nil or (client and p ~= Players.LocalPlayer) then
			return nil, nil
		end
		return p, perso
	end
	-- UNE boucle (0,1 s) pour tous les coureurs du script ; elle s'arrête quand il n'y en a plus
	local function boucle()
		if etat.coureursActifs then
			return
		end
		etat.coureursActifs = true
		task.spawn(function()
			while next(etat.coureurs) ~= nil do
				local maintenant = os.clock()
				local liste = {}
				for p, c in pairs(etat.coureurs) do
					table.insert(liste, { p, c })
				end
				for _, ligne in ipairs(liste) do
					local p, c = ligne[1], ligne[2]
					if p.Parent == nil then
						if etat.coureurs[p] == c then
							etat.coureurs[p] = nil
						end
					elseif etat.coureurs[p] == c then
						if c.auDepart then
							-- encore sur le départ : le chrono reste à 0
							local perso = p.Character
							local racine = perso and perso:FindFirstChild("HumanoidRootPart")
							if racine ~= nil and surDepart(c.course, racine.Position) then
								c.debut = maintenant
							else
								c.auDepart = false
							end
						end
						if c.annonce ~= nil and maintenant < c.annonceFin then
							-- tour de circuit : le temps du tour précédent reste affiché un instant
							montrer(p, c, c.annonce, c.annonceCouleurs)
						else
							montrer(p, c, texteTemps(maintenant - c.debut, false), bleu)
						end
					end
				end
				task.wait(0.1)
			end
			etat.coureursActifs = false
		end)
	end
	local function toucheDepart(course, autre)
		local p = joueurDe(autre)
		if p == nil then
			return
		end
		local maintenant = os.clock()
		local arrive = course.arrivees[p]
		if arrive ~= nil and maintenant - arrive < 2 then
			-- vient d'arriver : on lui laisse le temps de voir son temps
			return
		end
		local c = etat.coureurs[p]
		if c ~= nil and c.course == course and (c.auDepart or course.arrivee == course.depart) then
			-- déjà au départ, ou tour de circuit en cours (l'arrivée s'en occupe)
			return
		end
		if c == nil then
			-- nouveau coureur : on oublie les joueurs partis
			for ancien in pairs(etat.coureurs) do
				if ancien.Parent == nil then
					etat.coureurs[ancien] = nil
				end
			end
		end
		etat.coureurs[p] = { course = course, debut = maintenant, auDepart = true }
		etat.chronoJetons[p] = nil
		boucle()
	end
	local function toucheArrivee(course, autre)
		local p, perso = joueurDe(autre)
		if p == nil then
			return
		end
		local c = etat.coureurs[p]
		if c == nil or c.course ~= course or c.auDepart then
			return
		end
		local maintenant = os.clock()
		etat.coureurs[p] = nil
		course.arrivees[p] = maintenant
		local temps = maintenant - c.debut
		local texte = "Arrivée : " .. texteTemps(temps, true)
		local couleurs = vert
		if enregistrer(p, temps) then
			texte = "Record ! " .. texteTemps(temps, true)
			couleurs = dore
		end
		local final = { etiquette = c.etiquette, couleurs = c.couleurs }
		montrer(p, final, texte, couleurs)
		_jouerSon("rbxasset://sounds/electronicpingshort.wav", perso, 0.6)
		if course.arrivee == course.depart then
			-- tour de circuit : le tour suivant commence tout de suite (il part quand le joueur quitte la
			-- ligne) ; le temps de ce tour reste affiché 2,5 s
			etat.coureurs[p] = {
				course = course,
				debut = maintenant,
				auDepart = true,
				etiquette = final.etiquette,
				affiche = final.affiche,
				couleurs = final.couleurs,
				annonce = texte,
				annonceCouleurs = couleurs,
				annonceFin = maintenant + 2.5,
			}
			boucle()
			return
		end
		-- la pilule disparaît 4 s plus tard (sauf si le joueur est reparti)
		local jeton = {}
		etat.chronoJetons[p] = jeton
		task.delay(4, function()
			if etat.chronoJetons[p] ~= jeton or etat.coureurs[p] ~= nil then
				return
			end
			etat.chronoJetons[p] = nil
			local interface = p:FindFirstChildOfClass("PlayerGui")
			local ecran = interface and interface:FindFirstChild("BlocsFR_Chrono")
			if ecran ~= nil then
				ecran:Destroy()
			end
		end)
	end
	task.spawn(function()
		local objDepart, objArrivee = nil, nil
		local attente = 0
		while true do
			objDepart = _tpCible(depart)
			objArrivee = _tpCible(arrivee)
			if (typeof(objDepart) == "Instance" and typeof(objArrivee) == "Instance") or attente >= 5 then
				break
			end
			attente += task.wait(0.5)
		end
		for _, ligne in ipairs({ { objDepart, depart, "le départ" }, { objArrivee, arrivee, "l'arrivée" } }) do
			if typeof(ligne[1]) ~= "Instance" or #_parties(ligne[1]) == 0 then
				_tpAvertirUneFois(etat, "chrono:" .. _texte(ligne[2]), "« chronomètre » : " .. ligne[3] .. " « " .. _texte(ligne[2]) .. " » est introuvable (ou ne contient aucune partie). Crée une partie avec ce nom, ou choisis l'objet avec « objet nommé … ».")
				return
			end
		end
		if etat.chronos[objDepart] ~= nil then
			return
		end
		local cf, taille = _boiteObjet(objDepart)
		local course = { depart = objDepart, arrivee = objArrivee, cf = cf, taille = taille, arrivees = setmetatable({}, { __mode = "k" }) }
		etat.chronos[objDepart] = course
		for _, partie in ipairs(_parties(objDepart)) do
			partie.Touched:Connect(function(autre)
				toucheDepart(course, autre)
			end)
		end
		for _, partie in ipairs(_parties(objArrivee)) do
			partie.Touched:Connect(function(autre)
				toucheArrivee(course, autre)
			end)
		end
	end)
end]],
	},

	-- « la lave … monte de … studs par seconde jusqu'à … » : monte jusqu'à « hauteur » studs au-dessus de
	-- sa place puis s'arrête (une partie Part posée à plat grandit vers le haut, son dessous ne bouge
	-- pas ; sinon l'objet monte). Elle élimine au contact (_tpMortel) et, toutes les 0,1 s, les
	-- personnages des joueurs dans ses parties (requête limitée à ces personnages : le décor noyé n'est
	-- jamais parcouru). Le message « fin » remet en bas toutes les laves du script ; elles remontent 3 s
	-- plus tard. Animée par _tpMoteur.
	_tpLaveMontante = {
		deps = { "_tpObjetValide", "_tpMortel", "_tpPersoDe", "_tpMoteur", "_surMessage", "_nombreOu" },
		services = { "Players" },
		code = [[
local function _tpLaveMontante(etat, valeur, vitesse, hauteur)
	local objet, parties = _tpObjetValide(etat, valeur, "lave qui monte")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.laves = etat.laves or setmetatable({}, { __mode = "k" })
	local function placer(l)
		local montee = l.montee
		if l.grandit then
			-- 2048 studs au plus pour une partie (déjà presque aussi haute : elle ne grandit plus)
			montee = math.clamp(montee, 0, math.max(2040 - l.taille.Y, 0))
			l.objet.Size = l.taille + Vector3.new(0, montee, 0)
			l.objet.CFrame = l.base + Vector3.new(0, montee / 2, 0)
		elseif l.objet:IsA("BasePart") then
			l.objet.CFrame = l.base + Vector3.new(0, montee, 0)
		else
			l.objet:PivotTo(l.base + Vector3.new(0, montee, 0))
		end
	end
	local v = math.clamp(_nombreOu(vitesse, 1), 0, 500)
	local hmax = math.clamp(_nombreOu(hauteur, 50), 0, 2000)
	local lave = etat.laves[objet]
	if lave ~= nil then
		lave.vitesse = v
		lave.hauteur = hmax
		if lave.montee > hmax then
			lave.montee = hmax
			placer(lave)
		end
		return
	end
	for _, partie in ipairs(parties) do
		partie.Anchored = true
	end
	-- au contact : éliminé tout de suite (joueurs et PNJ)
	_tpMortel(etat, objet)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local estPartie = objet:IsA("BasePart")
	lave = {
		objet = objet,
		parties = parties,
		base = estPartie and objet.CFrame or objet:GetPivot(),
		taille = estPartie and objet.Size or nil,
		grandit = estPartie and objet.ClassName == "Part" and objet.Shape == Enum.PartType.Block and math.abs(objet.CFrame.UpVector.Y) > 0.99,
		montee = 0,
		vitesse = v,
		hauteur = hmax,
		pause = 0,
		verif = 0,
	}
	etat.laves[objet] = lave
	if not etat.lavesMessage then
		-- message « fin » : toutes les laves du script redescendent, et remontent 3 s plus tard
		etat.lavesMessage = true
		_surMessage("fin", function()
			for o, l in pairs(etat.laves) do
				if o.Parent ~= nil then
					l.montee = 0
					l.pause = 3
					placer(l)
				end
			end
		end)
	end
	local marge = Vector3.new(1, 1, 1)
	_tpMoteur(etat, objet, function(dt)
		if not objet:IsDescendantOf(workspace) then
			return true
		end
		if lave.pause > 0 then
			lave.pause -= dt
		elseif lave.montee < lave.hauteur and lave.vitesse > 0 then
			lave.montee = math.min(lave.montee + lave.vitesse * dt, lave.hauteur)
			placer(lave)
		end
		lave.verif -= dt
		if lave.verif > 0 then
			return true
		end
		lave.verif = 0.1
		-- personnages des joueurs dans la lave (ou posés dessus)
		local persos = {}
		for _, joueurEnJeu in ipairs(Players:GetPlayers()) do
			if joueurEnJeu.Character ~= nil then
				table.insert(persos, joueurEnJeu.Character)
			end
		end
		if #persos == 0 then
			return true
		end
		params.FilterDescendantsInstances = persos
		local vus = {}
		for _, partie in ipairs(lave.parties) do
			if partie.Parent ~= nil then
				local ok, trouvees = pcall(workspace.GetPartBoundsInBox, workspace, partie.CFrame, partie.Size + marge, params)
				if ok and type(trouvees) == "table" then
					for _, morceau in ipairs(trouvees) do
						local parent = morceau.Parent
						if parent ~= nil and not vus[parent] then
							vus[parent] = true
							local perso, h = _tpPersoDe(etat, morceau)
							if perso ~= nil and h ~= nil and h.Health > 0 then
								h.Health = 0
							end
						end
					end
				end
			end
		end
		return true
	end, function()
		if etat.laves[objet] == lave then
			etat.laves[objet] = nil
		end
	end)
end]],
	},

	-- Bonus temporaire d'une propriété de l'Humanoid (WalkSpeed, JumpPower, JumpHeight). La valeur d'avant,
	-- la valeur mise et la fin sont des attributs de l'Humanoid (« BlocsFR_Avant… », « BlocsFR_Mise… »,
	-- « BlocsFR_Fin… ») : plusieurs zones (même dans d'autres scripts) prolongent le même bonus au lieu de
	-- s'empiler. À la fin, la valeur d'avant revient, sauf si un autre bloc l'a changée entre-temps.
	-- duree <= 0 : jusqu'à la réapparition. Une seule vérification prévue (task.delay) par Humanoid et
	-- par propriété dans chaque script. Renvoie vrai pour un nouveau bonus.
	_tpBoost = {
		deps = {},
		services = {},
		code = [[
local function _tpBoost(etat, h, propriete, valeur, duree)
	local cleAvant = "BlocsFR_Avant" .. propriete
	local cleMise = "BlocsFR_Mise" .. propriete
	local cleFin = "BlocsFR_Fin" .. propriete
	local nouveau = type(h:GetAttribute(cleAvant)) ~= "number"
	if nouveau then
		h:SetAttribute(cleAvant, h[propriete])
	end
	h[propriete] = valeur
	h:SetAttribute(cleMise, valeur)
	if duree <= 0 then
		-- jusqu'à la réapparition : aucune fin
		h:SetAttribute(cleFin, -1)
		return nouveau
	end
	h:SetAttribute(cleFin, os.clock() + duree)
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.boostsPrevus = etat.boostsPrevus or setmetatable({}, { __mode = "k" })
	local prevus = etat.boostsPrevus[h]
	if prevus == nil then
		prevus = {}
		etat.boostsPrevus[h] = prevus
	end
	if prevus[propriete] then
		return nouveau
	end
	prevus[propriete] = true
	local function verifier()
		local fin = h:GetAttribute(cleFin)
		if h.Parent == nil or type(fin) ~= "number" or fin < 0 then
			-- terminé par un autre script, devenu sans fin, ou personnage disparu
			prevus[propriete] = nil
			return
		end
		local reste = fin - os.clock()
		if reste > 0.01 then
			-- prolongé entre-temps
			task.delay(reste, verifier)
			return
		end
		prevus[propriete] = nil
		local avant = h:GetAttribute(cleAvant)
		local mise = h:GetAttribute(cleMise)
		if type(avant) == "number" and type(mise) == "number" and math.abs(h[propriete] - mise) < 0.01 then
			h[propriete] = avant
		end
		h:SetAttribute(cleAvant, nil)
		h:SetAttribute(cleMise, nil)
		h:SetAttribute(cleFin, nil)
	end
	task.delay(duree, verifier)
	return nouveau
end]],
	},

	-- « zone de vitesse … » / « zone de super saut … » (genre "vitesse" / "saut") : un personnage qui touche
	-- la zone reçoit le bonus (_tpBoost) ; 0,25 s de pause par personnage (table à clés faibles). Saut :
	-- JumpPower si l'Humanoid l'utilise, sinon la hauteur de saut équivalente (force² / (2 × gravité)).
	-- Les deux blocs sur le même objet s'ajoutent (un registre par genre).
	_tpZoneBoost = {
		deps = { "_tpObjetValide", "_tpPersoDe", "_tpBoost", "_tpEclat", "_jouerSon", "_nombreOu" },
		services = { "Players", "RunService" },
		code = [[
local function _tpZoneBoost(etat, valeur, genre, montant, duree)
	local saut = genre == "saut"
	local action = "zone de vitesse"
	local registre = "zonesVitesse"
	if saut then
		action = "zone de super saut"
		registre = "zonesSaut"
	end
	local objet, parties = _tpObjetValide(etat, valeur, action)
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat[registre] = etat[registre] or setmetatable({}, { __mode = "k" })
	local reglage = etat[registre][objet]
	if reglage == nil then
		reglage = { montant = 0, duree = 0, derniers = setmetatable({}, { __mode = "k" }) }
		etat[registre][objet] = reglage
		local client = RunService:IsClient()
		local couleur = Color3.fromRGB(56, 189, 248)
		local son = "rbxasset://sounds/swoosh.wav"
		if saut then
			couleur = Color3.fromRGB(47, 191, 90)
			son = "rbxasset://sounds/electronicpingshort.wav"
		end
		local function touche(autre)
			local perso, h = _tpPersoDe(etat, autre)
			if perso == nil or h == nil or h.Health <= 0 then
				return
			end
			if client and Players:GetPlayerFromCharacter(perso) ~= Players.LocalPlayer then
				return
			end
			local maintenant = os.clock()
			local dernier = reglage.derniers[h]
			if dernier ~= nil and maintenant - dernier < 0.25 then
				return
			end
			if dernier == nil then
				-- nouveau personnage : on oublie ceux qui ne sont plus dans le jeu
				for ancien in pairs(reglage.derniers) do
					if ancien.Parent == nil then
						reglage.derniers[ancien] = nil
					end
				end
			end
			reglage.derniers[h] = maintenant
			local nouveau = false
			if not saut then
				nouveau = _tpBoost(etat, h, "WalkSpeed", reglage.montant, reglage.duree)
			elseif h.UseJumpPower then
				nouveau = _tpBoost(etat, h, "JumpPower", reglage.montant, reglage.duree)
			else
				local gravite = math.max(workspace.Gravity, 1)
				nouveau = _tpBoost(etat, h, "JumpHeight", reglage.montant * reglage.montant / (2 * gravite), reglage.duree)
			end
			if nouveau then
				_tpEclat(objet, couleur, 0.3)
				_jouerSon(son, perso, 0.5)
			end
		end
		for _, partie in ipairs(parties) do
			partie.Touched:Connect(touche)
		end
	end
	local defaut = 40
	if saut then
		defaut = 100
	end
	reglage.montant = math.clamp(_nombreOu(montant, defaut), 0, 1000)
	reglage.duree = math.clamp(_nombreOu(duree, 3), 0, 3600)
end]],
	},

	-- « porte … réservée à qui a … … » : un joueur qui a au moins « mini » dans la statistique ouvre la
	-- porte 1 s (traversable et transparente, prolongée tant qu'il la touche) ; les autres sont repoussés
	-- (au plus toutes les 0,4 s) et voient « Il te faut … » (toutes les 2 s). Rien n'est retiré.
	-- Les parties sont ancrées (traversable, une porte non ancrée tomberait à travers le sol) ; un
	-- minimum de 0 (ou moins) laisse passer tout le monde, même sans la statistique.
	-- NOTE: une collision différente pour chaque joueur est impossible côté serveur : pendant
	-- l'ouverture, un autre joueur qui touche la porte est repoussé.
	_tpPorteVip = {
		deps = {
			"_tpObjetValide",
			"_tpPersoDe",
			"_statTrouver",
			"_tpRepousser",
			"_tpEclat",
			"_jouerSon",
			"_messageEcran",
			"_texte",
			"_nombreOu",
		},
		services = { "Players", "RunService" },
		code = [[
local function _tpPorteVip(etat, valeur, mini, stat)
	local objet, parties = _tpObjetValide(etat, valeur, "porte réservée")
	if objet == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.portesVip = etat.portesVip or setmetatable({}, { __mode = "k" })
	local reglage = etat.portesVip[objet]
	if reglage == nil then
		reglage = {
			mini = 100,
			stat = "",
			ouverte = false,
			fin = 0,
			repousses = setmetatable({}, { __mode = "k" }),
			avertis = setmetatable({}, { __mode = "k" }),
		}
		etat.portesVip[objet] = reglage
		for _, partie in ipairs(parties) do
			partie.Anchored = true
		end
		local client = RunService:IsClient()
		local vert = Color3.fromRGB(47, 191, 90)
		local rouge = Color3.fromRGB(229, 56, 59)
		local function ouvrir()
			reglage.fin = os.clock() + 1
			if reglage.ouverte then
				return
			end
			reglage.ouverte = true
			local sauve = {}
			for _, partie in ipairs(parties) do
				if partie.Parent ~= nil then
					table.insert(sauve, { partie, partie.CanCollide, partie.Transparency })
					partie.CanCollide = false
					partie.Transparency = math.max(partie.Transparency, 0.6)
				end
			end
			_tpEclat(objet, vert, 0.3)
			_jouerSon("rbxasset://sounds/electronicpingshort.wav", objet, 0.5)
			local function fermer()
				local reste = reglage.fin - os.clock()
				if reste > 0.01 and objet.Parent ~= nil then
					task.delay(reste, fermer)
					return
				end
				for _, ligne in ipairs(sauve) do
					local partie = ligne[1]
					if partie.Parent ~= nil then
						partie.CanCollide = ligne[2]
						partie.Transparency = ligne[3]
					end
				end
				reglage.ouverte = false
			end
			task.delay(1, fermer)
		end
		local function touche(autre)
			local perso, h = _tpPersoDe(etat, autre)
			if perso == nil or perso == objet or h == nil or h.Health <= 0 then
				return
			end
			local p = Players:GetPlayerFromCharacter(perso)
			if p == nil or (client and p ~= Players.LocalPlayer) then
				return
			end
			-- minimum 0 (ou moins) : tout le monde passe, même sans la statistique
			local assez = reglage.mini <= 0
			if not assez then
				local compte = _statTrouver(p, reglage.stat, nil)
				assez = compte ~= nil and (compte:IsA("IntValue") or compte:IsA("NumberValue")) and compte.Value >= reglage.mini
			end
			if assez then
				ouvrir()
				return
			end
			-- pas assez : repoussé, et le message de temps en temps
			local maintenant = os.clock()
			local dernier = reglage.repousses[perso]
			if dernier ~= nil and maintenant - dernier < 0.4 then
				return
			end
			if dernier == nil then
				for ancien in pairs(reglage.repousses) do
					if ancien.Parent == nil then
						reglage.repousses[ancien] = nil
					end
				end
			end
			reglage.repousses[perso] = maintenant
			_tpRepousser(perso, objet, 60)
			local averti = reglage.avertis[p]
			if averti == nil or maintenant - averti >= 2 then
				if averti == nil then
					for ancien in pairs(reglage.avertis) do
						if ancien.Parent == nil then
							reglage.avertis[ancien] = nil
						end
					end
				end
				reglage.avertis[p] = maintenant
				_tpEclat(objet, rouge, 0.3)
				_messageEcran(p, "Il te faut " .. _texte(reglage.mini) .. " " .. reglage.stat .. " pour passer cette porte.", 2)
			end
		end
		for _, partie in ipairs(parties) do
			partie.Touched:Connect(touche)
		end
	end
	reglage.mini = _nombreOu(mini, 100)
	reglage.stat = _texte(stat)
end]],
	},

	-- Modèle à copier (partie ou modèle) : l'objet donné, ou cherché par son nom dans ServerStorage,
	-- ReplicatedStorage, Workspace puis Lighting. Renvoie une copie privée gardée en mémoire (sans ce
	-- script s'il est dedans : sinon chaque copie relancerait le bloc), ou nil + avertissement.
	_tpGabarit = {
		deps = { "_obj", "_texte", "_estProtege", "_tpAvertirUneFois" },
		services = {},
		code = [[
local function _tpGabarit(etat, modele, action)
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.gabarits = etat.gabarits or setmetatable({}, { __mode = "k" })
	local nom = _texte(modele)
	local cle = modele
	if typeof(modele) ~= "Instance" then
		cle = nom
	end
	local deja = etat.gabarits[cle]
	if deja ~= nil then
		return deja
	end
	local original = nil
	if typeof(modele) == "Instance" then
		original = _obj(modele)
	elseif nom ~= "" then
		for _, nomService in ipairs({ "ServerStorage", "ReplicatedStorage", "Workspace", "Lighting" }) do
			local ok, service = pcall(function()
				return game:GetService(nomService)
			end)
			if ok and service then
				local trouve = service:FindFirstChild(nom, true)
				if trouve then
					original = trouve
					break
				end
			end
		end
	end
	if original == nil then
		_tpAvertirUneFois(etat, "gabarit:" .. nom, "« " .. action .. " » : aucun objet nommé « " .. nom .. " » dans ServerStorage, ReplicatedStorage ou Workspace.")
		return nil
	end
	if _estProtege(original) or not original:IsA("PVInstance") then
		_tpAvertirUneFois(etat, "gabarit:type:" .. original.Name, "« " .. action .. " » : « " .. original.Name .. " » n'est ni une partie ni un modèle.")
		return nil
	end
	local scriptDedans = script:IsDescendantOf(original)
	local archivableScript = script.Archivable
	local archivableObjet = original.Archivable
	if scriptDedans then
		script.Archivable = false
	end
	original.Archivable = true
	local ok, copie = pcall(function()
		return original:Clone()
	end)
	original.Archivable = archivableObjet
	if scriptDedans then
		script.Archivable = archivableScript
	end
	if not ok or copie == nil then
		_tpAvertirUneFois(etat, "gabarit:copie:" .. original.Name, "« " .. action .. " » : impossible de copier « " .. original.Name .. " ».")
		return nil
	end
	etat.gabarits[cle] = copie
	return copie
end]],
	},

	-- « … suit … comme un familier » : une copie du modèle (ancrée, sans collision, sans contact) flotte
	-- derrière l'épaule du joueur et le suit (sa CFrame rattrape la cible en douceur à chaque image, avec
	-- un petit flottement), même après une réapparition ; elle disparaît quand le joueur quitte le jeu.
	-- Un familier par joueur pour ce script (un autre modèle remplace l'ancien) ; les familiers d'un même
	-- joueur venant d'autres scripts prennent d'autres places (_tpPartage). Dossier « BlocsFR_Familiers ».
	-- La copie attend hors du monde (ServerStorage) jusqu'à sa première place : sans personnage (joueur
	-- qui vient d'arriver), elle ne se montre pas à la place du modèle d'origine.
	_tpFamilier = {
		deps = { "_exigerJoueur", "_tpGabarit", "_parties", "_tpPartage", "_tpMoteur", "_texte" },
		services = { "RunService" },
		code = [[
local function _tpFamilier(etat, modele, qui)
	local p = _exigerJoueur(qui, "suit comme un familier")
	if p == nil then
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.familiers = etat.familiers or setmetatable({}, { __mode = "k" })
	local cle = modele
	if typeof(modele) ~= "Instance" then
		cle = _texte(modele)
	end
	local ancien = etat.familiers[p]
	if ancien ~= nil and ancien.objet.Parent ~= nil then
		if ancien.cle == cle then
			-- ce joueur a déjà ce familier
			return
		end
		ancien.objet:Destroy()
	end
	local gabarit = _tpGabarit(etat, modele, "suit comme un familier")
	if gabarit == nil then
		return
	end
	local ok, copie = pcall(function()
		return gabarit:Clone()
	end)
	if not ok or copie == nil then
		return
	end
	for _, partie in ipairs(_parties(copie)) do
		partie.Anchored = true
		partie.CanCollide = false
		partie.CanTouch = false
		partie.CanQuery = false
	end
	copie:SetAttribute("BlocsFR_Familier", p.UserId)
	-- place libre derrière le joueur : épaule droite, épaule gauche, au-dessus…
	local partage = _tpPartage()
	partage.familiers = partage.familiers or setmetatable({}, { __mode = "k" })
	local liste = partage.familiers[p] or {}
	partage.familiers[p] = liste
	for i = #liste, 1, -1 do
		if liste[i].Parent == nil then
			table.remove(liste, i)
		end
	end
	table.insert(liste, copie)
	local places = {
		Vector3.new(2.5, 1.5, 2.5),
		Vector3.new(-2.5, 1.5, 2.5),
		Vector3.new(0, 3.5, 3),
		Vector3.new(4, 0.5, 0.5),
		Vector3.new(-4, 0.5, 0.5),
	}
	local decalage = places[(#liste - 1) % #places + 1]
	local m = { objet = copie, cle = cle, estPartie = copie:IsA("BasePart"), cf = nil, t = math.random() * 6, perso = nil, racine = nil, place = false }
	etat.familiers[p] = m
	-- hors du monde jusqu'à sa première place (le moteur la garde : son parent n'est pas vide)
	local okRangement, rangement = pcall(function()
		if RunService:IsServer() then
			return game:GetService("ServerStorage")
		end
		return game:GetService("ReplicatedStorage")
	end)
	if not okRangement or rangement == nil then
		rangement = workspace
	end
	copie.Parent = rangement
	_tpMoteur(etat, copie, function(dt)
		if p.Parent == nil then
			-- le joueur a quitté le jeu
			copie:Destroy()
			return false
		end
		local perso = p.Character
		if perso ~= m.perso or m.racine == nil or m.racine.Parent == nil then
			m.perso = perso
			m.racine = nil
			if perso ~= nil then
				local racine = perso:FindFirstChild("HumanoidRootPart")
				if racine ~= nil and racine:IsA("BasePart") then
					m.racine = racine
				end
			end
		end
		if m.racine == nil then
			return true
		end
		m.t += dt
		local cible = m.racine.CFrame * CFrame.new(decalage.X, decalage.Y + math.sin(m.t * 2.5) * 0.35, decalage.Z)
		local cf = cible
		if m.cf ~= nil and (m.cf.Position - cible.Position).Magnitude < 40 then
			-- rattrape la cible en douceur (trop loin : réapparition, téléportation -> tout de suite)
			cf = m.cf:Lerp(cible, 1 - math.exp(-dt * 7))
		end
		m.cf = cf
		if m.estPartie then
			copie.CFrame = cf
		else
			copie:PivotTo(cf)
		end
		if not m.place then
			-- première place trouvée : le familier entre dans le monde
			m.place = true
			local dossier = workspace:FindFirstChild("BlocsFR_Familiers")
			if dossier == nil then
				dossier = Instance.new("Folder")
				dossier.Name = "BlocsFR_Familiers"
				dossier.Parent = workspace
			end
			copie.Parent = dossier
		end
		return true
	end, function()
		if etat.familiers[p] == m then
			etat.familiers[p] = nil
		end
		if copie.Parent ~= nil then
			copie:Destroy()
		end
	end)
end]],
	},

	-- « … réapparaît … s après sa mort » : une copie du PNJ est gardée au départ (pleine vie, sans les
	-- effets temporaires des blocs : barre de vie, flash, recul…) ; à sa mort, après le délai, une
	-- nouvelle copie apparaît à la place de départ puis l'ancien corps est retiré. Script DANS le PNJ : la
	-- copie contient ce script, qui s'occupe à son tour de la suivante (et refait ses autres blocs).
	-- Script ailleurs : ce script surveille aussi chaque nouvelle copie.
	_tpPnjReapparait = {
		deps = { "_humanoid", "_obj", "_nombreOu", "_tpAvertirUneFois" },
		services = { "Players" },
		code = [[
local function _tpPnjReapparait(etat, valeur, delai)
	local h = _humanoid(valeur)
	if h == nil or h.Parent == nil then
		local objet = _obj(valeur)
		local nom = "?"
		if objet then
			nom = objet.Name
		end
		_tpAvertirUneFois(etat, "reapparait:" .. nom, "« réapparaît après sa mort » : « " .. nom .. " » n'est pas un PNJ (il faut un modèle qui contient un Humanoid).")
		return
	end
	local pnj = h.Parent
	if Players:GetPlayerFromCharacter(pnj) ~= nil then
		_tpAvertirUneFois(etat, "reapparait:joueur", "« réapparaît après sa mort » : les joueurs réapparaissent déjà tout seuls ; ce bloc est fait pour les PNJ.")
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.reapparitions = etat.reapparitions or setmetatable({}, { __mode = "k" })
	local d = math.clamp(_nombreOu(delai, 5), 0, 3600)
	local reglage = etat.reapparitions[pnj]
	if reglage ~= nil then
		reglage.delai = d
		return
	end
	local archivable = pnj.Archivable
	pnj.Archivable = true
	local ok, gabarit = pcall(function()
		return pnj:Clone()
	end)
	pnj.Archivable = archivable
	if not ok or gabarit == nil then
		_tpAvertirUneFois(etat, "reapparait:copie:" .. pnj.Name, "« réapparaît après sa mort » : impossible de copier « " .. pnj.Name .. " ».")
		return
	end
	-- la copie gardée : pleine vie, sans les effets temporaires des blocs
	local temporaires = {
		BlocsFR_BarreVie = true,
		BlocsFR_Flash = true,
		BlocsFR_Eclat = true,
		BlocsFR_Poussee = true,
		BlocsFR_Invincible = true,
		BlocsFR_Son = true,
	}
	for _, morceau in ipairs(gabarit:GetDescendants()) do
		if temporaires[morceau.Name] or morceau:GetAttribute("BlocsFR_VFX") == true then
			morceau:Destroy()
		end
	end
	local hg = gabarit:FindFirstChildOfClass("Humanoid")
	if hg ~= nil and hg.Health < hg.MaxHealth then
		hg.Health = hg.MaxHealth
	end
	reglage = { delai = d }
	local scriptDedans = script:IsDescendantOf(pnj)
	local parent = pnj.Parent
	local function surveiller(modele, hum)
		etat.reapparitions[modele] = reglage
		hum.Died:Connect(function()
			task.delay(reglage.delai, function()
				local okCopie, nouveau = pcall(function()
					return gabarit:Clone()
				end)
				if okCopie and nouveau ~= nil then
					local destination = parent
					if destination == nil or not destination:IsDescendantOf(game) then
						destination = workspace
					end
					nouveau.Parent = destination
					if not scriptDedans then
						local hn = nouveau:FindFirstChildOfClass("Humanoid")
						if hn ~= nil then
							surveiller(nouveau, hn)
						end
					end
				end
				-- en dernier : si ce script est dans l'ancien corps, il s'arrête ici
				if modele.Parent ~= nil then
					modele:Destroy()
				end
			end)
		end)
	end
	surveiller(pnj, h)
end]],
	},

	-- Pièce de butin (partie « BlocsFR_Piece », valeur dans l'attribut « BlocsFR_Valeur ») : le joueur qui
	-- la touche gagne sa valeur en « Pièces ». Sa connexion est rangée dans _tpPartage : si le script qui
	-- l'a faite disparaît (PNJ retiré…), le prochain script de butin la reprend (_tpAdopterPieces).
	_tpBrancherPiece = {
		deps = { "_tpPartage", "_tpPersoDe", "_ajouterStat", "_jouerSon", "_nombreOu" },
		services = { "Players" },
		code = [[
local function _tpBrancherPiece(etat, piece)
	local partage = _tpPartage()
	partage.piecesButin = partage.piecesButin or setmetatable({}, { __mode = "k" })
	-- un court instant pour la voir jaillir avant de pouvoir la prendre
	local prete = os.clock() + 0.4
	local connexion = nil
	connexion = piece.Touched:Connect(function(autre)
		if os.clock() < prete or piece.Parent == nil or piece:GetAttribute("BlocsFR_Prise") then
			return
		end
		local perso, h = _tpPersoDe(etat, autre)
		if perso == nil or h == nil or h.Health <= 0 then
			return
		end
		local p = Players:GetPlayerFromCharacter(perso)
		if p == nil then
			return
		end
		piece:SetAttribute("BlocsFR_Prise", true)
		connexion:Disconnect()
		partage.piecesButin[piece] = nil
		_ajouterStat(p, "Pièces", _nombreOu(piece:GetAttribute("BlocsFR_Valeur"), 1))
		_jouerSon("rbxasset://sounds/electronicpingshort.wav", perso, 0.5)
		piece:Destroy()
	end)
	partage.piecesButin[piece] = connexion
end]],
	},

	-- Reprend les pièces de butin dont le script a disparu (connexion coupée)
	_tpAdopterPieces = {
		deps = { "_tpPartage", "_tpBrancherPiece" },
		services = {},
		code = [[
local function _tpAdopterPieces(etat)
	local pieces = _tpPartage().piecesButin
	if pieces == nil then
		return
	end
	for piece, connexion in pairs(pieces) do
		if piece.Parent == nil then
			pieces[piece] = nil
		elseif not connexion.Connected then
			_tpBrancherPiece(etat, piece)
		end
	end
end]],
	},

	-- Fait jaillir « total » pièces de butin d'une position : 20 parties au plus (au-delà, chaque pièce
	-- vaut plus), physique gérée par le serveur, retirées au bout de 30 s
	_tpLacherPieces = {
		deps = { "_tpBrancherPiece", "_nombreOu" },
		services = { "Debris", "RunService" },
		code = [[
local function _tpLacherPieces(etat, position, total)
	local n = math.floor(math.clamp(_nombreOu(total, 0), 0, 1000000))
	if n <= 0 then
		return
	end
	local nombre = math.min(n, 20)
	local valeur = math.floor(n / nombre)
	local reste = n - valeur * nombre
	for i = 1, nombre do
		local piece = Instance.new("Part")
		piece.Name = "BlocsFR_Piece"
		piece.Shape = Enum.PartType.Cylinder
		piece.Size = Vector3.new(0.35, 1.5, 1.5)
		piece.Color = Color3.fromRGB(255, 190, 30)
		piece.Material = Enum.Material.Neon
		piece.CastShadow = false
		piece.CFrame = CFrame.new(position + Vector3.new(math.random() * 2 - 1, 1.5, math.random() * 2 - 1)) * CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
		local v = valeur
		if i <= reste then
			v += 1
		end
		piece:SetAttribute("BlocsFR_Valeur", v)
		piece.Parent = workspace
		local angle = math.random() * 2 * math.pi
		local elan = 8 + math.random() * 8
		piece.AssemblyLinearVelocity = Vector3.new(math.cos(angle) * elan, 22 + math.random() * 10, math.sin(angle) * elan)
		if RunService:IsServer() then
			pcall(function()
				piece:SetNetworkOwner(nil)
			end)
		end
		Debris:AddItem(piece, 30)
		_tpBrancherPiece(etat, piece)
	end
end]],
	},

	-- « quand … meurt, il lâche … pièces » : à la mort (Humanoid.Died, une seule connexion), des pièces
	-- jaillissent de sa racine. Marche pour un PNJ comme pour le personnage d'un joueur.
	_tpButin = {
		deps = { "_humanoid", "_obj", "_partie", "_nombreOu", "_tpAvertirUneFois", "_tpAdopterPieces", "_tpLacherPieces" },
		services = {},
		code = [[
local function _tpButin(etat, valeur, nombre)
	local h = _humanoid(valeur)
	if h == nil or h.Parent == nil then
		local objet = _obj(valeur)
		local nom = "?"
		if objet then
			nom = objet.Name
		end
		_tpAvertirUneFois(etat, "butin:" .. nom, "« lâche des pièces » : « " .. nom .. " » n'est pas un PNJ (il faut un modèle qui contient un Humanoid).")
		return
	end
	if type(etat) ~= "table" then
		etat = {}
	end
	etat.butins = etat.butins or setmetatable({}, { __mode = "k" })
	local n = math.max(math.floor(_nombreOu(nombre, 5)), 0)
	local reglage = etat.butins[h]
	if reglage ~= nil then
		reglage.nombre = n
		return
	end
	reglage = { nombre = n }
	etat.butins[h] = reglage
	-- pièces laissées par un script disparu (PNJ réapparu…) : ce script les reprend
	_tpAdopterPieces(etat)
	h.Died:Connect(function()
		local perso = h.Parent
		if perso == nil then
			return
		end
		local racine = perso:FindFirstChild("HumanoidRootPart")
		if racine == nil or not racine:IsA("BasePart") then
			racine = _partie(perso)
		end
		if racine == nil then
			return
		end
		_tpAdopterPieces(etat)
		_tpLacherPieces(etat, racine.Position, reglage.nombre)
	end)
end]],
	},
}

return {
	category = "toutprets",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Defs_Valeurs</string><ProtectedString name="Source"><![CDATA[-- Defs_Valeurs : blocs de la catégorie « Valeurs »
-- vrai / faux, variables de contexte (le joueur, la partie touchée…), nombres, textes,
-- vecteurs, positions et couleurs. Ce sont tous des blocs valeur (reporter) ou booléens :
-- leur fonction gen renvoie une seule expression Luau.

local Shared = require(script.Parent.Shared)

-- Bloc qui renvoie toujours le même code (constante ou variable de contexte)
local function constante(code)
	return function()
		return code
	end
end

local blocks = {
	{
		id = "val_vrai",
		shape = "boolean",
		label = "vrai",
		keywords = "true oui juste booleen condition",
		tooltip = "La valeur « vrai » (oui).",
		gen = constante("true"),
	},
	{
		id = "val_faux",
		shape = "boolean",
		label = "faux",
		keywords = "false non booleen condition",
		tooltip = "La valeur « faux » (non).",
		gen = constante("false"),
	},
	{
		id = "val_cet_objet",
		shape = "reporter",
		label = "cet objet",
		keywords = "objet script parent moi soi self",
		tooltip = "L'objet dans lequel se trouve ce script (la cible choisie dans l'explorateur).",
		gen = constante("script.Parent"),
	},
	{
		id = "val_partie_touchee",
		shape = "reporter",
		label = "la partie touchée",
		keywords = "partie touche toucher contact hit collision",
		tooltip = "La partie qui vient de toucher l'objet (dans un événement « Quand cet objet est touché »). Vide ailleurs.",
		gen = constante("partieTouchee"),
	},
	{
		id = "val_joueur",
		shape = "reporter",
		label = "le joueur",
		keywords = "joueur player utilisateur",
		tooltip = "Le joueur concerné par l'événement (celui qui a touché, cliqué, rejoint…). Dans un script local : le joueur local.",
		gen = constante("joueur"),
	},
	{
		id = "val_personnage",
		shape = "reporter",
		label = "le personnage",
		keywords = "personnage avatar character corps",
		tooltip = "Le personnage (avatar) concerné par l'événement. Dans un script local : le personnage du joueur local.",
		gen = constante("personnage"),
	},
	{
		id = "val_dernier_objet",
		shape = "reporter",
		label = "le dernier objet créé",
		keywords = "dernier objet cree clone copie nouveau",
		tooltip = "Le dernier objet créé ou cloné par un bloc (par exemple « cloner » ou « créer une partie »).",
		gen = constante("dernierObjet"),
	},
	{
		id = "val_delta",
		shape = "reporter",
		label = "temps depuis la dernière image",
		keywords = "delta temps image frame seconde battement",
		tooltip = "Le temps écoulé (en secondes) depuis l'image précédente, dans l'événement « À chaque image ».",
		gen = constante("deltaTemps"),
	},
	{
		id = "val_message_chat",
		shape = "reporter",
		label = "le message du chat",
		keywords = "chat message texte ecrit discussion",
		tooltip = "Le message écrit dans le chat, dans l'événement « Quand un joueur écrit dans le chat ».",
		gen = constante("messageChat"),
	},
	{
		id = "val_joueur_local",
		shape = "reporter",
		label = "le joueur local",
		scriptType = "local",
		keywords = "joueur local moi localplayer client",
		tooltip = "Le joueur qui utilise cet ordinateur (uniquement dans un script local).",
		gen = function(_a, g)
			return g.service("Players") .. ".LocalPlayer"
		end,
	},
	{
		id = "val_nombre",
		shape = "reporter",
		label = "nombre %1",
		inputs = { { name = "N", kind = "number", default = 10 } },
		keywords = "nombre chiffre valeur number",
		tooltip = "Un nombre. Si tu y places un texte, il est converti en nombre (0 si impossible).",
		gen = function(a, g)
			return g.num(a.N)
		end,
	},
	{
		id = "val_texte",
		shape = "reporter",
		label = "texte %1",
		inputs = { { name = "TEXTE", kind = "text", default = "Bonjour" } },
		keywords = "texte mot phrase chaine string",
		tooltip = "Un texte. Si tu y places une autre valeur, elle est convertie en texte.",
		gen = function(a, g)
			return g.str(a.TEXTE)
		end,
	},
	{
		id = "val_vecteur",
		shape = "reporter",
		label = "vecteur x %1 y %2 z %3",
		inputs = {
			{ name = "X", kind = "number", default = 0 },
			{ name = "Y", kind = "number", default = 10 },
			{ name = "Z", kind = "number", default = 0 },
		},
		keywords = "vecteur position coordonnees vector3 point",
		tooltip = "Une position ou une direction en 3D (x, y, z), en studs.",
		gen = function(a, g)
			return "Vector3.new(" .. g.num(a.X) .. ", " .. g.num(a.Y) .. ", " .. g.num(a.Z) .. ")"
		end,
	},
	{
		id = "val_position",
		shape = "reporter",
		label = "position de %1",
		inputs = { Shared.objInput("OBJ") },
		keywords = "position coordonnees ou emplacement vecteur",
		tooltip = "La position (x, y, z) d'un objet, d'un personnage ou d'un joueur. Donne 0, 0, 0 si l'objet est introuvable.",
		gen = function(a, g)
			return "(" .. g.helper("_pos") .. "(" .. a.OBJ .. ") or Vector3.zero)"
		end,
	},
	{
		id = "val_couleur",
		shape = "reporter",
		label = "couleur %1",
		inputs = { { name = "COULEUR", kind = "color", default = { 0, 170, 255 } } },
		keywords = "couleur color teinte rgb",
		tooltip = "Une couleur, à choisir dans la palette.",
		gen = function(a)
			return a.COULEUR
		end,
	},
	{
		id = "val_rien",
		shape = "reporter",
		label = "rien",
		keywords = "rien nil vide aucun nul",
		tooltip = "Aucune valeur (nil). Utile pour vider une variable ou tester si quelque chose existe.",
		gen = constante("nil"),
	},
}

return {
	category = "valeurs",
	blocks = blocks,
	helpers = {},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Defs_Variables</string><ProtectedString name="Source"><![CDATA[-- Defs_Variables : blocs « Variables » (variables du script dans la table V, et valeurs partagées).
-- Les valeurs partagées sont des attributs de Workspace (nom nettoyé par _nomPartage) : tous les
-- scripts les voient ; celles modifiées par un script serveur sont aussi vues par les joueurs.

local blocks = {
	{
		id = "var_valeur",
		shape = "reporter",
		label = "%1",
		inputs = { { name = "VAR", kind = "variable" } },
		hidden = true,
		keywords = "variable valeur",
		tooltip = "La valeur actuelle de cette variable.",
		gen = function(a, g)
			return a.VAR
		end,
	},
	{
		id = "var_definir",
		shape = "stack",
		label = "mettre %1 à %2",
		inputs = {
			{ name = "VAR", kind = "variable" },
			{ name = "VALEUR", kind = "any", default = "0" },
		},
		keywords = "mettre définir variable valeur changer donner égal affecter set",
		tooltip = "Donne une nouvelle valeur (nombre, texte, objet…) à la variable.",
		gen = function(a, g)
			return a.VAR .. " = " .. a.VALEUR
		end,
	},
	{
		id = "var_ajouter",
		shape = "stack",
		label = "ajouter %1 à %2",
		inputs = {
			{ name = "VALEUR", kind = "number", default = 1 },
			{ name = "VAR", kind = "variable" },
		},
		keywords = "ajouter augmenter additionner incrémenter plus variable compteur score change",
		tooltip = "Ajoute ce nombre à la variable (utilise un nombre négatif pour enlever).",
		gen = function(a, g)
			return a.VAR .. " = " .. g.num(a.VAR) .. " + " .. g.num(a.VALEUR)
		end,
	},
	{
		id = "var_multiplier",
		shape = "stack",
		label = "multiplier %1 par %2",
		inputs = {
			{ name = "VAR", kind = "variable" },
			{ name = "VALEUR", kind = "number", default = 2 },
		},
		keywords = "multiplier fois produit doubler variable",
		tooltip = "Multiplie la valeur de la variable par ce nombre.",
		gen = function(a, g)
			return a.VAR .. " = " .. g.num(a.VAR) .. " * " .. g.num(a.VALEUR)
		end,
	},
	{
		id = "var_partagee_definir",
		shape = "stack",
		label = "mettre la valeur partagée %1 à %2",
		inputs = {
			{ name = "NOM", kind = "text", default = "score" },
			{ name = "VALEUR", kind = "any", default = "0" },
		},
		keywords = "valeur partagée globale commune attribut workspace mettre définir tous les scripts",
		tooltip = "Range une valeur sous ce nom dans Workspace (attribut), lisible par tous les scripts. Modifiée par un script serveur, elle est aussi vue par les joueurs.",
		gen = function(a, g)
			return g.helper("_ecrirePartagee") .. "(" .. a.NOM .. ", " .. a.VALEUR .. ")"
		end,
	},
	{
		id = "var_partagee_ajouter",
		shape = "stack",
		label = "ajouter %1 à la valeur partagée %2",
		inputs = {
			{ name = "VALEUR", kind = "number", default = 1 },
			{ name = "NOM", kind = "text", default = "score" },
		},
		keywords = "ajouter augmenter valeur partagée globale commune attribut workspace",
		tooltip = "Ajoute ce nombre à la valeur partagée (0 si elle n'existe pas encore).",
		gen = function(a, g)
			return g.helper("_ajouterPartagee") .. "(" .. a.NOM .. ", " .. a.VALEUR .. ")"
		end,
	},
	{
		id = "var_partagee",
		shape = "reporter",
		label = "valeur partagée %1",
		inputs = { { name = "NOM", kind = "text", default = "score" } },
		keywords = "valeur partagée globale commune attribut workspace lire",
		tooltip = "La valeur partagée rangée sous ce nom dans Workspace (0 si elle n'existe pas encore).",
		gen = function(a, g)
			return g.helper("_lirePartagee") .. "(" .. a.NOM .. ")"
		end,
	},
}

local helpers = {
	-- Nom d'attribut valide : lettres (accents retirés), chiffres et _ ; 100 caractères au plus
	_nomPartage = {
		deps = { "_texte" },
		services = {},
		code = [[
local function _nomPartage(nom)
	local texte = _texte(nom)
	local accents = {
		["à"] = "a", ["á"] = "a", ["â"] = "a", ["ä"] = "a", ["ç"] = "c",
		["è"] = "e", ["é"] = "e", ["ê"] = "e", ["ë"] = "e",
		["ì"] = "i", ["í"] = "i", ["î"] = "i", ["ï"] = "i", ["ñ"] = "n",
		["ò"] = "o", ["ó"] = "o", ["ô"] = "o", ["ö"] = "o",
		["ù"] = "u", ["ú"] = "u", ["û"] = "u", ["ü"] = "u", ["ÿ"] = "y",
		["À"] = "A", ["Â"] = "A", ["Ä"] = "A", ["Ç"] = "C",
		["È"] = "E", ["É"] = "E", ["Ê"] = "E", ["Ë"] = "E",
		["Î"] = "I", ["Ï"] = "I", ["Ô"] = "O", ["Ö"] = "O",
		["Ù"] = "U", ["Û"] = "U", ["Ü"] = "U",
		["œ"] = "oe", ["Œ"] = "OE", ["æ"] = "ae", ["Æ"] = "AE",
	}
	texte = string.gsub(texte, "[\192-\223][\128-\191]", function(c)
		return accents[c]
	end)
	texte = string.gsub(texte, "[^%w_]", "_")
	if texte == "" then
		texte = "valeur"
	end
	if string.sub(texte, 1, 3) == "RBX" then
		texte = "_" .. texte
	end
	return string.sub(texte, 1, 100)
end]],
	},

	-- Valeur partagée (attribut de Workspace) ; 0 si elle n'existe pas
	_lirePartagee = {
		deps = { "_nomPartage" },
		services = {},
		code = [[
local function _lirePartagee(nom)
	local valeur = workspace:GetAttribute(_nomPartage(nom))
	if valeur == nil then
		return 0
	end
	return valeur
end]],
	},

	-- Modifie une valeur partagée ; les types non acceptés par les attributs sont convertis en texte
	_ecrirePartagee = {
		deps = { "_nomPartage", "_texte", "_avertir" },
		services = {},
		code = [[
local function _ecrirePartagee(nom, valeur)
	local cle = _nomPartage(nom)
	local acceptes = {
		string = true, number = true, boolean = true, Vector3 = true, Vector2 = true,
		Color3 = true, CFrame = true, BrickColor = true, UDim = true, UDim2 = true,
	}
	if valeur ~= nil and not acceptes[typeof(valeur)] then
		valeur = _texte(valeur)
	end
	local ok, erreur = pcall(function()
		workspace:SetAttribute(cle, valeur)
	end)
	if not ok then
		_avertir("Impossible de modifier la valeur partagée « " .. cle .. " » : " .. tostring(erreur))
	end
end]],
	},

	-- Ajoute un nombre à une valeur partagée
	_ajouterPartagee = {
		deps = { "_lirePartagee", "_ecrirePartagee", "_num" },
		services = {},
		code = [[
local function _ajouterPartagee(nom, valeur)
	_ecrirePartagee(nom, _num(_lirePartagee(nom)) + _num(valeur))
end]],
	},
}

return {
	category = "variables",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Detecteur</string><ProtectedString name="Source"><![CDATA[-- Detecteur : le détecteur d'erreurs de Blocs FR (SPEC §17).
-- Il relit le projet de blocs comme le ferait un professeur et explique, en français simple,
-- les erreurs de débutant : conditions vides, événements vides, blocs du mauvais type de script,
-- variables inconnues, messages jamais envoyés, « le joueur » vide, script mal placé, etc.
--
-- API :
--   Detecteur.analyze(model, ctx) -> problems, info
--       ctx = { mode = "server"|"local"|"module"|nil, target = Instance|nil, code = string|nil,
--               generated = résultat de CodeGen.generate|nil (NOTE: en plus de la SPEC ; prioritaire
--                           sur code : ses errors / warnings / lineMap sont aussi vérifiés),
--               generate = false (facultatif : ne pas générer le code si ctx.code est nil) }
--       problem = { severity = "erreur"|"avertissement"|"conseil", blockId = id|nil, title, message,
--                   source = "statique"|"code"|"test", line = n|nil, raw = string|nil,
--                   key = string (identifiant stable), order = n (position du bloc) }
--       info = { codeOk = bool|nil, codeErr = string|nil, codeLine = n|nil, code = string|nil,
--                lineMap = table|nil }   (NOTE: 2e valeur en plus de la SPEC, pour le pied du panneau)
--       Les problèmes sont triés : erreur, avertissement, conseil ; puis par position des blocs.
--   Detecteur.checkCode(code) -> ok, errFR, line   (loadstring, sinon ModuleScript sans parent +
--       LogService comme DevBridge ; peut céder la main ~0,2 s dans ce second cas)
--   Detecteur.explain(messageLuau) -> explicationFR, titreFR   (partagé avec ErrorWatcher)
--   Detecteur.sort(problems) ; Detecteur.count(problems) -> { erreur = n, avertissement = n, conseil = n }
--   Detecteur.blockAtLine(lineMap, line) -> entrée { line, last, block, def } la plus précise, ou nil
--   Detecteur.stripLocation(message) -> message sans le préfixe « Chemin.Du.Script:12: »
--
-- NOTE: analyze ne lève jamais d'erreur : en cas de bug interne, il renvoie un seul avertissement.
-- NOTE: si ctx.generated et ctx.code sont nil, analyze génère lui-même le code (CodeGen) pour le
-- vérifier. Avec ctx.code seul, les erreurs de génération ne sont pas signalées : passez plutôt
-- ctx.generated (ou rien).
--
-- Scripts modules (SPEC §20) : en mode "module", les blocs réservés aux scripts serveur / locaux ne
-- sont pas des erreurs (un module tourne du côté du script qui le charge) : un seul conseil par genre.
-- Les blocs « mod_* » réservés aux modules sont des erreurs dans les autres modes. Contrôles propres
-- aux modules : « renvoyer » hors d'une fonction, deux fonctions du même nom, « paramètre » inconnu ou
-- hors d'une fonction, événements d'un module, boucle sans fin qui bloque une fonction ou le
-- chargement, module introuvable (même recherche que l'aide _trouverModule), module rangé côté
-- serveur appelé par un script local, fonction / valeur absente d'un module Blocs FR (lue dans ses
-- données BlocsFR_Donnees ; pour le module ouvert lui-même, le projet en cours d'édition).
--
-- Version 2.1.0 (SPEC §21.9, §22.1, §23, §32) :
--   * ctx.guiNames = { screens = { "Menu", … }, elements = { [écran] = { [nom] = type } } } (écran en cours
--     d'édition, pas encore enregistré) : ajouté aux écrans de StarterGui (faits avec Blocs FR ou non).
--     Nom d'écran / d'élément introuvable -> avertissement (avec « Voulais-tu dire … ? ») ; élément du
--     mauvais type pour la case (un texte dans une case « bouton »…) -> avertissement ; bloc Interface
--     dans un script serveur hors d'un événement qui donne un joueur -> avertissement ; « afficher la
--     statistique … » dont la statistique n'est créée par aucun projet Blocs FR de la place -> conseil.
--   * « sauvegarder les statistiques des joueurs » dans deux projets (ou deux fois) -> avertissement ;
--     nom d'objet écrit dans une case (destination du téléporteur, de la plateforme, de la caméra, du
--     rayon ; modèle du générateur ; outil du bouton d'achat) introuvable dans la place -> avertissement.
--   * Blocs Caméra dans un script serveur : message propre à la caméra (erreur).
--   * Blocs désactivés (block.disabled, SPEC §32) : ignorés comme dans CodeGen (instruction sautée avec
--     ses corps, événement désactivé = toute sa pile, bloc valeur désactivé = la case garde sa valeur
--     écrite) ; un seul conseil « n blocs sont désactivés » montre le premier.
-- NOTE: les messages ajoutés tutoient (« vérifie », « tu peux ») comme le reste de l'interface.

local HttpService = game:GetService("HttpService")

local Registry = require(script.Parent.Registry)
local Util = require(script.Parent.Util)

local Detecteur = {}

Detecteur.SEVERITIES = { "erreur", "avertissement", "conseil" }

local SEVERITY_RANK = { erreur = 1, avertissement = 2, conseil = 3 }
local MAX_STEPS = 20000 -- garde-fou (piles circulaires dans des données abîmées)
local MAX_DEPTH = 120
local LOG_WAIT = 0.2 -- attente maximale des messages de LogService (vérification de secours)
local INDEX_TTL = 10 -- secondes de validité de l'index des noms d'objets du jeu
local INDEX_MAX = 30000 -- nombre maximal d'objets parcourus pour cet index

---------------------------------------------------------------------------
-- Tables de connaissances sur les blocs
---------------------------------------------------------------------------

-- Conditions dont la case vide est une vraie erreur (et pourquoi)
local STRICT_CONDITIONS = {
