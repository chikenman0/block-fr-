			},
		},
	}
end

local function modeleHud()
	local cases = {}
	for n = 1, 5 do
		local bord = NUIT
		if n == 1 then
			bord = JAUNE -- case choisie
		end
		table.insert(
			cases,
			E(
				"cadre",
				"Case " .. n,
				{ 0, 0, 96, 96 },
				cadre(NUIT, nil, { transparence = 0.18, arrondi = 20, contour = 3, contourCouleur = bord })
			)
		)
	end
	return {
		id = "hud",
		title = "HUD vie + pièces",
		description = "Vie, expérience, niveau, pièces, gemmes, quête et barre d'objets.",
		thumb = { { 36, 50, 79 }, { 18, 26, 46 } },
		ecran = { nom = "HUD", visible = true, ordre = 0 },
		elements = {
			E("cadre", "Avatar", { 32, 28, 108, 108 }, cadre({ 255, 224, 138 }, { 245, 185, 65 }, { arrondi = 54, contour = 3 })),
			E("texte", "Nom", { 164, 22, 300, 40 }, texte("Joueur", POLICE_TEXTE, 32, BLANC, 3, { alignement = "gauche" })),
			E("barre", "Vie", { 164, 72, 400, 36 }, barre(1, VERT, { texte = "100 / 100" })),
			E("barre", "XP", { 164, 124, 300, 20 }, barre(0.4, { 139, 92, 246 }, { arrondi = 10 })),
			E("texte", "Niveau", { 480, 114, 120, 40 }, texte("Niv. 5", POLICE_TEXTE, 26, { 196, 181, 253 }, 2, { alignement = "gauche" })),
			E("cadre", "Compteur", { 1068, 28, 180, 60 }, pastille(), {
				E("cadre", "IcônePièce", { 10, 8, 44, 44 }, piece()),
				E("texte", "Pièces", { 64, 6, 104, 48 }, texte("1 250", POLICE_TEXTE, 30, BLANC, 0, { alignement = "gauche" })),
			}),
			E("cadre", "CompteurGemmes", { 1068, 108, 180, 60 }, pastille(), {
				E(
					"cadre",
					"IcôneGemme",
					{ 16, 14, 32, 32 },
					cadre({ 156, 246, 255 }, { 10, 143, 176 }, {
						rotation = 45,
						arrondi = 6,
						contour = 3,
						contourCouleur = { 7, 94, 116 },
					})
				),
				E("texte", "Gemmes", { 64, 6, 104, 48 }, texte("36", POLICE_TEXTE, 30, BLANC, 0, { alignement = "gauche" })),
			}),
			E("cadre", "Quête", { 32, 552, 420, 136 }, panneau(PANNEAU_HAUT, PANNEAU_BAS, { arrondi = 28 }), {
				E("texte", "QuêteTitre", { 28, 16, 364, 34 }, texte("Quête", POLICE_TEXTE, 26, JAUNE, 0, { alignement = "gauche" })),
				E(
					"texte",
					"QuêteTexte",
					{ 28, 52, 364, 34 },
					texte("Ramasse 10 pièces", POLICE_TEXTE, 26, BLANC, 0, { alignement = "gauche" })
				),
				E("barre", "QuêteBarre", { 28, 96, 364, 14 }, barre(0.6, { 255, 201, 60 }, { arrondi = 7, contour = 0 })),
			}),
			E(
				"liste",
				"Objets",
				{ 476, 584, 584, 112 },
				cadre(NUIT, nil, { transparence = 1, direction = "horizontale", espacement = 20 }),
				cases
			),
		},
		piles = {
			{
				{ "evt_demarrage" },
				{ "gui_lier_vie", BARRE = "Vie" },
				{ "gui_lier_stat", STAT = "Pièces", ELEMENT = "Pièces" },
			},
		},
	}
end

local function modeleBoutique()
	-- Une carte d'objet : pastille ronde (Image n), nom, bouton prix
	local function carte(n, gauche, haut, bas, nom, prix, prixHaut, prixBas, bord)
		return E("cadre", "Carte " .. n, { gauche, 232, 296, 320 }, cadre({ 22, 32, 58 }, nil, {
			arrondi = 24,
			contour = 3,
			contourCouleur = bord or NUIT,
		}), {
			E("cadre", "Image " .. n, { 98, 28, 100, 100 }, cadre(haut, bas, { arrondi = 50, contour = 3 })),
			E("texte", "Nom " .. n, { 8, 144, 280, 40 }, texte(nom, POLICE_TEXTE, 28, BLANC, 0)),
			E("bouton", "Prix " .. n, { 40, 220, 216, 74 }, petitBouton(prix, prixHaut, prixBas, 32)),
		})
	end
	local onglet = { texteCouleur = CLAIR, texteContour = 0 }
	return {
		id = "boutique",
		title = "Boutique",
		description = "Onglets, cartes d'objets avec leur prix, solde et bouton fermer.",
		thumb = { { 43, 58, 103 }, { 30, 42, 74 } },
		ecran = { nom = "Boutique", visible = false, ordre = 10 },
		elements = {
			E("cadre", "Voile", { 0, 0, 1280, 720 }, voile(VOILE, nil, 0.45)),
			E("cadre", "Fenêtre", { 120, 52, 1040, 608 }, panneau(PANNEAU_HAUT, PANNEAU_BAS), {
				E("cadre", "Bandeau", { 0, 0, 1040, 108 }, cadre(JAUNE, { 255, 159, 28 }, { arrondi = 36, relief = 6, reliefCouleur = NUIT })),
				E("texte", "Titre", { 0, 13, 1040, 76 }, texte("BOUTIQUE", POLICE_TITRE, 64, BLANC, 3)),
				E(
					"bouton",
					"Fermer",
					{ 1000, -28, 68, 74 },
					bouton("×", { 255, 122, 133 }, ROUGE_BAS, 40, { arrondi = 34, contour = 3, relief = 6 })
				),
				E("bouton", "Onglet Épées", { 48, 140, 208, 66 }, petitBouton("ÉPÉES", JAUNE_HAUT, JAUNE_BAS, 28)),
				E("bouton", "Onglet Familiers", { 280, 140, 208, 66 }, petitBouton("FAMILIERS", PANNEAU_HAUT, nil, 28, onglet)),
				E("bouton", "Onglet Bonus", { 512, 140, 208, 66 }, petitBouton("BONUS", PANNEAU_HAUT, nil, 28, onglet)),
				carte(1, 48, { 255, 177, 153 }, { 255, 90, 54 }, "Épée de feu", "250", VERT_HAUT, VERT_BAS),
				carte(2, 372, { 167, 243, 255 }, { 34, 195, 230 }, "Épée de glace", "400", VERT_HAUT, VERT_BAS),
				carte(3, 696, { 233, 213, 255 }, { 139, 92, 246 }, "Épée magique", "ÉQUIPÉE", GRIS_HAUT, GRIS_BAS, JAUNE),
				E("cadre", "Solde", { 48, 572, 200, 52 }, pastille({ arrondi = 26 }), {
					E("texte", "SoldePièces", { 12, 4, 176, 44 }, texte("1 250", POLICE_TEXTE, 26, BLANC, 0)),
				}),
			}),
		},
		piles = {
			{
				{ "gui_quand_clic", BOUTON = "Fermer" },
				{ "gui_cacher_ecran", ECRAN = "Boutique", EFFET = '"zoom"' },
			},
		},
	}
end

