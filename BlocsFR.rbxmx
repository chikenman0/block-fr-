						Speed = plage(0.5, 1.5),
						SpreadAngle = Vector2.new(180, 180),
						Acceleration = Vector3.new(0, -2.5, 0),
						Drag = 1,
						Rate = 25,
						RotSpeed = plage(-60, 60),
					}),
					fumee(rgb(200, 235, 255), 0.12, -2, 0.4),
				},
			}
		end,
		tenebres = function()
			return {
				lumiere = rgb(120, 40, 200),
				eclat = 1.2,
				objets = {
					fumee(rgb(35, 10, 55), 0.35, 3, 0.5),
					emetteur({
						Color = degrade(rgb(110, 30, 170), rgb(20, 0, 40)),
						LightEmission = 0,
						Size = seq(0, 0.45, 1, 0.1),
						Transparency = seq(0, 0.2, 1, 1),
						Lifetime = plage(0.8, 1.4),
						Speed = plage(1, 2.5),
						SpreadAngle = Vector2.new(180, 180),
						Acceleration = Vector3.new(0, 2.5, 0),
						Drag = 1,
						Rate = 22,
						RotSpeed = plage(-90, 90),
					}),
				},
			}
		end,
		electrique = function()
			return {
				lumiere = rgb(120, 200, 255),
				eclat = 2,
				scintille = true,
				objets = {
					zaps(35, 18),
					emetteur({
						Color = degrade(rgb(255, 255, 255), rgb(120, 200, 255)),
						LightEmission = 1,
						Size = seq(0, 0.15, 1, 0),
						Transparency = seq(0, 0, 1, 1),
						Lifetime = plage(0.2, 0.4),
						Speed = plage(2, 5),
						SpreadAngle = Vector2.new(180, 180),
						Rate = 20,
					}),
				},
			}
		end,
		soin = function()
			return {
				lumiere = rgb(110, 255, 150),
				eclat = 1.8,
				objets = {
					emetteur({
						Color = degrade(rgb(200, 255, 200), rgb(60, 220, 100)),
						LightEmission = 1,
						Size = seq(0, 0.1, 0.3, 0.4, 1, 0),
						Transparency = seq(0, 0.3, 0.3, 0, 1, 1),
						Lifetime = plage(1.2, 1.8),
						Speed = plage(2, 4),
						SpreadAngle = Vector2.new(30, 30),
						Acceleration = Vector3.new(0, 2, 0),
						Drag = 0.5,
						Rate = 20,
						RotSpeed = plage(-60, 60),
					}),
					emetteur({
						Color = ColorSequence.new(rgb(160, 255, 180)),
						LightEmission = 0.6,
						Size = seq(0, 0.6, 1, 1.2),
						Transparency = seq(0, 1, 0.3, 0.8, 1, 1),
						Lifetime = plage(1, 1.5),
						Speed = plage(1, 2),
						SpreadAngle = Vector2.new(180, 180),
						Rate = 5,
					}),
				},
			}
		end,
	}
	local liste = particules
	local defaut = "etincelles"
	local quoi = "particules"
	if aura then
		liste = auras
		defaut = "magique"
		quoi = "aura"
	end
	local cle = string.lower(tostring(nom or ""))
	for accent, simple in pairs({ ["é"] = "e", ["è"] = "e", ["ê"] = "e", ["É"] = "e", ["È"] = "e", ["à"] = "a", ["â"] = "a", ["î"] = "i", ["ï"] = "i", ["ô"] = "o", ["û"] = "u", ["ù"] = "u", ["ç"] = "c", ["œ"] = "oe", ["Œ"] = "oe" }) do
		cle = string.gsub(cle, accent, simple)
	end
	cle = string.gsub(cle, "[^%a]", "")
	if liste[cle] == nil then
		local sansS = string.gsub(cle, "s$", "")
		if liste[sansS] ~= nil then
			cle = sansS
		elseif liste[cle .. "s"] ~= nil then
			cle = cle .. "s"
		else
			_vfxAvertir("« " .. quoi .. " » : effet « " .. tostring(nom) .. " » inconnu, j'utilise « " .. defaut .. " ».")
			cle = defaut
		end
	end
	local preset = liste[cle]()
	preset.cle = cle
	return preset
end]],
	},

	-- Pose les objets d'un réglage (_vfxPreset) dans « parent ». rafale = true : émetteurs éteints
	-- (l'explosion appelle :Emit), réglages d'explosion appliqués, feu / fumée allumés. Sinon tout
	-- s'allume et le débit des particules est multiplié par « facteur » (grandes parties).
	-- Renvoie la liste des objets créés.
	_vfxPoser = {
		deps = { "_vfxCreer" },
		services = {},
		code = [[
local function _vfxPoser(parent, preset, nom, rafale, facteur)
	local crees = {}
	for i, description in ipairs(preset.objets) do
		local classe, proprietes = description[1], description[2]
		if rafale then
			if classe == "ParticleEmitter" then
				proprietes.SpreadAngle = Vector2.new(180, 180)
			end
			if type(description[3]) == "table" then
				for cle, valeur in pairs(description[3]) do
					proprietes[cle] = valeur
				end
			end
			proprietes.Enabled = classe ~= "ParticleEmitter"
		else
			proprietes.Enabled = true
			if classe == "ParticleEmitter" and type(proprietes.Rate) == "number" then
				proprietes.Rate = proprietes.Rate * (tonumber(facteur) or 1)
			end
		end
		local objet = _vfxCreer(classe, nom .. i, proprietes, parent)
		if objet ~= nil then
			table.insert(crees, objet)
		end
	end
	return crees
end]],
	},

	-- « particules … sur … pendant … s » (0 s = sans arrêt : remplace les particules sans arrêt
	-- du même type sur cet objet). Si les mêmes particules jaillissent déjà de cet objet (un bloc
	-- sous « Quand cet objet est touché » est lancé à chaque contact), rien n'est ajouté. À la fin,
	-- le débit tombe à 0 (TweenService : marche même si le script a été détruit entre-temps), feu,
	-- fumée et lumière s'éteignent, et Debris détruit tout quand les dernières particules ont fini.
	_vfxParticules = {
		deps = { "_vfxPartie", "_vfxTaille", "_vfxPreset", "_vfxPoser", "_vfxCreer", "_vfxRetirer", "_nombreOu" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxParticules(nom, cible, duree)
	local partie, objet = _vfxPartie(cible, "particules")
	if partie == nil then
		return
	end
	local taille = _vfxTaille(partie, objet)
	local preset = _vfxPreset(nom, taille, false)
	local d = math.max(_nombreOu(duree, 2), 0)
	local base = "BlocsFR_Particules_" .. preset.cle .. "_"
	if d == 0 then
		_vfxRetirer(partie, base)
	else
		for _, enfant in ipairs(partie:GetChildren()) do
			if enfant:GetAttribute("BlocsFR_VFX") == true and string.sub(enfant.Name, 1, #base) == base then
				if (enfant:IsA("ParticleEmitter") and enfant.Enabled and enfant.Rate > 0) or ((enfant:IsA("Fire") or enfant:IsA("Smoke")) and enfant.Enabled) then
					return
				end
			end
		end
	end
	local crees = _vfxPoser(partie, preset, base, false, math.clamp(taille / 4, 1, 4))
	if preset.eclairage then
		local lumiere = _vfxCreer("PointLight", base .. "Lumiere", {
			Color = preset.lumiere,
			Brightness = 1.5,
			Range = math.clamp(taille * 2.5, 8, 40),
			Shadows = false,
		}, partie)
		if lumiere ~= nil then
			table.insert(crees, lumiere)
		end
	end
	if d > 0 then
		local arret = TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, d)
		for _, cree in ipairs(crees) do
			if cree:IsA("ParticleEmitter") then
				TweenService:Create(cree, arret, { Rate = 0 }):Play()
			end
			Debris:AddItem(cree, d + preset.duree + 0.5)
		end
		task.delay(d, function()
			for _, cree in ipairs(crees) do
				if cree.Parent ~= nil then
					pcall(function()
						cree.Enabled = false
					end)
				end
			end
		end)
	end
end]],
	},

	-- « explosion de … sur … » : une rafale de 40 particules (+ feu / fumée 0,45 s) et un flash de
	-- lumière, depuis une partie invisible posée dans le Workspace à la place de la cible. Tout part
	-- tout de suite (:Emit, TweenService, Debris) : l'explosion a lieu même si le script et son objet
	-- sont détruits juste après (pièce ramassée), car les task.delay d'un script détruit ne tournent plus.
	_vfxExplosion = {
		deps = { "_vfxPartie", "_vfxTaille", "_vfxPreset", "_vfxPoser", "_vfxCreer" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxExplosion(nom, cible)
	local partie, objet = _vfxPartie(cible, "explosion")
	if partie == nil then
		return
	end
	local taille = _vfxTaille(partie, objet)
	local preset = _vfxPreset(nom, taille, false)
	local cote = math.clamp(taille * 0.4, 0.5, 6)
	local support = _vfxCreer("Part", "BlocsFR_Explosion", {
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Transparency = 1,
		Size = Vector3.new(cote, cote, cote),
		CFrame = CFrame.new(partie.Position),
	}, workspace)
	if support == nil then
		return
	end
	local crees = _vfxPoser(support, preset, "Rafale", true, 1)
	local flash = _vfxCreer("PointLight", "Flash", {
		Color = preset.lumiere,
		Brightness = 5,
		Range = math.clamp(taille * 3, 10, 40),
		Shadows = false,
	}, support)
	if flash ~= nil then
		TweenService:Create(flash, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
	end
	local emetteurs = {}
	for _, cree in ipairs(crees) do
		if cree:IsA("ParticleEmitter") then
			table.insert(emetteurs, cree)
		end
	end
	local parEmetteur = math.max(math.floor(40 / math.max(#emetteurs, 1) + 0.5), 1)
	for _, emetteurCree in ipairs(emetteurs) do
		pcall(function()
			emetteurCree:Emit(parEmetteur)
		end)
	end
	-- feu / fumée : une bouffée de 0,45 s, éteinte en douceur (détruite au plus tard par Debris)
	for _, cree in ipairs(crees) do
		if not cree:IsA("ParticleEmitter") then
			Debris:AddItem(cree, 0.45 + preset.duree)
		end
	end
	task.delay(0.45, function()
		for _, cree in ipairs(crees) do
			if cree.Parent ~= nil and not cree:IsA("ParticleEmitter") then
				pcall(function()
					cree.Enabled = false
				end)
			end
		end
	end)
	Debris:AddItem(support, preset.duree + 3)
end]],
	},

	-- « traînée lumineuse sur … » : Trail entre deux points d'attache. Personnage : du coude au bout
	-- de la main droite (R15) ou le long du bras droit (R6) ; partie : d'un bout à l'autre de son
	-- côté le plus long. Une seule traînée par objet.
	_vfxTrainee = {
		deps = { "_vfxPartie", "_vfxCreer", "_vfxRetirer", "_versColor3" },
		services = {},
		code = [[
local function _vfxTrainee(cible, couleur)
	local partie, objet = _vfxPartie(cible, "traînée lumineuse")
	if partie == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.fromRGB(34, 211, 238)
	local p0, p1, pos0, pos1 = nil, nil, nil, nil
	if objet:IsA("Model") and objet:FindFirstChildOfClass("Humanoid") ~= nil then
		local main = objet:FindFirstChild("RightHand")
		local avantBras = objet:FindFirstChild("RightLowerArm")
		local bras = objet:FindFirstChild("Right Arm")
		if main ~= nil and main:IsA("BasePart") and avantBras ~= nil and avantBras:IsA("BasePart") then
			p0, pos0 = avantBras, Vector3.new(0, avantBras.Size.Y / 2, 0)
			p1, pos1 = main, Vector3.new(0, -main.Size.Y / 2, 0)
		elseif bras ~= nil and bras:IsA("BasePart") then
			p0, pos0 = bras, Vector3.new(0, bras.Size.Y / 2 - 0.2, 0)
			p1, pos1 = bras, Vector3.new(0, -bras.Size.Y / 2, 0)
		end
	end
	if p0 == nil then
		local s = partie.Size
		local bout = Vector3.new(0, s.Y / 2, 0)
		if s.X >= s.Y and s.X >= s.Z then
			bout = Vector3.new(s.X / 2, 0, 0)
		elseif s.Z >= s.Y then
			bout = Vector3.new(0, 0, s.Z / 2)
		end
		p0, pos0, p1, pos1 = partie, bout, partie, -bout
	end
	_vfxRetirer(objet, "BlocsFR_Trainee")
	local a0 = _vfxCreer("Attachment", "BlocsFR_TraineeA", { Position = pos0 }, p0)
	local a1 = _vfxCreer("Attachment", "BlocsFR_TraineeB", { Position = pos1 }, p1)
	if a0 == nil or a1 == nil then
		_vfxRetirer(objet, "BlocsFR_Trainee")
		return
	end
	_vfxCreer("Trail", "BlocsFR_Trainee", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(c, 0.6), c),
		LightEmission = 1,
		LightInfluence = 0,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.3) }),
		Lifetime = 0.3,
		MinLength = 0.05,
		FaceCamera = false,
	}, a0)
end]],
	},

	-- « rayon de … vers … » : deux Beam (cœur blanc + halo coloré) entre deux points d'attache, et
	-- des étincelles au point d'arrivée. « vers » : nom d'objet, objet, joueur ou position.
	-- 0 s = sans arrêt (remplace le rayon sans arrêt précédent de cet objet).
	_vfxRayon = {
		deps = { "_vfxPartie", "_vfxCreer", "_vfxRetirer", "_vfxAvertir", "_versColor3", "_objetNomme", "_nombreOu" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxRayon(de, vers, couleur, duree)
	local depart = _vfxPartie(de, "rayon")
	if depart == nil then
		return
	end
	local parentB, positionB = nil, Vector3.zero
	local t = typeof(vers)
	if t == "Vector3" or t == "CFrame" then
		parentB = workspace:FindFirstChildOfClass("Terrain")
		if t == "CFrame" then
			positionB = vers.Position
		else
			positionB = vers
		end
	else
		local objetVers = vers
		if t == "string" or t == "number" then
			objetVers = _objetNomme(vers)
			if objetVers == nil then
				_vfxAvertir("« rayon » : l'objet « " .. tostring(vers) .. " » est introuvable (vérifie son nom dans l'Explorateur).")
				return
			end
		end
		parentB = _vfxPartie(objetVers, "rayon")
		if parentB ~= nil and not parentB:IsDescendantOf(workspace) then
			_vfxAvertir("« rayon » : « " .. parentB.Name .. " » n'est pas dans le Workspace : le rayon ne se verrait pas.")
			return
		end
	end
	if parentB == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.fromRGB(250, 204, 21)
	local d = math.max(_nombreOu(duree, 1), 0)
	local nom = "BlocsFR_Rayon"
	if d == 0 then
		nom = "BlocsFR_RayonFixe"
		_vfxRetirer(depart, nom)
	end
	local a0 = _vfxCreer("Attachment", nom .. "A", nil, depart)
	local a1 = _vfxCreer("Attachment", nom .. "B", { Position = positionB }, parentB)
	if a0 == nil or a1 == nil then
		if a0 ~= nil then
			a0:Destroy()
		end
		if a1 ~= nil then
			a1:Destroy()
		end
		return
	end
	-- les deux bouts vivent ensemble : si l'un des objets est détruit, l'autre point d'attache
	-- (et les étincelles d'arrivée) disparaît aussi
	local function lier(premier, second)
		pcall(function()
			premier.Destroying:Connect(function()
				if second.Parent ~= nil then
					second:Destroy()
				end
			end)
		end)
	end
	lier(a0, a1)
	lier(a1, a0)
	_vfxCreer("ParticleEmitter", nom .. "Impact", {
		Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(c, 0.4), c),
		LightEmission = 1,
		LightInfluence = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.15, 0.35),
		Speed = NumberRange.new(4, 10),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Rate = 30,
	}, a1)
	local halo = _vfxCreer("Beam", nom, {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(c),
		LightEmission = 1,
		LightInfluence = 0,
		FaceCamera = true,
		Segments = 1,
		Transparency = NumberSequence.new(0.25),
		Width0 = 0.8,
		Width1 = 0.8,
	}, a0)
	local coeur = _vfxCreer("Beam", nom .. "Coeur", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		LightEmission = 1,
		LightInfluence = 0,
		FaceCamera = true,
		Segments = 1,
		Transparency = NumberSequence.new(0),
		Width0 = 0.25,
		Width1 = 0.25,
	}, a0)
	if d > 0 then
		-- à la fin, le rayon s'amincit (tween retardé de d secondes) puis Debris détruit tout :
		-- rien ne dépend du script, qui peut être détruit entre-temps
		local fin = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, d)
		if halo ~= nil then
			TweenService:Create(halo, fin, { Width0 = 0, Width1 = 0 }):Play()
		end
		if coeur ~= nil then
			TweenService:Create(coeur, fin, { Width0 = 0, Width1 = 0 }):Play()
		end
		Debris:AddItem(a0, d + 0.2)
		Debris:AddItem(a1, d + 0.2)
	end
end]],
	},

	-- « onde de choc sur … » : un anneau de morceaux de néon (posés dans le Workspace) qui
	-- s'agrandit jusqu'à « taille » studs de large en s'effaçant (0,5 s). Sur un modèle, l'anneau
	-- part du bas de sa boîte englobante (les pieds d'un personnage).
	_vfxOnde = {
		deps = { "_vfxPartie", "_vfxCreer", "_versColor3", "_nombreOu" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxOnde(cible, taille, couleur)
	local partie, objet = _vfxPartie(cible, "onde de choc")
	if partie == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.new(1, 1, 1)
	local rayon = math.clamp(_nombreOu(taille, 16), 1, 500) / 2
	local centre = partie.Position
	if objet:IsA("Model") then
		local ok, cf, dimensions = pcall(function()
			return objet:GetBoundingBox()
		end)
		if ok and typeof(cf) == "CFrame" and typeof(dimensions) == "Vector3" then
			centre = Vector3.new(cf.Position.X, cf.Position.Y - dimensions.Y / 2 + 0.3, cf.Position.Z)
		end
	end
	local n = math.clamp(math.floor(rayon * 3), 12, 36)
	local epaisseur = math.clamp(rayon * 0.12, 0.4, 4)
	local depart = 0.5
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for i = 1, n do
		local orientation = CFrame.new(centre) * CFrame.Angles(0, -(i - 1) / n * math.pi * 2, 0)
		local morceau = _vfxCreer("Part", "BlocsFR_Onde", {
			Anchored = true,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
			CastShadow = false,
			Material = Enum.Material.Neon,
			Color = c,
			Transparency = 0.1,
			Size = Vector3.new(epaisseur * 0.6, 0.35, 2 * math.pi * depart / n * 1.2 + 0.05),
			CFrame = orientation * CFrame.new(depart, 0, 0),
		}, workspace)
		if morceau ~= nil then
			TweenService:Create(morceau, info, {
				Size = Vector3.new(epaisseur, 0.12, 2 * math.pi * rayon / n * 1.12),
				CFrame = orientation * CFrame.new(rayon, 0, 0),
				Transparency = 1,
			}):Play()
			Debris:AddItem(morceau, 0.6)
		end
	end
end]],
	},

	-- « éclair d'impact sur … » : boule de néon qui grossit et s'efface (0,25 s), flash de lumière et
	-- 14 étincelles. Posée dans le Workspace, au centre de la cible.
	_vfxEclair = {
		deps = { "_vfxPartie", "_vfxTaille", "_vfxCreer", "_versColor3" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxEclair(cible, couleur)
	local partie, objet = _vfxPartie(cible, "éclair d'impact")
	if partie == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.fromRGB(251, 146, 60)
	local taille = math.clamp(_vfxTaille(partie, objet) * 0.8, 2, 12)
	local boule = _vfxCreer("Part", "BlocsFR_Eclair", {
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = c,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Transparency = 0.05,
		Size = Vector3.new(0.6, 0.6, 0.6),
		CFrame = CFrame.new(partie.Position),
	}, workspace)
	if boule == nil then
		return
	end
	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(boule, info, { Size = Vector3.new(taille, taille, taille), Transparency = 1 }):Play()
	local flash = _vfxCreer("PointLight", "Flash", {
		Color = c,
		Brightness = 6,
		Range = math.clamp(taille * 3, 10, 40),
		Shadows = false,
	}, boule)
	if flash ~= nil then
		TweenService:Create(flash, info, { Brightness = 0 }):Play()
	end
	local etincelles = _vfxCreer("ParticleEmitter", "Etincelles", {
		Enabled = false,
		Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(c, 0.35), c),
		LightEmission = 1,
		LightInfluence = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.2, 0.45),
		Speed = NumberRange.new(12, 24),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 5,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Squash = NumberSequence.new(1.2),
		Rate = 0,
	}, boule)
	if etincelles ~= nil then
		pcall(function()
			etincelles:Emit(14)
		end)
	end
	Debris:AddItem(boule, 0.9)
end]],
	},

	-- « contour lumineux sur … » : Highlight de la couleur choisie (caché derrière les murs), qui
	-- s'efface en 0,25 s à la fin. 0 s = sans arrêt. Un seul contour par objet.
	_vfxContour = {
		deps = { "_vfxPartie", "_vfxCreer", "_vfxRetirer", "_versColor3", "_nombreOu" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxContour(cible, couleur, duree)
	local partie, objet = _vfxPartie(cible, "contour lumineux")
	if partie == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.fromRGB(239, 68, 68)
	local hote = objet
	if not (hote:IsA("Model") or hote:IsA("BasePart")) then
		hote = partie
	end
	_vfxRetirer(hote, "BlocsFR_Contour")
	local eclat = _vfxCreer("Highlight", "BlocsFR_Contour", {
		Adornee = hote,
		FillColor = c,
		FillTransparency = 0.75,
		OutlineColor = c,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.Occluded,
	}, hote)
	if eclat == nil then
		return
	end
	local d = math.max(_nombreOu(duree, 1), 0)
	if d > 0 then
		-- fondu de sortie retardé de d secondes (TweenService) puis Debris : marche même si le script
		-- est détruit entre-temps
		local fin = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, d)
		TweenService:Create(eclat, fin, { FillTransparency = 1, OutlineTransparency = 1 }):Play()
		Debris:AddItem(eclat, d + 0.3)
	end
end]],
	},

	-- « chiffres de dégâts … au-dessus de … » : BillboardGui (au-dessus de la tête d'un personnage)
	-- en LuckiestGuy avec contour, qui apparaît en grossissant, monte et s'efface (0,9 s).
	-- Rouge si le texte commence par « - », vert par « + », doré sinon.
	_vfxDegats = {
		deps = { "_vfxPartie", "_vfxCreer", "_texte" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxDegats(texte, cible)
	local partie, objet = _vfxPartie(cible, "chiffres de dégâts")
	if partie == nil then
		return
	end
	local message = string.match(_texte(texte), "^%s*(.-)%s*$") or ""
	if message == "" then
		return
	end
	local support = partie
	if objet:IsA("Model") then
		local tete = objet:FindFirstChild("Head")
		if tete ~= nil and tete:IsA("BasePart") then
			support = tete
		end
	end
	local teinte = Color3.fromRGB(255, 214, 64)
	local premier = string.sub(message, 1, 1)
	if premier == "-" then
		teinte = Color3.fromRGB(255, 72, 72)
	elseif premier == "+" then
		teinte = Color3.fromRGB(90, 255, 120)
	end
	local x = (math.random() * 2 - 1) * 1.5
	local hauteur = support.Size.Y / 2 + 1
	local panneau = _vfxCreer("BillboardGui", "BlocsFR_Degats", {
		Adornee = support,
		Size = UDim2.fromOffset(150, 48),
		StudsOffset = Vector3.new(x, hauteur, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 150,
		ResetOnSpawn = false,
	}, nil)
	if panneau == nil then
		return
	end
	local etiquette = _vfxCreer("TextLabel", "Texte", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = message,
		Font = Enum.Font.LuckiestGuy,
		TextScaled = true,
		TextColor3 = teinte,
		TextStrokeTransparency = 1,
	}, panneau)
	local contour, echelle = nil, nil
	if etiquette ~= nil then
		contour = _vfxCreer("UIStroke", "Contour", { Thickness = 2.5, Color = Color3.fromRGB(25, 10, 10) }, etiquette)
		echelle = _vfxCreer("UIScale", "Echelle", { Scale = 0.3 }, etiquette)
	end
	local place = pcall(function()
		panneau.Parent = support
	end)
	if not place then
		panneau:Destroy()
		return
	end
	if echelle ~= nil then
		TweenService:Create(echelle, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	TweenService:Create(panneau, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(x, hauteur + 2.5, 0) }):Play()
	-- s'efface pendant la 2e moitié (tween retardé de 0,45 s : ne dépend pas du script)
	local fondu = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.45)
	if etiquette ~= nil then
		TweenService:Create(etiquette, fondu, { TextTransparency = 1 }):Play()
	end
	if contour ~= nil then
		TweenService:Create(contour, fondu, { Transparency = 1 }):Play()
	end
	Debris:AddItem(panneau, 1)
end]],
	},

	-- « aura … autour de … » : émetteurs + PointLight sur la partie racine, jusqu'à « arrêter les
	-- effets ». Une nouvelle aura remplace l'ancienne. L'aura électrique scintille (la boucle
	-- s'arrête dès que sa lumière disparaît).
	_vfxAura = {
		deps = { "_vfxPartie", "_vfxTaille", "_vfxPreset", "_vfxPoser", "_vfxCreer", "_vfxRetirer" },
		services = {},
		code = [[
local function _vfxAura(nom, cible)
	local partie, objet = _vfxPartie(cible, "aura")
	if partie == nil then
		return
	end
	_vfxRetirer(partie, "BlocsFR_Aura")
	local taille = _vfxTaille(partie, objet)
	local preset = _vfxPreset(nom, taille, true)
	_vfxPoser(partie, preset, "BlocsFR_Aura", false, 1)
	local lumiere = _vfxCreer("PointLight", "BlocsFR_AuraLumiere", {
		Color = preset.lumiere,
		Brightness = preset.eclat or 2,
		Range = math.clamp(taille * 2, 8, 24),
		Shadows = false,
	}, partie)
	if lumiere ~= nil and preset.scintille then
		task.spawn(function()
			while lumiere.Parent ~= nil do
				lumiere.Brightness = 0.6 + math.random() * 3
				task.wait(0.05 + math.random() * 0.1)
			end
		end)
	end
end]],
	},

	-- « images fantômes de … pendant … s » : toutes les 0,05 s, une copie en néon de chaque partie
	-- visible (60 au plus, sans les enfants sauf les maillages), ancrée et sans collision, qui
	-- s'efface en 0,3 s. Ne fait pas attendre le script ; un marqueur « BlocsFR_Fantomes » dans
	-- l'objet permet à « arrêter les effets » de stopper la boucle.
	_vfxFantomes = {
		deps = { "_vfxPartie", "_vfxCreer", "_vfxAvertir", "_nombreOu" },
		services = { "Debris", "TweenService" },
		code = [[
local function _vfxFantomes(cible, duree)
	local partie, objet = _vfxPartie(cible, "images fantômes")
	if partie == nil then
		return
	end
	local d = math.clamp(_nombreOu(duree, 0.5), 0.05, 10)
	local liste = objet:GetDescendants()
	table.insert(liste, 1, objet)
	local parties = {}
	for _, p in ipairs(liste) do
		if p:IsA("BasePart") and p.Transparency < 0.95 and p.Name ~= "HumanoidRootPart" and p:GetAttribute("BlocsFR_VFX") ~= true then
			table.insert(parties, p)
			if #parties >= 60 then
				break
			end
		end
	end
	if #parties == 0 then
		_vfxAvertir("« images fantômes » : « " .. objet.Name .. " » n'a aucune partie visible.")
		return
	end
	local marqueur = _vfxCreer("Configuration", "BlocsFR_Fantomes", nil, objet)
	if marqueur == nil then
		return
	end
	Debris:AddItem(marqueur, d + 0.2)
	local teinte = Color3.fromRGB(160, 220, 255)
	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	task.spawn(function()
		local fin = os.clock() + d
		while os.clock() < fin and marqueur.Parent ~= nil do
			for _, p in ipairs(parties) do
				if p.Parent ~= nil then
					local ok, copie = pcall(function()
						local archivable = p.Archivable
						p.Archivable = true
						local clone = p:Clone()
						p.Archivable = archivable
						return clone
					end)
					if ok and copie ~= nil then
						for _, enfant in ipairs(copie:GetChildren()) do
							if enfant:IsA("DataModelMesh") then
								pcall(function()
									enfant.TextureId = ""
								end)
							else
								enfant:Destroy()
							end
						end
						pcall(function()
							copie.TextureID = ""
						end)
						copie.Name = "BlocsFR_Fantome"
						copie:SetAttribute("BlocsFR_VFX", true)
						copie.Anchored = true
						copie.CanCollide = false
						copie.CanTouch = false
						copie.CanQuery = false
						copie.CastShadow = false
						copie.Massless = true
						copie.Material = Enum.Material.Neon
						copie.Color = teinte
						copie.Transparency = 0.5
						copie.Parent = workspace
						TweenService:Create(copie, info, { Transparency = 1 }):Play()
						Debris:AddItem(copie, 0.35)
					end
				end
			end
			task.wait(0.05)
		end
	end)
end]],
	},

	-- « lumière qui pulse sur … » : PointLight dont la luminosité monte et descend doucement (0,9 s),
	-- tant que la lumière existe. Relancé sur le même objet : change seulement la couleur.
	_vfxLumiere = {
		deps = { "_vfxPartie", "_vfxTaille", "_vfxCreer", "_versColor3" },
		services = { "TweenService" },
		code = [[
local function _vfxLumiere(cible, couleur)
	local partie, objet = _vfxPartie(cible, "lumière qui pulse")
	if partie == nil then
		return
	end
	local c = _versColor3(couleur) or Color3.fromRGB(167, 139, 250)
	local existante = partie:FindFirstChild("BlocsFR_LumierePulse")
	if existante ~= nil and existante:IsA("PointLight") then
		existante.Color = c
		return
	end
	local lumiere = _vfxCreer("PointLight", "BlocsFR_LumierePulse", {
		Color = c,
		Brightness = 0.3,
		Range = math.clamp(_vfxTaille(partie, objet) * 2 + 6, 10, 40),
		Shadows = false,
	}, partie)
	if lumiere == nil then
		return
	end
	task.spawn(function()
		local info = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		local monte = TweenService:Create(lumiere, info, { Brightness = 3 })
		local descend = TweenService:Create(lumiere, info, { Brightness = 0.3 })
		local enHaut = false
		while lumiere.Parent ~= nil do
			if enHaut then
				descend:Play()
			else
				monte:Play()
			end
			enHaut = not enHaut
			task.wait(0.9)
		end
	end)
end]],
	},

	-- « faire disparaître … en fondu en … s » : Transparency -> 1 (parties et images), puis plus de
	-- collision. Attend la fin. La transparence d'avant est gardée dans « BlocsFR_Transparence »
	-- (comme « cacher ») : « montrer » la remet.
	_vfxFondu = {
		deps = { "_vfxPartie", "_elementsVisibles", "_nombreOu" },
		services = { "TweenService" },
		code = [[
local function _vfxFondu(cible, duree)
	local partie, objet = _vfxPartie(cible, "disparaître en fondu")
	if partie == nil then
		return
	end
	local elements = _elementsVisibles(objet, true)
	local d = math.clamp(_nombreOu(duree, 1), 0, 60)
	for _, element in ipairs(elements) do
		if element:GetAttribute("BlocsFR_Transparence") == nil then
			element:SetAttribute("BlocsFR_Transparence", element.Transparency)
		end
		if d > 0 then
			TweenService:Create(element, TweenInfo.new(d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = 1 }):Play()
		else
			element.Transparency = 1
		end
	end
	if d > 0 then
		task.wait(d)
	end
	for _, element in ipairs(elements) do
		if element:IsA("BasePart") and element.Parent ~= nil then
			element.CanCollide = false
		end
	end
end]],
	},

	-- « arrêter les effets sur … » : détruit tout ce que les blocs Effets ont posé dans l'objet (ou
	-- dans tout le personnage quand l'objet en fait partie).
	_vfxArreter = {
		deps = { "_obj", "_perso", "_vfxRetirer", "_vfxAvertir" },
		services = {},
		code = [[
local function _vfxArreter(cible)
	if cible == nil then
		_vfxAvertir("« arrêter les effets » : la cible est vide (rien).")
		return
	end
	local objet = _obj(cible)
	if typeof(objet) == "Instance" and objet:IsA("Humanoid") then
		objet = objet.Parent
	end
	if typeof(objet) ~= "Instance" then
		_vfxAvertir("« arrêter les effets » : objet introuvable (" .. tostring(cible) .. ").")
		return
	end
	local perso = _perso(objet)
	if perso ~= nil then
		objet = perso
	end
	_vfxRetirer(objet, nil)
end]],
	},
}

return {
	category = "vfx",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Defs_Evenements</string><ProtectedString name="Source"><![CDATA[-- Defs_Evenements : blocs « Événements » (chapeaux qui démarrent un script) et fonctions utiles
-- du code généré : contacts, clics, joueurs, personnages et système de messages.
--
-- Contexte (SPEC §5.5) : les chapeaux qui fournissent joueur / personnage / partieTouchee /
-- deltaTemps / messageChat les déclarent comme paramètres (ou variables locales) portant ces noms
-- exacts, qui masquent ceux de l'en-tête. En mode local, « joueur » n'est jamais masqué par nil
-- (l'en-tête du script local vaut déjà le joueur local).
--
-- NOTE: _envoyerMessage(nom, joueur) accepte un 2e paramètre facultatif : dans un script serveur,
-- ctrl_envoyer_message transmet le « joueur » du contexte de l'expéditeur, que le chapeau
-- « Quand je reçois le message » reçoit comme « le joueur ». Les autres signatures suivent la SPEC.

local Util = require(script.Parent.Util)
local Shared = require(script.Parent.Shared)

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

-- Code indenté d'un niveau, précédé d'un saut de ligne ("" si le code est vide)
local function corps(g, code)
	if code == nil or code == "" then
		return ""
	end
	return "\n" .. g.indent(code)
end

-- Assemble les morceaux de code non vides, un par ligne
local function lignes(...)
	local out = {}
	for i = 1, select("#", ...) do
		local morceau = select(i, ...)
		if morceau ~= nil and morceau ~= "" then
			table.insert(out, morceau)
		end
	end
	return table.concat(out, "\n")
end

-- Valeur d'un littéral numérique ("12", "(-3)") ou nil si l'expression n'est pas un littéral
local function litNum(expr)
	if not Util.isNumberLiteral(expr) then
		return nil
	end
	return tonumber((string.gsub(expr, "[%(%)]", "")))
end

-- Chapeaux de contact : _surContact(script.Parent, mode, function(partieTouchee, personnage, joueur) ... end)
-- garde = code facultatif placé avant le corps (délai entre deux exécutions)
local function genContact(a, g, mode, garde)
	local fonction = g.helper("_surContact")
	local params = "partieTouchee, personnage, joueur"
	local prelude = ""
	if g.mode == "local" then
		-- en mode local, « joueur » garde la valeur de l'en-tête (joueur local) si personne n'est trouvé
		params = "partieTouchee, personnage, joueurContact"
		prelude = "local joueur = joueurContact or joueur"
	end
	local interieur = lignes(prelude, garde, a.BODY)
	return fonction .. "(script.Parent, \"" .. mode .. "\", function(" .. params .. ")" .. corps(g, interieur) .. "\nend)"
end

-- Délai global : une seule exécution par délai, quel que soit ce qui touche
local function gardeGlobale(a, g)
	local dernier = g.declare(g.uid("dernierContact"), "-math.huge")
	return "if os.clock() - " .. dernier .. " < " .. g.num(a.DELAI) .. " then\n\treturn\nend\n"
		.. dernier .. " = os.clock()"
end

-- Délai par personnage : chaque personnage ne déclenche qu'une exécution par délai
local function gardeParPersonnage(a, g)
	local derniers = g.declare(g.uid("contactsPersonnages"), "setmetatable({}, { __mode = \"k\" })")
	local acces = derniers .. "[personnage]"
	return "if " .. acces .. " and os.clock() - " .. acces .. " < " .. g.num(a.DELAI) .. " then\n\treturn\nend\n"
		.. acces .. " = os.clock()"
end

-- Chapeaux clavier (script local) : InputBegan / InputEnded filtré sur une touche.
-- Une lettre est comparée à ce qui est écrit sur la touche (_lettreTouche : AZERTY, QWERTY…),
-- car Enum.KeyCode suit la position QWERTY (sur AZERTY, la touche A donne KeyCode.Q).
-- _toucheIgnoree remplace le simple test « dejaTraite » : Roblox marque comme déjà traitées les
-- touches de ses commandes (espace, flèches, maj en verrouillage…), qui ne doivent pas être perdues.
local function genClavier(a, g, signal)
	local uis = g.service("UserInputService")
	local lettre = string.match(tostring(a.TOUCHE), "^Enum%.KeyCode%.(%u)$")
	local autreTouche
	if lettre then
		autreTouche = g.helper("_lettreTouche") .. "(entree) ~= \"" .. lettre .. "\""
	else
		autreTouche = "entree.KeyCode ~= " .. a.TOUCHE
	end
	local filtre = "if " .. autreTouche .. " or " .. g.helper("_toucheIgnoree") .. "(entree, dejaTraite) then\n\treturn\nend"
	local interieur = lignes(filtre, a.BODY)
	return uis .. "." .. signal .. ":Connect(function(entree, dejaTraite)" .. corps(g, interieur) .. "\nend)"
end

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "evt_demarrage",
		shape = "hat",
		label = "Quand ce script démarre",
		inputs = {},
		hatOrder = 2,
		keywords = "démarrer démarrage début commencer lancer lancement départ drapeau vert start",
		tooltip = "S'exécute une seule fois, au démarrage du script, juste après la mise en place des événements de ce script et des autres scripts qui démarrent en même temps (ils reçoivent donc les messages envoyés ici). Plusieurs de ces blocs s'exécutent en même temps.",
		gen = function(a, g)
			-- task.wait() : on laisse une image aux autres scripts lancés au même moment pour brancher
			-- leurs événements (sinon un message envoyé ici peut être perdu selon l'ordre des scripts)
			return "task.spawn(function()\n\ttask.wait()" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_touche",
		shape = "hat",
		label = "Quand cet objet est touché",
		inputs = {},
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "toucher touché touche contact collision cogner heurter marcher dessus",
		tooltip = "S'exécute chaque fois que quelque chose touche cet objet (ou une de ses parties). « la partie touchée » est la partie qui l'a touché ; « le personnage » et « le joueur » sont remplis si c'est un personnage.",
		gen = function(a, g)
			return genContact(a, g, "touche", nil)
		end,
	},
	{
		id = "evt_touche_delai",
		shape = "hat",
		label = "Quand cet objet est touché (délai %1 s)",
		inputs = { { name = "DELAI", kind = "number", default = 1 } },
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "toucher touché touche contact collision délai attente anti-rebond cooldown debounce",
		tooltip = "Comme « Quand cet objet est touché », mais ne s'exécute qu'une fois par délai (en secondes), même si l'objet est touché plusieurs fois.",
		gen = function(a, g)
			return genContact(a, g, "touche", gardeGlobale(a, g))
		end,
	},
	{
		id = "evt_fin_contact",
		shape = "hat",
		label = "Quand quelque chose arrête de toucher cet objet",
		inputs = {},
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "arrêter toucher fin contact quitter sortir lâcher touchended",
		tooltip = "S'exécute quand une partie arrête de toucher cet objet. « la partie touchée » est la partie qui s'en va.",
		gen = function(a, g)
			return genContact(a, g, "fin", nil)
		end,
	},
	{
		id = "evt_touche_perso",
		shape = "hat",
		label = "Quand un personnage touche cet objet",
		inputs = {},
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "personnage joueur toucher touché touche contact collision humanoid marcher",
		tooltip = "S'exécute quand un personnage (un joueur ou un PNJ avec un Humanoid) touche cet objet. Les autres objets sont ignorés.",
		gen = function(a, g)
			return genContact(a, g, "perso", nil)
		end,
	},
	{
		id = "evt_touche_perso_delai",
		shape = "hat",
		label = "Quand un personnage touche cet objet (délai %1 s)",
		inputs = { { name = "DELAI", kind = "number", default = 1 } },
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "personnage joueur toucher touché touche contact délai attente anti-rebond cooldown debounce",
		tooltip = "Comme « Quand un personnage touche cet objet », avec un délai propre à chaque personnage : chacun ne déclenche l'événement qu'une fois par délai (en secondes).",
		gen = function(a, g)
			return genContact(a, g, "perso", gardeParPersonnage(a, g))
		end,
	},
	{
		id = "evt_fin_contact_perso",
		shape = "hat",
		label = "Quand un personnage arrête de toucher cet objet",
		inputs = {},
		provides = { "partieTouchee", "personnage", "joueur" },
		keywords = "personnage joueur arrêter toucher fin contact quitter sortir descendre",
		tooltip = "S'exécute quand un personnage ne touche plus du tout cet objet (aucune de ses parties) pendant au moins 0,25 seconde : les pieds qui se lèvent à chaque pas ne comptent pas.",
		gen = function(a, g)
			return genContact(a, g, "fin_perso", nil)
		end,
	},
	{
		id = "evt_clic",
		shape = "hat",
		label = "Quand cet objet est cliqué",
		inputs = {},
		provides = { "joueur", "personnage" },
		keywords = "clic cliquer cliqué souris bouton appuyer clickdetector",
		tooltip = "S'exécute quand un joueur clique sur cet objet. Un ClickDetector (portée 32 studs) est ajouté automatiquement s'il n'y en a pas déjà un.",
		gen = function(a, g)
			local fonction = g.helper("_surClic")
			return fonction .. "(script.Parent, function(joueur, personnage)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_battement",
		shape = "hat",
		label = "À chaque image",
		inputs = {},
		provides = { "deltaTemps" },
		keywords = "chaque image frame battement heartbeat boucle continu toujours tick",
		tooltip = "S'exécute à chaque image (environ 60 fois par seconde). « temps depuis la dernière image » donne la durée écoulée. Évite d'y mettre des attentes.",
		gen = function(a, g)
			local rs = g.service("RunService")
			return rs .. ".Heartbeat:Connect(function(deltaTemps)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_toutes_les",
		shape = "hat",
		label = "Toutes les %1 secondes",
		inputs = { { name = "SECONDES", kind = "number", default = 1 } },
		keywords = "toutes les secondes minuterie chronomètre répéter intervalle timer horloge régulièrement",
		tooltip = "Exécute les blocs en dessous toutes les N secondes, tant que le jeu tourne (au minimum toutes les 0,03 s).",
		gen = function(a, g)
			local secondes = g.num(a.SECONDES)
			local n = litNum(secondes)
			local attente
			if n then
				attente = Util.numLiteral(math.max(n, 0.03))
			else
				attente = "math.max(" .. secondes .. ", 0.03)"
			end
			local interieur = ""
			if a.BODY ~= nil and a.BODY ~= "" then
				-- chaque tour s'exécute dans sa propre tâche : une erreur n'arrête que ce tour (comme pour
				-- les autres événements), pas le minuteur ; le tour suivant attend la fin de celui-ci
				local tour = g.uid("tour")
				interieur = "local " .. tour .. " = task.spawn(function()" .. corps(g, a.BODY) .. "\nend)\n"
					.. "while coroutine.status(" .. tour .. ") ~= \"dead\" do\n\ttask.wait()\nend"
			end
			local boucle = "while true do\n\ttask.wait(" .. attente .. ")" .. corps(g, interieur) .. "\nend"
			return "task.spawn(function()\n" .. g.indent(boucle) .. "\nend)"
		end,
	},
	{
		id = "evt_joueur_rejoint",
		shape = "hat",
		label = "Quand un joueur rejoint la partie",
		inputs = {},
		provides = { "joueur" },
		keywords = "joueur rejoint arrive arrivée connexion entrer nouveau playeradded",
		tooltip = "S'exécute pour chaque joueur qui rejoint la partie, y compris ceux qui étaient déjà là au démarrage du script.",
		gen = function(a, g)
			local fonction = g.helper("_surChaqueJoueur")
			return fonction .. "(function(joueur)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_joueur_quitte",
		shape = "hat",
		label = "Quand un joueur quitte la partie",
		inputs = {},
		provides = { "joueur" },
		keywords = "joueur quitte part départ déconnexion sortir partir playerremoving",
		tooltip = "S'exécute quand un joueur quitte la partie.",
		gen = function(a, g)
			local players = g.service("Players")
			return players .. ".PlayerRemoving:Connect(function(joueur)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_perso_apparait",
		shape = "hat",
		label = "Quand un personnage apparaît",
		inputs = {},
		provides = { "joueur", "personnage" },
		keywords = "personnage apparaît apparition réapparaît spawn naissance respawn characteradded",
		tooltip = "S'exécute chaque fois que le personnage d'un joueur apparaît (au début et après chaque réapparition), y compris les personnages déjà présents au démarrage du script.",
		gen = function(a, g)
			local fonction = g.helper("_surChaquePersonnage")
			return fonction .. "(function(joueur, personnage)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_perso_meurt",
		shape = "hat",
		label = "Quand un personnage meurt",
		inputs = {},
		provides = { "joueur", "personnage" },
		keywords = "personnage meurt mort mourir tué éliminé died vie zéro",
		tooltip = "S'exécute quand le personnage d'un joueur meurt (sa vie tombe à zéro).",
		gen = function(a, g)
			local fonction = g.helper("_surMortPersonnage")
			return fonction .. "(function(joueur, personnage)" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_message",
		shape = "hat",
		label = "Quand je reçois le message %1",
		inputs = { { name = "MESSAGE", kind = "text", default = "message1" } },
		provides = { "joueur" },
		keywords = "message recevoir reçois diffusion signal broadcast événement communication réseau",
		tooltip = "S'exécute quand le message portant exactement ce nom est envoyé, depuis ce côté-ci ou depuis l'autre (serveur et joueurs). Dans un script serveur, « le joueur » est le joueur qui a envoyé le message. Attention : un tricheur peut envoyer n'importe quel message au serveur ; ne donne pas de récompense sur un simple message sans vérifier (distance, délai…).",
		gen = function(a, g)
			local fonction = g.helper("_surMessage")
			local params = "joueur"
			if g.mode == "local" then
				-- en mode local, on ne masque pas « joueur » (joueur local de l'en-tête)
				params = ""
			end
			return fonction .. "(" .. a.MESSAGE .. ", function(" .. params .. ")" .. corps(g, a.BODY) .. "\nend)"
		end,
	},
	{
		id = "evt_touche_clavier",
		shape = "hat",
		label = "Quand la touche %1 est appuyée",
		inputs = { { name = "TOUCHE", kind = "dropdown", options = Shared.TOUCHES, default = "Enum.KeyCode.E" } },
		scriptType = "local",
		keywords = "touche clavier appuyer appuyée presser taper keyboard input key",
		tooltip = "Script local uniquement : s'exécute quand le joueur appuie sur la touche choisie (ignoré pendant qu'il écrit dans le chat). Les lettres suivent le clavier du joueur (AZERTY, QWERTY…).",
		gen = function(a, g)
			return genClavier(a, g, "InputBegan")
		end,
	},
	{
		id = "evt_touche_relachee",
		shape = "hat",
		label = "Quand la touche %1 est relâchée",
		inputs = { { name = "TOUCHE", kind = "dropdown", options = Shared.TOUCHES, default = "Enum.KeyCode.E" } },
		scriptType = "local",
		keywords = "touche clavier relâcher relâchée lâcher keyboard input key",
		tooltip = "Script local uniquement : s'exécute quand le joueur relâche la touche choisie (ignoré pendant qu'il écrit dans le chat). Les lettres suivent le clavier du joueur (AZERTY, QWERTY…).",
		gen = function(a, g)
			return genClavier(a, g, "InputEnded")
		end,
	},
	{
		id = "evt_chat",
		shape = "hat",
		label = "Quand un joueur écrit dans le chat",
		inputs = {},
		provides = { "joueur", "messageChat", "personnage" },
		scriptType = "server",
		keywords = "chat écrire message discuter parler tchat commande chatted",
		tooltip = "Script serveur uniquement : s'exécute quand un joueur envoie un message dans le chat. « le message du chat » contient le texte écrit.",
		gen = function(a, g)
			local fonction = g.helper("_surChaqueJoueur")
			local interieur = lignes("local personnage = joueur.Character", a.BODY)
			local connexion = "joueur.Chatted:Connect(function(messageChat)" .. corps(g, interieur) .. "\nend)"
			return fonction .. "(function(joueur)" .. corps(g, connexion) .. "\nend)"
		end,
	},
}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré
---------------------------------------------------------------------------

local helpers = {
	-- Branche les contacts de toutes les parties d'un objet (partie ou modèle).
	-- mode : "touche" | "fin" | "perso" | "fin_perso" ; fn(partieTouchee, personnage, joueur)
	_surContact = {
		deps = { "_obj", "_parties", "_perso", "_avertir" },
		services = { "Players" },
		code = [[
local function _surContact(objet, mode, fn)
	local racine = _obj(objet)
	if racine == nil then
		_avertir("Événement de contact : l'objet à surveiller est introuvable.")
		return
	end
	if racine == workspace or racine.Parent == game then
		_avertir("Événement de contact : place le script dans une partie ou un modèle (pas directement dans « " .. racine.Name .. " »).")
		return
	end
	local avecFin = mode == "fin" or mode == "fin_perso"
	local persoSeulement = mode == "perso" or mode == "fin_perso"
	local contacts = setmetatable({}, { __mode = "k" })
	local finsPrevues = setmetatable({}, { __mode = "k" })
	local branchees = setmetatable({}, { __mode = "k" })
	local nbBranchees = 0
	local function joueurDe(perso)
		if perso then
			return Players:GetPlayerFromCharacter(perso)
		end
		return nil
	end
	local function valide(autre)
		-- on ignore l'objet lui-même (ex. deux parties du même modèle qui se touchent)
		return typeof(autre) == "Instance" and autre ~= racine and not autre:IsDescendantOf(racine)
	end
	local function debut(autre)
		if not valide(autre) then
			return
		end
		local perso = _perso(autre)
		if mode == "fin_perso" then
			if perso then
				contacts[perso] = (contacts[perso] or 0) + 1
			end
		elseif perso or not persoSeulement then
			fn(autre, perso, joueurDe(perso))
		end
	end
	local function fin(autre)
		if not valide(autre) then
			return
		end
		local perso = _perso(autre)
		if mode == "fin" then
			fn(autre, perso, joueurDe(perso))
		elseif perso then
			local reste = (contacts[perso] or 0) - 1
			if reste > 0 then
				contacts[perso] = reste
			else
				-- les pieds quittent la partie un instant à chaque pas (TouchEnded puis Touched) :
				-- fn n'est appelée que si le personnage n'a rien retouché pendant 0,25 s
				contacts[perso] = nil
				local numero = (finsPrevues[perso] or 0) + 1
				finsPrevues[perso] = numero
				task.delay(0.25, function()
					if contacts[perso] == nil and finsPrevues[perso] == numero then
						fn(autre, perso, joueurDe(perso))
					end
				end)
			end
		end
	end
	local function brancher(partie)
		if branchees[partie] then
			return
		end
		branchees[partie] = true
		nbBranchees += 1
		if mode ~= "fin" then
			partie.Touched:Connect(debut)
		end
		if avecFin then
			partie.TouchEnded:Connect(fin)
		end
	end
	for _, partie in ipairs(_parties(racine)) do
		brancher(partie)
	end
	racine.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			brancher(descendant)
		end
	end)
	task.delay(5, function()
		if nbBranchees == 0 then
			_avertir("« " .. racine.Name .. " » ne contient aucune partie : ses contacts ne peuvent pas être détectés.")
		end
	end)
end]],
	},

	-- Clic sur un objet : utilise (ou crée) un ClickDetector ; fn(joueur, personnage)
	_surClic = {
		deps = { "_obj", "_avertir" },
		services = {},
		code = [[
local function _surClic(objet, fn)
	local racine = _obj(objet)
	if racine == nil then
		_avertir("Événement de clic : l'objet à surveiller est introuvable.")
		return
	end
	local detecteur = racine:FindFirstChildOfClass("ClickDetector")
	if detecteur == nil then
		if racine == workspace or racine.Parent == game or not (racine:IsA("BasePart") or racine:IsA("Model")) then
			_avertir("« " .. racine.Name .. " » n'est ni une partie ni un modèle : il ne peut pas être cliqué.")
			return
		end
		detecteur = Instance.new("ClickDetector")
		detecteur.MaxActivationDistance = 32
		detecteur.Parent = racine
	end
	detecteur.MouseClick:Connect(function(j)
		local perso = nil
		if j then
			perso = j.Character
		end
		fn(j, perso)
	end)
end]],
	},

	-- Appelle fn(joueur) pour chaque joueur : ceux déjà présents puis chaque nouveau (une seule fois chacun)
	_surChaqueJoueur = {
		deps = {},
		services = { "Players" },
		code = [[
local function _surChaqueJoueur(fn)
	local vus = setmetatable({}, { __mode = "k" })
	local function lancer(j)
		if vus[j] then
			return
		end
		vus[j] = true
		task.spawn(fn, j)
	end
	Players.PlayerAdded:Connect(lancer)
	for _, j in ipairs(Players:GetPlayers()) do
		lancer(j)
	end
end]],
	},

	-- Appelle fn(joueur, personnage) à chaque apparition d'un personnage (y compris ceux déjà présents)
	_surChaquePersonnage = {
		deps = { "_surChaqueJoueur" },
		services = {},
		code = [[
local function _surChaquePersonnage(fn)
	local vus = setmetatable({}, { __mode = "k" })
	_surChaqueJoueur(function(j)
		local function appeler(perso)
			if perso == nil or vus[perso] then
				return
			end
			vus[perso] = true
			fn(j, perso)
		end
		j.CharacterAdded:Connect(appeler)
		appeler(j.Character)
	end)
end]],
	},

	-- Appelle fn(joueur, personnage) quand le personnage d'un joueur meurt
	_surMortPersonnage = {
		deps = { "_surChaquePersonnage" },
		services = {},
		code = [[
local function _surMortPersonnage(fn)
	_surChaquePersonnage(function(j, perso)
		local humanoid = perso:FindFirstChildOfClass("Humanoid")
		if humanoid == nil then
			humanoid = perso:WaitForChild("Humanoid", 10)
		end
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(function()
				fn(j, perso)
			end)
		end
	end)
end]],
	},

	-- Chapeaux clavier : vrai si la touche doit être ignorée. Une touche « déjà traitée » par le jeu
	-- est ignorée, sauf celles des commandes de Roblox (sauter, marcher, verrouillage maj, caméra,
	-- liste des joueurs), que Roblox marque toujours ainsi : elles ne sont ignorées que pendant que
	-- le joueur écrit (chat, zone de texte) ou que le menu Roblox est ouvert.
	_toucheIgnoree = {
		deps = {},
		services = { "UserInputService", "GuiService", "TextChatService" },
		code = [[
local function _toucheIgnoree(entree, dejaTraite)
	if not dejaTraite then
		return false
	end
	if typeof(entree) ~= "Instance" then
		return true
	end
	if UserInputService:GetFocusedTextBox() ~= nil then
		return true
	end
	local okMenu, menuOuvert = pcall(function()
		return GuiService.MenuIsOpen
	end)
	if okMenu and menuOuvert == true then
		return true
	end
	local okChat, chatActif = pcall(function()
		return TextChatService.ChatInputBarConfiguration.IsFocused
	end)
	if okChat and chatActif == true then
		return true
	end
	local commandes = {
		[Enum.KeyCode.Space] = true,
		[Enum.KeyCode.LeftShift] = true,
		[Enum.KeyCode.RightShift] = true,
		[Enum.KeyCode.W] = true,
		[Enum.KeyCode.A] = true,
		[Enum.KeyCode.S] = true,
		[Enum.KeyCode.D] = true,
		[Enum.KeyCode.Up] = true,
		[Enum.KeyCode.Down] = true,
		[Enum.KeyCode.Left] = true,
		[Enum.KeyCode.Right] = true,
		[Enum.KeyCode.Tab] = true,
	}
	return commandes[entree.KeyCode] ~= true
end]],
	},

	-- Lettre écrite sur la touche d'une entrée clavier, selon le clavier du joueur (AZERTY, QWERTY…),
	-- en majuscule ; "" si ce n'est pas une touche du clavier. Pour un clavier sans lettres latines,
	-- on garde la lettre de la position QWERTY (Enum.KeyCode).
	_lettreTouche = {
		deps = {},
		services = { "UserInputService" },
		code = [[
local function _lettreTouche(entree)
	if typeof(entree) ~= "Instance" or entree.UserInputType ~= Enum.UserInputType.Keyboard then
		return ""
	end
	local code = entree.KeyCode
	local ok, texte = pcall(function()
		return UserInputService:GetStringForKeyCode(code)
	end)
	if ok and type(texte) == "string" and texte ~= "" and not string.find(texte, "[\128-\255]") then
		return string.upper(texte)
	end
	local nom = code.Name
	if #nom == 1 then
		return nom
	end
	return ""
end]],
	},

	-- BindableEvent des messages d'un même côté (« BlocsFR_Messages » dans ReplicatedStorage).
	-- Le serveur le crée ; un client l'attend 5 s au plus puis en crée un local (marqué BlocsFR_Local).
	_canalMessages = {
		deps = {},
		services = { "ReplicatedStorage", "RunService" },
		code = [[
local function _canalMessages()
	local NOM = "BlocsFR_Messages"
	local function chercher()
		local trouve = nil
		for _, enfant in ipairs(ReplicatedStorage:GetChildren()) do
			if enfant.Name == NOM and enfant:IsA("BindableEvent") then
				if enfant:GetAttribute("BlocsFR_Local") then
					return enfant
				end
				if trouve == nil then
					trouve = enfant
				end
			end
		end
		return trouve
	end
	local canal = chercher()
	if canal then
		return canal
	end
	if RunService:IsServer() then
		canal = Instance.new("BindableEvent")
		canal.Name = NOM
		canal.Parent = ReplicatedStorage
		return canal
	end
	ReplicatedStorage:WaitForChild(NOM, 5)
	canal = chercher()
	if canal then
		return canal
	end
	canal = Instance.new("BindableEvent")
	canal.Name = NOM
	canal:SetAttribute("BlocsFR_Local", true)
	canal.Parent = ReplicatedStorage
	return canal
end]],
	},

	-- RemoteEvent des messages entre serveur et joueurs (« BlocsFR_Reseau » dans ReplicatedStorage).
	-- Le serveur le crée ; un client l'attend (attente = secondes max, nil = sans limite).
	_reseauMessages = {
		deps = { "_avertir" },
		services = { "ReplicatedStorage", "RunService" },
		code = [[
local function _reseauMessages(attente)
	local NOM = "BlocsFR_Reseau"
	local reseau = ReplicatedStorage:FindFirstChild(NOM)
	if reseau and reseau:IsA("RemoteEvent") then
		return reseau
	end
	if RunService:IsServer() then
		if reseau then
			_avertir("« " .. NOM .. " » existe déjà dans ReplicatedStorage mais n'est pas un RemoteEvent : messages réseau impossibles.")
			return nil
		end
		reseau = Instance.new("RemoteEvent")
		reseau.Name = NOM
		reseau.Parent = ReplicatedStorage
		return reseau
	end
	if type(attente) == "number" then
		reseau = ReplicatedStorage:WaitForChild(NOM, attente)
	else
		reseau = ReplicatedStorage:WaitForChild(NOM, 60)
		while reseau == nil do
			reseau = ReplicatedStorage:WaitForChild(NOM, 60)
		end
	end
	if reseau and reseau:IsA("RemoteEvent") then
		return reseau
	end
	return nil
end]],
	},

	-- Écoute un message : envois du même côté (BindableEvent) et de l'autre côté (RemoteEvent).
	-- fn(joueur) : sur le serveur, joueur = l'expéditeur (client) ou le joueur transmis par le script serveur.
	_surMessage = {
		deps = { "_canalMessages", "_reseauMessages", "_texte" },
		services = { "RunService" },
		code = [[
local function _surMessage(nom, fn)
	local attendu = _texte(nom)
	task.spawn(function()
		local canal = _canalMessages()
		if canal == nil then
			return
		end
		canal.Event:Connect(function(recu, j)
			if recu == attendu then
				fn(j)
			end
		end)
	end)
	task.spawn(function()
		local reseau = _reseauMessages()
		if reseau == nil then
			return
		end
		if RunService:IsServer() then
			reseau.OnServerEvent:Connect(function(j, recu)
				if type(recu) == "string" and recu == attendu then
					fn(j)
				end
			end)
		else
			reseau.OnClientEvent:Connect(function(recu)
				if recu == attendu then
					fn(nil)
				end
			end)
		end
	end)
end]],
	},

	-- Envoie un message aux scripts du même côté (joueur = joueur du contexte, facultatif)
	_envoyerMessage = {
		deps = { "_canalMessages", "_texte" },
		services = {},
		code = [[
local function _envoyerMessage(nom, joueur)
	local canal = _canalMessages()
	if canal then
		canal:Fire(_texte(nom), joueur)
	end
end]],
	},

	-- Serveur -> scripts locaux de tous les joueurs
	_envoyerMessageClients = {
		deps = { "_reseauMessages", "_texte", "_avertir" },
		services = { "RunService" },
		code = [[
local function _envoyerMessageClients(nom)
	if not RunService:IsServer() then
		_avertir("« envoyer le message à tous les joueurs » ne fonctionne que dans un script serveur.")
		return
	end
	local reseau = _reseauMessages()
	if reseau then
		reseau:FireAllClients(_texte(nom))
	end
end]],
	},

	-- Serveur -> scripts locaux d'un joueur
	_envoyerMessageJoueur = {
		deps = { "_reseauMessages", "_texte", "_avertir", "_joueur" },
		services = { "RunService" },
		code = [[
local function _envoyerMessageJoueur(nom, joueur)
	if not RunService:IsServer() then
		_avertir("« envoyer le message au joueur » ne fonctionne que dans un script serveur.")
		return
	end
	local cible = _joueur(joueur)
	if cible == nil then
		_avertir("Message « " .. _texte(nom) .. " » non envoyé : joueur introuvable.")
		return
	end
	local reseau = _reseauMessages()
	if reseau then
		reseau:FireClient(cible, _texte(nom))
	end
end]],
	},

	-- Script local -> scripts serveur
	_envoyerMessageServeur = {
		deps = { "_reseauMessages", "_texte", "_avertir" },
		services = { "RunService" },
		code = [[
local function _envoyerMessageServeur(nom)
	if RunService:IsServer() then
		_avertir("« envoyer le message au serveur » ne fonctionne que dans un script local.")
		return
	end
	local reseau = _reseauMessages(10)
	if reseau == nil then
		_avertir("Message « " .. _texte(nom) .. " » non envoyé : aucun script serveur Blocs FR ne reçoit de messages.")
		return
	end
	reseau:FireServer(_texte(nom))
end]],
	},
}

return {
	category = "evenements",
	blocks = blocks,
	helpers = helpers,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Defs_Interface</string><ProtectedString name="Source"><![CDATA[-- Defs_Interface : blocs de la catégorie « Interface » (SPEC §21.7) : ils pilotent les écrans créés
-- dans l'onglet Interface (le Studio d'interface) : boutons, textes, barres, écrans entiers.
--
-- Les entrées « gui » (SPEC §21.6) contiennent le NOM d'un écran ou d'un élément (« Jouer »), ou
-- « Écran/Élément » quand ce nom existe dans plusieurs écrans. Le code reçoit toujours un texte.
--
-- Choix de conception :
--   * Chaque bloc agit sur l'interface (PlayerGui) du « joueur » du contexte, passé en premier
--     argument (qui) : dans un script local, c'est toujours le joueur local (les écrans des autres
--     joueurs n'existent pas chez lui) ; dans un script serveur, le joueur de l'événement (sans
--     joueur : avertissement en français, le bloc ne fait rien).
--   * Un élément est cherché par son nom : « Écran/Élément » dans cet écran ; sinon d'abord dans
--     l'écran qui contient le script (les blocs de l'écran), puis dans tous les écrans du joueur. Les
--     morceaux internes des éléments (Face, Texte, Remplissage : attribut BlocsFR_Partie) ne comptent
--     jamais : un élément nommé « Texte » est bien trouvé. On attend l'élément 5 s au plus.
--   * L'état partagé (avertissements déjà affichés, recherches en cache, effets d'écran en cours)
--     est rangé dans shared.BlocsFR_Interface et renvoyé par _guiEtat() : une fonction utile ne
--     peut pas avoir de variable à elle en dehors de son corps (SPEC §5.4).
--   * Les avertissements identiques ne sont affichés qu'une fois toutes les 5 s.
--   * « afficher / cacher l'écran » (effet de 0,3 s), « animer » et « déplacer » attendent la fin
--     de leur effet ; « remplir la barre », les notifications et le grand message n'attendent pas.
-- NOTE: écarts / précisions par rapport à la SPEC :
--   * « Quand le bouton … est cliqué » (et les autres événements) : dans les blocs d'un écran, si
--     cet écran contient un bouton de ce nom, seuls ses boutons à lui sont écoutés (deux écrans
--     peuvent avoir chacun un bouton « Fermer ») ; sinon tous les boutons de ce nom du joueur.
--   * le grand message utilise le ScreenGui « BlocsFR_GrandMessage » : « BlocsFR_Message » est déjà
--     pris par le bloc « afficher … à l'écran de … » (Defs_Joueurs), qui le supprimerait.
--   * « mettre la couleur » d'une barre change la couleur de son remplissage ; une image sans fond
--     est teintée (ImageColor3) ; un bouton dont le relief suit sa couleur garde un relief assorti.
--   * « montrer » / « cacher » annulent un fondu (apparaître / disparaître) en cours sur l'élément
--     (ses tweens sont arrêtés) ; de même, un effet d'écran arrête les tweens de l'effet précédent.
--   * « texte de … » reste utilisable partout (SPEC : "both") mais avertit à la compilation dans un
--     script serveur : ce que le joueur écrit dans un champ n'arrive jamais au serveur.
--   * « afficher la statistique » suit la statistique sans limite de temps (créée plus tard ou
--     remplacée) ; un seul avertissement au bout de 10 s si elle n'existe toujours pas.

---------------------------------------------------------------------------
-- Listes d'options (le code est un texte Luau entre guillemets)
---------------------------------------------------------------------------

local EFFETS_ECRAN = {
	{ "sans effet", '"aucun"' },
	{ "fondu", '"fondu"' },
	{ "glisser du haut", '"haut"' },
	{ "glisser du bas", '"bas"' },
	{ "glisser de la gauche", '"gauche"' },
	{ "glisser de la droite", '"droite"' },
	{ "zoom", '"zoom"' },
}

local ANIMATIONS = {
	{ "rebondir", '"rebondir"' },
	{ "grossir", '"grossir"' },
	{ "rétrécir", '"retrecir"' },
	{ "taille normale", '"normal"' },
	{ "secouer", '"secouer"' },
	{ "clignoter", '"clignoter"' },
	{ "tourner", '"tourner"' },
	{ "apparaître", '"apparaitre"' },
	{ "disparaître", '"disparaitre"' },
	{ "pulser", '"pulser"' },
}

---------------------------------------------------------------------------
-- Outils de génération
---------------------------------------------------------------------------

-- Entrée « gui » (SPEC §21.6) : filtre = "ecran", "element", "bouton", "texte", "barre", "champ", "image"
local function guiInput(name, filter, default)
	return { name = name, kind = "gui", filter = filter, default = default }
end

local function nombre(name, default)
	return { name = name, kind = "number", default = default }
end

-- Code indenté d'un niveau, précédé d'un saut de ligne ("" si le code est vide)
local function corps(g, code)
	if code == nil or code == "" then
		return ""
	end
	return "\n" .. g.indent(code)
end

-- Appel d'une aide : appel(g, "_aide", "a", "b") -> "_aide(a, b)" (l'aide est ajoutée au script)
local function appel(g, nom, ...)
	local n = select("#", ...)
	local args = { ... }
	for i = 1, n do
		if args[i] == nil or args[i] == "" then
			args[i] = "nil"
		end
	end
	return g.helper(nom) .. "(" .. table.concat(args, ", ", 1, n) .. ")"
end

-- Chapeau d'événement d'interface : aide(joueur, "Nom", function() … end)
local function chapeau(g, aide, nomExpr, body)
	return appel(g, aide, "joueur", nomExpr, "function()" .. corps(g, body) .. "\nend")
end

local SERVEUR = " Dans un script serveur, il agit sur l'écran du « joueur » de l'événement."

---------------------------------------------------------------------------
-- Blocs
---------------------------------------------------------------------------

local blocks = {
	{
		id = "gui_quand_clic",
		shape = "hat",
		label = "Quand le bouton %1 est cliqué",
		inputs = { guiInput("BOUTON", "bouton", "Jouer") },
		scriptType = "local",
		keywords = "quand bouton clic clique cliquer appuyer toucher interface gui menu ecran click button pressed activated",
		tooltip = "S'exécute chaque fois que le joueur clique (ou touche, sur téléphone) ce bouton de ton interface (onglet Interface). À mettre dans un script local : les blocs sous l'écran en sont un. Astuce : enchaîne « cacher l'écran … avec fondu » pour fermer un menu.",
		gen = function(a, g)
			return chapeau(g, "_guiSurClic", a.BOUTON, a.BODY)
		end,
	},
	{
		id = "gui_quand_valide",
