}

---------------------------------------------------------------------------
-- Fonctions utiles copiées dans le code généré (SPEC §5.4, §21.7)
---------------------------------------------------------------------------

local helpers = {
	-- État partagé par tous les scripts du même côté (avertissements, cache, effets en cours)
	_guiEtat = {
		deps = {},
		services = {},
		code = [=[
local function _guiEtat()
	local etat = shared.BlocsFR_Interface
	if type(etat) ~= "table" then
		etat = {
			avertis = {},
			cache = setmetatable({}, { __mode = "k" }),
			versions = setmetatable({}, { __mode = "k" }),
			enCours = setmetatable({}, { __mode = "k" }),
			notifications = 0,
		}
		shared.BlocsFR_Interface = etat
	end
	-- Tweens en cours des effets d'écran et des fondus (créés ici si l'état vient d'un script plus ancien)
	if etat.tweens == nil then
		etat.tweens = setmetatable({}, { __mode = "k" })
	end
	if etat.fondus == nil then
		etat.fondus = setmetatable({}, { __mode = "k" })
	end
	return etat
end]=],
	},

	-- Avertissement en français, au plus une fois toutes les 5 s pour un même message
	_guiAvertir = {
		deps = { "_avertir", "_guiEtat" },
		services = {},
		code = [=[
local function _guiAvertir(message)
	local etat = _guiEtat()
	local maintenant = os.clock()
	local dernier = etat.avertis[message]
	if dernier ~= nil and maintenant - dernier < 5 then
		return
	end
	etat.avertis[message] = maintenant
	_avertir(message)
end]=],
	},

	-- Nom d'écran / d'élément : texte sans espaces aux extrémités
	_guiNom = {
		deps = { "_texte" },
		services = {},
		code = [=[
local function _guiNom(valeur)
	local nom = _texte(valeur)
	nom = string.gsub(nom, "^%s+", "")
	nom = string.gsub(nom, "%s+$", "")
	return nom
end]=],
	},

