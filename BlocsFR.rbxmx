	-- Élément d'interface nommé nom dans conteneur (recherche en profondeur, mise en cache)
	_guiChercher = {
		deps = { "_guiEtat" },
		services = {},
		code = [=[
local function _guiChercher(conteneur, nom)
	if typeof(conteneur) ~= "Instance" or nom == "" then
		return nil
	end
	local etat = _guiEtat()
	local connus = etat.cache[conteneur]
	if connus == nil then
		connus = setmetatable({}, { __mode = "v" })
		etat.cache[conteneur] = connus
	end
	local connu = connus[nom]
	if connu ~= nil and connu.Name == nom and connu:IsDescendantOf(conteneur) then
		return connu
	end
	for _, objet in ipairs(conteneur:GetDescendants()) do
		if objet.Name == nom and objet:IsA("GuiObject") and objet:GetAttribute("BlocsFR_Partie") == nil then
			connus[nom] = objet
			return objet
		end
	end
	return nil
end]=],
	},

	-- Écran (ScreenGui) du joueur qui porte ce nom (attendu 5 s au plus)
	_guiEcran = {
		deps = { "_guiNom", "_guiRacine", "_guiAvertir" },
		services = {},
		code = [=[
local function _guiEcran(qui, nom)
	nom = _guiNom(nom)
	if nom == "" then
		_guiAvertir("Choisis un écran dans le bloc (la case est vide).")
		return nil
	end
	local racine = _guiRacine(qui)
	if racine == nil then
		return nil
	end
	local attendu = 0
	while true do
		for _, ecran in ipairs(racine:GetChildren()) do
			if ecran.Name == nom and ecran:IsA("LayerCollector") then
				return ecran
			end
		end
		if attendu >= 5 then
			break
		end
		attendu += task.wait(0.2)
	end
	_guiAvertir("Écran « " .. nom .. " » introuvable : vérifie son nom dans le Studio d'interface (il doit être enregistré dans StarterGui).")
	return nil
end]=],
	},

	-- Élément d'interface : « Écran/Élément », sinon l'écran du script d'abord, puis tous les écrans
	-- du joueur (attendu 5 s au plus)
	_guiTrouver = {
		deps = { "_guiNom", "_guiRacine", "_guiChercher", "_guiAvertir" },
		services = {},
		code = [=[
local function _guiTrouver(qui, nom)
	nom = _guiNom(nom)
	if nom == "" then
		_guiAvertir("Choisis un élément de l'interface dans le bloc (la case est vide).")
		return nil
	end
	local ecranNom, elementNom = string.match(nom, "^([^/]+)/(.+)$")
	local propre = script:FindFirstAncestorOfClass("ScreenGui")
	local racine = nil
	local attendu = 0
	while true do
		local trouve = nil
		if ecranNom ~= nil then
			racine = racine or _guiRacine(qui)
			if racine == nil then
				return nil
			end
			for _, ecran in ipairs(racine:GetChildren()) do
				if ecran.Name == ecranNom and ecran:IsA("LayerCollector") then
					trouve = _guiChercher(ecran, elementNom)
					if trouve ~= nil then
						break
					end
				end
			end
		else
			if propre ~= nil then
				trouve = _guiChercher(propre, nom)
			end
			if trouve == nil then
				racine = racine or _guiRacine(qui)
				if racine == nil then
					return nil
				end
				trouve = _guiChercher(racine, nom)
			end
		end
		if trouve ~= nil then
			return trouve
		end
		if attendu >= 5 then
			break
		end
		attendu += task.wait(0.2)
	end
	_guiAvertir("Élément « " .. nom .. " » introuvable dans l'interface (vérifie son nom dans le Studio d'interface).")
	return nil
end]=],
	},

	-- Objet qui affiche le texte d'un élément : Face > Texte (bouton), Texte (barre) ou lui-même
	_guiTexteObjet = {
		deps = { "_guiPartie" },
		services = {},
		code = [=[
local function _guiTexteObjet(objet)
	if typeof(objet) ~= "Instance" then
		return nil
	end
	local function estTexte(o)
		return o ~= nil and (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox"))
	end
	local face = _guiPartie(objet, "Face")
	if face ~= nil then
		local zone = _guiPartie(face, "Texte")
		if estTexte(zone) then
			return zone
		end
	end
	local zone = _guiPartie(objet, "Texte")
	if estTexte(zone) then
		return zone
	end
	if estTexte(objet) then
		return objet
	end
	return nil
end]=],
	},

	-- Branche fn sur les éléments nommés nom, présents et à venir (genre : "clic", "valide", "survol").
	-- Ne bloque jamais le script : la recherche se fait en parallèle.
	_guiBrancher = {
		deps = { "_guiNom", "_guiRacine", "_guiAvertir" },
		services = {},
		code = [=[
local function _guiBrancher(qui, nom, genre, fn)
	nom = _guiNom(nom)
	if nom == "" then
		_guiAvertir("Choisis un élément de l'interface dans l'événement (la case est vide).")
		return
	end
	if type(fn) ~= "function" then
		return
	end
	task.spawn(function()
		local racine = _guiRacine(qui)
		if racine == nil then
			return
		end
		local ecranNom, elementNom = string.match(nom, "^([^/]+)/(.+)$")
		if elementNom == nil then
			elementNom = nom
		end
		local function convient(objet)
			if objet.Name ~= elementNom or objet:GetAttribute("BlocsFR_Partie") ~= nil then
				return false
			end
			if genre == "clic" then
				if not objet:IsA("GuiButton") then
					return false
				end
			elseif genre == "valide" then
				if not objet:IsA("TextBox") then
					return false
				end
			elseif not objet:IsA("GuiObject") then
				return false
			end
			if ecranNom ~= nil then
				local ecran = objet:FindFirstAncestorWhichIsA("LayerCollector")
				return ecran ~= nil and ecran.Name == ecranNom
			end
			return true
		end
		-- Dans les blocs d'un écran qui contient cet élément : seulement les éléments de cet écran
		local conteneur = racine
		local propre = script:FindFirstAncestorOfClass("ScreenGui")
		if ecranNom == nil and propre ~= nil and propre:IsDescendantOf(racine) then
			for _, objet in ipairs(propre:GetDescendants()) do
				if convient(objet) then
					conteneur = propre
					break
				end
			end
		end
		local branches = setmetatable({}, { __mode = "k" })
		local nombre = 0
		local function brancher(objet)
			if branches[objet] or not convient(objet) then
				return
			end
			branches[objet] = true
			nombre += 1
			if genre == "clic" then
				objet.Activated:Connect(function()
					task.spawn(fn)
				end)
			elseif genre == "valide" then
				objet.FocusLost:Connect(function(entree)
					if entree then
						task.spawn(fn)
					end
				end)
			else
				objet.MouseEnter:Connect(function()
					task.spawn(fn)
				end)
			end
		end
		for _, objet in ipairs(conteneur:GetDescendants()) do
			brancher(objet)
		end
		conteneur.DescendantAdded:Connect(brancher)
		task.delay(6, function()
			if nombre == 0 then
				_guiAvertir("« " .. nom .. " » est introuvable dans l'interface : cet événement ne se déclenchera pas (vérifie le nom dans le Studio d'interface).")
			end
		end)
	end)
end]=],
	},

	_guiSurClic = {
		deps = { "_guiBrancher" },
		services = {},
		code = [=[
local function _guiSurClic(qui, nom, fn)
	_guiBrancher(qui, nom, "clic", fn)
end]=],
