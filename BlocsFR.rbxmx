	ctrl_tant_que = "une case vide vaut « faux » : la boucle s'arrête tout de suite et les blocs à l'intérieur ne s'exécutent jamais.",
	ctrl_repeter_jusqua = "une case vide vaut « faux » : la condition n'est jamais remplie, la boucle tourne donc sans fin et les blocs placés dessous ne s'exécutent jamais.",
	ctrl_attendre_jusqua = "une case vide vaut « faux » : le script restera bloqué ici pour toujours.",
}

