local faq = {
	id = "faq",
	title = "Questions fréquentes",
	summary = "Les réponses aux questions que tout le monde se pose.",
	body = {
		h("Est-ce que je dois savoir programmer ?"),
		p("Non ! Si tu sais glisser des blocs, tu sais utiliser Blocs FR. Et si un jour tu as envie d'apprendre le Luau, le bouton **Voir le code** te montre le vrai script écrit à partir de tes blocs."),
		h("Où est passé mon script ?"),
		p("Dans la cible, sous le nom `BlocsServeur` (script serveur), `BlocsLocal` (script local) ou `BlocsModule` (script module). Déplie l'objet dans l'Explorateur pour le voir."),
		h("Je peux modifier le code Luau à la main ?"),
		p("Tu peux le lire, mais ne le modifie pas : la prochaine fois que tu enregistreras depuis l'éditeur de blocs, il sera remplacé."),
		h("Comment supprimer un bloc ?"),
		p("Glisse-le sur la palette, ou fais un clic droit dessus puis **Supprimer ce bloc**. Si tu te trompes, le bouton **Annuler** répare tout."),
		h("Pourquoi certains blocs sont grisés ?"),
		p("Ils ne fonctionnent pas dans le type de script choisi. Par exemple, « Quand la touche … est appuyée » demande un script local, « créer la statistique … (départ …) » un script serveur, et « Définir la fonction … » un script module."),
		h("Comment utiliser les mêmes blocs dans plusieurs scripts ?"),
		p("Range-les dans un **script module** : choisis **Script module** en haut de l'éditeur, mets tes blocs sous « Définir la fonction … », enregistre le module dans un Folder de ReplicatedStorage, puis appelle la fonction depuis tes autres scripts avec « appeler la fonction … du module … »."),
		lien("modules", "Les scripts modules"),
		h("Un script module, ça marche tout seul ?"),
		p("Non : un module est une boîte à outils. Ses blocs ne s'exécutent que quand un script serveur ou local l'utilise. Il tourne alors du côté de ce script."),
		h("Un bloc tout seul sur le canvas, c'est grave ?"),
		p("Non, mais il ne fera rien : seuls les blocs accrochés sous un **événement** sont transformés en script. Le détecteur d'erreurs te le rappelle avec un conseil."),
		h("Plusieurs événements dans le même script ?"),
		p("Oui ! Un script peut contenir autant de piles que tu veux, chacune commençant par un événement. Elles fonctionnent toutes en même temps."),
		h("Mes joueurs doivent-ils installer Blocs FR ?"),
		p("Non. Le script enregistré est un vrai script Roblox : ton jeu fonctionne sans le plugin. Tu n'en as besoin que dans Studio, pour modifier tes blocs."),
		h("Ça marche avec un modèle ?"),
		p("Oui. La plupart des blocs agissent sur **toutes les parties** d'un modèle : le colorer, le déplacer, le rendre transparent… Les événements de contact surveillent aussi toutes ses parties."),
		h("Comment faire réagir un objet à un autre objet ?"),
		p("Utilise « objet nommé … » (catégorie **Monde**) dans le menu d'un bloc pour viser un objet par son nom, ou fais communiquer deux scripts avec des **messages**."),
		lien("messages", "Les messages entre scripts"),
		h("Comment faire une attaque, une hitbox ou un ennemi ?"),
		p("Avec la catégorie **Tout prêts** : « attaque de … : animation …, … dégâts, portée … » fait une attaque complète en un seul bloc, et « faire de … un ennemi qui poursuit les joueurs (… dégâts par coup) » transforme un PNJ en ennemi. Les blocs de dégâts vont dans un **script serveur**. Pour voir où frappe ta hitbox, fais un clic droit sur le bloc puis **Prévisualiser la hitbox**."),
		lien("tuto_combat", "Tutoriel : système de combat (animation + hitbox)"),
		lien("hitbox", "Le prévisualiseur de hitbox"),
		h("Comment faire un menu, une barre de vie ou une boutique ?"),
		p("Avec l'onglet **Interface** : dessine ton écran (ou pars d'un des 8 modèles), puis pose ses blocs juste en dessous, par exemple « Quand le bouton Jouer est cliqué » et « cacher l'écran Menu avec fondu »."),
		lien("tuto_menu", "Tutoriel : un menu qui marche"),
		h("J'ai fermé Studio sans enregistrer !"),
		p("Rouvre l'éditeur : si un **brouillon** a été gardé, la fenêtre « Brouillon retrouvé » te propose de le restaurer. Pense ensuite à cliquer sur **Enregistrer**."),
		h("Comment envoyer mon script à un ami ?"),
		p("Utilise **Partager ce script…** (menu **?**) : copie le texte qui commence par `BLOCSFR1:` et envoie-le. Ton ami le colle dans **Importer un code…**."),
		lien("outils", "Favoris, copier-coller, partage, brouillon et mini-carte"),
		h("Je peux changer les couleurs de l'éditeur ?"),
		p("Oui : menu **?** puis **Paramètres…**. Tu peux choisir un thème (sombre, nuit, clair, contraste élevé), ta couleur préférée, la taille du texte, le style des blocs, et même la couleur de chaque catégorie."),
		lien("parametres", "Les paramètres"),
		h("Les animations me gênent"),
		p("Dans le menu **?**, clique sur **Animations de l'éditeur** pour les éteindre (et encore une fois pour les rallumer). Leur vitesse se règle dans les Paramètres."),
		h("Comment savoir ce que fait un script ?"),
		p("Clique sur **Expliquer** en haut de l'éditeur : chaque étape est écrite en français, et **Lecture pas à pas** les montre une par une."),
		lien("expliquer", "Explique-moi ce script"),
	},
}

local rienNeSePasse = {
	id = "rien_ne_se_passe",
	title = "Rien ne se passe ?",
	summary = "Les vérifications à faire, dans l'ordre, quand ton script ne fait rien.",
	body = {
		p("Pas de panique : dans la plupart des cas, la solution se trouve dans cette liste."),
		etapes({
			"As-tu cliqué sur **Enregistrer** ? « ● Non enregistré » veut dire que tes derniers blocs ne sont pas encore dans le script.",
			"Tes blocs sont-ils **accrochés sous un événement** ? Une pile qui ne commence pas par un événement est ignorée.",
			"Le script est-il dans la **bonne cible** ? Regarde **Cible** en haut de l'éditeur, et vérifie dans l'Explorateur que `BlocsServeur`, `BlocsLocal` ou `BlocsModule` est bien dans l'objet.",
			"As-tu choisi le bon **type de script** ? Les touches du clavier demandent un script local ; « Quand un joueur écrit dans le chat » et « créer la statistique … (départ …) », un script serveur.",
			"Le bouton des problèmes affiche-t-il **⚠** ? Ouvre le détecteur : il explique souvent ce qui ne va pas.",
			"As-tu regardé la **Sortie** pendant le test (menu **Affichage → Sortie**) ? Les lignes qui commencent par `[Blocs FR]` expliquent ce qui coince.",
			"Testes-tu avec **Jouer** ? Toucher, cliquer et appuyer sur des touches demandent un vrai personnage dans le jeu.",
			"Ton objet est-il **ancré** (Anchored) ? Une Part non ancrée peut tomber dans le vide avant même que tu la voies.",
		}),
		astuce("Ajoute « afficher … dans la sortie » à plusieurs endroits de ton script, avec des textes comme `étape 1`, `étape 2`… Tu verras dans la Sortie jusqu'où il va."),
		h("Les cas les plus fréquents"),
		p("**La brique ne réagit pas quand je la touche** : le script doit être dans la Part elle-même (ou dans un modèle qui la contient), pas dans Workspace ni dans ServerScriptService."),
		p("**Le clic ne marche pas** : approche-toi, on ne peut cliquer qu'à 32 studs au maximum. Le script doit être dans une Part ou un modèle."),
		p("**Mon message n'arrive pas** : vérifie que son nom est exactement le même des deux côtés, et qu'il part dans la bonne direction (même côté, serveur vers joueurs, ou joueur vers serveur)."),
		p("**Mes variables ne sont pas partagées entre deux scripts** : c'est normal ! Chaque script a ses propres variables. Utilise une valeur partagée ou un message."),
		p("**Le clavier ne répond pas** : le script doit être un **script local**, placé dans StarterPlayerScripts, StarterGui, StarterPack ou une partie de Workspace (jamais dans ServerScriptService ni ServerStorage), et la fenêtre du jeu doit être active (clique dedans)."),
		p("**L'objet ne bouge pas avec « pousser … avec la force x … y … z … »** : il est sans doute ancré. Ajoute « ancrer … : … » sur « non » avant."),
		p("**Mon script module ne fait rien** : c'est normal, un module ne s'exécute jamais tout seul. Un script serveur ou local doit l'utiliser avec « appeler la fonction … du module … ». Vérifie aussi que les noms du module et de la fonction sont écrits exactement pareil des deux côtés."),
		p("**Mon bouton ne réagit pas** : as-tu cliqué sur **Enregistrer l'écran** ? Le nom écrit dans « Quand le bouton … est cliqué » doit être exactement celui du bouton (regarde dans les Calques). Et souviens-toi que dans le Studio, l'**Aperçu** fait réagir les boutons, mais les blocs ne tournent que quand tu cliques sur **Jouer**."),
		p("**La caméra ne bouge pas** : les blocs Caméra demandent un **script local** (dans StarterPlayerScripts par exemple). Vérifie aussi le nom de la partie visée (`Point1`…)."),
		p("**Un bloc ne fait plus rien** : il est peut-être **désactivé** (pâle, rayé, avec l'étiquette « désactivé »). Clic droit dessus, puis **Réactiver ce bloc**."),
		lien("modules", "Les scripts modules"),
		lien("erreurs", "Comprendre les messages d'erreur"),
	},
}

local erreurs = {
	id = "erreurs",
	title = "Comprendre les messages d'erreur",
	summary = "Ce que veulent dire les messages de Blocs FR, et comment corriger le problème.",
	body = {
		p("Blocs FR parle français, même quand quelque chose se passe mal. Ses messages apparaissent à deux endroits."),
		h("Dans le détecteur, avant de jouer"),
		p("Le détecteur d'erreurs vérifie tes blocs pendant que tu les assembles. Chaque problème a un titre court, une explication et un bouton **Voir le bloc**."),
		lien("detecteur", "Le détecteur d'erreurs"),
		h("Dans la Sortie, pendant le test"),
		p("Les lignes **orange** qui commencent par `[Blocs FR]` sont des **avertissements** : un bloc n'a pas pu faire son travail, mais le script continue. Les lignes **rouges** sont des **erreurs** : la pile de blocs concernée s'arrête."),
		h("Les messages les plus courants"),
		p("`objet introuvable` : le bloc vise un objet qui n'existe pas, ou plus. Vérifie le menu de l'objet, ou le nom écrit dans « objet nommé … »."),
		p("`aucun joueur (la valeur est vide)` ou `aucun personnage (la valeur est vide)` : « le joueur » est vide à cet endroit. Place ce bloc sous un événement qui donne un joueur (toucher par un personnage, cliquer, rejoindre la partie…)."),
		p("`est ancré, il ne peut pas bouger` : « pousser … avec la force x … y … z … » et « donner à … la vitesse x … y … z … » ne marchent que sur un objet non ancré. Ajoute « ancrer … : … » sur « non » avant."),
		p("`ne contient aucune partie` : l'objet est un dossier ou un modèle vide. Il n'y a rien à colorer, à déplacer ou à toucher."),
		p("`place le script dans une partie ou un modèle` : un événement de contact ou de clic a besoin d'un objet à surveiller. Change la cible du script."),
		p("`ne fonctionne que dans un script serveur` (ou local) : change le type de script, ou utilise un message pour passer de l'autre côté."),
		p("`ne fonctionne que dans un script module` : « Définir la fonction … », « renvoyer … » et les autres blocs réservés aux modules demandent de choisir **Script module** en haut de l'éditeur."),
		p("**Un module introuvable** : aucun objet ne porte le nom écrit dans la case « module », ou il ne contient pas de script module. Vérifie le nom (majuscules comprises), que le module est bien enregistré, et qu'il est dans ReplicatedStorage s'il est utilisé par un script local."),
		p("**Une fonction qui n'existe pas** : le module a bien été trouvé, mais il ne définit aucune fonction de ce nom. Compare le nom dans « appeler la fonction … » avec celui de « Définir la fonction … »."),
		p("**Le module a une erreur** : un bloc du module a planté pendant son chargement. Ouvre le projet du module et regarde son détecteur d'erreurs."),
		p("`Erreur dans le bloc « … »` : Blocs FR a retrouvé le bloc qui a planté pendant le test. L'explication qui suit dit pourquoi, par exemple une valeur vide (« rien ») ou un calcul avec un texte."),
		p("`Élément « … » introuvable dans l'interface` : un bloc Interface cherche un bouton, un texte ou une barre qui n'existe dans aucun écran du joueur. Vérifie son nom dans le Studio d'interface, et que l'écran est bien enregistré."),
		p("`Dans un script serveur, ce bloc a besoin d'un joueur` : un bloc Interface est dans un script serveur, sous un événement qui ne donne pas de joueur. Place-le sous « Quand un joueur rejoint la partie », « Quand cet objet est cliqué »…, ou mets-le dans les blocs de l'écran (un script local)."),
		astuce("Un message d'erreur est long ? Lis surtout le **nom du bloc** entre « » : c'est là qu'il faut regarder en premier."),
		h("Un exemple dans la Sortie"),
		code("[Blocs FR] éliminer : aucun personnage (la valeur est vide). Place ce bloc sous un événement qui fournit « le joueur », ou choisis un autre joueur."),
		p("Ici, « éliminer … » a été placé sous « Quand ce script démarre » : à ce moment-là, aucun joueur n'est concerné. Il faut le mettre sous un événement comme « Quand un personnage touche cet objet »."),
	},
}

local astuces = {
	id = "astuces",
	title = "Raccourcis et astuces",
	summary = "Des petits gestes pour aller plus vite dans l'éditeur et dans Studio.",
	body = {
		h("Avec la souris"),
		p("**Glisser le fond** de la zone de travail : se déplacer. **Molette** : zoomer autour de la souris. **Mini-carte** (en bas à gauche) : cliquer pour aller loin d'un coup."),
		p("**Clic droit sur un bloc** : couper, copier, dupliquer, désactiver, ajouter une note, voir dans le code, wiki, supprimer… **Clic droit sur le fond** : coller, ranger, recentrer, zoom, partager, paramètres, tout effacer."),
		p("**Clic** sur un bloc : le sélectionner. **Maj + clic** : en ajouter d'autres. **Maj + glisser sur le fond** : un rectangle de sélection."),
		p("**Glisser des blocs sur la palette** : les supprimer."),
		p("**Attraper un bloc au milieu d'une pile** : il emporte les blocs du dessous. Pour n'en sortir qu'un seul, fais un clic droit dessus puis **Détacher ce bloc**."),
		h("Au clavier (souris sur la zone de travail)"),
		p("**Ctrl+C** copier, **Ctrl+X** couper, **Ctrl+V** coller à l'endroit de la souris, **Ctrl+D** dupliquer, **Ctrl+A** tout sélectionner, **Ctrl+Z** annuler, **Ctrl+Y** refaire, **Suppr** supprimer la sélection, **Échap** tout désélectionner."),
		h("Gagner du temps"),
		p("**Dupliquer** copie un bloc et tous ceux qui le suivent : pratique pour répéter une suite de blocs avec d'autres valeurs."),
		p("Dans les cases de nombres, tu peux écrire `0,5` ou `0.5`."),
		p("**Rechercher un bloc…** comprend aussi des mots-clés : tape `tuer`, `couleur`, `son` ou `cliquer`."),
		p("Mets tes blocs préférés dans les **Favoris** (clic droit, puis **Ajouter aux favoris**) : ils sont tout en haut de la palette. Et les **Modèles** posent un script entier d'un coup."),
		p("**Ranger** remet de l'ordre quand la zone de travail devient un vrai bazar."),
		p("Une bêtise ? Le bouton **Annuler** revient en arrière, autant de fois que nécessaire, et **Refaire** rétablit."),
		p("Laisse-toi des **notes** (clic droit, puis **Ajouter une note**) : elles deviennent des commentaires dans le code."),
		h("Dans Roblox Studio"),
		p("**F5** : jouer. **Maj+F5** : arrêter le test. **Ctrl+D** : dupliquer l'objet sélectionné, avec son script."),
		p("**Affichage → Sortie** : la fenêtre où s'écrivent les messages de « afficher … dans la sortie » et les avertissements de Blocs FR."),
		h("Ce wiki"),
		p("Le wiki s'ouvre dans sa propre fenêtre : place-le à côté de l'éditeur pour suivre un tutoriel en même temps. Dans les exemples, clique sur un bloc pour ouvrir sa fiche."),
		p("Le bouton **≡** en haut à gauche affiche ou cache le sommaire quand la fenêtre est étroite."),
	},
}

---------------------------------------------------------------------------
-- Présentation des catégories (pages « Tous les blocs »)
---------------------------------------------------------------------------

local categoryIntros = {
	evenements = "Les événements démarrent tes scripts : chaque pile de blocs commence par l'un d'eux. Ils ont une bosse sur le dessus et se déclenchent quand quelque chose se passe : un contact, un clic, un joueur qui arrive, une touche…",
	debogage = "Les blocs de débogage t'aident à comprendre ce que fait ton script : ils écrivent dans la fenêtre Sortie de Studio, que toi seul vois pendant le test.",
	controle = "Attendre, répéter, choisir avec « si … alors », lancer des blocs en parallèle, envoyer des messages : les blocs de contrôle décident de l'ordre et du rythme de ton script.",
	variables = "Les variables retiennent des valeurs pendant le jeu : un score, un nombre de clics, un état… Crée-les avec « ＋ Créer une variable » dans la palette.",
	actions = "Déplacer, tourner, faire glisser, détruire, cloner, jouer des sons : les actions agissent sur les objets du jeu, qu'il s'agisse d'une Part ou d'un modèle entier.",
	monde = "Créer des parties, changer la gravité, l'heure ou le brouillard, trouver un objet par son nom : les blocs du monde agissent sur tout le jeu.",
	joueurs = "Vie, vitesse, saut, téléportation, classement, messages à l'écran : tout ce qui concerne les joueurs et leurs personnages.",
	apparence = "Couleurs, transparence, matériaux, lumières, effets et textes : change l'apparence de tes objets.",
	operateurs = "Calculs, textes et conditions : les opérateurs se glissent dans les cases des autres blocs pour calculer ou comparer des valeurs.",
	valeurs = "Les valeurs de base : vrai et faux, cet objet, le joueur, la partie touchée, des nombres, des textes, des positions et des couleurs.",
	interface = "Les blocs des écrans dessinés dans le Studio d'interface (onglet Interface) : quand un bouton est cliqué, afficher ou cacher un écran avec un effet, changer un texte ou une couleur, remplir une barre, animer un élément, afficher une notification ou un grand message, suivre la vie ou une statistique… Les trois événements « Quand … » ne marchent que dans un script local (comme les blocs sous un écran) ; les autres blocs marchent aussi dans un script serveur, sous un événement qui donne un joueur.",
	camera = "Change ce que voit le joueur : modes de caméra (première personne, vue de dessus, vue de côté, épaule…), cinématiques qui glissent d'un point de vue à un autre, tremblements, zoom, flou, teinte et bandes de cinéma. La caméra n'existe que chez le joueur : tous ces blocs vont dans un script local.",
	vfx = "Des effets visuels spectaculaires, fabriqués par le script sans rien importer : particules, explosions, traînées lumineuses, rayons, ondes de choc, éclairs d'impact, contours, chiffres de dégâts, auras, images fantômes, lumières qui pulsent et fondus. Dans un script serveur tout le monde les voit ; dans un script local, seulement ce joueur.",
	toutprets = "Des mécaniques de jeu complètes en un seul bloc : attaque avec animation et hitbox, projectile, dash, recul, temps de recharge, barre de vie, PNJ qui poursuit les joueurs, mais aussi sprint, double saut, points de sauvegarde, brique mortelle, plateformes, ascenseur, téléporteur, pièces à ramasser, générateur, bouton d'achat, porte VIP, chronomètre de course, cycle jour/nuit, familier, sauvegarde des statistiques… La plupart vont dans un script serveur placé dans l'objet ; les touches, le clic de souris, le sprint et le double saut se lisent dans un script local.",
	modules = "Les scripts modules sont des boîtes à outils : dans un script module, définis des fonctions avec « Définir la fonction … » et des valeurs avec « mettre la valeur … du module à … ». Ensuite, n'importe quel script serveur ou local les utilise avec « appeler la fonction … du module … », « résultat de … du module … » et « valeur … du module … ». Range tes modules dans ReplicatedStorage pour que tous les scripts y aient accès.",
}

