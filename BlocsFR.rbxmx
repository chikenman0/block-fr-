-- Police « game-kit » des bannières (GothamBlack si elle manque)
local GAME_FONT = Enum.Font.GothamBlack
do
	local ok, font = pcall(function()
		return Enum.Font.LuckiestGuy
	end)
	if ok and font ~= nil then
		GAME_FONT = font
