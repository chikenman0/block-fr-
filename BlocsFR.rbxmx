}

local tutoCinematique = {
	id = "tuto_cinematique",
	title = "Une cinématique avec la caméra",
	summary = "Au début du jeu, des bandes noires apparaissent et la caméra fait la visite de ton monde avant de revenir au joueur.",
	body = {
		p("Une **cinématique**, c'est un petit film au début du jeu : la caméra survole ton monde pour le présenter, comme dans les grands jeux. Il suffit de deux parties invisibles qui servent de **points de vue**."),
		h("1. Les points de vue"),
		etapes({
			"Dans Workspace, ajoute une Part et nomme-la `Point1`. Place-la là où la caméra doit se trouver, et tourne-la pour que sa **face avant** regarde ce que tu veux filmer.",
			"Dans ses propriétés, coche **Anchored**, décoche **CanCollide** et mets **Transparency** à `1` : elle sera invisible pendant le jeu.",
			"Duplique-la (**Ctrl+D**), nomme la copie `Point2` et place-la à un autre endroit.",
		}),
		h("2. Le script local"),
		etapes({
			"Dans l'Explorateur, ouvre **StarterPlayer** et sélectionne **StarterPlayerScripts**.",
			"Dans l'éditeur, clique sur **Nouveau**, puis choisis **Script local** : la caméra n'existe que chez le joueur.",
			"Glisse « Quand ce script démarre », puis « attendre … secondes » avec `2` (le temps que le jeu se charge).",
			"Ajoute « bandes de cinéma … » (catégorie **Caméra**) sur « oui ».",
			"Ajoute « déplacer la caméra vers … en … s » avec `Point1` et `2` secondes, puis « attendre … secondes » avec `1`.",
			"Ajoute un second « déplacer la caméra vers … en … s » avec `Point2` et `3` secondes, puis « attendre … secondes » avec `1`.",
			"Termine par « bandes de cinéma … » sur « non » et « remettre la caméra normale ».",
			"Clique sur **Enregistrer**, puis sur **Jouer** : ta cinématique commence !",
		}),
		exemple("cinematique"),
		h("Comment ça marche ?"),
		p("« déplacer la caméra vers … en … s » fait glisser la caméra jusqu'à la partie nommée, en douceur, et **attend** qu'elle soit arrivée avant de passer au bloc suivant. La caméra prend la position de la partie et regarde dans la direction de sa face avant."),
		p("« remettre la caméra normale » rend la caméra au joueur : elle le suit à nouveau, et tous les effets de caméra s'arrêtent."),
		attention("Dans un **script serveur**, les blocs Caméra ne font rien : le détecteur d'erreurs les affiche en rouge. Vérifie que **Script local** est bien choisi en haut de l'éditeur."),
		astuce("Le nom écrit dans la case doit être exactement celui de la partie (`Point1`, pas `point1`). Si le détecteur dit « Objet introuvable », vérifie l'orthographe dans l'Explorateur."),
		h("Pour aller plus loin"),
		p("Ajoute d'autres points de vue, un « faire trembler la caméra » au moment d'une explosion, un « flou de la caméra … » pendant un chargement, ou un « mettre le champ de vision à … en … s » pour un effet de zoom. Tu peux aussi lancer la cinématique quand un joueur touche une partie, avec un message envoyé par le serveur."),
		lien("camera", "La caméra"),
		lien("cat_camera", "Tous les blocs « Caméra »"),
	},
}

---------------------------------------------------------------------------
-- Exemples
---------------------------------------------------------------------------

local galerie = {
	id = "galerie",
	title = "Tous les exemples",
	summary = "Des scripts prêts à charger dans l'éditeur, à tester puis à modifier.",
	body = {
		p("Chaque exemple indique **où placer le script** et son type (serveur, local ou module). Sélectionne d'abord la bonne cible dans l'Explorateur, clique sur **Charger cet exemple**, puis sur **Enregistrer** dans l'éditeur."),
		astuce("Les exemples sont faits pour être modifiés : change les nombres, les couleurs, les textes… et regarde ce qui se passe !"),
		h("Pièges et obstacles"),
		exemple("brique_mortelle"),
