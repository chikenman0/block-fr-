-- Guides (version 2.1.0)
---------------------------------------------------------------------------

local camera = {
	id = "camera",
	title = "La caméra",
	summary = "Change la vue du joueur : vue de dessus, de côté, à l'épaule, cinématiques, tremblements, flou, bandes de cinéma…",
	body = {
		p("La catégorie **Caméra** change ce que voit le joueur : la vue, l'endroit où regarde la caméra, des effets comme un tremblement ou un flou… C'est parfait pour une **cinématique** au début du jeu, un jeu de plateforme **vu de côté** ou un jeu de stratégie **vu de dessus**."),
		attention("La caméra n'existe que **chez le joueur** : tous les blocs Caméra demandent un **script local** (bouton **Script local** en haut de l'éditeur), par exemple dans **StarterPlayer → StarterPlayerScripts**, ou dans les blocs d'un écran. Dans un script serveur, ils ne font rien et le détecteur d'erreurs l'affiche en rouge."),
		h("Changer de vue"),
		bloc("cam_mode"),
		p("« mode de caméra … » propose : **normale** (la caméra de Roblox), **première personne**, **vue de dessus** (au-dessus du personnage, qui le suit), **vue de côté (2D)** (comme un jeu de plateforme), **épaule** (au-dessus de l'épaule, comme un jeu de tir) et **fixe ici** (la caméra ne bouge plus). La vue choisie reste après une réapparition du personnage."),
		bloc("cam_premiere_personne"),
		bloc("cam_distance"),
		bloc("cam_decaler"),
		p("« distance de zoom entre … et … » limite le zoom de la molette du joueur, et « décaler la caméra de x … y … z … » la place un peu à côté du personnage."),
		h("Cinématiques"),
		bloc("cam_aller_vers"),
		p("« déplacer la caméra vers … en … s » fait glisser la caméra jusqu'à une partie (souvent invisible) nommée par exemple `Point1` : la caméra prend sa position et regarde dans la même direction que sa face avant. Le script **attend** la fin du mouvement : enchaîne plusieurs blocs pour faire une visite."),
		bloc("cam_fixer"),
		bloc("cam_regarder"),
		bloc("cam_suivre_objet"),
		bloc("cam_bandes"),
		bloc("cam_normale"),
		p("« remettre la caméra normale » termine la cinématique : la caméra revient au joueur et tous les effets s'arrêtent (flou, teinte, bandes de cinéma…)."),
		h("Effets"),
		bloc("cam_trembler"),
		bloc("cam_champ_vision"),
		bloc("cam_flou"),
		bloc("cam_teinte"),
		bloc("cam_souris_centre"),
		p("« mettre le champ de vision à … en … s » fait un effet de zoom (petit nombre = zoom, 70 = normal, 100 = effet de vitesse). « flou de la caméra … » se retire avec une taille de 0, et « teinte de l'écran … » avec une intensité de 0."),
		h("Valeurs"),
		p("« position de la caméra », « direction de la caméra », « champ de vision » et « objet visé par la souris » (l'objet que le joueur pointe avec sa souris, ou « rien »)."),
		astuce("Un grand saut ou une explosion ? Ajoute « faire trembler la caméra force 0,5 pendant 0,3 s » : l'impact paraît bien plus puissant. Comme la caméra est chez le joueur, envoie-lui un message depuis le serveur (« envoyer le message … au joueur … »)."),
		exemple("cinematique"),
		lien("tuto_cinematique", "Tutoriel : une cinématique avec la caméra"),
		lien("cat_camera", "Tous les blocs « Caméra »"),
	},
}

local effets = {
	id = "effets",
	title = "Les effets visuels (VFX)",
	summary = "Particules, explosions, traînées lumineuses, rayons, ondes de choc, auras, chiffres de dégâts : des effets spectaculaires sans rien importer.",
	body = {
		p("La catégorie **Effets** ajoute des effets visuels (on dit aussi **VFX**) à tes objets et à tes personnages. Tout est fabriqué par le script : pas besoin d'importer d'images ni de modèles."),
		p("Dans un **script serveur**, tout le monde voit l'effet ; dans un **script local**, seulement ce joueur. Dans les cases, « le personnage » marche aussi sous un événement qui ne donne que le joueur (par exemple « Quand je reçois le message … ») : son personnage est utilisé."),
		h("Particules et explosions"),
		bloc("vfx_particules"),
		p("Dix sortes de particules : étincelles, feu, fumée, magie, poussière, bulles, cœurs, neige, éclairs et confettis. Avec **0 s**, elles jaillissent sans arrêt, jusqu'à « arrêter les effets »."),
		bloc("vfx_explosion"),
		bloc("vfx_eclair"),
		bloc("vfx_onde"),
		h("Autour des personnages"),
		bloc("vfx_aura"),
		bloc("vfx_trainee"),
		bloc("vfx_contour"),
		bloc("vfx_fantomes"),
		p("Une **aura** (magique, feu, glace, ténèbres, électrique ou soin) reste jusqu'à « arrêter les effets » ou la mort du personnage. La **traînée lumineuse** suit le bras droit d'un personnage : chaque coup d'épée laisse un arc de lumière. Les **images fantômes** laissent des copies brillantes derrière un personnage qui fonce."),
		h("Dégâts, rayons et lumières"),
		bloc("vfx_degats"),
		bloc("vfx_rayon"),
		bloc("vfx_lumiere"),
		bloc("vfx_fondu"),
		p("Les **chiffres de dégâts** sont rouges s'ils commencent par « - », verts par « + ». Le **rayon** va d'un objet à un autre (ou vers un objet nommé, comme `Cible`). « faire disparaître … en fondu » attend la fin du fondu ; « montrer … » (Apparence) fait revenir l'objet."),
		h("Tout arrêter"),
		bloc("vfx_arreter"),
		astuce("Mets les effets juste après les dégâts, dans « pour chaque ennemi dans une hitbox devant … » : chaque ennemi touché a son éclair, son chiffre de dégâts et son contour rouge. C'est ce que fait l'exemple ci-dessous."),
		exemple("effets_attaque"),
		attention("Un effet sans arrêt (0 s), une aura ou une lumière qui pulse restent jusqu'à « arrêter les effets ». Les effets courts disparaissent tout seuls, même si l'objet est détruit juste après."),
		lien("cat_vfx", "Tous les blocs « Effets »"),
		lien("tuto_combat", "Tutoriel : système de combat (animation + hitbox)"),
	},
}

local toutpretsSystemes = {
	id = "toutprets_systemes",
	title = "Les systèmes tout prêts",
	summary = "28 mécaniques de jeu complètes en un seul bloc : obby, pièces, boutique, sprint, double saut, porte automatique, chronomètre, familier…",
	body = {
		p("Les blocs **Tout prêts** font en un seul bloc ce qui demanderait des dizaines de petits blocs. La version 2.1.0 en ajoute **28** : de quoi construire un obby, une boutique ou un jeu de course en quelques minutes."),
		p("La plupart se mettent dans un **script serveur** placé dans l'objet concerné, sous « Quand ce script démarre » : ils travaillent ensuite tout seuls, pendant toute la partie. Passe la souris sur un bloc dans la palette pour savoir où le mettre."),
		astuce("Ces blocs sont **optimisés** : ils ne relancent jamais une boucle à chaque contact, et plusieurs blocs du même genre dans un même script partagent une seule boucle. Ton jeu reste fluide, même avec beaucoup d'objets."),
		h("Se déplacer (script local)"),
		bloc("tp_sprint"),
		bloc("tp_double_saut"),
		p("Ces deux blocs lisent le clavier du joueur : ils vont dans un **script local**, par exemple dans StarterPlayer → StarterPlayerScripts. Ils marchent encore après une réapparition."),
		exemple("sprint_double_saut"),
		h("Parcours d'obstacles (obby)"),
		bloc("tp_point_sauvegarde"),
		bloc("tp_mortel"),
		bloc("tp_plateforme_disparait"),
		bloc("tp_plateforme_mobile"),
		bloc("tp_ascenseur"),
		bloc("tp_trampoline"),
		bloc("tp_tapis_roulant"),
		bloc("tp_zone_vitesse"),
		bloc("tp_zone_saut"),
		bloc("tp_lave_montante"),
		bloc("tp_teleporteur"),
		bloc("tp_chrono_course"),
		exemple("obby_complet"),
		exemple("course_chrono"),
		h("Objets et décor"),
		bloc("tp_porte_auto"),
		bloc("tp_flotter"),
		bloc("tp_rotation"),
		bloc("tp_jour_nuit"),
		exemple("jour_nuit"),
		h("Pièces, boutique et récompenses"),
		bloc("tp_ramasser"),
		bloc("tp_generateur"),
		bloc("tp_bouton_achat"),
		bloc("tp_porte_vip"),
		bloc("tp_butin"),
		p("Avec « … se ramasse : + … …, revient après … s », la pièce revient toute seule après le délai ; avec **0 s**, elle est détruite pour de bon (pratique pour les copies d'un générateur)."),
		exemple("piece_toute_prete"),
		exemple("generateur_pieces"),
		exemple("boutique_epee"),
		h("Joueurs et PNJ"),
		bloc("tp_zone_soin"),
		bloc("tp_familier"),
		p("Le familier se met sous « Quand un joueur rejoint la partie » : chaque joueur qui arrive reçoit le sien, et le garde après une réapparition. Range ton modèle (par exemple `Familier`) dans **ServerStorage**, sinon il reste aussi à sa place dans le monde."),
		bloc("tp_pnj_reapparait"),
		bloc("tp_minuteur_ecran"),
		bloc("tp_sauver_stats"),
		p("« sauvegarder les statistiques des joueurs » garde les pièces (et toutes les statistiques du classement) quand un joueur quitte le jeu, et les lui rend quand il revient. **Un seul** bloc suffit pour tout le jeu. Pour l'essayer dans Studio, publie ton jeu puis active **Accès aux services API** dans **Paramètres du jeu → Sécurité**."),
		h("Les noms écrits dans les cases"),
		p("Certains blocs cherchent un objet par son **nom** : la destination du téléporteur (`Arrivée`), le point d'arrivée d'une plateforme mobile (`Point2`), le modèle du générateur (`Pièce`), l'outil du bouton d'achat (`Épée`), le départ et l'arrivée du chronomètre, le modèle du familier… Écris le nom **exactement** comme dans l'Explorateur, majuscules et accents compris. Le détecteur d'erreurs te prévient s'il ne trouve pas l'objet."),
		lien("cat_toutprets", "Tous les blocs « Tout prêts »"),
		lien("tuto_combat", "Tutoriel : système de combat (animation + hitbox)"),
		lien("modeles_scripts", "Les modèles : des scripts entiers tout prêts"),
