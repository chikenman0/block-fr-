		scriptType = "local",
		keywords = "quand souris survol survoler entre passe dessus pointer interface gui hover mouse enter",
		tooltip = "S'exécute quand la souris arrive sur cet élément de l'interface : pratique pour faire grossir un bouton ou afficher une info. À mettre dans un script local.",
		gen = function(a, g)
			return chapeau(g, "_guiSurSurvol", a.ELEMENT, a.BODY)
		end,
	},
	{
		id = "gui_afficher_ecran",
		shape = "stack",
		label = "afficher l'écran %1 avec %2",
		inputs = {
			guiInput("ECRAN", "ecran", "Menu"),
			{ name = "EFFET", kind = "dropdown", options = EFFETS_ECRAN, default = '"fondu"' },
		},
		keywords = "afficher ecran montrer ouvrir menu fenetre interface gui fondu glisser zoom show open screen",
		tooltip = "Affiche un écran de ton interface (créé dans l'onglet Interface) avec un effet : fondu, glisser depuis un bord, zoom… L'effet dure 0,3 s, puis le script continue." .. SERVEUR,
		gen = function(a, g)
			return appel(g, "_guiAfficherEcran", "joueur", a.ECRAN, a.EFFET)
