local MELEE_TAILLE = 5 -- hitbox fixe 5 × 5 de _tpAttaqueMelee
local MELEE_IMPACT = 0.25 -- task.wait(0.25) avant la hitbox dans _tpAttaqueMelee
local MELEE_RECUL = 35 -- _tpRepousser(cible, perso, 35)
